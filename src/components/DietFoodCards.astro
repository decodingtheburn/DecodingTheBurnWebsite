				<div class="diet-emoji-hero">🦐</div>
				<h5 class="diet-food-name">Seafood</h5>
				<div class="diet-bullet-wrapper">
					<ul class="diet-bullet-list">
						<li>Wild Shrimp</li>
						<li>Fresh Oysters</li>
						<li>Wild Scallops</li>
					</ul>
				</div>
			</div>
		</div>
	</div>

	<!-- Category: EGGS & MUSHROOMS (50/50 Side by Side) -->
	<div class="diet-category-group">
		<h4 class="diet-category-title">EGGS &amp; MUSHROOMS</h4>
		<div class="diet-cards-grid">
			<!-- Eggs -->
