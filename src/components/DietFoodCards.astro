						<li>Omelets</li>
						<li>Stir-Fry</li>
						<li>Soft-Boiled</li>
					</ul>
				</div>
			</div>

			<!-- Mushrooms -->
			<div class="diet-food-card">
				<div class="diet-emoji-hero">🍄</div>
				<h5 class="diet-food-name">Mushrooms</h5>
				<div class="diet-bullet-wrapper">
					<ul class="diet-bullet-list">
						<li>White Button</li>
						<li>Cremini &amp; Portobello</li>
