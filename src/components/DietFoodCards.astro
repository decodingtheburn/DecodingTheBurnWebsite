	</div>

	<!-- Category: SEASONINGS & SWEETENERS -->
	<div class="diet-category-group">
		<h4 class="diet-category-title">SEASONINGS &amp; SWEETENERS</h4>
		<div class="diet-cards-grid">
			<!-- Spices -->
			<div class="diet-food-card">
				<div class="diet-emoji-hero">🧂</div>
				<h5 class="diet-food-name">Spices</h5>
