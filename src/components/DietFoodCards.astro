				<div class="diet-emoji-hero">🥓</div>
				<h5 class="diet-food-name">Pork</h5>
				<div class="diet-bullet-wrapper">
					<ul class="diet-bullet-list">
						<li>Ground Pork</li>
						<li>Pork Loins</li>
						<li>Sugar-Free Bacon</li>
					</ul>
				</div>
			</div>

			<!-- Chicken -->
			<div class="diet-food-card">
				<div class="diet-emoji-hero">🍗</div>
				<h5 class="diet-food-name">Chicken</h5>
				<div class="diet-bullet-wrapper">
					<ul class="diet-bullet-list">
						<li>Whole Roast Chicken</li>
						<li>Chicken Thighs</li>
						<li>Chicken Wings</li>
					</ul>
				</div>
			</div>

			<!-- Fats -->
			<div class="diet-food-card">
				<div class="diet-emoji-hero">🧈</div>
				<h5 class="diet-food-name">Fats</h5>
				<div class="diet-bullet-wrapper">
					<ul class="diet-bullet-list">
						<li>Raw Beef Suet</li>
						<li>Beef Tallow</li>
						<li>Cooking Drippings</li>
					</ul>
