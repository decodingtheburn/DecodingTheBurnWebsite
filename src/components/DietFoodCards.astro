				<div class="diet-emoji-hero">🥩</div>
				<h5 class="diet-food-name">Meats</h5>
				<div class="diet-bullet-wrapper">
					<ul class="diet-bullet-list">
						<li>Ground Veal</li>
						<li>Beef Steaks</li>
						<li>Organs (Liver &amp; Heart)</li>
					</ul>
				</div>
			</div>

			<!-- Pork -->
