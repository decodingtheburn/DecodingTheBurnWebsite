<script is:inline>
(() => {
	// Containers & Controls
	const sclContainer = document.getElementById('sclContainer');
	const sclViewButtons = document.querySelectorAll('.sclerotic-view-btn');
	const sclStepButtons = document.querySelectorAll('.timeline-step-btn');
