	const occlusionReadout = document.getElementById('occlusionReadout');
	const sclPlayBtn = document.getElementById('sclPlayBtn');
	const sclPlayIcon = document.getElementById('sclPlayIcon');
	const sclPlayText = document.getElementById('sclPlayText');
	const sclResetBtn = document.getElementById('sclResetBtn');

	// Canvases
	const microCanvas = document.getElementById('scleroticMicroCanvas');
	const microCtx = microCanvas ? microCanvas.getContext('2d') : null;
	const toothCanvas = document.getElementById('sclToothOverlayCanvas');
	const toothCtx = toothCanvas ? toothCanvas.getContext('2d') : null;

	// Elements
	const lumenPill = document.getElementById('lumenPill');
	const sclStatusDot = document.getElementById('sclStatusDot');
	const sclBadgeTitle = document.getElementById('sclBadgeTitle');
	const sclBadgeDesc = document.getElementById('sclBadgeDesc');

	// Telemetry Metrics
	const metricLumen = document.getElementById('metricLumen');
	const subLumen = document.getElementById('subLumen');
	const metricMineral = document.getElementById('metricMineral');
	const subMineral = document.getElementById('subMineral');
	const metricPermeability = document.getElementById('metricPermeability');
	const subPermeability = document.getElementById('subPermeability');
	const metricVelocity = document.getElementById('metricVelocity');
	const subVelocity = document.getElementById('subVelocity');
	const metricGlassy = document.getElementById('metricGlassy');
	const subGlassy = document.getElementById('subGlassy');
	const metricNerveAlarm = document.getElementById('metricNerveAlarm');
	const subNerveAlarm = document.getElementById('subNerveAlarm');

	// Explanations
	const sclPhaseBadge = document.getElementById('sclPhaseBadge');
	const sclExpTitle = document.getElementById('sclExpTitle');
	const sclExpBody = document.getElementById('sclExpBody');

	let currentProgression = 0; // 0 to 100
	let isPlaying = false;
	let animReqId = null;
	let playDirection = 1;
	let frameCount = 0;

	// View Toggle Logic
	sclViewButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			sclViewButtons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
			const mode = btn.getAttribute('data-scl-view');
			if (sclContainer) sclContainer.setAttribute('data-mode', mode);
		});
	});

	// Milestones
	const milestones = [
		{
			step: 0,
			min: 0,
			max: 20,
			label: "Day 0 (Acute Exposure)",
			lumen: 2.50,
			mineral: 0,
			permeability: 100,
			velocity: 3.80,
			glassy: 0,
			nerve: 10,
			badgeTitle: "Acute Tubule Exposure",
			badgeDesc: "Fluid rush firing 10/10 burning pain",
			phase: "Timeline Milestone: Day 0",
			title: "Acute Tubule Exposure: The Unobstructed Fluid Gateway",
			body: "Immediately after enamel is breached or an abfraction notch develops, tubule lumens stand completely patent at a wide 2.5 µm diameter. With no smear layer or mineral plugs, saliva and dietary acids rush across the dentin wall at 3.8 mm/s. The underlying odontoblasts release large quantities of ATP, firing non-stop 10/10 electrical alarms into the Trigeminal Mandibular Canal (CN V3).",
			subLumen: "Wide open cone aperture",
			subMineral: "No crystal occlusion",
			subPermeability: "Violent fluid shear stress",
			subVelocity: "Maximum odontoblast pull",
			subGlassy: "Opaque, porous root face",
			subNerve: "Furious action potential firing"
		},
		{
			step: 1,
			min: 21,
			max: 50,
			label: "Month 3 (Crystal Seeding)",
			lumen: 1.80,
			mineral: 35,
			permeability: 50,
			velocity: 1.90,
			glassy: 25,
			nerve: 6,
			badgeTitle: "Intratubular Mineral Seeding",
			badgeDesc: "Whitlockite crystals choking flow (6/10 Pain)",
			phase: "Timeline Milestone: Month 3",
			title: "Intratubular Nucleation: Salivary Minerals & Crystal Growth",
			body: "Under neutral oral pH conditions, calcium and phosphate from saliva and odontoblastic fluid precipitate microscopic whitlockite crystals within the tubule lumens. Lumen diameter constricts to 1.8 µm. Hydraulic conductance drops by 50%, significantly decreasing the pull on Piezo1 mechanoreceptors and dialing back trigeminal firing to a 6/10 dull ache.",
			subLumen: "Narrowed by crystal seeds",
			subMineral: "Whitlockite matrix forming",
			subPermeability: "Flow reduced by 50%",
			subVelocity: "Moderated shear pull",
			subGlassy: "Early mineralized sheen",
			subNerve: "Dull ache, twinges on cold"
		},
		{
			step: 2,
			min: 51,
			max: 80,
			label: "Month 9 (Peritubular Dentin Choke)",
			lumen: 0.75,
			mineral: 75,
			permeability: 10,
			velocity: 0.40,
			glassy: 70,
			nerve: 2,
			badgeTitle: "Peritubular Dentin Hypertrophy",
			badgeDesc: "Lumen choked by 90% (2/10 Mild Sensitivity)",
			phase: "Timeline Milestone: Month 9",
			title: "Peritubular Hypertrophy: Concentric Calcified Rings",
			body: "Living odontoblasts actively secrete hypermineralized collagenous and non-collagenous matrices that calcify into concentric peritubular rings. The tubule aperture is choked down to a tiny 0.75 µm. Because conductance drops with r⁴, fluid flow plunges by 90%. Pain is reduced to an occasional minor 2/10 twinge.",
			subLumen: "Heavy annular constriction",
			subMineral: "Dense peritubular deposition",
			subPermeability: "Down 90% via r⁴ law",
			subVelocity: "Near-static fluid column",
			subGlassy: "Prominent glassy translucency",
			subNerve: "Infrequent minor twinges"
		},
		{
			step: 3,
			min: 81,
			max: 100,
			label: "Year 2+ (Complete Sclerotic Obliteration)",
			lumen: 0.00,
			mineral: 100,
			permeability: 0,
			velocity: 0.00,
			glassy: 100,
			nerve: 0,
			badgeTitle: "Solid Sclerotic Glassy Seal",
			badgeDesc: "Complete tubule obliteration (0/10 Pain Free)",
			phase: "Timeline Milestone: Year 2+",
			title: "Complete Tubular Obliteration: Permanent Sclerotic Remission",
			body: "The tubule lumens are 100% calcified and obliterated solid from the outer root margin all the way down to the pulp border. The dentin becomes glassy, homogeneous transparent dentin. Zero fluid movement or acid protons can penetrate. Odontoblasts return to resting homeostasis, and the Trigeminal Mandibular Canal (CN V3) is completely silenced.",
			subLumen: "100% calcified solid",
			subMineral: "Complete tubular obliteration",
			subPermeability: "Absolute zero conductance",
			subVelocity: "Static mineralized barrier",
			subGlassy: "Homogeneous transparent glass",
			subNerve: "Completely quiet (0/10 Pain)"
		}
	];

	function interpolateSclerosis(val) {
		const t = val / 100; // 0 (Day 0) to 1 (Year 2+)
		
		const lumen = Math.max(0, 2.50 * (1 - t)).toFixed(2);
		const mineral = Math.round(t * 100);
		// Poiseuille conductance drops rapidly
		const permeability = Math.round(Math.pow(1 - t, 3.5) * 100);
		const velocity = (3.80 * Math.pow(1 - t, 2)).toFixed(2);
		const glassy = Math.round(t * 100);
		const nerve = Math.max(0, Math.round(10 * Math.pow(1 - t, 1.8)));

		let mIdx = 0;
		if (val <= 20) mIdx = 0;
		else if (val <= 50) mIdx = 1;
		else if (val <= 80) mIdx = 2;
		else mIdx = 3;

		const m = milestones[mIdx];

		return {
			t,
			val,
			lumen,
			mineral,
			permeability,
			velocity,
			glassy,
			nerve,
			milestone: m
		};
	}

	function updateSclTelemetry(val) {
		currentProgression = val;
		const d = interpolateSclerosis(val);

		// Header Readouts
		sclTimelineDisplay.innerText = d.milestone.label;
		occlusionReadout.innerText = `${d.mineral}% Sclerotic Occlusion`;
		if (lumenPill) {
			lumenPill.innerHTML = `Lumen Diameter: <strong>${d.lumen} µm (${d.mineral}% Occluded)</strong>`;
		}

		// Floating Tooth Badge
		if (sclBadgeTitle) sclBadgeTitle.innerText = d.milestone.badgeTitle;
		if (sclBadgeDesc) sclBadgeDesc.innerText = d.milestone.badgeDesc;
		if (sclStatusDot) {
			sclStatusDot.className = 'scl-dot ' + (d.nerve > 6 ? 'danger' : d.nerve > 2 ? 'warning' : '');
		}

		// Telemetry Dashboard
		metricLumen.innerText = d.lumen;
		subLumen.innerText = d.milestone.subLumen;

		metricMineral.innerText = d.mineral;
		subMineral.innerText = d.milestone.subMineral;

		metricPermeability.innerText = d.permeability;
		subPermeability.innerText = d.milestone.subPermeability;

		metricVelocity.innerText = d.velocity;
		subVelocity.innerText = d.milestone.subVelocity;

		metricGlassy.innerText = d.glassy;
		subGlassy.innerText = d.milestone.subGlassy;

		metricNerveAlarm.innerText = d.nerve;
		subNerveAlarm.innerText = d.milestone.subNerve;

		// Explanation Card
		sclPhaseBadge.innerText = d.milestone.phase;
		sclExpTitle.innerText = d.milestone.title;
		sclExpBody.innerHTML = d.milestone.body.replace(/([a-zA-Z0-9]+)\s+([a-zA-Z0-9.,]+)$/, '$1&nbsp;$2');

		// Step Buttons Sync
		sclStepButtons.forEach((btn, idx) => {
			btn.classList.toggle('active', idx === d.milestone.step);
		});
	}

	// 1. Draw Microscopic Tubule Occlusion Canvas
	function drawMicroscopicCanvas() {
		if (!microCtx) return;
		const w = microCanvas.width;
		const h = microCanvas.height;
		microCtx.clearRect(0, 0, w, h);

		const t = currentProgression / 100; // 0 to 1

		// Background: Deep microscopic field
		microCtx.fillStyle = '#05020b';
		microCtx.fillRect(0, 0, w, h);

		// Layout: 4 Conical Tubules in longitudinal cross-section
		// Left: Exposed Tooth Surface (Saliva/Acid), Right: Dental Pulp & Odontoblasts
		const leftX = 80;
		const rightX = w - 80;
		const tubuleRows = 4;
		const rowH = (h - 90) / tubuleRows;

		// Oral Cavity Title Left
		microCtx.fillStyle = '#c084fc';
		microCtx.font = 'bold 11px system-ui, sans-serif';
		microCtx.fillText('OUTER ROOT SURFACE (SALIVA & ACIDS)', leftX - 60, 24);

		// Pulp Chamber Title Right
		microCtx.fillStyle = '#fca5a5';
		microCtx.fillText('DENTAL PULP CHAMBER (ODONTOBLAST LAYER)', rightX - 160, 24);

		for (let i = 0; i < tubuleRows; i++) {
			const yCenter = 55 + i * rowH + rowH / 2;
			
			// Total outer anatomical tubule channel boundary (Fixed peritubular jacket)
			const maxOuterRadius = 26; // px
			const minOuterRadius = 16; // near surface

			// Calcified Ingrowth: As t increases, peritubular dentin grows inward!
			const inwardGrowth = t * (maxOuterRadius - 2);
			const currentLumenR = Math.max(1, maxOuterRadius - inwardGrowth);

			// 1. Surrounding Intertubular Dentin Matrix (Brown/Gold)
			microCtx.fillStyle = '#6e451b';
			microCtx.fillRect(leftX, yCenter - rowH / 2, rightX - leftX, rowH);

			// 2. Hypermineralized Peritubular Dentin Ring (Paler off-white dense collar)
			microCtx.fillStyle = '#d1d5db';
			microCtx.beginPath();
			microCtx.moveTo(leftX, yCenter - maxOuterRadius);
			microCtx.lineTo(rightX, yCenter - maxOuterRadius);
			microCtx.lineTo(rightX, yCenter + maxOuterRadius);
			microCtx.lineTo(leftX, yCenter + maxOuterRadius);
			microCtx.closePath();
			microCtx.fill();

			// 3. Newly Ingrowing Peritubular Mineral Wall (Glassy Amber / Sclerotic Dentin)
			if (t > 0.05) {
				const sclGrad = microCtx.createLinearGradient(leftX, 0, rightX, 0);
				sclGrad.addColorStop(0, '#fde047');
				sclGrad.addColorStop(0.5, '#f59e0b');
				sclGrad.addColorStop(1, '#d97706');
				microCtx.fillStyle = sclGrad;

				// Top wall growth
				microCtx.fillRect(leftX, yCenter - maxOuterRadius, rightX - leftX, inwardGrowth);
				// Bottom wall growth
				microCtx.fillRect(leftX, yCenter + maxOuterRadius - inwardGrowth, rightX - leftX, inwardGrowth);
			}

			// 4. Remaining Open Lumen (Center channel where fluid flows)
			if (currentLumenR > 1.5) {
				const lumenGrad = microCtx.createLinearGradient(0, yCenter - currentLumenR, 0, yCenter + currentLumenR);
				lumenGrad.addColorStop(0, '#0284c7');
				lumenGrad.addColorStop(0.5, '#38bdf8');
				lumenGrad.addColorStop(1, '#0369a1');
				microCtx.fillStyle = lumenGrad;
				microCtx.fillRect(leftX, yCenter - currentLumenR, rightX - leftX, currentLumenR * 2);

				// Fluid Flow Particles inside open lumen (Hydrodynamic shear)
				const flowSpeed = (1 - t) * 0.04;
				if (flowSpeed > 0.002) {
					const pCount = Math.floor((1 - t) * 6);
					microCtx.fillStyle = '#ffffff';
					for (let p = 0; p < pCount; p++) {
						const pt = ((frameCount * flowSpeed + p * 0.2 + i * 0.15) % 1);
						const px = leftX + pt * (rightX - leftX);
						const py = yCenter + Math.sin(pt * Math.PI * 4) * (currentLumenR * 0.4);
						microCtx.beginPath();
						microCtx.arc(px, py, 1.8 * (1 - t), 0, Math.PI * 2);
						microCtx.fill();
					}
				}

				// Intratubular Whitlockite Mineral Crystals precipitating inside lumen
				if (t > 0.15 && t < 0.95) {
					const crystalCount = Math.floor(t * 12);
					for (let c = 0; c < crystalCount; c++) {
						const cx = leftX + 40 + (c * 48) % (rightX - leftX - 80);
						const cy = yCenter + Math.sin(c * 2.3) * (currentLumenR * 0.6);
						microCtx.fillStyle = '#fef08a';
						microCtx.beginPath();
						// Rhomboid crystal shape
						microCtx.moveTo(cx, cy - 4);
						microCtx.lineTo(cx + 4, cy);
						microCtx.lineTo(cx, cy + 4);
						microCtx.lineTo(cx - 4, cy);
						microCtx.closePath();
						microCtx.fill();
					}
				}
			} else {
				// 100% Sclerotic Obliteration: Solid calcification line in center!
				microCtx.strokeStyle = '#ffffff';
				microCtx.lineWidth = 1.5;
				microCtx.beginPath();
				microCtx.moveTo(leftX, yCenter);
				microCtx.lineTo(rightX, yCenter);
				microCtx.stroke();
			}

			// Odontoblast Cellular Process Extension (Red living cell projection from pulp)
			microCtx.strokeStyle = '#f87171';
			microCtx.lineWidth = Math.max(1, 3 * (1 - t * 0.7));
			microCtx.beginPath();
			microCtx.moveTo(rightX + 30, yCenter);
			// Retracts as sclerosis solidifies
			const retractX = rightX - (1 - t * 0.8) * (rightX - leftX - 40);
			microCtx.lineTo(retractX, yCenter);
			microCtx.stroke();

			// Odontoblast cell body in pulp
			microCtx.fillStyle = (t > 0.8) ? '#22c55e' : (t > 0.4) ? '#f59e0b' : '#ef4444';
			microCtx.beginPath();
			microCtx.arc(rightX + 35, yCenter, 7, 0, Math.PI * 2);
			microCtx.fill();
		}

		// Annotations & Dimension lines
		if (t < 0.9) {
			microCtx.fillStyle = '#38bdf8';
			microCtx.font = 'bold 11px system-ui, sans-serif';
			microCtx.fillText(`Active Lumen: ${(2.5 * (1 - t)).toFixed(2)} µm`, leftX + 10, h - 14);
		} else {
			microCtx.fillStyle = '#22c55e';
			microCtx.font = 'bold 12px system-ui, sans-serif';
			microCtx.fillText('✔ 100% SCLEROTIC DENTIN: COMPLETE OBLITERATION & FLUID SHIELD', leftX + 100, h - 14);
		}
	}

	// 2. Draw 3D Tooth Sclerotic Overlay Canvas
	function drawToothCanvas() {
		if (!toothCtx) return;
		const w = toothCanvas.width;
		const h = toothCanvas.height;
		toothCtx.clearRect(0, 0, w, h);

		const t = currentProgression / 100; // 0 to 1

		// Left cervical abfraction notch coords: X=415, Y=345
		const cx = 415;
		const cy = 345;

		toothCtx.save();

		// A. Cervical Notch Sclerotic Shield Transformation
		// At t=0: bright porous red/orange permeable breach.
		// At t=1: glassy, transparent amber/pearl solid barrier.
		const notchGlow = toothCtx.createRadialGradient(cx, cy, 5, cx, cy, 65);
		if (t < 0.6) {
			// Porous inflamed open state
			notchGlow.addColorStop(0, `rgba(239, 68, 68, ${0.45 * (1 - t)})`);
			notchGlow.addColorStop(0.6, `rgba(245, 158, 11, ${0.3 * (1 - t)})`);
			notchGlow.addColorStop(1, 'rgba(239, 68, 68, 0)');
			toothCtx.fillStyle = notchGlow;
			toothCtx.beginPath();
			toothCtx.arc(cx, cy, 55, 0, Math.PI * 2);
			toothCtx.fill();

			// Open permeable tubule pores (fading out as t increases)
			const poreCount = Math.floor(28 * (1 - t));
			for (let p = 0; p < poreCount; p++) {
				const px = cx - 18 + Math.sin(p * 1.6 + frameCount * 0.03) * 16;
				const py = cy - 25 + (p / poreCount) * 50;
				toothCtx.fillStyle = (frameCount % 10 < 5) ? '#fef08a' : '#ef4444';
				toothCtx.beginPath();
				toothCtx.arc(px, py, 2.5 * (1 - t), 0, Math.PI * 2);
				toothCtx.fill();
			}
		} else {
			// Sclerotic Glassy Seal (Golden pearl shield over the notch)
			notchGlow.addColorStop(0, `rgba(253, 224, 71, ${0.4 * t})`);
			notchGlow.addColorStop(0.5, `rgba(34, 197, 94, ${0.3 * t})`);
			notchGlow.addColorStop(1, 'rgba(34, 197, 94, 0)');
			toothCtx.fillStyle = notchGlow;
			toothCtx.beginPath();
			toothCtx.arc(cx, cy, 55, 0, Math.PI * 2);
			toothCtx.fill();

			// Glassy Sclerotic Shield Badge
			toothCtx.strokeStyle = '#22c55e';
			toothCtx.lineWidth = 2.5;
			toothCtx.beginPath();
			toothCtx.arc(cx - 5, cy, 28, 0, Math.PI * 2);
			toothCtx.stroke();

			toothCtx.fillStyle = '#22c55e';
			toothCtx.font = 'bold 13px system-ui, sans-serif';
			toothCtx.fillText('GLASSY SCLEROTIC SEAL', cx - 80, cy - 35);
		}

		// B. Horizontal Conduits to Pulp (Choking off)
		const tubuleHorizontalCount = 5;
		for (let hIndex = 0; hIndex < tubuleHorizontalCount; hIndex++) {
			const hy = cy - 25 + hIndex * 12;
			const startX = cx - 10;
			const endX = 515;

			toothCtx.strokeStyle = (t > 0.8) ? 'rgba(34, 197, 94, 0.4)' : 'rgba(253, 224, 71, 0.35)';
			toothCtx.lineWidth = Math.max(1, 2 * (1 - t));
			toothCtx.beginPath();
			toothCtx.moveTo(startX, hy);
			toothCtx.lineTo(endX, hy);
			toothCtx.stroke();

			// Fluid flow particles stop at high t
			if (t < 0.8) {
				const pProg = ((frameCount * (0.04 * (1 - t)) + hIndex * 0.22) % 1);
				const px = startX + pProg * (endX - startX);
				toothCtx.fillStyle = (t > 0.4) ? '#fde047' : '#ef4444';
				toothCtx.beginPath();
				toothCtx.arc(px, hy, 2 * (1 - t), 0, Math.PI * 2);
				toothCtx.fill();
			}
		}

		// C. Trigeminal Action Potentials down Root Canal to Mandibular Canal (Dying down to zero)
		const nerveIntensity = 1 - t; // 1 at Day 0, 0 at Year 2+
		if (nerveIntensity > 0.05) {
			const sparkCount = Math.floor(nerveIntensity * 14);
			toothCtx.fillStyle = (nerveIntensity > 0.5) ? '#ef4444' : '#38bdf8';
			toothCtx.shadowColor = toothCtx.fillStyle;
			toothCtx.shadowBlur = 10 * nerveIntensity;

			// Left Root Canal Pulses
			for (let s = 0; s < sparkCount; s++) {
				const progress = ((frameCount * 0.035 + s * 0.15) % 1);
				const nx = 480 - progress * 45;
				const ny = 350 + progress * 390;
				toothCtx.beginPath();
				toothCtx.arc(nx, ny, 3 * nerveIntensity, 0, Math.PI * 2);
				toothCtx.fill();
			}

			// Mandibular Canal Surge
			for (let m = 0; m < sparkCount * 1.5; m++) {
				const mProgress = ((frameCount * 0.05 + m * 0.12) % 1);
				const mx = 340 + mProgress * 580;
				const my = 753 + Math.sin(mx * 0.08) * 3;
				toothCtx.beginPath();
				toothCtx.arc(mx, my, 2.5 * nerveIntensity, 0, Math.PI * 2);
				toothCtx.fill();
			}
		}

		toothCtx.restore();
	}

	function sclRenderLoop() {
		frameCount++;
		drawMicroscopicCanvas();
		drawToothCanvas();
		animReqId = requestAnimationFrame(sclRenderLoop);
	}

	// Slider Listener
	sclSlider?.addEventListener('input', (e) => {
		const val = parseInt(e.target.value, 10);
		updateSclTelemetry(val);
	});

	// Timeline Step Buttons
	sclStepButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const step = parseInt(btn.getAttribute('data-step'), 10);
			let targetVal = 0;
			if (step === 0) targetVal = 0;
			else if (step === 1) targetVal = 35;
			else if (step === 2) targetVal = 70;
			else if (step === 3) targetVal = 100;

			sclSlider.value = targetVal;
			updateSclTelemetry(targetVal);
		});
	});

	// Auto Play Sclerosis Loop
	function togglePlay() {
		isPlaying = !isPlaying;
		if (isPlaying) {
			sclPlayIcon.innerText = '⏸';
			sclPlayText.innerText = 'Pause';
			autoStepScl();
		} else {
			sclPlayIcon.innerText = '▶';
			sclPlayText.innerText = 'Play Healing Arc';
		}
	}

	function autoStepScl() {
		if (!isPlaying) return;
		let val = parseInt(sclSlider.value, 10);
		val += playDirection * 1;

		if (val >= 100) {
			val = 100;
			playDirection = -1;
		} else if (val <= 0) {
			val = 0;
			playDirection = 1;
		}

		sclSlider.value = val;
		updateSclTelemetry(val);
		setTimeout(autoStepScl, 80);
	}

	sclPlayBtn?.addEventListener('click', togglePlay);

	// Reset
	sclResetBtn?.addEventListener('click', () => {
		isPlaying = false;
		sclPlayIcon.innerText = '▶';
		sclPlayText.innerText = 'Play Healing Arc';
		sclSlider.value = 0;
		updateSclTelemetry(0);
	});

	// Init
	updateSclTelemetry(0);
	sclRenderLoop();
})();
</script>
