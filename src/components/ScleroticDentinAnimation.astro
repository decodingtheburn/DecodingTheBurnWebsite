---
// ScleroticDentinAnimation.astro - Interactive Biophysical Simulator for Dentinal Sclerosis & Tubule Obliteration
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`sclerotic-anim-wrapper ${className}`}>
	<div class="sclerotic-anim-card">
		<!-- Header -->
		<div class="sclerotic-anim-header">
			<h3 class="sclerotic-anim-title">Interactive Biophysical Timeline: Sclerotic Dentin&nbsp;Obstruction</h3>
			<p class="sclerotic-anim-subtitle">
				Drag the timeline slider or step through each healing phase to observe how the tooth pulp naturally fights erosion, depositing intratubular mineral crystals to choke off open tubules into solid, glassy sclerotic&nbsp;dentin.
			</p>
		</div>

		<!-- View Switcher Tabs -->
		<div class="sclerotic-view-toggle" role="tablist" aria-label="Sclerosis Simulation Views">
			<button class="sclerotic-view-btn active" data-scl-view="microscopic" type="button">
				<span class="view-icon">🔬</span>
				<span class="view-label">Microscopic Tubule Lumen Occlusion</span>
			</button>
			<button class="sclerotic-view-btn" data-scl-view="tooth" type="button">
				<span class="view-icon">🦷</span>
				<span class="view-label">3D Tooth Sclerotic Shield</span>
			</button>
			<button class="sclerotic-view-btn" data-scl-view="split" type="button">
				<span class="view-icon">⚡</span>
				<span class="view-label">Side-by-Side Dual View</span>
			</button>
		</div>

		<!-- Timeline Milestone Buttons -->
		<div class="timeline-step-grid" role="tablist" aria-label="Sclerosis Timeline Milestones">
			<button class="timeline-step-btn active" data-step="0" type="button">
				<span class="step-num">Day 0 - Acute Breach</span>
				<span class="step-desc">Open Tubules (10/10 Pain)</span>
			</button>
			<button class="timeline-step-btn" data-step="1" type="button">
				<span class="step-num">Month 3 - Crystal Seeding</span>
				<span class="step-desc">Mineral Precipitation (50% Flow)</span>
			</button>
			<button class="timeline-step-btn" data-step="2" type="button">
				<span class="step-num">Month 9 - Wall Constriction</span>
				<span class="step-desc">Peritubular Dentin Choke (10% Flow)</span>
			</button>
			<button class="timeline-step-btn" data-step="3" type="button">
				<span class="step-num">Year 2+ - Full Obliteration</span>
				<span class="step-desc">Solid Sclerotic Glass (0/10 Pain)</span>
			</button>
		</div>

		<!-- Simulation Viewport -->
		<div class="sclerotic-viewport-container" id="sclContainer" data-mode="microscopic">
			
			<!-- VIEW A: Microscopic Tubule Conical Occlusion Canvas -->
			<div class="scl-pane microscopic-pane" id="microscopicPane">
				<div class="micro-header-bar">
					<div class="micro-title-wrap">
						<h4 class="micro-title">Intratubular Calcification &amp; Lumen&nbsp;Choke</h4>
						<p class="micro-subtitle">
							Watch peritubular hydroxyapatite and whitlockite crystals grow inward, strangling fluid flow ($Q \propto r^4$) down to absolute&nbsp;zero.
						</p>
					</div>
					<div class="micro-lumen-pill" id="lumenPill">
						Lumen Diameter: <strong>2.50 µm (100% Open)</strong>
					</div>
				</div>

				<div class="micro-canvas-box">
					<canvas id="scleroticMicroCanvas" width="900" height="440"></canvas>
					
					<div class="micro-legend-row">
						<div class="scl-legend-chip"><span class="chip-dot open-fluid"></span> Open Fluid Lumen (Hydrodynamic Shear)</div>
						<div class="scl-legend-chip"><span class="chip-dot mineral-crystals"></span> Intratubular Mineral Crystals (Whitlockite)</div>
						<div class="scl-legend-chip"><span class="chip-dot peritubular"></span> Hypermineralized Peritubular Dentin</div>
						<div class="scl-legend-chip"><span class="chip-dot odontoblast"></span> Odontoblast Process (Retracting / Calming)</div>
					</div>
				</div>
			</div>

			<!-- VIEW B: 3D Tooth Sclerotic Shield View -->
			<div class="scl-pane tooth-pane" id="toothPane">
				<div class="tooth-header-bar">
					<div class="tooth-title-wrap">
						<h4 class="micro-title">3D Tooth Cervical Notch: Natural Glassy&nbsp;Seal</h4>
						<p class="micro-subtitle">
							The exposed, porous cervical wedge transforms into dense, translucent sclerotic dentin, halting nerve firing into the mandibular&nbsp;canal.
						</p>
					</div>
				</div>

				<div class="scl-tooth-stage">
					<img 
						src="/exposed-dentinal-tubules-cross-section.jpg" 
						alt="3D cross section of tooth showing sclerotic dentin obstruction sealing tubules and calming trigeminal nerve"
						class="scl-tooth-img"
						id="sclToothImg"
					/>
					<canvas id="sclToothOverlayCanvas" width="1200" height="896"></canvas>

					<!-- Floating Status Callout -->
					<div class="scl-hotspot-badge" id="sclHotspotBadge">
						<div class="scl-dot danger" id="sclStatusDot"></div>
						<div class="scl-badge-info">
							<strong id="sclBadgeTitle">Acute Tubule Exposure</strong>
							<span id="sclBadgeDesc">Fluid rush firing 10/10 burning pain</span>
						</div>
					</div>
				</div>
			</div>

		</div>

		<!-- Interactive Timeline Slider & Controls -->
		<div class="scl-slider-bar">
			<div class="slider-left">
				<div class="slider-header-flex">
					<label for="sclSlider" class="scl-slider-label">
						<span>Sclerosis Healing Timeline:</span>
						<strong id="sclTimelineDisplay">Day 0 (Acute Exposure)</strong>
					</label>
					<span class="occlusion-readout" id="occlusionReadout">0% Lumen Occlusion</span>
				</div>
				<input 
					type="range" 
					id="sclSlider" 
					min="0" 
					max="100" 
					value="0" 
					step="1"
					class="scl-range-input"
					aria-label="Sclerosis healing timeline slider"
				/>
				<div class="scl-ticks">
					<span>Day 0</span>
					<span>Month 1</span>
					<span>Month 3</span>
					<span>Month 6</span>
					<span>Month 12</span>
					<span>Year 2+</span>
				</div>
			</div>

			<div class="scl-actions">
				<button id="sclPlayBtn" class="scl-action-btn" type="button">
					<span id="sclPlayIcon">▶</span>
					<span id="sclPlayText">Play Healing Arc</span>
				</button>
				<button id="sclResetBtn" class="scl-action-btn secondary" type="button">
					Reset to Day 0
				</button>
			</div>
		</div>

		<!-- Real-Time Biophysical Telemetry Dashboard -->
		<div class="scl-metrics-dashboard">
			<div class="scl-metric-card">
				<div class="scl-metric-label">Lumen Aperture</div>
				<div class="scl-metric-value-box">
					<span class="scl-metric-val" id="metricLumen">2.50</span>
					<span class="scl-metric-unit">µm</span>
				</div>
				<div class="scl-metric-sub" id="subLumen">Wide open cone aperture</div>
			</div>

			<div class="scl-metric-card">
				<div class="scl-metric-label">Intratubular Mineralization</div>
				<div class="scl-metric-value-box">
					<span class="scl-metric-val" id="metricMineral">0</span>
					<span class="scl-metric-unit">% Solid</span>
				</div>
				<div class="scl-metric-sub" id="subMineral">No crystal occlusion</div>
			</div>

			<div class="scl-metric-card">
				<div class="scl-metric-label">Hydraulic Conductance ($r^4$)</div>
				<div class="scl-metric-value-box">
					<span class="scl-metric-val" id="metricPermeability">100</span>
					<span class="scl-metric-unit">% Max</span>
				</div>
				<div class="scl-metric-sub" id="subPermeability">Violent fluid shear stress</div>
			</div>

			<div class="scl-metric-card">
				<div class="scl-metric-label">Fluid Velocity (Brännström)</div>
				<div class="scl-metric-value-box">
					<span class="scl-metric-val" id="metricVelocity">3.80</span>
					<span class="scl-metric-unit">mm/s</span>
				</div>
				<div class="scl-metric-sub" id="subVelocity">Maximum odontoblast pull</div>
			</div>

			<div class="scl-metric-card">
				<div class="scl-metric-label">Dentin Translucency</div>
				<div class="scl-metric-value-box">
					<span class="scl-metric-val" id="metricGlassy">0</span>
					<span class="scl-metric-unit">% Glassy</span>
				</div>
				<div class="scl-metric-sub" id="subGlassy">Opaque, porous root face</div>
			</div>

			<div class="scl-metric-card critical">
				<div class="scl-metric-label">Trigeminal Nerve Alarm (CN V3)</div>
				<div class="scl-metric-value-box">
					<span class="scl-metric-val nerve" id="metricNerveAlarm">10</span>
					<span class="scl-metric-unit">/ 10 Pain</span>
				</div>
				<div class="scl-metric-sub" id="subNerveAlarm">Furious action potential firing</div>
			</div>
		</div>

		<!-- Deep Scientific Analysis & Clinical Explanations -->
		<div class="scl-explanation-card" id="sclExpCard">
			<div class="scl-exp-header">
				<span class="scl-phase-badge" id="sclPhaseBadge">Timeline Milestone: Day 0</span>
				<h4 class="scl-exp-title" id="sclExpTitle">Acute Tubule Exposure: The Unobstructed Fluid Gateway</h4>
			</div>
			<p class="scl-exp-body" id="sclExpBody">
				Immediately after enamel is breached or an abfraction notch develops, tubule lumens stand completely patent at a wide 2.5 µm diameter. With no smear layer or mineral plugs, saliva and dietary acids rush across the dentin wall at 3.8 mm/s. The underlying odontoblasts release large quantities of ATP, firing non-stop 10/10 electrical alarms into the Trigeminal Mandibular Canal (CN V3).
			</p>

			<div class="scl-science-grid">
				<div class="scl-science-box">
					<div class="scl-science-title">The Natural Defense: Peritubular Hypertrophy</div>
					<p class="scl-science-desc">
						When protected from rapid acid erosion, odontoblasts actively synthesize and deposit mineral rings of peritubular dentin. Whitlockite (calcium magnesium phosphate) crystals precipitate inside the lumen, choking the channel from within.
					</p>
				</div>
				<div class="scl-science-box">
					<div class="scl-science-title">The Power of Poiseuille's Fourth Power ($r^4$)</div>
					<p class="scl-science-desc">
						Because fluid conductance shrinks with the fourth power of the radius, halving the lumen diameter from 2.5 µm to 1.25 µm slashes fluid movement by a massive 93.75%! Even partial sclerosis provides dramatic pain relief.
					</p>
				</div>
				<div class="scl-science-box highlight-box">
					<div class="scl-science-title">Why Acidic Diets Prevent Natural Sclerosis</div>
					<p class="scl-science-desc">
						If a patient drinks acidic coffee, soda, or citrus daily (pH &lt; 5.5), dietary acids dissolve the delicate whitlockite crystals faster than the tooth can deposit them. Sclerosis halts, trapping the tooth in permanent chronic burning pain.
					</p>
				</div>
			</div>
		</div>

	</div>
</div>

<style>
	.sclerotic-anim-wrapper {
		margin: 3.5rem 0;
		width: 100%;
		box-sizing: border-box;
	}

	.sclerotic-anim-card {
		background: radial-gradient(120% 120% at 50% 0%, #17102e 0%, #0d081a 60%, #070311 100%);
		border: 1px solid rgba(168, 85, 247, 0.35);
		border-radius: 1.5rem;
		padding: clamp(1.25rem, 3vw, 2.5rem);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		color: #e2e8f0;
	}

	.sclerotic-anim-header {
		text-align: center;
		margin-bottom: 2rem;
		max-width: 860px;
		margin-left: auto;
		margin-right: auto;
	}

	.sclerotic-anim-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(1.4rem, 2.8vw, 2.1rem);
		font-weight: 900;
		color: #ffffff;
		margin: 0 0 0.85rem 0;
		line-height: 1.25;
		text-wrap: balance;
		letter-spacing: -0.02em;
	}

	.sclerotic-anim-subtitle {
		font-size: clamp(0.95rem, 1.6vw, 1.05rem);
		line-height: 1.65;
		color: #cbd5e1;
		margin: 0;
		text-wrap: pretty;
	}

	/* View Toggle */
	.sclerotic-view-toggle {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
	}

	.sclerotic-view-btn {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(168, 85, 247, 0.28);
		border-radius: 0.85rem;
		padding: 0.65rem 1.25rem;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: #cbd5e1;
		transition: all 0.2s ease;
	}

	.sclerotic-view-btn:hover {
		background: rgba(168, 85, 247, 0.15);
		color: #ffffff;
		border-color: rgba(168, 85, 247, 0.5);
	}

	.sclerotic-view-btn.active {
		background: linear-gradient(135deg, rgba(168, 85, 247, 0.3) 0%, rgba(126, 34, 206, 0.5) 100%);
		border-color: #c084fc;
		color: #ffffff;
		box-shadow: 0 0 16px rgba(168, 85, 247, 0.4);
	}

	/* Timeline Step Buttons */
	.timeline-step-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	@media (max-width: 768px) {
		.timeline-step-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.timeline-step-btn {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(168, 85, 247, 0.22);
		border-radius: 0.85rem;
		padding: 0.85rem 0.75rem;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.25rem;
		transition: all 0.2s ease;
		color: #e2e8f0;
		text-align: left;
	}

	.timeline-step-btn:hover {
		background: rgba(168, 85, 247, 0.12);
		border-color: rgba(168, 85, 247, 0.45);
	}

	.timeline-step-btn.active {
		background: linear-gradient(135deg, rgba(168, 85, 247, 0.25) 0%, rgba(147, 51, 234, 0.38) 100%);
		border-color: #c084fc;
		box-shadow: 0 0 14px rgba(168, 85, 247, 0.3);
	}

	.step-num {
		font-size: 0.82rem;
		font-weight: 800;
		color: #c084fc;
	}

	.timeline-step-btn.active .step-num {
		color: #fde047;
	}

	.step-desc {
		font-size: 0.84rem;
		font-weight: 600;
		color: #ffffff;
		line-height: 1.25;
	}

	/* Viewport Container & Modes */
	.sclerotic-viewport-container {
		background: #06020d;
		border: 1px solid rgba(168, 85, 247, 0.3);
		border-radius: 1.25rem;
		padding: 0.85rem;
		margin-bottom: 1.5rem;
		position: relative;
		overflow: hidden;
	}

	.sclerotic-viewport-container[data-mode="microscopic"] .tooth-pane {
		display: none;
	}

	.sclerotic-viewport-container[data-mode="tooth"] .microscopic-pane {
		display: none;
	}

	.sclerotic-viewport-container[data-mode="split"] {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	@media (max-width: 900px) {
		.sclerotic-viewport-container[data-mode="split"] {
			grid-template-columns: 1fr;
		}
	}

	/* Microscopic Pane */
	.microscopic-pane {
		background: #070311;
		border-radius: 0.85rem;
		padding: 1rem;
		display: flex;
		flex-direction: column;
		border: 1px solid rgba(168, 85, 247, 0.25);
	}

	.micro-header-bar {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.85rem;
		flex-wrap: wrap;
	}

	.micro-title-wrap {
		flex: 1;
		min-width: 240px;
	}

	.micro-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: 1.08rem;
		font-weight: 800;
		color: #ffffff;
		margin: 0 0 0.35rem 0;
		line-height: 1.3;
	}

	.micro-subtitle {
		font-size: 0.82rem;
		line-height: 1.5;
		color: #cbd5e1;
		margin: 0;
	}

	.micro-lumen-pill {
		background: rgba(253, 224, 71, 0.12);
		border: 1px solid rgba(253, 224, 71, 0.35);
		border-radius: 0.6rem;
		padding: 0.4rem 0.8rem;
		font-size: 0.82rem;
		color: #fde047;
		white-space: nowrap;
	}

	.micro-canvas-box {
		width: 100%;
		border-radius: 0.75rem;
		overflow: hidden;
		background: #030107;
		border: 1px solid rgba(168, 85, 247, 0.2);
	}

	#scleroticMicroCanvas {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 900 / 440;
	}

	.micro-legend-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		margin-top: 0.75rem;
		padding: 0.4rem 0.2rem;
	}

	.scl-legend-chip {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.76rem;
		color: #cbd5e1;
	}

	.chip-dot {
		width: 12px;
		height: 12px;
		border-radius: 3px;
	}

	.chip-dot.open-fluid { background: #38bdf8; }
	.chip-dot.mineral-crystals { background: #fde047; }
	.chip-dot.peritubular { background: #e2e8f0; }
	.chip-dot.odontoblast { background: #f87171; }

	/* Tooth Pane */
	.tooth-pane {
		background: #070311;
		border-radius: 0.85rem;
		padding: 1rem;
		border: 1px solid rgba(168, 85, 247, 0.25);
	}

	.tooth-header-bar {
		margin-bottom: 0.85rem;
	}

	.scl-tooth-stage {
		position: relative;
		width: 100%;
		border-radius: 0.85rem;
		overflow: hidden;
		background: #020106;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.scl-tooth-img {
		width: 100%;
		height: auto;
		display: block;
		object-fit: contain;
		max-height: 520px;
	}

	#sclToothOverlayCanvas {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	/* Hotspot Badges */
	.scl-hotspot-badge {
		position: absolute;
		top: 14px;
		right: 14px;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		background: rgba(12, 6, 24, 0.92);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(168, 85, 247, 0.45);
		padding: 0.45rem 0.85rem;
		border-radius: 0.75rem;
		box-shadow: 0 4px 16px rgba(0,0,0,0.6);
		pointer-events: none;
		max-width: 290px;
		z-index: 10;
		transition: all 0.3s ease;
	}

	@media (max-width: 600px) {
		.scl-hotspot-badge {
			display: none;
		}
	}

	.scl-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #22c55e;
		box-shadow: 0 0 8px #22c55e;
		flex-shrink: 0;
	}

	.scl-dot.warning {
		background: #eab308;
		box-shadow: 0 0 10px #eab308;
	}

	.scl-dot.danger {
		background: #ef4444;
		box-shadow: 0 0 12px #ef4444;
		animation: pulseRed 1s infinite alternate;
	}

	.scl-badge-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.scl-badge-info strong {
		font-size: 0.82rem;
		color: #ffffff;
		line-height: 1.2;
	}

	.scl-badge-info span {
		font-size: 0.72rem;
		color: #cbd5e1;
		line-height: 1.25;
	}

	/* Slider Controls */
	.scl-slider-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.85rem 0.5rem 0.4rem;
		flex-wrap: wrap;
		margin-bottom: 1.25rem;
	}

	.slider-left {
		flex: 1;
		min-width: 280px;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.slider-header-flex {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.9rem;
	}

	.scl-slider-label {
		color: #cbd5e1;
		font-weight: 600;
	}

	.scl-slider-label strong {
		color: #fde047;
		margin-left: 0.25rem;
	}

	.occlusion-readout {
		font-size: 0.85rem;
		font-weight: 800;
		color: #c084fc;
	}

	.scl-range-input {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 8px;
		border-radius: 4px;
		background: linear-gradient(90deg, #ef4444 0%, #eab308 50%, #22c55e 100%);
		outline: none;
		cursor: pointer;
	}

	.scl-range-input::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: #ffffff;
		border: 3px solid #9333ea;
		box-shadow: 0 0 12px rgba(168, 85, 247, 0.8);
		cursor: pointer;
		transition: transform 0.15s ease;
	}

	.scl-range-input::-webkit-slider-thumb:hover {
		transform: scale(1.15);
	}

