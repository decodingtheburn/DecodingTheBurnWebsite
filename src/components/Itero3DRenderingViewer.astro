	// Helper to create clinical diagnostic badges with dynamic width so NO text is ever truncated
	function createClinicalSprite(text, borderColorHex) {
		const canvas = document.createElement('canvas');
		const ctx = canvas.getContext('2d');
		const fontStr = 'bold 24px system-ui, -apple-system, sans-serif';
		ctx.font = fontStr;

		// Accurately measure text width to guarantee zero truncation
		const metrics = ctx.measureText(text);
		const textWidth = Math.ceil(metrics.width);
		const padX = 36;
		const canvasW = Math.max(360, textWidth + padX * 2);
		const canvasH = 72;
		canvas.width = canvasW;
		canvas.height = canvasH;

		// Re-apply context font after canvas resize
		ctx.font = fontStr;

		// Soft drop shadow
		ctx.shadowColor = 'rgba(0, 0, 0, 0.92)';
		ctx.shadowBlur = 12;
		ctx.shadowOffsetX = 0;
		ctx.shadowOffsetY = 4;

		// Card Background
		const boxX = 6;
		const boxY = 4;
		const boxW = canvasW - 12;
		const boxH = canvasH - 8;
		const radius = 10;

		ctx.fillStyle = 'rgba(12, 8, 26, 0.96)';
		ctx.beginPath();
		ctx.roundRect(boxX, boxY, boxW, boxH, radius);
		ctx.fill();

		// Clean accent border
		ctx.shadowColor = 'transparent';
		ctx.strokeStyle = borderColorHex;
		ctx.lineWidth = 3;
		ctx.stroke();

		// Sharp Typography with ample breathing room
		ctx.fillStyle = '#ffffff';
		ctx.textAlign = 'center';
		ctx.textBaseline = 'middle';
		ctx.fillText(text, canvasW / 2, (canvasH / 2) - 0.5);

		const texture = new THREE.CanvasTexture(canvas);
		texture.minFilter = THREE.LinearFilter;
		const mat = new THREE.SpriteMaterial({
			map: texture,
			depthTest: true,
			depthWrite: false,
			transparent: true
		});
		const sprite = new THREE.Sprite(mat);
		// Compute accurate world scale preserving true aspect ratio
		const worldHeight = 0.36;
		const worldWidth = worldHeight * (canvasW / canvasH);
		sprite.scale.set(worldWidth, worldHeight, 1);
		sprite.userData.baseScaleX = worldWidth;
		sprite.userData.baseScaleY = worldHeight;
		allSprites.push(sprite);
		return sprite;
	}

	// Helper to create high-contrast dark green tooth number sprites with emerald accent border
	function createToothNumberSprite(text) {
		const canvas = document.createElement('canvas');
		canvas.width = 64;
		canvas.height = 36;
		const ctx = canvas.getContext('2d');

		// Rich drop shadow
		ctx.shadowColor = 'rgba(0, 0, 0, 0.95)';
		ctx.shadowBlur = 8;
		ctx.shadowOffsetX = 0;
		ctx.shadowOffsetY = 2;

		// Card box: Rich dark forest green (#064e3b)
		const boxX = 3;
		const boxY = 3;
		const boxW = canvas.width - 6;
		const boxH = canvas.height - 6;
		const radius = 6;

		ctx.fillStyle = 'rgba(6, 78, 59, 0.96)';
		ctx.beginPath();
		ctx.roundRect(boxX, boxY, boxW, boxH, radius);
		ctx.fill();

		// Sharp emerald border (#10b981) for contrast against both dark bg and pink gums
		ctx.shadowColor = 'transparent';
		ctx.strokeStyle = '#10b981';
		ctx.lineWidth = 2.5;
		ctx.stroke();

		// Crisp white typography for maximum contrast
		ctx.fillStyle = '#ffffff';
		ctx.font = 'bold 18px system-ui, -apple-system, sans-serif';
		ctx.textAlign = 'center';
		ctx.textBaseline = 'middle';
		ctx.fillText(text, canvas.width / 2, (canvas.height / 2) - 0.5);

		const texture = new THREE.CanvasTexture(canvas);
		texture.minFilter = THREE.LinearFilter;
		const mat = new THREE.SpriteMaterial({
			map: texture,
			depthTest: true,
			depthWrite: false,
			transparent: true
		});
		const sprite = new THREE.Sprite(mat);
		// Compact scale: width 0.30, height 0.17
		const baseScaleX = 0.30;
		const baseScaleY = 0.17;
		sprite.scale.set(baseScaleX, baseScaleY, 1);
		sprite.userData.baseScaleX = baseScaleX;
		allSprites.push(sprite);
		return sprite;
	}

	// Helper to create a glowing 3D beacon sphere sitting right on the tooth surface
	function createBeaconSphere(colorHex, radius = 0.14) {
		const group = new THREE.Group();

		// 1. Core glowing bead
		const geom = new THREE.SphereGeometry(radius, 16, 16);
		const mat = new THREE.MeshStandardMaterial({
			color: colorHex,
			emissive: colorHex,
			emissiveIntensity: 1.2,
			roughness: 0.15,
			depthTest: true,
			depthWrite: false
		});
		const sphere = new THREE.Mesh(geom, mat);
		group.add(sphere);

		// 2. High-contrast luminous halo ring directly around the bead
		const ringGeom = new THREE.RingGeometry(radius * 1.15, radius * 1.7, 24);
		const ringMat = new THREE.MeshBasicMaterial({
			color: colorHex,
			side: THREE.DoubleSide,
			transparent: true,
			opacity: 0.85,
			depthTest: true,
			depthWrite: false
		});
		const ring = new THREE.Mesh(ringGeom, ringMat);
		group.add(ring);

		return group;
	}

	// Helper to create a solid 3D cylinder stem connecting a start point to an end point
	function createStemCylinder(startPos, endPos, colorHex, radius = 0.018) {
		const dir = new THREE.Vector3().subVectors(endPos, startPos);
		const length = dir.length();
		if (length < 0.01) return new THREE.Group();

		const geom = new THREE.CylinderGeometry(radius, radius, length, 10);
		geom.translate(0, length / 2, 0);
		geom.rotateX(Math.PI / 2);

		const mat = new THREE.MeshStandardMaterial({
			color: colorHex,
			emissive: colorHex,
			emissiveIntensity: 0.75,
			roughness: 0.25,
			depthTest: true,
			depthWrite: false
		});

		const cylinder = new THREE.Mesh(geom, mat);
		cylinder.position.copy(startPos);
		cylinder.lookAt(endPos);
		return cylinder;
	}

	// Helper to create a 3D pointer arrow cone pointing at the tooth dot
	function createArrowCone(pos, dirNormalized, colorHex) {
		const geom = new THREE.ConeGeometry(0.08, 0.22, 12);
		geom.translate(0, -0.11, 0);
		geom.rotateX(Math.PI / 2);

		const mat = new THREE.MeshStandardMaterial({
			color: colorHex,
			emissive: colorHex,
			emissiveIntensity: 0.9,
			roughness: 0.2,
			depthTest: true,
			depthWrite: false
		});

		const cone = new THREE.Mesh(geom, mat);
		cone.position.copy(pos);
		cone.lookAt(pos.clone().add(dirNormalized));
		return cone;
	}

