		if (rec) {
			if (drawerTitle) drawerTitle.textContent = rec.name;
			if (drawerSubtitle) drawerSubtitle.textContent = rec.subtitle;
			if (drawerSeverity) drawerSeverity.textContent = rec.severity;
			if (drawerClinicalText) drawerClinicalText.textContent = rec.clinical;
			if (drawerBmsMechanism) drawerBmsMechanism.textContent = rec.mechanism;
			if (metricPocket) metricPocket.textContent = rec.pocket;
			if (metricBop) metricBop.textContent = rec.bop;
			if (metricSensitivity) metricSensitivity.textContent = rec.sensitivity;
			if (metricStressor) metricStressor.textContent = rec.stressor;
		} else if (toothInfo) {
			if (drawerTitle) drawerTitle.textContent = `Tooth #${toothInfo.fdi} [FDI] / #${toothInfo.uni} [US]: ${toothInfo.name}`;
			if (drawerSubtitle) drawerSubtitle.textContent = `${toothInfo.arch === 'upper' ? 'Maxillary Quadrant' : 'Mandibular Quadrant'} • ${toothInfo.branch}`;
			if (drawerSeverity) drawerSeverity.textContent = 'Intact Reference Tooth';
			if (drawerClinicalText) drawerClinicalText.textContent = 'Intact clinical morphology. No defective restorations, margin gaps, or active periodontal breakdown documented in this sector.';
			if (drawerBmsMechanism) drawerBmsMechanism.textContent = 'Serves as a normal reference comparator. Not currently identified as an active nociceptive trigger source in your oral examination.';
			if (metricPocket) metricPocket.textContent = '2mm - 3mm (Normal sulcus)';
			if (metricBop) metricBop.textContent = 'Negative';
			if (metricSensitivity) metricSensitivity.textContent = 'Normal';
			if (metricStressor) metricStressor.textContent = 'None';
		}

		// Highlight selected tooth with rich purple emissive glow
		if (selectedToothMesh) {
			selectedToothMesh.material.color.setHex(0xfaf8f2);
			selectedToothMesh.material.emissive.setHex(0x1c1a17);
		}

		const targetToothKey = key === 'pocket-molar' ? 'tooth-36' : key;
		if (teethMeshes[targetToothKey]) {
			selectedToothMesh = teethMeshes[targetToothKey];
			selectedToothMesh.material.color.setHex(0xffffff);
			selectedToothMesh.material.emissive.setHex(0x9333ea);
			selectedToothMesh.material.emissiveIntensity = 0.65;
		}
	}

	// Update markers and meshes visibility based on view preset and issue filter
	function syncSceneVisibility() {
		// Arch isolation
		if (currentView === 'upper') {
			upperMeshes.forEach(m => m.visible = true);
			lowerMeshes.forEach(m => m.visible = false);
		} else if (currentView === 'lower') {
			upperMeshes.forEach(m => m.visible = false);
			lowerMeshes.forEach(m => m.visible = true);
		} else {
			upperMeshes.forEach(m => m.visible = true);
			lowerMeshes.forEach(m => m.visible = true);
		}

		// Clinical markers visibility
		active3DMarkerObjects.forEach(group => {
			const cat = group.userData.category;
			const arch = group.userData.arch;

			let matchFilter = (activeFilter === 'all' || activeFilter === cat);
			let matchView = (currentView === 'occlusion' || currentView === arch);

			group.visible = matchFilter && matchView;
		});

		// Tooth numbers visibility
		if (toothNumbersGroup) {
			toothNumbersGroup.children.forEach(sprite => {
				const arch = sprite.userData.arch;
				let matchView = (currentView === 'occlusion' || currentView === arch);
				sprite.visible = showNumbers && matchView;
			});
		}
	}

	// Perspective Camera Views
	const VIEW_PRESETS = {
		'occlusion': {
			label: 'Centric Occlusion (Bite Relationship)',
			camPos: [0, 0.45, 11.2],
			target: [0, 0, 0]
		},
		'upper': {
			label: 'Upper Arch (Maxilla & Palate)',
			camPos: [0, -6.2, 5.8],
			target: [0, 1.2, 0.2]
		},
		'lower': {
			label: 'Lower Arch (Mandible & Tooth #36)',
			camPos: [0, 6.2, 5.8],
			target: [0, -0.8, -0.2]
		}
	};

	perspectiveButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			perspectiveButtons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');

			const key = btn.getAttribute('data-view');
			const view = VIEW_PRESETS[key];
			if (!view) return;

			currentView = key;
			if (hudViewLabel) hudViewLabel.textContent = isMirrored ? `${view.label} (Mirror View)` : view.label;

			syncSceneVisibility();

			// Trigger smooth glide to preset
			targetCamPos.set(view.camPos[0], view.camPos[1], view.camPos[2]);
			targetLookAt.set(view.target[0], view.target[1], view.target[2]);
			isCameraAnimating = true;
		});
	});

	// Filter Logic
	filterButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			filterButtons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');

			activeFilter = btn.getAttribute('data-filter') || 'all';
			syncSceneVisibility();

			if (activeFilter === 'crown') updateDiagnosticDrawer('tooth-36');
			else if (activeFilter === 'recession') updateDiagnosticDrawer('tooth-23');
			else if (activeFilter === 'abfraction') updateDiagnosticDrawer('tooth-14');
			else if (activeFilter === 'filling') updateDiagnosticDrawer('tooth-24');
			else if (activeFilter === 'pocket') updateDiagnosticDrawer('pocket-molar');
		});
	});

	// HUD Tools Listeners
	btnNumbers?.addEventListener('click', () => {
		showNumbers = !showNumbers;
		btnNumbers.classList.toggle('active', showNumbers);
		toothNumbersGroup.visible = showNumbers;
		syncSceneVisibility();
	});

	btnMirror?.addEventListener('click', () => {
		isMirrored = !isMirrored;
		btnMirror.classList.toggle('active', isMirrored);

		// Mirror modelGroup horizontally along X
		modelGroup.scale.x = isMirrored ? -1 : 1;

		// Ensure all billboard text sprites stay upright and non-mirrored
		allSprites.forEach(sprite => {
			const base = sprite.userData.baseScaleX || Math.abs(sprite.scale.x);
			sprite.scale.x = isMirrored ? -base : base;
		});

		// Update HUD view label
		if (hudViewLabel) {
			const view = VIEW_PRESETS[currentView] || VIEW_PRESETS['occlusion'];
			hudViewLabel.textContent = isMirrored ? `${view.label} (Mirror View)` : view.label;
		}
	});

	btnSpin?.addEventListener('click', () => {
		isSpinning = !isSpinning;
		btnSpin.classList.toggle('active', isSpinning);
		if (spinLabel) spinLabel.textContent = isSpinning ? 'Pause Spin' : 'Spin 3D';
	});

	btnWireframe?.addEventListener('click', () => {
		isWireframe = !isWireframe;
		btnWireframe.classList.toggle('active', isWireframe);
		toothMaterial.wireframe = isWireframe;
		gingivaMaterial.wireframe = isWireframe;
	});

	btnReset?.addEventListener('click', () => {
		const view = VIEW_PRESETS[currentView] || VIEW_PRESETS['occlusion'];
		targetCamPos.set(view.camPos[0], view.camPos[1], view.camPos[2]);
		targetLookAt.set(view.target[0], view.target[1], view.target[2]);
		isCameraAnimating = true;
	});

	btnBone?.addEventListener('click', () => {
		showBone = !showBone;
		btnBone.classList.toggle('active', showBone);
		boneMeshes.forEach(m => m.visible = showBone);
	});

	// Raycaster for Hover and Click Interaction
	const raycaster = new THREE.Raycaster();
	const mouse = new THREE.Vector2();

	function getIntersectedObject(e) {
		const rect = renderer.domElement.getBoundingClientRect();
		mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
		mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

		raycaster.setFromCamera(mouse, camera);
		const intersects = raycaster.intersectObjects(raycastableObjects, true);

		// Filter for currently visible objects only
		const visibleHits = intersects.filter(hit => {
			let obj = hit.object;
			while (obj && obj !== scene) {
				if (obj.visible === false) return false;
				obj = obj.parent;
			}
			return true;
		});

		return visibleHits.length > 0 ? visibleHits[0].object : null;
	}

	viewport.addEventListener('mousemove', (e) => {
		const hit = getIntersectedObject(e);
		if (hit) {
			viewport.style.cursor = 'pointer';
			let key = hit.name;
			if (hit.userData && hit.userData.id) key = hit.userData.id;
			else if (hit.userData && hit.userData.toothKey) key = hit.userData.toothKey;

			const info = TOOTH_DIRECTORY[key];
			if (info && hudHelperTip) {
				hudHelperTip.innerHTML = `<span>🎯 <strong>Tooth #${info.fdi} [FDI] / #${info.uni} [US]</strong>: ${info.name}</span>`;
			}
		} else {
			viewport.style.cursor = 'grab';
			if (hudHelperTip) {
				hudHelperTip.innerHTML = '<span>🖱️ Drag to rotate 360°</span><span>•</span><span>🔍 Scroll to zoom</span><span>•</span><span>🎯 Click tooth or marker to&nbsp;inspect</span>';
			}
		}
	});

	viewport.addEventListener('click', (e) => {
		const hit = getIntersectedObject(e);
		if (hit) {
			let toothKey = hit.name;
			if (hit.userData && hit.userData.id) {
				toothKey = hit.userData.id;
			} else if (hit.userData && hit.userData.toothKey) {
				toothKey = hit.userData.toothKey;
			}

			if (CLINICAL_RECORDS[toothKey] || TOOTH_DIRECTORY[toothKey]) {
				updateDiagnosticDrawer(toothKey);
			}
		}
	});

	// Resize Handler
	window.addEventListener('resize', () => {
		const newW = container.clientWidth;
		const newH = container.clientHeight;
		if (newW && newH) {
			camera.aspect = newW / newH;
			camera.updateProjectionMatrix();
			renderer.setSize(newW, newH);
		}
	});

	// Render Animation Loop
	function animate() {
		requestAnimationFrame(animate);

		// Turntable Rotation
		if (isSpinning) {
			modelGroup.rotation.y += 0.007;
		}

		// Smooth Camera Transition only when triggered by preset button
		if (isCameraAnimating) {
			camera.position.lerp(targetCamPos, 0.08);
			controls.target.lerp(targetLookAt, 0.08);

			if (camera.position.distanceTo(targetCamPos) < 0.03 && controls.target.distanceTo(targetLookAt) < 0.03) {
				isCameraAnimating = false;
			}
		}

		controls.update();
		renderer.render(scene, camera);
	}

	animate();
})();
</script>
