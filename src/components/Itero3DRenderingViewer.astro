---
// Itero3DRenderingViewer.astro
// True 3D Dental Arch Anatomy & Clinical Issue Map with Physically-Attached 3D Sprites
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`dental-arch-wrapper ${className}`}>
	<div class="dental-arch-card">
		<!-- Top Bar Header -->
		<div class="arch-topbar">
			<div class="arch-title-group">
				<span class="status-indicator"></span>
				<span class="arch-main-title">3D Dental Arch Anatomy &amp; Clinical Issue&nbsp;Map</span>
			</div>
			<div class="arch-meta-details">
				<span>BodyParts3D Anatomical Reference</span>
				<span class="meta-separator">•</span>
				<span>FDI &amp; Universal Numbering</span>
				<span class="meta-separator">•</span>
				<span>Denis Ethier Diagnostic&nbsp;Audit</span>
			</div>
		</div>

		<!-- Main 3D Viewport & Interactive Stage (820px Tall) -->
		<div class="arch-viewport" id="archViewport">
			<!-- Three.js Canvas Mount Container -->
			<div id="threeArchContainer" class="three-arch-container"></div>

			<!-- Loading Indicator Overlay -->
			<div id="archLoadingOverlay" class="arch-loading-overlay">
				<div class="loading-spinner"></div>
				<span class="loading-text">Loading 3D Dental Arch Anatomy...</span>
			</div>

			<!-- Viewport Floating HUD Controls -->
			<div class="arch-hud-top">
				<div class="hud-view-label" id="hudViewLabel">Centric Occlusion (Bite Relationship)</div>
				<div class="hud-helper-tip" id="hudHelperTip">
					<span>🖱️ Drag to rotate 360°</span>
					<span>•</span>
					<span>🔍 Scroll to zoom</span>
					<span>•</span>
					<span>🎯 Click tooth or marker to&nbsp;inspect</span>
				</div>
			</div>

			<!-- HUD Tools (Tooth Numbers, Mirror View, Auto-Spin, Wireframe, Center, Jawbone) -->
			<div class="arch-hud-tools">
				<button type="button" class="hud-btn" id="btnToggleNumbers" title="Toggle Tooth Numbers (#11 to #48 / US #1 to #32)">
					<span>🔢 Numbers</span>
				</button>
				<button type="button" class="hud-btn" id="btnToggleMirror" title="Toggle Mirror View (Patient Perspective)">
					<span id="mirrorIcon">🪞</span>
					<span id="mirrorLabel">Mirror View</span>
				</button>
				<button type="button" class="hud-btn" id="btnToggleSpin" title="Toggle Turntable 3D Spin">
					<span id="spinIcon">🔄</span>
					<span id="spinLabel">Spin 3D</span>
				</button>
				<button type="button" class="hud-btn" id="btnToggleWireframe" title="Toggle 3D Wireframe Mesh">
					<span>🕸️ Wireframe</span>
				</button>
				<button type="button" class="hud-btn" id="btnResetView" title="Reset 3D Camera">
					<span>🎯 Center</span>
				</button>
				<button type="button" class="hud-btn" id="btnToggleBone" title="Toggle Alveolar Bone">
					<span>🦴 Jawbone</span>
				</button>
			</div>
		</div>

		<!-- Perspective Selector Bar (Core Arch Views) -->
		<div class="arch-perspective-bar" role="tablist" aria-label="3D Anatomical Views">
			<button type="button" class="perspective-btn active" data-view="occlusion">
				<span>Centric Occlusion (Bite&nbsp;Relationship)</span>
			</button>
			<button type="button" class="perspective-btn" data-view="upper">
				<span>Upper Arch (Maxilla &amp;&nbsp;Palate)</span>
			</button>
			<button type="button" class="perspective-btn" data-view="lower">
				<span>Lower Arch (Mandible &amp; Tooth&nbsp;#36)</span>
			</button>
		</div>

		<!-- Issue Category Filter Buttons -->
		<div class="arch-filter-bar">
			<span class="filter-heading">Diagnostic Issue Filters:</span>
			<div class="filter-buttons">
				<button type="button" class="filter-btn active" data-filter="all">
					<span class="filter-dot dot-all"></span>
					<span>All Clinical Issues</span>
				</button>
				<button type="button" class="filter-btn" data-filter="crown">
					<span class="filter-dot dot-crown"></span>
					<span>Crown Defect (#36)</span>
				</button>
				<button type="button" class="filter-btn" data-filter="recession">
					<span class="filter-dot dot-recession"></span>
					<span>Recessions &amp; Allodynia</span>
				</button>
				<button type="button" class="filter-btn" data-filter="abfraction">
					<span class="filter-dot dot-abfraction"></span>
					<span>Abfractions &amp; Wear</span>
				</button>
				<button type="button" class="filter-btn" data-filter="filling">
					<span class="filter-dot dot-filling"></span>
					<span>Fillings &amp; Overcontours</span>
				</button>
				<button type="button" class="filter-btn" data-filter="pocket">
					<span class="filter-dot dot-pocket"></span>
					<span>Periodontal Pockets</span>
				</button>
			</div>
		</div>

		<!-- Diagnostic Clinical Drawer -->
		<div class="arch-diagnostic-drawer" id="archDrawer">
			<div class="drawer-header-row">
				<div class="drawer-title-block">
					<h3 class="drawer-tooth-title" id="drawerTitle">Tooth #36 [FDI] / #19 [US]: Defective Distal Crown Margin &amp; Hidden&nbsp;Cavities</h3>
					<span class="drawer-quadrant-sub" id="drawerSubtitle">Lower Left First Molar • Mandibular Quadrant • Trigeminal Branch&nbsp;V3</span>
				</div>
				<div class="drawer-severity-label" id="drawerSeverity">Primary Neuropathic Trigger</div>
			</div>

			<div class="drawer-content-layout">
				<div class="drawer-text-block">
					<h4 class="drawer-section-heading">Clinical Chart &amp; Independent Radiograph Finding</h4>
					<p class="drawer-body-text" id="drawerClinicalText">
						Florida Probe periodontal charting confirmed a defective distal crown margin ("#36D joint au distal"). An independent radiograph audit uncovered three hidden recurrent cavities undermining the enamel and dentin beneath the 20-year-old restoration.
					</p>

					<h4 class="drawer-section-heading" style="margin-top: 1.15rem;">Direct Neuropathic Mechanism in Burning Mouth Syndrome</h4>
					<p class="drawer-body-text" id="drawerBmsMechanism">
						Because this mechanical margin sits subgingivally, it acts as a permanent incubator for anaerobic bacterial biofilm. Microorganisms pump lactic and acetic acids directly into exposed dentinal tubules, constantly stimulating the inferior alveolar nerve and sensitizing the trigeminal&nbsp;system.
					</p>
				</div>

				<div class="drawer-metrics-grid">
					<div class="metric-card">
						<span class="metric-label">Sulcus / Pocket Depth</span>
						<span class="metric-value" id="metricPocket">3mm - 4mm</span>
					</div>
					<div class="metric-card">
						<span class="metric-label">Bleeding on Probing (BOP)</span>
						<span class="metric-value critical" id="metricBop">Positive (9% total sites)</span>
					</div>
					<div class="metric-card">
						<span class="metric-label">Mechanical Sensitivity</span>
						<span class="metric-value warning" id="metricSensitivity">Extreme Hyperalgesia</span>
					</div>
					<div class="metric-card">
						<span class="metric-label">Biological Stressor</span>
						<span class="metric-value" id="metricStressor">Acid &amp; Plaque Trap</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	/* 90% Viewport Width Breakout Container */
	.dental-arch-wrapper {
		margin: 3.5rem 0 4rem 0;
		width: 90vw;
		max-width: 1400px;
		position: relative;
		left: 50%;
		transform: translateX(-50%);
		box-sizing: border-box;
		font-family: var(--font-body, system-ui, sans-serif);
	}

	@media (max-width: 768px) {
		.dental-arch-wrapper {
			width: 95vw;
			margin: 2rem 0 2.5rem 0;
		}
	}

	.dental-arch-card {
		background: #090614;
		border: 1px solid rgba(168, 85, 247, 0.35);
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.75), 0 0 35px rgba(168, 85, 247, 0.12);
		position: relative;
	}

	/* Top Bar Header */
	.arch-topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.15rem 1.6rem;
		background: rgba(18, 12, 38, 0.85);
		border-bottom: 1px solid rgba(168, 85, 247, 0.2);
		flex-wrap: wrap;
		gap: 0.8rem;
	}

	.arch-title-group {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
	}

	.status-indicator {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #10b981;
		box-shadow: 0 0 10px #10b981;
	}

	.arch-main-title {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.4;
		color: #ffffff;
		letter-spacing: -0.01em;
	}

	.arch-meta-details {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		font-size: 0.82rem;
		line-height: 1.5;
		color: #94a3b8;
		flex-wrap: wrap;
	}

	.meta-separator {
		color: #64748b;
	}

	/* 820px Tall 3D Viewport Stage */
	.arch-viewport {
		position: relative;
		width: 100%;
		height: 820px;
		min-height: 820px;
		background: radial-gradient(circle at center, #1c113b 0%, #06030c 100%);
		overflow: hidden;
		cursor: grab;
		user-select: none;
	}

	@media (max-width: 860px) {
		.arch-viewport {
			height: 650px;
			min-height: 650px;
		}
	}

	@media (max-width: 580px) {
		.arch-viewport {
			height: 520px;
			min-height: 520px;
		}
	}

	.arch-viewport:active {
		cursor: grabbing;
	}

	.three-arch-container {
		width: 100%;
		height: 100%;
		display: block;
	}

	.three-arch-container canvas {
		width: 100% !important;
		height: 100% !important;
		display: block;
	}

	/* Loading Overlay */
	.arch-loading-overlay {
		position: absolute;
		inset: 0;
		background: rgba(9, 6, 20, 0.94);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.1rem;
		z-index: 50;
		transition: opacity 0.4s ease;
	}

	.arch-loading-overlay.hidden {
		opacity: 0;
		pointer-events: none;
	}

	.loading-spinner {
		width: 46px;
		height: 46px;
		border: 3px solid rgba(168, 85, 247, 0.2);
		border-top-color: #a855f7;
		border-radius: 50%;
		animation: spin 1s infinite linear;
	}

	@keyframes spin {
		to { transform: rotate(360deg); }
	}

	.loading-text {
		color: #cbd5e1;
		font-size: 0.9rem;
		line-height: 1.4;
		font-weight: 600;
	}

	/* Floating HUD Controls */
	.arch-hud-top {
		position: absolute;
		top: 1.15rem;
		left: 1.15rem;
		right: 1.15rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		pointer-events: none;
		z-index: 10;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.hud-view-label {
		background: rgba(12, 8, 26, 0.88);
		border: 1px solid rgba(168, 85, 247, 0.4);
		padding: 0.45rem 0.9rem;
		border-radius: 8px;
		font-size: 0.84rem;
		font-weight: 600;
		line-height: 1.4;
		color: #e9d5ff;
		backdrop-filter: blur(8px);
	}

	.hud-helper-tip {
		background: rgba(12, 8, 26, 0.78);
		border: 1px solid rgba(255, 255, 255, 0.1);
		padding: 0.45rem 0.9rem;
		border-radius: 8px;
		font-size: 0.78rem;
		line-height: 1.4;
		color: #94a3b8;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		backdrop-filter: blur(8px);
	}

	@media (max-width: 640px) {
		.hud-helper-tip {
			display: none;
		}
	}

	.arch-hud-tools {
		position: absolute;
		bottom: 1.15rem;
		right: 1.15rem;
		display: flex;
		gap: 0.5rem;
		z-index: 10;
		flex-wrap: wrap;
	}

	.hud-btn {
		background: rgba(18, 12, 38, 0.88);
		border: 1px solid rgba(168, 85, 247, 0.35);
		color: #e2e8f0;
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1.4;
		padding: 0.45rem 0.85rem;
		border-radius: 8px;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		transition: all 0.2s ease;
		backdrop-filter: blur(8px);
	}

	.hud-btn:hover {
		background: rgba(168, 85, 247, 0.25);
		border-color: #a855f7;
		color: #ffffff;
		transform: translateY(-1px);
	}

	.hud-btn.active {
		background: #a855f7;
		color: #ffffff;
		border-color: #c084fc;
		box-shadow: 0 0 14px rgba(168, 85, 247, 0.5);
	}

	/* Perspective Selector Bar */
	.arch-perspective-bar {
		display: flex;
		background: rgba(18, 12, 38, 0.95);
		border-bottom: 1px solid rgba(168, 85, 247, 0.2);
		padding: 0.5rem;
		gap: 0.5rem;
		overflow-x: auto;
	}

	.perspective-btn {
		flex: 1;
		min-width: 170px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
		color: #cbd5e1;
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1.4;
		padding: 0.65rem 1rem;
		border-radius: 10px;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	.perspective-btn:hover {
		background: rgba(168, 85, 247, 0.15);
		border-color: rgba(168, 85, 247, 0.4);
		color: #ffffff;
	}

	.perspective-btn.active {
		background: linear-gradient(135deg, rgba(168, 85, 247, 0.3) 0%, rgba(147, 51, 234, 0.2) 100%);
		border-color: #a855f7;
		color: #ffffff;
		box-shadow: 0 0 15px rgba(168, 85, 247, 0.25);
	}

	/* Filter Bar */
	.arch-filter-bar {
		display: flex;
		align-items: center;
		padding: 0.95rem 1.6rem;
		background: rgba(12, 8, 26, 0.9);
		border-bottom: 1px solid rgba(168, 85, 247, 0.15);
		gap: 1.1rem;
		flex-wrap: wrap;
	}

	.filter-heading {
		font-size: 0.82rem;
		font-weight: 600;
		line-height: 1.45;
		color: #94a3b8;
	}

	.filter-buttons {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		flex-wrap: wrap;
	}

	.filter-btn {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: #cbd5e1;
		font-size: 0.78rem;
		font-weight: 500;
		line-height: 1.4;
		padding: 0.38rem 0.8rem;
		border-radius: 6px;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		transition: all 0.2s ease;
	}

	.filter-btn:hover {
		background: rgba(255, 255, 255, 0.08);
		color: #ffffff;
	}

	.filter-btn.active {
		background: rgba(168, 85, 247, 0.22);
		border-color: #a855f7;
		color: #ffffff;
	}

	.filter-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}

	.dot-all { background: #ffffff; }
	.dot-crown { background: #ef4444; }
	.dot-recession { background: #f97316; }
	.dot-abfraction { background: #eab308; }
	.dot-filling { background: #38bdf8; }
	.dot-pocket { background: #a855f7; }

	/* Diagnostic Drawer */
	.arch-diagnostic-drawer {
		padding: 1.8rem 2rem;
		background: #0d081a;
	}

	.drawer-header-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 1.35rem;
		flex-wrap: wrap;
		gap: 0.85rem;
	}

	.drawer-title-block {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.drawer-tooth-title {
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.35;
		color: #ffffff;
		margin: 0;
		letter-spacing: -0.015em;
	}

	.drawer-quadrant-sub {
		font-size: 0.85rem;
		line-height: 1.5;
		color: #a855f7;
		font-weight: 500;
	}

	/* Clean severity typography without pill bubble container */
	.drawer-severity-label {
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1.35;
		color: #f87171;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.drawer-content-layout {
		display: grid;
		grid-template-columns: 1.45fr 1fr;
		gap: 1.75rem;
	}

	@media (max-width: 860px) {
		.drawer-content-layout {
			grid-template-columns: 1fr;
			gap: 1.35rem;
		}
	}

	.drawer-section-heading {
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1.45;
		color: #c084fc;
		margin: 0 0 0.4rem 0;
	}

	.drawer-body-text {
		font-size: 0.95rem;
		line-height: 1.7;
		color: #cbd5e1;
		margin: 0;
	}

	.drawer-metrics-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
	}

	.metric-card {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(168, 85, 247, 0.2);
		border-radius: 10px;
		padding: 0.85rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.metric-label {
		font-size: 0.74rem;
		line-height: 1.4;
		color: #94a3b8;
		font-weight: 500;
	}

	.metric-value {
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.35;
		color: #ffffff;
	}

	.metric-value.critical {
		color: #ef4444;
	}

	.metric-value.warning {
		color: #f97316;
	}
</style>

<!-- Load Three.js core, GLTFLoader, and OrbitControls -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" is:inline></script>
<script src="/vendor/three/GLTFLoader.js" is:inline></script>
<script src="/vendor/three/OrbitControls.js" is:inline></script>

<script is:inline>
(() => {
	const container = document.getElementById('threeArchContainer');
	const viewport = document.getElementById('archViewport');
	const loadingOverlay = document.getElementById('archLoadingOverlay');
	const hudViewLabel = document.getElementById('hudViewLabel');
	const hudHelperTip = document.getElementById('hudHelperTip');

	const btnNumbers = document.getElementById('btnToggleNumbers');
	const btnMirror = document.getElementById('btnToggleMirror');
	const mirrorLabel = document.getElementById('mirrorLabel');
	const btnSpin = document.getElementById('btnToggleSpin');
	const spinLabel = document.getElementById('spinLabel');
	const btnWireframe = document.getElementById('btnToggleWireframe');
	const btnReset = document.getElementById('btnResetView');
	const btnBone = document.getElementById('btnToggleBone');

	const perspectiveButtons = document.querySelectorAll('.perspective-btn');
	const filterButtons = document.querySelectorAll('.filter-btn');

	const drawerTitle = document.getElementById('drawerTitle');
	const drawerSubtitle = document.getElementById('drawerSubtitle');
	const drawerSeverity = document.getElementById('drawerSeverity');
	const drawerClinicalText = document.getElementById('drawerClinicalText');
	const drawerBmsMechanism = document.getElementById('drawerBmsMechanism');
	const metricPocket = document.getElementById('metricPocket');
	const metricBop = document.getElementById('metricBop');
	const metricSensitivity = document.getElementById('metricSensitivity');
	const metricStressor = document.getElementById('metricStressor');

	if (!container || typeof THREE === 'undefined') return;

	// Three.js Scene Setup
	const scene = new THREE.Scene();
	scene.background = null;

	const width = container.clientWidth || 960;
	const height = container.clientHeight || 820;

	const camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);
	camera.position.set(0, 0.45, 11.2);

	const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
	renderer.setSize(width, height);
	renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
	renderer.toneMapping = THREE.ACESFilmicToneMapping;
	renderer.toneMappingExposure = 1.1;
	container.appendChild(renderer.domElement);

	// Orbit Controls
	const controls = new THREE.OrbitControls(camera, renderer.domElement);
	controls.enableDamping = true;
	controls.dampingFactor = 0.08;
	controls.maxDistance = 24;
	controls.minDistance = 3.5;
	controls.target.set(0, 0, 0);

	// Camera animation control: user interaction stops preset animation immediately
	let isCameraAnimating = false;
	const targetCamPos = new THREE.Vector3(0, 0.45, 11.2);
	const targetLookAt = new THREE.Vector3(0, 0, 0);

	controls.addEventListener('start', () => {
		isCameraAnimating = false;
	});

	// Studio Lighting Setup
	const ambientLight = new THREE.AmbientLight(0xffffff, 0.95);
	scene.add(ambientLight);

	const keyLight = new THREE.DirectionalLight(0xfff7ee, 1.4);
	keyLight.position.set(6, 8, 8);
	scene.add(keyLight);

	const fillLight = new THREE.DirectionalLight(0xc084fc, 0.7);
	fillLight.position.set(-7, 4, -5);
	scene.add(fillLight);

	const blueRimLight = new THREE.DirectionalLight(0x38bdf8, 0.85);
	blueRimLight.position.set(0, -6, 5);
	scene.add(blueRimLight);

	// Floor Grid
	const grid = new THREE.GridHelper(12, 24, 0xa855f7, 0x241242);
	grid.position.y = -2.6;
	scene.add(grid);

