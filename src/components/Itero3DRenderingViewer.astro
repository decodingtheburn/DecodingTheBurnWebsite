			category: 'filling',
			label: '#26 Composite Overcontour',
			color: 0x38bdf8,
			colorHex: '#38bdf8',
			targetY: 3.50,
			radiusOffset: 1.70
		}
	];

	const active3DMarkerObjects = [];

	// Compute outward normal unit vector from the oral cavity center (0, 0, 0.15) through the tooth
	function getToothOutwardVector(mesh) {
		const dx = mesh.position.x;
		const dz = mesh.position.z - 0.15;
		const len = Math.hypot(dx, dz) || 1;
		return { x: dx / len, z: dz / len };
	}

	// Load 3D GLB Model
	const loader = new THREE.GLTFLoader();
	loader.load(
		'/models/dental-arch-opt.glb',
		(gltf) => {
			gltf.scene.traverse((child) => {
				if (child.isMesh) {
					if (child.geometry && !child.geometry.attributes.normal) {
						child.geometry.computeVertexNormals();
					}

					const name = child.name || '';
					if (name.startsWith('tooth-')) {
						const isWisdom = (name === 'tooth-18' || name === 'tooth-28' || name === 'tooth-38' || name === 'tooth-48');
						if (isWisdom) {
							// Denis does not have wisdom teeth: keep meshes hidden so 3D model reflects his mouth
							child.visible = false;
							return;
						}

						child.material = toothMaterial.clone();
						teethMeshes[name] = child;
						raycastableObjects.push(child);

						const dir = TOOTH_DIRECTORY[name];
						if (dir && dir.arch === 'upper') {
							upperMeshes.push(child);
						} else {
							lowerMeshes.push(child);
						}
					} else if (name === 'gingiva-upper') {
						child.material = gingivaMaterial.clone();
						upperMeshes.push(child);
					} else if (name === 'gingiva-lower') {
						child.material = gingivaMaterial.clone();
						lowerMeshes.push(child);
					} else if (name.includes('alveolar') || name.includes('mandible') || name.includes('maxilla')) {
						child.material = boneMaterial;
						child.visible = false;
						boneMeshes.push(child);
					} else if (name.includes('sinus') || name.includes('condyle')) {
						child.visible = false;
					}
				}
			});

			modelGroup.add(gltf.scene);

			// Build True 3D Clinical Issue Markers physically attached to exact teeth
			CLINICAL_3D_MARKERS.forEach(item => {
				const toothMesh = teethMeshes[item.tooth];
				if (!toothMesh) return;

				const markerGroup = new THREE.Group();
				markerGroup.userData = { id: item.id, category: item.category, arch: item.arch };

				const outVec = getToothOutwardVector(toothMesh);
				const isUpper = item.arch === 'upper';

				if (!toothMesh.geometry.boundingBox) toothMesh.geometry.computeBoundingBox();
				const bMin = toothMesh.geometry.boundingBox.min;
				const bMax = toothMesh.geometry.boundingBox.max;
				const worldMinY = toothMesh.position.y + bMin.y;
				const worldMaxY = toothMesh.position.y + bMax.y;
				const crownY = isUpper
					? worldMinY + (worldMaxY - worldMinY) * 0.26
					: worldMaxY - (worldMaxY - worldMinY) * 0.26;

				// 1. Glowing 3D Beacon Dot right on the outer visible enamel/cervical tooth surface
				const dotDist = 0.50;
				const dotPos = new THREE.Vector3(
					toothMesh.position.x + outVec.x * dotDist,
					crownY,
					toothMesh.position.z + outVec.z * dotDist
				);
				const beacon = createBeaconSphere(item.color, 0.14);
				beacon.position.copy(dotPos);
				beacon.userData = { id: item.id };
				beacon.lookAt(dotPos.clone().add(new THREE.Vector3(outVec.x, 0, outVec.z)));
				markerGroup.add(beacon);

				// 2. High/Low Floating Billboard Badge (completely outside teeth and gums)
				const sprite = createClinicalSprite(item.label, item.colorHex);
				const targetY = item.targetY || (isUpper ? 2.7 : -2.5);
				const badgeDist = item.radiusOffset || (isUpper ? 1.55 : 1.85);
				const badgePos = new THREE.Vector3(
					toothMesh.position.x + outVec.x * badgeDist,
					targetY,
					toothMesh.position.z + outVec.z * badgeDist
				);
				sprite.position.copy(badgePos);
				sprite.userData = { id: item.id };
				markerGroup.add(sprite);

				// 3. Solid 3D Stem Cylinder connecting the tooth surface dot to the floating badge
				const stem = createStemCylinder(dotPos, badgePos, item.color, 0.018);
				stem.userData = { id: item.id };
				markerGroup.add(stem);

				// 4. Directional Arrow Cone pointing directly at the tooth dot
				const arrowDir = isUpper ? new THREE.Vector3(0, -1, 0) : new THREE.Vector3(0, 1, 0);
				const arrowCone = createArrowCone(dotPos, arrowDir, item.color);
				arrowCone.userData = { id: item.id };
				markerGroup.add(arrowCone);

				clinicalMarkersGroup.add(markerGroup);
				active3DMarkerObjects.push(markerGroup);
				raycastableObjects.push(beacon, sprite, stem, arrowCone);
			});

			// Build Clean 3D Tooth Number Badges (#11 to #47) interlinked with dot + stem (28 active teeth)
			Object.entries(teethMeshes).forEach(([toothName, mesh]) => {
				if (toothName === 'tooth-18' || toothName === 'tooth-28' || toothName === 'tooth-38' || toothName === 'tooth-48') {
					// Denis had all wisdom teeth extracted: skip generating tooth number badges
					return;
				}
				const dir = TOOTH_DIRECTORY[toothName];
				const numStr = dir ? `#${dir.fdi}` : toothName.replace('tooth-', '#');
				const isUpper = dir ? dir.arch === 'upper' : mesh.position.y > 0;
				const outVec = getToothOutwardVector(mesh);

				if (!mesh.geometry.boundingBox) mesh.geometry.computeBoundingBox();
				const bMin = mesh.geometry.boundingBox.min;
				const bMax = mesh.geometry.boundingBox.max;
				const worldMinY = mesh.position.y + bMin.y;
				const worldMaxY = mesh.position.y + bMax.y;
				const crownY = isUpper
					? worldMinY + (worldMaxY - worldMinY) * 0.26
					: worldMaxY - (worldMaxY - worldMinY) * 0.26;

				const numGroup = new THREE.Group();
				numGroup.userData = { toothKey: toothName, arch: isUpper ? 'upper' : 'lower' };

				// 1. Tooth Surface Dot (Luminous emerald green bead right on the tooth enamel)
				const dotGeom = new THREE.SphereGeometry(0.08, 12, 12);
				const dotMat = new THREE.MeshStandardMaterial({
					color: 0x10b981,
					emissive: 0x059669,
					emissiveIntensity: 1.2,
					roughness: 0.15,
					depthTest: true,
					depthWrite: false
				});
				const surfaceDot = new THREE.Mesh(dotGeom, dotMat);
				const dotDist = 0.50;
				const dotPos = new THREE.Vector3(
					mesh.position.x + outVec.x * dotDist,
					crownY,
					mesh.position.z + outVec.z * dotDist
				);
				surfaceDot.position.copy(dotPos);
				surfaceDot.userData = { toothKey: toothName };
				numGroup.add(surfaceDot);

				// 2. Interlinking Stem Line in emerald green
				const badgeDist = isUpper ? 1.45 : 1.70;
				const badgeY = isUpper ? (crownY + 0.62) : (crownY - 0.50);
				const badgePos = new THREE.Vector3(
					mesh.position.x + outVec.x * badgeDist,
					badgeY,
					mesh.position.z + outVec.z * badgeDist
				);
				const stem = createStemCylinder(dotPos, badgePos, 0x10b981, 0.014);
				stem.userData = { toothKey: toothName };
				numGroup.add(stem);

				// 3. Compact Dark Green Number Badge (pure drop shadow, emerald border, white text)
				const numSprite = createToothNumberSprite(numStr);
				numSprite.position.copy(badgePos);
				numSprite.userData = { toothKey: toothName, arch: isUpper ? 'upper' : 'lower' };
				numGroup.add(numSprite);

				toothNumbersGroup.add(numGroup);
				raycastableObjects.push(numSprite, surfaceDot, stem);
			});

			if (loadingOverlay) loadingOverlay.classList.add('hidden');
			updateDiagnosticDrawer('tooth-36');
		},
		undefined,
		(err) => {
			console.warn('Error loading dental arch GLB:', err);
			if (loadingOverlay) {
				loadingOverlay.innerHTML = '<span style="color:#f87171;">Failed to load 3D model</span>';
			}
		}
	);

	// Update Diagnostic Drawer
	function updateDiagnosticDrawer(key) {
		const rec = CLINICAL_RECORDS[key];
		const toothInfo = TOOTH_DIRECTORY[key];

		if (rec) {
			if (drawerTitle) drawerTitle.textContent = rec.name;
			if (drawerSubtitle) drawerSubtitle.textContent = rec.subtitle;
			if (drawerSeverity) drawerSeverity.textContent = rec.severity;
			if (drawerClinicalText) drawerClinicalText.textContent = rec.clinical;
			if (drawerBmsMechanism) drawerBmsMechanism.textContent = rec.mechanism;
			if (metricPocket) metricPocket.textContent = rec.pocket;
			if (metricBop) metricBop.textContent = rec.bop;
			if (metricSensitivity) metricSensitivity.textContent = rec.sensitivity;
			if (metricStressor) metricStressor.textContent = rec.stressor;
		} else if (toothInfo) {
			if (toothInfo.extracted) {
				if (drawerTitle) drawerTitle.textContent = `Tooth #${toothInfo.fdi} [FDI] / #${toothInfo.uni} [US]: ${toothInfo.name}`;
				if (drawerSubtitle) drawerSubtitle.textContent = `${toothInfo.arch === 'upper' ? 'Maxillary Quadrant' : 'Mandibular Quadrant'} • ${toothInfo.branch}`;
				if (drawerSeverity) drawerSeverity.textContent = 'Surgically Extracted Wisdom Tooth';
				if (drawerClinicalText) drawerClinicalText.textContent = 'Denis had all third molars (wisdom teeth #18, #28, #38, #48) surgically extracted. This tooth is naturally absent in his dentition.';
				if (drawerBmsMechanism) drawerBmsMechanism.textContent = 'Historical extraction site. No retained root fragments or residual alveolar osteitis identified in independent audits.';
				if (metricPocket) metricPocket.textContent = 'N/A (Tooth absent)';
				if (metricBop) metricBop.textContent = 'None';
				if (metricSensitivity) metricSensitivity.textContent = 'None';
				if (metricStressor) metricStressor.textContent = 'None (Extracted)';
			} else {
				if (drawerTitle) drawerTitle.textContent = `Tooth #${toothInfo.fdi} [FDI] / #${toothInfo.uni} [US]: ${toothInfo.name}`;
				if (drawerSubtitle) drawerSubtitle.textContent = `${toothInfo.arch === 'upper' ? 'Maxillary Quadrant' : 'Mandibular Quadrant'} • ${toothInfo.branch}`;
				if (drawerSeverity) drawerSeverity.textContent = 'Intact Reference Tooth';
				if (drawerClinicalText) drawerClinicalText.textContent = 'Intact clinical morphology. No defective restorations, margin gaps, or active periodontal breakdown documented in this sector.';
				if (drawerBmsMechanism) drawerBmsMechanism.textContent = 'Serves as a normal reference comparator. Not currently identified as an active nociceptive trigger source in your oral examination.';
				if (metricPocket) metricPocket.textContent = '2mm - 3mm (Normal sulcus)';
				if (metricBop) metricBop.textContent = 'Negative';
				if (metricSensitivity) metricSensitivity.textContent = 'Normal';
				if (metricStressor) metricStressor.textContent = 'None';
			}
		}

		// Highlight selected tooth with rich purple emissive glow
		if (selectedToothMesh) {
			selectedToothMesh.material.color.setHex(0xfaf8f2);
			selectedToothMesh.material.emissive.setHex(0x1c1a17);
		}

		const markerDef = CLINICAL_3D_MARKERS.find(m => m.id === key);
		const targetToothKey = markerDef ? markerDef.tooth : (key === 'pocket-molar' ? 'tooth-36' : key);
		if (teethMeshes[targetToothKey]) {
			selectedToothMesh = teethMeshes[targetToothKey];
			selectedToothMesh.material.color.setHex(0xffffff);
			selectedToothMesh.material.emissive.setHex(0x9333ea);
			selectedToothMesh.material.emissiveIntensity = 0.65;
		}
	}

	// Update markers and meshes visibility based on view preset and issue filter
	function syncSceneVisibility() {
		// Arch isolation
		if (currentView === 'upper') {
			upperMeshes.forEach(m => m.visible = true);
			lowerMeshes.forEach(m => m.visible = false);
		} else if (currentView === 'lower') {
			upperMeshes.forEach(m => m.visible = false);
			lowerMeshes.forEach(m => m.visible = true);
		} else {
			upperMeshes.forEach(m => m.visible = true);
			lowerMeshes.forEach(m => m.visible = true);
		}

		// Clinical markers visibility
		active3DMarkerObjects.forEach(group => {
			const cat = group.userData.category;
			const arch = group.userData.arch;

			let matchFilter = (activeFilter === 'all' || activeFilter === cat);
			let matchView = (currentView === 'occlusion' || currentView === arch);

			group.visible = matchFilter && matchView;
		});

		// Tooth numbers visibility
		if (toothNumbersGroup) {
			toothNumbersGroup.children.forEach(sprite => {
				const arch = sprite.userData.arch;
				let matchView = (currentView === 'occlusion' || currentView === arch);
				sprite.visible = showNumbers && matchView;
			});
		}
	}

	// Perspective Camera Views
	const VIEW_PRESETS = {
		'occlusion': {
			label: 'Centric Occlusion (Bite Relationship)',
			camPos: [0, 0.45, 11.2],
			target: [0, 0, 0]
		},
		'upper': {
			label: 'Upper Arch (Maxilla & Palate)',
			camPos: [0, -6.2, 5.8],
			target: [0, 1.2, 0.2]
		},
		'lower': {
			label: 'Lower Arch (Mandible & Tooth #36)',
			camPos: [0, 6.2, 5.8],
			target: [0, -0.8, -0.2]
		}
	};

	perspectiveButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			perspectiveButtons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');

			const key = btn.getAttribute('data-view');
			const view = VIEW_PRESETS[key];
			if (!view) return;

			currentView = key;
			if (hudViewLabel) hudViewLabel.textContent = isMirrored ? `${view.label} (Mirror View)` : view.label;

			syncSceneVisibility();

			// Trigger smooth glide to preset
			targetCamPos.set(view.camPos[0], view.camPos[1], view.camPos[2]);
			targetLookAt.set(view.target[0], view.target[1], view.target[2]);
			isCameraAnimating = true;
		});
	});

	// Filter Logic
	filterButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			filterButtons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');

			activeFilter = btn.getAttribute('data-filter') || 'all';
			syncSceneVisibility();

			if (activeFilter === 'crown') updateDiagnosticDrawer('tooth-36');
			else if (activeFilter === 'recession') updateDiagnosticDrawer('tooth-23');
			else if (activeFilter === 'abfraction') updateDiagnosticDrawer('tooth-14');
			else if (activeFilter === 'filling') updateDiagnosticDrawer('tooth-24');
			else if (activeFilter === 'pocket') updateDiagnosticDrawer('pocket-molar');
		});
	});

	// HUD Tools Listeners
	btnNumbers?.addEventListener('click', () => {
		showNumbers = !showNumbers;
		btnNumbers.classList.toggle('active', showNumbers);
		toothNumbersGroup.visible = showNumbers;
		syncSceneVisibility();
	});

	btnMirror?.addEventListener('click', () => {
		isMirrored = !isMirrored;
		btnMirror.classList.toggle('active', isMirrored);

		// Mirror modelGroup horizontally along X
		modelGroup.scale.x = isMirrored ? -1 : 1;

		// Ensure all billboard text sprites stay upright and non-mirrored
		allSprites.forEach(sprite => {
			const base = sprite.userData.baseScaleX || Math.abs(sprite.scale.x);
			sprite.scale.x = isMirrored ? -base : base;
		});

		// Update HUD view label
		if (hudViewLabel) {
			const view = VIEW_PRESETS[currentView] || VIEW_PRESETS['occlusion'];
			hudViewLabel.textContent = isMirrored ? `${view.label} (Mirror View)` : view.label;
		}
	});

	btnSpin?.addEventListener('click', () => {
		isSpinning = !isSpinning;
		btnSpin.classList.toggle('active', isSpinning);
		if (spinLabel) spinLabel.textContent = isSpinning ? 'Pause Spin' : 'Spin 3D';
	});

	btnWireframe?.addEventListener('click', () => {
		isWireframe = !isWireframe;
		btnWireframe.classList.toggle('active', isWireframe);
		toothMaterial.wireframe = isWireframe;
		gingivaMaterial.wireframe = isWireframe;
	});

	btnReset?.addEventListener('click', () => {
		const view = VIEW_PRESETS[currentView] || VIEW_PRESETS['occlusion'];
		targetCamPos.set(view.camPos[0], view.camPos[1], view.camPos[2]);
		targetLookAt.set(view.target[0], view.target[1], view.target[2]);
		isCameraAnimating = true;
	});

	btnBone?.addEventListener('click', () => {
		showBone = !showBone;
		btnBone.classList.toggle('active', showBone);
		boneMeshes.forEach(m => m.visible = showBone);
	});

	// Raycaster for Hover and Click Interaction
	const raycaster = new THREE.Raycaster();
	const mouse = new THREE.Vector2();

	function getIntersectedObject(e) {
		const rect = renderer.domElement.getBoundingClientRect();
		mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
		mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

		raycaster.setFromCamera(mouse, camera);
		const intersects = raycaster.intersectObjects(raycastableObjects, true);

		// Filter for currently visible objects only
		const visibleHits = intersects.filter(hit => {
			let obj = hit.object;
			while (obj && obj !== scene) {
				if (obj.visible === false) return false;
				obj = obj.parent;
			}
			return true;
		});

		return visibleHits.length > 0 ? visibleHits[0].object : null;
	}

	function resolveHitKey(hit) {
		let curr = hit;
		while (curr && curr !== scene) {
			if (curr.userData) {
				if (curr.userData.id) return curr.userData.id;
				if (curr.userData.toothKey) return curr.userData.toothKey;
			}
			if (curr.name && (curr.name.startsWith('tooth-') || curr.name === 'pocket-molar')) {
				return curr.name;
			}
			curr = curr.parent;
		}
		return hit ? hit.name || null : null;
	}

	viewport.addEventListener('mousemove', (e) => {
		const hit = getIntersectedObject(e);
		if (hit) {
			viewport.style.cursor = 'pointer';
			const key = resolveHitKey(hit);
			const markerDef = CLINICAL_3D_MARKERS.find(m => m.id === key);
			const targetKey = markerDef ? markerDef.tooth : key;

			const info = TOOTH_DIRECTORY[targetKey];
			if (info && hudHelperTip) {
				hudHelperTip.innerHTML = `<span>🎯 <strong>Tooth #${info.fdi} [FDI] / #${info.uni} [US]</strong>: ${info.name}</span>`;
			}
		} else {
			viewport.style.cursor = 'grab';
			if (hudHelperTip) {
				hudHelperTip.innerHTML = '<span>🖱️ Drag to rotate 360°</span><span>•</span><span>🔍 Scroll to zoom</span><span>•</span><span>🎯 Click tooth or marker to&nbsp;inspect</span>';
			}
		}
	});

	viewport.addEventListener('click', (e) => {
		const hit = getIntersectedObject(e);
		if (hit) {
			const toothKey = resolveHitKey(hit);
			if (toothKey && (CLINICAL_RECORDS[toothKey] || TOOTH_DIRECTORY[toothKey])) {
				updateDiagnosticDrawer(toothKey);
			}
		}
	});

	// Resize Handler
	window.addEventListener('resize', () => {
		const newW = container.clientWidth;
		const newH = container.clientHeight;
		if (newW && newH) {
			camera.aspect = newW / newH;
			camera.updateProjectionMatrix();
			renderer.setSize(newW, newH);
		}
	});

	// Render Animation Loop
	function animate() {
		requestAnimationFrame(animate);

		// Turntable Rotation
		if (isSpinning) {
			modelGroup.rotation.y += 0.007;
		}

		// Smooth Camera Transition only when triggered by preset button
		if (isCameraAnimating) {
			camera.position.lerp(targetCamPos, 0.08);
			controls.target.lerp(targetLookAt, 0.08);

			if (camera.position.distanceTo(targetCamPos) < 0.03 && controls.target.distanceTo(targetLookAt) < 0.03) {
				isCameraAnimating = false;
			}
		}

		controls.update();
		renderer.render(scene, camera);
	}

	animate();
})();
</script>
