	// Compute outward normal unit vector from the oral cavity center (0, 0, 0.35) through the tooth
	function getToothOutwardVector(mesh) {
		const dx = mesh.position.x;
		const dz = mesh.position.z - 0.35;
		const len = Math.hypot(dx, dz) || 1;
		return { x: dx / len, z: dz / len };
	}

	// Load 3D GLB Model
	const loader = new THREE.GLTFLoader();
	loader.load(
		'/models/dental-arch-opt.glb',
		(gltf) => {
			gltf.scene.traverse((child) => {
				if (child.isMesh) {
					if (child.geometry && !child.geometry.attributes.normal) {
						child.geometry.computeVertexNormals();
					}

					const name = child.name || '';
					if (name.startsWith('tooth-')) {
						child.material = toothMaterial.clone();
						teethMeshes[name] = child;
						raycastableObjects.push(child);

						const dir = TOOTH_DIRECTORY[name];
						if (dir && dir.arch === 'upper') {
							upperMeshes.push(child);
						} else {
							lowerMeshes.push(child);
						}
					} else if (name === 'gingiva-upper') {
						child.material = gingivaMaterial.clone();
						upperMeshes.push(child);
					} else if (name === 'gingiva-lower') {
						child.material = gingivaMaterial.clone();
						lowerMeshes.push(child);
					} else if (name.includes('alveolar') || name.includes('mandible') || name.includes('maxilla')) {
						child.material = boneMaterial;
						child.visible = false;
						boneMeshes.push(child);
					} else if (name.includes('sinus') || name.includes('condyle')) {
						child.visible = false;
					}
				}
			});

			modelGroup.add(gltf.scene);

			// Build True 3D Clinical Issue Markers physically attached to exact teeth
			CLINICAL_3D_MARKERS.forEach(item => {
				const toothMesh = teethMeshes[item.tooth];
				if (!toothMesh) return;

				const markerGroup = new THREE.Group();
				markerGroup.userData = { id: item.id, category: item.category, arch: item.arch };

				const outVec = getToothOutwardVector(toothMesh);

				// 1. Glowing 3D Beacon sphere right on the outer tooth surface
				const beacon = createBeaconSphere(item.color);
				beacon.userData = { id: item.id };
				const beaconPos = new THREE.Vector3(
					toothMesh.position.x + outVec.x * 0.45,
					toothMesh.position.y + item.yOffset,
					toothMesh.position.z + outVec.z * 0.45
				);
				beacon.position.copy(beaconPos);
				markerGroup.add(beacon);

				// 2. Crisp 3D Billboard Sprite badge floating cleanly outside the tooth
				const sprite = createClinicalSprite(item.label, item.colorHex);
				const badgePos = new THREE.Vector3(
					toothMesh.position.x + outVec.x * 0.95,
					toothMesh.position.y + item.yOffset * 1.3,
					toothMesh.position.z + outVec.z * 0.95
				);
				sprite.position.copy(badgePos);
				sprite.userData = { id: item.id };
				markerGroup.add(sprite);

				// 3. Subtle thin leader line connecting the tooth surface beacon to the floating badge
				const line = createLeaderLine(beaconPos, badgePos, item.color);
				markerGroup.add(line);

				clinicalMarkersGroup.add(markerGroup);
				active3DMarkerObjects.push(markerGroup);
				raycastableObjects.push(beacon);
				raycastableObjects.push(sprite);
			});

			// Build Clean 3D Tooth Number Badges (#11 to #48) on every single tooth (2x smaller, tight padding, drop shadow)
			Object.entries(teethMeshes).forEach(([toothName, mesh]) => {
				const dir = TOOTH_DIRECTORY[toothName];
				const numStr = dir ? `#${dir.fdi}` : toothName.replace('tooth-', '#');
				const isUpper = dir ? dir.arch === 'upper' : mesh.position.y > 0;
				const outVec = getToothOutwardVector(mesh);

				const numSprite = createToothNumberSprite(numStr);
				// Position precisely on the outer emergence crown edge facing outward
				numSprite.position.set(
					mesh.position.x + outVec.x * 0.65,
					mesh.position.y + (isUpper ? -0.22 : 0.22),
					mesh.position.z + outVec.z * 0.65
				);
				numSprite.userData = { toothKey: toothName, arch: isUpper ? 'upper' : 'lower' };
				toothNumbersGroup.add(numSprite);
				raycastableObjects.push(numSprite);
			});

			if (loadingOverlay) loadingOverlay.classList.add('hidden');
			updateDiagnosticDrawer('tooth-36');
		},
		undefined,
		(err) => {
			console.warn('Error loading dental arch GLB:', err);
			if (loadingOverlay) {
				loadingOverlay.innerHTML = '<span style="color:#f87171;">Failed to load 3D model</span>';
			}
		}
