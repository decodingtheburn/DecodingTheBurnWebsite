---
// Itero3DRenderingViewer.astro
// Clean 3D Dental Arch Anatomy & Clinical Issue Map (Powered by Three.js & BodyParts3D Data)
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`dental-arch-wrapper ${className}`}>
	<div class="dental-arch-card">
		<!-- Top Bar Header -->
		<div class="arch-topbar">
			<div class="arch-title-group">
				<span class="status-indicator"></span>
				<span class="arch-main-title">3D Dental Arch Anatomy &amp; Clinical Issue&nbsp;Map</span>
			</div>
			<div class="arch-meta-details">
				<span>BodyParts3D Anatomical Reference</span>
				<span class="meta-separator">•</span>
				<span>FDI Tooth Numbering</span>
				<span class="meta-separator">•</span>
				<span>Denis Ethier Diagnostic Audit</span>
			</div>
		</div>

		<!-- Main 3D Viewport & Interactive Stage -->
		<div class="arch-viewport" id="archViewport">
			<!-- Three.js Canvas Mount Container -->
			<div id="threeArchContainer" class="three-arch-container"></div>

			<!-- Loading Indicator Overlay -->
			<div id="archLoadingOverlay" class="arch-loading-overlay">
				<div class="loading-spinner"></div>
				<span class="loading-text">Loading 3D Dental Arch Anatomy...</span>
			</div>

			<!-- Dynamic Screen-Space Hotspot Pins -->
			<div id="hotspotPinsContainer" class="hotspot-pins-container">
				<!-- Tooth #36: Defective Crown & Caries -->
				<div class="clinical-pin pin-crown active" data-pin="tooth-36" title="Tooth #36: Defective Distal Crown Margin">
					<span class="pin-pulse"></span>
					<span class="pin-marker"></span>
					<span class="pin-tag">#36 Defective Crown &amp; Cavities</span>
				</div>

				<!-- Tooth #23: Canine Recession & Floss Allodynia -->
				<div class="clinical-pin pin-recession active" data-pin="tooth-23" title="Tooth #23: 1mm Cervical Recession + 10/10 Pain">
					<span class="pin-pulse"></span>
					<span class="pin-marker"></span>
					<span class="pin-tag">#23 Canine Recession (10/10 Pain)</span>
				</div>

				<!-- Tooth #13: Canine Recession -->
				<div class="clinical-pin pin-recession active" data-pin="tooth-13" title="Tooth #13: Cervical Sensitivity">
					<span class="pin-pulse"></span>
					<span class="pin-marker"></span>
					<span class="pin-tag">#13 Canine Sensitivity</span>
				</div>

				<!-- Tooth #24: Overcontoured Composite -->
				<div class="clinical-pin pin-filling active" data-pin="tooth-24" title="Tooth #24: Overcontoured Buccal Composite">
					<span class="pin-pulse"></span>
					<span class="pin-marker"></span>
					<span class="pin-tag">#24 Composite Overcontour</span>
				</div>

				<!-- Tooth #26: Overcontoured Composite -->
				<div class="clinical-pin pin-filling active" data-pin="tooth-26" title="Tooth #26: Overcontoured Buccal Composite">
					<span class="pin-pulse"></span>
					<span class="pin-marker"></span>
					<span class="pin-tag">#26 Composite Overcontour</span>
				</div>

				<!-- Premolars: Abfraction Lesions -->
				<div class="clinical-pin pin-abfraction active" data-pin="tooth-14" title="Teeth #14, #15: Premolar Abfraction Notches">
					<span class="pin-pulse"></span>
					<span class="pin-marker"></span>
					<span class="pin-tag">#14-#15 Abfraction Notches</span>
				</div>

				<!-- Lower Premolars: Mandibular Abfraction -->
				<div class="clinical-pin pin-abfraction active" data-pin="tooth-34" title="Teeth #34, #35: Mandibular Abfractions">
					<span class="pin-pulse"></span>
					<span class="pin-marker"></span>
					<span class="pin-tag">#34-#35 Mandibular Wear</span>
				</div>

				<!-- Periodontal Pockets: Florida Probe Chart -->
				<div class="clinical-pin pin-pocket active" data-pin="pocket-molar" title="Molar Quadrants: 3mm-4mm Pockets">
					<span class="pin-pulse"></span>
					<span class="pin-marker"></span>
					<span class="pin-tag">3mm - 4mm Pockets (9% BOP)</span>
				</div>
			</div>

			<!-- Viewport Floating HUD Controls -->
			<div class="arch-hud-top">
				<div class="hud-view-label" id="hudViewLabel">Both Arches (In Centric Occlusion)</div>
				<div class="hud-helper-tip">
					<span>🖱️ Drag / Touch to rotate 360°</span>
					<span>•</span>
					<span>🔍 Scroll to zoom</span>
					<span>•</span>
					<span>🎯 Click any tooth to inspect</span>
				</div>
			</div>

			<!-- HUD Tools (Wireframe, Auto-Spin, Center, Bone Toggle) -->
			<div class="arch-hud-tools">
				<button type="button" class="hud-btn" id="btnToggleSpin" title="Toggle Turntable 3D Spin">
					<span id="spinIcon">🔄</span>
					<span id="spinLabel">Spin 3D</span>
				</button>
				<button type="button" class="hud-btn" id="btnToggleWireframe" title="Toggle 3D Wireframe Mesh">
					<span>🕸️ Wireframe</span>
				</button>
				<button type="button" class="hud-btn" id="btnResetView" title="Reset 3D Camera">
					<span>🎯 Center</span>
				</button>
				<button type="button" class="hud-btn" id="btnToggleBone" title="Toggle Alveolar Bone">
					<span>🦴 Jawbone</span>
				</button>
			</div>
		</div>

		<!-- Perspective Selector Bar -->
		<div class="arch-perspective-bar" role="tablist" aria-label="3D Anatomical Views">
			<button type="button" class="perspective-btn active" data-view="occlusion">
				<span>Centric Occlusion (Bite)</span>
			</button>
			<button type="button" class="perspective-btn" data-view="upper">
				<span>Upper Arch (Maxilla)</span>
			</button>
			<button type="button" class="perspective-btn" data-view="lower">
				<span>Lower Arch (Mandible)</span>
			</button>
			<button type="button" class="perspective-btn" data-view="left-profile">
				<span>Left Profile (#36 Focus)</span>
			</button>
			<button type="button" class="perspective-btn" data-view="right-profile">
				<span>Right Profile</span>
			</button>
		</div>

		<!-- Issue Category Filter Buttons -->
		<div class="arch-filter-bar">
			<span class="filter-heading">Diagnostic Issue Filters:</span>
			<div class="filter-buttons">
				<button type="button" class="filter-btn active" data-filter="all">
					<span class="filter-dot dot-all"></span>
					<span>All Clinical Issues</span>
				</button>
				<button type="button" class="filter-btn" data-filter="recession">
					<span class="filter-dot dot-recession"></span>
					<span>Recessions &amp; Allodynia</span>
				</button>
				<button type="button" class="filter-btn" data-filter="abfraction">
					<span class="filter-dot dot-abfraction"></span>
					<span>Abfractions &amp; Wear</span>
				</button>
				<button type="button" class="filter-btn" data-filter="filling">
					<span class="filter-dot dot-filling"></span>
					<span>Fillings &amp; Overcontours</span>
				</button>
				<button type="button" class="filter-btn" data-filter="crown">
					<span class="filter-dot dot-crown"></span>
					<span>Crown Defect (#36)</span>
				</button>
				<button type="button" class="filter-btn" data-filter="pocket">
					<span class="filter-dot dot-pocket"></span>
					<span>Periodontal Pockets</span>
				</button>
			</div>
		</div>

		<!-- Diagnostic Clinical Drawer -->
		<div class="arch-diagnostic-drawer" id="archDrawer">
			<div class="drawer-header-row">
				<div class="drawer-title-block">
					<h3 class="drawer-tooth-title" id="drawerTitle">Tooth #36: Defective Distal Crown Margin &amp; Hidden Cavities</h3>
					<span class="drawer-quadrant-sub" id="drawerSubtitle">Lower Left First Molar • Mandibular Quadrant • Trigeminal Branch V3</span>
				</div>
				<span class="drawer-severity-badge" id="drawerSeverity">Primary Neuropathic Trigger</span>
			</div>

			<div class="drawer-content-layout">
				<div class="drawer-text-block">
					<h4 class="drawer-section-heading">Clinical Chart &amp; Independent Radiograph Finding</h4>
					<p class="drawer-body-text" id="drawerClinicalText">
						Florida Probe periodontal charting confirmed a defective distal crown margin ("#36D joint au distal"). An independent radiograph audit uncovered three hidden recurrent cavities undermining the enamel and dentin beneath the 20-year-old restoration.
					</p>

					<h4 class="drawer-section-heading" style="margin-top: 1rem;">Direct Neuropathic Mechanism in Burning Mouth Syndrome</h4>
					<p class="drawer-body-text" id="drawerBmsMechanism">
						Because this mechanical margin sits subgingivally, it acts as a permanent incubator for anaerobic bacterial biofilm. Microorganisms pump lactic and acetic acids directly into exposed dentinal tubules, constantly stimulating the inferior alveolar nerve and sensitizing the trigeminal system.
					</p>
				</div>

				<div class="drawer-metrics-grid">
					<div class="metric-card">
						<span class="metric-label">Sulcus / Pocket Depth</span>
						<span class="metric-value" id="metricPocket">3mm - 4mm</span>
					</div>
					<div class="metric-card">
						<span class="metric-label">Bleeding on Probing (BOP)</span>
						<span class="metric-value critical" id="metricBop">Positive (9% total sites)</span>
					</div>
					<div class="metric-card">
						<span class="metric-label">Mechanical Sensitivity</span>
						<span class="metric-value warning" id="metricSensitivity">Extreme Hyperalgesia</span>
					</div>
					<div class="metric-card">
						<span class="metric-label">Biological Stressor</span>
						<span class="metric-value" id="metricStressor">Acid &amp; Plaque Trap</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.dental-arch-wrapper {
		margin: 2.75rem 0;
		width: 100%;
		font-family: var(--font-body, system-ui, sans-serif);
	}

	.dental-arch-card {
		background: #090614;
		border: 1px solid rgba(168, 85, 247, 0.35);
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.75), 0 0 35px rgba(168, 85, 247, 0.12);
		position: relative;
	}

	/* Top Bar Header */
	.arch-topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.1rem 1.5rem;
		background: rgba(18, 12, 38, 0.85);
		border-bottom: 1px solid rgba(168, 85, 247, 0.2);
		flex-wrap: wrap;
		gap: 0.8rem;
	}

	.arch-title-group {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}

	.status-indicator {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #10b981;
		box-shadow: 0 0 10px #10b981;
	}

	.arch-main-title {
		font-size: 0.95rem;
		font-weight: 700;
		color: #ffffff;
		letter-spacing: -0.01em;
	}

	.arch-meta-details {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-size: 0.8rem;
		color: #94a3b8;
		flex-wrap: wrap;
	}

	.meta-separator {
		color: #64748b;
	}

	/* Viewport Stage */
	.arch-viewport {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: radial-gradient(circle at center, #1b1038 0%, #06030c 100%);
		overflow: hidden;
		cursor: grab;
		user-select: none;
	}

	.arch-viewport:active {
		cursor: grabbing;
	}

	.three-arch-container {
		width: 100%;
		height: 100%;
		display: block;
	}

	.three-arch-container canvas {
		width: 100% !important;
		height: 100% !important;
		display: block;
	}

	/* Loading Overlay */
	.arch-loading-overlay {
		position: absolute;
		inset: 0;
		background: rgba(9, 6, 20, 0.92);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		z-index: 50;
		transition: opacity 0.4s ease;
	}

	.arch-loading-overlay.hidden {
		opacity: 0;
		pointer-events: none;
	}

	.loading-spinner {
		width: 44px;
		height: 44px;
		border: 3px solid rgba(168, 85, 247, 0.2);
		border-top-color: #a855f7;
		border-radius: 50%;
		animation: spin 1s infinite linear;
	}

	@keyframes spin {
		to { transform: rotate(360deg); }
	}

	.loading-text {
		color: #cbd5e1;
		font-size: 0.88rem;
		font-weight: 600;
	}

	/* Hotspot Pins Container */
	.hotspot-pins-container {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 15;
		overflow: hidden;
	}

	.clinical-pin {
		position: absolute;
		transform: translate(-50%, -50%);
		pointer-events: auto;
		cursor: pointer;
		display: none;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.clinical-pin.active {
		display: flex;
	}

	.clinical-pin:hover {
		transform: translate(-50%, -50%) scale(1.15);
		z-index: 30;
	}

	.pin-marker {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: #ffffff;
		box-shadow: 0 0 12px rgba(255, 255, 255, 0.8);
		position: relative;
		z-index: 2;
	}

	.pin-pulse {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		animation: pinPulse 2s infinite ease-out;
	}

	@keyframes pinPulse {
		0% { transform: scale(0.7); opacity: 1; }
		100% { transform: scale(2.4); opacity: 0; }
	}

	.pin-tag {
		position: absolute;
		left: 28px;
		top: 50%;
		transform: translateY(-50%);
		background: rgba(15, 10, 30, 0.92);
		border: 1px solid rgba(255, 255, 255, 0.2);
		color: #ffffff;
		font-size: 0.74rem;
		font-weight: 700;
		padding: 0.25rem 0.6rem;
		border-radius: 6px;
		white-space: nowrap;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.7);
		pointer-events: none;
	}

	/* Pin Color Schemes */
	.pin-crown .pin-marker { background: #ef4444; box-shadow: 0 0 12px #ef4444; }
	.pin-crown .pin-pulse { border: 2px solid #ef4444; }
	.pin-crown .pin-tag { border-color: rgba(239, 68, 68, 0.5); color: #fca5a5; }

	.pin-recession .pin-marker { background: #f97316; box-shadow: 0 0 12px #f97316; }
	.pin-recession .pin-pulse { border: 2px solid #f97316; }
	.pin-recession .pin-tag { border-color: rgba(249, 115, 22, 0.5); color: #fdba74; }

	.pin-filling .pin-marker { background: #38bdf8; box-shadow: 0 0 12px #38bdf8; }
	.pin-filling .pin-pulse { border: 2px solid #38bdf8; }
	.pin-filling .pin-tag { border-color: rgba(56, 189, 248, 0.5); color: #7dd3fc; }

	.pin-abfraction .pin-marker { background: #eab308; box-shadow: 0 0 12px #eab308; }
	.pin-abfraction .pin-pulse { border: 2px solid #eab308; }
	.pin-abfraction .pin-tag { border-color: rgba(234, 179, 8, 0.5); color: #fde047; }

	.pin-pocket .pin-marker { background: #a855f7; box-shadow: 0 0 12px #a855f7; }
	.pin-pocket .pin-pulse { border: 2px solid #a855f7; }
	.pin-pocket .pin-tag { border-color: rgba(168, 85, 247, 0.5); color: #d8b4fe; }

	/* Floating HUD Controls */
	.arch-hud-top {
		position: absolute;
		top: 1rem;
		left: 1rem;
		right: 1rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		pointer-events: none;
		z-index: 10;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.hud-view-label {
		background: rgba(15, 23, 42, 0.85);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(192, 132, 252, 0.35);
		color: #f1f5f9;
		font-size: 0.82rem;
		font-weight: 700;
		padding: 0.4rem 0.85rem;
		border-radius: 8px;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
	}

	.hud-helper-tip {
		background: rgba(15, 23, 42, 0.7);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #cbd5e1;
		font-size: 0.74rem;
		font-weight: 500;
		padding: 0.4rem 0.8rem;
		border-radius: 8px;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.arch-hud-tools {
		position: absolute;
		bottom: 1rem;
		right: 1rem;
		display: flex;
		gap: 0.5rem;
		z-index: 20;
	}

	.hud-btn {
		background: rgba(15, 23, 42, 0.85);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(168, 85, 247, 0.3);
		color: #cbd5e1;
		font-size: 0.76rem;
		font-weight: 600;
		padding: 0.4rem 0.8rem;
		border-radius: 8px;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		transition: all 0.2s ease;
	}

	.hud-btn:hover {
		background: rgba(168, 85, 247, 0.25);
		color: #ffffff;
		border-color: #c084fc;
	}

	.hud-btn.active {
		background: linear-gradient(135deg, #a855f7 0%, #7e22ce 100%);
		color: #ffffff;
		border-color: #d8b4fe;
		box-shadow: 0 2px 10px rgba(168, 85, 247, 0.4);
	}

	/* Perspective Selector Bar */
	.arch-perspective-bar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.25rem;
		background: rgba(15, 10, 32, 0.95);
		border-top: 1px solid rgba(168, 85, 247, 0.2);
		border-bottom: 1px solid rgba(168, 85, 247, 0.2);
		overflow-x: auto;
		white-space: nowrap;
	}

	.perspective-btn {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(168, 85, 247, 0.25);
		color: #cbd5e1;
		font-size: 0.8rem;
		font-weight: 600;
		padding: 0.45rem 0.9rem;
		border-radius: 8px;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.perspective-btn:hover {
		background: rgba(168, 85, 247, 0.18);
		color: #ffffff;
		border-color: #c084fc;
	}

	.perspective-btn.active {
		background: linear-gradient(135deg, #a855f7 0%, #7e22ce 100%);
		border-color: #d8b4fe;
		color: #ffffff;
		box-shadow: 0 3px 12px rgba(168, 85, 247, 0.35);
	}

	/* Issue Filter Bar */
	.arch-filter-bar {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.75rem 1.25rem;
		background: rgba(10, 7, 24, 0.98);
		border-bottom: 1px solid rgba(168, 85, 247, 0.2);
		flex-wrap: wrap;
	}

	.filter-heading {
		font-size: 0.78rem;
		font-weight: 600;
		color: #94a3b8;
	}

	.filter-buttons {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.filter-btn {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: #cbd5e1;
		font-size: 0.76rem;
		font-weight: 500;
		padding: 0.35rem 0.75rem;
		border-radius: 6px;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		transition: all 0.2s ease;
	}

	.filter-btn:hover {
		background: rgba(255, 255, 255, 0.08);
		color: #ffffff;
	}

	.filter-btn.active {
		background: rgba(168, 85, 247, 0.2);
		border-color: #a855f7;
		color: #ffffff;
	}

	.filter-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}

	.dot-all { background: #ffffff; }
	.dot-recession { background: #f97316; }
	.dot-abfraction { background: #eab308; }
	.dot-filling { background: #38bdf8; }
	.dot-crown { background: #ef4444; }
	.dot-pocket { background: #a855f7; }

	/* Diagnostic Drawer */
	.arch-diagnostic-drawer {
		padding: 1.6rem 1.8rem;
		background: #0d081a;
	}

	.drawer-header-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 1.2rem;
		flex-wrap: wrap;
		gap: 0.8rem;
	}

	.drawer-title-block {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.drawer-tooth-title {
		font-size: 1.18rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0;
		letter-spacing: -0.015em;
	}

	.drawer-quadrant-sub {
		font-size: 0.82rem;
		color: #a855f7;
		font-weight: 500;
	}

	.drawer-severity-badge {
		font-size: 0.78rem;
		font-weight: 600;
		color: #fca5a5;
		background: rgba(239, 68, 68, 0.15);
		border: 1px solid rgba(239, 68, 68, 0.35);
		padding: 0.3rem 0.7rem;
		border-radius: 6px;
	}

	.drawer-content-layout {
		display: grid;
		grid-template-columns: 1.45fr 1fr;
		gap: 1.6rem;
	}

	@media (max-width: 840px) {
		.drawer-content-layout {
			grid-template-columns: 1fr;
			gap: 1.2rem;
		}
	}

	.drawer-section-heading {
		font-size: 0.8rem;
		font-weight: 600;
		color: #c084fc;
		margin: 0 0 0.35rem 0;
	}

	.drawer-body-text {
		font-size: 0.92rem;
		line-height: 1.65;
		color: #cbd5e1;
		margin: 0;
	}

	.drawer-metrics-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.7rem;
	}

	.metric-card {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(168, 85, 247, 0.2);
		border-radius: 10px;
		padding: 0.75rem 0.9rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.metric-label {
		font-size: 0.72rem;
		color: #94a3b8;
		font-weight: 500;
	}

	.metric-value {
		font-size: 0.98rem;
		font-weight: 700;
		color: #ffffff;
	}

	.metric-value.critical {
		color: #f87171;
	}

	.metric-value.warning {
		color: #fbbf24;
	}
</style>

<!-- Load Three.js core, GLTFLoader, and OrbitControls -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" is:inline></script>
<script src="/vendor/three/GLTFLoader.js" is:inline></script>
<script src="/vendor/three/OrbitControls.js" is:inline></script>

<script is:inline>
(() => {
	const container = document.getElementById('threeArchContainer');
	const viewport = document.getElementById('archViewport');
	const loadingOverlay = document.getElementById('archLoadingOverlay');
	const hudViewLabel = document.getElementById('hudViewLabel');
	const pinsContainer = document.getElementById('hotspotPinsContainer');

	const btnSpin = document.getElementById('btnToggleSpin');
	const spinLabel = document.getElementById('spinLabel');
	const btnWireframe = document.getElementById('btnToggleWireframe');
	const btnReset = document.getElementById('btnResetView');
	const btnBone = document.getElementById('btnToggleBone');

	const perspectiveButtons = document.querySelectorAll('.perspective-btn');
	const filterButtons = document.querySelectorAll('.filter-btn');

	const drawerTitle = document.getElementById('drawerTitle');
	const drawerSubtitle = document.getElementById('drawerSubtitle');
	const drawerSeverity = document.getElementById('drawerSeverity');
	const drawerClinicalText = document.getElementById('drawerClinicalText');
	const drawerBmsMechanism = document.getElementById('drawerBmsMechanism');
	const metricPocket = document.getElementById('metricPocket');
	const metricBop = document.getElementById('metricBop');
	const metricSensitivity = document.getElementById('metricSensitivity');
	const metricStressor = document.getElementById('metricStressor');

	if (!container || typeof THREE === 'undefined') return;

	// Three.js Scene Setup
	const scene = new THREE.Scene();
	scene.background = null;

	const width = container.clientWidth || 960;
	const height = container.clientHeight || 540;

	const camera = new THREE.PerspectiveCamera(42, width / height, 0.1, 100);
	camera.position.set(0, 0.6, 8.2);

	const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
	renderer.setSize(width, height);
	renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
	renderer.toneMapping = THREE.ACESFilmicToneMapping;
	renderer.toneMappingExposure = 1.05;
	container.appendChild(renderer.domElement);

	// Orbit Controls
	const controls = new THREE.OrbitControls(camera, renderer.domElement);
	controls.enableDamping = true;
	controls.dampingFactor = 0.08;
	controls.maxDistance = 18;
	controls.minDistance = 3.2;
	controls.target.set(0, 0, 0);

	// Studio Lighting Setup
	const ambientLight = new THREE.AmbientLight(0xffffff, 0.75);
	scene.add(ambientLight);

	const keyLight = new THREE.DirectionalLight(0xfff7ee, 1.3);
	keyLight.position.set(6, 8, 8);
	scene.add(keyLight);

	const fillLight = new THREE.DirectionalLight(0xc084fc, 0.65);
	fillLight.position.set(-7, 4, -5);
	scene.add(fillLight);

	const blueRimLight = new THREE.DirectionalLight(0x38bdf8, 0.75);
	blueRimLight.position.set(0, -6, 5);
	scene.add(blueRimLight);

	// Subtle Floor Grid
	const grid = new THREE.GridHelper(12, 24, 0xa855f7, 0x241242);
	grid.position.y = -2.4;
	scene.add(grid);

	// Root Group for Models
	const modelGroup = new THREE.Group();
	scene.add(modelGroup);

	// Material Definitions
	const toothMaterial = new THREE.MeshStandardMaterial({
		color: 0xfaf7ee,
		roughness: 0.16,
		metalness: 0.04
	});

	const gingivaMaterial = new THREE.MeshStandardMaterial({
		color: 0xd97585,
		roughness: 0.45,
		metalness: 0.0
	});

	const boneMaterial = new THREE.MeshStandardMaterial({
		color: 0xcdbead,
		roughness: 0.55,
		metalness: 0.0,
		transparent: true,
		opacity: 0.85
	});

	// Storage & State
	const teethMeshes = {};
	const boneMeshes = [];
	const raycastableTeeth = [];
	let isSpinning = false;
	let isWireframe = false;
	let showBone = false;
	let activeFilter = 'all';
	let selectedToothMesh = null;

	// Clinical Audit Records Dictionary
	const CLINICAL_RECORDS = {
		'tooth-36': {
			name: 'Tooth #36: Defective Distal Crown Margin & Hidden Cavities',
			subtitle: 'Lower Left First Molar • Mandibular Quadrant • Trigeminal V3',
			severity: 'Primary Neuropathic Trigger',
			clinical: 'Florida Probe audit confirmed defective distal margin ("#36D joint au distal"). Independent X-ray review discovered three hidden cavities eroding dentin beneath the crown.',
			mechanism: 'Subgingival food/plaque trap produces constant lactic and acetic acids. Acid penetrates directly into exposed dentinal tubules, firing the inferior alveolar nerve (V3).',
			pocket: '3mm - 4mm',
			bop: 'Positive (severe)',
			sensitivity: 'Excruciating Hyperalgesia',
			stressor: 'Anaerobic Bacterial Acid'
		},
		'tooth-23': {
			name: 'Tooth #23: 1mm Cervical Recession & 10/10 Floss Allodynia',
			subtitle: 'Upper Left Canine • Maxillary Quadrant • Trigeminal V2',
			severity: 'Extreme Mechanical Allodynia',
			clinical: 'Periodontal chart: "23B récession 1mm... L’intensité de l’inconfort au passage du fil de soie dentaire est de 10/10 et dure quelques secondes."',
			mechanism: 'A 1mm recession exposes thousands of conical dentinal tubules. In a primed nervous system with sensitized ASIC3 channels, passing floss triggers a massive 10/10 shockwave.',
			pocket: '3mm sulcus',
			bop: 'Negative at margin',
			sensitivity: '10/10 Allodynia to Floss',
			stressor: 'Exposed Dentinal Tubules'
		},
		'tooth-13': {
			name: 'Tooth #13: Canine Cervical Recession & Sensitivity',
			subtitle: 'Upper Right Canine • Maxillary Quadrant • Trigeminal V2',
			severity: 'Bilateral Canine Sensitivity',
			clinical: 'Bilateral canine flossing tenderness documented in dental chart alongside #23. Mild buccal recession exposing cementoenamel junction.',
			mechanism: 'Mechanical friction during daily hygiene stimulates sensitized nerve terminals within exposed coronal tubules.',
			pocket: '2mm - 3mm',
			bop: 'Negative',
			sensitivity: 'Moderate Floss Tenderness',
			stressor: 'Mechanical Friction'
		},
		'tooth-24': {
			name: 'Tooth #24: Overcontoured Buccal Composite Filling',
			subtitle: 'Upper Left First Premolar • Maxillary Quadrant • Trigeminal V2',
			severity: 'Chronic Plaque & Plaque Trap',
			clinical: 'Dental audit noted: "24B composite avec surcontour." Filling ledge overhangs the natural emergence profile.',
			mechanism: 'Bulky restorative ledges trap biofilm against the gingival margin. Chronic inflammatory vasodilation prevents mucosal epithelial closure.',
			pocket: '3mm sulcus',
			bop: 'Localized Bleeding',
			sensitivity: 'Floss Snagging & Tenderness',
			stressor: 'Microbial Plaque Retention'
		},
		'tooth-26': {
			name: 'Tooth #26: Overcontoured Buccal Composite Filling',
			subtitle: 'Upper Left First Molar • Maxillary Quadrant • Trigeminal V2',
			severity: 'Chronic Plaque & Plaque Trap',
			clinical: 'Dental audit noted: "26B composite en surcontour." Bulky resin margin interfaces with molar gingival collar.',
			mechanism: 'Restoration overhang traps acid-producing bacteria directly adjacent to inflamed mucosal tissue.',
			pocket: '3mm - 4mm',
			bop: 'Positive on Probing',
			sensitivity: 'Localized Burning Flare',
			stressor: 'Biofilm Trap'
		},
		'tooth-14': {
			name: 'Teeth #14 & #15: Premolar Abfraction Lesions',
			subtitle: 'Upper Right Premolars • Maxillary Quadrant • Trigeminal V2',
			severity: 'Non-Carious Cervical Wear',
			clinical: 'Wedge-shaped cervical enamel notches along buccal cervical margins caused by eccentric bite stress and clenching.',
			mechanism: 'Enamel microfractures expose dentin to dietary acids, triggering rapid burning flares upon contact with acidic or salty food.',
			pocket: '2mm - 3mm',
			bop: 'Negative',
			sensitivity: 'Acid / Cold Sensitive',
			stressor: 'Occlusal Flexure & Acid'
		},
		'tooth-34': {
			name: 'Teeth #34 & #35: Mandibular Premolar Abfractions',
			subtitle: 'Lower Left Premolars • Mandibular Quadrant • Trigeminal V3',
			severity: 'Mechanical Enamel Notches',
			clinical: 'Cervical wear facets and enamel notches adjacent to defective molar #36.',
			mechanism: 'Occlusal forces from heavy chewing and clenching flex the cervical crown, dislodging enamel prisms.',
			pocket: '3mm sulcus',
			bop: 'Mild',
			sensitivity: 'Tactile Sensitivity',
			stressor: 'Bite Stress'
		},
		'pocket-molar': {
			name: 'Periodontal Charting: 2mm - 4mm Pockets (9% Bleeding on Probing)',
			subtitle: 'Full Mouth Florida Probe Audit • April 14, 2025',
			severity: 'Severe Hyperalgesia on Probing',
			clinical: '15 bleeding sites documented. Periodontist recorded: "Le sondage fut excessivement difficile et sensible... La condition ne peut expliquer l’ampleur des inconforts."',
			mechanism: 'The physical tissue damage did not match the agony: proving the patient suffered from severe peripheral and central neuropathic hyperalgesia.',
			pocket: '2mm - 4mm (mostly 3mm)',
			bop: '9% (15 bleeding sites)',
			sensitivity: 'Severe Probing Agony',
			stressor: 'Neuropathic Sensitization'
		}
	};

	// 3D Hotspot Coordinates
	const PIN_LOCATIONS = {
		'tooth-36': new THREE.Vector3(2.126, -0.45, -0.357),
		'tooth-23': new THREE.Vector3(1.584, 1.15, 1.977),
		'tooth-13': new THREE.Vector3(-1.716, 1.15, 1.978),
		'tooth-24': new THREE.Vector3(1.883, 1.12, 1.245),
		'tooth-26': new THREE.Vector3(2.269, 1.25, -0.179),
		'tooth-14': new THREE.Vector3(-2.15, 1.12, 0.95),
		'tooth-34': new THREE.Vector3(1.65, -0.95, 0.75),
		'pocket-molar': new THREE.Vector3(2.35, 0.35, -0.9)
	};

	// Load 3D GLB Model
	const loader = new THREE.GLTFLoader();
	loader.load(
		'/models/dental-arch-opt.glb',
		(gltf) => {
			gltf.scene.traverse((child) => {
				if (child.isMesh) {
					const name = child.name || '';
					if (name.startsWith('tooth-')) {
						child.material = toothMaterial.clone();
						teethMeshes[name] = child;
						raycastableTeeth.push(child);
					} else if (name.startsWith('gingiva-')) {
						child.material = gingivaMaterial;
					} else if (name.includes('alveolar') || name.includes('mandible') || name.includes('maxilla')) {
						child.material = boneMaterial;
						child.visible = false;
						boneMeshes.push(child);
					} else if (name.includes('sinus') || name.includes('condyle')) {
						child.visible = false;
					}
				}
			});

			modelGroup.add(gltf.scene);
			if (loadingOverlay) loadingOverlay.classList.add('hidden');
			updateDiagnosticDrawer('tooth-36');
		},
		undefined,
		(err) => {
			console.warn('Error loading dental arch GLB:', err);
			if (loadingOverlay) {
				loadingOverlay.innerHTML = '<span style="color:#f87171;">Failed to load 3D model</span>';
			}
		}
	);

	// Update Diagnostic Drawer
	function updateDiagnosticDrawer(key) {
		const rec = CLINICAL_RECORDS[key];
		if (!rec) return;

		if (drawerTitle) drawerTitle.textContent = rec.name;
		if (drawerSubtitle) drawerSubtitle.textContent = rec.subtitle;
		if (drawerSeverity) drawerSeverity.textContent = rec.severity;
		if (drawerClinicalText) drawerClinicalText.textContent = rec.clinical;
		if (drawerBmsMechanism) drawerBmsMechanism.textContent = rec.mechanism;
		if (metricPocket) metricPocket.textContent = rec.pocket;
		if (metricBop) metricBop.textContent = rec.bop;
		if (metricSensitivity) metricSensitivity.textContent = rec.sensitivity;
		if (metricStressor) metricStressor.textContent = rec.stressor;

		// Highlight tooth
		if (selectedToothMesh) {
			selectedToothMesh.material.color.setHex(0xfaf7ee);
			selectedToothMesh.material.emissive.setHex(0x000000);
		}

		if (teethMeshes[key]) {
			selectedToothMesh = teethMeshes[key];
			selectedToothMesh.material.color.setHex(0xffffff);
			selectedToothMesh.material.emissive.setHex(0x9333ea);
			selectedToothMesh.material.emissiveIntensity = 0.45;
		}
	}

	// Hotspot Pin Click Listeners
	document.querySelectorAll('.clinical-pin').forEach(pin => {
		pin.addEventListener('click', (e) => {
			e.stopPropagation();
			const key = pin.getAttribute('data-pin');
			if (key) {
				updateDiagnosticDrawer(key);
				// Fly camera towards pin
				const loc = PIN_LOCATIONS[key];
				if (loc) {
					controls.target.set(loc.x * 0.7, loc.y * 0.7, loc.z * 0.7);
				}
			}
		});
	});

	// Perspective Camera Views
	const VIEW_PRESETS = {
		'occlusion': {
			label: 'Both Arches (In Centric Occlusion)',
			camPos: [0, 0.4, 8.2],
			target: [0, 0, 0]
		},
		'upper': {
			label: 'Upper Arch (Maxilla & Palate)',
			camPos: [0, -4.8, 5.5],
			target: [0, 1.2, 0.2]
		},
		'lower': {
			label: 'Lower Arch (Mandible & Tooth #36)',
			camPos: [0, 5.0, 5.2],
			target: [0, -0.8, -0.3]
		},
		'left-profile': {
			label: 'Left Profile (Focus on #36 Crown & Composites)',
			camPos: [6.2, 0.2, 2.8],
			target: [1.8, -0.1, 0.2]
		},
		'right-profile': {
			label: 'Right Profile (Canines & Premolars)',
			camPos: [-6.2, 0.2, 2.8],
			target: [-1.8, -0.1, 0.2]
		}
	};

	perspectiveButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			perspectiveButtons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');

			const key = btn.getAttribute('data-view');
			const view = VIEW_PRESETS[key];
			if (!view) return;

			if (hudViewLabel) hudViewLabel.textContent = view.label;

			// Smooth camera animation
			targetCamPos.set(view.camPos[0], view.camPos[1], view.camPos[2]);
			targetLookAt.set(view.target[0], view.target[1], view.target[2]);
		});
	});

	const targetCamPos = new THREE.Vector3(0, 0.4, 8.2);
	const targetLookAt = new THREE.Vector3(0, 0, 0);

	// Filter Logic
	filterButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			filterButtons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');

			activeFilter = btn.getAttribute('data-filter') || 'all';

			document.querySelectorAll('.clinical-pin').forEach(pin => {
				const isCrown = pin.classList.contains('pin-crown');
				const isRecession = pin.classList.contains('pin-recession');
				const isAbfraction = pin.classList.contains('pin-abfraction');
				const isFilling = pin.classList.contains('pin-filling');
				const isPocket = pin.classList.contains('pin-pocket');

				let show = false;
				if (activeFilter === 'all') show = true;
				else if (activeFilter === 'crown' && isCrown) show = true;
				else if (activeFilter === 'recession' && isRecession) show = true;
				else if (activeFilter === 'abfraction' && isAbfraction) show = true;
				else if (activeFilter === 'filling' && isFilling) show = true;
				else if (activeFilter === 'pocket' && isPocket) show = true;

				pin.classList.toggle('active', show);
			});

			// If specific filter selected, update drawer to first related issue
			if (activeFilter === 'crown') updateDiagnosticDrawer('tooth-36');
			else if (activeFilter === 'recession') updateDiagnosticDrawer('tooth-23');
			else if (activeFilter === 'abfraction') updateDiagnosticDrawer('tooth-14');
			else if (activeFilter === 'filling') updateDiagnosticDrawer('tooth-24');
			else if (activeFilter === 'pocket') updateDiagnosticDrawer('pocket-molar');
		});
	});

	// HUD Tools Listeners
	btnSpin?.addEventListener('click', () => {
		isSpinning = !isSpinning;
		btnSpin.classList.toggle('active', isSpinning);
		if (spinLabel) spinLabel.textContent = isSpinning ? 'Pause Spin' : 'Spin 3D';
	});

	btnWireframe?.addEventListener('click', () => {
		isWireframe = !isWireframe;
		btnWireframe.classList.toggle('active', isWireframe);
		toothMaterial.wireframe = isWireframe;
		gingivaMaterial.wireframe = isWireframe;
	});

	btnReset?.addEventListener('click', () => {
		targetCamPos.set(0, 0.4, 8.2);
		targetLookAt.set(0, 0, 0);
		controls.target.set(0, 0, 0);
	});

	btnBone?.addEventListener('click', () => {
		showBone = !showBone;
		btnBone.classList.toggle('active', showBone);
		boneMeshes.forEach(m => m.visible = showBone);
	});

	// Raycaster for Tooth Clicking
	const raycaster = new THREE.Raycaster();
	const mouse = new THREE.Vector2();

	viewport.addEventListener('click', (e) => {
		const rect = renderer.domElement.getBoundingClientRect();
		mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
		mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

		raycaster.setFromCamera(mouse, camera);
		const intersects = raycaster.intersectObjects(raycastableTeeth);

		if (intersects.length > 0) {
			const clickedTooth = intersects[0].object;
			const toothKey = clickedTooth.name;
			if (CLINICAL_RECORDS[toothKey]) {
				updateDiagnosticDrawer(toothKey);
			} else {
				// Fallback generic info for unannotated teeth
				if (drawerTitle) drawerTitle.textContent = `${toothKey.toUpperCase()} (Normal Anatomical Profile)`;
				if (drawerSubtitle) drawerSubtitle.textContent = 'Intact Enamel Crown • Physiological Periodontal Sulcus';
				if (drawerSeverity) drawerSeverity.textContent = 'Normal Reference';
				if (drawerClinicalText) drawerClinicalText.textContent = 'This tooth presents normal anatomical morphology without documented restoration margins, cavities, or severe cervical defects.';
				if (drawerBmsMechanism) drawerBmsMechanism.textContent = 'Acts as a normal reference surface. Not an active primary mechanical trigger in your clinical audit.';
				if (metricPocket) metricPocket.textContent = '2mm - 3mm (Normal)';
				if (metricBop) metricBop.textContent = 'Negative';
				if (metricSensitivity) metricSensitivity.textContent = 'Normal';
				if (metricStressor) metricStressor.textContent = 'None';
			}
		}
	});

	// Screen-Space Pin Projection
	const tempVec = new THREE.Vector3();
	function updatePinPositions() {
		const rect = renderer.domElement.getBoundingClientRect();
		const halfW = rect.width / 2;
		const halfH = rect.height / 2;

		document.querySelectorAll('.clinical-pin').forEach(pin => {
			const key = pin.getAttribute('data-pin');
			const pos3D = PIN_LOCATIONS[key];
			if (!pos3D) return;

			tempVec.copy(pos3D);
			tempVec.applyMatrix4(modelGroup.matrixWorld);
			tempVec.project(camera);

			// Behind camera check
			if (tempVec.z > 1.0) {
				pin.style.display = 'none';
				return;
			}

			if (pin.classList.contains('active')) {
				pin.style.display = 'flex';
			}

			const screenX = (tempVec.x * halfW) + halfW;
			const screenY = -(tempVec.y * halfH) + halfH;

			pin.style.left = `${screenX}px`;
			pin.style.top = `${screenY}px`;
		});
	}

	// Resize Handler
	window.addEventListener('resize', () => {
		const newW = container.clientWidth;
		const newH = container.clientHeight;
		if (newW && newH) {
			camera.aspect = newW / newH;
			camera.updateProjectionMatrix();
			renderer.setSize(newW, newH);
		}
	});

	// Render Loop
	function animate() {
		requestAnimationFrame(animate);

		// Turntable Rotation
		if (isSpinning) {
			modelGroup.rotation.y += 0.007;
		}

		// Smooth Camera Transition
		camera.position.lerp(targetCamPos, 0.05);
		controls.target.lerp(targetLookAt, 0.05);
		controls.update();

		// Project 3D pins to 2D screen
		updatePinPositions();

		renderer.render(scene, camera);
	}

	animate();
})();
</script>
