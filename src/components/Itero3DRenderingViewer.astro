	// Helper to create clinical diagnostic badges with subtle drop shadow
	function createClinicalSprite(text, borderColorHex) {
		const canvas = document.createElement('canvas');
		canvas.width = 280;
		canvas.height = 76;
		const ctx = canvas.getContext('2d');

		// Soft drop shadow
		ctx.shadowColor = 'rgba(0, 0, 0, 0.85)';
		ctx.shadowBlur = 10;
		ctx.shadowOffsetX = 0;
		ctx.shadowOffsetY = 4;

		// Card Background
		const boxX = 6;
		const boxY = 5;
		const boxW = canvas.width - 12;
		const boxH = canvas.height - 12;
		const radius = 12;

		ctx.fillStyle = 'rgba(12, 8, 26, 0.94)';
		ctx.beginPath();
		ctx.roundRect(boxX, boxY, boxW, boxH, radius);
		ctx.fill();

		// Clean accent border
		ctx.shadowColor = 'transparent';
		ctx.strokeStyle = borderColorHex;
		ctx.lineWidth = 3;
		ctx.stroke();

		// Sharp Typography
		ctx.fillStyle = '#ffffff';
		ctx.font = 'bold 26px system-ui, -apple-system, sans-serif';
		ctx.textAlign = 'center';
		ctx.textBaseline = 'middle';
		ctx.fillText(text, canvas.width / 2, (canvas.height / 2) - 1);

		const texture = new THREE.CanvasTexture(canvas);
		texture.minFilter = THREE.LinearFilter;
		const mat = new THREE.SpriteMaterial({
			map: texture,
			depthTest: true,
			depthWrite: false,
			transparent: true
		});
		const sprite = new THREE.Sprite(mat);
		const baseScaleX = 1.35;
		const baseScaleY = 0.38;
		sprite.scale.set(baseScaleX, baseScaleY, 1);
		sprite.userData.baseScaleX = baseScaleX;
		allSprites.push(sprite);
		return sprite;
	}

	// Helper to create 2x smaller tooth number sprites with tight padding, NO border, and pure drop shadow
	function createToothNumberSprite(text) {
		const canvas = document.createElement('canvas');
		canvas.width = 56;
		canvas.height = 32;
		const ctx = canvas.getContext('2d');

		// Rich drop shadow (no border)
		ctx.shadowColor = 'rgba(0, 0, 0, 0.95)';
		ctx.shadowBlur = 6;
		ctx.shadowOffsetX = 0;
		ctx.shadowOffsetY = 2;

		// Compact card box with minimal padding (no border)
		const boxX = 4;
		const boxY = 3;
		const boxW = canvas.width - 8;
		const boxH = canvas.height - 8;
		const radius = 5;

		ctx.fillStyle = 'rgba(15, 10, 30, 0.96)';
		ctx.beginPath();
		ctx.roundRect(boxX, boxY, boxW, boxH, radius);
		ctx.fill();

		// Crisp typography (no shadow on font itself)
		ctx.shadowColor = 'transparent';
		ctx.fillStyle = '#ffffff';
		ctx.font = 'bold 16px system-ui, -apple-system, sans-serif';
		ctx.textAlign = 'center';
		ctx.textBaseline = 'middle';
		ctx.fillText(text, canvas.width / 2, (canvas.height / 2) - 0.5);

		const texture = new THREE.CanvasTexture(canvas);
		texture.minFilter = THREE.LinearFilter;
		const mat = new THREE.SpriteMaterial({
			map: texture,
			depthTest: true,
			depthWrite: false,
			transparent: true
		});
		const sprite = new THREE.Sprite(mat);
		// Exactly 2x smaller than previous 0.65 x 0.32: width 0.28, height 0.16
		const baseScaleX = 0.28;
		const baseScaleY = 0.16;
		sprite.scale.set(baseScaleX, baseScaleY, 1);
		sprite.userData.baseScaleX = baseScaleX;
		allSprites.push(sprite);
