		},
		'tooth-14': {
			name: 'Teeth #14 & #15: Premolar Abfraction Lesions',
			subtitle: 'Upper Right Premolars • Maxillary Quadrant • Trigeminal V2',
			severity: 'Non-Carious Cervical Wear',
			clinical: 'Wedge-shaped cervical enamel notches along buccal cervical margins caused by eccentric bite stress and clenching.',
			mechanism: 'Enamel microfractures expose dentin to dietary acids, triggering rapid burning flares upon contact with acidic or salty food.',
			pocket: '2mm - 3mm',
			bop: 'Negative',
			sensitivity: 'Acid / Cold Sensitive',
			stressor: 'Occlusal Flexure & Acid'
		},
		'tooth-34': {
			name: 'Teeth #34 & #35: Mandibular Premolar Abfractions',
			subtitle: 'Lower Left Premolars • Mandibular Quadrant • Trigeminal V3',
			severity: 'Mechanical Enamel Notches',
			clinical: 'Cervical wear facets and enamel notches adjacent to defective molar #36.',
			mechanism: 'Occlusal forces from heavy chewing and clenching flex the cervical crown, dislodging enamel prisms.',
			pocket: '3mm sulcus',
			bop: 'Mild',
			sensitivity: 'Tactile Sensitivity',
			stressor: 'Bite Stress'
		},
		'pocket-molar': {
			name: 'Periodontal Charting: 2mm - 4mm Pockets (9% Bleeding on Probing)',
			subtitle: 'Full Mouth Florida Probe Audit • April 14, 2025',
			severity: 'Severe Hyperalgesia on Probing',
			clinical: '15 bleeding sites documented. Periodontist recorded: "Le sondage fut excessivement difficile et sensible... La condition ne peut expliquer l’ampleur des inconforts."',
			mechanism: 'The physical tissue damage did not match the agony: proving the patient suffered from severe peripheral and central neuropathic hyperalgesia.',
			pocket: '2mm - 4mm (mostly 3mm)',
			bop: '9% (15 bleeding sites)',
			sensitivity: 'Severe Probing Agony',
			stressor: 'Neuropathic Sensitization'
		}
	};

	// Clinical 3D Markers Definitions (Attached directly to exact teeth in 3D scene)
	const CLINICAL_3D_MARKERS = [
		{
			id: 'tooth-36',
			tooth: 'tooth-36',
			category: 'crown',
			label: '#36 Crown Leak & Cavities',
			color: 0xef4444,
			colorHex: '#ef4444',
			offset: [0.45, 0.2, -0.15]
		},
		{
			id: 'tooth-23',
			tooth: 'tooth-23',
			category: 'recession',
			label: '#23 1mm Recession (10/10 Pain)',
			color: 0xf97316,
			colorHex: '#f97316',
			offset: [0.25, 0.25, 0.25]
		},
		{
			id: 'tooth-13',
			tooth: 'tooth-13',
			category: 'recession',
			label: '#13 Canine Floss Pain',
			color: 0xf97316,
			colorHex: '#f97316',
			offset: [-0.25, 0.25, 0.25]
		},
		{
			id: 'tooth-24',
			tooth: 'tooth-24',
			category: 'filling',
			label: '#24 Composite Overcontour',
			color: 0x38bdf8,
			colorHex: '#38bdf8',
			offset: [0.35, 0.2, 0.15]
		},
		{
			id: 'tooth-26',
			tooth: 'tooth-26',
			category: 'filling',
			label: '#26 Composite Overcontour',
			color: 0x38bdf8,
			colorHex: '#38bdf8',
			offset: [0.45, 0.25, 0.05]
		},
		{
			id: 'tooth-14',
			tooth: 'tooth-14',
			category: 'abfraction',
			label: '#14-#15 Abfraction Notches',
			color: 0xeab308,
			colorHex: '#eab308',
			offset: [-0.35, 0.2, 0.15]
		},
		{
			id: 'tooth-34',
			tooth: 'tooth-34',
			category: 'abfraction',
			label: '#34-#35 Mandibular Wear',
			color: 0xeab308,
			colorHex: '#eab308',
			offset: [0.3, 0.15, 0.15]
		},
		{
			id: 'pocket-molar',
			tooth: 'tooth-36',
			category: 'pocket',
			label: '3mm - 4mm Pockets (9% BOP)',
			color: 0xa855f7,
			colorHex: '#a855f7',
			offset: [0.55, 0.65, -0.05]
		}
	];

	const active3DMarkerObjects = [];

	// Load 3D GLB Model
	const loader = new THREE.GLTFLoader();
	loader.load(
		'/models/dental-arch-opt.glb',
		(gltf) => {
			gltf.scene.traverse((child) => {
				if (child.isMesh) {
					if (child.geometry && !child.geometry.attributes.normal) {
						child.geometry.computeVertexNormals();
					}

					const name = child.name || '';
					if (name.startsWith('tooth-')) {
						child.material = toothMaterial.clone();
						teethMeshes[name] = child;
						raycastableObjects.push(child);
					} else if (name.startsWith('gingiva-')) {
						child.material = gingivaMaterial.clone();
					} else if (name.includes('alveolar') || name.includes('mandible') || name.includes('maxilla')) {
						child.material = boneMaterial;
						child.visible = false;
						boneMeshes.push(child);
					} else if (name.includes('sinus') || name.includes('condyle')) {
						child.visible = false;
					}
				}
			});

			modelGroup.add(gltf.scene);

			// Build True 3D Clinical Issue Markers attached directly to teeth
			CLINICAL_3D_MARKERS.forEach(item => {
				const toothMesh = teethMeshes[item.tooth];
				if (!toothMesh) return;

				const markerGroup = new THREE.Group();
				markerGroup.userData = { id: item.id, category: item.category };

				// 1. Glowing 3D Beacon sphere right on the tooth surface
				const beacon = createBeaconSphere(item.color);
				beacon.userData = { id: item.id };
				markerGroup.add(beacon);

				// 2. Crisp 3D Billboard Sprite badge floating slightly above beacon
				const sprite = createTextSprite(item.label, item.colorHex, false);
				sprite.position.set(0, 0.45, 0.05);
				sprite.userData = { id: item.id };
				markerGroup.add(sprite);

				// Position marker group at tooth position + calibrated surface offset
				markerGroup.position.set(
					toothMesh.position.x + item.offset[0],
					toothMesh.position.y + item.offset[1],
					toothMesh.position.z + item.offset[2]
				);

				clinicalMarkersGroup.add(markerGroup);
				active3DMarkerObjects.push(markerGroup);
				raycastableObjects.push(beacon);
				raycastableObjects.push(sprite);
			});

			// Build Clean 3D Tooth Number Badges (#11 to #48) on every single tooth
			Object.entries(teethMeshes).forEach(([toothName, mesh]) => {
				const numStr = toothName.replace('tooth-', '#');
				const isUpper = mesh.position.y > 0;

				const numSprite = createTextSprite(numStr, '#a855f7', true);
				// Position right at the emergence edge of the tooth
				numSprite.position.set(
					mesh.position.x,
					mesh.position.y + (isUpper ? -0.45 : 0.45),
					mesh.position.z + 0.15
				);
				numSprite.userData = { toothKey: toothName };
				toothNumbersGroup.add(numSprite);
				raycastableObjects.push(numSprite);
			});

			if (loadingOverlay) loadingOverlay.classList.add('hidden');
			updateDiagnosticDrawer('tooth-36');
		},
		undefined,
		(err) => {
			console.warn('Error loading dental arch GLB:', err);
			if (loadingOverlay) {
				loadingOverlay.innerHTML = '<span style="color:#f87171;">Failed to load 3D model</span>';
			}
		}
	);

	// Update Diagnostic Drawer
	function updateDiagnosticDrawer(key) {
		const rec = CLINICAL_RECORDS[key];
		if (!rec) return;

		if (drawerTitle) drawerTitle.textContent = rec.name;
		if (drawerSubtitle) drawerSubtitle.textContent = rec.subtitle;
		if (drawerSeverity) drawerSeverity.textContent = rec.severity;
		if (drawerClinicalText) drawerClinicalText.textContent = rec.clinical;
		if (drawerBmsMechanism) drawerBmsMechanism.textContent = rec.mechanism;
		if (metricPocket) metricPocket.textContent = rec.pocket;
		if (metricBop) metricBop.textContent = rec.bop;
		if (metricSensitivity) metricSensitivity.textContent = rec.sensitivity;
		if (metricStressor) metricStressor.textContent = rec.stressor;

		// Highlight selected tooth with purple emissive glow
		if (selectedToothMesh) {
			selectedToothMesh.material.color.setHex(0xfaf8f2);
			selectedToothMesh.material.emissive.setHex(0x1c1a17);
		}

		const targetToothKey = key === 'pocket-molar' ? 'tooth-36' : key;
		if (teethMeshes[targetToothKey]) {
			selectedToothMesh = teethMeshes[targetToothKey];
			selectedToothMesh.material.color.setHex(0xffffff);
			selectedToothMesh.material.emissive.setHex(0x9333ea);
			selectedToothMesh.material.emissiveIntensity = 0.55;
		}
	}

	// Perspective Camera Views
	const VIEW_PRESETS = {
		'occlusion': {
			label: 'Both Arches (In Centric Occlusion)',
			camPos: [0, 0.45, 11.2],
			target: [0, 0, 0]
		},
		'upper': {
			label: 'Upper Arch (Maxilla & Palate)',
			camPos: [0, -5.8, 7.5],
			target: [0, 1.2, 0.2]
		},
		'lower': {
			label: 'Lower Arch (Mandible & Tooth #36)',
			camPos: [0, 5.8, 7.2],
			target: [0, -0.8, -0.3]
		}
	};

	perspectiveButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			perspectiveButtons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');

			const key = btn.getAttribute('data-view');
			const view = VIEW_PRESETS[key];
			if (!view) return;

			if (hudViewLabel) hudViewLabel.textContent = view.label;

			// Trigger smooth glide to preset
			targetCamPos.set(view.camPos[0], view.camPos[1], view.camPos[2]);
			targetLookAt.set(view.target[0], view.target[1], view.target[2]);
			isCameraAnimating = true;
		});
	});

	// Filter Logic
	filterButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			filterButtons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');

			activeFilter = btn.getAttribute('data-filter') || 'all';

			active3DMarkerObjects.forEach(group => {
				const cat = group.userData.category;
				let isVisible = false;
				if (activeFilter === 'all') isVisible = true;
				else if (activeFilter === cat) isVisible = true;
				group.visible = isVisible;
			});

			if (activeFilter === 'crown') updateDiagnosticDrawer('tooth-36');
			else if (activeFilter === 'recession') updateDiagnosticDrawer('tooth-23');
			else if (activeFilter === 'abfraction') updateDiagnosticDrawer('tooth-14');
			else if (activeFilter === 'filling') updateDiagnosticDrawer('tooth-24');
			else if (activeFilter === 'pocket') updateDiagnosticDrawer('pocket-molar');
		});
	});

	// HUD Tools Listeners
	btnNumbers?.addEventListener('click', () => {
		showNumbers = !showNumbers;
		btnNumbers.classList.toggle('active', showNumbers);
		toothNumbersGroup.visible = showNumbers;
	});

	btnSpin?.addEventListener('click', () => {
		isSpinning = !isSpinning;
		btnSpin.classList.toggle('active', isSpinning);
		if (spinLabel) spinLabel.textContent = isSpinning ? 'Pause Spin' : 'Spin 3D';
	});

	btnWireframe?.addEventListener('click', () => {
		isWireframe = !isWireframe;
		btnWireframe.classList.toggle('active', isWireframe);
		toothMaterial.wireframe = isWireframe;
		gingivaMaterial.wireframe = isWireframe;
	});

	btnReset?.addEventListener('click', () => {
		targetCamPos.set(0, 0.45, 11.2);
		targetLookAt.set(0, 0, 0);
		isCameraAnimating = true;
	});

	btnBone?.addEventListener('click', () => {
		showBone = !showBone;
		btnBone.classList.toggle('active', showBone);
		boneMeshes.forEach(m => m.visible = showBone);
	});

	// Raycaster for Clicking 3D Teeth, Sprites, and Beacons
	const raycaster = new THREE.Raycaster();
	const mouse = new THREE.Vector2();

	viewport.addEventListener('click', (e) => {
		const rect = renderer.domElement.getBoundingClientRect();
		mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
		mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

		raycaster.setFromCamera(mouse, camera);
		const intersects = raycaster.intersectObjects(raycastableObjects, true);

		if (intersects.length > 0) {
			const hit = intersects[0].object;
			let toothKey = hit.name;

			// If clicked a 3D marker or number sprite
			if (hit.userData && hit.userData.id) {
				toothKey = hit.userData.id;
			} else if (hit.userData && hit.userData.toothKey) {
				toothKey = hit.userData.toothKey;
			}

			if (CLINICAL_RECORDS[toothKey]) {
				updateDiagnosticDrawer(toothKey);
			} else if (toothKey && toothKey.startsWith('tooth-')) {
				if (drawerTitle) drawerTitle.textContent = `${toothKey.toUpperCase()} (Normal Reference Tooth)`;
				if (drawerSubtitle) drawerSubtitle.textContent = 'Intact Enamel Crown • Physiological Sulcus';
				if (drawerSeverity) drawerSeverity.textContent = 'Normal Reference';
				if (drawerClinicalText) drawerClinicalText.textContent = 'This tooth presents intact morphology without documented restoration margins, cavities, or severe cervical defects.';
				if (drawerBmsMechanism) drawerBmsMechanism.textContent = 'Acts as a normal reference surface. Not an active primary mechanical trigger in your clinical audit.';
				if (metricPocket) metricPocket.textContent = '2mm - 3mm (Normal)';
				if (metricBop) metricBop.textContent = 'Negative';
				if (metricSensitivity) metricSensitivity.textContent = 'Normal';
				if (metricStressor) metricStressor.textContent = 'None';

				// Highlight normal tooth
				if (selectedToothMesh) {
					selectedToothMesh.material.color.setHex(0xfaf8f2);
					selectedToothMesh.material.emissive.setHex(0x1c1a17);
				}
				if (teethMeshes[toothKey]) {
					selectedToothMesh = teethMeshes[toothKey];
					selectedToothMesh.material.color.setHex(0xffffff);
					selectedToothMesh.material.emissive.setHex(0x60a5fa);
					selectedToothMesh.material.emissiveIntensity = 0.4;
				}
			}
		}
	});

	// Resize Handler
	window.addEventListener('resize', () => {
		const newW = container.clientWidth;
		const newH = container.clientHeight;
		if (newW && newH) {
			camera.aspect = newW / newH;
			camera.updateProjectionMatrix();
			renderer.setSize(newW, newH);
		}
	});

	// Render Animation Loop
	function animate() {
		requestAnimationFrame(animate);

		// Turntable Rotation
		if (isSpinning) {
			modelGroup.rotation.y += 0.007;
		}

		// Smooth Camera Transition only when triggered by preset button
		if (isCameraAnimating) {
			camera.position.lerp(targetCamPos, 0.08);
			controls.target.lerp(targetLookAt, 0.08);

			if (camera.position.distanceTo(targetCamPos) < 0.03 && controls.target.distanceTo(targetLookAt) < 0.03) {
				isCameraAnimating = false;
			}
		}

		controls.update();
		renderer.render(scene, camera);
	}

	animate();
})();
</script>
