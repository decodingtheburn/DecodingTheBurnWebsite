	// Darker Anatomical Mucosal Pink Gums (#be185d deep rich pink)
	const gingivaMaterial = new THREE.MeshStandardMaterial({
		color: 0xbe185d,
		emissive: 0x4a0e24,
		roughness: 0.36,
		metalness: 0.02,
		side: THREE.DoubleSide
	});

	const boneMaterial = new THREE.MeshStandardMaterial({
		color: 0xcdbead,
		roughness: 0.55,
		metalness: 0.0,
		transparent: true,
		opacity: 0.85,
		side: THREE.DoubleSide
	});

	// Storage & State
	const teethMeshes = {};
	const boneMeshes = [];
	const raycastableObjects = [];
	let isSpinning = false;
	let isWireframe = false;
	let showBone = false;
	let showNumbers = true;
	let activeFilter = 'all';
	let selectedToothMesh = null;

	// Helper to create sharp 3D billboard text sprites
	function createTextSprite(text, borderColorHex, isSmall = false) {
		const canvas = document.createElement('canvas');
		canvas.width = isSmall ? 128 : 280;
		canvas.height = isSmall ? 64 : 80;
		const ctx = canvas.getContext('2d');

		const w = canvas.width - 6;
		const h = canvas.height - 6;
		const r = isSmall ? 10 : 14;

		// Card Background
		ctx.fillStyle = 'rgba(12, 8, 26, 0.92)';
		ctx.strokeStyle = borderColorHex;
		ctx.lineWidth = isSmall ? 4 : 5;

		ctx.beginPath();
		ctx.roundRect(3, 3, w, h, r);
		ctx.fill();
		ctx.stroke();

		// Sharp Typography
		ctx.fillStyle = '#ffffff';
		ctx.font = isSmall ? 'bold 36px system-ui, sans-serif' : 'bold 30px system-ui, sans-serif';
		ctx.textAlign = 'center';
		ctx.textBaseline = 'middle';
		ctx.fillText(text, canvas.width / 2, canvas.height / 2);

		const texture = new THREE.CanvasTexture(canvas);
		texture.minFilter = THREE.LinearFilter;
		const mat = new THREE.SpriteMaterial({
			map: texture,
			depthTest: false,
			transparent: true
		});
		const sprite = new THREE.Sprite(mat);
		sprite.scale.set(isSmall ? 0.65 : 1.55, isSmall ? 0.32 : 0.45, 1);
		return sprite;
	}

	// Helper to create a glowing 3D sphere marker sitting right on the tooth
	function createBeaconSphere(colorHex) {
		const geom = new THREE.SphereGeometry(0.13, 16, 16);
		const mat = new THREE.MeshBasicMaterial({ color: colorHex, depthTest: false });
		return new THREE.Mesh(geom, mat);
	}

	// Clinical Audit Records Dictionary
	const CLINICAL_RECORDS = {
		'tooth-36': {
			name: 'Tooth #36: Defective Distal Crown Margin & Hidden Cavities',
