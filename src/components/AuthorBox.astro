---
// Author Box Component
import { Image } from 'astro:assets';
import authorPhoto from '../assets/denis-ethier.png';

const authorName = "Denis Ethier";
const authorBio = "I am a computer programmer by trade, but on this journey, I am a BMS patient first. In programming, we are never limited by what we can do or solve. Here, I share the self-experiments that allowed me to stop my burning symptoms and help fellow sufferers decode their own pain.";
const authorWebsite = "https://www.thrivemate.com";
---

<div class="author-box">
	<div class="author-photo">
		<Image src={authorPhoto} alt={authorName} width={512} height={512} />
	</div>
	<div class="author-info">
		<h3>About the Author</h3>
		<h4>{authorName}</h4>
		<p>{authorBio}</p>
		<a href="/about" class="author-link">Read My Story →</a>
	</div>
</div>

<style>
	.author-box {
		display: flex;
		gap: 2rem;
		background: #ffffff;
		border: 1px solid var(--card-border);
		padding: 2.5rem;
		border-radius: 20px;
		margin: 4rem 0;
		align-items: center;
		box-shadow: var(--shadow-md);
	}

	.author-photo {
		flex-shrink: 0;
	}

	.author-photo img {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid var(--accent);
	}

	.author-info h3 {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 1.5px;
		color: var(--accent);
		margin: 0 0 0.5rem 0;
		font-weight: 700;
	}

	.author-info h4 {
		font-size: 1.5rem;
		margin: 0 0 0.75rem 0;
		color: var(--text-primary);
		font-weight: 800;
	}

	.author-info p {
		color: var(--text-secondary);
		line-height: 1.65;
		margin: 0 0 1.25rem 0;
		font-size: 1rem;
	}

	.author-link {
		display: inline-block;
		color: var(--accent);
		text-decoration: none;
		font-weight: 600;
		transition: opacity 0.2s ease;
	}

	.author-link:hover {
		opacity: 0.8;
	}

	@media (max-width: 768px) {
		.author-box {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
