---
---
<svg viewBox="0 0 100 100" class="logo-icon" aria-label="Decoding The Burn Logo" role="img">
  <defs>
    <!-- Outer ambient red flame glow -->
    <filter id="mouthGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#ef4444" flood-opacity="0.45"/>
      <feDropShadow dx="0" dy="3" stdDeviation="4" flood-color="#000000" flood-opacity="0.5"/>
    </filter>
    <!-- Flame Plume Gradient -->
    <linearGradient id="mouthFlameGrad" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#991b1b" stop-opacity="0.9"/>
      <stop offset="35%" stop-color="#dc2626"/>
      <stop offset="80%" stop-color="#ef4444"/>
      <stop offset="100%" stop-color="#fca5a5"/>
    </linearGradient>
    <!-- Facet Crystalline Gradients -->
    <linearGradient id="mouthFacetLight" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f87171"/>
      <stop offset="100%" stop-color="#dc2626"/>
    </linearGradient>
    <linearGradient id="mouthFacetDark" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#b91c1c"/>
      <stop offset="100%" stop-color="#450a0a"/>
    </linearGradient>
    <linearGradient id="mouthBorderRed" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ff4d4d"/>
      <stop offset="50%" stop-color="#dc2626"/>
      <stop offset="100%" stop-color="#7f1d1d"/>
    </linearGradient>
    <linearGradient id="mouthToothGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#e2e8f0"/>
    </linearGradient>
  </defs>

  <g filter="url(#mouthGlow)">
    <!-- 1. Rising Flame Plumes Above Mouth -->
    <!-- Left Plumes -->
    <path d="M 28,45 C 22,34 26,20 38,12 C 35,20 40,26 44,32 C 38,36 32,40 28,45 Z" fill="url(#mouthFlameGrad)" opacity="0.9"/>
    <!-- Center Plumes -->
    <path d="M 42,32 C 44,18 52,8 58,2 C 55,10 62,18 64,24 C 56,28 48,30 42,32 Z" fill="url(#mouthFlameGrad)"/>
    <circle cx="58" cy="2" r="1.5" fill="#fca5a5"/>
    <!-- Right Plumes -->
    <path d="M 58,28 C 66,20 74,14 80,10 C 76,18 76,26 68,34 C 64,30 60,28 58,28 Z" fill="url(#mouthFlameGrad)" opacity="0.95"/>
    <circle cx="80" cy="10" r="1.2" fill="#ef4444"/>

    <!-- 2. Base Dark Charcoal Beveled Hull of the Mouth -->
    <path d="M 12,50 C 22,34 38,32 46,36 C 48,37 50,39 50,39 C 50,39 52,37 54,36 C 62,32 78,34 88,50 C 80,74 62,80 50,80 C 38,80 20,74 12,50 Z" 
          fill="#0a0c10" stroke="#000000" stroke-width="2.5" stroke-linejoin="round"/>
    
    <!-- Red Outer Rim Bevel -->
    <path d="M 14,50 C 23,36 37,34 45,38 C 47,39 50,40 50,40 C 50,40 53,39 55,38 C 63,34 77,36 86,50 C 78,72 61,78 50,78 C 39,78 22,72 14,50 Z" 
          fill="none" stroke="url(#mouthBorderRed)" stroke-width="1.8" stroke-linejoin="round"/>

    <!-- 3. Upper Lip Faceted Shards -->
    <polygon points="17,50 30,40 42,44 32,50" fill="url(#mouthFacetLight)"/>
    <polygon points="30,40 45,38 46,47 42,44" fill="#ef4444"/>
    <polygon points="83,50 70,40 58,44 68,50" fill="url(#mouthFacetLight)"/>
    <polygon points="70,40 55,38 54,47 58,44" fill="#ef4444"/>
    <!-- Center Cupid's Bow -->
    <polygon points="46,47 50,43 54,47 50,51" fill="#ff7676"/>

    <!-- 4. Oral Cavity -->
    <path d="M 20,50 C 30,48 44,48 50,48 C 56,48 70,48 80,50 C 74,64 60,66 50,66 C 40,66 26,64 20,50 Z" fill="#040507"/>

    <!-- 5. Bright White & Beveled Teeth Row -->
    <!-- Central Left Incisor -->
    <rect x="44" y="49" width="5.5" height="8.5" rx="1" fill="url(#mouthToothGrad)" stroke="#1e293b" stroke-width="0.8"/>
    <!-- Central Right Incisor -->
    <rect x="50.5" y="49" width="5.5" height="8.5" rx="1" fill="url(#mouthToothGrad)" stroke="#1e293b" stroke-width="0.8"/>
    <!-- Left Lateral Incisor -->
    <rect x="37.5" y="49.5" width="5.5" height="7.5" rx="1" fill="url(#mouthToothGrad)" stroke="#1e293b" stroke-width="0.8"/>
    <!-- Right Lateral Incisor -->
    <rect x="57" y="49.5" width="5.5" height="7.5" rx="1" fill="url(#mouthToothGrad)" stroke="#1e293b" stroke-width="0.8"/>
    <!-- Left Canine -->
    <polygon points="31,50.5 36.5,50 36.5,56 32,55" fill="url(#mouthToothGrad)" stroke="#1e293b" stroke-width="0.8"/>
    <!-- Right Canine -->
    <polygon points="69,50.5 63.5,50 63.5,56 68,55" fill="url(#mouthToothGrad)" stroke="#1e293b" stroke-width="0.8"/>

    <!-- 6. Lower Lip Faceted Shards -->
    <polygon points="17,52 32,56 30,67 20,60" fill="#b91c1c"/>
    <polygon points="32,56 46,55 44,72 30,67" fill="url(#mouthFacetDark)"/>
    <polygon points="46,55 50,56 50,76 44,72" fill="#991b1b"/>
    <polygon points="83,52 68,56 70,67 80,60" fill="#b91c1c"/>
    <polygon points="68,56 54,55 56,72 70,67" fill="url(#mouthFacetDark)"/>
    <polygon points="54,55 50,56 50,76 56,72" fill="#991b1b"/>

    <!-- Center Lower Lip Highlight -->
    <polygon points="46,73 50,76 54,73 50,68" fill="#ef4444"/>
  </g>
</svg>


