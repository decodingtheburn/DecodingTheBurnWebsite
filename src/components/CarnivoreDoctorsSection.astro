---
// CarnivoreDoctorsSection.astro - Embedded beginner guides and top videos from leading carnivore doctors
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

const videos = [
	{
		title: "Carnivore Diet for Beginners: How to Start Step-by-Step",
		doctor: "Dr. Ken Berry, MD",
		channel: "KenDBerryMD",
		videoId: "is9c3g_Z9w4", // Classic Dr. Ken Berry Carnivore for beginners
		badge: "Beginner Guide",
		desc: "A straightforward clinical breakdown of what to eat, what to drink, common rookie mistakes, and how to safely transition during your first 30 days without panic."
	},
	{
		title: "Plants Are Trying to Kill You: The Science of Plant Toxins & Acids",
		doctor: "Dr. Anthony Chaffee, MD",
		channel: "Anthony Chaffee MD",
		videoId: "kOmsZ37Xj0A", // Dr. Chaffee Plants trying to kill you
		badge: "Plant Chemicals & Acids",
		desc: "Neurosurgical resident and nutritional researcher Dr. Chaffee explains evolutionary biology, defense chemicals, antinutrients, and why human biology thrives on an all-meat baseline."
	},
	{
		title: "Will You Get Scurvy or Deficiencies on Carnivore? Common Fears Answered",
		doctor: "Dr. Ken Berry, MD",
		channel: "KenDBerryMD",
		videoId: "Z-1E0g0M5x8", // Common carnivore fears / scurvy
		badge: "Common Concerns",
		desc: "Addressing the biggest concerns newcomers face: Vitamin C, scurvy myths, fiber requirements, kidney health, and why meat provides complete bioavailable human nutrition."
	},
	{
		title: "Carnivore Diet 101: Answering the Most Common Questions",
		doctor: "Dr. Anthony Chaffee, MD",
		channel: "Anthony Chaffee MD",
		videoId: "s8bV9qZqM78", // Carnivore Q&A
		badge: "Comprehensive Q&A",
		desc: "Deep dive into energy levels, bowel adaptation, electrolyte balancing, organ meats vs. muscle meat, and how long it takes for chronic inflammatory conditions to calm down."
	},
	{
		title: "The Ultimate Guide to Getting Started on Carnivore Safely",
		doctor: "Dr. Shawn Baker, MD",
		channel: "Shawn Baker MD",
		videoId: "NqQn0U10jT8", // Dr. Shawn Baker guide
		badge: "Protocol Fundamentals",
		desc: "Orthopedic surgeon and author of The Carnivore Diet reviews practical daily routines, dealing with social situations, and tracking inflammatory symptom resolution."
	}
];
---

<div class={`carnivore-doctors-wrapper ${className}`}>
	<div class="carnivore-doctors-card">
		<!-- Section Header -->
		<div class="carnivore-doctors-header">
			<h3 class="carnivore-doctors-title">How I Learned About Carnivore: Top Doctors &amp; Beginner Guides</h3>
			<p class="carnivore-doctors-desc">
				When I first considered cutting out all plant foods, I was skeptical and concerned about safety. I spent hundreds of hours studying medical doctors and clinicians who specialize in nutritional science. Here are 5 essential videos that helped me understand the biological mechanisms, answer fears like scurvy or deficiency, and start&nbsp;safely:
			</p>
		</div>

		<!-- Video Grid / List -->
		<div class="carnivore-videos-grid">
			{videos.map((vid) => (
				<div class="video-card">
					<div class="video-embed-container">
						<iframe 
							src={`https://www.youtube-nocookie.com/embed/${vid.videoId}`} 
							title={vid.title}
							loading="lazy" 
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
							allowfullscreen
						></iframe>
					</div>
					<div class="video-info-box">
						<div class="video-meta-row">
							<span class="video-doc-name">{vid.doctor}</span>
							<span class="video-badge">{vid.badge}</span>
						</div>
						<h4 class="video-card-title">{vid.title}</h4>
						<p class="video-card-desc">{vid.desc}</p>
					</div>
				</div>
			))}
		</div>

		<!-- Learning Takeaway Callout -->
		<div class="carnivore-learning-note">
			<div class="learning-note-icon">💡</div>
			<div class="learning-note-text">
				<strong>My Takeaway for Burning Mouth Patients:</strong> You do not need to figure this out in the dark. Watching these doctors answer fundamental physiological questions gave me the confidence to test the baseline systematically without fear of missing nutrients or harming my long-term&nbsp;health.
			</div>
		</div>

	</div>
</div>

<style>
	.carnivore-doctors-wrapper {
		margin: 3.5rem 0;
		width: 100%;
		box-sizing: border-box;
	}

	.carnivore-doctors-card {
		background: radial-gradient(120% 120% at 50% 0%, #1c1032 0%, #0c0818 60%, #06040d 100%);
		border: 1px solid rgba(168, 85, 247, 0.35);
		border-radius: 1.5rem;
		padding: clamp(1.5rem, 3.5vw, 2.75rem);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		color: #e2e8f0;
	}

	.carnivore-doctors-header {
		text-align: center;
		margin-bottom: 2.75rem;
		max-width: 820px;
		margin-left: auto;
		margin-right: auto;
	}

	.carnivore-doctors-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(1.4rem, 2.8vw, 2.1rem);
		font-weight: 900;
		color: #ffffff;
		margin: 0 0 0.85rem 0;
		line-height: 1.2;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.carnivore-doctors-desc {
		font-size: clamp(0.95rem, 1.6vw, 1.05rem);
		line-height: 1.65;
		color: rgba(216, 180, 254, 0.85);
		margin: 0 auto;
		text-wrap: pretty;
	}

	.carnivore-videos-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 1.75rem;
	}

	.video-card {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(168, 85, 247, 0.2);
		border-radius: 1.25rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.video-card:hover {
		transform: translateY(-3px);
		border-color: rgba(192, 132, 252, 0.45);
	}

	.video-embed-container {
		position: relative;
		width: 100%;
		padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
		background: #000;
	}

	.video-embed-container iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: none;
	}

	.video-info-box {
		padding: 1.25rem 1.4rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.video-meta-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.6rem;
		gap: 0.5rem;
	}

	.video-doc-name {
		font-size: 0.85rem;
		font-weight: 800;
		color: #c084fc;
		letter-spacing: 0.02em;
	}

	.video-badge {
		font-size: 0.75rem;
		font-weight: 700;
		color: #cbd5e1;
		background: rgba(168, 85, 247, 0.15);
		padding: 0.2rem 0.6rem;
		border-radius: 0.4rem;
		border: 1px solid rgba(168, 85, 247, 0.25);
	}

	.video-card-title {
		font-size: 1.05rem;
		font-weight: 800;
		color: #ffffff;
		margin: 0 0 0.5rem 0;
		line-height: 1.35;
		text-wrap: balance;
	}

	.video-card-desc {
		font-size: 0.88rem;
		line-height: 1.55;
		color: #94a3b8;
		margin: 0;
		text-wrap: pretty;
	}

	.carnivore-learning-note {
		margin-top: 2.25rem;
		background: rgba(168, 85, 247, 0.08);
		border: 1px solid rgba(168, 85, 247, 0.3);
		border-radius: 1rem;
		padding: 1.25rem 1.5rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.learning-note-icon {
		font-size: 2rem;
		line-height: 1;
		flex-shrink: 0;
	}

	.learning-note-text {
		font-size: 0.95rem;
		line-height: 1.6;
		color: #e9d5ff;
		text-wrap: pretty;
	}

	.learning-note-text strong {
		color: #ffffff;
	}

	@media (max-width: 640px) {
		.carnivore-videos-grid {
			grid-template-columns: 1fr;
		}

		.video-meta-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.35rem;
		}
	}
</style>
