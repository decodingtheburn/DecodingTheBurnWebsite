---
// CarnivoreDoctorsSection.astro - Embedded beginner guides and top videos from leading carnivore doctors
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

const videos = [
	{
		title: "7 Things I Wish I Knew Before Starting the Carnivore Diet",
		doctor: "Dr. Ken Berry, MD",
		channel: "KenDBerryMD",
		videoId: "t2om-RJbLyg",
		directUrl: "https://www.youtube.com/watch?v=t2om-RJbLyg",
		badge: "Essential Advice",
		desc: "Dr. Ken Berry shares the 7 crucial lessons and practical tips he wishes he knew when starting carnivore, covering fat adaptation, electrolytes, and avoiding common pitfalls."
	},
	{
		title: "Does the Carnivore Diet Cause Scurvy? Dietitian vs Doctor Debunked",
		doctor: "Dr. Ken Berry, MD",
		channel: "KenDBerryMD",
		videoId: "mPTsS2oC68c",
		directUrl: "https://www.youtube.com/watch?v=mPTsS2oC68c",
		badge: "Common Concerns (Scurvy)",
		desc: "Addressing the biggest concerns newcomers face: Vitamin C, scurvy myths, fiber requirements, kidney health, and why meat provides complete bioavailable human nutrition."
	},
	{
		title: "Plants Are Trying to Kill You: The Science of Plant Toxins & Acids",
		doctor: "Dr. Anthony Chaffee, MD",
		channel: "Anthony Chaffee MD",
		videoId: "j1cqNDDG4aA",
		directUrl: "https://www.youtube.com/watch?v=j1cqNDDG4aA",
		badge: "Plant Chemicals & Acids",
		desc: "Neurosurgical resident and nutritional researcher Dr. Chaffee explains evolutionary biology, defense chemicals, antinutrients, and why human biology thrives on an all-meat baseline."
	},
	{
		title: "The Ultimate Carnivore Beginner Guide & Daily Routine",
		doctor: "Dr. Shawn Baker, MD",
		channel: "Shawn Baker MD",
		videoId: "jwEpnioTQLA",
		directUrl: "https://www.youtube.com/watch?v=jwEpnioTQLA",
		badge: "Protocol Fundamentals",
		desc: "Orthopedic surgeon and author of The Carnivore Diet reviews practical daily routines, dealing with social situations, and tracking inflammatory symptom resolution."
	}
];
---

<div class={`carnivore-doctors-wrapper ${className}`}>
	<div class="carnivore-doctors-card">
		<!-- Section Header -->
		<div class="carnivore-doctors-header">
			<h3 class="carnivore-doctors-title">How I Learned About Carnivore: Top Doctors &amp; Beginner Guides</h3>
			<p class="carnivore-doctors-desc">
				When I first considered cutting out all plant foods, I was skeptical and concerned about safety. I spent hundreds of hours studying medical doctors and clinicians who specialize in nutritional science. Here are essential videos that helped me understand the biological mechanisms, answer fears like scurvy or deficiency, and start&nbsp;safely:
			</p>
		</div>

		<!-- Video Grid / List -->
		<div class="carnivore-videos-grid">
			{videos.map((vid) => (
				<div class="video-card">
					<div class="video-embed-container">
						<iframe 
							src={`https://www.youtube-nocookie.com/embed/${vid.videoId}`} 
							title={vid.title}
							loading="lazy" 
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
							allowfullscreen
						></iframe>
					</div>
					<div class="video-info-box">
						<div class="video-meta-row">
							<span class="video-doc-name">{vid.doctor}</span>
							<span class="video-badge">{vid.badge}</span>
						</div>
						<h4 class="video-card-title">{vid.title}</h4>
						<p class="video-card-desc">{vid.desc}</p>
						<div class="video-footer-link">
							<a href={vid.directUrl} target="_blank" rel="noopener noreferrer" class="watch-on-yt-link">
								Watch on YouTube &rarr;
							</a>
						</div>
					</div>
				</div>
			))}
		</div>

		<!-- Learning Takeaway Callout -->
		<div class="carnivore-learning-note">
			<div class="learning-note-icon">💡</div>
			<div class="learning-note-text">
				<strong>My Takeaway for Burning Mouth Patients:</strong> You do not need to figure this out in the dark. Watching these doctors answer fundamental physiological questions gave me the confidence to test the baseline systematically without fear of missing nutrients or harming my long-term&nbsp;health.
			</div>
		</div>

	</div>
</div>

<style>
	.carnivore-doctors-wrapper {
		margin: 3.5rem 0;
		width: 100%;
		box-sizing: border-box;
	}

	.carnivore-doctors-card {
		background: radial-gradient(120% 120% at 50% 0%, #1c1032 0%, #0c0818 60%, #06040d 100%);
		border: 1px solid rgba(168, 85, 247, 0.35);
		border-radius: 1.5rem;
		padding: clamp(1.5rem, 3.5vw, 2.75rem);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		color: #e2e8f0;
	}

	.carnivore-doctors-header {
		text-align: center;
		margin-bottom: 2.75rem;
		max-width: 820px;
		margin-left: auto;
		margin-right: auto;
	}

	.carnivore-doctors-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(1.4rem, 2.8vw, 2.1rem);
		font-weight: 900;
		color: #ffffff !important;
		margin: 0 0 0.85rem 0;
		line-height: 1.2;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.carnivore-doctors-desc {
		font-size: clamp(0.95rem, 1.6vw, 1.05rem);
		line-height: 1.65;
		color: rgba(216, 180, 254, 0.85);
		margin: 0 auto;
		text-wrap: pretty;
	}

	.carnivore-videos-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 1.75rem;
	}

	.video-card {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(168, 85, 247, 0.2);
		border-radius: 1.25rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.video-card:hover {
		transform: translateY(-3px);
		border-color: rgba(192, 132, 252, 0.45);
	}

	.video-embed-container {
		position: relative;
		width: 100%;
		padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
		background: #000;
	}

	.video-embed-container iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: none;
	}

	.video-info-box {
		padding: 1.25rem 1.4rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.video-meta-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.6rem;
		gap: 0.5rem;
	}

	.video-doc-name {
		font-size: 0.85rem;
		font-weight: 800;
		color: #c084fc;
		letter-spacing: 0.02em;
	}

	.video-badge {
		font-size: 0.72rem;
		font-weight: 700;
		color: #fca5a5;
		background: rgba(239, 68, 68, 0.15);
		border: 1px solid rgba(239, 68, 68, 0.35);
		padding: 0.2rem 0.55rem;
		border-radius: 0.35rem;
		white-space: nowrap;
	}

	.video-card-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: 1.12rem;
		font-weight: 800;
		color: #ffffff;
		margin: 0 0 0.5rem 0;
		line-height: 1.35;
		letter-spacing: -0.015em;
		text-wrap: balance;
	}

	.video-card-desc {
		font-size: 0.86rem;
		line-height: 1.55;
		color: #94a3b8;
		margin: 0 0 1rem 0;
		flex-grow: 1;
		text-wrap: pretty;
	}

	.video-footer-link {
		margin-top: auto;
		padding-top: 0.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.watch-on-yt-link {
		color: #f43f5e;
		font-size: 0.84rem;
		font-weight: 700;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		transition: color 0.15s ease, transform 0.15s ease;
	}

	.watch-on-yt-link:hover {
		color: #fb7185;
		text-decoration: underline;
		transform: translateX(2px);
	}

	/* Learning Takeaway Callout */
	.carnivore-learning-note {
		margin-top: 2.25rem;
		background: rgba(168, 85, 247, 0.08);
		border: 1px solid rgba(168, 85, 247, 0.3);
		border-radius: 1rem;
		padding: 1.25rem 1.5rem;
		display: flex;
		align-items: center;
		gap: 1.15rem;
	}

	.learning-note-icon {
		font-size: 2rem;
		line-height: 1;
		flex-shrink: 0;
	}

	.learning-note-text {
		font-size: 0.95rem;
		line-height: 1.6;
		color: #e9d5ff;
		text-wrap: pretty;
	}

	.learning-note-text strong {
		color: #ffffff;
	}

	@media (max-width: 600px) {
		.carnivore-learning-note {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.65rem;
			padding: 1.15rem;
		}
	}
</style>
