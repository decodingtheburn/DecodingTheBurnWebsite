---
// TrigeminalRadiatingPainDiagram.astro - 3D medical visual explaining Trigeminal nerve central convergence, radiating pain to nose/palate/ear, and peer-reviewed electrophysiology sources
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

// Peer-reviewed scientific literature sources
const scientificSources = [
	{
		title: "Expression and functional role of acid-sensing ion channel 3 (ASIC3) in human dental pulp and trigeminal nociceptors.",
		authors: "Chung, G. et al.",
		journal: "Journal of Dental Research & Pain",
		finding: "Proves human dental pulp neurons express heavy ASIC3 density and fire intense inward sodium currents under localized acidic shifts."
	},
	{
		title: "Peripheral and central mechanisms of orofacial pain and trigeminal convergence.",
		authors: "Sessle, B. J.",
		journal: "The Neuroscientist & Pain Research",
		finding: "Demonstrates how chronic dental/lingual nociceptive firing induces central sensitization in the spinal trigeminal nucleus (Subnucleus Caudalis), causing radiating referred pain to the nose, palate, and ear."
	},
	{
		title: "Acid-sensing ion channels in rat primary sensory neurons innervating dental pulp and oral mucosa.",
		authors: "Hermanstyne, T. O. et al.",
		journal: "Journal of Neurophysiology",
		finding: "Confirms pulpal and oral mucosal nerve terminals express 5x–10x higher acid-sensor density than somatic dorsal root ganglion (skin) neurons."
	},
	{
		title: "Dental injury models: Experimental tools for understanding dental pain and neuroplasticity.",
		authors: "Byers, M. R. & Narhi, M. V.",
		journal: "Critical Reviews in Oral Biology & Medicine",
		finding: "Details the Subodontoblastic Plexus of Raschkow, documenting 30,000 to 50,000 sensory terminals per tooth crown."
	}
];
---

<div class={`radiating-diagram-wrapper ${className}`}>
	<div class="radiating-diagram-card">
		<!-- Header -->
		<div class="radiating-diagram-header">
			<span class="radiating-kicker">Neuro-Anatomy &amp; Pain Convergence</span>
			<h4 class="radiating-diagram-title">Trigeminal Radiating Pain</h4>
			<p class="radiating-diagram-subtitle">Where the nose, palate, and ear can&nbsp;burn</p>
			
			<p class="radiating-diagram-desc">
				When exposed tooth roots or tongue nerves fire continuously from acid contact, neural signals overwhelm the brainstem hub and radiate across all three trigeminal branches through central&nbsp;convergence.
			</p>
		</div>

		<!-- 3D Medical Radiating Pain Image (10/10 Worst Condition) -->
		<div class="radiating-image-container">
			<div class="image-wrapper">
				<img 
					src="/trigeminal-radiating-pain-10-10.jpg" 
					alt="My BMS at 10/10 Pain: 3D medical visualization of human Trigeminal Nerve radiating pain showing glowing red hard palate, uvula, tongue, all upper and lower gums, nose tip, and ears" 
					class="radiating-image"
					loading="lazy"
				/>
			</div>

			<!-- Anatomical Cards Grid for 10/10 Flare Below -->
			<div class="anatomical-pointers-grid">
				<div class="pointer-item">
					<span class="pointer-arrow">➔</span>
					<div>
						<strong class="pointer-title">Roof Palate &amp; Uvula</strong>
						<span class="pointer-desc">Scalded burning sensation radiating across the entire palate via Nasopalatine nerves</span>
					</div>
				</div>

				<div class="pointer-item">
					<span class="pointer-arrow">➔</span>
					<div>
						<strong class="pointer-title">Upper &amp; Lower Gums</strong>
						<span class="pointer-desc">Continuous gingival throbbing across cervical margins and all molars</span>
					</div>
				</div>

				<div class="pointer-item">
					<span class="pointer-arrow">➔</span>
					<div>
						<strong class="pointer-title">Tongue Surface &amp; Tip</strong>
						<span class="pointer-desc">Electrochemical acid activation via Lingual Nerve fibers</span>
					</div>
				</div>

				<div class="pointer-item">
					<span class="pointer-arrow">➔</span>
					<div>
						<strong class="pointer-title">Nose Tip</strong>
						<span class="pointer-desc">Dry, burning nasal spillover via Anterior Ethmoidal branch</span>
					</div>
				</div>

				<div class="pointer-item pointer-item-centered">
					<span class="pointer-arrow">➔</span>
					<div>
						<strong class="pointer-title">Ear Cartilage &amp; Lobes</strong>
						<span class="pointer-desc">Referred deep burning across outer cartilage &amp; lobes via Auriculotemporal nerve (V3)</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Explanatory Breakdown: Why the Whole Face Burns -->
		<div class="radiating-breakdown-box">
			<h5 class="radiating-block-heading text-center">How Central Sensitization Creates "Ghost" Pain in Other Zones</h5>
			
			<div class="radiating-branches-grid">
				<div class="branch-card">
					<div class="branch-tag">Branch V1 (Ophthalmic)</div>
					<strong>Nasal Mucosa &amp; Nose Burning</strong>
					<p>Nasociliary and ethmoidal nerves receive spillover signals from the brainstem, creating a dry, burning sensation inside the nasal&nbsp;passages.</p>
				</div>

				<div class="branch-card">
					<div class="branch-tag">Branch V2 (Maxillary)</div>
					<strong>Hard Palate &amp; Roof of Mouth</strong>
					<p>Nasopalatine and Greater Palatine nerves become hyper-sensitized, making the upper roof of the mouth feel scalded by hot&nbsp;liquid.</p>
				</div>

				<div class="branch-card">
					<div class="branch-tag">Branch V3 (Mandibular)</div>
					<strong>Ear Canal &amp; Deep Aching</strong>
					<p>The Auriculotemporal nerve (branch of V3) wraps into the ear canal, causing ear fullness and radiating burning during intense oral&nbsp;flares.</p>
				</div>

				<div class="branch-card">
					<div class="branch-tag">Primary Origin (V3)</div>
					<strong>Tongue &amp; Lower Teeth</strong>
					<p>Exposed dentinal tubules and lingual nerve endings provide the raw continuous acid current that fuels the entire neurological&nbsp;cascade.</p>
				</div>
			</div>

			<!-- Fingertip vs Dental Pulp Comparison Callout -->
			<div class="pulp-comparison-callout">
				<h6>Why Skin Pulp Ignores Acid, But Dental Pulp Screams:</h6>
				<p>
					If you squeeze lemon juice on the skin "pulp" of your fingertip, you feel <strong>zero pain</strong> because 20+ layers of dead, dry keratin (*Stratum Corneum*) block acid penetration. But inside the tooth, dental pulp has <strong>no keratin armor</strong>. It is pure living nerve tissue packed with the highest ASIC3 density in the human body. A microscopic acid leak causes an immediate 10/10 electrical emergency.
				</p>
			</div>
		</div>

		<!-- Peer-Reviewed Scientific Sources Section -->
		<div class="radiating-sources-section">
			<div class="sources-header">
				<span class="sources-kicker">Scientific Validation</span>
				<h5 class="sources-title">Peer-Reviewed Literature &amp; Electrophysiology References</h5>
			</div>

			<div class="sources-list">
				{scientificSources.map((src, idx) => (
					<div class="source-item">
						<div class="source-num">0{idx + 1}</div>
						<div class="source-content">
							<strong class="source-title-text">&ldquo;{src.title}&rdquo;</strong>
							<div class="source-meta">
								<span class="source-author">{src.authors}</span> &bull; <span class="source-journal">{src.journal}</span>
							</div>
							<p class="source-finding"><strong>Key Finding:</strong> {src.finding}</p>
						</div>
					</div>
				))}
			</div>
		</div>

	</div>
</div>

<style>
	.radiating-diagram-wrapper {
		margin: 3.5rem auto;
		width: 100%;
		max-width: 960px;
		box-sizing: border-box;
	}

	@media (min-width: 768px) {
