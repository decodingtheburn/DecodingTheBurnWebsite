---
// LeakyCrownDiagram.astro - High-contrast visual container explaining Leaky Crowns, Defective Fillings, & Dental Restorations
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`tubule-diagram-wrapper ${className}`}>
	<div class="tubule-diagram-card">
		<div class="tubule-diagram-header">
			<h4 class="tubule-diagram-title">Restoration Micro-Leakage &amp; Acid Pathways</h4>
			<p class="tubule-diagram-desc">
				When dental cement sealing crowns, fillings, or veneers degrades, acidic fluids and oral bacteria seep through micro-gaps directly into tooth dentin and the central pulp chamber.
			</p>
		</div>

		<!-- 3D Medical Cross-Section Image Container (Leaky Crown 3D Diagram) -->
		<div class="tubule-image-container">
			<img 
				src="/leaky-crown-cross-section-3d.jpg" 
				alt="High-detail 3D anatomical cross-section of a human tooth with a porcelain dental crown showing a large defective crown margin gap near the gum line with one prominent red arrow pointing H+ acid directly into the central dental pulp chamber" 
				class="tubule-image"
				loading="lazy"
			/>
			
			<div class="tubule-pointer-callout">
				<div class="tubule-callout-arrow">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="12" y1="5" x2="12" y2="19"></line>
						<polyline points="19 12 12 19 5 12"></polyline>
					</svg>
				</div>
				<p class="tubule-callout-text">
					<strong>Defective Crown Margin &amp; Pulpal Infiltration:</strong> A large mechanical margin defect near the gum line allows free hydrogen ions (H⁺) from acidic foods to bypass outer porcelain and dentin entirely, seeping directly into the central pulp chamber and pulpal nerve trunk.
				</p>
			</div>
		</div>

		<!-- Dental Radiograph X-Ray Container (My Defective Crown Case Study) -->
		<div class="tubule-sem-container">
			<div class="tubule-sem-media">
				<img 
					src="/defective-crown-margin-xray.png" 
					alt="Bitewing radiograph highlighting a defective crown margin gap (red circle)" 
					class="tubule-sem-image"
					style="object-fit: contain; padding: 1rem;"
					loading="lazy"
				/>
			</div>
			<div class="tubule-sem-caption">
				<div class="tubule-sem-meta-row">
					<span class="tubule-sem-kicker">Clinical Radiographic Evidence (Bitewing X-Ray)</span>
					<span class="tubule-sem-source">N=1 Story: 20-Year-Old Crown Restoration</span>
				</div>
				<h5 class="tubule-sem-title">Radiographic Proof: Margin Micro-Gap (Red Circle)</h5>
				<p class="tubule-sem-desc">
					This bitewing X-ray shows my 20-year-old crown with a defective margin gap (red circle). At the peak of my BMS pain, clinicians dismissed it, asserting that a localized dental margin could never cause generalized oral burning. However, once I had this defective restoration replaced and properly sealed, my lower arch burning decreased dramatically.
				</p>
			</div>
		</div>
	</div>
</div>

<style>
	.tubule-diagram-wrapper {
		margin: 3.5rem 0;
		width: 100%;
		box-sizing: border-box;
	}

	.tubule-diagram-card {
		background: radial-gradient(120% 120% at 50% 0%, #1e1136 0%, #0d081a 60%, #080410 100%);
		border: 1px solid rgba(168, 85, 247, 0.35);
		border-radius: 1.5rem;
		padding: clamp(1.5rem, 3.5vw, 2.5rem);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		color: #e2e8f0;
	}

	.tubule-diagram-header {
		text-align: center;
		margin-bottom: 2rem;
		max-width: 780px;
		margin-left: auto;
		margin-right: auto;
	}

	.tubule-diagram-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(1.4rem, 2.8vw, 1.95rem);
		font-weight: 900;
		color: #ffffff;
		margin: 0 0 0.85rem 0;
		line-height: 1.25;
		text-wrap: balance;
		letter-spacing: -0.02em;
	}

	.tubule-diagram-desc {
		font-size: clamp(0.95rem, 1.6vw, 1.05rem);
		line-height: 1.65;
		color: #cbd5e1;
		margin: 0;
		text-wrap: pretty;
	}

	.tubule-image-container {
		width: 100%;
		max-width: 680px;
		margin: 0 auto 2.25rem auto;
		background: rgba(10, 6, 20, 0.6);
		border-radius: 1.25rem;
		border: 1px solid rgba(168, 85, 247, 0.3);
		padding: 0.75rem;
		box-sizing: border-box;
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
		overflow: hidden;
	}

	.tubule-image {
		width: 100%;
		height: auto;
		max-height: 560px;
		object-fit: contain;
		display: block;
		margin: 0 auto;
		border-radius: 0.85rem;
	}

	.tubule-pointer-callout {
		margin-top: 1rem;
		padding: 1rem 1.25rem;
		background: rgba(168, 85, 247, 0.12);
		border: 1px solid rgba(168, 85, 247, 0.35);
		border-radius: 0.85rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.tubule-callout-arrow {
		color: #c084fc;
		background: rgba(168, 85, 247, 0.25);
		border-radius: 50%;
		width: 38px;
		height: 38px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		animation: bounceArrow 2s infinite ease-in-out;
	}

	@keyframes bounceArrow {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(4px); }
	}

	.tubule-callout-text {
		font-size: 0.92rem;
		line-height: 1.55;
		color: #e2e8f0;
		margin: 0;
		text-wrap: pretty;
	}

	.tubule-callout-text strong {
		color: #fde047;
	}

	.tubule-sem-container {
		width: 100%;
		max-width: 680px;
		margin: 0 auto 0.5rem auto;
		background: rgba(13, 8, 26, 0.7);
		border: 1px solid rgba(168, 85, 247, 0.28);
		border-radius: 1.25rem;
		overflow: hidden;
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
		display: flex;
		flex-direction: column;
	}

	.tubule-sem-media {
		position: relative;
		width: 100%;
		max-height: 380px;
		background: #05020a;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		border-bottom: 1px solid rgba(168, 85, 247, 0.2);
	}

	.tubule-sem-image {
		width: 100%;
		height: 100%;
		max-height: 380px;
		display: block;
	}

	.tubule-sem-caption {
		padding: 1.5rem 1.75rem;
		display: flex;
		flex-direction: column;
	}

	.tubule-sem-meta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.45rem;
	}

	.tubule-sem-kicker {
		font-size: 0.82rem;
		font-weight: 700;
		color: #c084fc;
		letter-spacing: 0.03em;
		text-transform: none;
	}

	.tubule-sem-source {
		font-size: 0.76rem;
		font-style: italic;
		color: #94a3b8;
		letter-spacing: 0.01em;
	}

	.tubule-sem-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: 1.18rem;
		font-weight: 800;
		color: #ffffff;
		margin: 0 0 0.75rem 0;
		line-height: 1.35;
		text-wrap: balance;
	}

	.tubule-sem-desc {
		font-size: 0.94rem;
		line-height: 1.65;
		color: #cbd5e1;
		margin: 0;
		text-wrap: pretty;
	}

	.tubule-sem-desc strong {
		color: #f1f5f9;
	}
</style>
