---
// Carnivore18MonthTimeline.astro - Focused 18-Month Carnivore Experiment Timeline with Axis Descriptors
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`carnivore-timeline-widget tts-ignore ${className}`} id="carnivore-18m-timeline-box">
	<!-- Centered Title Header -->
	<div class="carnivore-widget-header">
		<h3 class="carnivore-widget-title">
			<span class="carnivore-title-main">Pain Levels During the Three Carnivore&nbsp;Phases</span>
		</h3>
	</div>

	<div class="carnivore-timeline-wrapper">
		<!-- SVG Canvas: Clean left edge, Right-Side Vertical Y-Axis Numbers & Small Axis Descriptors -->
		<svg 
			viewBox="870 -50 635 565" 
			class="carnivore-timeline-svg" 
			preserveAspectRatio="xMidYMid meet"
			aria-label="18-Month BMS Carnivore Experiment Progression Chart showing Pain Levels During the Three Carnivore Phases"
		>
			<defs>
				<!-- Discrete Stepped Gradient: 5-10 = Red, 2-5 = Amber, 0-2 = Emerald Green -->
				<linearGradient id="c18CurveGradient" x1="0%" y1="0%" x2="0%" y2="100%">
					<stop offset="0%" stop-color="#ef4444" />
					<stop offset="50%" stop-color="#ef4444" />
					<stop offset="50%" stop-color="#f59e0b" />
					<stop offset="80%" stop-color="#f59e0b" />
					<stop offset="80%" stop-color="#10b981" />
					<stop offset="100%" stop-color="#10b981" />
				</linearGradient>

				<linearGradient id="c18AreaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
					<stop offset="0%" stop-color="rgba(239, 68, 68, 0.18)" />
					<stop offset="50%" stop-color="rgba(239, 68, 68, 0.18)" />
					<stop offset="50%" stop-color="rgba(245, 158, 11, 0.10)" />
					<stop offset="80%" stop-color="rgba(245, 158, 11, 0.10)" />
					<stop offset="80%" stop-color="rgba(16, 185, 129, 0.05)" />
					<stop offset="100%" stop-color="rgba(16, 185, 129, 0.02)" />
				</linearGradient>

				<!-- Glow Filter -->
				<filter id="c18Glow" x="-20%" y="-20%" width="140%" height="140%">
					<feGaussianBlur stdDeviation="3.5" result="blur" />
					<feMerge>
						<feMergeNode in="blur" />
						<feMergeNode in="SourceGraphic" />
					</feMerge>
				</filter>

				<!-- Arrow Marker for Timeline Axis -->
				<marker id="c18ArrowTimeline" viewBox="0 0 12 12" refX="8" refY="6" markerWidth="8" markerHeight="8" orient="auto">
					<path d="M 1 2 L 10 6 L 10 6 L 1 10 z" fill="#a855f7" />
				</marker>
			</defs>

			<!-- Background Severity Bands -->
			<rect x="870" y="60" width="555" height="180" fill="rgba(239, 68, 68, 0.035)" />
			<rect x="870" y="240" width="555" height="108" fill="rgba(245, 158, 11, 0.028)" />
			<rect x="870" y="348" width="555" height="72" fill="rgba(16, 185, 129, 0.035)" />

			<!-- Horizontal Grid Lines & Right-Side Y-Axis Numbers (10/10, 5/10, 2/10, 0/10) -->
			<g class="c18-grid-lines">
				<!-- Small Pain Level Axis Descriptor on Right -->
				<text x="1458" y="40" class="c18-axis-descriptor">Pain Level</text>

				<line x1="880" y1="60" x2="1425" y2="60" class="c18-grid-line line-red-dashed" />
				<text x="1458" y="65" class="c18-axis-val val-10">10/10</text>

				<line x1="880" y1="240" x2="1425" y2="240" class="c18-grid-line line-amber-dashed" />
				<text x="1458" y="245" class="c18-axis-val val-5">5/10</text>

				<line x1="880" y1="348" x2="1425" y2="348" class="c18-grid-line line-green-dashed" />
				<text x="1458" y="353" class="c18-axis-val val-2">2/10</text>

				<line x1="880" y1="420" x2="1425" y2="420" class="c18-grid-line axis-x-base" />
				<text x="1458" y="425" class="c18-axis-val val-0">0/10</text>
			</g>

			<!-- Vertical Milestone Dividers -->
			<g class="c18-dividers">
				<line x1="978" y1="60" x2="978" y2="468" class="c18-divider-line line-milestone-18m" />
				<line x1="1188" y1="60" x2="1188" y2="468" class="c18-divider-line" />
				<line x1="1400" y1="60" x2="1400" y2="468" class="c18-divider-line line-today-divider" />
			</g>

			<!-- Shaded Area Under Curve -->
			<path 
				class="c18-curve-area"
				d="
					M 890 420
					L 890 60
					L 948 60
					C 956 60, 966 60, 972 60
					C 976 60, 976 348, 978 348
					C 981 348, 986 220, 991 220
					C 996 220, 1000 350, 1005 350
					C 1009 350, 1014 240, 1019 240
					C 1024 240, 1028 355, 1033 355
					C 1037 355, 1042 260, 1047 260
					C 1052 260, 1056 360, 1061 360
					C 1065 360, 1070 285, 1075 285
					C 1080 285, 1084 370, 1089 370
					C 1093 370, 1098 305, 1103 305
					C 1108 305, 1112 382, 1117 382
					C 1121 382, 1126 325, 1131 325
					C 1136 325, 1140 395, 1145 395
					C 1149 395, 1154 350, 1159 350
					C 1164 350, 1168 405, 1173 405
					C 1176 405, 1178 380, 1180 380
					C 1182 380, 1184 416, 1188 416
					L 1400 416
					L 1400 420
					Z
				"
				fill="url(#c18AreaGradient)"
			/>

			<!-- Glowing Curve Line Starting at top 10/10 plateau -->
			<path 
				class="c18-curve-line"
				d="
					M 890 60
					L 948 60
					C 956 60, 966 60, 972 60
					C 976 60, 976 348, 978 348
					C 981 348, 986 220, 991 220
					C 996 220, 1000 350, 1005 350
					C 1009 350, 1014 240, 1019 240
					C 1024 240, 1028 355, 1033 355
					C 1037 355, 1042 260, 1047 260
					C 1052 260, 1056 360, 1061 360
					C 1065 360, 1070 285, 1075 285
					C 1080 285, 1084 370, 1089 370
					C 1093 370, 1098 305, 1103 305
					C 1108 305, 1112 382, 1117 382
					C 1121 382, 1126 325, 1131 325
					C 1136 325, 1140 395, 1145 395
					C 1149 395, 1154 350, 1159 350
					C 1164 350, 1168 405, 1173 405
					C 1176 405, 1178 380, 1180 380
					C 1182 380, 1184 416, 1188 416
					L 1400 416
				"
				fill="none"
				stroke="url(#c18CurveGradient)"
				stroke-width="4.8"
				filter="url(#c18Glow)"
			/>

			<!-- Continuing Green Arrow on Flatline -->
			<g class="c18-future-arrow">
				<path d="M 1390 408 L 1405 416 L 1390 424" fill="none" stroke="#10b981" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round" filter="url(#c18Glow)" />
			</g>

			<!-- Annotations -->
			<g class="c18-annotations">
				<!-- Phase 1: White Square Pill + 2-Week Trial -->
				<rect x="932" y="-37" width="66" height="20" rx="4" fill="#ffffff" stroke="none" />
				<text x="965" y="-23" class="c18-phase-badge">PHASE 1</text>
				<text x="965" y="4" class="c18-peak-title">2-Week Trial</text>
				<g class="c18-arrow-group">
					<path d="M 965 14 L 965 52" fill="none" stroke="#ef4444" stroke-width="2.4" stroke-linecap="round" />
					<path d="M 960 44 L 965 52 L 970 44" fill="none" stroke="#ef4444" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
				</g>

				<!-- Phase 2: White Square Pill + 1-Year Yo-Yo -->
				<rect x="1050" y="108" width="66" height="20" rx="4" fill="#ffffff" stroke="none" />
				<text x="1083" y="122" class="c18-phase-badge">PHASE 2</text>
				<text x="1083" y="152" class="c18-yoyo-title">1-Year Yo-Yo</text>
				<text x="1083" y="172" class="c18-yoyo-subtitle">Alternating between carnivore</text>
				<text x="1083" y="188" class="c18-yoyo-subtitle">&amp; plant-based diet</text>
				<g class="c18-arrow-group">
					<path d="M 1083 196 C 1081 206, 1085 216, 1083 226" fill="none" stroke="#f59e0b" stroke-width="2.2" stroke-linecap="round" />
					<path d="M 1078 218 C 1080 222, 1082 225, 1083 228 C 1084 225, 1086 222, 1088 218" fill="none" stroke="#f59e0b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
				</g>

				<!-- Phase 3: White Square Pill + Strict Carnivore -->
				<rect x="1261" y="198" width="66" height="20" rx="4" fill="#ffffff" stroke="none" />
				<text x="1294" y="212" class="c18-phase-badge">PHASE 3</text>
				<text x="1294" y="242" class="c18-exp7-title">Strict Carnivore</text>
				<text x="1294" y="264" class="c18-phase3-desc">6 Months Pain-Free 0/10</text>
				<g class="c18-arrow-group">
					<path d="M 1294 274 C 1292 316, 1296 358, 1294 398" fill="none" stroke="#10b981" stroke-width="2.2" stroke-linecap="round" />
					<path d="M 1289 390 C 1291 394, 1293 397, 1294 400 C 1295 397, 1297 394, 1299 390" fill="none" stroke="#10b981" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
				</g>
			</g>

			<!-- Bottom Timeline Axis -->
			<g class="c18-timeline-axis">
				<!-- Purple Axis Line -->
				<line x1="880" y1="468" x2="1415" y2="468" class="c18-axis-line" marker-end="url(#c18ArrowTimeline)" />

				<!-- Milestone Ticks & Labels -->
				<line x1="978" y1="462" x2="978" y2="474" class="c18-axis-tick" />
				<text x="978" y="452" class="c18-axis-label">18 Months Ago</text>

				<line x1="1188" y1="462" x2="1188" y2="474" class="c18-axis-tick" />
				<text x="1188" y="452" class="c18-axis-label">6 Months Ago</text>

				<line x1="1400" y1="462" x2="1400" y2="474" class="c18-axis-tick tick-today" />
				<text x="1400" y="452" class="c18-axis-label label-today">Today</text>

				<!-- Small Timeline Horizontal Axis Descriptor -->
				<text x="1165" y="496" class="c18-axis-descriptor">Timeline</text>
			</g>
		</svg>
	</div>
</div>

<style>
	.carnivore-timeline-widget {
		background: radial-gradient(120% 120% at 50% 0%, #1e1136 0%, #0d081a 60%, #080410 100%);
		border: 1px solid rgba(168, 85, 247, 0.35);
		border-radius: 1.25rem;
		padding: 1.25rem 1.25rem 1.25rem 1.25rem;
		margin: 2.25rem auto;
		color: #e2e8f0;
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		position: relative;
		overflow: hidden;
	}

	.carnivore-widget-header {
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 1.25rem;
		text-align: center;
		padding: 0.25rem 0.5rem 0 0.5rem;
	}

	.carnivore-widget-title {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		text-align: center;
	}

	.carnivore-title-main {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: clamp(2.2rem, 5.2vw, 3.25rem);
		font-weight: 900;
		color: #ffffff;
		letter-spacing: -0.025em;
		line-height: 1.15;
		text-shadow: 0 2px 14px rgba(0, 0, 0, 0.7);
		text-wrap: balance;
		margin-bottom: 0.35rem;
	}

	.carnivore-title-sub {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: clamp(1rem, 2.2vw, 1.35rem);
		font-weight: 600;
		color: #d8b4fe;
		letter-spacing: -0.01em;
		line-height: 1.3;
		text-wrap: balance;
	}

	.carnivore-timeline-wrapper {
		width: 100%;
		position: relative;
	}

	.carnivore-timeline-svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		user-select: none;
	}

	/* Small Axis Descriptors */
	.c18-axis-descriptor {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 10.5px;
		font-weight: 700;
		fill: #94a3b8;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		text-anchor: middle;
	}

	/* Right-Side Y-Axis Numbers */
	.c18-axis-val {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 12.5px;
		font-weight: 800;
		text-anchor: middle;
	}

	.val-10 { fill: #f87171; }
	.val-5 { fill: #fbbf24; }
	.val-2 { fill: #34d399; }
	.val-0 { fill: #10b981; }

	/* Grid & Reference Lines */
	.c18-grid-line {
		stroke: rgba(255, 255, 255, 0.08);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}

	.line-red-dashed {
		stroke: rgba(239, 68, 68, 0.22);
	}

	.line-amber-dashed {
		stroke: rgba(245, 158, 11, 0.25);
		stroke-dasharray: 6 3;
	}

	.line-green-dashed {
		stroke: rgba(16, 185, 129, 0.25);
		stroke-dasharray: 6 3;
	}

	.axis-x-base {
		stroke: rgba(255, 255, 255, 0.22);
		stroke-width: 1.5;
		stroke-dasharray: none;
	}

	.c18-divider-line {
		stroke: rgba(255, 255, 255, 0.12);
		stroke-dasharray: 3 3;
	}

	.line-milestone-18m {
		stroke: rgba(168, 85, 247, 0.45);
	}

	.line-today-divider {
		stroke: rgba(192, 132, 252, 0.6);
	}

	/* Curve */
	.c18-curve-line {
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Annotations */
	.c18-phase-badge {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 11.5px;
		font-weight: 900;
		fill: #09090b;
		text-anchor: middle;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.c18-peak-num {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 14.5px;
		font-weight: 800;
		fill: #f87171;
		text-anchor: middle;
		letter-spacing: 0.01em;
	}

	.c18-peak-title {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 20.5px;
		font-weight: 800;
		fill: #f87171;
		text-anchor: middle;
		letter-spacing: -0.01em;
	}

	.c18-yoyo-title {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 21.7px;
		font-weight: 800;
		fill: #f59e0b;
		text-anchor: middle;
		letter-spacing: -0.01em;
	}

	.c18-yoyo-subtitle {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 12.5px;
		font-weight: 600;
		fill: #f1f5f9;
		text-anchor: middle;
	}

	.c18-exp7-title {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 22.4px;
		font-weight: 800;
		fill: #10b981;
		text-anchor: middle;
		letter-spacing: -0.01em;
	}

	.c18-phase3-desc {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 12.5px;
		font-weight: 600;
		fill: #f1f5f9;
		text-anchor: middle;
	}

	.c18-exp7-subtitle {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 12.5px;
		font-weight: 600;
		fill: #f1f5f9;
		text-anchor: middle;
	}

	/* Timeline Axis */
	.c18-axis-line {
		stroke: #a855f7;
		stroke-width: 2.5;
	}

	.c18-axis-tick {
		stroke: #a855f7;
		stroke-width: 2;
	}

	.c18-axis-label {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 13px;
		font-weight: 700;
		fill: #cbd5e1;
		text-anchor: middle;
	}

	.label-today {
		fill: #e879f9;
		font-weight: 800;
	}

	.tick-today {
		stroke: #e879f9;
		stroke-width: 2.5;
	}
</style>
