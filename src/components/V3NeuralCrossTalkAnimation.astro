---
// V3NeuralCrossTalkAnimation.astro
// Anatomical Head Profile Simulation: Trigeminal Nerve (V1, V2, V3)
// Demonstrates Upstream Tooth Leak -> Trigeminal Ganglion Cross-Talk -> Retrograde Wave to Tongue & Lower Arch
---

<div class="v3-animation-container tts-ignore">
  <div class="v3-anim-header">
    <div class="v3-kicker">Interactive Anatomical Simulation</div>
    <h3 class="v3-title">Trigeminal Nerve Cross-Talk &amp; Retrograde&nbsp;Conduction</h3>
    <p class="v3-subtitle">Watch an action potential ignite at a lower molar, travel up the mandibular nerve (V3) to the Trigeminal Ganglion, spark adjacent fibers, and blast backward across the entire lower jaw and&nbsp;tongue.</p>
  </div>

  <div class="v3-svg-wrapper">
    <svg viewBox="0 0 840 560" class="v3-svg" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Gradients -->
        <linearGradient id="brainGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#fda4af" stop-opacity="0.25" />
          <stop offset="50%" stop-color="#f43f5e" stop-opacity="0.15" />
          <stop offset="100%" stop-color="#881337" stop-opacity="0.05" />
        </linearGradient>
        <radialGradient id="ganglionAura" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.9" />
          <stop offset="40%" stop-color="#a855f7" stop-opacity="0.5" />
          <stop offset="100%" stop-color="#1e1b4b" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="tongueBurnRadial" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ff0055" stop-opacity="0.85" />
          <stop offset="60%" stop-color="#ff5500" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#3b0764" stop-opacity="0" />
        </radialGradient>
        <filter id="glowEffect" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <filter id="intenseGlow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="7" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <!-- Background Canvas -->
      <rect x="0" y="0" width="840" height="560" fill="#080312" rx="16" />

      <!-- ANATOMICAL HEAD & PROFILE SILHOUETTE (Facing Left) -->
      <!-- Head Contour (Scalp, Forehead, Nose, Lips, Chin, Neck) -->
      <path d="M 520 540 C 530 460, 540 380, 520 280 C 500 160, 440 60, 320 30 C 220 5, 140 50, 100 130 C 85 160, 80 185, 80 205 C 70 215, 45 250, 35 265 C 30 273, 38 278, 55 278 C 70 278, 80 285, 78 295 C 70 310, 55 315, 55 325 C 55 335, 70 340, 78 350 C 82 360, 68 375, 68 390 C 68 410, 95 425, 130 435 C 170 445, 230 445, 270 425 C 290 445, 305 485, 315 540 Z" fill="#0f0921" stroke="#2a1847" stroke-width="1.8" />

      <!-- Brain Contour (Cerebrum & Cerebellum inside skull) -->
      <g opacity="0.65">
        <!-- Cerebrum Folds & Outline -->
        <path d="M 125 150 C 135 110, 180 65, 250 55 C 330 45, 420 70, 460 130 C 490 175, 490 230, 450 270 C 420 295, 380 295, 350 275 C 330 260, 300 260, 280 270 C 220 275, 160 250, 135 210 C 120 185, 120 165, 125 150 Z" fill="url(#brainGrad)" stroke="#f43f5e" stroke-width="1.2" stroke-dasharray="6 3" />
        <!-- Gyri / Sulci Detail Lines -->
        <path d="M 160 125 C 190 115, 230 135, 260 120 C 300 100, 350 110, 390 90" fill="none" stroke="#f43f5e" stroke-width="1" opacity="0.4" />
        <path d="M 180 165 C 220 155, 260 175, 310 155 C 360 135, 410 150, 450 135" fill="none" stroke="#f43f5e" stroke-width="1" opacity="0.4" />
        <path d="M 210 205 C 250 195, 300 215, 350 195 C 390 180, 430 200, 460 185" fill="none" stroke="#f43f5e" stroke-width="1" opacity="0.4" />
        <!-- Cerebellum -->
        <path d="M 370 290 C 420 290, 460 320, 450 360 C 430 390, 390 395, 360 365 C 345 350, 350 310, 370 290 Z" fill="#2d1238" stroke="#e11d48" stroke-width="1" opacity="0.5" />
        <!-- Brainstem (Pons & Medulla) -->
        <path d="M 330 270 C 350 280, 360 320, 355 370 C 350 420, 345 470, 340 520" fill="none" stroke="#fb7185" stroke-width="14" stroke-linecap="round" opacity="0.3" />
      </g>

      <!-- ORAL CAVITY & ANATOMY -->
      <!-- Mandible (Lower Jawbone) Contour -->
      <path d="M 340 330 C 350 380, 320 420, 270 440 C 210 460, 140 455, 95 425 C 80 410, 75 390, 85 375 C 95 360, 125 365, 160 375 C 210 390, 270 380, 300 350 C 320 330, 330 310, 340 330 Z" fill="#120c24" stroke="#4c1d95" stroke-width="1.4" opacity="0.8" />

      <!-- Tongue (Lingual Mucosa Zone) -->
      <path d="M 95 335 C 130 305, 190 305, 230 335 C 250 350, 240 380, 200 390 C 150 405, 105 380, 85 360 C 80 350, 85 340, 95 335 Z" fill="#200d30" stroke="#7e22ce" stroke-width="1.2" stroke-dasharray="3 2" />
      <text x="165" y="348" fill="#c084fc" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="700" letter-spacing="0.05em" text-anchor="middle">TONGUE (Lingual)</text>
      <!-- Tongue Burn Flush (Animated Red/Orange Heat Wave) -->
      <path class="anim-tongue-flush" d="M 95 335 C 130 305, 190 305, 230 335 C 250 350, 240 380, 200 390 C 150 405, 105 380, 85 360 C 80 350, 85 340, 95 335 Z" fill="url(#tongueBurnRadial)" opacity="0" />

      <!-- LOWER TEETH ARCH ON MANDIBLE -->
      <g opacity="0.9">
        <rect x="85" y="358" width="10" height="15" rx="2" fill="#334155" stroke="#64748b" stroke-width="1" />
        <rect x="98" y="362" width="11" height="16" rx="2" fill="#334155" stroke="#64748b" stroke-width="1" />
        <rect x="112" y="367" width="13" height="17" rx="2" fill="#334155" stroke="#64748b" stroke-width="1" />
        <rect x="130" y="373" width="15" height="18" rx="3" fill="#334155" stroke="#64748b" stroke-width="1" />
        <rect x="150" y="379" width="16" height="19" rx="3" fill="#334155" stroke="#64748b" stroke-width="1" />
        <rect x="172" y="386" width="18" height="20" rx="3" fill="#334155" stroke="#64748b" stroke-width="1" />
        <!-- TRIGGER TOOTH: Lower Molar #19 with Exposed Margin -->
        <rect class="anim-trigger-tooth" x="195" y="392" width="22" height="22" rx="4" fill="#311042" stroke="#f59e0b" stroke-width="2" />
        <!-- Molars #18 / #17 -->
        <rect x="222" y="396" width="20" height="20" rx="3" fill="#334155" stroke="#64748b" stroke-width="1" />
        <rect x="247" y="396" width="19" height="19" rx="3" fill="#334155" stroke="#64748b" stroke-width="1" />
      </g>
      <!-- Trigger Tooth Callout -->
      <circle cx="206" cy="403" r="3.5" fill="#f59e0b" filter="url(#glowEffect)" />
      <text x="206" y="440" fill="#fbbf24" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="800" text-anchor="middle">TRIGGER TOOTH (Molar #19)</text>
      <text x="206" y="452" fill="#fde68a" font-family="'Plus Jakarta Sans', sans-serif" font-size="8.5" text-anchor="middle">Cervical Leak / Open Tubule</text>

      <!-- THE TRIGEMINAL NERVE TREE (Golden Yellow Anatomy) -->

      <!-- TRIGEMINAL GANGLION (Pulsing Master Node near Temple / Ear base) -->
      <circle cx="320" cy="245" r="32" fill="url(#ganglionAura)" opacity="0.45" />
      <g id="ganglionBody">
        <circle cx="320" cy="245" r="19" fill="#2e1065" stroke="#eab308" stroke-width="2.5" />
        <circle cx="310" cy="238" r="3.5" fill="#facc15" opacity="0.9" />
        <circle cx="328" cy="240" r="3.5" fill="#facc15" opacity="0.9" />
        <circle cx="318" cy="254" r="4" fill="#facc15" opacity="0.9" />
        <!-- Satellite Glial Node Ring -->
        <circle cx="320" cy="245" r="24" fill="none" stroke="#a855f7" stroke-width="1.2" stroke-dasharray="3 3" />
      </g>
      <!-- Ganglion Label Badge -->
      <rect x="350" y="215" width="170" height="34" rx="6" fill="#1e1136" stroke="#eab308" stroke-width="1.2" />
      <text x="435" y="230" fill="#fef08a" font-family="'Plus Jakarta Sans', sans-serif" font-size="10.5" font-weight="800" text-anchor="middle">TRIGEMINAL GANGLION</text>
      <text x="435" y="242" fill="#d8b4fe" font-family="'Plus Jakarta Sans', sans-serif" font-size="8.5" text-anchor="middle">SGC Glial Gap Junctions</text>

      <!-- BRANCH V1: OPHTHALMIC NERVE (Forehead & Upper Orbit) -->
      <g opacity="0.55">
        <path d="M 310 235 C 280 195, 230 170, 160 145 C 130 135, 95 125, 80 100" fill="none" stroke="#eab308" stroke-width="2.2" stroke-linecap="round" />
        <path d="M 230 170 C 200 150, 150 140, 110 135" fill="none" stroke="#eab308" stroke-width="1.4" />
        <path d="M 160 145 C 140 120, 115 105, 90 85" fill="none" stroke="#eab308" stroke-width="1.4" />
        <circle cx="230" cy="170" r="10" fill="#1e1136" stroke="#ca8a04" stroke-width="1" />
        <text x="230" y="174" fill="#fef08a" font-family="'Plus Jakarta Sans', sans-serif" font-size="9" font-weight="800" text-anchor="middle">V₁</text>
        <text x="140" y="115" fill="#fef08a" font-family="'Plus Jakarta Sans', sans-serif" font-size="9" font-weight="600">V₁ (Ophthalmic)</text>
      </g>

      <!-- BRANCH V2: MAXILLARY NERVE (Midface, Palate & Upper Teeth) -->
      <g opacity="0.65">
        <path d="M 310 248 C 275 245, 225 255, 175 270 C 135 280, 95 285, 65 285" fill="none" stroke="#eab308" stroke-width="2.5" stroke-linecap="round" />
        <path d="M 225 255 C 190 270, 150 280, 120 285" fill="none" stroke="#eab308" stroke-width="1.5" />
        <circle cx="225" cy="255" r="10" fill="#1e1136" stroke="#ca8a04" stroke-width="1" />
        <text x="225" y="259" fill="#fef08a" font-family="'Plus Jakarta Sans', sans-serif" font-size="9" font-weight="800" text-anchor="middle">V₂</text>
        <text x="145" y="260" fill="#fef08a" font-family="'Plus Jakarta Sans', sans-serif" font-size="9" font-weight="600">V₂ (Maxillary)</text>
      </g>

      <!-- BRANCH V3: MANDIBULAR NERVE (The Primary Circuit - Featured) -->
      <g>
        <!-- V3 Main Descending Trunk from Ganglion -->
        <path d="M 320 264 C 325 285, 335 315, 325 340" fill="none" stroke="#eab308" stroke-width="4.5" stroke-linecap="round" />
        <circle cx="335" cy="315" r="11" fill="#1e1136" stroke="#eab308" stroke-width="1.8" />
        <text x="335" y="319" fill="#fef08a" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="800" text-anchor="middle">V₃</text>
        <text x="355" y="320" fill="#fef08a" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="800">V₃ (Mandibular)</text>

        <!-- SUB-BRANCH 1: Inferior Alveolar Nerve (IAN) through Mandibular Canal to Teeth -->
        <!-- Path: (325, 340) -> (310, 380) -> (250, 400) -> (206, 403 Molar #19) -> (140, 395) -> (85, 370 Mental Foramen) -->
        <path id="v3IanFullTrack" d="M 206 403 C 250 400, 310 380, 325 340 C 335 315, 325 285, 320 264" fill="none" stroke="#ca8a04" stroke-width="3" stroke-linecap="round" />
        <!-- Mental & Incisive Extension to Chin/Front Teeth -->
        <path d="M 206 403 C 160 395, 120 385, 85 370" fill="none" stroke="#ca8a04" stroke-width="2.5" stroke-dasharray="3 3" opacity="0.75" />

        <!-- SUB-BRANCH 2: Lingual Nerve curving into Tongue -->
        <!-- Path: From V3 Bifurcation (325, 340) branching forward into the Tongue (165, 360) -->
        <path id="v3LingualTrack" d="M 325 340 C 285 335, 230 340, 165 355" fill="none" stroke="#e11d48" stroke-width="3" stroke-dasharray="4 3" opacity="0.8" />
        <text x="235" y="330" fill="#f472b6" font-family="'Plus Jakarta Sans', sans-serif" font-size="9" font-weight="700">Lingual Nerve (to Tongue)</text>
      </g>

      <!-- SPARK BURST AT GANGLION (Cross-Talk Ignition Phase 2) -->
      <g class="anim-spark-burst" opacity="0">
        <circle cx="320" cy="245" r="42" fill="none" stroke="#f43f5e" stroke-width="3" filter="url(#intenseGlow)" />
        <circle cx="320" cy="245" r="22" fill="#ffffff" filter="url(#intenseGlow)" opacity="0.9" />
        <line x1="275" y1="245" x2="365" y2="245" stroke="#fbbf24" stroke-width="3" />
        <line x1="320" y1="200" x2="320" y2="290" stroke="#fbbf24" stroke-width="3" />
        <line x1="288" y1="213" x2="352" y2="277" stroke="#ec4899" stroke-width="2.5" />
        <line x1="288" y1="277" x2="352" y2="213" stroke="#ec4899" stroke-width="2.5" />
        <text x="320" y="190" fill="#f43f5e" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="900" text-anchor="middle" filter="url(#glowEffect)">CROSS-TALK DETONATION!</text>
      </g>

      <!-- ANIMATED ACTION POTENTIALS (Smooth SVG Motion) -->
      <!-- 1. Upstream Signal: From Molar #19 UP along V3 to Trigeminal Ganglion -->
      <circle class="anim-pulse-upstream" r="6.5" fill="#facc15" filter="url(#glowEffect)">
        <animateMotion dur="6s" repeatCount="indefinite" path="M 206 403 C 250 400, 310 380, 325 340 C 335 315, 325 285, 320 264" keyTimes="0; 0.30; 0.32; 1" keyPoints="0; 1; 1; 1" />
      </circle>

      <!-- 2. Retrograde Pulse A: From Ganglion BACK OUT down Lingual Nerve into the Tongue -->
      <circle class="anim-pulse-lingual" r="6.5" fill="#f43f5e" filter="url(#glowEffect)">
        <animateMotion dur="6s" repeatCount="indefinite" path="M 320 264 C 325 285, 335 315, 325 340 C 285 335, 230 340, 165 355" keyTimes="0; 0.38; 0.72; 1" keyPoints="0; 0; 1; 1" />
      </circle>

      <!-- 3. Retrograde Pulse B: From Ganglion BACK OUT down IAN across the whole lower arch -->
      <circle class="anim-pulse-arch" r="6" fill="#fb923c" filter="url(#glowEffect)">
        <animateMotion dur="6s" repeatCount="indefinite" path="M 320 264 C 325 285, 335 315, 325 340 C 310 380, 250 400, 206 403 C 160 395, 120 385, 85 370" keyTimes="0; 0.38; 0.80; 1" keyPoints="0; 0; 1; 1" />
      </circle>

      <!-- Neuropeptide Spray Particles (Spraying on Tongue at 3.6s - 5.8s) -->
      <g class="anim-neuropeptides" opacity="0">
        <circle cx="120" cy="335" r="3" fill="#ff0055" filter="url(#glowEffect)" />
        <circle cx="140" cy="355" r="3.5" fill="#ff0055" filter="url(#glowEffect)" />
        <circle cx="165" cy="340" r="3" fill="#ff5500" filter="url(#glowEffect)" />
        <circle cx="185" cy="365" r="4" fill="#ff0055" filter="url(#glowEffect)" />
        <circle cx="210" cy="350" r="3.5" fill="#ffaa00" filter="url(#glowEffect)" />
        <text x="165" y="380" fill="#fecdd3" font-family="'Plus Jakarta Sans', sans-serif" font-size="9" font-weight="800" text-anchor="middle" filter="url(#glowEffect)">NEUROPEPTIDE FLOOD (CGRP &amp; Substance P)</text>
      </g>

      <!-- Anterior Arch Radiation Rings (Chin & Incisors) -->
      <g class="anim-arch-flush" opacity="0">
        <circle cx="95" cy="365" r="16" fill="none" stroke="#f97316" stroke-width="2" stroke-dasharray="3 3" />
        <circle cx="130" cy="380" r="20" fill="none" stroke="#f97316" stroke-width="2" stroke-dasharray="3 3" />
        <text x="105" y="420" fill="#fdba74" font-family="'Plus Jakarta Sans', sans-serif" font-size="9" font-weight="700">Arch-Wide Pain</text>
      </g>
    </svg>
  </div>

  <!-- Synchronized 4-Stage Status Pipeline -->
  <div class="v3-status-pipeline">
    <div class="v3-stage stage-1">
      <div class="stage-dot dot-1"></div>
      <div class="stage-info">
        <div class="stage-num">STAGE 1</div>
        <div class="stage-title">Upstream Tooth Leak</div>
        <div class="stage-desc">Proton influx at Molar #19 fires action potential upward along&nbsp;V3.</div>
      </div>
    </div>

    <div class="v3-stage stage-2">
      <div class="stage-dot dot-2"></div>
      <div class="stage-info">
        <div class="stage-num">STAGE 2</div>
        <div class="stage-title">Ganglion Cross-Talk</div>
        <div class="stage-desc">Glial gap junctions spark the adjacent lingual and arch&nbsp;fibers.</div>
      </div>
    </div>

    <div class="v3-stage stage-3">
      <div class="stage-dot dot-3"></div>
      <div class="stage-info">
        <div class="stage-num">STAGE 3</div>
        <div class="stage-title">Retrograde Back-Fire</div>
        <div class="stage-desc">Antidromic pulses race down into the tongue and anterior&nbsp;arch.</div>
      </div>
    </div>

    <div class="v3-stage stage-4">
      <div class="stage-dot dot-4"></div>
      <div class="stage-info">
        <div class="stage-num">STAGE 4</div>
        <div class="stage-title">Neuropeptide Flood</div>
        <div class="stage-desc">CGRP and Substance P spray into healthy tissue, burning&nbsp;tongue!</div>
      </div>
    </div>
  </div>
</div>
