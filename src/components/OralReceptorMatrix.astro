---

<div class={`receptor-matrix-wrapper ${className}`}>
	<div class="receptor-matrix-card">
		<!-- Header -->
		<div class="receptor-header">
			<h3 class="receptor-title">Master Oral Receptor Matrix (Unified Big Picture)</h3>
			<p class="receptor-desc">
				Complete functional directory of the 35–45 specialized receptor types and ion channels governing oral sensation, dentin fluid movement, acid perception, and Burning Mouth Syndrome&nbsp;pain.
			</p>
		</div>

		<!-- Desktop & Wide Tablet View: Full Width Clean Grid Table (Zero Horizontal Scroll) -->
		<div class="matrix-desktop-view">
			<div class="matrix-grid-table">
				<div class="grid-header-row">
					<div class="gh-cell cell-category">Category</div>
					<div class="gh-cell cell-receptor">Receptor / Channel</div>
					<div class="gh-cell cell-stimulus">Primary Stimulus</div>
					<div class="gh-cell cell-pain">Triggers Pain?</div>
					<div class="gh-cell cell-location">Location in Mouth</div>
					<div class="gh-cell cell-role">Role in Acid, Dentin, Chili, or BMS</div>
				</div>

				<div class="grid-body">
					{receptorsData.map((item) => (
						<div class={`grid-row ${item.triggersPain ? "is-pain-row" : "is-calm-row"}`}>
							<div class="gb-cell cell-category">
								<span class="cat-pill">{item.category}</span>
							</div>
							<div class="gb-cell cell-receptor">
								<span class="receptor-code">{item.receptor}</span>
							</div>
							<div class="gb-cell cell-stimulus">
								<span class="stimulus-text">{item.stimulus}</span>
							</div>
							<div class="gb-cell cell-pain">
								{item.triggersPain ? (
									<span class="status-badge pain-yes">{item.painLabel}</span>
								) : (
									<span class="status-badge pain-no">{item.painLabel}</span>
								)}
							</div>
							<div class="gb-cell cell-location">
								<span class="location-text">{item.location}</span>
							</div>
							<div class="gb-cell cell-role">
								<span class="role-text">{item.role}</span>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>

		<!-- Mobile & Compact Tablet View: Beautiful Stacked Responsive Cards (Zero Horizontal Scroll) -->
		<div class="matrix-mobile-view">
			<div class="mobile-cards-list">
				{receptorsData.map((item) => (
					<div class={`mobile-receptor-card ${item.triggersPain ? "card-pain" : "card-calm"}`}>
						<div class="m-card-header">
							<div class="m-header-left">
								<span class="m-cat-tag">{item.category}</span>
								<h4 class="m-receptor-title">{item.receptor}</h4>
							</div>
							<div class="m-header-right">
								{item.triggersPain ? (
									<span class="status-badge pain-yes">{item.painLabel}</span>
								) : (
									<span class="status-badge pain-no">{item.painLabel}</span>
								)}
							</div>
						</div>

						<div class="m-card-details">
							<div class="m-detail-row">
								<span class="m-label">Stimulus:</span>
								<span class="m-value stimulus-text">{item.stimulus}</span>
							</div>
							<div class="m-detail-row">
								<span class="m-label">Location:</span>
								<span class="m-value location-text">{item.location}</span>
							</div>
							<div class="m-detail-row m-role-row">
								<span class="m-label">Role in BMS / Pain:</span>
								<p class="m-role-text">{item.role}</p>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>

		<!-- Bottom Key Insight Callout -->
		<div class="matrix-insight-box">
			<div class="insight-icon">🔬</div>
			<div class="insight-text">
				<strong>Key BMS Discovery:</strong> Burning Mouth Syndrome does not require millions of mystery receptors. It is driven by the pathological sensitization and uncontrolled firing of a small, distinct cluster of pain channels—predominantly <strong>TRPV1, TRPA1, ASIC3, and P2X7</strong>—stimulated by chemical protons (acid), hydrodynamic dentinal shear, and neurogenic inflammatory peptides.
			</div>
		</div>
	</div>
</div>

<style>
	/* Breakout container to span full width of the article without causing horizontal scroll */
	.receptor-matrix-wrapper {
		margin: 3.5rem 0;
		width: 100%;
		box-sizing: border-box;
	}

	.receptor-matrix-card {
		background: #090614;
		background: radial-gradient(120% 120% at 50% 0%, #150d27 0%, #0a0615 65%, #05030a 100%);
		border: 1px solid rgba(168, 85, 247, 0.3);
		border-radius: 1.5rem;
		padding: clamp(1.25rem, 3vw, 2.5rem);
		box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
		color: #f1f5f9;
		box-sizing: border-box;
		width: 100%;
	}

	.receptor-header {
		text-align: center;
		margin-bottom: 2rem;
		max-width: 820px;
		margin-left: auto;
		margin-right: auto;
	}

	.receptor-title {
		font-family: var(--font-heading, system-ui, -apple-system, sans-serif);
		font-size: clamp(1.35rem, 2.6vw, 2.1rem);
		font-weight: 900;
		color: #ffffff;
		margin: 0 0 0.75rem 0;
		line-height: 1.22;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.receptor-desc {
		font-size: clamp(0.92rem, 1.5vw, 1.02rem);
		line-height: 1.6;
		color: #d8b4fe;
		margin: 0 auto;
		text-wrap: pretty;
	}

	/* ==========================================================
	   DESKTOP & TABLET GRID TABLE (No Horizontal Scroll)
	   ========================================================== */
	.matrix-desktop-view {
		display: block;
		width: 100%;
	}

	.matrix-grid-table {
		display: flex;
		flex-direction: column;
		width: 100%;
		border-radius: 1rem;
		border: 1px solid rgba(168, 85, 247, 0.22);
		overflow: hidden;
		background: rgba(13, 8, 26, 0.7);
	}

	.grid-header-row {
		display: grid;
		grid-template-columns: 140px 150px 1.1fr 140px 1.1fr 1.6fr;
		background: linear-gradient(180deg, rgba(168, 85, 247, 0.22) 0%, rgba(147, 51, 234, 0.12) 100%);
		border-bottom: 2px solid rgba(168, 85, 247, 0.35);
		font-size: 0.78rem;
		font-weight: 800;
		color: #f3e8ff;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.gh-cell {
		padding: 0.95rem 1rem;
		display: flex;
		align-items: center;
		box-sizing: border-box;
	}

	.grid-body {
		display: flex;
		flex-direction: column;
	}

	.grid-row {
		display: grid;
		grid-template-columns: 140px 150px 1.1fr 140px 1.1fr 1.6fr;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		transition: background-color 0.15s ease;
		font-size: 0.86rem;
		line-height: 1.45;
	}

	.grid-row:last-child {
		border-bottom: none;
	}

	.grid-row:hover {
		background: rgba(168, 85, 247, 0.09);
	}

	.grid-row.is-pain-row {
		background: rgba(239, 68, 68, 0.025);
	}

	.grid-row.is-pain-row:hover {
		background: rgba(239, 68, 68, 0.08);
	}

	.gb-cell {
		padding: 0.85rem 1rem;
		display: flex;
		align-items: flex-start;
		box-sizing: border-box;
	}

	.cat-pill {
		font-size: 0.76rem;
		font-weight: 700;
		color: #c084fc;
		line-height: 1.35;
	}

	.receptor-code {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-weight: 800;
		color: #ffffff;
		font-size: 0.92rem;
		letter-spacing: -0.01em;
		line-height: 1.3;
	}

	.stimulus-text {
		color: #cbd5e1;
		font-weight: 500;
	}

	.status-badge {
		display: inline-block;
		font-size: 0.72rem;
		font-weight: 800;
		padding: 0.22rem 0.55rem;
		border-radius: 0.35rem;
		line-height: 1.25;
		text-align: center;
	}

	.status-badge.pain-yes {
		color: #fca5a5;
		background: rgba(239, 68, 68, 0.18);
		border: 1px solid rgba(239, 68, 68, 0.4);
	}

	.status-badge.pain-no {
		color: #86efac;
		background: rgba(34, 197, 94, 0.12);
		border: 1px solid rgba(34, 197, 94, 0.3);
	}

	.location-text {
		color: #94a3b8;
		font-size: 0.82rem;
		line-height: 1.4;
	}

	.role-text {
		color: #e2e8f0;
		font-size: 0.84rem;
		line-height: 1.45;
	}

	/* ==========================================================
	   MOBILE VIEW (Cards Stack for Screens < 960px)
	   ========================================================== */
	.matrix-mobile-view {
		display: none;
		width: 100%;
	}

	.mobile-cards-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
	}

	.mobile-receptor-card {
		background: rgba(17, 10, 32, 0.75);
		border: 1px solid rgba(168, 85, 247, 0.25);
		border-radius: 1rem;
		padding: 1.15rem 1.25rem;
		display: flex;
		flex-direction: column;
