<script>
	// AudioReader Client Engine
	(() => {
		const root = document.getElementById('tts-reader-root');
		if (!root) return;

		const synth = window.speechSynthesis;
		if (!synth) {
			const statusMsg = document.getElementById('tts-status-msg');
			if (statusMsg) statusMsg.textContent = 'Audio reader is not supported in this browser.';
			const playBtn = document.getElementById('tts-main-play-btn');
			if (playBtn) (playBtn as HTMLButtonElement).disabled = true;
			return;
		}

		// State variables
		type SentenceData = {
			id: number;
			text: string;
			blockEl: HTMLElement;
			words: { el: HTMLElement; start: number; end: number; text: string }[];
		};

		let sentences: SentenceData[] = [];
		let currentSentenceIdx = 0;
		let currentWordIdx = -1;
		let playbackState: 'STOPPED' | 'PLAYING' | 'PAUSED' = 'STOPPED';
		let playbackRate = 1.0;
		let availableVoices: SpeechSynthesisVoice[] = [];
		let selectedVoice: SpeechSynthesisVoice | null = null;
		let activeUtterance: SpeechSynthesisUtterance | null = null;
		let watchdogTimer: number | null = null;
		let isAdvancing = false;
		let isUserStopped = false;

		// DOM Elements
		const mainPlayBtn = document.getElementById('tts-main-play-btn');
		const prevBtn = document.getElementById('tts-prev-btn');
		const nextBtn = document.getElementById('tts-next-btn');
		const stopBtn = document.getElementById('tts-stop-btn');
		const speedSelect = document.getElementById('tts-speed-select') as HTMLSelectElement | null;
		const voiceSelect = document.getElementById('tts-voice-select') as HTMLSelectElement | null;
		const progressFill = document.getElementById('tts-progress-fill');
		const statusMsg = document.getElementById('tts-status-msg');
		const timeEstEl = document.getElementById('tts-time-est');
		const iconBox = document.getElementById('tts-icon-box');

		const stickyBar = document.getElementById('tts-sticky-bar');
		const stickyPlayBtn = document.getElementById('tts-sticky-play');
		const stickyPrevBtn = document.getElementById('tts-sticky-prev');
		const stickyNextBtn = document.getElementById('tts-sticky-next');
		const stickyCloseBtn = document.getElementById('tts-sticky-close');
		const stickySentenceEl = document.getElementById('tts-sticky-sentence');
		const stickyProgressFill = document.getElementById('tts-sticky-progress-fill');
		const stickyCounter = document.getElementById('tts-sticky-counter');

		// Helper: Identify male voices across different OS & browser voice providers
		function isMaleVoice(v: SpeechSynthesisVoice): boolean {
			const text = (v.name + ' ' + ((v as any).voiceURI || '')).toLowerCase();
			const maleKeywords = [
				'male', 'david', 'guy', 'daniel', 'alex', 'george', 'mark', 
				'ryan', 'oliver', 'arthur', 'fred', 'tom', 'aaron', 'christopher', 
				'james', 'matthew', 'brian', 'richard', 'charles'
			];
			const femaleKeywords = ['female', 'zira', 'samantha', 'jenny', 'victoria', 'karen', 'fiona', 'susan', 'catherine', 'hazel', 'aria'];
			if (femaleKeywords.some((f) => text.includes(f))) return false;
			return maleKeywords.some((m) => text.includes(m));
		}

		// 1. Initialize Voices
		function loadVoices() {
			if (!synth) return;
			const allVoices = synth.getVoices();
			if (!allVoices || allVoices.length === 0) return;

			// Prioritize English voices
			const enVoices = allVoices.filter((v) => v.lang.startsWith('en'));
			availableVoices = enVoices.length > 0 ? enVoices : allVoices;

			if (voiceSelect) {
				voiceSelect.innerHTML = '';
				availableVoices.forEach((v, idx) => {
					const opt = document.createElement('option');
					opt.value = String(idx);
					const cleanName = v.name.replace(/Google|Microsoft|Apple|Natural|Desktop/g, '').trim();
					const isMale = isMaleVoice(v);
					opt.textContent = `${isMale ? '👨 ' : ''}${cleanName || v.name} (${v.lang})`;
					voiceSelect.appendChild(opt);
				});

				// Select a natural/neural English male voice as the default if possible
				let defaultIdx = availableVoices.findIndex((v) => isMaleVoice(v) && (v.name.includes('Natural') || v.name.includes('Online')));
				if (defaultIdx === -1) {
					defaultIdx = availableVoices.findIndex((v) => isMaleVoice(v));
				}
				if (defaultIdx === -1) {
					defaultIdx = availableVoices.findIndex((v) => v.lang.startsWith('en'));
				}

				if (defaultIdx >= 0) {
					voiceSelect.selectedIndex = defaultIdx;
					selectedVoice = availableVoices[defaultIdx];
				} else if (availableVoices[0]) {
					selectedVoice = availableVoices[0];
				}
			}
		}

		loadVoices();
		if (synth.onvoiceschanged !== undefined) {
			synth.onvoiceschanged = loadVoices;
		}

		// Comprehensive rule-based POS classifier for English (Montessori & Immersive Reader standard)
		const PRONOUNS = new Set([
			'i', 'me', 'my', 'myself', 'we', 'us', 'our', 'ours', 'ourselves',
			'you', 'your', 'yours', 'yourself', 'yourselves', 'he', 'him', 'his', 'himself',
			'she', 'her', 'hers', 'herself', 'it', 'its', 'itself', 'they', 'them', 'their',
			'theirs', 'themselves', 'what', 'which', 'who', 'whom', 'whose', 'this', 'that', 'these', 'those'
		]);

		const COMMON_VERBS = new Set([
			'is', 'are', 'was', 'were', 'be', 'been', 'being', 'have', 'has', 'had', 'having',
			'do', 'does', 'did', 'doing', 'say', 'says', 'said', 'go', 'goes', 'went', 'gone',
			'going', 'get', 'gets', 'got', 'getting', 'make', 'makes', 'made', 'making',
			'know', 'knows', 'knew', 'known', 'think', 'thinks', 'thought', 'take', 'takes', 'took',
			'taken', 'see', 'sees', 'saw', 'seen', 'come', 'comes', 'came', 'want', 'wants',
			'wanted', 'look', 'looks', 'looked', 'use', 'uses', 'used', 'using', 'find', 'finds',
			'found', 'give', 'gives', 'gave', 'given', 'tell', 'tells', 'told', 'work', 'works',
			'worked', 'call', 'calls', 'called', 'try', 'tries', 'tried', 'ask', 'asks', 'asked',
			'need', 'needs', 'needed', 'feel', 'feels', 'felt', 'become', 'becomes', 'became',
			'leave', 'leaves', 'left', 'put', 'puts', 'mean', 'means', 'meant', 'keep', 'keeps',
			'kept', 'let', 'lets', 'begin', 'begins', 'began', 'begun', 'seem', 'seems', 'seemed',
			'help', 'helps', 'helped', 'show', 'shows', 'showed', 'shown', 'hear', 'hears', 'heard',
			'run', 'runs', 'ran', 'play', 'plays', 'played', 'move', 'moves', 'moved', 'live',
			'lives', 'lived', 'living', 'believe', 'believes', 'believed', 'bring', 'brings', 'brought',
			'happen', 'happens', 'happened', 'write', 'writes', 'wrote', 'written', 'provide',
			'provides', 'provided', 'sit', 'sits', 'sat', 'stand', 'stands', 'stood', 'lose',
			'loses', 'lost', 'pay', 'pays', 'paid', 'meet', 'meets', 'met', 'include', 'includes',
			'included', 'continue', 'continues', 'continued', 'set', 'sets', 'setting', 'learn',
			'learns', 'learned', 'change', 'changes', 'changed', 'lead', 'leads', 'led', 'understand',
			'understands', 'understood', 'watch', 'watches', 'watched', 'follow', 'follows', 'followed',
			'stop', 'stops', 'stopped', 'create', 'creates', 'created', 'speak', 'speaks', 'spoke',
			'spoken', 'speaking', 'read', 'reads', 'reading', 'allow', 'allows', 'allowed', 'add',
			'spend', 'spends', 'spent', 'grow', 'grows', 'grew', 'grown', 'open', 'opens', 'opened',
			'walk', 'walks', 'walked', 'win', 'wins', 'won', 'offer', 'offers', 'offered',
			'remember', 'remembers', 'remembered', 'love', 'loves', 'loved', 'consider', 'considers',
			'considered', 'appear', 'appears', 'appeared', 'buy', 'buys', 'bought', 'wait', 'waits',
			'waited', 'serve', 'serves', 'served', 'die', 'dies', 'died', 'send', 'sends', 'sent',
			'expect', 'expects', 'expected', 'build', 'builds', 'built', 'stay', 'stays', 'stayed',
			'fall', 'falls', 'fell', 'fallen', 'cut', 'cuts', 'cutting', 'reach', 'reaches', 'reached',
			'remain', 'remains', 'remained', 'suggest', 'suggests', 'suggested', 'raise', 'raises',
			'raised', 'pass', 'passes', 'passed', 'sell', 'sells', 'sold', 'require', 'requires',
			'required', 'decide', 'decides', 'decided', 'pull', 'pulls', 'pulled', 'solved', 'ignited',
			'suffered', 'flossing', 'triggered', 'escalated', 'treated', 'investigated', 'healed',
			'lowered', 'starved', 'rot', 'rotting', 'excavated', 'placed', 'eliminated', 'calmed'
		]);

		const COMMON_ADVERBS = new Set([
			'not', 'also', 'very', 'often', 'however', 'too', 'usually', 'really', 'early', 'never',
			'always', 'sometimes', 'together', 'likely', 'simply', 'generally', 'instead', 'actually',
			'again', 'almost', 'especially', 'probably', 'already', 'below', 'directly', 'quickly',
			'easily', 'finally', 'suddenly', 'immediately', 'completely', 'deeply', 'noticeably'
		]);

		function classifyWord(clean: string): string {
			if (!clean || clean.length < 2) return '';
			if (PRONOUNS.has(clean)) return 'pos-pronoun';
			if (COMMON_ADVERBS.has(clean) || (clean.endsWith('ly') && clean.length > 3)) return 'pos-adv';
			if (COMMON_VERBS.has(clean) || (clean.endsWith('ed') && clean.length > 4) || (clean.endsWith('ing') && clean.length > 5)) return 'pos-verb';
			if (clean.endsWith('able') || clean.endsWith('ible') || clean.endsWith('al') || clean.endsWith('ful') || clean.endsWith('ic') || clean.endsWith('ive') || clean.endsWith('ous') || clean.endsWith('less')) return 'pos-adj';
			if (clean.length > 3) return 'pos-noun';
			return '';
		}

		// 2. Tokenize Article DOM (Non-destructive)
		function tokenizeContent() {
			const contentContainer = document.querySelector('.post-content');
			if (!contentContainer) return;

			// Gather eligible text blocks, skipping non-readable elements
			const rawBlocks = contentContainer.querySelectorAll('p, h2, h3, h4, li, blockquote');
			const blocks: HTMLElement[] = [];

			rawBlocks.forEach((b) => {
				const el = b as HTMLElement;
				// Skip if inside interactive or ignored components
				if (el.closest('.brushing-timer-container') || el.closest('pre') || el.closest('code') || el.closest('.tts-ignore')) {
					return;
				}
				blocks.push(el);
			});

			let sentenceCounter = 0;
			let totalWordCount = 0;

			blocks.forEach((block) => {
				const blockText = block.textContent || '';
				if (!blockText.trim()) return;

				// Split block text into sentence units using regex boundary
				const sentenceStrings = splitIntoSentences(blockText);
				if (sentenceStrings.length === 0) return;

				// Collect text nodes inside block
				const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT, null);
				const textNodes: Text[] = [];
				let n: Node | null;
				while ((n = walker.nextNode())) {
					textNodes.push(n as Text);
				}

				// Wrap each word in text nodes with <span class="tts-word">
				const wordSpansInBlock: HTMLElement[] = [];
				textNodes.forEach((tNode) => {
					const val = tNode.nodeValue || '';
					if (!val.trim()) return;

					// Split preserving whitespace: matches words and inter-word spaces
					const tokens = val.split(/(\s+)/);
					const frag = document.createDocumentFragment();

					tokens.forEach((token) => {
						if (!token) return;
						if (/^\s+$/.test(token)) {
							// Whitespace node
							frag.appendChild(document.createTextNode(token));
						} else {
							// Word token
							const span = document.createElement('span');
							span.className = 'tts-word';

							// Classify part of speech for dyslexic color coding
							const clean = token.replace(/[^a-zA-Z]/g, '').toLowerCase();
							const posClass = classifyWord(clean);
							if (posClass) span.classList.add(posClass);

							// Bionic anchor breakdown: bold first ~45% of word
							const bionicSplit = token.length <= 3 ? 1 : Math.ceil(token.length * 0.45);
							const anchorPart = token.slice(0, bionicSplit);
							const restPart = token.slice(bionicSplit);

							span.innerHTML = `<span class="bionic-anchor">${anchorPart}</span>${restPart}`;
							frag.appendChild(span);
							wordSpansInBlock.push(span);
							totalWordCount++;
						}
					});

					tNode.parentNode?.replaceChild(frag, tNode);
				});

				// Associate word spans with sentences
				let wordCursor = 0;
				sentenceStrings.forEach((sText) => {
					const sentenceWords: { el: HTMLElement; start: number; end: number; text: string }[] = [];
					const wordsInSentence = sText.trim().split(/\s+/).filter(Boolean);
					const count = wordsInSentence.length;

					let charOffsetInSentence = 0;
					for (let i = 0; i < count && wordCursor < wordSpansInBlock.length; i++) {
						const span = wordSpansInBlock[wordCursor];
						const wText = span.textContent || '';
						const start = charOffsetInSentence;
						const end = start + wText.length;

						span.dataset.sentenceIdx = String(sentenceCounter);
						span.dataset.wordIdx = String(i);

						sentenceWords.push({
							el: span,
							start,
							end,
							text: wText
						});

						charOffsetInSentence = end + 1; // +1 accounts for space
						wordCursor++;
					}

					if (sentenceWords.length > 0) {
						// Assign syntactic phrase chunks to words in this sentence
						let chunkIdx = 0;
						let wordsInChunk = 0;
						const CLAUSE_CONNECTORS = new Set([
							'and', 'but', 'or', 'so', 'because', 'although', 'though', 'since',
							'if', 'that', 'which', 'who', 'where', 'when', 'after', 'before',
							'as', 'with', 'in', 'on', 'at', 'by', 'for', 'to', 'from'
						]);

						sentenceWords.forEach((wordObj, wIdx) => {
							const text = wordObj.text.trim();
							const clean = text.replace(/[^a-zA-Z]/g, '').toLowerCase();
							const prevWord = wIdx > 0 ? sentenceWords[wIdx - 1].text.trim() : '';

							const prevHadPunct = /[,;:—–)"]$/.test(prevWord);
							const isConnector = CLAUSE_CONNECTORS.has(clean) && wordsInChunk >= 2;
							const reachedMax = wordsInChunk >= 4;

							if (wIdx > 0 && (prevHadPunct || isConnector || reachedMax)) {
								chunkIdx++;
								wordsInChunk = 0;
							}

							const colorIdx = chunkIdx % 5;
							wordObj.el.classList.add(`chunk-${colorIdx}`);
							wordsInChunk++;
						});

						sentences.push({
							id: sentenceCounter,
							text: sText,
							blockEl: block,
							words: sentenceWords
						});
						sentenceCounter++;
					}
				});
			});

			// Update estimated reading time
			if (timeEstEl) {
				const minutes = Math.max(1, Math.round(totalWordCount / 140));
				timeEstEl.textContent = `~${minutes} min listen`;
			}

			// Add interactive click listener to jump directly to any sentence
			contentContainer.addEventListener('click', (e) => {
				const target = (e.target as HTMLElement)?.closest('.tts-word') as HTMLElement | null;
				if (!target || !target.dataset.sentenceIdx) return;

				const targetIdx = parseInt(target.dataset.sentenceIdx, 10);
				if (!isNaN(targetIdx) && targetIdx >= 0 && targetIdx < sentences.length) {
					jumpToSentence(targetIdx);
				}
			});
		}

		// Helper: Sentence splitter with regex boundary and abbreviation protection
		function splitIntoSentences(text: string): string[] {
			// Protect common abbreviations and titles so periods don't trigger false sentence splits
			const protectedText = text
				.replace(/\b(Dr|Mr|Mrs|Ms|Prof|vs|etc|i\.e|e\.g)\./gi, '$1§dot§')
				.replace(/&nbsp;|\u00A0/g, ' ');

			let rawSentences: string[] = [];

			if (typeof Intl !== 'undefined' && (Intl as any).Segmenter) {
				try {
					const segmenter = new (Intl as any).Segmenter('en', { granularity: 'sentence' });
					rawSentences = Array.from(segmenter.segment(protectedText)).map((s: any) => s.segment.trim()).filter(Boolean);
				} catch (e) {
					// fallback to regex below
				}
			}

			if (rawSentences.length === 0) {
				rawSentences = protectedText
					.replace(/([.?!])\s+(?=[A-Z0-9"'])/g, '$1|~|')
					.split('|~|')
					.map((s) => s.trim())
					.filter(Boolean);
			}

			return rawSentences.map((s) => s.replace(/§dot§/g, '.').trim()).filter(Boolean);
		}

		tokenizeContent();

		// 3. Playback Engine
		function clearHighlights() {
			document.querySelectorAll('.tts-word.is-speaking-sentence, .tts-word.is-speaking-word').forEach((el) => {
				el.classList.remove('is-speaking-sentence', 'is-speaking-word');
			});
		}

		function highlightSentence(idx: number) {
			clearHighlights();
			const s = sentences[idx];
			if (!s) return;

			s.words.forEach((w) => {
				w.el.classList.add('is-speaking-sentence');
			});

			// Smooth scroll into view if outside reading comfort zone
			const firstWordEl = s.words[0]?.el;
			if (firstWordEl) {
				const rect = firstWordEl.getBoundingClientRect();
				const topSafe = 120;
				const bottomSafe = window.innerHeight - 140;
				if (rect.top < topSafe || rect.bottom > bottomSafe) {
					firstWordEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}
			}

			// Update UI indicators
			updateProgressUI(idx);
		}

		function highlightWord(sIdx: number, charIndex: number) {
			const s = sentences[sIdx];
			if (!s) return;

			// Find matching word
			let matchedWordIdx = -1;
			for (let i = 0; i < s.words.length; i++) {
				const w = s.words[i];
				if (charIndex >= w.start && (i === s.words.length - 1 || charIndex < s.words[i + 1].start)) {
					matchedWordIdx = i;
					break;
				}
			}

			if (matchedWordIdx !== -1 && matchedWordIdx !== currentWordIdx) {
				if (currentWordIdx >= 0 && s.words[currentWordIdx]) {
					s.words[currentWordIdx].el.classList.remove('is-speaking-word');
				}
				currentWordIdx = matchedWordIdx;
				s.words[matchedWordIdx].el.classList.add('is-speaking-word');
			}
		}

		function updateProgressUI(idx: number) {
			const total = sentences.length;
			if (total === 0) return;

			const percent = Math.min(100, Math.round(((idx + 1) / total) * 100));

			if (progressFill) progressFill.style.width = `${percent}%`;
			if (stickyProgressFill) stickyProgressFill.style.width = `${percent}%`;

			const currentSentence = sentences[idx];
			const previewText = currentSentence ? currentSentence.text : '';

			if (statusMsg) {
				statusMsg.textContent = `Reading sentence ${idx + 1} of ${total}...`;
			}
			if (stickySentenceEl) {
				stickySentenceEl.textContent = previewText;
			}
			if (stickyCounter) {
				stickyCounter.textContent = `${idx + 1} / ${total}`;
			}
		}

		function clearWatchdog() {
			if (watchdogTimer !== null) {
				clearTimeout(watchdogTimer);
				watchdogTimer = null;
			}
		}

		function startWatchdog(text: string, idx: number) {
			clearWatchdog();
			// Generous watchdog timeout: ~10 chars per second at current rate + 6s buffer
			const charRate = 10 * Math.max(0.5, playbackRate);
			const expectedSecs = Math.max(5, (text.length / charRate) + 6);
			watchdogTimer = window.setTimeout(() => {
				if (playbackState === 'PLAYING' && currentSentenceIdx === idx) {
					console.warn('[TTS] Watchdog timeout triggered on sentence:', idx, '- auto-advancing');
					advanceToNextSentence();
				}
			}, expectedSecs * 1000);
		}

		function advanceToNextSentence() {
			if (playbackState !== 'PLAYING' || isAdvancing) return;
			isAdvancing = true;
			clearWatchdog();

			const nextIdx = currentSentenceIdx + 1;
			if (nextIdx >= sentences.length) {
				stopPlayback();
				if (statusMsg) statusMsg.textContent = 'Finished reading article.';
				isAdvancing = false;
				return;
			}

			// Clean 40ms pause between sentences gives the browser engine time to finalize previous utterance
			window.setTimeout(() => {
				isAdvancing = false;
				if (playbackState === 'PLAYING') {
					playSentence(nextIdx, false);
				}
			}, 40);
		}

		function playSentence(idx: number, isManualJump: boolean = true) {
			if (!synth) return;
			if (idx < 0 || idx >= sentences.length) {
				stopPlayback();
				if (statusMsg) statusMsg.textContent = 'Finished reading article.';
				return;
			}

			clearWatchdog();
			isUserStopped = false;

			// Only cancel if user initiated a manual jump or reset, never on natural sentence transitions
			if (isManualJump) {
				synth.cancel();
			}

			currentSentenceIdx = idx;
			currentWordIdx = -1;
			playbackState = 'PLAYING';
			updateButtonStates();

			highlightSentence(idx);

			const sentenceData = sentences[idx];
			const textToSpeak = (sentenceData.text || '').replace(/\u00A0/g, ' ').trim();
			if (!textToSpeak) {
				advanceToNextSentence();
				return;
			}

			const utterance = new SpeechSynthesisUtterance(textToSpeak);
			utterance.rate = playbackRate;
			if (selectedVoice) utterance.voice = selectedVoice;

			// Global reference prevents Chromium V8 garbage collector from terminating speech mid-sentence
			activeUtterance = utterance;
			(window as any).__ttsActiveUtterance = utterance;

			utterance.onboundary = (e) => {
				if (e.name === 'word') {
					highlightWord(idx, e.charIndex);
				}
			};

			utterance.onend = () => {
				clearWatchdog();
				activeUtterance = null;
				(window as any).__ttsActiveUtterance = null;

				if (playbackState === 'PLAYING') {
					advanceToNextSentence();
				}
			};

			utterance.onerror = (e) => {
				clearWatchdog();
				activeUtterance = null;
				(window as any).__ttsActiveUtterance = null;

				if (isUserStopped) return;

				// If an utterance fails or is interrupted, smoothly recover by advancing to next sentence
				if (playbackState === 'PLAYING') {
					console.warn('[TTS] Utterance error:', e.error, 'on sentence:', idx);
					window.setTimeout(() => {
						if (playbackState === 'PLAYING') {
							advanceToNextSentence();
						}
					}, 50);
				}
			};

			// Resume synthesizer if browser has it in a suspended or paused state
			if (synth.paused) {
				synth.resume();
			}

			synth.speak(utterance);
			startWatchdog(textToSpeak, idx);
		}

		function pausePlayback() {
			if (!synth) return;
			isUserStopped = true;
			clearWatchdog();
			synth.cancel();
			activeUtterance = null;
			(window as any).__ttsActiveUtterance = null;
			playbackState = 'PAUSED';
			updateButtonStates();
			if (statusMsg) statusMsg.textContent = `Paused at sentence ${currentSentenceIdx + 1}. Click play to resume.`;
		}

		function resumePlayback() {
			isUserStopped = false;
			playSentence(currentSentenceIdx, true);
		}

		function stopPlayback() {
			if (!synth) return;
			isUserStopped = true;
			clearWatchdog();
			synth.cancel();
			activeUtterance = null;
			(window as any).__ttsActiveUtterance = null;
			clearHighlights();
			playbackState = 'STOPPED';
			currentSentenceIdx = 0;
			currentWordIdx = -1;
			updateButtonStates();
			if (progressFill) progressFill.style.width = '0%';
			if (stickyProgressFill) stickyProgressFill.style.width = '0%';
			if (statusMsg) statusMsg.textContent = 'Click play to listen with live word highlighting.';
			if (stickySentenceEl) stickySentenceEl.textContent = 'Listening to post...';
			if (stickyCounter) stickyCounter.textContent = `0 / ${sentences.length}`;
		}

		function jumpToSentence(idx: number) {
			playSentence(idx, true);
		}

		function updateButtonStates() {
			const isPlaying = playbackState === 'PLAYING';

			// Top player icons
			const playIcon = mainPlayBtn?.querySelector('.tts-play-icon') as HTMLElement | null;
			const pauseIcon = mainPlayBtn?.querySelector('.tts-pause-icon') as HTMLElement | null;
			const playText = document.getElementById('tts-play-text');

			if (playIcon) playIcon.style.display = isPlaying ? 'none' : 'block';
			if (pauseIcon) pauseIcon.style.display = isPlaying ? 'block' : 'none';
			if (playText) playText.textContent = isPlaying ? 'Pause' : 'Listen';

			// Icon box equalizer animation
			if (iconBox) {
				if (isPlaying) {
					iconBox.classList.add('is-playing');
				} else {
					iconBox.classList.remove('is-playing');
				}
			}

			// Compact bar play button
			const compactPlayIcon = compactPlayBtn?.querySelector('.tts-play-icon') as HTMLElement | null;
			const compactPauseIcon = compactPlayBtn?.querySelector('.tts-pause-icon') as HTMLElement | null;
			if (compactPlayIcon) compactPlayIcon.style.display = isPlaying ? 'none' : 'block';
			if (compactPauseIcon) compactPauseIcon.style.display = isPlaying ? 'block' : 'none';
			if (compactPlayLabel) compactPlayLabel.textContent = isPlaying ? 'Pause' : 'Listen';

			// Sticky bar icons
			const stickyPlayIcon = stickyPlayBtn?.querySelector('.tts-play-icon') as HTMLElement | null;
			const stickyPauseIcon = stickyPlayBtn?.querySelector('.tts-pause-icon') as HTMLElement | null;

			if (stickyPlayIcon) stickyPlayIcon.style.display = isPlaying ? 'none' : 'block';
			if (stickyPauseIcon) stickyPauseIcon.style.display = isPlaying ? 'block' : 'none';

			// Sticky bar visibility (visible whenever not STOPPED)
			if (stickyBar) {
				if (playbackState === 'STOPPED') {
					stickyBar.classList.remove('is-visible');
				} else {
					stickyBar.classList.add('is-visible');
				}
			}
		}

		// 4. Attach Event Listeners
		const compactPlayBtn = document.getElementById('tts-compact-play');
		const compactPlayLabel = document.getElementById('tts-compact-play-label');

		compactPlayBtn?.addEventListener('click', () => {
			if (playbackState === 'PLAYING') {
				pausePlayback();
			} else {
				resumePlayback();
			}
		});

		mainPlayBtn?.addEventListener('click', () => {
			if (playbackState === 'PLAYING') {
				pausePlayback();
			} else {
				resumePlayback();
			}
		});

		stickyPlayBtn?.addEventListener('click', () => {
			if (playbackState === 'PLAYING') {
				pausePlayback();
			} else {
				resumePlayback();
			}
		});

		prevBtn?.addEventListener('click', () => {
			const target = Math.max(0, currentSentenceIdx - 1);
			jumpToSentence(target);
		});

		stickyPrevBtn?.addEventListener('click', () => {
			const target = Math.max(0, currentSentenceIdx - 1);
			jumpToSentence(target);
		});

		nextBtn?.addEventListener('click', () => {
			const target = Math.min(sentences.length - 1, currentSentenceIdx + 1);
			jumpToSentence(target);
		});

		stickyNextBtn?.addEventListener('click', () => {
			const target = Math.min(sentences.length - 1, currentSentenceIdx + 1);
			jumpToSentence(target);
		});

		stopBtn?.addEventListener('click', stopPlayback);
		stickyCloseBtn?.addEventListener('click', stopPlayback);

		// Expand / Collapse Options Drawer
		const expandBtn = document.getElementById('tts-expand-btn');
		const expandedDrawer = document.getElementById('tts-expanded-drawer');
		let isOptionsExpanded = false;

		function setOptionsExpanded(expanded: boolean) {
			isOptionsExpanded = expanded;
			if (expandedDrawer) {
				expandedDrawer.style.display = expanded ? 'block' : 'none';
			}
			if (expandBtn) {
				expandBtn.setAttribute('aria-expanded', String(expanded));
				expandBtn.classList.toggle('is-expanded', expanded);
				const textEl = expandBtn.querySelector('.tts-expand-text');
				if (textEl) textEl.textContent = expanded ? 'Hide' : 'Options';
			}
		}

		expandBtn?.addEventListener('click', () => {
			setOptionsExpanded(!isOptionsExpanded);
		});

		speedSelect?.addEventListener('change', (e) => {
			const val = parseFloat((e.target as HTMLSelectElement).value);
			if (!isNaN(val)) {
				playbackRate = val;
				if (playbackState === 'PLAYING') {
					// Restart sentence at new rate
					playSentence(currentSentenceIdx);
				}
			}
		});

		voiceSelect?.addEventListener('change', (e) => {
			const idx = parseInt((e.target as HTMLSelectElement).value, 10);
			if (!isNaN(idx) && availableVoices[idx]) {
				selectedVoice = availableVoices[idx];
				if (playbackState === 'PLAYING') {
					playSentence(currentSentenceIdx);
				}
			}
		});

		// Keyboard Shortcuts (Space for toggle, Esc for stop)
		window.addEventListener('keydown', (e) => {
			if (['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement)?.tagName || '')) return;

			if (e.code === 'Space' && playbackState !== 'STOPPED') {
				e.preventDefault();
				if (playbackState === 'PLAYING') {
					pausePlayback();
				} else {
					resumePlayback();
				}
			} else if (e.code === 'Escape' && playbackState !== 'STOPPED') {
				stopPlayback();
			}
		});

		// 5. Accessible & Dyslexic Reading Modes Controller
		const quickBionicBtn = document.getElementById('tts-quick-bionic');
		const quickChunkBtn = document.getElementById('tts-quick-chunking');
		const chipBionic = document.getElementById('tts-chip-bionic');
		const chipChunk = document.getElementById('tts-chip-chunking');
		const chipDyslexicFont = document.getElementById('tts-chip-dyslexic-font');
		const chipRuler = document.getElementById('tts-chip-ruler');
		const chunkPanel = document.getElementById('tts-chunk-panel');
		const stickyBionicBtn = document.getElementById('tts-sticky-bionic');
		const pillToggle = document.getElementById('dyslexic-pill-toggle');
		const readingRuler = document.getElementById('dyslexic-reading-ruler');

		const sliderWidth = document.getElementById('tts-slider-width') as HTMLInputElement | null;
		const sliderLetter = document.getElementById('tts-slider-letter') as HTMLInputElement | null;
		const sliderWord = document.getElementById('tts-slider-word') as HTMLInputElement | null;
		const valWidth = document.getElementById('tts-val-width');
		const valLetter = document.getElementById('tts-val-letter');
		const valWord = document.getElementById('tts-val-word');
		const resetSpacingBtn = document.getElementById('tts-reset-spacing');

		interface DyslexicSettings {
			dyslexicMode: boolean;
			phraseChunking: boolean;
			bionicReading: boolean;
			readingRuler: boolean;
		}

		let dyslexicSettings: DyslexicSettings = {
			dyslexicMode: false,
			phraseChunking: false,
			bionicReading: false,
			readingRuler: false
		};

		function applyDyslexicSettings() {
			// Toggle body classes
			document.body.classList.toggle('dyslexic-mode', dyslexicSettings.dyslexicMode);
			document.body.classList.toggle('chunking-mode-active', dyslexicSettings.phraseChunking);
			document.body.classList.toggle('bionic-reading-active', dyslexicSettings.bionicReading);
			document.body.classList.toggle('has-reading-ruler', dyslexicSettings.readingRuler);

			// Synchronize UI buttons & chips
			quickBionicBtn?.classList.toggle('is-active', dyslexicSettings.bionicReading);
			chipBionic?.classList.toggle('is-active', dyslexicSettings.bionicReading);
			stickyBionicBtn?.classList.toggle('is-active', dyslexicSettings.bionicReading);
			pillToggle?.classList.toggle('is-active', dyslexicSettings.bionicReading);

			quickChunkBtn?.classList.toggle('is-active', dyslexicSettings.phraseChunking);
			chipChunk?.classList.toggle('is-active', dyslexicSettings.phraseChunking);

			chipDyslexicFont?.classList.toggle('is-active', dyslexicSettings.dyslexicMode);
			chipRuler?.classList.toggle('is-active', dyslexicSettings.readingRuler);

			if (chunkPanel) {
				chunkPanel.style.display = dyslexicSettings.phraseChunking ? 'flex' : 'none';
			}

			try {
				localStorage.setItem('decoding_dyslexic_settings', JSON.stringify(dyslexicSettings));
				localStorage.setItem('decoding_dyslexic_mode', dyslexicSettings.dyslexicMode ? 'true' : 'false');
			} catch (err) {}
		}

		// Check saved preference on page load
		try {
			const saved = localStorage.getItem('decoding_dyslexic_settings');
			if (saved) {
				dyslexicSettings = { ...dyslexicSettings, ...JSON.parse(saved) };
			} else if (localStorage.getItem('decoding_dyslexic_mode') === 'true') {
				dyslexicSettings.dyslexicMode = true;
			}
			applyDyslexicSettings();
		} catch (err) {}

		// Custom Column Width Controller
		function updateColumnWidth(widthVal: number, persist = true) {
			document.documentElement.style.setProperty('--reading-max-width', `${widthVal}ch`);

			if (sliderWidth && parseInt(sliderWidth.value, 10) !== widthVal) {
				sliderWidth.value = String(widthVal);
			}

			if (valWidth) {
				valWidth.textContent = `${widthVal}ch (~${Math.round(widthVal * 0.95)} chars)`;
			}

			if (persist) {
				try {
					localStorage.setItem('decoding_reading_width', String(widthVal));
				} catch (e) {}
			}
		}

		sliderWidth?.addEventListener('input', (e) => {
			const v = parseInt((e.target as HTMLInputElement).value, 10) || 58;
			updateColumnWidth(v);
		});

		// Custom Spacing Sliders Controller
		function updateSpacing(letterVal: number, wordVal: number, persist = true) {
			const letterStr = letterVal === 0 ? 'normal' : `${letterVal}em`;
			const wordStr = wordVal === 0 ? 'normal' : `${wordVal}em`;

			document.documentElement.style.setProperty('--user-letter-spacing', letterStr);
			document.documentElement.style.setProperty('--user-word-spacing', wordStr);

			if (sliderLetter && parseFloat(sliderLetter.value) !== letterVal) {
				sliderLetter.value = String(letterVal);
			}
			if (sliderWord && parseFloat(sliderWord.value) !== wordVal) {
				sliderWord.value = String(wordVal);
			}

			if (valLetter) {
				valLetter.textContent = letterVal === 0 ? 'Normal' : `+${letterVal}em`;
			}
			if (valWord) {
				valWord.textContent = wordVal === 0 ? 'Normal' : `+${wordVal}em`;
			}

			if (persist) {
				try {
					localStorage.setItem('decoding_spacing_settings', JSON.stringify({ letter: letterVal, word: wordVal }));
				} catch (e) {}
			}
		}

		sliderLetter?.addEventListener('input', (e) => {
			const v = parseFloat((e.target as HTMLInputElement).value) || 0;
			const currentWord = sliderWord ? parseFloat(sliderWord.value) || 0 : 0;
			updateSpacing(v, currentWord);
		});

		sliderWord?.addEventListener('input', (e) => {
			const v = parseFloat((e.target as HTMLInputElement).value) || 0;
			const currentLetter = sliderLetter ? parseFloat(sliderLetter.value) || 0 : 0;
			updateSpacing(currentLetter, v);
		});

		resetSpacingBtn?.addEventListener('click', () => {
			updateSpacing(0, 0);
			updateColumnWidth(58);
		});

		// Restore saved custom layout and spacing on page load
		try {
			const savedWidth = localStorage.getItem('decoding_reading_width');
			if (savedWidth) {
				updateColumnWidth(parseInt(savedWidth, 10), false);
			} else {
				updateColumnWidth(58, false);
			}

			const savedSpacing = localStorage.getItem('decoding_spacing_settings');
			if (savedSpacing) {
				const parsed = JSON.parse(savedSpacing);
				updateSpacing(Number(parsed.letter) || 0, Number(parsed.word) || 0, false);
			}
		} catch (e) {}

		const toggleBionic = () => {
			dyslexicSettings.bionicReading = !dyslexicSettings.bionicReading;
			applyDyslexicSettings();
		};

		const toggleChunking = () => {
			dyslexicSettings.phraseChunking = !dyslexicSettings.phraseChunking;
			applyDyslexicSettings();
		};

		quickBionicBtn?.addEventListener('click', toggleBionic);
		chipBionic?.addEventListener('click', toggleBionic);
		stickyBionicBtn?.addEventListener('click', toggleBionic);
		pillToggle?.addEventListener('click', toggleBionic);

		quickChunkBtn?.addEventListener('click', toggleChunking);
		chipChunk?.addEventListener('click', toggleChunking);

		chipDyslexicFont?.addEventListener('click', () => {
			dyslexicSettings.dyslexicMode = !dyslexicSettings.dyslexicMode;
			applyDyslexicSettings();
		});

		chipRuler?.addEventListener('click', () => {
			dyslexicSettings.readingRuler = !dyslexicSettings.readingRuler;
			applyDyslexicSettings();
		});

		// Reading ruler mouse tracking
		window.addEventListener('mousemove', (e) => {
			if (dyslexicSettings.readingRuler && readingRuler) {
				readingRuler.style.top = `${e.clientY}px`;
			}
		});

		// Cleanup when navigating away or unmounting
		window.addEventListener('beforeunload', () => {
			synth.cancel();
			clearWatchdog();
		});
	})();
</script>
