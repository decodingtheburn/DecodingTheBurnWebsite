---
// PresenterCursor.astro - Recording Tools
// 1. Key 'C' cycle modes: OFF -> 2x Red Circle -> Large Red Arrow -> OFF
// 2. Key 'S': Fullscreen Video Hook Card with editable text (default "BMS"), saved in Cookie across pages.
// 3. Double-click title to edit. Single click / blur saves & exits edit state. No edit icon.
---

<div id="presenter-cursor" class="presenter-cursor" aria-hidden="true">
	<!-- High-Visibility Large Red Arrow with Tail, Amber/Yellow Border, and Heavy Black Shadow -->
	<svg id="presenter-arrow-svg" class="presenter-arrow-svg" width="64" height="64" viewBox="0 0 32 32" fill="none">
		<path 
			d="M4 4 L13 28 L17.5 17.5 L28 13 Z" 
			fill="#DC2626" 
			stroke="#F59E0B" 
			stroke-width="2.2" 
			stroke-linejoin="round" 
			stroke-linecap="round"
		/>
		<!-- Arrow Stem / Tail Extension for complete classic pointer shape -->
		<path 
			d="M16 16 L27 27" 
			stroke="#DC2626" 
			stroke-width="5" 
			stroke-linecap="round"
		/>
		<path 
			d="M16 16 L27 27" 
			stroke="#F59E0B" 
			stroke-width="2.2" 
			stroke-linecap="round"
		/>
	</svg>
</div>

<div id="cursor-toggle-toast" class="cursor-toggle-toast" aria-hidden="true">
	<span id="toast-message">Cursor Mode: OFF</span>
</div>

<!-- Fullscreen Hook Card Overlay (Triggered by 'S') -->
<div id="presenter-hook-card" class="presenter-hook-card" aria-hidden="true">
	<div class="hook-card-container">
		<div id="hook-text-display" class="hook-text-display" tabindex="0" title="Double-click to edit title">
			BMS
		</div>
	</div>
</div>

<script>
	(function () {
		// Cursor Modes: 0 = OFF, 1 = Red Circle (2x), 2 = Big Red Arrow
		let cursorMode = 0;
		let isHookActive = false;

		const cursorEl = document.getElementById('presenter-cursor');
		const toastEl = document.getElementById('cursor-toggle-toast');
		const toastMsg = document.getElementById('toast-message');
		const hookCardEl = document.getElementById('presenter-hook-card');
		const hookTextEl = document.getElementById('hook-text-display');

		if (!cursorEl || !hookCardEl) return;

		let mouseX = -100;
		let mouseY = -100;

		// Cookie helper
		function getCookie(name) {
			const value = `; ${document.cookie}`;
			const parts = value.split(`; ${name}=`);
			if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
			return null;
		}

		function setCookie(name, val, days = 365) {
			const d = new Date();
			d.setTime(d.getTime() + days * 24 * 60 * 60 * 1000);
			document.cookie = `${name}=${encodeURIComponent(val)};expires=${d.toUTCString()};path=/`;
		}

		// Load saved Hook Title from Cookie (or fallback to "BMS")
		if (hookTextEl) {
			const savedTitle = getCookie('presenter_hook_title');
			if (savedTitle) {
				hookTextEl.textContent = savedTitle;
			}
		}

		function showToast(text) {
			if (!toastEl || !toastMsg) return;
			toastMsg.innerHTML = text;
			toastEl.classList.add('show');
			setTimeout(() => toastEl.classList.remove('show'), 1800);
		}

		// Track Mouse Position
		window.addEventListener('mousemove', (e) => {
			mouseX = e.clientX;
			mouseY = e.clientY;
			if (cursorMode > 0) {
				cursorEl.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
			}
		});

		// Keyboard Shortcuts ('C' & 'S')
		window.addEventListener('keydown', (e) => {
			const active = document.activeElement;
			if (
				active &&
				(active.tagName === 'INPUT' ||
					active.tagName === 'TEXTAREA' ||
					active.isContentEditable ||
					active.getAttribute('contenteditable') === 'true')
			) {
				return;
			}

			// Key 'C': Cycle Cursor Mode (0: OFF -> 1: Red Circle -> 2: Big Red Arrow -> 0: OFF)
			if (e.key === 'c' || e.key === 'C') {
				cursorMode = (cursorMode + 1) % 3;

				document.body.classList.remove('presenter-cursor-active');
				cursorEl.classList.remove('mode-circle', 'mode-arrow');

				if (cursorMode === 1) {
					// Mode 1: Red Circle 2x
					document.body.classList.add('presenter-cursor-active');
					cursorEl.classList.add('mode-circle');
					cursorEl.style.display = 'block';
					cursorEl.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
					showToast('Cursor: <strong>2x Red Circle 🔴</strong> <kbd>C</kbd>');
				} else if (cursorMode === 2) {
					// Mode 2: Big Red Arrow
					document.body.classList.add('presenter-cursor-active');
					cursorEl.classList.add('mode-arrow');
					cursorEl.style.display = 'block';
					cursorEl.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
					showToast('Cursor: <strong>Big Red Arrow 🏹</strong> <kbd>C</kbd>');
				} else {
					// Mode 0: OFF
					cursorEl.style.display = 'none';
					showToast('Cursor: <strong>OFF</strong> <kbd>C</kbd>');
				}
			}

			// Key 'S': Toggle Fullscreen Hook Card
			if (e.key === 's' || e.key === 'S') {
				isHookActive = !isHookActive;
				if (isHookActive) {
					hookCardEl.classList.add('is-active');
					showToast('Hook Card: <strong>OPEN</strong> <kbd>S</kbd>');
				} else {
					closeHookCard();
				}
			}

			// Key 'T': Jump/Scroll to Table of Contents
			if (e.key === 't' || e.key === 'T') {
				const tocEl = document.querySelector('.toc-sidebar-container, .toc-inline-container, #table-of-contents');
				if (tocEl) {
					tocEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
					showToast('Table of Contents <kbd>T</kbd>');
				}
			}

			// ESC key closes hook card
			if (e.key === 'Escape' && isHookActive) {
				closeHookCard();
			}
		});

		function closeHookCard() {
			isHookActive = false;
			hookCardEl.classList.remove('is-active');
			if (hookTextEl) {
				disableTextEditing();
			}
			showToast('Hook Card: <strong>CLOSED</strong> <kbd>S</kbd>');
		}

		// Text Editing Logic: Double-Click to Edit
		function enableTextEditing() {
			if (!hookTextEl) return;
			hookTextEl.contentEditable = "true";
			hookTextEl.classList.add('is-editing');
			hookTextEl.focus();
		}

		function disableTextEditing() {
			if (!hookTextEl) return;
			hookTextEl.contentEditable = "false";
			hookTextEl.classList.remove('is-editing');

			// Save to Cookie
			const currentText = hookTextEl.textContent.trim() || 'BMS';
			hookTextEl.textContent = currentText;
			setCookie('presenter_hook_title', currentText);
		}

		if (hookTextEl) {
			// Double click to start editing
			hookTextEl.addEventListener('dblclick', (e) => {
				e.stopPropagation();
				enableTextEditing();
			});

			// Single click while editing finishes & saves
			hookTextEl.addEventListener('click', (e) => {
				if (hookTextEl.isContentEditable) {
					e.stopPropagation();
					disableTextEditing();
				}
			});

			// Blur (clicking outside) saves & returns to normal state
			hookTextEl.addEventListener('blur', () => {
				disableTextEditing();
			});

			// Press Enter to finish editing
			hookTextEl.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' && !e.shiftKey) {
					e.preventDefault();
					disableTextEditing();
				}
			});
		}

		// Click Ripple Effect (works in both cursor modes)
		window.addEventListener('click', (e) => {
			if (cursorMode === 0 || isHookActive) return;

			const ripple = document.createElement('div');
			ripple.className = 'presenter-click-ripple';
			ripple.style.left = `${e.clientX}px`;
			ripple.style.top = `${e.clientY}px`;
			document.body.appendChild(ripple);

			setTimeout(() => {
				ripple.remove();
			}, 600);
		});
	})();
</script>

<style is:global>
	/* Presenter Cursor Container */
	.presenter-cursor {
		position: fixed;
		top: 0;
		left: 0;
		pointer-events: none;
		z-index: 999999;
		display: none;
		will-change: transform;
	}

	/* Mode 1: Red 2x Circle Dot with Amber/Yellow Border and Black Shadow */
	.presenter-cursor.mode-circle {
		width: 32px;
		height: 32px;
		margin-left: -16px;
		margin-top: -16px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(239, 68, 68, 0.98) 0%, rgba(220, 38, 38, 0.9) 45%, rgba(239, 68, 68, 0.4) 75%, transparent 100%);
		border: 2.5px solid #f59e0b; /* Amber/Yellow border */
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.95), 0 0 20px rgba(239, 68, 68, 0.85); /* Black drop shadow */
	}

	.presenter-cursor.mode-circle #presenter-arrow-svg {
		display: none;
	}

	/* Mode 2: Big Red Arrow Cursor with Tail & Black Drop Shadows */
	.presenter-cursor.mode-arrow {
		width: 64px;
		height: 64px;
		margin-left: -4px;
		margin-top: -4px;
		background: transparent;
		border: none;
		box-shadow: none;
		/* Crisp heavy black drop shadow for high contrast on light & dark backgrounds */
		filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 16px rgba(239, 68, 68, 0.75));
	}

	.presenter-cursor.mode-arrow #presenter-arrow-svg {
		display: block;
		width: 64px;
		height: 64px;
	}

	body.presenter-cursor-active,
	body.presenter-cursor-active a,
	body.presenter-cursor-active button,
	body.presenter-cursor-active [role="button"] {
		cursor: none !important;
	}

	/* Click Ripple Effect */
	.presenter-click-ripple {
		position: fixed;
		width: 18px;
		height: 18px;
		margin-left: -9px;
		margin-top: -9px;
		border-radius: 50%;
		border: 3px solid #ef4444;
		background: rgba(239, 68, 68, 0.4);
		box-shadow: 0 0 16px rgba(239, 68, 68, 0.9);
		pointer-events: none;
		z-index: 999998;
		animation: presenterRippleAnim 0.55s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
	}

	@keyframes presenterRippleAnim {
		0% {
			transform: scale(0.8);
			opacity: 1;
		}
		100% {
			transform: scale(4.2);
			opacity: 0;
		}
	}

	/* Toast Notification */
	.cursor-toggle-toast {
		position: fixed;
		bottom: 24px;
		right: 24px;
		background: #0f172a;
		color: #ffffff;
		border: 1px solid #334155;
		padding: 0.6rem 1.1rem;
		border-radius: 10px;
		font-size: 0.88rem;
		font-weight: 700;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
		z-index: 9999999;
		opacity: 0;
		transform: translateY(12px);
		pointer-events: none;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.cursor-toggle-toast.show {
		opacity: 1;
		transform: translateY(0);
	}

	.cursor-toggle-toast kbd {
		background: #334155;
		color: #ffffff;
		padding: 0.15rem 0.45rem;
		border-radius: 4px;
		font-size: 0.75rem;
		font-family: monospace;
	}

	/* ------------------------------------------------------------- */
	/* Fullscreen Hook Card Overlay (Triggered by 'S')               */
	/* ------------------------------------------------------------- */
	.presenter-hook-card {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		background: radial-gradient(circle 1200px at 50% 30%, #4c1d95 0%, #2e1065 60%, #1e1b4b 100%);
		z-index: 999990;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 3rem;
		box-sizing: border-box;
		animation: hookPopIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	.presenter-hook-card.is-active {
		display: flex;
	}

	@keyframes hookPopIn {
		0% {
			opacity: 0;
			transform: scale(0.94);
		}
		100% {
			opacity: 1;
			transform: scale(1);
		}
	}

	.hook-card-container {
		position: relative;
		width: 100%;
		max-width: 1200px;
		min-height: 480px;
		background: transparent;
		border: none;
		box-shadow: none;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 3rem 4rem;
		box-sizing: border-box;
	}

	/* Giant High-Contrast Centered Hook Title - Slightly Italic */
	.hook-text-display {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(4.5rem, 12vw, 10rem);
		font-weight: 900;
		font-style: italic;
		color: #ffffff;
		text-align: center;
		line-height: 1.05;
		letter-spacing: -0.03em;
		text-shadow: 0 6px 30px rgba(0, 0, 0, 0.6), 0 0 50px rgba(168, 85, 247, 0.4);
		outline: none;
		cursor: pointer;
		padding: 1rem 2rem;
		border-radius: 20px;
		border: none;
		transition: all 0.2s ease;
		max-width: 100%;
		word-break: break-word;
		text-wrap: balance;
		user-select: none;
	}

	.hook-text-display:hover {
		border-color: rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.03);
	}

	.hook-text-display.is-editing {
		border-color: #ef4444;
		background: rgba(0, 0, 0, 0.5);
		box-shadow: 0 0 30px rgba(239, 68, 68, 0.4);
		cursor: text;
		user-select: text;
	}
</style>
