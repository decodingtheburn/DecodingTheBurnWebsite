---
// AcidFoodScale.astro - Continuous 30-item vertical scale categorized into Red (Aggressive Acid), Yellow (Moderate/Fermentable), and Green (Zero Acid)
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

// 30 Total Foods & Drinks Strictly Sorted by pH (Ascending: Worst 2.2 to Best 7.4)
const redZoneFoods = [
	{ 
		name: "Lemon & Lime Juice", 
