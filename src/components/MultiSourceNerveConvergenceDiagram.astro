---
// MultiSourceNerveConvergenceDiagram.astro
// Interactive Anatomical & Architectural SVG Diagram:
// 5 Peripheral Sources in the Mouth -> Merging into the V3/V2 Nerve Trunk -> Brainstem Hub (Subnucleus Caudalis) -> Multiplied Tongue Burning
---

<div class="nerve-convergence-interactive-container tts-ignore" style="margin: 2.25rem 0 2.75rem; background: #090514; border: 1.5px solid #3b1d6e; border-radius: 16px; padding: 1.5rem; box-shadow: 0 12px 40px -10px rgba(0, 0, 0, 0.7); color: #f8fafc;">
  
  <!-- Header -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 1px solid #1e1338; padding-bottom: 1rem;">
    <div>
      <div style="font-size: 0.76rem; font-weight: 800; color: #a855f7; text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.35; margin-bottom: 0.2rem;">
        Interactive Systems-Biology Architecture
      </div>
      <div style="font-size: 1.2rem; font-weight: 900; color: #ffffff; line-height: 1.35;">
        Visual Model 5: Multi-Source Oral Ingress &amp; Trigeminal Convergence
      </div>
      <p style="font-size: 0.86rem; color: #94a3b8; line-height: 1.45; margin: 0.35rem 0 0; max-width: 760px;">
        Trace how five concurrent peripheral leaks in the mouth funnel electrical charges down individual nerve branches, merging into the high-bandwidth Mandibular (V3) cable before saturating the brainstem's oral pain computer.
      </p>
    </div>
    <div style="display: flex; gap: 0.5rem; align-items: center; align-self: flex-start;">
      <span style="font-size: 0.78rem; font-weight: 700; color: #ec4899; background: #3b0724; border: 1px solid #831843; padding: 0.25rem 0.7rem; border-radius: 9999px; line-height: 1.3;">
        &Sigma; 5 Oral Faucets = 100% Spark
      </span>
    </div>
  </div>

  <!-- Interactive Control Bar -->
  <div style="background: #130a26; border: 1px solid #2e1a54; border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1.25rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
    <div style="font-size: 0.82rem; color: #cbd5e1; line-height: 1.4;">
      <strong style="color: #c084fc;">Simulation Controller:</strong> Toggle individual sources on/off to watch central bandwidth saturation change in real-time.
    </div>
    <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
      <button type="button" class="ctrl-btn active" data-source="all" style="font-size: 0.76rem; font-weight: 700; padding: 0.3rem 0.65rem; border-radius: 6px; border: 1px solid #7c3aed; background: #7c3aed; color: white; cursor: pointer;">All 5 Leaks (10/10 Scald)</button>
      <button type="button" class="ctrl-btn" data-source="diet-only" style="font-size: 0.76rem; font-weight: 700; padding: 0.3rem 0.65rem; border-radius: 6px; border: 1px solid #4c1d95; background: #1a0f35; color: #c084fc; cursor: pointer;">Cut Diet Only (-10%)</button>
      <button type="button" class="ctrl-btn" data-source="sealed" style="font-size: 0.76rem; font-weight: 700; padding: 0.3rem 0.65rem; border-radius: 6px; border: 1px solid #065f46; background: #064e3b; color: #34d399; cursor: pointer;">Triage All Sources (0/10 Pain)</button>
    </div>
  </div>

  <!-- SVG Visual Diagram -->
  <div style="width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 12px; background: radial-gradient(circle at 65% 50%, #160c2e 0%, #080312 85%); border: 1px solid #251242;">
    <svg viewBox="0 0 960 520" style="width: 100%; min-width: 780px; height: auto; display: block;" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Gradients -->
        <linearGradient id="trunkGlow" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.2" />
          <stop offset="50%" stop-color="#8b5cf6" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#ef4444" stop-opacity="0.9" />
        </linearGradient>
        <linearGradient id="nerveTubeGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.9" />
          <stop offset="25%" stop-color="#818cf8" stop-opacity="0.95" />
          <stop offset="50%" stop-color="#c084fc" stop-opacity="1" />
          <stop offset="75%" stop-color="#f43f5e" stop-opacity="0.95" />
          <stop offset="100%" stop-color="#fb7185" stop-opacity="0.8" />
        </linearGradient>
        <radialGradient id="hubGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.8" />
          <stop offset="50%" stop-color="#a855f7" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#090514" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="tongueBurnGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ff0055" stop-opacity="0.9" />
          <stop offset="60%" stop-color="#ff5500" stop-opacity="0.5" />
          <stop offset="100%" stop-color="#090514" stop-opacity="0" />
        </radialGradient>
        <!-- Filters -->
        <filter id="pulseGlow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="5" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <!-- 1. LEFT ZONE: THE ORAL CAVITY & 5 PERIPHERAL SOURCES (X: 20 to 280) -->
      <!-- Oral Cavity Backdrop -->
      <rect x="25" y="25" width="260" height="470" rx="12" fill="#0f0722" stroke="#2a1447" stroke-width="1.5" />
      <text x="40" y="52" fill="#c084fc" font-size="12" font-weight="800" letter-spacing="0.05em">1. ORAL CAVITY (5 PARALLEL FAUCETS)</text>

      <!-- Source 1 Card: Leaking Dental Margins -->
      <g class="source-node s1" transform="translate(40, 70)">
        <rect width="230" height="66" rx="8" fill="#180e33" stroke="#6366f1" stroke-width="1.4" />
        <circle cx="16" cy="22" r="5" fill="#6366f1" />
        <text x="28" y="26" fill="#ffffff" font-size="12" font-weight="700">1. Leaking Margins (40%)</text>
        <text x="16" y="44" fill="#94a3b8" font-size="10">Subgingival crown cement washouts</text>
        <text x="16" y="57" fill="#818cf8" font-size="9.5" font-weight="600">Tooth #19, #30 micro-gaps &bull; 40 Hz</text>
      </g>

      <!-- Source 2 Card: Exposed Root Tubules -->
      <g class="source-node s2" transform="translate(40, 150)">
        <rect width="230" height="66" rx="8" fill="#180e33" stroke="#8b5cf6" stroke-width="1.4" />
        <circle cx="16" cy="22" r="5" fill="#8b5cf6" />
        <text x="28" y="26" fill="#ffffff" font-size="12" font-weight="700">2. Exposed Tubules (25%)</text>
        <text x="16" y="44" fill="#94a3b8" font-size="10">Cervical recession / lost resin</text>
        <text x="16" y="57" fill="#a78bfa" font-size="9.5" font-weight="600">60,000 to 135,000 open micro-canals</text>
      </g>

      <!-- Source 3 Card: Periodontal Biofilm Trenches -->
      <g class="source-node s3" transform="translate(40, 230)">
        <rect width="230" height="66" rx="8" fill="#180e33" stroke="#ec4899" stroke-width="1.4" />
        <circle cx="16" cy="22" r="5" fill="#ec4899" />
        <text x="28" y="26" fill="#ffffff" font-size="12" font-weight="700">3. Sulcus Biofilm (15%)</text>
        <text x="16" y="44" fill="#94a3b8" font-size="10">3 to 4 mm anaerobic pockets</text>
        <text x="16" y="57" fill="#f472b6" font-size="9.5" font-weight="600">Stagnant lactic acid incubation</text>
      </g>

      <!-- Source 4 Card: Dietary Acidity -->
      <g class="source-node s4" transform="translate(40, 310)">
        <rect width="230" height="66" rx="8" fill="#180e33" stroke="#f59e0b" stroke-width="1.4" />
        <circle cx="16" cy="22" r="5" fill="#f59e0b" />
        <text x="28" y="26" fill="#ffffff" font-size="12" font-weight="700">4. Dietary Acidity (10%)</text>
        <text x="16" y="44" fill="#94a3b8" font-size="10">Coffee, wine, vinegar, fruit juice</text>
        <text x="16" y="57" fill="#fbbf24" font-size="9.5" font-weight="600">External H+ washing over barriers</text>
      </g>

      <!-- Source 5 Card: Salivary Buffer Depletion -->
      <g class="source-node s5" transform="translate(40, 390)">
        <rect width="230" height="66" rx="8" fill="#180e33" stroke="#ef4444" stroke-width="1.4" />
        <circle cx="16" cy="22" r="5" fill="#ef4444" />
        <text x="28" y="26" fill="#ffffff" font-size="12" font-weight="700">5. Salivary Deficit (10%)</text>
        <text x="16" y="44" fill="#94a3b8" font-size="10">Stress cortisol, mouth-breathing</text>
        <text x="16" y="57" fill="#f87171" font-size="9.5" font-weight="600">Loss of alkaline bicarbonate buffer</text>
      </g>

      <!-- 2. MIDDLE ZONE: NERVE TRIBUTARIES & MAIN MANDIBULAR (V3) TRUNK CABLE (X: 280 to 620) -->
      <!-- Nerve Convergence Lines from Sources to Trunk Entrance -->
      <path class="stream-line line-s1" d="M 270 103 C 330 103, 380 200, 420 220" fill="none" stroke="#6366f1" stroke-width="3" stroke-linecap="round" />
      <path class="stream-line line-s2" d="M 270 183 C 340 183, 380 215, 420 230" fill="none" stroke="#8b5cf6" stroke-width="3" stroke-linecap="round" />
      <path class="stream-line line-s3" d="M 270 263 C 340 263, 380 245, 420 240" fill="none" stroke="#ec4899" stroke-width="2.5" stroke-linecap="round" />
      <path class="stream-line line-s4" d="M 270 343 C 340 343, 380 260, 420 250" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" />
      <path class="stream-line line-s5" d="M 270 423 C 330 423, 380 270, 420 260" fill="none" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" />

      <!-- The Main Trigeminal Mandibular (V3) Cable Tube (Physical Sheath) -->
      <g transform="translate(420, 185)">
        <!-- Outer Epineurium Sheath (Transparent Glassy Blue/Purple) -->
        <path d="M 0 15 C 60 15, 120 25, 180 35 L 180 85 C 120 75, 60 65, 0 65 Z" fill="url(#nerveTubeGrad)" opacity="0.18" />
        <path d="M 0 15 C 60 15, 120 25, 180 35" fill="none" stroke="#38bdf8" stroke-width="3" stroke-linecap="round" />
        <path d="M 0 65 C 60 65, 120 75, 180 85" fill="none" stroke="#ec4899" stroke-width="3" stroke-linecap="round" />

        <!-- Internal Packed Axon Fibers (The 70,000 Cable) -->
        <line x1="5" y1="28" x2="175" y2="44" stroke="#6366f1" stroke-width="3.5" stroke-dasharray="8 4" class="anim-axon-flow" />
        <line x1="5" y1="40" x2="175" y2="54" stroke="#a855f7" stroke-width="3.5" stroke-dasharray="10 5" class="anim-axon-flow" />
        <line x1="5" y1="52" x2="175" y2="65" stroke="#f43f5e" stroke-width="3.5" stroke-dasharray="6 3" class="anim-axon-flow" />

        <!-- Cable Label -->
        <rect x="25" y="-12" width="130" height="22" rx="4" fill="#030712" stroke="#38bdf8" stroke-width="1" />
        <text x="90" y="3" fill="#38bdf8" font-size="10" font-weight="800" text-anchor="middle">V3 TRUNK (70k AXONS)</text>

        <!-- Bandwidth Saturation Badge -->
        <rect x="25" y="88" width="130" height="22" rx="4" fill="#450a0a" stroke="#ef4444" stroke-width="1" />
        <text x="90" y="103" fill="#fca5a5" font-size="10" font-weight="800" text-anchor="middle">100% BANDWIDTH FULL</text>
      </g>

      <!-- Ephaptic Cross-Talk Arc: Tooth to Tongue Wire Jump inside cable -->
      <g transform="translate(480, 205)">
        <path d="M 15 15 C 25 -5, 55 -5, 65 15" fill="none" stroke="#fbbf24" stroke-width="2.5" stroke-dasharray="3 2" filter="url(#pulseGlow)" />
        <text x="40" y="-8" fill="#fbbf24" font-size="9" font-weight="800" text-anchor="middle">&#9889; K+ Short-Circuit</text>
      </g>

      <!-- 3. RIGHT ZONE: CENTRAL SWITCHBOARD (SUBNUCLEUS CAUDALIS) & EXPONENTIAL MULTIPLIER (X: 620 to 930) -->
      <!-- Central Processing Hub Aura -->
      <circle cx="700" cy="235" r="75" fill="url(#hubGlow)" />
      
      <!-- Central Hub Box (Brainstem Relay) -->
      <g transform="translate(625, 155)">
        <rect width="150" height="160" rx="14" fill="#180a33" stroke="#a855f7" stroke-width="2.5" filter="url(#pulseGlow)" />
        <text x="75" y="26" fill="#c084fc" font-size="10" font-weight="800" text-anchor="middle" letter-spacing="0.05em">CENTRAL RELAY HUB</text>
        <text x="75" y="44" fill="#ffffff" font-size="11.5" font-weight="800" text-anchor="middle">Subnucleus Caudalis</text>
        <text x="75" y="58" fill="#a78bfa" font-size="10" font-weight="700" text-anchor="middle">(Brainstem Vc)</text>
        
        <!-- Status Badges inside Hub -->
        <rect x="12" y="70" width="126" height="24" rx="4" fill="#2e1065" stroke="#7e22ce" stroke-width="1" />
        <text x="75" y="86" fill="#f3e8ff" font-size="9" font-weight="700" text-anchor="middle">GLT-1 Pumps Saturated</text>

        <rect x="12" y="100" width="126" height="24" rx="4" fill="#450a0a" stroke="#dc2626" stroke-width="1" />
        <text x="75" y="116" fill="#fecaca" font-size="9" font-weight="700" text-anchor="middle">GABA Inhibitory Brakes Lost</text>

        <text x="75" y="142" fill="#fb7185" font-size="10" font-weight="800" text-anchor="middle">GAIN: 10x MULTIPLIER</text>
      </g>

      <!-- Arrow from Central Hub to Tongue Output -->
      <path d="M 775 235 L 825 235" fill="none" stroke="#f43f5e" stroke-width="4" stroke-linecap="round" marker-end="url(#arrow)" />
      <polygon points="825,230 837,235 825,240" fill="#f43f5e" />

      <!-- 4. FINAL OUTPUT BOX: TONGUE BURNING (EXPONENTIAL 10/10) -->
      <g transform="translate(835, 135)">
        <rect width="105" height="200" rx="14" fill="#3b0724" stroke="#f43f5e" stroke-width="2.5" />
        <circle cx="52" cy="55" r="40" fill="url(#tongueBurnGlow)" />
        <text x="52" y="32" fill="#fda4af" font-size="10" font-weight="800" text-anchor="middle">PERCEIVED</text>
        <text x="52" y="48" fill="#fda4af" font-size="10" font-weight="800" text-anchor="middle">OUTPUT</text>
        <text x="52" y="78" fill="#ffffff" font-size="19" font-weight="900" text-anchor="middle">10/10</text>
        <text x="52" y="96" fill="#fecdd3" font-size="11" font-weight="800" text-anchor="middle">SCALD</text>

        <line x1="12" y1="110" x2="93" y2="110" stroke="#831843" stroke-width="1" />
        
        <text x="52" y="130" fill="#ffffff" font-size="9.5" font-weight="700" text-anchor="middle">Whole Tongue</text>
        <text x="52" y="145" fill="#fca5a5" font-size="8.5" text-anchor="middle">&amp; Hard Palate</text>
        <text x="52" y="165" fill="#f43f5e" font-size="8" font-weight="600" text-anchor="middle">Referred Pain</text>
        <text x="52" y="178" fill="#fda4af" font-size="8" font-weight="700" text-anchor="middle">Disinhibition</text>
      </g>
    </svg>
  </div>

  <!-- Explanatory Legend / Footnote Bar -->
  <div style="margin-top: 1.25rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.85rem;">
    <div style="background: #120a22; border: 1px solid #281647; border-radius: 8px; padding: 0.75rem 0.9rem; line-height: 1.45;">
      <div style="font-size: 0.78rem; font-weight: 700; color: #a855f7; margin-bottom: 0.2rem;">Parallel Faucets (Peripheral Input)</div>
      <div style="font-size: 0.8rem; color: #cbd5e1;">Five separate leaks add together arithmetically in the mouth. Cutting only 1 source leaves 90% of the raw sparks firing.</div>
    </div>
    <div style="background: #120a22; border: 1px solid #281647; border-radius: 8px; padding: 0.75rem 0.9rem; line-height: 1.45;">
      <div style="font-size: 0.78rem; font-weight: 700; color: #38bdf8; margin-bottom: 0.2rem;">The Nerve Trunk (V3 Bandwidth)</div>
      <div style="font-size: 0.8rem; color: #cbd5e1;">70,000 tightly packed axons. Overloaded unmyelinated fibers experience potassium accumulation, spilling tooth signals into the tongue.</div>
    </div>
    <div style="background: #120a22; border: 1px solid #281647; border-radius: 8px; padding: 0.75rem 0.9rem; line-height: 1.45;">
      <div style="font-size: 0.78rem; font-weight: 700; color: #f43f5e; margin-bottom: 0.2rem;">The Central Amplifier (Subnucleus Caudalis)</div>
      <div style="font-size: 0.8rem; color: #cbd5e1;">When 5 streams converge at once, astrocyte glutamate pumps saturate. The central gain locks at 10x, turning whispers into roaring fire.</div>
    </div>
  </div>

</div>

<script>
  // Interactive Simulation Controller
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.ctrl-btn');
    const nodes = document.querySelectorAll('.source-node');
    const streamLines = document.querySelectorAll('.stream-line');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.classList.remove('active');
          (b as HTMLElement).style.background = '#1a0f35';
          (b as HTMLElement).style.color = '#c084fc';
          (b as HTMLElement).style.borderColor = '#4c1d95';
        });
        btn.classList.add('active');
        (btn as HTMLElement).style.background = '#7c3aed';
        (btn as HTMLElement).style.color = '#ffffff';
        (btn as HTMLElement).style.borderColor = '#7c3aed';

        const mode = btn.getAttribute('data-source');

        if (mode === 'diet-only') {
          // Dim source 4, keep others active
          nodes.forEach(n => (n as HTMLElement).style.opacity = '1');
          streamLines.forEach(l => (l as HTMLElement).style.opacity = '1');
          
          const s4 = document.querySelector('.s4') as HTMLElement;
          const l4 = document.querySelector('.line-s4') as HTMLElement;
          if (s4) s4.style.opacity = '0.25';
          if (l4) l4.style.opacity = '0.25';
        } else if (mode === 'sealed') {
          // Dim sources 1, 2, 4
          nodes.forEach(n => (n as HTMLElement).style.opacity = '0.2');
          streamLines.forEach(l => (l as HTMLElement).style.opacity = '0.15');
        } else {
          // All active
          nodes.forEach(n => (n as HTMLElement).style.opacity = '1');
          streamLines.forEach(l => (l as HTMLElement).style.opacity = '1');
        }
      });
    });
  });
</script>

<style>
  @keyframes flowDash {
    to {
      stroke-dashoffset: -40;
    }
  }
  .anim-axon-flow {
    animation: flowDash 1.2s linear infinite;
  }
  .source-node {
    transition: opacity 0.3s ease;
  }
  .stream-line {
    transition: opacity 0.3s ease;
  }
</style>
