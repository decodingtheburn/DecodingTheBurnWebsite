					<button type="button" class="quiz-option-btn" data-val="female">
						<div class="option-header">
							<span class="your-answer-badge">Your Answer &rarr;</span>
							<span class="option-label">Female</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="male">
