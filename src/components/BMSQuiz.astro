							<span class="option-label">Mild. Baseline 1 to 3, spikes to 7-10 in&nbsp;flares.</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="mod-spike">
						<div class="option-header">
							<span class="your-answer-badge">Your Answer &rarr;</span>
							<span class="option-label">Moderate. Baseline 4 to 6, spikes to&nbsp;8-10.</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="severe-constant">
						<div class="option-header">
							<span class="your-answer-badge">Your Answer &rarr;</span>
							<span class="option-label">Severe. Constant high pain (7 to&nbsp;10).</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="variable">
						<div class="option-header">
							<span class="your-answer-badge">Your Answer &rarr;</span>
							<span class="option-label">Fluctuating. Varies with no clear&nbsp;baseline.</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
