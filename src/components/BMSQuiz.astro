---
// Interactive BMS Questionnaire Component - 7 Clinical Diagnostic Categories
// Designed for mature audiences (50+): 2x larger question emojis, Yes/No/Sometimes structured answers,
// darker orange buttons, dynamic width by longest item, clear "Your Answer ->" tag with red outline, and green/yellow/red color bands
---

<div class="bms-quiz-wrapper">
	<div class="quiz-header-banner">
		<p class="quiz-callout">
			<strong>Real-Time Anonymous BMS Community Research:</strong> Tap your answers below. Each response is immediately and anonymously saved to our central research database, instantly revealing how other BMS patients experience the same&nbsp;symptom.
		</p>
	</div>

	<div id="bms-quiz-container" class="quiz-container">
		<!-- Category 1 -->
		<div class="quiz-category-card">
			<h3 class="category-title">1. Pain Sensation</h3>
			
			<div class="quiz-item" data-qid="q1_sensation" data-multiselect="true">
				<div class="question-emoji" aria-hidden="true">🔥</div>
				<p class="quiz-question">What does the burning sensation feel&nbsp;like?</p>
				<p class="multiselect-hint">Select all that apply</p>
				<div class="quiz-options-list" role="group" aria-label="Sensation feeling">
					<button type="button" class="quiz-option-btn" data-val="scalding">
						<div class="option-header">
							<span class="your-answer-badge">Your Answer &rarr;</span>
							<span class="option-label">Scalding or Burning&nbsp;Heat</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="electric">
						<div class="option-header">
							<span class="your-answer-badge">Your Answer &rarr;</span>
							<span class="option-label">Electric Shock or&nbsp;Stabbing</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="dull-ache">
						<div class="option-header">
							<span class="your-answer-badge">Your Answer &rarr;</span>
							<span class="option-label">Dull Constant&nbsp;Ache</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="raw-hypersensitivity">
						<div class="option-header">
							<span class="your-answer-badge">Your Answer &rarr;</span>
							<span class="option-label">Raw Sandpaper&nbsp;Hypersensitivity</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="mixed">
						<div class="option-header">
							<span class="your-answer-badge">Your Answer &rarr;</span>
							<span class="option-label">Mixed or Fluctuating&nbsp;Sensations</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>

			<div class="quiz-item" data-qid="q2_daily_cycle">
				<div class="question-emoji" aria-hidden="true">⏰</div>
				<p class="quiz-question">Does your pain get worse as the day goes&nbsp;on?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Daily pain cycle">
					<button type="button" class="quiz-option-btn" data-val="builds-evening">
						<div class="option-header">
							<span class="your-answer-badge">Your Answer &rarr;</span>
							<span class="option-label">Yes. It starts mild and builds toward&nbsp;evening.</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="worse-morning">
						<div class="option-header">
							<span class="your-answer-badge">Your Answer &rarr;</span>
							<span class="option-label">No. It is worse upon waking in the&nbsp;morning.</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="constant">
