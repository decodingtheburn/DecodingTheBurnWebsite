							<span class="your-answer-badge">Your Answer &rarr;</span>
							<span class="option-label">No. Zero heartburn or gastrointestinal issues of any&nbsp;kind.</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="occasional-heartburn">
						<div class="option-header">
							<span class="your-answer-badge">Your Answer &rarr;</span>
							<span class="option-label">Sometimes. Occasional mild reflux after heavy or spicy meals.</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	import { db } from '../firebase.js';
	import { doc, getDoc, setDoc, increment, serverTimestamp } from 'firebase/firestore';

	document.addEventListener('DOMContentLoaded', () => {
		// Anonymous persistent user ID in localStorage
		let anonUserId = localStorage.getItem('bms_quiz_anon_uid');
		if (!anonUserId) {
			anonUserId = 'anon_' + Math.random().toString(36).substring(2, 11) + '_' + Date.now().toString(36);
			localStorage.setItem('bms_quiz_anon_uid', anonUserId);
		}

		// Cache for stored answers
		const getStoredAnswers = () => {
			try {
				return JSON.parse(localStorage.getItem('bms_quiz_answers') || '{}');
			} catch (e) {
				return {};
			}
		};

		const saveStoredAnswer = (qid, val) => {
			const answers = getStoredAnswers();
			answers[qid] = val;
			localStorage.setItem('bms_quiz_answers', JSON.stringify(answers));
		};

		// Helper to update visual stats for a question item
		const updateQuestionStatsUI = (item, selectedVal, statsData) => {
			const total = statsData?.total || 0;
			const optionsData = statsData?.options || {};
			const buttons = item.querySelectorAll('.quiz-option-btn');
			const feedback = item.querySelector('.quiz-item-feedback');
			const feedbackText = item.querySelector('.feedback-text');

			const selectedList = Array.isArray(selectedVal) 
				? selectedVal 
				: (selectedVal ? [selectedVal] : []);

			buttons.forEach(btn => {
				const val = btn.getAttribute('data-val');
				const isSelected = selectedList.includes(val);
				if (isSelected) {
					btn.classList.add('selected');
				} else {
					btn.classList.remove('selected');
				}

				const count = optionsData[val] || statsData?.[`options.${val}`] || 0;
				const pct = total > 0 ? Math.round((count / total) * 100) : 0;

				const pctSpan = btn.querySelector('.option-pct');
				const fillBar = btn.querySelector('.option-stat-fill');

				if (fillBar) {
					fillBar.style.width = `${pct}%`;
					fillBar.parentElement?.classList.add('visible');

					// Band color styling: Green (>=45%), Yellow (>=20%), Red (<20%)
					fillBar.classList.remove('band-green', 'band-yellow', 'band-red');
					if (pct >= 45) {
						fillBar.classList.add('band-green');
					} else if (pct >= 20) {
						fillBar.classList.add('band-yellow');
					} else {
						fillBar.classList.add('band-red');
					}
				}

				if (pctSpan) {
					pctSpan.textContent = `${pct}% (${count})`;
					pctSpan.classList.add('visible');
					pctSpan.classList.remove('band-green', 'band-yellow', 'band-red');
					if (pct >= 45) {
						pctSpan.classList.add('band-green');
					} else if (pct >= 20) {
						pctSpan.classList.add('band-yellow');
					} else {
						pctSpan.classList.add('band-red');
					}
				}
			});

			if (feedback && feedbackText) {
				feedbackText.textContent = `Saved anonymously • ${total} total patient ${total === 1 ? 'response' : 'responses'}`;
				feedback.classList.add('visible');
			}
		};

		// Initialize existing answered questions on load
		const savedAnswers = getStoredAnswers();
		const items = document.querySelectorAll('.quiz-item');

		items.forEach(item => {
			const qid = item.getAttribute('data-qid');
			const isMultiSelect = item.getAttribute('data-multiselect') === 'true';
			const savedVal = savedAnswers[qid];

			if (savedVal) {
				const selectedList = Array.isArray(savedVal) ? savedVal : [savedVal];
				selectedList.forEach(v => {
					const btn = item.querySelector(`.quiz-option-btn[data-val="${v}"]`);
					if (btn) btn.classList.add('selected');
				});

				// Fetch live stats from Firestore
				if (db && qid) {
					getDoc(doc(db, 'bms_quiz_stats', qid)).then(snap => {
						if (snap.exists()) {
							updateQuestionStatsUI(item, savedVal, snap.data());
						}
					}).catch(err => {
						console.error('Error fetching initial stats:', err);
					});
				}
			}

			// Add click listeners to option buttons
			const buttons = item.querySelectorAll('.quiz-option-btn');
			buttons.forEach(btn => {
				btn.addEventListener('click', async () => {
					const clickedVal = btn.getAttribute('data-val');
					const currentAnswers = getStoredAnswers();
					const statRef = doc(db, 'bms_quiz_stats', qid);
					const userRef = doc(db, 'bms_quiz_responses', anonUserId);

					if (isMultiSelect) {
						let currentSelected = Array.isArray(currentAnswers[qid]) 
							? [...currentAnswers[qid]] 
							: (currentAnswers[qid] ? [currentAnswers[qid]] : []);

						const isAlreadySelected = currentSelected.includes(clickedVal);
						let updates = {
							lastUpdated: serverTimestamp(),
							options: {}
						};

						if (isAlreadySelected) {
							// Deselecting option
							currentSelected = currentSelected.filter(v => v !== clickedVal);
							btn.classList.remove('selected');
							updates.options[clickedVal] = increment(-1);
							if (currentSelected.length === 0) {
								updates.total = increment(-1);
							}
						} else {
							// Selecting option
							if (currentSelected.length === 0) {
								updates.total = increment(1);
							}
							currentSelected.push(clickedVal);
							btn.classList.add('selected');
							updates.options[clickedVal] = increment(1);
						}

						saveStoredAnswer(qid, currentSelected);

						try {
							await Promise.all([
								setDoc(statRef, updates, { merge: true }),
								setDoc(userRef, {
									answers: {
										[qid]: currentSelected
									},
									updatedAt: serverTimestamp()
								}, { merge: true })
							]);

							const snap = await getDoc(statRef);
							if (snap.exists()) {
								updateQuestionStatsUI(item, currentSelected, snap.data());
							}
						} catch (err) {
							console.error('Error saving multi-select to Firebase:', err);
							updateQuestionStatsUI(item, currentSelected, {
								total: 1,
								options: { [clickedVal]: 1 }
							});
						}

					} else {
						// Single select
						const oldVal = currentAnswers[qid];
						if (oldVal === clickedVal) {
							return;
						}

						buttons.forEach(b => b.classList.remove('selected'));
						btn.classList.add('selected');
						saveStoredAnswer(qid, clickedVal);

						try {
							const updates = {
								total: increment(oldVal ? 0 : 1),
								lastUpdated: serverTimestamp(),
								options: {
									[clickedVal]: increment(1)
								}
							};
							if (oldVal) {
								updates.options[oldVal] = increment(-1);
							}

							await Promise.all([
								setDoc(statRef, updates, { merge: true }),
								setDoc(userRef, {
									answers: {
										[qid]: clickedVal
									},
									updatedAt: serverTimestamp()
								}, { merge: true })
							]);

							const snap = await getDoc(statRef);
							if (snap.exists()) {
								updateQuestionStatsUI(item, clickedVal, snap.data());
							}
						} catch (err) {
							console.error('Error saving single-select to Firebase:', err);
							updateQuestionStatsUI(item, clickedVal, {
								total: 1,
								options: { [clickedVal]: 1 }
							});
						}
					}
				});
			});
		});

		// Handle Textarea open-ended inputs (24-Hour Food & Drink Recall)
		const textItems = document.querySelectorAll('.quiz-text-item');
		const textDebounceTimers = {};

		textItems.forEach(item => {
			const qid = item.getAttribute('data-qid');
			const textarea = item.querySelector('.quiz-textarea-input');
			const feedback = item.querySelector('.quiz-item-feedback');
			const feedbackText = item.querySelector('.feedback-text');

			if (!textarea || !qid) return;

			// Restore saved text
			const savedText = savedAnswers[qid];
			if (savedText && typeof savedText === 'string') {
				textarea.value = savedText;
				if (feedback && feedbackText && savedText.trim().length > 0) {
					feedbackText.textContent = 'Saved to your anonymous profile';
					feedback.classList.add('visible');
				}
			}

			// Debounced autosave on input
			textarea.addEventListener('input', () => {
				const val = textarea.value;
				saveStoredAnswer(qid, val);

				if (feedback && feedbackText) {
					feedbackText.textContent = 'Saving...';
					feedback.classList.add('visible');
				}

				clearTimeout(textDebounceTimers[qid]);
				textDebounceTimers[qid] = setTimeout(async () => {
					const trimmed = val.trim();
					try {
						const userRef = doc(db, 'bms_quiz_responses', anonUserId);
						await setDoc(userRef, {
							answers: {
								[qid]: trimmed
							},
							updatedAt: serverTimestamp()
						}, { merge: true });

						if (feedback && feedbackText) {
							feedbackText.textContent = trimmed ? 'Saved anonymously' : '';
							if (!trimmed) feedback.classList.remove('visible');
						}
					} catch (err) {
						console.error('Error saving text input to Firebase:', err);
						if (feedback && feedbackText) {
							feedbackText.textContent = 'Saved locally';
						}
					}
				}, 750);
			});
		});
	});
</script>

