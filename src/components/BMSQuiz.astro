---
// Interactive BMS Questionnaire Component - 7 Clinical Diagnostic Categories
// Designed for mature audiences (50+): Large legible fonts, centered questions, vertically stacked options, 80% breakout container width
// Real-time Firestore submission with instant community statistics display
---

<div class="bms-quiz-wrapper">
	<div class="quiz-header-banner">
		<p class="quiz-callout">
			<strong>Real-Time Anonymous BMS Community Research:</strong> Tap your answers below. Each response is immediately and anonymously saved to our central research database, instantly revealing how other BMS patients experience the same&nbsp;symptom.
		</p>
	</div>

	<div id="bms-quiz-container" class="quiz-container">
		<!-- Category 1 -->
		<div class="quiz-category-card">
			<div class="category-emoji" aria-hidden="true">🔥</div>
			<h3 class="category-title">1. Pain Sensation</h3>
			
			<div class="quiz-item" data-qid="q1_sensation">
				<p class="quiz-question">What does the burning sensation feel&nbsp;like?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Sensation feeling">
					<button type="button" class="quiz-option-btn" data-val="scalding">
						<div class="option-header">
							<span class="option-label">Scalding or Burning Heat</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="electric">
						<div class="option-header">
							<span class="option-label">Electric Shock or Stabbing</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="dull-ache">
						<div class="option-header">
							<span class="option-label">Dull Constant Ache</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="raw-hypersensitivity">
						<div class="option-header">
							<span class="option-label">Raw Sandpaper Hypersensitivity</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="mixed">
						<div class="option-header">
							<span class="option-label">Mixed or Fluctuating Sensations</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>

			<div class="quiz-item" data-qid="q2_daily_cycle">
				<p class="quiz-question">Does your pain get worse as the day goes&nbsp;on?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Daily pain cycle">
					<button type="button" class="quiz-option-btn" data-val="builds-evening">
						<div class="option-header">
							<span class="option-label">Yes, starts mild and builds toward evening</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="worse-morning">
						<div class="option-header">
							<span class="option-label">Worse upon waking in the morning</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="constant">
						<div class="option-header">
							<span class="option-label">Constant intensity all day long</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="unpredictable">
						<div class="option-header">
							<span class="option-label">Random or unpredictable flares</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>

			<div class="quiz-item" data-qid="q3_night_waking">
				<p class="quiz-question">Does the burning wake you up from&nbsp;sleep?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Nighttime waking">
					<button type="button" class="quiz-option-btn" data-val="day-only">
						<div class="option-header">
							<span class="option-label">No, it only bothers me while awake</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="sometimes-wakes">
						<div class="option-header">
							<span class="option-label">Sometimes wakes me during the night</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="frequently-wakes">
						<div class="option-header">
							<span class="option-label">Frequently jolts me awake from sleep</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>

			<div class="quiz-item" data-qid="q4_intensity">
				<p class="quiz-question">How intense is your pain on a 0 to 10&nbsp;scale?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Pain intensity">
					<button type="button" class="quiz-option-btn" data-val="mild-spike">
						<div class="option-header">
							<span class="option-label">Mild baseline (1 to 3), spikes to 7-10 in flares</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="mod-spike">
						<div class="option-header">
							<span class="option-label">Moderate baseline (4 to 6), spikes to 8-10</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="severe-constant">
						<div class="option-header">
							<span class="option-label">Constant severe pain (7 to 10)</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="variable">
						<div class="option-header">
							<span class="option-label">Fluctuates with no clear baseline</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>
		</div>

		<!-- Category 2 -->
		<div class="quiz-category-card">
			<div class="category-emoji" aria-hidden="true">⚡</div>
			<h3 class="category-title">2. Pain Triggers</h3>

			<div class="quiz-item" data-qid="q5_flossing_spike">
				<p class="quiz-question">Does light brushing or flossing trigger sharp&nbsp;pain?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Flossing and brushing sensitivity">
					<button type="button" class="quiz-option-btn" data-val="sharp-spike">
						<div class="option-header">
							<span class="option-label">Yes, sharp shooting pain at gumline</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="mild-tender">
						<div class="option-header">
							<span class="option-label">Mild tender spot only</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="no-spike">
						<div class="option-header">
							<span class="option-label">No pain from brushing or flossing</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>

			<div class="quiz-item" data-qid="q6_temp_triggers">
				<p class="quiz-question">Do temperature changes (ice, hot drinks, cold air)&nbsp;hurt?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Temperature triggers">
					<button type="button" class="quiz-option-btn" data-val="sharp-cold">
						<div class="option-header">
							<span class="option-label">Ice water or cold drinks trigger pain</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="hot-liquids">
						<div class="option-header">
							<span class="option-label">Hot liquids trigger intense burning</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="cold-air">
						<div class="option-header">
							<span class="option-label">Breathing cold air triggers pain</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="no-temp">
						<div class="option-header">
							<span class="option-label">No temperature sensitivity</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>

			<div class="quiz-item" data-qid="q7_acid_triggers">
				<p class="quiz-question">Do acidic foods, citrus, or coffee trigger&nbsp;burning?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Acid triggers">
					<button type="button" class="quiz-option-btn" data-val="immediate">
						<div class="option-header">
							<span class="option-label">Stings immediately upon contact</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="delayed">
						<div class="option-header">
							<span class="option-label">Delayed flare 24 to 72 hours later</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="both">
						<div class="option-header">
							<span class="option-label">Both immediate stinging and delayed flares</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="neither">
						<div class="option-header">
							<span class="option-label">No reaction to acidic foods or drinks</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>

			<div class="quiz-item" data-qid="q8_chewing_pain">
				<p class="quiz-question">Does chewing or biting down firmly&nbsp;hurt?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Biting and chewing pain">
					<button type="button" class="quiz-option-btn" data-val="yes-bite">
						<div class="option-header">
							<span class="option-label">Yes, chewing or biting down hurts</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="mild-bite">
						<div class="option-header">
							<span class="option-label">Mild pressure ache when chewing</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="no-bite">
						<div class="option-header">
							<span class="option-label">No biting or chewing pain</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>
		</div>

		<!-- Category 3 -->
		<div class="quiz-category-card">
			<div class="category-emoji" aria-hidden="true">📍</div>
			<h3 class="category-title">3. Burning Location</h3>

			<div class="quiz-item" data-qid="q9_point_spread">
				<p class="quiz-question">Can you point to one tooth, or does it&nbsp;spread?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Location spread">
					<button type="button" class="quiz-option-btn" data-val="quadrant-spread">
						<div class="option-header">
							<span class="option-label">Spreads across palate, tongue, or entire gums</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="single-tooth">
						<div class="option-header">
							<span class="option-label">Localized to one or two specific teeth</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="shifts">
						<div class="option-header">
							<span class="option-label">Moves and shifts around my mouth</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>

			<div class="quiz-item" data-qid="q10_radiation">
				<p class="quiz-question">Does the burning spread into cheeks, nose, or&nbsp;ears?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Pain radiation">
					<button type="button" class="quiz-option-btn" data-val="radiates-deep">
						<div class="option-header">
							<span class="option-label">Yes, radiates to ear, cheek, or nose</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="mild-radiation">
						<div class="option-header">
							<span class="option-label">Occasionally radiates outward</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="no-radiation">
						<div class="option-header">
							<span class="option-label">Stays strictly inside the mouth</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>

			<div class="quiz-item" data-qid="q11_symmetry">
				<p class="quiz-question">Is the burning on one side only, or both&nbsp;sides?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Symmetry">
					<button type="button" class="quiz-option-btn" data-val="unilateral">
						<div class="option-header">
							<span class="option-label">One side only (unilateral)</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="bilateral">
						<div class="option-header">
							<span class="option-label">Both sides across the midline</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>
		</div>

		<!-- Category 4 -->
		<div class="quiz-category-card">
			<div class="category-emoji" aria-hidden="true">🦷</div>
			<h3 class="category-title">4. Jaw Clenching</h3>

			<div class="quiz-item" data-qid="q12_jaw_tightness">
				<p class="quiz-question">Do you wake up with tight or sore jaw&nbsp;muscles?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Morning jaw stiffness">
					<button type="button" class="quiz-option-btn" data-val="yes-tightness">
						<div class="option-header">
							<span class="option-label">Yes, morning jaw tightness or muscle fatigue</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="sometimes-tight">
						<div class="option-header">
							<span class="option-label">Sometimes or mild morning stiffness</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="no-tightness">
						<div class="option-header">
							<span class="option-label">No jaw tightness or morning stiffness</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>

			<div class="quiz-item" data-qid="q13_clenching_bruxism">
				<p class="quiz-question">Do you clench your teeth, grind at night, or brace your&nbsp;tongue?</p>
				<div class="quiz-options-list" role="radiogroup" aria-label="Bruxism habits">
					<button type="button" class="quiz-option-btn" data-val="yes-bruxism">
						<div class="option-header">
							<span class="option-label">Yes, clenching, night grinding, or tongue bracing</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="unaware">
						<div class="option-header">
							<span class="option-label">Not sure, but likely clenching during sleep</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
					<button type="button" class="quiz-option-btn" data-val="no-bruxism">
						<div class="option-header">
							<span class="option-label">No teeth grinding or tongue bracing</span>
							<span class="option-pct"></span>
						</div>
						<div class="option-stat-bar">
							<div class="option-stat-fill"></div>
						</div>
					</button>
				</div>
				<div class="quiz-item-feedback">
					<span class="feedback-pulse"></span>
					<span class="feedback-text"></span>
				</div>
			</div>

			<div class="quiz-item" data-qid="q14_tmj_clicking">
				<p class="quiz-question">Does your jaw joint (TMJ) click or pop when&nbsp;chewing?</p>
