---
import TongueLogo from './TongueLogo.astro';

export interface Slide {
	id: number;
	badge: string;
	title: string;
	bullets: string[];
	notes?: string;
}

interface Props {
	slides?: Slide[];
	isStandalone?: boolean;
}

const defaultSlides: Slide[] = [
	{
		id: 1,
		badge: "Presenter Setup",
		title: "Presenter Guide & Quick Controls",
		bullets: [
			"Spacebar or Left-Click or [→] : Advance to next bullet point",
			"Shift + Spacebar or Right-Click or [←] : Step backward to previous point",
			"[↓] / Page Down : Jump directly to next slide",
			"[↑] / Page Up : Jump directly to previous slide",
			"[F] key : Toggle Fullscreen (Clean OBS Recording Mode)",
			"[?] or [H] key : Open / close this quick shortcuts guide anytime",
			"Ready to record? Hit Spacebar to reveal Slide 2 and begin"
		],
		notes: "Introductory slide showing all shortcuts. Hit spacebar to start recording."
	},
	{
		id: 2,
		badge: "Title Slide",
		title: "How I Solved My Burning Mouth Syndrome (BMS)",
		bullets: [
			"An engineer's forensic journey from 10/10 agony to 9 months of full remission",
			"Beyond 'idiopathic': moving from symptom suppression to root cause debugging",
			"The two critical triggers: dental hardware flaws and dietary proton fuel",
			"By Dennis Ethier • DecodingTheBurn.com"
		],
		notes: "Introduce yourself, the site, and the central theme of forensic engineering."
	},
	{
		id: 3,
		badge: "Introduction",
		title: "Why I Am Sharing My Story",
		bullets: [
			"Hey, my name is Dennis. BMS affects thousands, but real solutions are rarely shared",
			"I know this might not work for everyone, but my remission is 100% real",
			"Inspired by author Peggy Shaw, who solved her oral burning through dental restoration removal",
			"Documenting my research on YouTube and my blog first before writing the full book",
			"Today, self-publishing and sharing medical forensics is more accessible than ever"
		],
		notes: "Dennis's recorded intro! Mention Peggy Shaw's book and the plan to write a book."
	},
	{
		id: 4,
		badge: "The Onset",
		title: "The Onset of Pain: How the Fire Started",
		bullets: [
			"The pain began gradually: subtle, intermittent tingling along gums and upper lip",
			"Over time, the intermittent burning locked in: constant, exhausting oral heat",
			"Spiked into an agonizing 10 out of 10 mechanical pain during daily flossing",
			"Standard doctors called it 'idiopathic' (unknown cause) and advised living with it",
			"Refused to accept that it was in my head: treated my body as a system to debug"
		],
		notes: "Describe the transition from subtle tingle to debilitating allodynia."
	},
	{
		id: 5,
		badge: "Dietary Discovery",
		title: "The Dietary Breakthrough: No-Sugar, No-Acid",
		bullets: [
			"Realized that everyday 'healthy' foods were acting as high-octane fuel for oral nerves",
			"Shifted from standard foods to a strict zero-acid, zero-sugar elimination protocol",
			"Why fruits and vegetables burned: acidic protons (H+) triggering ASIC and TRPV1 channels",
			"100% Carnivore / Paleolithic Ketogenic diet: pasture meat, animal fat, water, and salt",
			"Result: Rapid, dramatic calming of oral burning and systemic gut inflammation"
		],
		notes: "Explain why fruits and veggies burned (protons/ASIC) and how carnivore cut the fuel."
	},
	{
		id: 6,
		badge: "Dental Hardware",
		title: "Dental Hardware: Uncovering the Mechanical Sparks",
		bullets: [
			"Diet stopped the fuel, but what physical damage ignited the nerve in the first place?",
			"Four cervical composite resin patches: overhanging margins trapping chronic biofilm",
			"Tooth 36: An old crown concealing three deep active cavities missed on standard 2D x-rays",
			"Mechanical friction and chemical resin hydrolysis delivering galvanic micro-currents to the pulp",
			"Resolving the hardware: removing defective patches and replacing the infected crown"
		],
		notes: "Show that tooth 36 and composite patches were the physical fire starters."
	},
	{
		id: 7,
		badge: "Biophysics",
		title: "The Biophysics: The Gut-Trigeminal Axis",
		bullets: [
			"Connective tissue vulnerability: past vegetarian years weakened collagen and fascia",
			"Leaky gut barrier allowing bacterial endotoxins (LPS) into systemic blood circulation",
			"Circulating endotoxins sensitized the trigeminal ganglion (V2-V3), lowering pain thresholds",
			"Dual repair: seal the gut barrier with animal nutrition and fix the dental hardware",
			"Complete remission achieved: 9 continuous months of zero burning and normal flossing"
		],
		notes: "Connect the hernia, gut permeability, and trigeminal nerve sensitization."
	},
	{
		id: 8,
		badge: "The Roadmap",
		title: "The Roadmap: Documenting the Recovery Blueprint",
		bullets: [
			"Launching this YouTube video series to break down the science step by step",
			"Publishing free diagnostic checklists on DecodingTheBurn.com for dentist and doctor visits",
			"Preparing the upcoming book to give BMS sufferers a complete forensic recovery manual",
			"Empowering patients: you are the lead investigator of your own health",
			"Don't give up hope: intractable pain has physical causes that can be solved"
		],
		notes: "Wrap up with call to action: subscribe, visit blog, download checklists."
	}
];

const { slides = defaultSlides, isStandalone = false } = Astro.props;
---

<div class={`deck-wrapper ${isStandalone ? 'standalone-mode' : 'embedded-mode'}`} id="bms-slide-deck">
	<!-- Top Toolbar (for embedded view) -->
	{!isStandalone && (
		<div class="deck-top-bar">
			<div class="deck-title-group">
				<span class="deck-live-badge">INTERACTIVE PRESENTATION</span>
				<span class="deck-meta">8 Slides • OBS Ready • Fullscreen Mode</span>
			</div>
			<div class="deck-actions">
				<a href="/presentation/how-i-solved-my-bms" target="_blank" class="deck-btn deck-btn-outline" title="Open Clean Presenter Window for OBS">
					<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
					<span>Open OBS Window</span>
				</a>
				<button type="button" class="deck-btn deck-btn-primary toggle-fullscreen-btn" title="Toggle Fullscreen Presenter Mode (F)">
					<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
					<span>Fullscreen [F]</span>
				</button>
			</div>
		</div>
	)}

	<!-- Main 16:9 Presentation Stage -->
	<div class="slide-stage-container" id="slide-stage-container" tabindex="0">
		<div class="slide-stage" id="slide-stage">
			<!-- Slide Header -->
			<div class="slide-stage-header">
				<div class="slide-badge-box">
					<span class="slide-counter-badge" id="slide-counter-badge">SLIDE 01 / 08</span>
					<span class="slide-topic-badge" id="slide-topic-badge">Presenter Setup</span>
				</div>
				<div class="slide-brand">
					<div class="brand-logo-mini">
						<TongueLogo />
					</div>
					<span class="brand-text">Decoding The Burn</span>
				</div>
			</div>

			<!-- Slide Dynamic Content -->
			<div class="slide-body">
				<h2 class="slide-title" id="slide-title">Presenter Guide & Quick Controls</h2>
				
				<ul class="slide-bullets" id="slide-bullets">
					<!-- Generated dynamically by script -->
				</ul>
			</div>

			<!-- Slide Footer & Controls -->
			<div class="slide-stage-footer">
				<div class="footer-left">
					<span class="point-counter" id="point-counter">Point 1 of 7</span>
					<span class="footer-hint">Press <kbd>Spacebar</kbd> to advance</span>
				</div>
				<div class="footer-center">
					<button type="button" class="nav-control-btn prev-point-btn" id="prev-point-btn" title="Previous Point (Shift+Space or ←)">
						<svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="15 18 9 12 15 6"></polyline></svg>
					</button>
					<div class="slide-dots-container" id="slide-dots-container">
						<!-- Dots generated dynamically -->
					</div>
					<button type="button" class="nav-control-btn next-point-btn" id="next-point-btn" title="Next Point (Spacebar or →)">
						<svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="9 18 15 12 9 6"></polyline></svg>
					</button>
				</div>
				<div class="footer-right">
					<button type="button" class="stage-icon-btn help-btn" id="help-btn" title="Help / Keyboard Shortcuts (?)">
						<span class="help-question-mark">?</span>
					</button>
					<button type="button" class="stage-icon-btn toggle-fullscreen-btn" title="Fullscreen Presenter Mode (F)">
						<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
					</button>
				</div>
			</div>

			<!-- Help Modal Overlay -->
			<div class="help-modal-overlay" id="help-modal-overlay">
				<div class="help-modal-card">
					<div class="help-modal-header">
						<div class="help-modal-title">
							<span class="help-badge">?</span>
							<h3>Presenter Shortcuts & Controls</h3>
						</div>
						<button type="button" class="help-close-btn" id="help-close-btn">&times;</button>
					</div>
					<div class="help-grid">
						<div class="help-row">
							<span class="help-action">Next bullet point</span>
							<div class="help-keys">
								<kbd>Spacebar</kbd> <kbd>→</kbd> <kbd>Left-Click</kbd>
							</div>
						</div>
						<div class="help-row">
							<span class="help-action">Previous bullet point</span>
							<div class="help-keys">
								<kbd>Shift+Space</kbd> <kbd>←</kbd> <kbd>Right-Click</kbd>
							</div>
						</div>
						<div class="help-row">
							<span class="help-action">Jump to next slide</span>
							<div class="help-keys">
								<kbd>↓</kbd> <kbd>PageDown</kbd>
							</div>
						</div>
						<div class="help-row">
							<span class="help-action">Jump to previous slide</span>
							<div class="help-keys">
								<kbd>↑</kbd> <kbd>PageUp</kbd>
							</div>
						</div>
						<div class="help-row">
							<span class="help-action">Toggle Fullscreen (OBS Mode)</span>
							<div class="help-keys">
								<kbd>F</kbd>
							</div>
						</div>
						<div class="help-row">
							<span class="help-action">Toggle this shortcuts help</span>
							<div class="help-keys">
								<kbd>?</kbd> or <kbd>H</kbd>
							</div>
						</div>
					</div>
					<div class="help-note">
						<strong>OBS Pro-Tip:</strong> Press <kbd>F</kbd> for clean, borderless presentation during window capture or screen recording.
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- PowerPoint-Style Slide Thumbnail Rail (for Visitors & Dennis) -->
	<div class="thumbnail-preview-section">
		<div class="thumbnail-header">
			<h4>Slide Navigator (Click any slide to jump)</h4>
			<span class="thumbnail-count">8 Slides in this presentation</span>
		</div>
		<div class="thumbnail-strip" id="thumbnail-strip">
			{slides.map((s, idx) => (
				<button 
					type="button" 
					class={`thumb-card ${idx === 0 ? 'is-active' : ''}`}
					data-slide-index={idx}
					id={`thumb-btn-${idx}`}
				>
					<div class="thumb-screen">
						<div class="thumb-header">
							<span class="thumb-num">Slide {idx + 1}</span>
							<span class="thumb-badge">{s.badge}</span>
						</div>
						<div class="thumb-title">{s.title}</div>
						<div class="thumb-lines">
							<div class="thumb-line"></div>
							<div class="thumb-line short"></div>
						</div>
					</div>
				</button>
			))}
		</div>
	</div>
</div>

<!-- Slide Deck Client Script -->
<script define:vars={{ slides }}>
	(function () {
		let currentSlideIndex = 0;
		let currentPointIndex = 0;
		const totalSlides = slides.length;

		// DOM Elements
		const stageContainer = document.getElementById('slide-stage-container');
		const stage = document.getElementById('slide-stage');
		const titleEl = document.getElementById('slide-title');
		const bulletsContainer = document.getElementById('slide-bullets');
		const counterBadge = document.getElementById('slide-counter-badge');
		const topicBadge = document.getElementById('slide-topic-badge');
		const pointCounter = document.getElementById('point-counter');
		const dotsContainer = document.getElementById('slide-dots-container');
		const prevBtn = document.getElementById('prev-point-btn');
		const nextBtn = document.getElementById('next-point-btn');
		const helpBtn = document.getElementById('help-btn');
		const helpOverlay = document.getElementById('help-modal-overlay');
		const helpCloseBtn = document.getElementById('help-close-btn');
		const fullscreenBtns = document.querySelectorAll('.toggle-fullscreen-btn');

		// Render Dots
		function initDots() {
			if (!dotsContainer) return;
			dotsContainer.innerHTML = '';
			for (let i = 0; i < totalSlides; i++) {
				const dot = document.createElement('button');
				dot.type = 'button';
				dot.className = `slide-dot ${i === 0 ? 'is-active' : ''}`;
				dot.title = `Jump to slide ${i + 1}`;
				dot.addEventListener('click', (e) => {
					e.stopPropagation();
					jumpToSlide(i);
				});
				dotsContainer.appendChild(dot);
			}
		}

		// Update UI for Current Slide and Point
		function renderSlide() {
			const slide = slides[currentSlideIndex];
			if (!slide) return;

			// Header badges
			if (counterBadge) {
				const padSlide = String(currentSlideIndex + 1).padStart(2, '0');
				const padTotal = String(totalSlides).padStart(2, '0');
				counterBadge.textContent = `SLIDE ${padSlide} / ${padTotal}`;
			}
			if (topicBadge) {
				topicBadge.textContent = slide.badge || `Topic ${currentSlideIndex + 1}`;
			}

			// Title
			if (titleEl) {
				titleEl.textContent = slide.title;
			}

			// Bullets
			if (bulletsContainer) {
				bulletsContainer.innerHTML = '';
				slide.bullets.forEach((bulletText, bIdx) => {
					const li = document.createElement('li');
					li.className = 'bullet-item';

					if (bIdx === currentPointIndex) {
						li.classList.add('is-active');
					} else if (bIdx < currentPointIndex) {
						li.classList.add('is-revealed');
					} else {
						li.classList.add('is-dimmed');
					}

					li.innerHTML = `
						<span class="bullet-marker"></span>
						<span class="bullet-text">${bulletText}</span>
					`;
					
					li.addEventListener('click', (e) => {
						e.stopPropagation();
						currentPointIndex = bIdx;
						updateBulletClasses();
						updatePointCounter();
					});

					bulletsContainer.appendChild(li);
				});
			}

			updatePointCounter();
			updateThumbnailStrip();
			updateDots();
		}

		function updateBulletClasses() {
			if (!bulletsContainer) return;
			const items = bulletsContainer.querySelectorAll('.bullet-item');
			items.forEach((item, bIdx) => {
				item.classList.remove('is-active', 'is-revealed', 'is-dimmed');
				if (bIdx === currentPointIndex) {
					item.classList.add('is-active');
				} else if (bIdx < currentPointIndex) {
					item.classList.add('is-revealed');
				} else {
					item.classList.add('is-dimmed');
				}
			});
		}

		function updatePointCounter() {
			const slide = slides[currentSlideIndex];
			if (!slide || !pointCounter) return;
			pointCounter.textContent = `Point ${currentPointIndex + 1} of ${slide.bullets.length}`;
		}

		function updateDots() {
			if (!dotsContainer) return;
			const dots = dotsContainer.querySelectorAll('.slide-dot');
			dots.forEach((dot, idx) => {
				if (idx === currentSlideIndex) {
					dot.classList.add('is-active');
				} else {
					dot.classList.remove('is-active');
				}
			});
		}

		function updateThumbnailStrip() {
			const thumbs = document.querySelectorAll('.thumb-card');
			thumbs.forEach((thumb, idx) => {
				if (idx === currentSlideIndex) {
					thumb.classList.add('is-active');
					thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
				} else {
					thumb.classList.remove('is-active');
				}
			});
		}

		// Navigation logic
		function nextStep() {
			const slide = slides[currentSlideIndex];
			if (!slide) return;

			if (currentPointIndex < slide.bullets.length - 1) {
				currentPointIndex++;
				updateBulletClasses();
				updatePointCounter();
			} else {
				// Advance to next slide
				if (currentSlideIndex < totalSlides - 1) {
					currentSlideIndex++;
					currentPointIndex = 0;
					renderSlide();
				}
			}
		}

		function prevStep() {
			if (currentPointIndex > 0) {
				currentPointIndex--;
				updateBulletClasses();
				updatePointCounter();
			} else {
				// Go back to previous slide
				if (currentSlideIndex > 0) {
					currentSlideIndex--;
					const prevSlide = slides[currentSlideIndex];
					currentPointIndex = prevSlide.bullets.length - 1;
					renderSlide();
				}
			}
		}

		function nextSlide() {
			if (currentSlideIndex < totalSlides - 1) {
				currentSlideIndex++;
				currentPointIndex = 0;
				renderSlide();
			}
		}

		function prevSlide() {
			if (currentSlideIndex > 0) {
				currentSlideIndex--;
				currentPointIndex = 0;
				renderSlide();
			}
		}

		function jumpToSlide(idx) {
			if (idx >= 0 && idx < totalSlides) {
				currentSlideIndex = idx;
				currentPointIndex = 0;
				renderSlide();
			}
		}

		// Toggle Fullscreen
		function toggleFullscreen() {
			const target = stageContainer || document.documentElement;
			if (!document.fullscreenElement) {
				if (target.requestFullscreen) {
					target.requestFullscreen();
				}
			} else {
				if (document.exitFullscreen) {
					document.exitFullscreen();
				}
			}
		}

		// Help Modal Toggle
		function toggleHelp(show) {
			if (!helpOverlay) return;
			if (typeof show === 'boolean') {
				helpOverlay.style.display = show ? 'flex' : 'none';
			} else {
				helpOverlay.style.display = helpOverlay.style.display === 'flex' ? 'none' : 'flex';
			}
		}

		// Event Listeners
		prevBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			prevStep();
		});

		nextBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			nextStep();
		});

		helpBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			toggleHelp();
		});

		helpCloseBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			toggleHelp(false);
		});

		helpOverlay?.addEventListener('click', (e) => {
			if (e.target === helpOverlay) {
				toggleHelp(false);
			}
		});

		fullscreenBtns.forEach((btn) => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				toggleFullscreen();
			});
		});

		// Thumbnail rail clicks
		document.querySelectorAll('.thumb-card').forEach((card) => {
			card.addEventListener('click', () => {
				const idx = parseInt(card.getAttribute('data-slide-index') || '0', 10);
				jumpToSlide(idx);
			});
		});

		// Mouse clicks on stage: Left-click advances, Right-click steps back
		stage?.addEventListener('click', (e) => {
			// Ignore clicks on control buttons or links
			if (e.target.closest('button') || e.target.closest('a') || e.target.closest('.help-modal-card')) return;
			nextStep();
		});

		stage?.addEventListener('contextmenu', (e) => {
			// Right-click steps back and prevents context menu
			e.preventDefault();
			prevStep();
		});

		stage?.addEventListener('auxclick', (e) => {
			// Middle-click toggles help
			if (e.button === 1) {
				e.preventDefault();
				toggleHelp();
			}
		});

		// Keyboard Navigation
		window.addEventListener('keydown', (e) => {
			// If focus is in an input or textarea, don't intercept
			if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) return;

			if (e.code === 'Space') {
				e.preventDefault();
				if (e.shiftKey) {
					prevStep();
				} else {
					nextStep();
				}
			} else if (e.code === 'ArrowRight') {
				e.preventDefault();
				nextStep();
			} else if (e.code === 'ArrowLeft') {
				e.preventDefault();
				prevStep();
			} else if (e.code === 'ArrowDown' || e.code === 'PageDown') {
				e.preventDefault();
				nextSlide();
			} else if (e.code === 'ArrowUp' || e.code === 'PageUp') {
				e.preventDefault();
				prevSlide();
			} else if (e.code === 'KeyF') {
				e.preventDefault();
				toggleFullscreen();
			} else if (e.code === 'KeyH' || e.key === '?') {
				e.preventDefault();
				toggleHelp();
			} else if (e.code === 'Escape') {
				toggleHelp(false);
			}
		});

		// Fullscreen state listener
		document.addEventListener('fullscreenchange', () => {
			if (document.fullscreenElement) {
				stageContainer?.classList.add('is-in-fullscreen');
			} else {
				stageContainer?.classList.remove('is-in-fullscreen');
			}
		});

		// Initialize
		initDots();
		renderSlide();
	})();
</script>

<style>
	/* Deck Outer Wrapper */
	.deck-wrapper {
		margin: 2.5rem 0 3.5rem 0;
		width: 100%;
		font-family: var(--font-body, system-ui, sans-serif);
	}

	.deck-wrapper.standalone-mode {
		margin: 0;
		padding: 0;
		width: 100vw;
		height: 100vh;
		background: #07090e;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		overflow: hidden;
	}

	/* Top Bar for Embedded View */
	.deck-top-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.85rem 1.25rem;
		background: #0f131a;
		border: 1px solid #1e2638;
		border-bottom: none;
		border-radius: 12px 12px 0 0;
	}

	.deck-title-group {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.deck-live-badge {
		font-size: 0.72rem;
		font-weight: 700;
