---
// YouTubeVideo.astro - Standardized full-width responsive YouTube video embed component
interface Props {
	id: string;
	title?: string;
	class?: string;
}

const { 
	id, 
	title = 'YouTube video player',
	class: className = '' 
} = Astro.props;
---

<div class={`video-responsive-container ${className}`}>
	<div class="video-responsive-ratio">
		<iframe 
			src={`https://www.youtube-nocookie.com/embed/${id}`} 
			title={title} 
			class="video-responsive-iframe"
			loading="lazy"
			allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
			allowfullscreen
		></iframe>
	</div>
</div>

<style>
.video-responsive-container {
	width: 100% !important;
	max-width: 100% !important;
	margin: 2.25rem 0 !important;
	box-sizing: border-box !important;
	display: block !important;
	clear: both !important;
}

.video-responsive-ratio {
	position: relative !important;
	width: 100% !important;
	padding-bottom: 56.25% !important; /* Strict 16:9 aspect ratio fallback */
	aspect-ratio: 16 / 9 !important;
	height: 0 !important;
	border-radius: 18px !important;
	overflow: hidden !important;
	background: #0f172a !important;
	border: 1px solid rgba(15, 23, 42, 0.12) !important;
	box-shadow: 0 16px 40px -10px rgba(15, 23, 42, 0.16) !important;
}

/* Modern browsers with aspect-ratio */
@supports (aspect-ratio: 16 / 9) {
	.video-responsive-ratio {
		height: auto !important;
		padding-bottom: 0 !important;
	}
}

.video-responsive-iframe {
	position: absolute !important;
	top: 0 !important;
	left: 0 !important;
	width: 100% !important;
	height: 100% !important;
	border: 0 !important;
	display: block !important;
}
</style>
