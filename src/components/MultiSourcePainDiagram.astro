---
// MultiSourcePainDiagram.astro
// Option 6: Burning Mouth Pain Attribution (Bilateral 3-Column Layout with Categorized Drawers)

interface Props {
  showNerveCards?: boolean;
  showPeripheralInputs?: boolean;
}

const { 
  showNerveCards = true, 
  showPeripheralInputs = true 
} = Astro.props;
---

<div class="pain-diagram-wrapper" style="width: 100%; max-width: 980px; margin: 2rem auto; font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;">
  <div id="v6" style="border: 1.5px solid #cbd5e1; box-shadow: 0 15px 40px rgba(15, 23, 42, 0.08);">
    <div class="version-title-bar" style="margin-bottom: 2rem;">
      <div>
        <h2 style="font-size: 1.6rem; font-weight: 850; color: #0f172a; letter-spacing: -0.015em;">Burning Mouth Pain Attribution</h2>
      </div>
      <span class="version-badge" style="background: #0f172a; font-size: 0.85rem; padding: 0.35rem 0.85rem;">Option 6</span>
    </div>

    <!-- 3-Column Grid: Left Card | Manikin Center | Right Card -->
    <div style="display: grid; grid-template-columns: 1fr 140px 1fr; gap: 0; align-items: start;">
      
      <!-- LEFT COLUMN: DENTAL ISSUES (TOP) & NERVOUS SYSTEM (BOTTOM) -->
      <div style="display: flex; flex-direction: column; gap: 2.25rem;">
        
        <!-- TOP LEFT: DENTAL ISSUES -->
        <div class="p-card" id="card-dental" style="border: 1.5px solid #e2e8f0; border-radius: 12px; display: flex; flex-direction: column; position: relative; overflow: hidden; padding: 0;">
          <!-- Header with light background (#f8fafc), 2x thinner pale purple icon -->
          <div style="display: flex; justify-content: space-between; align-items: center; height: 44px; padding: 0 1rem; background: #fdf4ff; border-bottom: none; position: relative;">
            <div class="p-card-title" style="font-size: 1.12rem; font-weight: 850; color: #0f172a; line-height: 1.2;">Top 3 Dental issues</div>
            <svg width="62" height="62" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; opacity: 0.85; transform: translateY(18px); position: relative; z-index: 10;">
              <path d="M12 2C7.5 2 4 4.5 4 8c0 3 1.5 5.5 2 8 .6 3 1.5 6 3 6s2.5-3 3-5c.5 2 1.5 5 3 5s2.4-3 3-6c.5-2.5 2-5 2-8 0-3.5-3.5-6-8-6z"/>
            </svg>
          </div>

          <!-- Body Content -->
          <div style="padding: 1rem 1.15rem; display: flex; flex-direction: column; gap: 0.45rem;">
            <div style="display: flex; align-items: center; gap: 0.45rem;">
              <span class="p-row-label">Marginal defect</span>
              <span class="p-badge-red" style="padding: 0.1rem 0.35rem; font-size: 0.72rem;">30%</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.45rem;">
              <span class="p-row-label">Exposed tubules</span>
              <span class="p-badge-amber" style="padding: 0.1rem 0.35rem; font-size: 0.72rem;">20%</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.45rem;">
              <span class="p-row-label">Canine occlusion</span>
              <span class="p-badge-red" style="padding: 0.1rem 0.35rem; font-size: 0.72rem;">20%</span>
            </div>
            
            <!-- See Top 20 Trigger (Same font & boldness as label, disappears on click) -->
            <div id="trigger-wrapper-dental" class="expand-toggle-btn" data-trigger="trigger-wrapper-dental" data-target="expand-dental" style="display: flex; align-items: center; gap: 0.45rem; cursor: pointer; user-select: none;">
                <span class="p-row-label">See More</span>
                <span style="font-size: 0.72rem; color: #64748b;">&#9660;</span>
              </div>

            <!-- Seamless Expandable Drawer (Same formatting & green 0% badges) -->
            <div id="expand-dental" class="expandable-drawer" style="display: none; flex-direction: column; gap: 0.45rem; margin-top: 0.15rem; border-top: 1px dashed #e9d5ff; padding-top: 0.65rem;">
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Subgingival biofilm fermentation</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Galvanic metal micro-currents</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Cervical enamel abfraction</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Traumatic premature occlusion</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Recurrent micro-cavities</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Endodontic root resorption</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Cracked tooth syndrome</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Acrylic monomer sensitivity</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Night bruxism micro-strain</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Foreign body cement impaction</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Root proximity to alveolar nerve</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Cavitational osteonecrosis</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Periodontal furcation defect</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Composite shrinkage gap</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Nickel-titanium retainer allergy</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Crown margin biological invasion</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Impacted wisdom molar load</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Maxillary sinusitis extension</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Pulp canal obliteration</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Improper pontic tissue pressure</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
              
              
            </div>
          </div>
        </div>

        <!-- BOTTOM LEFT: NERVOUS SYSTEM -->
        <div class="p-card" id="card-nervous" style="border: 1.5px solid #e2e8f0; border-radius: 12px; display: flex; flex-direction: column; position: relative; overflow: hidden; padding: 0;">
          <!-- Header with light background (#f8fafc), 2x thinner pale purple icon -->
          <div style="display: flex; justify-content: space-between; align-items: center; height: 44px; padding: 0 1rem; background: #fdf4ff; border-bottom: none; position: relative;">
            <div class="p-card-title" style="font-size: 1.12rem; font-weight: 850; color: #0f172a; line-height: 1.2;">Top 3 Nervous System</div>
            <svg width="62" height="62" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; opacity: 0.85; transform: translateY(18px); position: relative; z-index: 10;">
              <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-2.04Z"/>
              <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-2.04Z"/>
            </svg>
          </div>

          <!-- Body Content -->
          <div style="padding: 1rem 1.15rem; display: flex; flex-direction: column; gap: 0.45rem;">
            <div style="display: flex; align-items: center; gap: 0.45rem;">
              <span class="p-row-label">Trigeminal wind-up</span>
              <span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.45rem;">
              <span class="p-row-label">Small-fiber neuropathy</span>
              <span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.45rem;">
              <span class="p-row-label">Trunk compression</span>
              <span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span>
            </div>

            <!-- See Top 20 Trigger (Same font & boldness as label, disappears on click) -->
            <div id="trigger-wrapper-nervous" class="expand-toggle-btn" data-trigger="trigger-wrapper-nervous" data-target="expand-nervous" style="display: flex; align-items: center; gap: 0.45rem; cursor: pointer; user-select: none;">
                <span class="p-row-label">See More</span>
                <span style="font-size: 0.72rem; color: #64748b;">&#9660;</span>
              </div>

            <!-- Seamless Expandable Drawer (Same formatting & green 0% badges) -->
                        <!-- Seamless Expandable Drawer (Categorized Groups & green 0% badges) -->
            <div id="expand-nervous" class="expandable-drawer" style="display: none; flex-direction: column; gap: 0.65rem; margin-top: 0.35rem; border-top: 1px dashed #e9d5ff; padding-top: 0.65rem;">
              
              <!-- Subcategory 1: Central Wind-Up & Gating -->
              <div>
                <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #9333ea; margin-bottom: 0.3rem; font-weight: 800;">Central Amplification &amp; Wind-Up</div>
                <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Brainstem caudalis wind-up</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Loss of GABAergic inhibition</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Microglial neuro-inflammation</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Taste-mediated gating failure</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Thalamocortical pain loop</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Central sensitization inventory</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                </div>
              </div>

              <!-- Subcategory 2: Ion Channels & Peripheral Neuropathy -->
              <div>
                <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #9333ea; margin-bottom: 0.3rem; font-weight: 800;">Sensory Channels &amp; Autonomic</div>
                <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Sustained ASIC3 channel firing</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Tactile-to-burning allodynia</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Sympathetic-sensory coupling</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Neurogenic plasma extravasation</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Lingual capillary ischemia</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">REM sleep disinhibition</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                </div>
              </div>

              <!-- Subcategory 3: Cranial & Cervical Compression -->
              <div>
                <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #9333ea; margin-bottom: 0.3rem; font-weight: 800;">Cranial Nerves &amp; Spine Entrapment</div>
                <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">C1–C3 cervical spine entrapment</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Occipital nerve compression</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Sphenopalatine ganglion neuralgia</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Glossopharyngeal cross-talk</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Superior laryngeal nerve input</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Myofascial trigger point referral</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Post-herpetic trigeminal injury</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                  <div style="display: flex; align-items: center; gap: 0.45rem;"><span class="p-row-label">Acoustic stapedial coupling</span><span style="background: #22c55e; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 4px;">0%</span></div>
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>

      <!-- CENTER: TRANSPARENT MEDICAL HUMAN WITH LIGHT GREY MULTI-TARGET ARROWS -->
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: 0; position: relative;">
        <!-- Height matches the cards layout, viewBox width = 140. Left edge = 0, Right edge = 140 -->
        <svg viewBox="0 0 140 450" style="width: 100%; height: auto; display: block;" aria-label="Anatomical female figure with subtle dotted arrows">
          <defs>
            <!-- Very Light Subtle Grey Dotted Arrowheads (#cbd5e1) -->
            <marker id="arrow-grey-left" viewBox="0 0 10 10" refX="2" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto-start-reverse">
              <path d="M 10 1.5 L 0 5 L 10 8.5 z" fill="#cbd5e1" />
            </marker>
            <marker id="arrow-grey-right" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="4.5" markerHeight="4.5" orient="auto">
              <path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#cbd5e1" />
            </marker>
          </defs>

                    <!-- Head & Facial Features (Clean, Friendly, Non-Creepy) -->
          <ellipse cx="70" cy="38" rx="13" ry="17" fill="#ffffff" stroke="#64748b" stroke-width="2.2" />
          <!-- Eyes -->
          <circle cx="65.5" cy="34" r="1.3" fill="#64748b" />
          <circle cx="74.5" cy="34" r="1.3" fill="#64748b" />
          <!-- Nose -->
          <path d="M 70 36.5 L 70 39.5 L 71.5 40.5" fill="none" stroke="#94a3b8" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" />
          <!-- Friendly Mouth -->
          <path d="M 66.5 44 Q 70 46.5 73.5 44" fill="none" stroke="#dc2626" stroke-width="1.3" stroke-linecap="round" />

          <!-- Body Silhouette with Natural Hands -->
          <path d="M 64 54 
                   C 64 64 58 70 46 78 
                   C 38 83 34 102 32 135 
                   C 30 162 29 188 29 200 
                   C 29 208 33 214 36 214 
                   C 39 214 42 208 43 198 
                   L 44 190 
                   C 47 165 48 135 50 115 
                   C 52 125 54 142 53 162 
                   C 52 180 50 205 48 230 
                   C 46 258 49 285 52 305 
                   L 55 400 
                   C 56 408 63 408 64 400 
                   L 68 300 
                   C 69 280 70 275 70 275 
                   C 70 275 71 280 72 300 
                   L 76 400 
                   C 77 408 84 408 85 400 
                   L 88 305 
                   C 91 285 94 258 92 230 
                   C 90 205 88 180 87 162 
                   C 86 142 88 125 90 115 
                   C 92 135 93 165 96 190 
                   L 97 198 
                   C 98 208 101 214 104 214 
                   C 107 214 111 208 111 200 
                   C 111 188 110 162 108 135 
                   C 106 102 102 83 94 78 
                   C 82 70 76 64 76 54 Z" 
                fill="#ffffff" stroke="#64748b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />

          <!-- STRICT ORTHOGONAL (NON-DIAGONAL) CONNECTOR LINES -->
          
          <!-- 1. BRAIN FOCAL POINT (Upper Cranium Y=27) -> Nervous System (Bottom Left: X=0, Y=240) -->
          <!-- Path: Horizontal Left -> Vertical Down outside body -> Horizontal Left to card -->
          <circle cx="70" cy="27" r="3.2" fill="#9333ea" />
          <polyline points="70,27 15,27 15,240 0,240" fill="none" stroke="#cbd5e1" stroke-width="1.25" stroke-dasharray="3,3" marker-end="url(#arrow-grey-left)" stroke-linecap="round" stroke-linejoin="round"/>

          <!-- 2. MOUTH FOCAL POINT (Y=44) -->
