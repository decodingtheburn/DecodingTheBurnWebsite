---
// MultiSourcePainDiagram.astro
// Clean, focused visual diagram illustrating peripheral multi-source pain convergence into the trigeminal system.
// Strictly compliant with the 3 to 4 word title standard: No colons, no ampersands, no hyphens/dashes.
// Features clean, transparent badges (max 3 words) with color-coded severity:
// Red = High pain, Yellow = Medium pain, Green = Mild pain.
---

<div class="multi-source-pain-container tts-ignore" style="margin: 2.25rem 0 2.75rem; background: #070312; border: 1.5px solid #3b1d6e; border-radius: 16px; padding: 1.75rem; box-shadow: 0 16px 45px -10px rgba(0, 0, 0, 0.8); color: #f8fafc;">
  
  <!-- Header (Strict 3-4 Word Titles) -->
  <div style="margin-bottom: 1.25rem; border-bottom: 1px solid #1e1338; padding-bottom: 1rem;">
    <div style="font-size: 0.76rem; font-weight: 800; color: #a855f7; text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.35; margin-bottom: 0.25rem;">
      Peripheral Drive
    </div>
    <div style="font-size: 1.35rem; font-weight: 900; color: #ffffff; line-height: 1.38; margin-bottom: 0.45rem;">
      Multi-Source Pain Convergence
    </div>
    <p style="font-size: 0.9rem; color: #94a3b8; line-height: 1.55; margin: 0; max-width: 820px; text-wrap: balance;">
      Peripheral inputs converge into the trigeminal network. Color-coded by severity: red marks severe primary drivers, yellow marks moderate triggers, and green marks modulating autonomic&nbsp;tension.
    </p>
  </div>

  <!-- Medical Visual Viewport with Clean Overlay Badges -->
  <div style="position: relative; width: 100%; border-radius: 14px; overflow: hidden; background: #030108; border: 1px solid #281447; display: flex; justify-content: center; align-items: center; min-height: 540px;">
    
    <!-- Base Medical Render (Skull profile showing brain, nucleus hub, trunk, and mouth) -->
    <img 
      src="/trigeminal-v2-v3-nerves-real.jpg" 
      alt="3D medical render mapping brain cortex, subnucleus caudalis hub, trigeminal trunks, and multi-source oral inputs" 
      style="width: 100%; max-width: 860px; height: auto; max-height: 640px; object-fit: contain; object-position: center; display: block; opacity: 0.92; filter: contrast(1.15) brightness(0.96);"
      loading="lazy"
    />

    <!-- SVG Clean Badges & Connecting Lines Overlay -->
    <svg viewBox="0 0 1000 640" style="position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;" xmlns="http://www.w3.org/2000/svg">
      
      <!-- TOP: BRAIN / CORTEX -->
      <g>
        <circle cx="510" cy="95" r="5" fill="#f43f5e" />
        <line x1="510" y1="95" x2="600" y2="75" stroke="#f43f5e" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
        <!-- Badge: Sensory Brain Hub -->
        <text x="610" y="79" fill="#f43f5e" font-size="14" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.02em">
          Brain Cortex
        </text>
      </g>

      <!-- MIDDLE: NUCLEUS HUB & TRUNK CAPACITY -->
      <g>
        <!-- Nucleus (Subnucleus Caudalis) -->
        <circle cx="535" cy="275" r="6" fill="#f43f5e" />
        <line x1="535" y1="275" x2="640" y2="250" stroke="#f43f5e" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
        <text x="650" y="254" fill="#f43f5e" font-size="14" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.02em">
          Subnucleus Caudalis
        </text>

        <!-- Trunk Capacity -->
        <circle cx="490" cy="340" r="5" fill="#eab308" />
        <line x1="490" y1="340" x2="350" y2="300" stroke="#eab308" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.8" />
        <text x="340" y="304" text-anchor="end" fill="#eab308" font-size="14" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.02em">
          Trunk Capacity
        </text>
      </g>

      <!-- MOUTH INTERNAL SOURCES (COLOR CODED) -->
      <!-- 1. Leaky margin, 30% (RED - severe) -->
      <g>
        <circle cx="460" cy="420" r="5" fill="#ef4444" />
        <line x1="460" y1="420" x2="330" y2="400" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.85" />
        <text x="320" y="404" text-anchor="end" fill="#ef4444" font-size="14.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.02em">
          Leaky margin, 30%
        </text>
      </g>

      <!-- 2. Exposed tubules, 10% (YELLOW - medium) -->
      <g>
        <circle cx="400" cy="455" r="5" fill="#eab308" />
        <line x1="400" y1="455" x2="280" y2="465" stroke="#eab308" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.85" />
        <text x="270" y="469" text-anchor="end" fill="#eab308" font-size="14.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.02em">
          Exposed tubules, 10%
        </text>
      </g>

      <!-- 3. Lack of saliva, 30% (RED - severe) -->
      <g>
        <circle cx="430" cy="485" r="5" fill="#ef4444" />
        <line x1="430" y1="485" x2="560" y2="500" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.85" />
        <text x="570" y="504" fill="#ef4444" font-size="14.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.02em">
          Lack of saliva, 30%
        </text>
      </g>

      <!-- EXTERNAL SOURCES (SIDE PLACEMENT WITH ICONIC SYMBOLS) -->
      <!-- 4. External acid (Glass of soda / drink icon outside mouth), 30% (RED - severe) -->
      <g>
        <!-- Minimalist glass outline outside mouth -->
        <path d="M 60 415 L 75 455 Q 78 460, 83 460 L 97 460 Q 102 460, 105 455 L 120 415 Z" fill="none" stroke="#ef4444" stroke-width="1.8" />
        <!-- Liquid level -->
        <path d="M 68 428 Q 90 425, 112 428" fill="none" stroke="#ef4444" stroke-width="1.2" opacity="0.75" />
        <!-- Straw -->
        <line x1="94" y1="402" x2="85" y2="450" stroke="#ef4444" stroke-width="1.6" />
        
        <!-- Connecting indicator -->
        <line x1="125" y1="435" x2="160" y2="435" stroke="#ef4444" stroke-width="1.5" opacity="0.6" />
        <text x="135" y="420" fill="#ef4444" font-size="14.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.02em">
          External acid, 30%
        </text>
      </g>

      <!-- 5. Chronic stress, 10% (GREEN - mild/modulating autonomic) -->
      <g>
        <!-- Subtle pulse wave icon for stress / autonomic drive -->
        <path d="M 65 345 L 80 345 L 85 332 L 92 356 L 98 338 L 103 345 L 118 345" fill="none" stroke="#22c55e" stroke-width="1.8" />
        <text x="135" y="348" fill="#22c55e" font-size="14.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.02em">
          Chronic stress, 10%
        </text>
      </g>

    </svg>

  </div>

</div>
