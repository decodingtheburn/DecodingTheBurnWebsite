---
// MultiSourcePainDiagram.astro
// Clean, focused visual diagram illustrating peripheral multi-source pain inputs into the trigeminal system.
// Strictly compliant with the 3 to 4 word title standard: No colons, no ampersands, no hyphens/dashes.
// Base image: /trigeminal-v2-v3-nerves-with-nucleus.jpg (with Subnucleus Caudalis accurately rendered along the brainstem tract).
// Left side:
// - "Dental Issues" and "Other Triggers" headers 1.6x larger (21px), clean bold text without decorative dashes/lines.
// - Badges color-coded: 30% and 20% in Red (#ef4444), 10% in Yellow (#eab308).
// - Dividing line between Dental Issues and Other Triggers.
// - Other Triggers includes examples: Gastric acid, Lack of saliva, and Chronic stress (10% each).
// Right side:
// - Column title: "Nerve Capacity".
// - Subnucleus Caudalis, V1, V2, V3 all fully CLICKABLE with interactive popup modal showing all sub-branches and central connections.
---

<div class="multi-source-pain-container tts-ignore" style="margin: 2.25rem 0 2.75rem; background: #070312; border: 1.5px solid #3b1d6e; border-radius: 16px; padding: 1.75rem; box-shadow: 0 16px 45px -10px rgba(0, 0, 0, 0.8); color: #f8fafc; position: relative;">
  
  <!-- Header (Strict 3-4 Word Titles) -->
  <div style="margin-bottom: 1.25rem; border-bottom: 1px solid #1e1338; padding-bottom: 1rem;">
    <div style="font-size: 0.76rem; font-weight: 800; color: #a855f7; text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.35; margin-bottom: 0.25rem;">
      Peripheral Drive
    </div>
    <div style="font-size: 1.35rem; font-weight: 900; color: #ffffff; line-height: 1.38; margin-bottom: 0.45rem;">
      Multi-Source Pain Stacking
    </div>
    <p style="font-size: 0.9rem; color: #94a3b8; line-height: 1.55; margin: 0; max-width: 820px; text-wrap: balance;">
      Left-aligned peripheral sources grouped by Dental Issues and Other Triggers, totaling 100% of sensory input. Right-aligned specifications detail trunk carrying capacity in axon&nbsp;volume. Click any right-side branch to explore its sub-branches.
    </p>
  </div>

  <!-- Medical Visual Viewport with Generous Dark Margins -->
  <div style="position: relative; width: 100%; border-radius: 14px; overflow: hidden; background: #020005; border: 1px solid #281447; display: flex; justify-content: center; align-items: center; min-height: 610px; padding: 1.5rem 0;">
    
    <!-- Base Medical Render with Glowing Red Subnucleus Caudalis in Brainstem -->
    <img 
      src="/trigeminal-v2-v3-nerves-with-nucleus.jpg" 
      alt="3D medical render mapping trigeminal nerve trunks V1 V2 V3, glowing red Subnucleus Caudalis hub in brainstem, and oral inputs" 
      style="width: 68%; max-width: 760px; height: auto; max-height: 610px; object-fit: contain; object-position: center; display: block; opacity: 0.90; filter: contrast(1.15) brightness(0.96);"
      loading="lazy"
    />

    <!-- SVG Clean Labels & Solid White Straight Connecting Lines Overlay (1200 x 640 viewBox) -->
    <svg viewBox="0 0 1200 640" style="position: absolute; inset: 0; width: 100%; height: 100%;" xmlns="http://www.w3.org/2000/svg">
      
      <!-- ============================================================ -->
      <!-- LEFT SIDE: GROUP 1 - DENTAL ISSUES (CLEAN, NO DASHES)        -->
      <!-- ============================================================ -->

      <!-- Group Category Title: Dental Issues (1.6x size = 21px, clean typography) -->
      <g>
        <text x="50" y="154" fill="#e9d5ff" font-size="21" font-weight="900" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.04em">
          Dental Issues
        </text>
      </g>

      <!-- 1. Leaky margin, 30% (RED - high severity, Y=195) -->
      <g>
        <line x1="305" y1="195" x2="550" y2="310" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="550" cy="310" r="4.5" fill="#ef4444" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="200" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Leaky margin
        </text>
        <rect x="240" y="183" width="56" height="23" rx="4" fill="#ef4444" stroke="#b91c1c" stroke-width="1" />
        <text x="268" y="200" text-anchor="middle" fill="#ffffff" font-size="13" font-weight="900" font-family="system-ui, -apple-system, sans-serif">
          30%
        </text>
      </g>

      <!-- 2. Canine occlusion, 20% (RED - high severity, Y=245) -->
      <g>
        <line x1="305" y1="245" x2="520" y2="375" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="520" cy="375" r="4.5" fill="#ef4444" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="250" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Canine occlusion
        </text>
        <rect x="240" y="233" width="56" height="23" rx="4" fill="#ef4444" stroke="#b91c1c" stroke-width="1" />
        <text x="268" y="250" text-anchor="middle" fill="#ffffff" font-size="13" font-weight="900" font-family="system-ui, -apple-system, sans-serif">
          20%
        </text>
      </g>

      <!-- 3. Exposed tubules, 20% (RED - high severity / moderate, Y=295) -->
      <g>
        <line x1="305" y1="295" x2="495" y2="425" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="495" cy="425" r="4.5" fill="#eab308" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="300" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Exposed tubules
        </text>
        <rect x="240" y="283" width="56" height="23" rx="4" fill="#eab308" stroke="#ca8a04" stroke-width="1" />
        <text x="268" y="300" text-anchor="middle" fill="#000000" font-size="13" font-weight="900" font-family="system-ui, -apple-system, sans-serif">
          20%
        </text>
      </g>

      <!-- DIVIDING SEPARATOR LINE -->
      <g>
        <line x1="50" y1="335" x2="296" y2="335" stroke="#334155" stroke-width="1.4" stroke-dasharray="4 3" opacity="0.8" />
      </g>

      <!-- ============================================================ -->
      <!-- LEFT SIDE: GROUP 2 - OTHER TRIGGERS (CLEAN, NO DASHES)       -->
      <!-- ============================================================ -->

      <!-- Group Category Title: Other Triggers (1.6x size = 21px, clean typography) -->
      <g>
        <text x="50" y="368" fill="#e0f2fe" font-size="21" font-weight="900" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.04em">
          Other Triggers
        </text>
      </g>

      <!-- 4. Gastric acid, 10% (YELLOW, Y=405) -->
      <g>
        <line x1="305" y1="405" x2="475" y2="475" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="475" cy="475" r="4.5" fill="#eab308" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="410" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Gastric acid
        </text>
        <rect x="240" y="393" width="56" height="23" rx="4" fill="#eab308" stroke="#ca8a04" stroke-width="1" />
        <text x="268" y="410" text-anchor="middle" fill="#000000" font-size="13" font-weight="900" font-family="system-ui, -apple-system, sans-serif">
          10%
        </text>
      </g>

      <!-- 5. Lack of saliva, 10% (YELLOW, Y=460) -->
      <g>
        <line x1="305" y1="460" x2="455" y2="520" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="455" cy="520" r="4.5" fill="#eab308" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="465" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Lack of saliva
        </text>
        <rect x="240" y="448" width="56" height="23" rx="4" fill="#eab308" stroke="#ca8a04" stroke-width="1" />
        <text x="268" y="465" text-anchor="middle" fill="#000000" font-size="13" font-weight="900" font-family="system-ui, -apple-system, sans-serif">
          10%
        </text>
      </g>

      <!-- 6. Chronic stress, 10% (YELLOW, Y=515, NO POINTER LINE) -->
      <g>
        <text x="50" y="520" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Chronic stress
        </text>
        <rect x="240" y="503" width="56" height="23" rx="4" fill="#eab308" stroke="#ca8a04" stroke-width="1" />
        <text x="268" y="520" text-anchor="middle" fill="#000000" font-size="13" font-weight="900" font-family="system-ui, -apple-system, sans-serif">
          10%
        </text>
      </g>

      <!-- ============================================================ -->
      <!-- RIGHT SIDE: CLICKABLE TARGETS FOR POPOVER MODALS             -->
      <!-- SUBNUCLEUS CAUDALIS (TOP), THEN V1, V2, V3                  -->
      <!-- ============================================================ -->

      <!-- Right Column Title Header -->
      <g>
        <text x="915" y="154" fill="#e0f2fe" font-size="21" font-weight="900" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.04em">
          Nerve Capacity
        </text>
        <text x="915" y="172" fill="#64748b" font-size="11.5" font-weight="600" font-family="system-ui, -apple-system, sans-serif">
          (Click any item for details)
        </text>
      </g>

      <!-- 1. Subnucleus Caudalis (CLICKABLE) -->
      <g class="interactive-nerve-target" data-branch="caudalis" style="cursor: pointer;">
        <line x1="685" y1="195" x2="895" y2="200" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="685" cy="195" r="6" fill="#ef4444" stroke="#ffffff" stroke-width="1.5" class="pulsing-hub" />

        <text x="915" y="195" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em" class="hover-glow">
          Subnucleus Caudalis &rsaquo;
        </text>
        <rect x="915" y="204" width="130" height="23" rx="4" fill="#1e293b" stroke="#64748b" stroke-width="1.2" class="btn-rect" />
        <text x="980" y="221" text-anchor="middle" fill="#e2e8f0" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          140,000 Axons
        </text>
      </g>

      <!-- 2. V1 Ophthalmic Branch (CLICKABLE) -->
      <g class="interactive-nerve-target" data-branch="v1" style="cursor: pointer;">
        <line x1="620" y1="240" x2="895" y2="285" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="620" cy="240" r="5" fill="#ffffff" stroke="#94a3b8" stroke-width="1.2" />

        <text x="915" y="280" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em" class="hover-glow">
          V1 Ophthalmic Branch &rsaquo;
        </text>
        <rect x="915" y="289" width="130" height="23" rx="4" fill="#1e293b" stroke="#475569" stroke-width="1.2" class="btn-rect" />
        <text x="980" y="306" text-anchor="middle" fill="#e2e8f0" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          25,000 Axons
        </text>
      </g>

      <!-- 3. V2 Maxillary Branch (CLICKABLE) -->
      <g class="interactive-nerve-target" data-branch="v2" style="cursor: pointer;">
        <line x1="605" y1="315" x2="895" y2="370" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="605" cy="315" r="5" fill="#ffffff" stroke="#94a3b8" stroke-width="1.2" />

        <text x="915" y="365" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em" class="hover-glow">
          V2 Maxillary Branch &rsaquo;
        </text>
        <rect x="915" y="374" width="130" height="23" rx="4" fill="#1e293b" stroke="#475569" stroke-width="1.2" class="btn-rect" />
        <text x="980" y="391" text-anchor="middle" fill="#e2e8f0" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          50,000 Axons
        </text>
      </g>

      <!-- 4. V3 Mandibular Branch (CLICKABLE) -->
      <g class="interactive-nerve-target" data-branch="v3" style="cursor: pointer;">
        <line x1="655" y1="410" x2="895" y2="455" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="655" cy="410" r="5.5" fill="#ffffff" stroke="#94a3b8" stroke-width="1.2" />

        <text x="915" y="450" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em" class="hover-glow">
          V3 Mandibular Branch &rsaquo;
        </text>
        <rect x="915" y="459" width="130" height="23" rx="4" fill="#1e293b" stroke="#475569" stroke-width="1.2" class="btn-rect" />
        <text x="980" y="476" text-anchor="middle" fill="#e2e8f0" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          70,000 Axons
        </text>
      </g>

    </svg>

    <!-- INTERACTIVE SLIDE-OVER POPUP CARD -->
    <div id="nerve-modal-card" style="display: none; position: absolute; right: 2rem; top: 2rem; bottom: 2rem; width: 380px; background: rgba(7, 3, 18, 0.96); backdrop-filter: blur(14px); border: 1.5px solid #7c3aed; border-radius: 14px; padding: 1.4rem; box-shadow: -10px 0 35px rgba(0, 0, 0, 0.85); color: #f8fafc; overflow-y: auto; z-index: 50; transition: all 0.3s ease;">
      
      <!-- Close Button -->
      <button id="close-modal-btn" type="button" style="position: absolute; top: 1rem; right: 1rem; background: #1e1338; border: 1px solid #4c1d95; color: #cbd5e1; border-radius: 6px; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 16px; font-weight: 700;">
        &times;
      </button>

      <!-- Modal Content Body -->
      <div id="modal-content-area"></div>
    </div>

  </div>

</div>

<script>
  // Data for Interactive Branch Explorer
  const branchData: Record<string, { title: string; subtitle: string; axons: string; role: string; subBranches: { name: string; innervates: string }[] }> = {
    caudalis: {
      title: "Subnucleus Caudalis (Vc)",
      subtitle: "Brainstem & Cervical Relay Gateway (C1–C2)",
      axons: "140,000 Total Convergent Axons",
      role: "The central pain gateway of the head. It does NOT just receive V1, V2, and V3: it is the master convergence center where cranial nerves VII (Facial), IX (Glossopharyngeal), and X (Vagus) ALSO merge together into the upper cervical spine (C1–C2 dorsal horn). When overwhelmed by chronic tooth leaks, its glial pumps fail and pain radiates everywhere.",
      subBranches: [
        { name: "Trigeminal Afferents (V1, V2, V3)", innervates: "All dental pulps, periodontal ligaments, oral mucosa, and tongue pain." },
        { name: "Glossopharyngeal Nerve (CN IX)", innervates: "Posterior 1/3 of the tongue, tonsils, and pharyngeal pain." },
        { name: "Vagus Nerve (CN X)", innervates: "Laryngeal, esophageal acid sensing, and deep throat mucosal inputs." },
        { name: "Upper Cervical Nerves (C1–C3)", innervates: "Suboccipital neck muscles, base of skull, and postural tension convergence." }
      ]
    },
    v1: {
      title: "V1 Ophthalmic Branch",
      subtitle: "Superior Division (Pure Sensory)",
      axons: "25,000 Axons",
      role: "Exits via the Superior Orbital Fissure. Innervates the forehead, scalp, upper eyelid, and frontal sinus. Receives minimal direct oral input but shares the spinal trigeminal nucleus.",
      subBranches: [
        { name: "Frontal Nerve", innervates: "Splits into Supraorbital and Supratrochlear nerves for forehead and anterior scalp." },
        { name: "Nasociliary Nerve", innervates: "Cornea, eyeball, ethmoid air cells, and bridge/tip of the nose." },
        { name: "Lacrimal Nerve", innervates: "Lacrimal gland sensory fibers and upper lateral eyelid." }
      ]
    },
    v2: {
      title: "V2 Maxillary Branch",
      subtitle: "Middle Division (Pure Sensory)",
      axons: "50,000 Axons",
      role: "Exits via the Foramen Rotundum. The master nerve for the entire upper jaw, palate, maxillary sinus, and midface.",
      subBranches: [
        { name: "Superior Alveolar Nerves (PSA, MSA, ASA)", innervates: "Posterior, Middle, and Anterior upper teeth pulps, roots, and alveolar bone." },
        { name: "Greater & Lesser Palatine Nerves", innervates: "Hard palate, soft palate, and posterior oral roof." },
        { name: "Nasopalatine Nerve", innervates: "Anterior hard palate (directly behind upper incisors) and nasal septum." },
        { name: "Infraorbital Nerve", innervates: "Upper lip, cheek mucosa, and lateral nose." },
        { name: "Zygomatic Nerve", innervates: "Cheek prominence and temporal skin." }
      ]
    },
    v3: {
      title: "V3 Mandibular Branch",
      subtitle: "Inferior Division (Mixed Sensory + Motor)",
      axons: "70,000 Axons (Largest Branch)",
      role: "Exits via the Foramen Ovale. Carries the massive load of the tongue and lower jaw, plus motor branches powering chewing muscles.",
      subBranches: [
        { name: "Lingual Nerve (Primary BMS Driver)", innervates: "General sensation (burning, scald, pain, touch) to the anterior 2/3 of tongue and floor of mouth." },
        { name: "Inferior Alveolar Nerve (IAN)", innervates: "All lower molar, premolar, canine, and incisor teeth pulps through mandibular canal." },
        { name: "Mental Nerve", innervates: "Lower lip, chin, and anterior lower labial gingiva." },
        { name: "Buccal Nerve (Long Buccal)", innervates: "Cheek mucosa and buccal gingiva of lower molars." },
        { name: "Auriculotemporal Nerve", innervates: "TMJ joint capsule, external auditory ear canal, and temple." },
        { name: "Motor Branches (Mastication)", innervates: "Masseter, Temporalis, Medial and Lateral Pterygoid muscles." }
      ]
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('nerve-modal-card');
    const modalArea = document.getElementById('modal-content-area');
    const closeBtn = document.getElementById('close-modal-btn');
    const targets = document.querySelectorAll('.interactive-nerve-target');

    targets.forEach(target => {
      target.addEventListener('click', () => {
        const branchKey = target.getAttribute('data-branch');
        if (!branchKey || !branchData[branchKey]) return;

        const data = branchData[branchKey];
        if (modalArea && modal) {
          modalArea.innerHTML = `
            <div style="font-size: 0.72rem; font-weight: 800; color: #a855f7; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.25rem;">
              Nerve Anatomy Explorer
            </div>
            <div style="font-size: 1.25rem; font-weight: 900; color: #ffffff; line-height: 1.3; margin-bottom: 0.2rem;">
              ${data.title}
            </div>
            <div style="font-size: 0.8rem; color: #38bdf8; font-weight: 700; margin-bottom: 0.5rem;">
              ${data.subtitle} &bull; <span style="color: #fde047;">${data.axons}</span>
            </div>
            <p style="font-size: 0.82rem; color: #94a3b8; line-height: 1.5; margin-bottom: 1rem; border-bottom: 1px solid #1e1338; padding-bottom: 0.75rem;">
              ${data.role}
            </p>
            <div style="font-size: 0.82rem; font-weight: 800; color: #e2e8f0; margin-bottom: 0.6rem; text-transform: uppercase; letter-spacing: 0.04em;">
              Sub-Branches & Innervation:
            </div>
            <div style="display: flex; flex-direction: column; gap: 0.55rem;">
              ${data.subBranches.map(sub => `
                <div style="background: #110822; border: 1px solid #281447; border-radius: 8px; padding: 0.65rem 0.8rem; line-height: 1.4;">
                  <div style="font-size: 0.82rem; font-weight: 800; color: #f43f5e; margin-bottom: 0.15rem;">
                    ${sub.name}
                  </div>
                  <div style="font-size: 0.75rem; color: #cbd5e1;">
                    ${sub.innervates}
                  </div>
                </div>
              `).join('')}
            </div>
          `;
          modal.style.display = 'block';
        }
      });
    });

    if (closeBtn && modal) {
      closeBtn.addEventListener('click', () => {
        modal.style.display = 'none';
      });
    }
  });
</script>

<style>
  .interactive-nerve-target:hover .hover-glow {
    fill: #38bdf8;
    transition: fill 0.2s ease;
  }
  .interactive-nerve-target:hover .btn-rect {
    stroke: #38bdf8;
    fill: #0c1a30;
    transition: all 0.2s ease;
  }
  @keyframes hubPulse {
    0%, 100% {
      transform: scale(1);
      filter: drop-shadow(0 0 3px #ef4444);
    }
    50% {
      transform: scale(1.3);
      filter: drop-shadow(0 0 8px #ef4444);
    }
  }
  .pulsing-hub {
    animation: hubPulse 2s ease-in-out infinite;
    transform-origin: center;
  }
</style>
