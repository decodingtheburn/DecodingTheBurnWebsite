---
// MultiSourcePainDiagram.astro
// Configurable Medical Diagnostic Layout:
// showNerveCards: boolean (default: true) - whether to display the top Caudalis and V1-V3 capacity cards
// showPeripheralInputs: boolean (default: true) - whether to display the 3 category cards below (Dental, Deficiency, Dietary)

interface Props {
  showNerveCards?: boolean;
  showPeripheralInputs?: boolean;
}

const { 
  showNerveCards = true, 
  showPeripheralInputs = true 
} = Astro.props;
---

<div class="pain-diagram-wrapper" style="width: 100%; max-width: 960px; margin: 2rem auto; font-family: system-ui, -apple-system, sans-serif;">

  {showNerveCards && (
  <!-- SECTION 1: TOP NERVE TRUNK CAPACITY (UNIFIED BRANDED PURPLE CARDS) -->
  <div style="margin-bottom: 1.5rem;">
    
    <!-- Subnucleus Caudalis (Full-Width on Top, Same Branded Purple Style) -->
    <div class="interactive-nerve-target nerve-top-card" data-branch="caudalis" style="background: #190d30; border: 1.5px solid #6b21a8; border-radius: 10px; padding: 0.85rem 1.25rem; cursor: pointer; transition: all 0.2s ease; margin-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.05rem; font-weight: 900; color: #ffffff;">Subnucleus Caudalis</span>
        <span style="font-size: 0.72rem; font-weight: 800; background: #6b21a8; color: #f3e8ff; padding: 0.15rem 0.5rem; border-radius: 4px;">Main Gateway</span>
        <span style="font-size: 0.82rem; color: #c084fc;">Medullary Dorsal Horn Convergence Hub</span>
      </div>
      <div style="font-size: 0.9rem; font-weight: 900; color: #38bdf8; background: #0c1527; padding: 0.25rem 0.75rem; border-radius: 6px; border: 1.5px solid #1e3a5f;">
        140,000 Axons
      </div>
    </div>

    <!-- 3 Trigeminal Branches (V1, V2, V3) in 3 Columns Underneath -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem;">
      
      <!-- V1 Ophthalmic -->
      <div class="interactive-nerve-target nerve-top-card" data-branch="v1" style="background: #190d30; border: 1.5px solid #4c1d95; border-radius: 10px; padding: 0.75rem 0.95rem; cursor: pointer; transition: all 0.2s ease;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
          <span style="font-size: 0.95rem; font-weight: 900; color: #ffffff;">V1 Ophthalmic</span>
          <span style="font-size: 0.72rem; font-weight: 700; color: #c084fc;">Sensory</span>
        </div>
        <div style="font-size: 0.85rem; font-weight: 800; color: #38bdf8;">25,000 Axons</div>
        <div style="font-size: 0.75rem; color: #94a3b8; margin-top: 0.2rem;">Orbit & Forehead</div>
      </div>

      <!-- V2 Maxillary -->
      <div class="interactive-nerve-target nerve-top-card" data-branch="v2" style="background: #190d30; border: 1.5px solid #4c1d95; border-radius: 10px; padding: 0.75rem 0.95rem; cursor: pointer; transition: all 0.2s ease;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
          <span style="font-size: 0.95rem; font-weight: 900; color: #ffffff;">V2 Maxillary</span>
          <span style="font-size: 0.72rem; font-weight: 700; color: #c084fc;">Sensory</span>
        </div>
        <div style="font-size: 0.85rem; font-weight: 800; color: #38bdf8;">50,000 Axons</div>
        <div style="font-size: 0.75rem; color: #94a3b8; margin-top: 0.2rem;">Upper Jaw & Palate</div>
      </div>

      <!-- V3 Mandibular -->
      <div class="interactive-nerve-target nerve-top-card" data-branch="v3" style="background: #190d30; border: 1.5px solid #4c1d95; border-radius: 10px; padding: 0.75rem 0.95rem; cursor: pointer; transition: all 0.2s ease;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
          <span style="font-size: 0.95rem; font-weight: 900; color: #ffffff;">V3 Mandibular</span>
          <span style="font-size: 0.72rem; font-weight: 700; color: #c084fc;">Sensory/Motor</span>
        </div>
        <div style="font-size: 0.85rem; font-weight: 800; color: #38bdf8;">70,000 Axons</div>
        <div style="font-size: 0.75rem; color: #94a3b8; margin-top: 0.2rem;">Tongue & Lower Arch</div>
      </div>

    </div>
  </div>
  )}

  <!-- SECTION 2: MEDICAL VISUAL VIEWPORT (CLEAN IMAGE WITH HOVER HIGHLIGHT HOTSPOTS - ZERO LINES) -->
  <div style="position: relative; width: 100%; border-radius: 14px; overflow: hidden; background: #020005; border: 1px solid #281447; display: flex; justify-content: center; align-items: center; min-height: 480px; padding: 1rem 0;">
    
    <!-- Base Medical Render -->
    <img 
      src="/trigeminal-v2-v3-nerves-with-nucleus.jpg" 
      alt="3D medical render mapping trigeminal nerve trunks V1 V2 V3 and glowing brainstem nucleus" 
      style="width: 100%; max-width: 720px; height: auto; max-height: 520px; object-fit: contain; object-position: center; display: block; opacity: 0.92; filter: contrast(1.15) brightness(0.96);"
      loading="lazy"
    />

    <!-- SVG Interactive Hotspots (No Static Lines, Only Glowing Hotspot Areas on Mouseover) -->
    <svg viewBox="0 0 1000 600" style="position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Radial Glow Filters -->
        <filter id="red-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="8" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <filter id="gold-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="6" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <!-- Brainstem Caudalis Glow Spot (CX=590, CY=220) -->
      <g id="hotspot-caudalis" class="diagram-hotspot" opacity="0.65" style="transition: opacity 0.3s ease;">
        <circle cx="585" cy="225" r="28" fill="#ef4444" opacity="0.3" filter="url(#red-glow)" />
        <circle cx="585" cy="225" r="10" fill="#ef4444" stroke="#ffffff" stroke-width="2" />
      </g>

      <!-- V1 Hotspot (Forehead/Orbit: CX=515, CY=265) -->
      <g id="hotspot-v1" class="diagram-hotspot" opacity="0" style="transition: opacity 0.3s ease;">
        <circle cx="515" cy="265" r="22" fill="#38bdf8" opacity="0.35" filter="url(#gold-glow)" />
        <circle cx="515" cy="265" r="8" fill="#38bdf8" stroke="#ffffff" stroke-width="2" />
      </g>

      <!-- V2 Hotspot (Upper Molar / Maxillary: CX=490, CY=350) -->
      <g id="hotspot-v2" class="diagram-hotspot" opacity="0" style="transition: opacity 0.3s ease;">
        <circle cx="490" cy="350" r="25" fill="#38bdf8" opacity="0.4" filter="url(#gold-glow)" />
        <circle cx="490" cy="350" r="9" fill="#38bdf8" stroke="#ffffff" stroke-width="2" />
      </g>

      <!-- V3 Hotspot (Lower Jaw / Mandibular: CX=540, CY=420) -->
      <g id="hotspot-v3" class="diagram-hotspot" opacity="0" style="transition: opacity 0.3s ease;">
        <circle cx="540" cy="420" r="25" fill="#38bdf8" opacity="0.4" filter="url(#gold-glow)" />
        <circle cx="540" cy="420" r="9" fill="#38bdf8" stroke="#ffffff" stroke-width="2" />
      </g>

      <!-- Leaky Crown Hotspot (Upper Molar Crown Site: CX=430, CY=335) -->
      <g id="hotspot-leaky-crown" class="diagram-hotspot" opacity="0" style="transition: opacity 0.3s ease;">
        <circle cx="430" cy="335" r="26" fill="#ef4444" opacity="0.45" filter="url(#red-glow)" />
        <circle cx="430" cy="335" r="9" fill="#ef4444" stroke="#ffffff" stroke-width="2" />
      </g>

      <!-- Exposed Tubules Hotspot (Cervical Margin: CX=370, CY=430) -->
      <g id="hotspot-tubules" class="diagram-hotspot" opacity="0" style="transition: opacity 0.3s ease;">
        <circle cx="370" cy="430" r="26" fill="#eab308" opacity="0.45" filter="url(#gold-glow)" />
        <circle cx="370" cy="430" r="9" fill="#eab308" stroke="#ffffff" stroke-width="2" />
      </g>

      <!-- Canine Occlusion Hotspot (Canine Guidance: CX=395, CY=385) -->
      <g id="hotspot-canine" class="diagram-hotspot" opacity="0" style="transition: opacity 0.3s ease;">
        <circle cx="395" cy="385" r="26" fill="#ef4444" opacity="0.45" filter="url(#red-glow)" />
        <circle cx="395" cy="385" r="9" fill="#ef4444" stroke="#ffffff" stroke-width="2" />
      </g>

      <!-- Dietary / Oral Acid Trigger Hotspot (Tongue Surface: CX=340, CY=450) -->
      <g id="hotspot-oral-acid" class="diagram-hotspot" opacity="0" style="transition: opacity 0.3s ease;">
        <circle cx="340" cy="450" r="30" fill="#eab308" opacity="0.45" filter="url(#gold-glow)" />
        <circle cx="340" cy="450" r="9" fill="#eab308" stroke="#ffffff" stroke-width="2" />
      </g>

      <!-- Saliva / Xerostomia Hotspot (Sublingual / Submandibular Glands: CX=330, CY=480) -->
      <g id="hotspot-saliva" class="diagram-hotspot" opacity="0" style="transition: opacity 0.3s ease;">
        <circle cx="330" cy="480" r="26" fill="#eab308" opacity="0.45" filter="url(#gold-glow)" />
        <circle cx="330" cy="480" r="9" fill="#eab308" stroke="#ffffff" stroke-width="2" />
      </g>
    </svg>

    <!-- FULLSCREEN MODAL OVERLAY (FOR INTERACTIVE DETAILS) -->
    <div id="nerve-modal-card" style="display: none; position: fixed; inset: 0; width: 100vw; height: 100vh; background: rgba(4, 2, 10, 0.95); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); z-index: 99999; overflow-y: auto; padding: 2.5rem 1.5rem; box-sizing: border-box; align-items: center; justify-content: center;">
      
      <!-- Modal Inner Container -->
      <div id="modal-inner-box" style="position: relative; width: 100%; max-width: 1200px; background: #ffffff; border-radius: 16px; padding: 2.5rem 3rem; box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7); color: #0f172a; box-sizing: border-box; transition: all 0.2s ease;">
        
        <!-- Close Button -->
        <button id="close-modal-btn" type="button" aria-label="Close details" style="position: absolute; top: 1.5rem; right: 1.5rem; background: #f1f5f9; border: 1px solid #cbd5e1; color: #0f172a; border-radius: 8px; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 24px; font-weight: 700; line-height: 1; transition: all 0.2s ease;">
          &times;
        </button>

        <!-- Modal Content Body -->
        <div id="modal-content-area"></div>
      </div>
    </div>

  </div>

  {showPeripheralInputs && (
  <!-- SECTION 3: ANATOMICAL HUMAN MAPPING & 4 CATEGORY CARDS -->
  <div style="margin-top: 2rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 1.5rem; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.07);">
    
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.25rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.75rem;">
      <div>
        <h3 style="margin: 0; font-size: 1.15rem; font-weight: 800; color: #0f172a; letter-spacing: -0.015em;">Anatomical Sources of Oral Pain</h3>
        <p style="margin: 0.25rem 0 0; font-size: 0.82rem; color: #64748b;">
          Convergence of dental hardware, chemical irritants, systemic factors, and central wind-up.
        </p>
      </div>
    </div>

    <!-- 3-Column Balanced Horizontal Architecture: Left (Nervous & Systemic) | Center (Human Silhouette) | Right (Dental & Dietary) -->
    <div class="anatomy-stack-container" style="display: grid; grid-template-columns: 1fr minmax(200px, 240px) 1fr; gap: 1.25rem; align-items: center;">
      
      <!-- LEFT COLUMN: 2 CARDS (Nervous System Top, Systemic Factors Bottom) -->
      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        
        <!-- CARD 1: NERVOUS SYSTEM (BRAIN & NERVES) -->
        <div class="category-card-stacked" style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 1rem 1.15rem; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04); transition: transform 0.15s ease, box-shadow 0.15s ease;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.65rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.45rem;">
            <div style="display: flex; flex-direction: column; gap: 0.15rem;">
              <span style="font-size: 1.22rem; font-weight: 850; color: #0f172a; line-height: 1.15; letter-spacing: -0.015em;">Nervous System</span>
              <span style="font-size: 0.78rem; color: #475569; font-weight: 400; line-height: 1.1;">Brain &amp; Nerves</span>
            </div>
            <!-- Authentic Anatomical Brain Icon (Lucide Brain) -->
            <span style="display: inline-flex; align-items: center; justify-content: center; color: #0f172a; flex-shrink: 0;" title="Central Sensitization Circuit">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-2.04Z"/>
                <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-2.04Z"/>
              </svg>
            </span>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.4rem;">
            <!-- 1. Central Wind-Up & Gating -->
            <div class="hover-trigger-row" data-highlight="hotspot-caudalis" style="display: flex; justify-content: space-between; align-items: center; padding: 0.2rem 0.35rem; border-radius: 6px; cursor: pointer;">
              <span style="font-size: 0.83rem; font-weight: 500; color: #334155;">Trigeminal wind-up</span>
              <span style="background: #0f172a; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.38rem; border-radius: 4px;">Active</span>
            </div>

            <!-- 2. Small-Fiber Neuropathy / Terminal Degeneration -->
            <div class="hover-trigger-row" data-highlight="hotspot-caudalis" style="display: flex; justify-content: space-between; align-items: center; padding: 0.2rem 0.35rem; border-radius: 6px; cursor: pointer;">
              <span style="font-size: 0.83rem; font-weight: 500; color: #334155;">Small-fiber neuropathy</span>
              <span style="background: #0f172a; color: #ffffff; font-size: 0.72rem; font-weight: 700; padding: 0.1rem 0.38rem; border-radius: 4px;">Active</span>
            </div>

            <!-- 3. Nerve Trunk Compression / Microvascular -->
            <div class="hover-trigger-row" data-highlight="hotspot-caudalis" style="display: flex; justify-content: space-between; align-items: center; padding: 0.2rem 0.35rem; border-radius: 6px; cursor: pointer;">
              <span style="font-size: 0.83rem; font-weight: 500; color: #334155;">Trunk compression</span>
              <span style="font-size: 0.72rem; font-weight: 600; color: #64748b;">0%</span>
            </div>

            <!-- 4. Mechanisms (10) - Underlined Clickable -->
            <div class="interactive-nerve-target hover-trigger-row" data-branch="sensitization-details" style="display: flex; justify-content: space-between; align-items: center; padding: 0.2rem 0.35rem; border-radius: 6px; cursor: pointer;">
              <span style="font-size: 0.83rem; font-weight: 500; color: #0f172a; text-decoration: underline; text-underline-offset: 3px;">Mechanisms (10) &rsaquo;</span>
              <span style="font-size: 0.72rem; font-weight: 600; color: #64748b;">Details</span>
            </div>
          </div>

          <!-- Total Row: Full solid slate/black background -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.55rem; padding: 0.45rem 0.7rem; border-radius: 6px; background: #0f172a; color: #ffffff;">
            <span style="font-size: 0.85rem; font-weight: 800; color: #ffffff;">Amplification</span>
            <span style="font-size: 0.92rem; font-weight: 900; color: #ffffff;">Active</span>
          </div>
        </div>

        <!-- CARD 4: SYSTEMIC FACTORS (0% - HORMONES, DEFICIENCIES, EXCESSES) -->
        <div class="category-card-stacked" style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 1rem 1.15rem; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04); transition: transform 0.15s ease, box-shadow 0.15s ease;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.65rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.45rem;">
            <div style="display: flex; flex-direction: column; gap: 0.15rem;">
              <span style="font-size: 1.22rem; font-weight: 850; color: #0f172a; line-height: 1.15; letter-spacing: -0.015em;">Systemic Factors</span>
              <span style="font-size: 0.78rem; color: #475569; font-weight: 400; line-height: 1.1;">Hormones &amp; Absorption</span>
            </div>
            <!-- 3x larger icon, no background container -->
            <span style="display: inline-flex; align-items: center; justify-content: center; color: #0f172a; flex-shrink: 0;" title="Systemic & Hormonal Factors">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 2v7.31L4.14 20.3A2 2 0 0 0 5.86 23h12.28a2 2 0 0 0 1.72-2.7L14 9.31V2" />
                <path d="M8.5 2h7" />
              </svg>
            </span>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.4rem;">
            <!-- 1. Hormones -->
            <div class="hover-trigger-row" style="display: flex; justify-content: space-between; align-items: center; padding: 0.2rem 0.35rem; border-radius: 6px;">
              <span style="font-size: 0.83rem; font-weight: 500; color: #334155;">Hormones (TSH/Estrogen)</span>
              <span style="font-size: 0.72rem; font-weight: 600; color: #64748b;">0%</span>
            </div>

            <!-- 2. Deficiencies -->
            <div class="hover-trigger-row" style="display: flex; justify-content: space-between; align-items: center; padding: 0.2rem 0.35rem; border-radius: 6px;">
              <span style="font-size: 0.83rem; font-weight: 500; color: #334155;">Deficiencies (B12/Iron)</span>
              <span style="font-size: 0.72rem; font-weight: 600; color: #64748b;">0%</span>
            </div>

            <!-- 3. Excesses & Toxicity -->
            <div class="hover-trigger-row" style="display: flex; justify-content: space-between; align-items: center; padding: 0.2rem 0.35rem; border-radius: 6px;">
              <span style="font-size: 0.83rem; font-weight: 500; color: #334155;">Excesses &amp; toxicity</span>
              <span style="font-size: 0.72rem; font-weight: 600; color: #64748b;">0%</span>
            </div>

            <!-- 4. Others (20) - Underlined Clickable -->
            <div class="interactive-nerve-target hover-trigger-row" data-branch="deficiency-others" style="display: flex; justify-content: space-between; align-items: center; padding: 0.2rem 0.35rem; border-radius: 6px; cursor: pointer;">
              <span style="font-size: 0.83rem; font-weight: 500; color: #0f172a; text-decoration: underline; text-underline-offset: 3px;">Others (20) &rsaquo;</span>
              <span style="font-size: 0.72rem; font-weight: 600; color: #64748b;">0%</span>
            </div>
          </div>

          <!-- Total Row: Full solid slate/neutral background -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.55rem; padding: 0.45rem 0.7rem; border-radius: 6px; background: #334155; color: #ffffff;">
            <span style="font-size: 0.85rem; font-weight: 800; color: #ffffff;">Total</span>
            <span style="font-size: 0.92rem; font-weight: 900; color: #ffffff;">0%</span>
          </div>
        </div>

      </div>

      <!-- CENTER COLUMN: CLEAN MEDICAL HUMAN SILHOUETTE WITH BILATERAL POINTERS -->
      <div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 14px; padding: 1.25rem 0.5rem; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative;">
        
        <!-- Anatomical Human Medical Figure (Bilateral pointer layout connecting symmetrically left & right) -->
        <svg viewBox="0 0 240 460" style="width: 100%; max-width: 230px; height: auto; display: block;" aria-label="Medical anatomical figure showing brain, mouth, stomach, and systemic axis">
          <defs>
            <linearGradient id="humanFillGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ffffff"/>
              <stop offset="100%" stop-color="#f1f5f9"/>
            </linearGradient>
            <filter id="focalShadow" x="-30%" y="-30%" width="160%" height="160%">
              <feDropShadow dx="0" dy="2" stdDeviation="2.5" flood-color="#0f172a" flood-opacity="0.18"/>
            </filter>
          </defs>

          <!-- Smooth, Proportional Medical Silhouette centered at X=120 -->
          <path d="M 120 20 C 100 20 88 36 88 58 C 88 76 98 90 108 97 L 108 112 C 92 118 76 130 68 150 L 60 215 C 58 230 70 235 76 220 L 86 175 L 86 290 L 98 425 C 100 440 112 440 114 425 L 118 315 L 122 315 L 126 425 C 128 440 140 440 142 425 L 154 290 L 154 175 L 164 220 C 170 235 182 230 180 215 L 172 150 C 164 130 148 118 132 112 L 132 97 C 142 90 152 76 152 58 C 152 36 140 20 120 20 Z" 
                fill="url(#humanFillGrad)" stroke="#94a3b8" stroke-width="1.75" stroke-linejoin="round"/>

          <!-- Central Neural Axis Spine / Core -->
          <line x1="120" y1="95" x2="120" y2="280" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="3,3" />

          <!-- 1. NERVOUS SYSTEM (BRAIN & BRAINSTEM - Level 1: Y ~ 55, Pointer Points LEFT to Card 1) -->
          <g id="body-focal-brain" filter="url(#focalShadow)">
            <path d="M 110 48 C 106 62 113 72 120 74 C 127 72 134 62 130 48 C 127 36 113 36 110 48 Z" fill="#f1f5f9" stroke="#0f172a" stroke-width="1.5"/>
            <circle cx="120" cy="55" r="5" fill="#0f172a"/>
            <!-- Pointer to Left Card 1 -->
            <line x1="105" y1="55" x2="12" y2="55" stroke="#0f172a" stroke-width="1.5" stroke-dasharray="3,3"/>
            <circle cx="12" cy="55" r="3" fill="#0f172a"/>
          </g>

          <!-- 2. DENTAL ISSUES (ORAL CAVITY - Level 2: Y ~ 90, Pointer Points RIGHT to Card 2) -->
          <g id="body-focal-dental" filter="url(#focalShadow)">
            <ellipse cx="120" cy="90" rx="13" ry="6.5" fill="#fef2f2" stroke="#dc2626" stroke-width="1.5"/>
            <circle cx="120" cy="90" r="4.5" fill="#dc2626"/>
            <!-- Pointer to Right Card 2 -->
