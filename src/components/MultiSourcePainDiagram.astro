---
// MultiSourcePainDiagram.astro
// Clean, focused visual diagram illustrating peripheral multi-source pain convergence into the trigeminal system.
// Strictly compliant with the 3 to 4 word title standard: No colons, no ampersands, no hyphens/dashes.
// Left side: Sorted top-to-bottom by anatomical level and severity with zero crossing lines.
// Left badges: Uniformly right-aligned with fixed positions for perfect visual harmony.
// Right side: Anatomical nerve specs with consistent units (Axons, Bandwidth, Threshold).
---

<div class="multi-source-pain-container tts-ignore" style="margin: 2.25rem 0 2.75rem; background: #070312; border: 1.5px solid #3b1d6e; border-radius: 16px; padding: 1.75rem; box-shadow: 0 16px 45px -10px rgba(0, 0, 0, 0.8); color: #f8fafc;">
  
  <!-- Header (Strict 3-4 Word Titles) -->
  <div style="margin-bottom: 1.25rem; border-bottom: 1px solid #1e1338; padding-bottom: 1rem;">
    <div style="font-size: 0.76rem; font-weight: 800; color: #a855f7; text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.35; margin-bottom: 0.25rem;">
      Peripheral Drive
    </div>
    <div style="font-size: 1.35rem; font-weight: 900; color: #ffffff; line-height: 1.38; margin-bottom: 0.45rem;">
      Multi-Source Pain Convergence
    </div>
    <p style="font-size: 0.9rem; color: #94a3b8; line-height: 1.55; margin: 0; max-width: 820px; text-wrap: balance;">
      Left-aligned peripheral sources feed into the central trigeminal network. Right-aligned specifications detail trunk bandwidth capacity in axon volume and membrane depolarizing&nbsp;voltages.
    </p>
  </div>

  <!-- Medical Visual Viewport with Generous Dark Margins -->
  <div style="position: relative; width: 100%; border-radius: 14px; overflow: hidden; background: #020005; border: 1px solid #281447; display: flex; justify-content: center; align-items: center; min-height: 580px; padding: 1.5rem 0;">
    
    <!-- Base Medical Render (Skull profile centered with space on left and right) -->
    <img 
      src="/trigeminal-v2-v3-nerves-real.jpg" 
      alt="3D medical render mapping trigeminal nerve trunks V2 V3, brainstem nucleus hub, and multi-source oral inputs" 
      style="width: 68%; max-width: 760px; height: auto; max-height: 600px; object-fit: contain; object-position: center; display: block; opacity: 0.88; filter: contrast(1.15) brightness(0.96);"
      loading="lazy"
    />

    <!-- SVG Clean Labels & Solid White Straight Connecting Lines Overlay (1200 x 640 viewBox) -->
    <svg viewBox="0 0 1200 640" style="position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;" xmlns="http://www.w3.org/2000/svg">
      
      <!-- ============================================================ -->
      <!-- LEFT SIDE: SOURCES (SORTED TOP-TO-BOTTOM, NO CROSSING LINES) -->
      <!-- BADGES UNIFORMLY RIGHT-ALIGNED AT X=240..296                 -->
      <!-- ============================================================ -->

      <!-- 1. Chronic stress, 10% (GREEN - upper autonomic / central relay, Y=220) -->
      <g>
        <line x1="305" y1="220" x2="575" y2="235" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="575" cy="235" r="4.5" fill="#22c55e" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="225" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Chronic stress
        </text>
        <rect x="240" y="208" width="56" height="23" rx="4" fill="#052e16" stroke="#22c55e" stroke-width="1.2" />
        <text x="268" y="225" text-anchor="middle" fill="#4ade80" font-size="13" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          10%
        </text>
      </g>

      <!-- 2. Leaky margin, 35% (RED - severe molar leak, Y=280) -->
      <g>
        <line x1="305" y1="280" x2="550" y2="310" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="550" cy="310" r="4.5" fill="#ef4444" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="285" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Leaky margin
        </text>
        <rect x="240" y="268" width="56" height="23" rx="4" fill="#3b0718" stroke="#ef4444" stroke-width="1.2" />
        <text x="268" y="285" text-anchor="middle" fill="#f87171" font-size="13" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          35%
        </text>
      </g>

      <!-- 3. Canine occlusion, 20% (YELLOW - periodontal mechanoreceptor loading, Y=340) -->
      <g>
        <line x1="305" y1="340" x2="520" y2="375" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="520" cy="375" r="4.5" fill="#eab308" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="345" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Canine occlusion
        </text>
        <rect x="240" y="328" width="56" height="23" rx="4" fill="#281705" stroke="#eab308" stroke-width="1.2" />
        <text x="268" y="345" text-anchor="middle" fill="#fde047" font-size="13" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          20%
        </text>
      </g>

      <!-- 4. Exposed tubules, 25% (YELLOW - moderate root canals/dentin, Y=400) -->
      <g>
        <line x1="305" y1="400" x2="495" y2="425" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="495" cy="425" r="4.5" fill="#eab308" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="405" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Exposed tubules
        </text>
        <rect x="240" y="388" width="56" height="23" rx="4" fill="#281705" stroke="#eab308" stroke-width="1.2" />
        <text x="268" y="405" text-anchor="middle" fill="#fde047" font-size="13" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          25%
        </text>
      </g>

      <!-- 5. External acid, 30% (RED - severe dietary ingress into teeth/sulci, Y=460) -->
      <g>
        <line x1="305" y1="460" x2="475" y2="475" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="475" cy="475" r="4.5" fill="#ef4444" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="465" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          External acid
        </text>
        <rect x="240" y="448" width="56" height="23" rx="4" fill="#3b0718" stroke="#ef4444" stroke-width="1.2" />
        <text x="268" y="465" text-anchor="middle" fill="#f87171" font-size="13" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          30%
        </text>
      </g>

      <!-- 6. Lack of saliva, 30% (RED - severe tongue acid bath, Y=520) -->
      <g>
        <line x1="305" y1="520" x2="455" y2="520" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="455" cy="520" r="4.5" fill="#ef4444" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="525" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Lack of saliva
        </text>
        <rect x="240" y="508" width="56" height="23" rx="4" fill="#3b0718" stroke="#ef4444" stroke-width="1.2" />
        <text x="268" y="525" text-anchor="middle" fill="#f87171" font-size="13" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          30%
        </text>
      </g>

      <!-- ============================================================ -->
      <!-- RIGHT SIDE: TRUNKS & BRAINSTEM NUCLEUS SPECIFICATIONS        -->
      <!-- SUBNUCLEUS CAUDALIS POSITIONED ACCURATELY IN BRAINSTEM       -->
      <!-- ============================================================ -->

      <!-- 1. Subnucleus Caudalis (Dorsal Brainstem, Above/Behind Trigeminal Trunk, Y=185) -->
      <g>
        <line x1="680" y1="185" x2="895" y2="185" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="680" cy="185" r="5" fill="#c084fc" stroke="#ffffff" stroke-width="1.2" />

        <text x="915" y="180" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Subnucleus Caudalis
        </text>
        <rect x="915" y="189" width="138" height="23" rx="4" fill="#1e1035" stroke="#a855f7" stroke-width="1.2" />
        <text x="984" y="206" text-anchor="middle" fill="#d8b4fe" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          -55 mV Threshold
        </text>
      </g>

      <!-- 2. V2 Maxillary Trunk (Maxilla & Palate Pathway, Y=275) -->
      <g>
        <line x1="640" y1="285" x2="895" y2="285" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="640" cy="285" r="4.5" fill="#38bdf8" stroke="#ffffff" stroke-width="1.2" />

        <text x="915" y="280" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          V2 Maxillary Trunk
        </text>
        <rect x="915" y="289" width="130" height="23" rx="4" fill="#081b33" stroke="#38bdf8" stroke-width="1.2" />
        <text x="980" y="306" text-anchor="middle" fill="#7dd3fc" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          50,000 Axons
        </text>
      </g>

      <!-- 3. V3 Mandibular Trunk (Main Lower Jaw & Tooth Conduit, Y=375) -->
      <g>
        <line x1="600" y1="365" x2="895" y2="375" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="600" cy="365" r="5" fill="#fbbf24" stroke="#ffffff" stroke-width="1.2" />

        <text x="915" y="370" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          V3 Mandibular Trunk
        </text>
        <rect x="915" y="379" width="130" height="23" rx="4" fill="#291a03" stroke="#fbbf24" stroke-width="1.2" />
        <text x="980" y="396" text-anchor="middle" fill="#fde047" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          70,000 Axons
        </text>
      </g>

      <!-- 4. Lingual Nerve (Anterior 2/3 of Tongue Conduction, Y=470) -->
      <g>
        <line x1="550" y1="465" x2="895" y2="470" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="550" cy="465" r="4.5" fill="#ec4899" stroke="#ffffff" stroke-width="1.2" />

        <text x="915" y="465" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Lingual Nerve
        </text>
        <rect x="915" y="474" width="135" height="23" rx="4" fill="#30071e" stroke="#ec4899" stroke-width="1.2" />
        <text x="982" y="491" text-anchor="middle" fill="#f472b6" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          40 Hz Bandwidth
        </text>
      </g>

    </svg>

  </div>

</div>
