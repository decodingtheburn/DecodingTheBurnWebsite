---
// MultiSourcePainDiagram.astro
// Clean, focused visual diagram illustrating peripheral multi-source pain inputs into the trigeminal system.
// Strictly compliant with the 3 to 4 word title standard: No colons, no ampersands, no hyphens/dashes.
// Base image: /trigeminal-v2-v3-nerves-with-nucleus.jpg (with Subnucleus Caudalis accurately rendered along the brainstem tract).
// Left side: Categorized into "Dental Issues" and "Other Triggers" separated by a clean dividing line.
// Left order: Leaky margin (30%), Canine occlusion (20%), Exposed tubules (15%), [Divider], External acid (15%), Lack of saliva (15%), Chronic stress (5%).
// Right side: Subnucleus Caudalis on top, then V1, V2, V3 with uniform neutral axon capacities.
---

<div class="multi-source-pain-container tts-ignore" style="margin: 2.25rem 0 2.75rem; background: #070312; border: 1.5px solid #3b1d6e; border-radius: 16px; padding: 1.75rem; box-shadow: 0 16px 45px -10px rgba(0, 0, 0, 0.8); color: #f8fafc;">
  
  <!-- Header (Strict 3-4 Word Titles) -->
  <div style="margin-bottom: 1.25rem; border-bottom: 1px solid #1e1338; padding-bottom: 1rem;">
    <div style="font-size: 0.76rem; font-weight: 800; color: #a855f7; text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.35; margin-bottom: 0.25rem;">
      Peripheral Drive
    </div>
    <div style="font-size: 1.35rem; font-weight: 900; color: #ffffff; line-height: 1.38; margin-bottom: 0.45rem;">
      Multi-Source Pain Stacking
    </div>
    <p style="font-size: 0.9rem; color: #94a3b8; line-height: 1.55; margin: 0; max-width: 820px; text-wrap: balance;">
      Left-aligned peripheral sources grouped by Dental Issues and Other Triggers, totaling 100% of sensory input. Right-aligned specifications detail trunk carrying capacity in axon&nbsp;volume.
    </p>
  </div>

  <!-- Medical Visual Viewport with Generous Dark Margins -->
  <div style="position: relative; width: 100%; border-radius: 14px; overflow: hidden; background: #020005; border: 1px solid #281447; display: flex; justify-content: center; align-items: center; min-height: 590px; padding: 1.5rem 0;">
    
    <!-- Base Medical Render with Glowing Red Subnucleus Caudalis in Brainstem -->
    <img 
      src="/trigeminal-v2-v3-nerves-with-nucleus.jpg" 
      alt="3D medical render mapping trigeminal nerve trunks V1 V2 V3, glowing red Subnucleus Caudalis hub in brainstem, and oral inputs" 
      style="width: 68%; max-width: 760px; height: auto; max-height: 610px; object-fit: contain; object-position: center; display: block; opacity: 0.90; filter: contrast(1.15) brightness(0.96);"
      loading="lazy"
    />

    <!-- SVG Clean Labels & Solid White Straight Connecting Lines Overlay (1200 x 640 viewBox) -->
    <svg viewBox="0 0 1200 640" style="position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;" xmlns="http://www.w3.org/2000/svg">
      
      <!-- ============================================================ -->
      <!-- LEFT SIDE: GROUP 1 - DENTAL ISSUES (PHYSICAL HARDWARE)       -->
      <!-- ============================================================ -->

      <!-- Group Category Title: Dental Issues -->
      <g>
        <text x="50" y="155" fill="#a855f7" font-size="13" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.08em" text-transform="uppercase">
          Dental Issues
        </text>
      </g>

      <!-- 1. Leaky margin, 30% (Y=195) -->
      <g>
        <line x1="305" y1="195" x2="550" y2="310" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="550" cy="310" r="4.5" fill="#ef4444" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="200" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Leaky margin
        </text>
        <rect x="240" y="183" width="56" height="23" rx="4" fill="#eab308" stroke="#ca8a04" stroke-width="1" />
        <text x="268" y="200" text-anchor="middle" fill="#000000" font-size="13" font-weight="900" font-family="system-ui, -apple-system, sans-serif">
          30%
        </text>
      </g>

      <!-- 2. Canine occlusion, 20% (Y=245) -->
      <g>
        <line x1="305" y1="245" x2="520" y2="375" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="520" cy="375" r="4.5" fill="#eab308" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="250" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Canine occlusion
        </text>
        <rect x="240" y="233" width="56" height="23" rx="4" fill="#eab308" stroke="#ca8a04" stroke-width="1" />
        <text x="268" y="250" text-anchor="middle" fill="#000000" font-size="13" font-weight="900" font-family="system-ui, -apple-system, sans-serif">
          20%
        </text>
      </g>

      <!-- 3. Exposed tubules, 15% (Y=295) -->
      <g>
        <line x1="305" y1="295" x2="495" y2="425" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="495" cy="425" r="4.5" fill="#eab308" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="300" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Exposed tubules
        </text>
        <rect x="240" y="283" width="56" height="23" rx="4" fill="#eab308" stroke="#ca8a04" stroke-width="1" />
        <text x="268" y="300" text-anchor="middle" fill="#000000" font-size="13" font-weight="900" font-family="system-ui, -apple-system, sans-serif">
          15%
        </text>
      </g>

      <!-- DIVIDING SEPARATOR LINE -->
      <g>
        <line x1="50" y1="335" x2="296" y2="335" stroke="#334155" stroke-width="1.2" stroke-dasharray="4 3" opacity="0.8" />
      </g>

      <!-- ============================================================ -->
      <!-- LEFT SIDE: GROUP 2 - OTHER TRIGGERS                          -->
      <!-- ============================================================ -->

      <!-- Group Category Title: Other Triggers -->
      <g>
        <text x="50" y="365" fill="#a855f7" font-size="13" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.08em" text-transform="uppercase">
          Other Triggers
        </text>
      </g>

      <!-- 4. External acid, 15% (Y=405) -->
      <g>
        <line x1="305" y1="405" x2="475" y2="475" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="475" cy="475" r="4.5" fill="#ef4444" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="410" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          External acid
        </text>
        <rect x="240" y="393" width="56" height="23" rx="4" fill="#eab308" stroke="#ca8a04" stroke-width="1" />
        <text x="268" y="410" text-anchor="middle" fill="#000000" font-size="13" font-weight="900" font-family="system-ui, -apple-system, sans-serif">
          15%
        </text>
      </g>

      <!-- 5. Lack of saliva, 15% (Y=460) -->
      <g>
        <line x1="305" y1="460" x2="455" y2="520" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="455" cy="520" r="4.5" fill="#ef4444" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="465" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Lack of saliva
        </text>
        <rect x="240" y="448" width="56" height="23" rx="4" fill="#eab308" stroke="#ca8a04" stroke-width="1" />
        <text x="268" y="465" text-anchor="middle" fill="#000000" font-size="13" font-weight="900" font-family="system-ui, -apple-system, sans-serif">
          15%
        </text>
      </g>

      <!-- 6. Chronic stress, 5% (Y=515, NO POINTER LINE) -->
      <g>
        <text x="50" y="520" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Chronic stress
        </text>
        <rect x="240" y="503" width="56" height="23" rx="4" fill="#eab308" stroke="#ca8a04" stroke-width="1" />
        <text x="268" y="520" text-anchor="middle" fill="#000000" font-size="13" font-weight="900" font-family="system-ui, -apple-system, sans-serif">
          5%
        </text>
      </g>

      <!-- ============================================================ -->
      <!-- RIGHT SIDE: ALL UNIFORM NEUTRAL SLATE-GRAY AXON BADGES       -->
      <!-- SUBNUCLEUS CAUDALIS (TOP), THEN V1, V2, V3                  -->
      <!-- ============================================================ -->

      <!-- 1. Subnucleus Caudalis (TOP: Accurate Brainstem Sensory Column, Y=200) -->
      <g>
        <!-- Correct site: brainstem sensory column behind ganglion -->
        <line x1="645" y1="285" x2="895" y2="200" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="645" cy="285" r="5" fill="#ef4444" stroke="#ffffff" stroke-width="1.2" />

        <text x="915" y="195" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Subnucleus Caudalis
        </text>
        <rect x="915" y="204" width="130" height="23" rx="4" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
        <text x="980" y="221" text-anchor="middle" fill="#e2e8f0" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          140,000 Axons
        </text>
      </g>

      <!-- 2. V1 Ophthalmic Trunk (Upper branch to orbit, Y=285) -->
      <g>
        <line x1="620" y1="240" x2="895" y2="285" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="620" cy="240" r="4.5" fill="#ffffff" stroke="#94a3b8" stroke-width="1.2" />

        <text x="915" y="280" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          V1 Ophthalmic Trunk
        </text>
        <rect x="915" y="289" width="130" height="23" rx="4" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
        <text x="980" y="306" text-anchor="middle" fill="#e2e8f0" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          25,000 Axons
        </text>
      </g>

      <!-- 3. V2 Maxillary Trunk (Mid branch to maxilla/palate, Y=370) -->
      <g>
        <line x1="605" y1="315" x2="895" y2="370" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="605" cy="315" r="4.5" fill="#ffffff" stroke="#94a3b8" stroke-width="1.2" />

        <text x="915" y="365" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          V2 Maxillary Trunk
        </text>
        <rect x="915" y="374" width="130" height="23" rx="4" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
        <text x="980" y="391" text-anchor="middle" fill="#e2e8f0" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          50,000 Axons
        </text>
      </g>

      <!-- 4. V3 Mandibular Trunk (Lower trunk to mandible/teeth/tongue, Y=455) -->
      <g>
        <line x1="655" y1="410" x2="895" y2="455" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="655" cy="410" r="5" fill="#ffffff" stroke="#94a3b8" stroke-width="1.2" />

        <text x="915" y="450" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          V3 Mandibular Trunk
        </text>
        <rect x="915" y="459" width="130" height="23" rx="4" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
        <text x="980" y="476" text-anchor="middle" fill="#e2e8f0" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          70,000 Axons
        </text>
      </g>

    </svg>

  </div>

</div>
