---
// MultiSourcePainDiagram.astro
// Clean, focused visual diagram illustrating peripheral multi-source pain convergence into the trigeminal system.
// Strictly compliant with the 3 to 4 word title standard: No colons, no ampersands, no hyphens/dashes.
// Wide 1200px canvas with solid white connecting lines.
// Left labels positioned with dedicated breathing room, right labels positioned well clear of the skull anatomy.
---

<div class="multi-source-pain-container tts-ignore" style="margin: 2.25rem 0 2.75rem; background: #070312; border: 1.5px solid #3b1d6e; border-radius: 16px; padding: 1.75rem; box-shadow: 0 16px 45px -10px rgba(0, 0, 0, 0.8); color: #f8fafc;">
  
  <!-- Header (Strict 3-4 Word Titles) -->
  <div style="margin-bottom: 1.25rem; border-bottom: 1px solid #1e1338; padding-bottom: 1rem;">
    <div style="font-size: 0.76rem; font-weight: 800; color: #a855f7; text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.35; margin-bottom: 0.25rem;">
      Peripheral Drive
    </div>
    <div style="font-size: 1.35rem; font-weight: 900; color: #ffffff; line-height: 1.38; margin-bottom: 0.45rem;">
      Multi-Source Pain Convergence
    </div>
    <p style="font-size: 0.9rem; color: #94a3b8; line-height: 1.55; margin: 0; max-width: 820px; text-wrap: balance;">
      Left-aligned peripheral sources feed into the central trigeminal network. Right-aligned specifications detail trunk bandwidth capacity in axon volume and membrane depolarizing&nbsp;voltages.
    </p>
  </div>

  <!-- Medical Visual Viewport with Generous Dark Background Margins -->
  <div style="position: relative; width: 100%; border-radius: 14px; overflow: hidden; background: #020005; border: 1px solid #281447; display: flex; justify-content: center; align-items: center; min-height: 580px; padding: 1.5rem 0;">
    
    <!-- Base Medical Render (Skull profile centered with space on left and right) -->
    <img 
      src="/trigeminal-v2-v3-nerves-real.jpg" 
      alt="3D medical render mapping trigeminal nerve trunks V2 V3, brainstem nucleus hub, and multi-source oral inputs" 
      style="width: 68%; max-width: 760px; height: auto; max-height: 600px; object-fit: contain; object-position: center; display: block; opacity: 0.88; filter: contrast(1.15) brightness(0.96);"
      loading="lazy"
    />

    <!-- SVG Clean Labels & Solid White Connecting Lines Overlay (1200 x 640 viewBox) -->
    <svg viewBox="0 0 1200 640" style="position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;" xmlns="http://www.w3.org/2000/svg">
      
      <!-- ============================================================ -->
      <!-- LEFT SIDE: ALL INPUT SOURCES (LEFT-ALIGNED, SOLID WHITE)     -->
      <!-- ============================================================ -->

      <!-- 1. External acid, 30% (RED) -->
      <g>
        <line x1="285" y1="210" x2="520" y2="430" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="520" cy="430" r="4.5" fill="#ef4444" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="215" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          External acid
        </text>
        <rect x="185" y="198" width="56" height="23" rx="4" fill="#3b0718" stroke="#ef4444" stroke-width="1.2" />
        <text x="213" y="215" text-anchor="middle" fill="#f87171" font-size="13" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          30%
        </text>
      </g>

      <!-- 2. Chronic stress, 10% (GREEN) -->
      <g>
        <line x1="285" y1="275" x2="575" y2="330" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="575" cy="330" r="4.5" fill="#22c55e" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="280" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Chronic stress
        </text>
        <rect x="195" y="263" width="56" height="23" rx="4" fill="#052e16" stroke="#22c55e" stroke-width="1.2" />
        <text x="223" y="280" text-anchor="middle" fill="#4ade80" font-size="13" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          10%
        </text>
      </g>

      <!-- 3. Leaky margin, 30% (RED) -->
      <g>
        <line x1="285" y1="340" x2="560" y2="420" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="560" cy="420" r="4.5" fill="#ef4444" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="345" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Leaky margin
        </text>
        <rect x="185" y="328" width="56" height="23" rx="4" fill="#3b0718" stroke="#ef4444" stroke-width="1.2" />
        <text x="213" y="345" text-anchor="middle" fill="#f87171" font-size="13" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          30%
        </text>
      </g>

      <!-- 4. Exposed tubules, 10% (YELLOW) -->
      <g>
        <line x1="285" y1="405" x2="505" y2="455" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="505" cy="455" r="4.5" fill="#eab308" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="410" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Exposed tubules
        </text>
        <rect x="200" y="393" width="56" height="23" rx="4" fill="#281705" stroke="#eab308" stroke-width="1.2" />
        <text x="228" y="410" text-anchor="middle" fill="#fde047" font-size="13" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          10%
        </text>
      </g>

      <!-- 5. Lack of saliva, 30% (RED) -->
      <g>
        <line x1="285" y1="470" x2="535" y2="490" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="535" cy="490" r="4.5" fill="#ef4444" stroke="#ffffff" stroke-width="1.2" />

        <text x="50" y="475" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Lack of saliva
        </text>
        <rect x="185" y="458" width="56" height="23" rx="4" fill="#3b0718" stroke="#ef4444" stroke-width="1.2" />
        <text x="213" y="475" text-anchor="middle" fill="#f87171" font-size="13" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          30%
        </text>
      </g>

      <!-- ============================================================ -->
      <!-- RIGHT SIDE: TRUNKS & NUCLEUS (RIGHT-ALIGNED IN CLEAR BLACK)  -->
      <!-- ============================================================ -->

      <!-- 1. Subnucleus Caudalis -->
      <g>
        <line x1="628" y1="275" x2="895" y2="210" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="628" cy="275" r="5" fill="#c084fc" stroke="#ffffff" stroke-width="1.2" />

        <text x="915" y="204" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Subnucleus Caudalis
        </text>
        <rect x="915" y="213" width="138" height="23" rx="4" fill="#1e1035" stroke="#a855f7" stroke-width="1.2" />
        <text x="984" y="230" text-anchor="middle" fill="#d8b4fe" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          -55 mV Threshold
        </text>
      </g>

      <!-- 2. V2 Maxillary Trunk -->
      <g>
        <line x1="610" y1="305" x2="895" y2="295" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="610" cy="305" r="4.5" fill="#38bdf8" stroke="#ffffff" stroke-width="1.2" />

        <text x="915" y="291" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          V2 Maxillary Trunk
        </text>
        <rect x="915" y="300" width="130" height="23" rx="4" fill="#081b33" stroke="#38bdf8" stroke-width="1.2" />
        <text x="980" y="317" text-anchor="middle" fill="#7dd3fc" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          50,000 Axons
        </text>
      </g>

      <!-- 3. V3 Mandibular Trunk -->
      <g>
        <line x1="588" y1="345" x2="895" y2="385" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="588" cy="345" r="5" fill="#fbbf24" stroke="#ffffff" stroke-width="1.2" />

        <text x="915" y="381" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          V3 Mandibular Trunk
        </text>
        <rect x="915" y="390" width="130" height="23" rx="4" fill="#291a03" stroke="#fbbf24" stroke-width="1.2" />
        <text x="980" y="407" text-anchor="middle" fill="#fde047" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          70,000 Axons
        </text>
      </g>

      <!-- 4. Lingual Nerve -->
      <g>
        <line x1="550" y1="460" x2="895" y2="475" stroke="#ffffff" stroke-width="1.8" opacity="0.9" />
        <circle cx="550" cy="460" r="4.5" fill="#ec4899" stroke="#ffffff" stroke-width="1.2" />

        <text x="915" y="471" fill="#ffffff" font-size="16" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Lingual Nerve
        </text>
        <rect x="915" y="480" width="135" height="23" rx="4" fill="#30071e" stroke="#ec4899" stroke-width="1.2" />
        <text x="982" y="497" text-anchor="middle" fill="#f472b6" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          40 Hz Bandwidth
        </text>
      </g>

    </svg>

  </div>

</div>
