    v2: {
      title: "V2 Maxillary Branch",
      codePrefix: "V2",
      subtitle: "Middle Division &bull; Pure Sensory",
      axons: "50,000 Axons",
      summary: "Exits via the Foramen Rotundum into the pterygopalatine fossa. Responsible for the entire upper dental arch, palate, and midface.",
      branches: [
        { code: "V2.1", name: "Superior Alveolar Nerves", subItems: ["Posterior Superior Alveolar (PSA - Upper Molars #1, #2, #3)", "Middle Superior Alveolar (MSA - Upper Premolars)", "Anterior Superior Alveolar (ASA - Upper Canines & Incisors)"], role: "Primary conduit for upper dental pulp pain, cement leaks, and periodontal ligament load." },
        { code: "V2.2", name: "Palatine Nerves", subItems: ["Greater Palatine Nerve (Hard palate mucosa & gingiva)", "Lesser Palatine Nerve (Soft palate & uvula)", "Nasopalatine Nerve (Anterior palate behind incisors / Incisive canal)"], role: "Innervates the entire palatal roof, a frequent zone of severe burning pain in BMS." },
        { code: "V2.3", name: "Infraorbital Nerve", subItems: ["Inferior palpebral branches (Lower eyelid)", "External nasal branches (Side of nose)", "Superior labial branches (Upper lip & cheek mucosa)"], role: "Midfacial cutaneous sensation and upper lip mucosal feedback." },
        { code: "V2.4", name: "Zygomatic Nerve", subItems: ["Zygomaticofacial nerve (Cheek prominence skin)", "Zygomaticotemporal nerve (Anterior temple skin)"], role: "Cheekbone and temporal sensation." }
      ]
    },
    v3: {
      title: "V3 Mandibular Branch",
      codePrefix: "V3",
      subtitle: "Inferior Division &bull; Mixed Sensory + Motor",
      axons: "70,000 Axons (Largest Branch)",
      summary: "Exits via the Foramen Ovale. Carries massive sensory traffic from the tongue and lower jaw teeth, plus motor fibers to chewing muscles.",
      branches: [
        { code: "V3.1", name: "Lingual Nerve (Primary BMS Highway)", subItems: ["Anterior 2/3 tongue mucosa general sensation (Pain/Heat/Acid)", "Sublingual gland & floor of mouth mucosa", "Chorda tympani communication (Taste hitchhike from CN VII)"], role: "The core biological conduit for burning mouth sensations, acid sensitivity, and lingual papillae pain." },
        { code: "V3.2", name: "Inferior Alveolar Nerve (IAN)", subItems: ["Dental plexus (All lower molar & premolar pulps)", "Incisive branch (Lower canines & incisors)", "Mental nerve (Lower lip, chin, & anterior gingiva)"], role: "Transmits dental pulp signals from lower molar restorations and exposed roots directly into the V3 trunk." },
        { code: "V3.3", name: "Buccal & Auriculotemporal Nerves", subItems: ["Long Buccal Nerve (Cheek mucosa & buccal molar gingiva)", "Auriculotemporal Nerve (TMJ joint capsule, ear canal, & temple)"], role: "Explains TMJ tenderness, ear fullness, and lateral cheek burning accompanying BMS." },
        { code: "V3.4", name: "Motor Branches (Masticatory Power)", subItems: ["Masseteric nerve (Masseter muscle)", "Deep temporal nerves (Temporalis muscle)", "Lateral & Medial pterygoid nerves (Pterygoid chewing muscles)"], role: "Motor control of jaw closure, clenching, and masticatory bite force." }
      ]
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('nerve-modal-card');
    const modalArea = document.getElementById('modal-content-area');
    const closeBtn = document.getElementById('close-modal-btn');
    const targets = document.querySelectorAll('.interactive-nerve-target');
    const hoverRows = document.querySelectorAll('.hover-trigger-row, .nerve-top-card');

    // No disruptive gray hover backgrounds or mouseover spot triggers

    // Modal Opening
    targets.forEach(target => {
      target.addEventListener('click', () => {
        const branchKey = target.getAttribute('data-branch');
        if (!branchKey || !branchData[branchKey]) return;

        const data = branchData[branchKey];
        const innerBox = document.getElementById('modal-inner-box');

        if (modalArea && modal && innerBox) {
          // Consistent Clean White Background for All Modals (Subnucleus Caudalis, Nerves, and "Others" Lists)
          innerBox.style.background = '#ffffff';
          innerBox.style.border = '1.5px solid #cbd5e1';
          innerBox.style.color = '#0f172a';
          innerBox.style.boxShadow = '0 25px 50px -12px rgba(0, 0, 0, 0.25)';
          if (closeBtn) {
            closeBtn.style.background = '#f1f5f9';
            closeBtn.style.borderColor = '#cbd5e1';
            closeBtn.style.color = '#0f172a';
          }

          if (data.isPlainList) {
            innerBox.style.maxWidth = '980px';

            modalArea.innerHTML = `
              <div>
                <!-- Clean Header -->
                <div style="margin-bottom: 1.25rem; border-bottom: 1.5px solid #e2e8f0; padding-bottom: 0.85rem; padding-right: 2.5rem;">
                  <div style="display: flex; justify-content: space-between; align-items: baseline;">
                    <h2 style="font-size: 1.6rem; font-weight: 900; color: #0f172a; margin: 0; letter-spacing: -0.01em;">
                      ${data.title}
                    </h2>
                    <span style="font-size: 0.85rem; font-weight: 800; color: #166534; background: #dcfce7; border: 1px solid #86efac; padding: 0.2rem 0.65rem; border-radius: 4px;">
                      0% (Ruled Out)
                    </span>
                  </div>
                  <p style="font-size: 0.92rem; color: #64748b; margin: 0.35rem 0 0; line-height: 1.4;">
                    ${data.summary}
                  </p>
                </div>

                <!-- Clean Plain List (2 Columns of clean items, no boxes) -->
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 0.85rem 2rem;">
                  ${data.branches.map(b => `
                    <div style="margin-bottom: 0.35rem;">
                      <div style="font-size: 0.98rem; font-weight: 800; color: #0f172a; line-height: 1.35;">
                        ${b.name}
                      </div>
                      ${b.subItems && b.subItems.length > 0 ? `
                        <ul style="margin: 0.2rem 0 0 1.25rem; padding: 0; list-style-type: disc;">
                          <li style="font-size: 0.86rem; color: #475569; line-height: 1.4;">
                            ${b.subItems[0]}
                          </li>
                        </ul>
                      ` : ''}
                    </div>
                  `).join('')}
                </div>

                <!-- Footer -->
                <div style="margin-top: 1.75rem; padding-top: 0.75rem; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
                  <span style="font-size: 0.8rem; color: #64748b;">Click &times; or anywhere outside to return to the diagram.</span>
                  <button id="modal-close-footer-btn" type="button" style="background: #0f172a; color: #ffffff; border: none; padding: 0.45rem 1.15rem; border-radius: 6px; font-size: 0.85rem; font-weight: 700; cursor: pointer;">
                    Close
                  </button>
                </div>
              </div>
            `;
          } else {
            // Crisp White Theme for V1, V2, V3, and Subnucleus Caudalis
            innerBox.style.maxWidth = '1200px';

            modalArea.innerHTML = `
              <div>
                <!-- Header Bar -->
                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem; border-bottom: 1.5px solid #e2e8f0; padding-bottom: 0.75rem; padding-right: 2.5rem;">
                  <div>
                    <span style="font-size: 1.5rem; font-weight: 900; color: #0f172a; letter-spacing: -0.01em;">${data.title}</span>
                    <span style="font-size: 0.88rem; color: #6d28d9; font-weight: 700; margin-left: 0.75rem;">${data.subtitle}</span>
                  </div>
                  <span style="font-size: 0.85rem; font-weight: 800; color: #0284c7; background: #e0f2fe; border: 1.5px solid #bae6fd; padding: 0.25rem 0.75rem; border-radius: 6px;">
                    ${data.axons}
                  </span>
                </div>

                <!-- Summary -->
                <p style="font-size: 0.92rem; color: #475569; line-height: 1.5; margin: 0.5rem 0 1.15rem;">
                  ${data.summary}
                </p>

                <!-- Structured Sub-Branches Grid (2 Columns on Clean White Cards) -->
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 0.85rem;">
                  ${data.branches.map(b => `
                    <div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 0.85rem 1rem; line-height: 1.45;">
                      <!-- Branch Header -->
                      <div style="display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.4rem;">
                        <span style="background: #fee2e2; color: #991b1b; font-size: 0.75rem; font-weight: 900; padding: 0.15rem 0.45rem; border-radius: 4px; border: 1px solid #fca5a5;">
                          ${b.code}
                        </span>
                        <span style="font-size: 0.98rem; font-weight: 800; color: #0f172a;">
                          ${b.name}
                        </span>
                      </div>

                      <!-- Sub-items stacked vertically on top of each other -->
                      ${b.subItems ? `
                        <ul style="margin: 0.4rem 0 0.5rem 1.1rem; padding: 0; list-style-type: disc; display: flex; flex-direction: column; gap: 0.25rem;">
                          ${b.subItems.map(item => `
                            <li style="font-size: 0.85rem; color: #334155; font-weight: 600;">
                              ${item}
                            </li>
                          `).join('')}
                        </ul>
                      ` : ''}

                      <!-- Role / Clinical Significance -->
                      <div style="font-size: 0.82rem; color: #64748b; border-top: 1px solid #e2e8f0; padding-top: 0.5rem; margin-top: 0.5rem; line-height: 1.45;">
                        <span style="font-weight: 800; color: #1e293b;">Function:</span> ${b.role}
                      </div>
                    </div>
                  `).join('')}
                </div>
              </div>

              <!-- Footer Close Guidance -->
              <div style="margin-top: 1.25rem; padding-top: 0.75rem; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 0.78rem; color: #64748b;">Click the &times; button or anywhere outside to return to the diagram.</span>
                <button id="modal-close-footer-btn" type="button" style="background: #6d28d9; color: #ffffff; border: none; padding: 0.35rem 0.95rem; border-radius: 6px; font-size: 0.82rem; font-weight: 800; cursor: pointer;">
                  Close Overview
                </button>
              </div>
            `;
          }
          modal.style.display = 'flex';

          const footerClose = document.getElementById('modal-close-footer-btn');
          if (footerClose) {
            footerClose.addEventListener('click', () => {
              modal.style.display = 'none';
            });
          }
        }
      });
    });

    if (closeBtn && modal) {
      closeBtn.addEventListener('click', () => {
        modal.style.display = 'none';
      });
    }

    // Close on click outside modal
    document.addEventListener('click', (e) => {
      if (modal && modal.style.display === 'flex') {
        const isTarget = (e.target as HTMLElement).closest('.interactive-nerve-target');
        const isModal = (e.target as HTMLElement).closest('#nerve-modal-card');
        if (!isTarget && !isModal) {
          modal.style.display = 'none';
        }
      }
    });
  });
</script>

<style>
  .nerve-top-card:hover {
    border-color: #a855f7 !important;
    background: #170c2e !important;
    transform: translateY(-2px);
  }
</style>
