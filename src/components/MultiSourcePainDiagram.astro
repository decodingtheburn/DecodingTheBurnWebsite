---
// MultiSourcePainDiagram.astro
// Clean, focused visual diagram illustrating peripheral multi-source pain convergence into the trigeminal system.
// Strictly compliant with the 3 to 4 word title standard: No colons, no ampersands, no hyphens/dashes.
// Left-aligned peripheral input labels with clean badges and severity colors (Red, Yellow, Green).
// Right-aligned nerve trunk capacity and brainstem nucleus labels with neuron axon count / voltage threshold specs.
---

<div class="multi-source-pain-container tts-ignore" style="margin: 2.25rem 0 2.75rem; background: #070312; border: 1.5px solid #3b1d6e; border-radius: 16px; padding: 1.75rem; box-shadow: 0 16px 45px -10px rgba(0, 0, 0, 0.8); color: #f8fafc;">
  
  <!-- Header (Strict 3-4 Word Titles) -->
  <div style="margin-bottom: 1.25rem; border-bottom: 1px solid #1e1338; padding-bottom: 1rem;">
    <div style="font-size: 0.76rem; font-weight: 800; color: #a855f7; text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.35; margin-bottom: 0.25rem;">
      Peripheral Drive
    </div>
    <div style="font-size: 1.35rem; font-weight: 900; color: #ffffff; line-height: 1.38; margin-bottom: 0.45rem;">
      Multi-Source Pain Convergence
    </div>
    <p style="font-size: 0.9rem; color: #94a3b8; line-height: 1.55; margin: 0; max-width: 820px; text-wrap: balance;">
      Left-aligned peripheral sources feed into the central trigeminal network. Right-aligned specifications detail trunk bandwidth capacity in axon volume and membrane depolarizing&nbsp;voltages.
    </p>
  </div>

  <!-- Medical Visual Viewport with Left and Right Aligned Text Overlays -->
  <div style="position: relative; width: 100%; border-radius: 14px; overflow: hidden; background: #030108; border: 1px solid #281447; display: flex; justify-content: center; align-items: center; min-height: 580px;">
    
    <!-- Base Medical Render (Skull profile showing skull, trigeminal trunks, and mouth) -->
    <img 
      src="/trigeminal-v2-v3-nerves-real.jpg" 
      alt="3D medical render mapping trigeminal nerve trunks V2 V3, brainstem nucleus hub, and multi-source oral inputs" 
      style="width: 100%; max-width: 860px; height: auto; max-height: 640px; object-fit: contain; object-position: center; display: block; opacity: 0.90; filter: contrast(1.15) brightness(0.96);"
      loading="lazy"
    />

    <!-- SVG Clean Labels & Connecting Lines Overlay -->
    <svg viewBox="0 0 1000 640" style="position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;" xmlns="http://www.w3.org/2000/svg">
      
      <!-- ============================================================ -->
      <!-- LEFT SIDE: ALL INPUT SOURCES (LEFT-ALIGNED, CLEAN BADGES)    -->
      <!-- ============================================================ -->

      <!-- 1. External acid, 30% (RED - severe) -->
      <g>
        <!-- Connecting Line to oral entry -->
        <line x1="260" y1="210" x2="420" y2="430" stroke="#ef4444" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.6" />
        <circle cx="420" cy="430" r="4.5" fill="#ef4444" />

        <!-- Left-Aligned Label -->
        <text x="45" y="214" fill="#f8fafc" font-size="15.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          External acid
        </text>
        <!-- Small Clean Badge -->
        <rect x="175" y="198" width="54" height="22" rx="4" fill="#3b0718" stroke="#ef4444" stroke-width="1" />
        <text x="202" y="214" text-anchor="middle" fill="#f87171" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          30%
        </text>
      </g>

      <!-- 2. Chronic stress, 10% (GREEN - mild/modulating autonomic) -->
      <g>
        <!-- Connecting Line to autonomic/trigeminal relay -->
        <line x1="260" y1="275" x2="480" y2="330" stroke="#22c55e" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.6" />
        <circle cx="480" cy="330" r="4" fill="#22c55e" />

        <!-- Left-Aligned Label -->
        <text x="45" y="279" fill="#f8fafc" font-size="15.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Chronic stress
        </text>
        <!-- Small Clean Badge -->
        <rect x="180" y="263" width="54" height="22" rx="4" fill="#052e16" stroke="#22c55e" stroke-width="1" />
        <text x="207" y="279" text-anchor="middle" fill="#4ade80" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          10%
        </text>
      </g>

      <!-- 3. Leaky margin, 30% (RED - severe) -->
      <g>
        <!-- Connecting Line to molar crown margin -->
        <line x1="260" y1="340" x2="460" y2="420" stroke="#ef4444" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.75" />
        <circle cx="460" cy="420" r="4.5" fill="#ef4444" />

        <!-- Left-Aligned Label -->
        <text x="45" y="344" fill="#f8fafc" font-size="15.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Leaky margin
        </text>
        <!-- Small Clean Badge -->
        <rect x="175" y="328" width="54" height="22" rx="4" fill="#3b0718" stroke="#ef4444" stroke-width="1" />
        <text x="202" y="344" text-anchor="middle" fill="#f87171" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          30%
        </text>
      </g>

      <!-- 4. Exposed tubules, 10% (YELLOW - medium) -->
      <g>
        <!-- Connecting Line to root tubules -->
        <line x1="260" y1="405" x2="400" y2="455" stroke="#eab308" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.75" />
        <circle cx="400" cy="455" r="4.5" fill="#eab308" />

        <!-- Left-Aligned Label -->
        <text x="45" y="409" fill="#f8fafc" font-size="15.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Exposed tubules
        </text>
        <!-- Small Clean Badge -->
        <rect x="190" y="393" width="54" height="22" rx="4" fill="#281705" stroke="#eab308" stroke-width="1" />
        <text x="217" y="409" text-anchor="middle" fill="#fde047" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          10%
        </text>
      </g>

      <!-- 5. Lack of saliva, 30% (RED - severe) -->
      <g>
        <!-- Connecting Line to tongue pool -->
        <line x1="260" y1="470" x2="435" y2="490" stroke="#ef4444" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.75" />
        <circle cx="435" cy="490" r="4.5" fill="#ef4444" />

        <!-- Left-Aligned Label -->
        <text x="45" y="474" fill="#f8fafc" font-size="15.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Lack of saliva
        </text>
        <!-- Small Clean Badge -->
        <rect x="175" y="458" width="54" height="22" rx="4" fill="#3b0718" stroke="#ef4444" stroke-width="1" />
        <text x="202" y="474" text-anchor="middle" fill="#f87171" font-size="12.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          30%
        </text>
      </g>

      <!-- ============================================================ -->
      <!-- RIGHT SIDE: TRUNKS & NUCLEUS CAPACITY (RIGHT-ALIGNED)        -->
      <!-- ============================================================ -->

      <!-- 1. Subnucleus Caudalis (Brainstem Hub / Voltage Threshold) -->
      <g>
        <!-- Connecting line from brainstem nucleus -->
        <circle cx="535" cy="275" r="5" fill="#c084fc" />
        <line x1="535" y1="275" x2="710" y2="210" stroke="#c084fc" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.7" />

        <!-- Right Label Header -->
        <text x="725" y="204" fill="#f8fafc" font-size="15.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Subnucleus Caudalis
        </text>
        <!-- Small Badge with Voltage Capacity -->
        <rect x="725" y="213" width="105" height="22" rx="4" fill="#1e1035" stroke="#a855f7" stroke-width="1" />
        <text x="777" y="229" text-anchor="middle" fill="#d8b4fe" font-size="12" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          -55 mV Threshold
        </text>
      </g>

      <!-- 2. V2 Maxillary Trunk (50,000 Axons) -->
      <g>
        <!-- Connecting line to V2 branch -->
        <circle cx="515" cy="305" r="4.5" fill="#38bdf8" />
        <line x1="515" y1="305" x2="710" y2="295" stroke="#38bdf8" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.7" />

        <!-- Right Label Header -->
        <text x="725" y="291" fill="#f8fafc" font-size="15.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          V2 Maxillary Trunk
        </text>
        <!-- Small Badge with Axon Count -->
        <rect x="725" y="300" width="108" height="22" rx="4" fill="#081b33" stroke="#38bdf8" stroke-width="1" />
        <text x="779" y="316" text-anchor="middle" fill="#7dd3fc" font-size="12" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          50,000 Axons
        </text>
      </g>

      <!-- 3. V3 Mandibular Trunk (70,000 Axons) -->
      <g>
        <!-- Connecting line to V3 trunk -->
        <circle cx="490" cy="345" r="5" fill="#fbbf24" />
        <line x1="490" y1="345" x2="710" y2="385" stroke="#fbbf24" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.7" />

        <!-- Right Label Header -->
        <text x="725" y="381" fill="#f8fafc" font-size="15.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          V3 Mandibular Trunk
        </text>
        <!-- Small Badge with Axon Count -->
        <rect x="725" y="390" width="108" height="22" rx="4" fill="#291a03" stroke="#fbbf24" stroke-width="1" />
        <text x="779" y="406" text-anchor="middle" fill="#fde047" font-size="12" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          70,000 Axons
        </text>
      </g>

      <!-- 4. Lingual Nerve Branch (Crosstalk Saturation Bandwidth) -->
      <g>
        <!-- Connecting line to lingual nerve pathway -->
        <circle cx="455" cy="460" r="4.5" fill="#ec4899" />
        <line x1="455" y1="460" x2="710" y2="475" stroke="#ec4899" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.7" />

        <!-- Right Label Header -->
        <text x="725" y="471" fill="#f8fafc" font-size="15.5" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.01em">
          Lingual Nerve
        </text>
        <!-- Small Badge with Bandwidth Capacity -->
        <rect x="725" y="480" width="105" height="22" rx="4" fill="#30071e" stroke="#ec4899" stroke-width="1" />
        <text x="777" y="496" text-anchor="middle" fill="#f472b6" font-size="12" font-weight="800" font-family="system-ui, -apple-system, sans-serif">
          40 Hz Bandwidth
        </text>
      </g>

    </svg>

  </div>

</div>
