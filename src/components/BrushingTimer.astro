---
// Interactive 20-Second Quadrant & Sextant Sonicare-Style Brushing Timer
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`brushing-timer-container ${className}`}>
	<div class="timer-card">
		<!-- Header -->
		<div class="timer-header">
			<div>
				<h3 class="timer-title">Sonic-Guide 20s Rinse Timer</h3>
				<p class="timer-subtitle">Sonicare-style guided dental arch mapping</p>
			</div>
			<button id="astroSoundToggle" class="timer-toggle-btn" type="button" title="Toggle audio chime">
				<span id="astroSoundIcon">🔔</span>
				<span id="astroSoundText">Chime On</span>
			</button>
		</div>

		<!-- Mode selector -->
		<div class="timer-mode-selector">
			<button id="astroMode20" class="mode-btn active" type="button">6 × 20s (Sextants)</button>
			<button id="astroMode30" class="mode-btn" type="button">4 × 30s (Quadrants)</button>
		</div>

		<!-- Sonicare Dental Arch Visualizer Box -->
		<div id="astroArchContainer" class="timer-display-box">
			<div class="total-progress-track">
				<div id="astroTotalProgress" class="total-progress-fill"></div>
			</div>

			<!-- Live Zone & Countdown Row -->
			<div class="zone-countdown-row">
				<span id="astroZoneBadge" class="zone-badge">Zone 1: Upper Right</span>
				<div class="countdown-row">
					<span id="astroSeconds" class="countdown-digits">20</span>
					<span class="countdown-unit">s</span>
				</div>
			</div>

			<!-- Dental Arch SVG Canvas -->
			<div class="arch-svg-wrapper">
				<svg id="astroDentalSvg" viewBox="0 0 320 180" class="arch-svg">
					<!-- Gingival Arch Guide Curves -->
					<path d="M 65,75 Q 160,15 255,75" fill="none" stroke="#334155" stroke-width="2" stroke-dasharray="2,3" opacity="0.4" />
					<path d="M 75,105 Q 160,165 245,105" fill="none" stroke="#334155" stroke-width="2" stroke-dasharray="2,3" opacity="0.4" />

					<!-- ================= UPPER JAW TEETH ================= -->
					<!-- Zone 0: Upper Right Molars & Premolars -->
					<g id="astroZone-0" class="tooth-group glow-active">
						<rect class="tooth-path" x="65" y="65" width="16" height="13" rx="3" fill="#c084fc" stroke="#a855f7" stroke-width="1.5" />
						<rect class="tooth-path" x="78" y="52" width="15" height="13" rx="3" fill="#c084fc" stroke="#a855f7" stroke-width="1.5" />
						<rect class="tooth-path" x="92" y="41" width="15" height="13" rx="3" fill="#c084fc" stroke="#a855f7" stroke-width="1.5" />
						<rect class="tooth-path" x="107" y="32" width="13" height="12" rx="3" fill="#c084fc" stroke="#a855f7" stroke-width="1.5" />
						<rect class="tooth-path" x="120" y="26" width="13" height="12" rx="3" fill="#c084fc" stroke="#a855f7" stroke-width="1.5" />
					</g>

					<!-- Zone 1: Upper Front Canines & Incisors -->
					<g id="astroZone-1" class="tooth-group">
						<rect class="tooth-path" x="134" y="21" width="12" height="13" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="146" y="19" width="12" height="12" rx="2" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="158" y="18" width="13" height="12" rx="2" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="171" y="18" width="13" height="12" rx="2" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="184" y="19" width="12" height="12" rx="2" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="196" y="21" width="12" height="13" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
					</g>

					<!-- Zone 2: Upper Left Premolars & Molars -->
					<g id="astroZone-2" class="tooth-group">
						<rect class="tooth-path" x="209" y="26" width="13" height="12" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="221" y="32" width="13" height="12" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="233" y="41" width="15" height="13" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="246" y="52" width="15" height="13" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="257" y="65" width="16" height="13" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
					</g>

					<!-- Arch Labels -->
					<text x="160" y="48" fill="#64748b" font-size="7" font-weight="bold" text-anchor="middle" font-family="sans-serif">UPPER ARCH</text>
					<text x="160" y="138" fill="#64748b" font-size="7" font-weight="bold" text-anchor="middle" font-family="sans-serif">LOWER ARCH</text>

					<!-- ================= LOWER JAW TEETH ================= -->
					<!-- Zone 3: Lower Left Premolars & Molars -->
					<g id="astroZone-3" class="tooth-group">
						<rect class="tooth-path" x="249" y="102" width="16" height="13" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="238" y="115" width="15" height="13" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="226" y="126" width="15" height="13" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="214" y="135" width="13" height="12" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="202" y="141" width="13" height="12" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
					</g>

					<!-- Zone 4: Lower Front Canines & Incisors -->
					<g id="astroZone-4" class="tooth-group">
						<rect class="tooth-path" x="190" y="146" width="12" height="12" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="179" y="149" width="11" height="11" rx="2" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="169" y="150" width="10" height="11" rx="2" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="159" y="150" width="10" height="11" rx="2" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="149" y="149" width="11" height="11" rx="2" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="138" y="146" width="12" height="12" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
					</g>

					<!-- Zone 5: Lower Right Molars & Premolars -->
					<g id="astroZone-5" class="tooth-group">
						<rect class="tooth-path" x="126" y="141" width="13" height="12" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="114" y="135" width="13" height="12" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="100" y="126" width="15" height="13" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="87" y="115" width="15" height="13" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
						<rect class="tooth-path" x="74" y="102" width="16" height="13" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1.2" />
					</g>

					<!-- Sweeping Brush Indicator -->
					<g id="astroBrushIndicator" class="sweep-anim" transform="translate(92, 52)">
						<circle cx="0" cy="0" r="10" fill="#a855f7" opacity="0.35" />
						<circle cx="0" cy="0" r="6" fill="#c084fc" />
						<path d="M -4,-2 L 4,-2 L 2,4 L -2,4 Z" fill="#ffffff" />
					</g>

					<!-- Water Splash Overlay for Rinse -->
					<g id="astroRinseOverlay" opacity="0" class="splash-active" transform="translate(160, 90)">
						<circle cx="0" cy="0" r="38" fill="#0284c7" opacity="0.25" />
						<text x="0" y="4" fill="#38bdf8" font-size="11" font-weight="bold" text-anchor="middle">💦 RINSE BRUSH!</text>
					</g>
				</svg>
			</div>

			<!-- Action Prompt -->
			<div id="astroActionPrompt" class="action-prompt">
				Gently sweep outer cervical margins at gumline
			</div>

			<!-- Total Session Time -->
			<div class="session-remainder">
				Total: <span id="astroTotalTime">2:00</span> remaining
			</div>
		</div>

		<!-- Controls -->
		<div class="timer-controls">
			<button id="astroStartBtn" class="btn-start" type="button">
				<span id="astroStartText">Start Guided Brushing</span>
			</button>
			<button id="astroResetBtn" class="btn-reset" type="button">
				Reset
			</button>
		</div>
	</div>
</div>

<style>
	.brushing-timer-container {
		max-width: 520px;
		width: 100%;
		margin: 2rem auto;
	}

	.timer-card {
		background: #090d16;
		border: 1px solid rgba(139, 92, 246, 0.25);
		border-radius: 1.25rem;
		padding: 1.25rem 1.5rem;
		box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.6), 0 0 20px rgba(139, 92, 246, 0.1);
		color: #f8fafc;
	}

	.timer-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		gap: 0.75rem;
	}

	.timer-title {
		font-size: 1.05rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0;
	}

	.timer-subtitle {
		font-size: 0.72rem;
		color: #94a3b8;
		margin: 0.15rem 0 0 0;
	}

	.timer-toggle-btn {
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: #e2e8f0;
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0.35rem 0.65rem;
		border-radius: 0.5rem;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		transition: all 0.2s ease;
	}

	.timer-toggle-btn:hover {
		background: rgba(255, 255, 255, 0.12);
	}

	.timer-mode-selector {
		display: flex;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 0.65rem;
		padding: 0.2rem;
		margin: 0.75rem 0;
		gap: 0.25rem;
	}

	.mode-btn {
		flex: 1;
		background: transparent;
		border: none;
		color: #94a3b8;
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0.45rem;
		border-radius: 0.45rem;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.mode-btn.active {
		background: #7c3aed;
		color: #ffffff;
		box-shadow: 0 2px 8px rgba(124, 58, 237, 0.4);
	}

	.timer-display-box {
		position: relative;
		background: #030712;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 1rem;
		padding: 1rem 0.75rem 0.75rem 0.75rem;
		text-align: center;
		overflow: hidden;
		transition: all 0.3s ease;
	}

	.timer-display-box.rinse-flash {
		background: #451a03;
		border-color: #f59e0b;
		box-shadow: 0 0 25px rgba(245, 158, 11, 0.3);
	}

	.total-progress-track {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 3px;
		background: rgba(255, 255, 255, 0.1);
	}

	.total-progress-fill {
		height: 100%;
		width: 0%;
		background: #8b5cf6;
		transition: width 0.3s linear;
	}

	.zone-countdown-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0 0.5rem;
		margin-bottom: 0.25rem;
	}

	.zone-badge {
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #c084fc;
		background: rgba(168, 85, 247, 0.15);
		border: 1px solid rgba(168, 85, 247, 0.35);
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
	}

	.zone-badge.alert {
		color: #fde047;
		background: rgba(234, 179, 8, 0.25);
		border-color: #facc15;
		animation: badge-pulse 0.8s infinite alternate;
	}

	@keyframes badge-pulse {
		from { transform: scale(0.97); }
		to { transform: scale(1.03); }
	}

	.countdown-row {
		display: flex;
		align-items: baseline;
		gap: 0.2rem;
	}

	.countdown-digits {
		font-size: 1.85rem;
		font-weight: 900;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		line-height: 1;
		color: #ffffff;
	}

	.countdown-unit {
		font-size: 0.75rem;
		font-family: monospace;
		color: #94a3b8;
	}

	.arch-svg-wrapper {
		position: relative;
		width: 100%;
		max-width: 280px;
		height: 145px;
		margin: 0.2rem auto;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.arch-svg {
		width: 100%;
		height: 100%;
	}

	.action-prompt {
		font-size: 0.75rem;
		font-weight: 500;
		color: #cbd5e1;
		margin-top: 0.35rem;
		min-height: 1.15rem;
	}

	.session-remainder {
		font-size: 0.65rem;
		font-family: monospace;
		color: #64748b;
		margin-top: 0.25rem;
	}

	.timer-controls {
		display: flex;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.btn-start {
		flex: 1;
		background: #7c3aed;
		border: none;
		color: #ffffff;
		font-size: 0.88rem;
		font-weight: 700;
		padding: 0.7rem;
		border-radius: 0.75rem;
		cursor: pointer;
		transition: all 0.2s ease;
		box-shadow: 0 4px 14px rgba(124, 58, 237, 0.4);
	}

	.btn-start:hover {
		background: #6d28d9;
	}

	.btn-start.pause {
		background: #d97706;
		box-shadow: 0 4px 14px rgba(217, 119, 6, 0.4);
	}

	.btn-reset {
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: #cbd5e1;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.7rem 1.1rem;
		border-radius: 0.75rem;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.btn-reset:hover {
		background: rgba(255, 255, 255, 0.12);
	}

	@keyframes brush-sweep {
		0% { transform: translate(-8px, -2px) rotate(-6deg); }
		50% { transform: translate(8px, 2px) rotate(6deg); }
		100% { transform: translate(-8px, -2px) rotate(-6deg); }
	}
	@keyframes pulse-glow {
		0%, 100% { filter: drop-shadow(0 0 5px rgba(168, 85, 247, 0.7)); }
		50% { filter: drop-shadow(0 0 14px rgba(168, 85, 247, 1)); }
	}
	@keyframes water-splash {
		0% { transform: scale(0.95); opacity: 0.7; }
		50% { transform: scale(1.05); opacity: 1; }
		100% { transform: scale(0.95); opacity: 0.7; }
	}

	.sweep-anim {
		animation: brush-sweep 1.8s infinite ease-in-out;
		transform-origin: center;
	}
	.glow-active {
		animation: pulse-glow 1.5s infinite ease-in-out;
	}
	.splash-active {
		animation: water-splash 0.8s infinite ease-in-out;
	}
	.tooth-path {
		transition: all 0.4s ease;
	}
</style>

<script>
	let audioCtx: AudioContext | null = null;
	let soundEnabled = true;

	function getAudioContext() {
		if (!audioCtx) {
			const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
			audioCtx = new AudioContextClass();
		}
		return audioCtx;
	}

	function playAstroChime(type: 'rinse' | 'finish') {
		if (!soundEnabled) return;
		try {
			const ctx = getAudioContext();
			if (ctx.state === 'suspended') ctx.resume();
			const now = ctx.currentTime;

			if (type === 'rinse') {
				const osc1 = ctx.createOscillator();
				const gain1 = ctx.createGain();
				osc1.type = 'sine';
				osc1.frequency.setValueAtTime(587.33, now);
				gain1.gain.setValueAtTime(0.25, now);
				gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
				osc1.connect(gain1);
				gain1.connect(ctx.destination);
				osc1.start(now);
				osc1.stop(now + 0.35);

				const osc2 = ctx.createOscillator();
				const gain2 = ctx.createGain();
				osc2.type = 'sine';
				osc2.frequency.setValueAtTime(880, now + 0.15);
				gain2.gain.setValueAtTime(0.3, now + 0.15);
				gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
				osc2.connect(gain2);
				gain2.connect(ctx.destination);
				osc2.start(now + 0.15);
				osc2.stop(now + 0.6);
			} else if (type === 'finish') {
				[523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
					const osc = ctx.createOscillator();
					const gain = ctx.createGain();
					osc.type = 'triangle';
					osc.frequency.setValueAtTime(freq, now + idx * 0.12);
					gain.gain.setValueAtTime(0.2, now + idx * 0.12);
					gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.12 + 0.7);
					osc.connect(gain);
					gain.connect(ctx.destination);
					osc.start(now + idx * 0.12);
					osc.stop(now + idx * 0.12 + 0.7);
				});
			}
		} catch (err) {
			console.log("Audio not allowed yet:", err);
		}
	}

	const zoneCoords6 = [
		{ x: 92, y: 52, name: "Zone 1: Upper Right", desc: "Upper right molars & cervical margins" },
		{ x: 165, y: 22, name: "Zone 2: Upper Front", desc: "Upper canines & incisors (gentle sweeps)" },
		{ x: 236, y: 52, name: "Zone 3: Upper Left", desc: "Upper left molars & premolars" },
		{ x: 228, y: 125, name: "Zone 4: Lower Left", desc: "Lower left molars & lingual margins" },
		{ x: 165, y: 152, name: "Zone 5: Lower Front", desc: "Lower front teeth (protect receded roots)" },
		{ x: 98, y: 125, name: "Zone 6: Lower Right", desc: "Lower right molars & crowns (problem areas last)" }
	];

	const zoneCoords4 = [
		{ x: 95, y: 48, name: "Quadrant 1: Upper Right", desc: "Upper right teeth all surfaces" },
		{ x: 230, y: 48, name: "Quadrant 2: Upper Left", desc: "Upper left teeth all surfaces" },
		{ x: 230, y: 128, name: "Quadrant 3: Lower Left", desc: "Lower left teeth all surfaces" },
		{ x: 95, y: 128, name: "Quadrant 4: Lower Right", desc: "Lower right teeth (save crown pockets for last)" }
	];

	let currentMode = 20;
	let intervalDuration = 20;
	let activeZones = zoneCoords6;
	let currentZoneIdx = 0;
	let secondsLeftInInterval = 20;
	let totalSecondsLeft = 120;
	let isRunning = false;
	let timerIntervalId: number | null = null;
	let isRinseAlert = false;

	const countdownSecEl = document.getElementById("astroSeconds");
	const totalProgressEl = document.getElementById("astroTotalProgress");
	const totalTimeEl = document.getElementById("astroTotalTime");
	const zoneBadgeEl = document.getElementById("astroZoneBadge");
	const actionPromptEl = document.getElementById("astroActionPrompt");
	const archContainerEl = document.getElementById("astroArchContainer");
	const brushIndicatorEl = document.getElementById("astroBrushIndicator");
	const rinseOverlayEl = document.getElementById("astroRinseOverlay");
	const startBtnEl = document.getElementById("astroStartBtn");
	const startTextEl = document.getElementById("astroStartText");
	const resetBtnEl = document.getElementById("astroResetBtn");
	const soundToggleEl = document.getElementById("astroSoundToggle");
	const soundTextEl = document.getElementById("astroSoundText");
	const soundIconEl = document.getElementById("astroSoundIcon");
	const mode20El = document.getElementById("astroMode20");
	const mode30El = document.getElementById("astroMode30");

	function updateArchUI() {
		const coord = activeZones[currentZoneIdx];
		brushIndicatorEl?.setAttribute("transform", `translate(${coord.x}, ${coord.y})`);

		for (let i = 0; i < 6; i++) {
			const group = document.getElementById(`astroZone-${i}`);
			if (!group) continue;
			const rects = group.querySelectorAll("rect");

			let isActive = false;
			let isCompleted = false;

			if (currentMode === 20) {
				isActive = (i === currentZoneIdx);
				isCompleted = (i < currentZoneIdx);
			} else {
				const map4to6 = [0, 0, 1, 2, 3, 3][i];
				isActive = (map4to6 === currentZoneIdx);
				isCompleted = (map4to6 < currentZoneIdx);
			}

			if (isActive) {
				group.classList.add("glow-active");
				rects.forEach(r => {
					r.setAttribute("fill", "#c084fc");
					r.setAttribute("stroke", "#a855f7");
					r.setAttribute("stroke-width", "1.5");
				});
			} else if (isCompleted) {
				group.classList.remove("glow-active");
				rects.forEach(r => {
					r.setAttribute("fill", "#4ade80");
					r.setAttribute("stroke", "#22c55e");
					r.setAttribute("stroke-width", "1.2");
				});
			} else {
				group.classList.remove("glow-active");
				rects.forEach(r => {
					r.setAttribute("fill", "#1e293b");
					r.setAttribute("stroke", "#475569");
					r.setAttribute("stroke-width", "1.2");
				});
			}
		}
	}

	function renderTimer() {
		if (countdownSecEl) countdownSecEl.textContent = String(secondsLeftInInterval);

		const mins = Math.floor(totalSecondsLeft / 60);
		const secs = totalSecondsLeft % 60;
		if (totalTimeEl) totalTimeEl.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;

		const totalDuration = activeZones.length * intervalDuration;
		const progress = ((totalDuration - totalSecondsLeft) / totalDuration) * 100;
		if (totalProgressEl) totalProgressEl.style.width = `${progress}%`;

		if (isRinseAlert) {
			if (zoneBadgeEl) {
				zoneBadgeEl.className = "zone-badge alert";
				zoneBadgeEl.textContent = "💦 3-SECOND RINSE!";
			}
			if (actionPromptEl) {
				actionPromptEl.innerHTML = `<strong style="color: #fde047;">Rinse bristles under running water & spit slurry now!</strong>`;
			}
			if (archContainerEl) archContainerEl.className = "timer-display-box rinse-flash";
			rinseOverlayEl?.setAttribute("opacity", "1");
			brushIndicatorEl?.setAttribute("opacity", "0");
		} else {
			if (zoneBadgeEl) {
				zoneBadgeEl.className = "zone-badge";
				zoneBadgeEl.textContent = activeZones[currentZoneIdx]?.name || '';
			}
			if (actionPromptEl) {
				actionPromptEl.textContent = activeZones[currentZoneIdx]?.desc || '';
			}
			if (archContainerEl) archContainerEl.className = "timer-display-box";
			rinseOverlayEl?.setAttribute("opacity", "0");
			brushIndicatorEl?.setAttribute("opacity", "1");
		}

		updateArchUI();
	}

	function timerTick() {
		if (totalSecondsLeft <= 0) {
			stopSession();
			return;
		}

		totalSecondsLeft--;
		secondsLeftInInterval--;

		if (secondsLeftInInterval <= 0) {
			if (currentZoneIdx < activeZones.length - 1) {
				isRinseAlert = true;
				playAstroChime('rinse');
				renderTimer();

				setTimeout(() => {
					isRinseAlert = false;
					currentZoneIdx++;
					secondsLeftInInterval = intervalDuration;
					renderTimer();
				}, 2500);
			} else {
				stopSession();
				return;
			}
		} else {
			renderTimer();
		}
	}

	function startTimerHandler() {
		getAudioContext();
		isRunning = true;
		if (startTextEl) startTextEl.textContent = "Pause";
		if (startBtnEl) startBtnEl.className = "btn-start pause";
		timerIntervalId = window.setInterval(timerTick, 1000);
	}

	function pauseTimerHandler() {
		isRunning = false;
		if (startTextEl) startTextEl.textContent = "Resume";
		if (startBtnEl) startBtnEl.className = "btn-start";
		if (timerIntervalId) clearInterval(timerIntervalId);
	}

	function resetTimerHandler() {
		pauseTimerHandler();
		if (startTextEl) startTextEl.textContent = "Start Guided Brushing";
		currentZoneIdx = 0;
		secondsLeftInInterval = intervalDuration;
		totalSecondsLeft = activeZones.length * intervalDuration;
		isRinseAlert = false;
		renderTimer();
	}

	function stopSession() {
		pauseTimerHandler();
		playAstroChime('finish');
		if (zoneBadgeEl) {
			zoneBadgeEl.textContent = "🎉 ARCH 100% CLEAN!";
			zoneBadgeEl.className = "zone-badge";
			zoneBadgeEl.style.color = "#4ade80";
			zoneBadgeEl.style.borderColor = "#22c55e";
		}
		if (actionPromptEl) {
			actionPromptEl.innerHTML = `<strong style="color: #4ade80;">All teeth clean. Filaments flushed. Tubule plugs protected!</strong>`;
		}
		if (countdownSecEl) countdownSecEl.textContent = "0";
		if (totalTimeEl) totalTimeEl.textContent = "0:00";
		if (totalProgressEl) totalProgressEl.style.width = "100%";
		brushIndicatorEl?.setAttribute("opacity", "0");

		for (let i = 0; i < 6; i++) {
			const group = document.getElementById(`astroZone-${i}`);
			group?.querySelectorAll("rect").forEach(r => {
				r.setAttribute("fill", "#4ade80");
				r.setAttribute("stroke", "#22c55e");
			});
		}
	}

	startBtnEl?.addEventListener("click", () => {
		if (isRunning) {
			pauseTimerHandler();
		} else {
			startTimerHandler();
		}
	});

	resetBtnEl?.addEventListener("click", resetTimerHandler);

	soundToggleEl?.addEventListener("click", () => {
		soundEnabled = !soundEnabled;
		if (soundTextEl && soundIconEl && soundToggleEl) {
			if (soundEnabled) {
				soundTextEl.textContent = "Chime On";
				soundIconEl.textContent = "🔔";
				soundToggleEl.style.color = "#e2e8f0";
				playAstroChime('rinse');
			} else {
				soundTextEl.textContent = "Muted";
				soundIconEl.textContent = "🔕";
				soundToggleEl.style.color = "#f87171";
			}
		}
	});

	mode20El?.addEventListener("click", () => {
		if (currentMode === 20) return;
		currentMode = 20;
		intervalDuration = 20;
		activeZones = zoneCoords6;
		mode20El.className = "mode-btn active";
		mode30El?.classList.remove("active");
		resetTimerHandler();
	});

	mode30El?.addEventListener("click", () => {
		if (currentMode === 30) return;
		currentMode = 30;
		intervalDuration = 30;
		activeZones = zoneCoords4;
		mode30El.className = "mode-btn active";
		mode20El?.classList.remove("active");
		resetTimerHandler();
	});

	// Initialize
	renderTimer();
</script>
