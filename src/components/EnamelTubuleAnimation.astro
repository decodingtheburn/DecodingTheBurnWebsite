---
// EnamelTubuleAnimation.astro - Interactive 3D Tooth & Conical Tubule Biophysical Simulator
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`enamel-anim-wrapper ${className}`}>
	<div class="enamel-anim-card">
		<!-- Header -->
		<div class="enamel-anim-header">
			<h3 class="enamel-anim-title">Interactive Biophysical Simulator: 50-Year Enamel &amp; Tubule&nbsp;Progression</h3>
			<p class="enamel-anim-subtitle">
				Observe how 50 years of mechanical abfraction, acid erosion, and gum recession strip the enamel shield, eat away the dentin wall, and expose up to 45,000 conical tubules directly into the trigeminal mandibular nerve&nbsp;canal.
			</p>
		</div>

		<!-- View Switcher (Dual View / Anatomical Tooth / Microscopic Cones) -->
		<div class="view-mode-toggle" role="tablist" aria-label="Simulation Views">
			<button class="view-btn active" data-view="anatomical" type="button">
				<span class="view-icon">🦷</span>
				<span class="view-label">3D Tooth Anatomical View</span>
			</button>
			<button class="view-btn" data-view="conical" type="button">
				<span class="view-icon">🔬</span>
				<span class="view-label">Microscopic Conic Zoom (Dentin Thinning)</span>
			</button>
			<button class="view-btn" data-view="split" type="button">
				<span class="view-icon">⚡</span>
				<span class="view-label">Side-by-Side Dual View</span>
			</button>
		</div>

		<!-- Age Step Controls -->
		<div class="age-button-grid" role="tablist" aria-label="Age Milestones">
			<button class="age-btn active" data-age="15" type="button">
				<span class="age-badge-text">Age 15 - Youth</span>
				<span class="age-state">Intact Shield (0mm Recession)</span>
			</button>
			<button class="age-btn" data-age="30" type="button">
				<span class="age-badge-text">Age 30 - Early Wear</span>
				<span class="age-state">Micro-Fissures (0.8mm Recession)</span>
			</button>
			<button class="age-btn" data-age="45" type="button">
				<span class="age-badge-text">Age 45 - Abfraction</span>
				<span class="age-state">Active Notch (1.8mm Recession)</span>
			</button>
			<button class="age-btn" data-age="60" type="button">
				<span class="age-badge-text">Age 60+ - Severe Breach</span>
				<span class="age-state">Dentin Thinning (2.5mm+ Recession)</span>
			</button>
		</div>

		<!-- Interactive Simulation Stage (Dynamic Viewport) -->
		<div class="simulation-viewport-container" id="simContainer" data-mode="anatomical">
			
			<!-- VIEW A: 3D Anatomical Tooth Cross-Section (Using Real Medical Image + Dynamic Canvas Overlays) -->
			<div class="sim-pane anatomical-pane" id="anatomicalPane">
				<div class="tooth-render-stage">
					<img 
						src="/exposed-dentinal-tubules-cross-section.jpg" 
						alt="3D Anatomical cross section of tooth with 2mm gum recession, exposed dentinal tubules, pulp and trigeminal nerve"
						class="tooth-base-image"
						id="toothBaseImg"
					/>
					
					<!-- Canvas Overlay for Dynamic Abfraction Erosion, Tubule Sprouting & Trigeminal Action Potentials -->
					<canvas id="toothOverlayCanvas" width="1200" height="896"></canvas>

					<!-- Dynamic Floating Callouts Tied to Age -->
					<div class="hotspot-badge abfraction-badge" id="abfractionBadge">
						<div class="hotspot-dot"></div>
						<div class="hotspot-info">
							<strong id="badgeWearTitle">Enamel Intact</strong>
							<span id="badgeWearDesc">CEJ fully protected by gingival margin</span>
						</div>
					</div>

					<div class="hotspot-badge nerve-badge" id="nerveBadge">
						<div class="hotspot-dot nerve"></div>
						<div class="hotspot-info">
							<strong>Mandibular Canal (CN V3)</strong>
							<span id="badgeNerveDesc">Action potential frequency: Quiet</span>
						</div>
					</div>
				</div>
			</div>

			<!-- VIEW B: Microscopic Zoom showing Conical Tubule Geometry & Dentin Wall Thinning -->
			<div class="sim-pane conical-pane" id="conicalPane">
				<div class="conical-header-bar">
					<div class="conical-title-wrap">
						<h4 class="conical-title">Microscopic Conic Geometry: Dentin Wall&nbsp;Thinning</h4>
						<p class="conical-subtitle">
							Dentinal tubules are funnel cones ($0.8\mu m \to 2.8\mu m$). As cervical erosion eats inward, the dentin thins and fluid flow surges by $95\times$ via Poiseuille's&nbsp;Law.
						</p>
					</div>
					<div class="conical-rdt-pill" id="rdtPill">
						Remaining Dentin: <strong>3.00 mm</strong>
					</div>
				</div>

				<div class="conical-canvas-box">
					<canvas id="conicalCanvas" width="900" height="460"></canvas>
					
					<div class="conical-legend-row">
						<div class="legend-chip"><span class="chip-color outer"></span> Outer Surface (Acid / Saliva)</div>
						<div class="legend-chip"><span class="chip-color dentin"></span> Dentin Wall (Thinning with Age)</div>
						<div class="legend-chip"><span class="chip-color tubule"></span> Funnel Tubules (Expanding Cones)</div>
						<div class="legend-chip"><span class="chip-color pulp"></span> Pulp / Odontoblast Plexus (Pain Trigger)</div>
					</div>
				</div>
			</div>

		</div>

		<!-- Interactive Timeline Slider & Playback Controls -->
		<div class="slider-control-bar">
			<div class="slider-left">
				<div class="slider-header-flex">
					<label for="ageSlider" class="slider-label">
						<span>Patient Age Timeline:</span>
						<strong id="ageDisplay">Age 15 (Pristine Shield)</strong>
					</label>
					<span class="recession-readout" id="recessionReadout">0.0 mm Recession</span>
				</div>
				<input 
					type="range" 
					id="ageSlider" 
					min="15" 
					max="65" 
					value="15" 
					step="1"
					class="age-range-input"
					aria-label="Patient age timeline slider"
				/>
				<div class="slider-ticks">
					<span>15y</span>
					<span>25y</span>
					<span>35y</span>
					<span>45y</span>
					<span>55y</span>
					<span>65y+</span>
				</div>
			</div>
			
			<div class="slider-actions">
				<button id="playPauseBtn" class="anim-action-btn" type="button">
					<span id="playIcon">▶</span>
					<span id="playText">Play 50-Year Arc</span>
				</button>
				<button id="resetBtn" class="anim-action-btn secondary" type="button">
					Reset to 15y
				</button>
			</div>
		</div>

		<!-- Real-Time Biophysical Telemetry Dashboard -->
		<div class="metrics-dashboard">
			<div class="metric-card">
				<div class="metric-label">Gum Line Recession</div>
				<div class="metric-value-box">
					<span class="metric-val" id="metricRecession">0.0</span>
					<span class="metric-unit">mm</span>
				</div>
				<div class="metric-sub" id="subRecession">Gums seal root cementum</div>
			</div>

			<div class="metric-card">
				<div class="metric-label">Remaining Dentin (RDT)</div>
				<div class="metric-value-box">
					<span class="metric-val" id="metricRdt">3.00</span>
					<span class="metric-unit">mm</span>
				</div>
				<div class="metric-sub" id="subRdt">Full insulation over pulp</div>
			</div>

			<div class="metric-card">
				<div class="metric-label">Exposed Tubule Density</div>
				<div class="metric-value-box">
					<span class="metric-val" id="metricDensity">0</span>
					<span class="metric-unit">/ mm²</span>
				</div>
				<div class="metric-sub" id="subDensity">Zero open micro-channels</div>
			</div>

			<div class="metric-card">
				<div class="metric-label">Conical Aperture Width</div>
				<div class="metric-value-box">
					<span class="metric-val" id="metricDiameter">0.00</span>
					<span class="metric-unit">µm</span>
				</div>
				<div class="metric-sub" id="subDiameter">Sealed by enamel prisms</div>
			</div>

			<div class="metric-card highlight">
				<div class="metric-label">Fluid Conductance ($r^4$)</div>
				<div class="metric-value-box">
					<span class="metric-val" id="metricFlow">1.0</span>
					<span class="metric-unit">× Base</span>
				</div>
				<div class="metric-sub" id="subFlow">Zero hydrodynamic shear</div>
			</div>

			<div class="metric-card critical">
				<div class="metric-label">Trigeminal CN V3 Output</div>
				<div class="metric-value-box">
					<span class="metric-val nerve" id="metricNerve">0</span>
					<span class="metric-unit">/ 10 Pain</span>
				</div>
				<div class="metric-sub" id="subNerve">Nociceptors quiet</div>
			</div>
		</div>

		<!-- Deep Scientific Analysis & Clinical Explanations -->
		<div class="stage-explanation-card" id="explanationCard">
			<div class="exp-header-row">
				<span class="exp-phase-badge" id="expPhaseBadge">Age 15 - Baseline</span>
				<h4 class="exp-title" id="expTitle">The Pristine Crown: Full Crystalline Enamel Insulation</h4>
			</div>
			<p class="exp-body" id="expBody">
				In youth, the cementoenamel junction (CEJ) is completely buried beneath tight gingival tissue. The crown features a 2.0 to 2.5 mm cap of impenetrable hydroxyapatite enamel crystals. Because dentinal tubules are sealed under this dense cap, thermal shifts and oral fluids exert zero hydrodynamic pull on the underlying odontoblasts, keeping the Trigeminal Mandibular Canal (CN V3) completely&nbsp;silent.
			</p>
			
			<div class="exp-scientific-grid" id="expScienceGrid">
				<div class="science-box">
					<div class="science-box-title">Why Tubules Are Conical (Funnel-Shaped)</div>
					<p class="science-box-desc">
						Tubules originate at the small surface of the pulp chamber (up to 65,000/mm², 2.8µm diameter) and radiate outward to a much larger enamel surface area (15,000/mm², 0.8µm diameter). They are natural tapered cones!
					</p>
				</div>
				<div class="science-box">
					<div class="science-box-title">The Danger of Dentin Thinning</div>
					<p class="science-box-desc">
						As wear slices into dentin, it does not just remove surface matter; it cuts into wider portions of the cone. By Poiseuille's Law, doubling tubule radius increases fluid flow by 16-fold ($r^4$), turning mild wear into explosive pain.
					</p>
				</div>
			</div>
		</div>

	</div>
</div>

<style>
	.enamel-anim-wrapper {
		margin: 3.5rem 0;
		width: 100%;
		box-sizing: border-box;
	}

	.enamel-anim-card {
		background: radial-gradient(120% 120% at 50% 0%, #1e1136 0%, #0d081a 60%, #080410 100%);
		border: 1px solid rgba(168, 85, 247, 0.35);
		border-radius: 1.5rem;
		padding: clamp(1.25rem, 3vw, 2.5rem);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		color: #e2e8f0;
	}

	.enamel-anim-header {
		text-align: center;
		margin-bottom: 2rem;
		max-width: 860px;
		margin-left: auto;
		margin-right: auto;
	}

	.enamel-anim-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(1.4rem, 2.8vw, 2.1rem);
		font-weight: 900;
		color: #ffffff;
		margin: 0 0 0.85rem 0;
		line-height: 1.25;
		text-wrap: balance;
		letter-spacing: -0.02em;
	}

	.enamel-anim-subtitle {
		font-size: clamp(0.95rem, 1.6vw, 1.05rem);
		line-height: 1.65;
		color: #cbd5e1;
		margin: 0;
		text-wrap: pretty;
	}

	/* View Mode Toggle */
	.view-mode-toggle {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
	}

	.view-btn {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(168, 85, 247, 0.28);
		border-radius: 0.85rem;
		padding: 0.65rem 1.25rem;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: #cbd5e1;
		transition: all 0.2s ease;
	}

	.view-btn:hover {
		background: rgba(168, 85, 247, 0.15);
		color: #ffffff;
		border-color: rgba(168, 85, 247, 0.5);
	}

	.view-btn.active {
		background: linear-gradient(135deg, rgba(168, 85, 247, 0.3) 0%, rgba(126, 34, 206, 0.5) 100%);
		border-color: #c084fc;
		color: #ffffff;
		box-shadow: 0 0 16px rgba(168, 85, 247, 0.4);
	}

	.view-icon {
		font-size: 1.1rem;
	}

	/* Age Button Grid */
	.age-button-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	@media (max-width: 768px) {
		.age-button-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.age-btn {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(168, 85, 247, 0.22);
		border-radius: 0.85rem;
		padding: 0.85rem 0.75rem;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.25rem;
		transition: all 0.2s ease;
		color: #e2e8f0;
		text-align: left;
	}

	.age-btn:hover {
		background: rgba(168, 85, 247, 0.12);
		border-color: rgba(168, 85, 247, 0.45);
	}

	.age-btn.active {
		background: linear-gradient(135deg, rgba(168, 85, 247, 0.25) 0%, rgba(147, 51, 234, 0.38) 100%);
		border-color: #c084fc;
		box-shadow: 0 0 14px rgba(168, 85, 247, 0.3);
	}

	.age-badge-text {
		font-size: 0.82rem;
		font-weight: 800;
		color: #c084fc;
	}

	.age-btn.active .age-badge-text {
		color: #fde047;
	}

	.age-state {
		font-size: 0.84rem;
		font-weight: 600;
		color: #ffffff;
		line-height: 1.25;
	}

	/* Simulation Viewport & Modes */
	.simulation-viewport-container {
		background: #06020d;
		border: 1px solid rgba(168, 85, 247, 0.3);
		border-radius: 1.25rem;
		padding: 0.85rem;
		margin-bottom: 1.5rem;
		position: relative;
		overflow: hidden;
	}

	.simulation-viewport-container[data-mode="anatomical"] .conical-pane {
		display: none;
	}

	.simulation-viewport-container[data-mode="conical"] .anatomical-pane {
		display: none;
	}

	.simulation-viewport-container[data-mode="split"] {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	@media (max-width: 900px) {
		.simulation-viewport-container[data-mode="split"] {
			grid-template-columns: 1fr;
		}
	}

	/* 3D Anatomical Stage */
	.tooth-render-stage {
		position: relative;
		width: 100%;
		border-radius: 0.85rem;
		overflow: hidden;
		background: #020106;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.tooth-base-image {
		width: 100%;
		height: auto;
		display: block;
		object-fit: contain;
		max-height: 580px;
	}

	#toothOverlayCanvas {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	/* Hotspot Callouts */
	.hotspot-badge {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		background: rgba(12, 6, 24, 0.9);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(168, 85, 247, 0.45);
		padding: 0.45rem 0.85rem;
		border-radius: 0.75rem;
		box-shadow: 0 4px 16px rgba(0,0,0,0.6);
		pointer-events: none;
		transition: all 0.3s ease;
	}

	.abfraction-badge {
		top: 28%;
		left: 3%;
		max-width: 260px;
	}

	.nerve-badge {
		bottom: 5%;
		right: 3%;
		max-width: 280px;
	}

	@media (max-width: 600px) {
		.hotspot-badge {
			display: none;
		}
	}

	.hotspot-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #22c55e;
		box-shadow: 0 0 8px #22c55e;
		flex-shrink: 0;
	}

	.hotspot-dot.warning {
		background: #eab308;
		box-shadow: 0 0 10px #eab308;
	}

	.hotspot-dot.danger {
		background: #ef4444;
		box-shadow: 0 0 12px #ef4444;
		animation: pulseRed 1s infinite alternate;
	}

	.hotspot-dot.nerve {
		background: #38bdf8;
		box-shadow: 0 0 8px #38bdf8;
	}

	.hotspot-dot.nerve.firing {
		background: #ef4444;
		box-shadow: 0 0 14px #ef4444;
	}

	.hotspot-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.hotspot-info strong {
		font-size: 0.82rem;
		color: #ffffff;
		line-height: 1.2;
	}

	.hotspot-info span {
		font-size: 0.72rem;
		color: #cbd5e1;
		line-height: 1.25;
	}

	/* Conical View Stage */
	.conical-pane {
		background: #070311;
		border-radius: 0.85rem;
		padding: 1rem;
		display: flex;
		flex-direction: column;
		border: 1px solid rgba(168, 85, 247, 0.25);
	}

	.conical-header-bar {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.85rem;
		flex-wrap: wrap;
	}

	.conical-title-wrap {
		flex: 1;
		min-width: 240px;
	}

	.conical-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: 1.08rem;
		font-weight: 800;
		color: #ffffff;
		margin: 0 0 0.35rem 0;
		line-height: 1.3;
	}

	.conical-subtitle {
		font-size: 0.82rem;
		line-height: 1.5;
		color: #cbd5e1;
		margin: 0;
	}

	.conical-rdt-pill {
		background: rgba(253, 224, 71, 0.12);
		border: 1px solid rgba(253, 224, 71, 0.35);
		border-radius: 0.6rem;
		padding: 0.4rem 0.8rem;
		font-size: 0.82rem;
		color: #fde047;
		white-space: nowrap;
	}

	.conical-canvas-box {
		width: 100%;
		border-radius: 0.75rem;
		overflow: hidden;
		background: #030107;
		border: 1px solid rgba(168, 85, 247, 0.2);
	}

	#conicalCanvas {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 900 / 460;
	}

	.conical-legend-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		margin-top: 0.75rem;
		padding: 0.4rem 0.2rem;
	}

	.legend-chip {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.76rem;
		color: #cbd5e1;
	}

	.chip-color {
		width: 12px;
		height: 12px;
		border-radius: 3px;
	}

	.chip-color.outer { background: #e2e8f0; }
	.chip-color.dentin { background: #92632b; }
	.chip-color.tubule { background: #fde047; }
	.chip-color.pulp { background: #dc2626; }

	/* Slider Bar Controls */
	.slider-control-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.85rem 0.5rem 0.4rem;
		flex-wrap: wrap;
		margin-bottom: 1.25rem;
	}

	.slider-left {
		flex: 1;
		min-width: 280px;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.slider-header-flex {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.9rem;
	}

	.slider-label {
		color: #cbd5e1;
		font-weight: 600;
	}

	.slider-label strong {
		color: #fde047;
		margin-left: 0.25rem;
	}

	.recession-readout {
		font-size: 0.85rem;
		font-weight: 800;
		color: #c084fc;
	}

	.age-range-input {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 8px;
		border-radius: 4px;
		background: linear-gradient(90deg, #22c55e 0%, #eab308 50%, #ef4444 100%);
		outline: none;
		cursor: pointer;
	}

	.age-range-input::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: #ffffff;
		border: 3px solid #9333ea;
		box-shadow: 0 0 12px rgba(168, 85, 247, 0.8);
		cursor: pointer;
		transition: transform 0.15s ease;
	}

	.age-range-input::-webkit-slider-thumb:hover {
		transform: scale(1.15);
	}

	.slider-ticks {
		display: flex;
		justify-content: space-between;
		font-size: 0.72rem;
		color: #94a3b8;
		padding: 0 4px;
	}

	.slider-actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.anim-action-btn {
		background: #9333ea;
		color: #ffffff;
		border: none;
		border-radius: 0.65rem;
		padding: 0.6rem 1.15rem;
		font-size: 0.86rem;
		font-weight: 700;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
