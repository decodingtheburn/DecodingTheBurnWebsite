<script is:inline>
(() => {
	// Containers & Controls
	const simContainer = document.getElementById('simContainer');
	const viewButtons = document.querySelectorAll('.view-btn');
	const ageButtons = document.querySelectorAll('.age-btn');
	const ageSlider = document.getElementById('ageSlider');
	const ageDisplay = document.getElementById('ageDisplay');
	const recessionReadout = document.getElementById('recessionReadout');
	const playPauseBtn = document.getElementById('playPauseBtn');
	const playIcon = document.getElementById('playIcon');
	const playText = document.getElementById('playText');
	const resetBtn = document.getElementById('resetBtn');

	// Canvases
	const toothCanvas = document.getElementById('toothOverlayCanvas');
	const toothCtx = toothCanvas ? toothCanvas.getContext('2d') : null;
	const conicalCanvas = document.getElementById('conicalCanvas');
	const conicalCtx = conicalCanvas ? conicalCanvas.getContext('2d') : null;

	// Floating Badges on 3D Tooth
	const badgeWearTitle = document.getElementById('badgeWearTitle');
	const badgeWearDesc = document.getElementById('badgeWearDesc');
	const badgeNerveDesc = document.getElementById('badgeNerveDesc');
	const rdtPill = document.getElementById('rdtPill');

	// Telemetry Metrics
	const metricRecession = document.getElementById('metricRecession');
	const subRecession = document.getElementById('subRecession');
	const metricRdt = document.getElementById('metricRdt');
	const subRdt = document.getElementById('subRdt');
	const metricDensity = document.getElementById('metricDensity');
	const subDensity = document.getElementById('subDensity');
	const metricDiameter = document.getElementById('metricDiameter');
	const subDiameter = document.getElementById('subDiameter');
	const metricFlow = document.getElementById('metricFlow');
	const subFlow = document.getElementById('subFlow');
	const metricNerve = document.getElementById('metricNerve');
	const subNerve = document.getElementById('subNerve');

	// Explanations
	const expPhaseBadge = document.getElementById('expPhaseBadge');
	const expTitle = document.getElementById('expTitle');
	const expBody = document.getElementById('expBody');

	let currentAge = 15;
	let isPlaying = false;
	let animReqId = null;
	let playDirection = 1;
	let frameCount = 0;

	// View Switcher logic
	viewButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			viewButtons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
			const mode = btn.getAttribute('data-view');
			if (simContainer) simContainer.setAttribute('data-mode', mode);
		});
	});

	// Age Milestones Data
	const ageMilestones = [
		{
			age: 15,
			label: "Age 15 (Pristine Shield)",
			recession: 0.0,
			rdt: 3.00,
			density: 0,
			diameter: 0.00,
			flowMultiplier: 1.0,
			nerveScore: 0,
			wearTitle: "Enamel Intact (2.5mm)",
			wearDesc: "Gingival collar tightly wraps CEJ",
			nerveDesc: "Trigeminal CN V3 quiet, zero stimulus",
			phase: "Age 15 - Baseline Youth",
			title: "The Pristine Crown: Full Crystalline Enamel Insulation",
			body: "In youth, the cementoenamel junction (CEJ) is completely buried beneath tight gingival tissue. The crown features a 2.0 to 2.5 mm cap of impenetrable hydroxyapatite enamel crystals. Because dentinal tubules are sealed under this dense cap, thermal shifts and oral fluids exert zero hydrodynamic pull on the underlying odontoblasts, keeping the Trigeminal Mandibular Canal (CN V3) completely silent.",
			subRecession: "Gums seal root cementum",
			subRdt: "Full insulation over pulp",
			subDensity: "Zero open micro-channels",
			subDiameter: "Sealed by enamel prisms",
			subFlow: "Zero hydrodynamic shear",
			subNerve: "Nociceptors quiet"
		},
		{
			age: 30,
			label: "Age 30 (Early Cervical Wear)",
			recession: 0.8,
			rdt: 2.45,
			density: 8500,
			diameter: 0.85,
			flowMultiplier: 4.5,
			nerveScore: 2,
			wearTitle: "Early Wear & Micro-Fissures",
			wearDesc: "0.8mm recession exposes cervical margin",
			nerveDesc: "Transient twinges on cold liquids",
			phase: "Age 30 - Early Demineralization",
			title: "Early Acid Softening & Incipient Cervical Recession",
			body: "After 15 years of dietary acids (carbonated beverages, coffee, citrus) and nocturnal grinding, the enamel at the cervical fulcrum begins micro-fracturing. Gums recede by 0.8 mm. Approximately 8,500 narrow tubule tips (0.85 µm diameter) become exposed. While smear plugs partially seal the openings, rapid temperature drops cause minor fluid contractions, firing occasional sharp spikes in A-delta fibers.",
			subRecession: "Early apical migration",
			subRdt: "Minor superficial dentin loss",
			subDensity: "Narrow peripheral tubule tips",
			subDiameter: "Outer cone aperture opening",
			subFlow: "Mild fluid oscillation",
			subNerve: "Transient twinges (2/10)"
		},
		{
			age: 45,
			label: "Age 45 (Abfraction Notch)",
			recession: 1.8,
			rdt: 1.60,
			density: 24000,
			diameter: 1.65,
			flowMultiplier: 28.0,
			nerveScore: 6,
			wearTitle: "Active Abfraction Notch",
			wearDesc: "1.8mm recession with smear plug dissolution",
			nerveDesc: "A-delta & C-fibers actively firing",
			phase: "Age 45 - Biomechanical Abfraction",
			title: "The Abfraction Fulcrum: Deep Cervical Wedge & Smear Loss",
			body: "Tensile stresses from clenching flex the tooth at the cervical fulcrum like bending an iron rod. Enamel rods pop off, creating a wedge-shaped abfraction notch. 1.8 mm of gum recession exposes porous root dentin. Over 24,000 tubules communicate with saliva. Acidic foods dissolve the smear plugs, widening tubule apertures to 1.65 µm and driving a 28-fold surge in fluid conductance via Poiseuille's law.",
			subRecession: "Root dentin exposed",
			subRdt: "Significant wall thinning",
			subDensity: "Thousands of active micro-pipes",
			subDiameter: "Expanding deeper down the cone",
			subFlow: "28x fluid flow surge (r⁴ law)",
			subNerve: "Sharp localized pain (6/10)"
		},
		{
			age: 60,
			label: "Age 60+ (Severe Breach & Thinning)",
			recession: 2.6,
			rdt: 0.55,
			density: 45000,
			diameter: 2.75,
			flowMultiplier: 95.0,
			nerveScore: 10,
			wearTitle: "Severe Dentin Thinning (0.55mm RDT)",
			wearDesc: "45,000 wide conical tubules firing into CN V3",
			nerveDesc: "Non-stop 10/10 radiating burning mouth cascade",
			phase: "Age 60+ - Full Neuropathic Cascade",
			title: "Dentin Wall Thinning & Chronic Trigeminal Ignition",
			body: "The remaining dentin barrier over the pulp horn is shaved down to a paper-thin 0.55 mm. Because dentinal tubules are cones that funnel inward towards the pulp, deep wear cuts into their widest diameters (2.75 µm) and densest packing (45,000 tubules/mm²). Fluid conductance explodes by 95-fold. Odontoblasts dump ATP onto P2X3/P2X7 receptors, unleashing Substance P and CGRP in a non-stop radiating oral burning firestorm.",
			subRecession: "Severe cervical exposure",
			subRdt: "Critically compromised (<0.6mm)",
			subDensity: "Massive open tubule field",
			subDiameter: "Maximal cone lumen width",
			subFlow: "95x maximum hydraulic rush",
			subNerve: "Continuous radiating burn (10/10)"
		}
	];

	function interpolate(age) {
		const t = Math.max(0, Math.min(1, (age - 15) / 50)); // 0 at 15, 1 at 65
		
		const recession = (t * 2.6).toFixed(1);
		const rdt = (3.00 - t * 2.45).toFixed(2);
		const density = Math.round(t * 45000);
		const diameter = (t * 2.75).toFixed(2);
		const flowMultiplier = (1.0 + Math.pow(t, 2.5) * 94.0).toFixed(1);
		const nerveScore = Math.min(10, Math.round(t * 10));

		let milestoneIdx = 0;
		if (age < 25) milestoneIdx = 0;
		else if (age < 40) milestoneIdx = 1;
		else if (age < 55) milestoneIdx = 2;
		else milestoneIdx = 3;

		const m = ageMilestones[milestoneIdx];

		return {
			t,
			age,
			recession,
			rdt,
			density,
			diameter,
			flowMultiplier,
			nerveScore,
			wearTitle: age > 50 ? "Severe Dentin Thinning (<0.6mm RDT)" : age > 35 ? "Active Abfraction Notch" : age > 22 ? "Early Cervical Wear" : "Enamel Intact (2.5mm)",
			wearDesc: age > 50 ? `${density.toLocaleString()} tubules firing into CN V3` : age > 35 ? `${recession}mm recession with smear dissolution` : age > 22 ? `${recession}mm recession exposes cervical neck` : "Gingival collar tightly wraps CEJ",
			nerveDesc: nerveScore >= 8 ? "Continuous 10/10 radiating burning mouth cascade" : nerveScore >= 5 ? "A-delta & C-fibers actively firing" : nerveScore >= 2 ? "Transient twinges on cold / sweetness" : "Trigeminal CN V3 quiet, zero stimulus",
			milestone: m
		};
	}

	function updateTelemetry(age) {
		currentAge = age;
		const d = interpolate(age);

		// Labels & Sliders
		ageDisplay.innerText = `Age ${age} (${age <= 20 ? 'Youth' : age <= 35 ? 'Early Wear' : age <= 50 ? 'Abfraction Notch' : 'Severe Breach'})`;
		recessionReadout.innerText = `${d.recession} mm Gum Recession`;
		if (rdtPill) rdtPill.innerHTML = `Remaining Dentin: <strong>${d.rdt} mm</strong>`;

		// Floating Badges on 3D Tooth
		if (badgeWearTitle) badgeWearTitle.innerText = d.wearTitle;
		if (badgeWearDesc) badgeWearDesc.innerText = d.wearDesc;
		if (badgeNerveDesc) badgeNerveDesc.innerText = d.nerveDesc;

		const abDot = document.querySelector('.abfraction-badge .hotspot-dot');
		if (abDot) {
			abDot.className = 'hotspot-dot ' + (d.nerveScore > 7 ? 'danger' : d.nerveScore > 3 ? 'warning' : '');
		}
		const nvDot = document.querySelector('.nerve-badge .hotspot-dot');
		if (nvDot) {
			nvDot.className = 'hotspot-dot nerve ' + (d.nerveScore > 4 ? 'firing' : '');
		}

		// Metrics Dashboard
		metricRecession.innerText = d.recession;
		subRecession.innerText = d.milestone.subRecession;

		metricRdt.innerText = d.rdt;
		subRdt.innerText = d.milestone.subRdt;

		metricDensity.innerText = d.density.toLocaleString();
		subDensity.innerText = d.milestone.subDensity;

		metricDiameter.innerText = d.diameter;
		subDiameter.innerText = d.milestone.subDiameter;

		metricFlow.innerText = d.flowMultiplier;
		subFlow.innerText = d.milestone.subFlow;

		metricNerve.innerText = d.nerveScore;
		subNerve.innerText = d.milestone.subNerve;

		// Explanation Card
		expPhaseBadge.innerText = d.milestone.phase;
		expTitle.innerText = d.milestone.title;
		expBody.innerHTML = d.milestone.body.replace(/([a-zA-Z0-9]+)\s+([a-zA-Z0-9.,]+)$/, '$1&nbsp;$2');

		// Age Step Buttons sync
		ageButtons.forEach((btn) => {
			const bAge = parseInt(btn.getAttribute('data-age'), 10);
			btn.classList.toggle('active', Math.abs(bAge - age) <= 7);
		});
	}

	// 1. Draw 3D Tooth Overlay Canvas (Abfraction Erosion Notch, Exposed Tubules Glow & Trigeminal Nerves)
	function drawToothOverlay() {
		if (!toothCtx) return;
		const w = toothCanvas.width;
		const h = toothCanvas.height;
		toothCtx.clearRect(0, 0, w, h);

		const t = Math.max(0, Math.min(1, (currentAge - 15) / 50)); // 0 to 1

		// The cervical region on the left is roughly centered around X=420, Y=330 in this 1200x896 graphic
		const cx = 415;
		const cy = 345;

		if (t > 0.05) {
			// A. Cervical Abfraction Erosion Wedge Overlay
			const notchDepth = t * 38; // px into dentin
			const notchHeight = t * 65; // px along cervical height

			toothCtx.save();
			// Draw red/orange glowing aura where erosion is carving the wedge
			const wedgeGlow = toothCtx.createRadialGradient(cx, cy, 5, cx, cy, 60);
			wedgeGlow.addColorStop(0, `rgba(239, 68, 68, ${0.4 + t * 0.4})`);
			wedgeGlow.addColorStop(0.5, `rgba(245, 158, 11, ${0.3 + t * 0.3})`);
			wedgeGlow.addColorStop(1, 'rgba(239, 68, 68, 0)');
			toothCtx.fillStyle = wedgeGlow;
			toothCtx.beginPath();
			toothCtx.arc(cx, cy, 45 + t * 25, 0, Math.PI * 2);
			toothCtx.fill();

			// Draw pulsing open tubule pores on the exposed root face
			const tubuleCount = Math.floor(t * 36);
			for (let i = 0; i < tubuleCount; i++) {
				const px = cx - 18 + Math.sin(i * 1.7 + frameCount * 0.03) * (14 + t * 12);
				const py = cy - notchHeight / 2 + (i / tubuleCount) * notchHeight;
				const rad = 1.5 + t * 2.2;

				toothCtx.fillStyle = (frameCount % 10 < 5) ? '#fef08a' : '#ef4444';
				toothCtx.beginPath();
				toothCtx.arc(px, py, rad, 0, Math.PI * 2);
				toothCtx.fill();
			}

			// Draw acid penetration arrows entering the cervical wedge
			if (t > 0.25) {
				const arrowCount = Math.floor(t * 4);
				for (let a = 0; a < arrowCount; a++) {
					const ax = cx - 60 - a * 15;
					const ay = cy - 20 + a * 18;
					toothCtx.strokeStyle = '#fde047';
					toothCtx.lineWidth = 2.5;
					toothCtx.beginPath();
					toothCtx.moveTo(ax, ay);
					toothCtx.lineTo(ax + 20, ay);
					toothCtx.stroke();
					// Arrow head
					toothCtx.beginPath();
					toothCtx.moveTo(ax + 14, ay - 4);
					toothCtx.lineTo(ax + 20, ay);
					toothCtx.lineTo(ax + 14, ay + 4);
					toothCtx.stroke();
				}
			}
			toothCtx.restore();
		}

		// B. Trigeminal Nerve Action Potential Cascades (Traveling from Pulp down to Mandibular Canal)
		if (t > 0.15) {
			toothCtx.save();
			// Root canal paths (Left root apex ~ X=435, Y=740; Right root apex ~ X=590, Y=740)
			// Mandibular horizontal canal ~ Y=750 to 765
			const sparkCount = Math.floor(t * 12);
			toothCtx.fillStyle = (t > 0.6) ? '#ef4444' : '#eab308';
			toothCtx.shadowColor = toothCtx.fillStyle;
			toothCtx.shadowBlur = 10;

			// Left Root Canal Nerve Pulses
			for (let s = 0; s < sparkCount; s++) {
				const progress = ((frameCount * 0.03 + s * 0.15) % 1);
				const nx = 480 - progress * 45;
				const ny = 350 + progress * 390;
				toothCtx.beginPath();
				toothCtx.arc(nx, ny, 3 + t * 3, 0, Math.PI * 2);
				toothCtx.fill();
			}

			// Horizontal Mandibular Canal Surge (Trigeminal CN V3 at bottom)
			for (let m = 0; m < sparkCount * 1.5; m++) {
				const mProgress = ((frameCount * 0.05 + m * 0.12) % 1);
				const mx = 340 + mProgress * 580;
				const my = 753 + Math.sin(mx * 0.08) * 3;
				toothCtx.beginPath();
				toothCtx.arc(mx, my, 2.5 + t * 3.5, 0, Math.PI * 2);
				toothCtx.fill();
			}

			toothCtx.restore();
		}
	}

	// 2. Draw Microscopic Conical Tubule Canvas (Proves Conical Shape + Dentin Wall Thinning)
	function drawConicalZoom() {
		if (!conicalCtx) return;
		const w = conicalCanvas.width;
		const h = conicalCanvas.height;
		conicalCtx.clearRect(0, 0, w, h);

		const t = Math.max(0, Math.min(1, (currentAge - 15) / 50)); // 0 to 1

		// Layers from Left (Outer Tooth Surface / Oral Acid) to Right (Pulp Chamber / Trigeminal Nerves)
		// Total dentin zone width: ~600px
		// As age progresses, the outer surface is eaten away inward (erosion moving left to right)
		const maxDentinWidth = 560;
		const erosionDepth = t * (maxDentinWidth * 0.82); // Dentin thins down by up to 82%!
		
		const outerSurfaceX = 90 + erosionDepth; // Eroding boundary
		const pulpBorderX = 90 + maxDentinWidth; // Inner pulp boundary

		// A. Background (Dark deep microscopic field)
		conicalCtx.fillStyle = '#06020c';
		conicalCtx.fillRect(0, 0, w, h);

		// B. Oral Cavity / Acid Zone (Left of outerSurfaceX)
		const oralGrad = conicalCtx.createLinearGradient(0, 0, outerSurfaceX, 0);
		oralGrad.addColorStop(0, 'rgba(168, 85, 247, 0.1)');
		oralGrad.addColorStop(1, 'rgba(239, 68, 68, 0.25)');
		conicalCtx.fillStyle = oralGrad;
		conicalCtx.fillRect(0, 0, outerSurfaceX, h);

		// Oral Cavity Label
		conicalCtx.fillStyle = '#c084fc';
		conicalCtx.font = 'bold 12px system-ui, sans-serif';
		conicalCtx.fillText('ORAL CAVITY: SALIVA & ACID PROTONS (H⁺)', 20, 30);

		// C. Dentin Matrix (From outerSurfaceX to pulpBorderX)
		const dentinGrad = conicalCtx.createLinearGradient(outerSurfaceX, 0, pulpBorderX, 0);
		dentinGrad.addColorStop(0, '#593a15');
		dentinGrad.addColorStop(0.6, '#7e531e');
		dentinGrad.addColorStop(1, '#9b6727');
		conicalCtx.fillStyle = dentinGrad;
		conicalCtx.fillRect(outerSurfaceX, 40, pulpBorderX - outerSurfaceX, h - 80);

		// D. Dental Pulp Chamber (Right of pulpBorderX)
		const pulpGrad = conicalCtx.createLinearGradient(pulpBorderX, 0, w, 0);
		pulpGrad.addColorStop(0, '#7f1d1d');
		pulpGrad.addColorStop(0.4, '#b91c1c');
		pulpGrad.addColorStop(1, '#450a0a');
		conicalCtx.fillStyle = pulpGrad;
		conicalCtx.fillRect(pulpBorderX, 40, w - pulpBorderX, h - 80);

		// Pulp Label & Odontoblast Layer
		conicalCtx.fillStyle = '#fca5a5';
		conicalCtx.font = 'bold 11px system-ui, sans-serif';
		conicalCtx.fillText('PULP TISSUE & A-DELTA / C-FIBER NERVES', pulpBorderX + 15, 30);

		// E. The Conical Dentinal Tubules (Funnel Cones widening toward Pulp!)
		const tubuleRows = 7;
		const tubuleSpacing = (h - 120) / (tubuleRows - 1);

		for (let r = 0; r < tubuleRows; r++) {
			const yCenter = 60 + r * tubuleSpacing;

			// Ideal un-eroded cone:
			// At original surface (X=90): diameter = 8px (0.8 µm)
			// At pulp wall (X=pulpBorderX): diameter = 32px (2.8 µm)
			// As outerSurfaceX moves right, the starting diameter is calculated at outerSurfaceX!
			const currentSurfaceDiameter = 8 + (erosionDepth / maxDentinWidth) * 24;
			const pulpDiameter = 32;

			// Draw Conical Tubule Boundary
			conicalCtx.beginPath();
			conicalCtx.moveTo(outerSurfaceX, yCenter - currentSurfaceDiameter / 2);
			conicalCtx.lineTo(pulpBorderX, yCenter - pulpDiameter / 2);
			conicalCtx.lineTo(pulpBorderX, yCenter + pulpDiameter / 2);
			conicalCtx.lineTo(outerSurfaceX, yCenter + currentSurfaceDiameter / 2);
			conicalCtx.closePath();

			// Tubule Interior Fill
			const tubuleGrad = conicalCtx.createLinearGradient(outerSurfaceX, 0, pulpBorderX, 0);
			if (t > 0.4) {
				tubuleGrad.addColorStop(0, 'rgba(234, 179, 8, 0.85)'); // Acid flooded
				tubuleGrad.addColorStop(0.7, 'rgba(239, 68, 68, 0.7)');
				tubuleGrad.addColorStop(1, 'rgba(220, 38, 38, 0.9)');
			} else {
				tubuleGrad.addColorStop(0, 'rgba(56, 189, 248, 0.4)'); // Normal fluid
				tubuleGrad.addColorStop(1, 'rgba(30, 58, 138, 0.6)');
			}
			conicalCtx.fillStyle = tubuleGrad;
			conicalCtx.fill();
			conicalCtx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
			conicalCtx.lineWidth = 1;
			conicalCtx.stroke();

			// Odontoblast Cellular Process Extension inside tubule
			conicalCtx.strokeStyle = '#f87171';
			conicalCtx.lineWidth = 2.5;
			conicalCtx.beginPath();
			conicalCtx.moveTo(pulpBorderX + 25, yCenter);
			conicalCtx.lineTo(outerSurfaceX + 30, yCenter);
			conicalCtx.stroke();

			// Animated Hydrodynamic Fluid Motion Particles (Flowing according to r⁴ velocity!)
			if (t > 0.15) {
				const flowVelocity = (0.01 + Math.pow(t, 2) * 0.08);
				const pCount = Math.floor(3 + t * 6);
				conicalCtx.fillStyle = t > 0.5 ? '#fde047' : '#7dd3fc';

				for (let p = 0; p < pCount; p++) {
					const pt = ((frameCount * flowVelocity + (p / pCount) + r * 0.15) % 1);
					const px = outerSurfaceX + pt * (pulpBorderX - outerSurfaceX);
					// Interpolate cone width at px
					const localWidth = currentSurfaceDiameter + pt * (pulpDiameter - currentSurfaceDiameter);
					const py = yCenter + Math.sin(pt * Math.PI * 2) * (localWidth * 0.25);

					conicalCtx.beginPath();
					conicalCtx.arc(px, py, 2 + t * 1.5, 0, Math.PI * 2);
					conicalCtx.fill();
				}
			}

			// Smear Plug at outer mouth (dissolves as t increases)
			if (t > 0.05 && t < 0.6) {
				const plugOpacity = 1 - (t / 0.6);
				conicalCtx.fillStyle = `rgba(226, 232, 240, ${plugOpacity * 0.95})`;
				conicalCtx.fillRect(outerSurfaceX - 4, yCenter - currentSurfaceDiameter / 2 - 1, 8, currentSurfaceDiameter + 2);
			}
		}

		// F. Measurement Callout Lines (Showing Remaining Dentin Thickness)
		conicalCtx.strokeStyle = '#fde047';
		conicalCtx.lineWidth = 2;
		conicalCtx.setLineDash([4, 4]);

		// Horizontal dimension bracket
		const dimY = h - 25;
		conicalCtx.beginPath();
		conicalCtx.moveTo(outerSurfaceX, dimY);
		conicalCtx.lineTo(pulpBorderX, dimY);
		conicalCtx.stroke();
		conicalCtx.setLineDash([]);

		// Dimension ticks
		conicalCtx.beginPath();
		conicalCtx.moveTo(outerSurfaceX, dimY - 6);
		conicalCtx.lineTo(outerSurfaceX, dimY + 6);
		conicalCtx.moveTo(pulpBorderX, dimY - 6);
		conicalCtx.lineTo(pulpBorderX, dimY + 6);
		conicalCtx.stroke();

		// RDT Text in bracket
		conicalCtx.fillStyle = '#fde047';
		conicalCtx.font = 'bold 12px system-ui, sans-serif';
		const rdtVal = (3.00 - t * 2.45).toFixed(2);
		conicalCtx.fillText(`Remaining Dentin Thickness (RDT): ${rdtVal} mm`, outerSurfaceX + 15, dimY - 8);

		// Conical funnel annotation
		conicalCtx.fillStyle = '#ffffff';
		conicalCtx.font = 'bold 11px system-ui, sans-serif';
		conicalCtx.fillText(`Aperture: ${(t * 2.75).toFixed(2)} µm`, outerSurfaceX - 90, 85);
		conicalCtx.fillText(`Pulp Base: 2.80 µm`, pulpBorderX + 15, 85);
	}

	function renderLoop() {
		frameCount++;
		drawToothOverlay();
		drawConicalZoom();
		animReqId = requestAnimationFrame(renderLoop);
	}

	// Slider Listener
	ageSlider?.addEventListener('input', (e) => {
		const val = parseInt(e.target.value, 10);
		updateTelemetry(val);
	});

	// Age Buttons Listener
	ageButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const targetAge = parseInt(btn.getAttribute('data-age'), 10);
			ageSlider.value = targetAge;
			updateTelemetry(targetAge);
		});
	});

	// Auto Play Arc
	function togglePlay() {
		isPlaying = !isPlaying;
		if (isPlaying) {
			playIcon.innerText = '⏸';
			playText.innerText = 'Pause';
			autoStep();
		} else {
			playIcon.innerText = '▶';
			playText.innerText = 'Play 50-Year Arc';
		}
	}

	function autoStep() {
		if (!isPlaying) return;
		let val = parseInt(ageSlider.value, 10);
		val += playDirection * 1;

		if (val >= 65) {
			val = 65;
			playDirection = -1;
		} else if (val <= 15) {
			val = 15;
			playDirection = 1;
		}

		ageSlider.value = val;
		updateTelemetry(val);
		setTimeout(autoStep, 80);
	}

	playPauseBtn?.addEventListener('click', togglePlay);

	// Reset
	resetBtn?.addEventListener('click', () => {
		isPlaying = false;
		playIcon.innerText = '▶';
		playText.innerText = 'Play 50-Year Arc';
		ageSlider.value = 15;
		updateTelemetry(15);
	});

	// Init
	updateTelemetry(15);
	renderLoop();
})();
</script>
