  },
  {
    id: "sparkling-water",
    name: "Sparkling Water & Carbonated Beverages",
    icon: "🫧",
    desc: "Dissolved carbon dioxide creates carbonic acid (pH 3.0–4.5), lowering oral pH and continuously firing ASIC3 acid receptors across sensitized mucosal tissue."
  },
  {
    id: "fruits",
