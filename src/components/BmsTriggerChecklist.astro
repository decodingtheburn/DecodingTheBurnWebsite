const selectedList = listType === 'personal' ? personalTriggers : top20Triggers;
---

<div class="discoveries-container">
	<div class="discoveries-stack">
		{selectedList.map((trigger, index) => (
			<div class="discovery-card">
				<div class="discovery-number">Item #{index + 1}</div>
				<div class="discovery-emoji-single">
					<span class="discovery-emoji-item">{trigger.icon}</span>
				</div>
				<h4 class="discovery-title">{trigger.name}</h4>
				<p class="discovery-desc">
					<strong>Potential causes of the BMS increase or pain increase:</strong> {trigger.desc}
				</p>
			</div>
		))}
	</div>
</div>

<style>
	.discoveries-container {
		width: 100%;
		margin: 2.75rem 0;
		display: flex;
		justify-content: center;
	}

	.discoveries-stack {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.25rem;
		width: 100%;
	}

	.discovery-card {
		background: #ffffff;
		border: 1.5px solid #e2e8f0;
		border-radius: 1.5rem;
		width: 82%;
		max-width: 46ch;
		padding: 2.75rem 2.25rem 2.5rem 2.25rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		box-shadow: 0 18px 45px rgba(15, 23, 42, 0.09), 0 4px 14px rgba(15, 23, 42, 0.04);
		transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
		box-sizing: border-box;
	}

	.discovery-card:hover {
		transform: translateY(-4px);
		border-color: #cbd5e1;
		box-shadow: 0 24px 54px rgba(15, 23, 42, 0.13), 0 6px 18px rgba(124, 58, 237, 0.09);
	}

	.discovery-number {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: 0.95rem;
		font-weight: 800;
		color: #7c3aed;
		letter-spacing: 0.03em;
		margin-bottom: 0.95rem;
		text-transform: uppercase;
	}

	.discovery-emoji-single {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1.25rem;
	}

	.discovery-emoji-item {
		font-size: 3.65rem;
		line-height: 1;
		filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.14));
		display: inline-block;
		transition: transform 0.25s ease;
	}

	.discovery-card:hover .discovery-emoji-item {
		transform: scale(1.12);
	}

	.discovery-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(1.35rem, 2.2vw, 1.65rem);
		font-weight: 900;
		color: #0f172a;
		margin: 0 0 0.95rem 0;
		letter-spacing: -0.02em;
		line-height: 1.22;
		text-wrap: balance;
	}

	.discovery-desc {
		font-size: 1.02rem;
		color: #334155;
		line-height: 1.58;
		margin: 0;
		text-wrap: pretty;
	}

	.discovery-desc strong {
		color: #0f172a;
		font-weight: 800;
	}

	@media (max-width: 640px) {
		.discovery-card {
			width: 100%;
			max-width: 100%;
			padding: 2.25rem 1.35rem 2rem 1.35rem;
		}

		.discovery-emoji-item {
			font-size: 2.85rem;
		}
	}
</style>
