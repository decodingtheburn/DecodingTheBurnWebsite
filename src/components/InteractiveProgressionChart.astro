---
// InteractiveProgressionChart.astro - Universal Interactive BMS Pain Progression Graph (0-10 Scale over 3 Years)
interface Props {
	class?: string;
	title?: string;
}

const {
	class: className = '',
	title = "My 3-Year BMS Progression"
} = Astro.props;
---

<div class={`interactive-progression-container ${className}`} id="bms-progression-widget">
	<!-- Header -->
	<div class="widget-header">
		<h3 class="widget-title">{title}</h3>
	</div>

	<!-- Chart Box -->
	<div class="chart-wrapper" id="chart-scroll-container">
		<div class="chart-canvas-inner">
			<!-- SVG Data Canvas -->
			<svg 
				id="progression-svg" 
				viewBox="0 0 1300 480" 
				class="progression-svg" 
				preserveAspectRatio="xMidYMid meet"
			>
				<defs>
					<!-- Gradients for Curve and Zones -->
					<linearGradient id="curveGradient" x1="0%" y1="0%" x2="100%" y2="0%">
						<stop offset="0%" stop-color="#10b981" />
						<stop offset="8%" stop-color="#ef4444" />
						<stop offset="18%" stop-color="#10b981" />
						<stop offset="25%" stop-color="#f59e0b" />
						<stop offset="35%" stop-color="#10b981" />
						<stop offset="42%" stop-color="#f59e0b" />
						<stop offset="50%" stop-color="#10b981" />
						<stop offset="55%" stop-color="#ef4444" />
						<stop offset="63%" stop-color="#10b981" />
						<stop offset="68%" stop-color="#ef4444" />
						<stop offset="72%" stop-color="#06b6d4" />
						<stop offset="76%" stop-color="#f59e0b" />
						<stop offset="86%" stop-color="#f59e0b" />
						<stop offset="90%" stop-color="#10b981" />
						<stop offset="100%" stop-color="#10b981" />
					</linearGradient>

					<linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
						<stop offset="0%" stop-color="rgba(239, 68, 68, 0.22)" />
						<stop offset="50%" stop-color="rgba(245, 158, 11, 0.12)" />
						<stop offset="100%" stop-color="rgba(16, 185, 129, 0.02)" />
					</linearGradient>

					<!-- Glow Filter -->
					<filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
						<feGaussianBlur stdDeviation="3.5" result="blur" />
						<feMerge>
							<feMergeNode in="blur" />
							<feMergeNode in="SourceGraphic" />
						</feMerge>
					</filter>

					<!-- Arrow Markers -->
					<marker id="arrowRed" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#ef4444" />
					</marker>
					<marker id="arrowAmber" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#f59e0b" />
					</marker>
					<marker id="arrowCyan" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#06b6d4" />
					</marker>
					<marker id="arrowGreen" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#10b981" />
					</marker>
				</defs>

				<!-- Background Severity Bands -->
				<!-- Red Zone: Severe (Pain 7-10) -> Y: 60 to 168 -->
				<rect x="70" y="60" width="1190" height="108" fill="rgba(239, 68, 68, 0.05)" />
				<text x="1250" y="80" class="zone-label zone-red">Severe (8 to 10)</text>

				<!-- Amber Zone: Moderate / Yo-Yo (Pain 3-6) -> Y: 168 to 312 -->
				<rect x="70" y="168" width="1190" height="144" fill="rgba(245, 158, 11, 0.04)" />
				<text x="1250" y="188" class="zone-label zone-amber">Yo-Yo Zone (2 to 5)</text>

				<!-- Green Zone: Baseline / Remission (Pain 0-2) -> Y: 312 to 420 -->
				<rect x="70" y="312" width="1190" height="108" fill="rgba(16, 185, 129, 0.05)" />
				<text x="1250" y="405" class="zone-label zone-green">Remission (0 to 1)</text>

				<!-- Horizontal Grid Lines & Y-Axis Labels (0 to 10 Scale) -->
				<!-- Pain 10: Y=60, Pain 8: Y=132, Pain 5: Y=240, Pain 2: Y=348, Pain 0: Y=420 -->
				<g class="grid-lines">
					<line x1="70" y1="60" x2="1250" y2="60" class="grid-line line-10" />
					<text x="55" y="65" class="axis-label y-val">10</text>

					<line x1="70" y1="132" x2="1250" y2="132" class="grid-line" />
					<text x="55" y="137" class="axis-label y-val">8</text>

					<line x1="70" y1="240" x2="1250" y2="240" class="grid-line line-highlight" />
					<text x="55" y="245" class="axis-label y-val val-5">5</text>

					<line x1="70" y1="348" x2="1250" y2="348" class="grid-line" />
					<text x="55" y="353" class="axis-label y-val">2</text>

					<line x1="70" y1="420" x2="1250" y2="420" class="grid-line axis-x-base" />
					<text x="55" y="425" class="axis-label y-val">0</text>
				</g>

				<!-- Phase Divider: Carnivore Yo-Yo (X=870) -->
				<g class="phase-dividers">
					<line x1="870" y1="40" x2="870" y2="420" class="phase-divider-line" />
					<rect x="800" y="20" width="140" height="24" rx="4" class="phase-badge-bg phase2-badge" />
					<text x="870" y="36" class="phase-divider-text">Yo-Yo (4 Cycles)</text>

					<!-- Phase Divider: 1-Year Remission (X=1100) -->
					<line x1="1100" y1="40" x2="1100" y2="420" class="phase-divider-line" />
					<rect x="1030" y="20" width="140" height="24" rx="4" class="phase-badge-bg phase3-badge" />
					<text x="1100" y="36" class="phase-divider-text">1-Year Remission</text>
				</g>

				<!-- Filled Area Under Curve -->
				<path 
					id="progression-area"
					class="curve-area"
					d="
						M 70 420
						L 80 420
						C 95 420, 110 132, 130 132
						C 150 132, 160 400, 175 400
						L 245 400
						C 260 400, 275 132, 295 132
						C 315 132, 325 384, 340 384
						L 395 384
						C 410 384, 425 150, 445 150
						C 460 150, 470 360, 485 360
						L 535 360
						C 550 360, 565 150, 585 150
						C 600 150, 610 348, 625 348
						L 660 348
						C 675 348, 685 96, 705 96
						C 720 96, 730 400, 745 400
						L 805 400
						C 820 400, 835 60, 855 60
						C 868 60, 878 348, 890 348
						C 900 348, 910 240, 920 240
						C 930 240, 940 360, 948 360
						C 958 360, 968 240, 978 240
						C 988 240, 998 360, 1006 360
						C 1016 360, 1026 240, 1036 240
						C 1046 240, 1054 360, 1062 360
						C 1072 360, 1082 240, 1092 240
						C 1102 240, 1110 400, 1125 400
						L 1170 400
						C 1180 400, 1190 384, 1198 384
						C 1206 384, 1215 415, 1225 415
						L 1250 415
						L 1250 420
						Z
					"
					fill="url(#areaGradient)"
				/>

				<!-- Main Glowing Line Path -->
				<path 
					id="progression-curve"
					class="curve-line"
					d="
						M 80 420
						C 95 420, 110 132, 130 132
						C 150 132, 160 400, 175 400
						L 245 400
						C 260 400, 275 132, 295 132
						C 315 132, 325 384, 340 384
						L 395 384
						C 410 384, 425 150, 445 150
						C 460 150, 470 360, 485 360
						L 535 360
						C 550 360, 565 150, 585 150
						C 600 150, 610 348, 625 348
						L 660 348
						C 675 348, 685 96, 705 96
						C 720 96, 730 400, 745 400
						L 805 400
						C 820 400, 835 60, 855 60
						C 868 60, 878 348, 890 348
						C 900 348, 910 240, 920 240
						C 930 240, 940 360, 948 360
						C 958 360, 968 240, 978 240
						C 988 240, 998 360, 1006 360
						C 1016 360, 1026 240, 1036 240
						C 1046 240, 1054 360, 1062 360
						C 1072 360, 1082 240, 1092 240
						C 1102 240, 1110 400, 1125 400
						L 1170 400
						C 1180 400, 1190 384, 1198 384
						C 1206 384, 1215 415, 1225 415
						L 1250 415
					"
					fill="none"
					stroke="url(#curveGradient)"
					stroke-width="4.5"
					filter="url(#glow)"
				/>

				<!-- Visual Annotation Arrows & Callouts on Top of Waves -->
				<g class="annotations-layer">
					<!-- Wave 1: Beer & Wine (Pain 8) -->
					<line x1="130" y1="100" x2="130" y2="122" class="annotation-arrow" marker-end="url(#arrowRed)" />
					<text x="130" y="90" class="annotation-text peak-text">1. Beer & Wine (8/10)</text>
					<text x="210" y="415" class="annotation-text valley-text">6 Months Free</text>

					<!-- Wave 2: Coffee (Pain 8) -->
					<line x1="295" y1="100" x2="295" y2="122" class="annotation-arrow" marker-end="url(#arrowRed)" />
					<text x="295" y="90" class="annotation-text peak-text">2. Cut Coffee (8/10)</text>
					<text x="365" y="405" class="annotation-text valley-text">6 Months Free</text>

					<!-- Wave 3: Dental Cleaning -->
					<line x1="445" y1="118" x2="445" y2="140" class="annotation-arrow" marker-end="url(#arrowAmber)" />
					<text x="445" y="108" class="annotation-text peak-text">3. Dental Cleaning</text>
					<text x="510" y="380" class="annotation-text valley-text">6 Months Free</text>

					<!-- Wave 4: Fruits (Episode 4) -->
					<line x1="585" y1="118" x2="585" y2="140" class="annotation-arrow" marker-end="url(#arrowAmber)" />
					<text x="585" y="108" class="annotation-text peak-text">4. Cut Fruits</text>
					<text x="640" y="370" class="annotation-text valley-text">3-4 Months</text>

					<!-- Wave 5: Composite Patches (Pain 9) -->
					<line x1="705" y1="65" x2="705" y2="86" class="annotation-arrow" marker-end="url(#arrowRed)" />
					<text x="705" y="55" class="annotation-text peak-text">5. 4 Patches (9/10)</text>
					<text x="775" y="415" class="annotation-text valley-text">6 Months Free</text>

					<!-- Wave 6: Patches Wore Down (Pain 10) -->
					<line x1="855" y1="30" x2="855" y2="50" class="annotation-arrow" marker-end="url(#arrowRed)" />
					<text x="855" y="20" class="annotation-text peak-text">6. Patches Wore Down (10/10)</text>

					<!-- Transition to Carnivore -->
					<line x1="890" y1="318" x2="890" y2="338" class="annotation-arrow" marker-end="url(#arrowCyan)" />
					<text x="890" y="308" class="annotation-text phase2-text">Carnivore</text>

					<!-- 4 Yo-Yo Spikes (5/10 Max) -->
					<line x1="920" y1="210" x2="920" y2="230" class="annotation-arrow" marker-end="url(#arrowAmber)" />
					<text x="920" y="200" class="annotation-text yo-yo-text">Cheat 1 (5/10)</text>

					<line x1="978" y1="210" x2="978" y2="230" class="annotation-arrow" marker-end="url(#arrowAmber)" />
					<text x="978" y="200" class="annotation-text yo-yo-text">Cheat 2</text>

					<line x1="1036" y1="210" x2="1036" y2="230" class="annotation-arrow" marker-end="url(#arrowAmber)" />
					<text x="1036" y="200" class="annotation-text yo-yo-text">Cheat 3</text>

					<line x1="1092" y1="210" x2="1092" y2="230" class="annotation-arrow" marker-end="url(#arrowAmber)" />
					<text x="1092" y="200" class="annotation-text yo-yo-text">Cheat 4</text>

					<!-- Phase 3: Remission Baseline -->
					<text x="1150" y="425" class="annotation-text remission-text">1-Year Baseline (0 to 1)</text>

					<!-- Cheese Nuance Blip -->
					<line x1="1198" y1="355" x2="1198" y2="375" class="annotation-arrow" marker-end="url(#arrowGreen)" />
					<text x="1198" y="345" class="annotation-text cheese-text">Cheese Blip (1/10)</text>
				</g>

				<!-- Interactive Milestone Pins / Nodes -->
				<g id="milestone-pins-group">
					<circle cx="80" cy="420" r="6" class="milestone-pin pin-success" data-pain="0" data-title="Normal Baseline" data-time="3 Years Ago" data-desc="Zero symptoms prior to first alcohol trigger." />
					<circle cx="130" cy="132" r="7" class="milestone-pin pin-critical" data-pain="8" data-title="1. Beer & Wine Trigger" data-time="3 Years Ago (Month 1)" data-desc="Intense aching throughout mouth after dark ale. Cut alcohol completely." />
					<circle cx="210" cy="400" r="6" class="milestone-pin pin-success" data-pain="0.5" data-title="6 Months Alcohol-Free Relief" data-time="~2.8 Years Ago" data-desc="Completely pain-free for 6 full months." />
					<circle cx="295" cy="132" r="7" class="milestone-pin pin-critical" data-pain="8" data-title="2. Morning Coffee Flare" data-time="~2.3 Years Ago" data-desc="Fire spread to palate, inner cheeks, lips. Cut coffee, 6 months relief followed." />
					<circle cx="365" cy="384" r="6" class="milestone-pin pin-success" data-pain="1" data-title="6 Months Relief" data-time="~2.0 Years Ago" data-desc="Maintained calm baseline." />
					<circle cx="445" cy="150" r="7" class="milestone-pin pin-yoyo" data-pain="7.5" data-title="3. Subgingival Plaque / Dental Cleaning" data-time="~1.8 Years Ago" data-desc="Deep cleaning cooled down oral irritation for 6 months." />
					<circle cx="510" cy="360" r="6" class="milestone-pin pin-success" data-pain="1.5" data-title="6 Months Relief" data-time="~1.5 Years Ago" data-desc="Post-cleaning relief." />
					<circle cx="585" cy="150" r="7" class="milestone-pin pin-yoyo" data-pain="7.5" data-title="4. Fruits & Blueberries (pH 3.0)" data-time="~1.3 Years Ago" data-desc="Discovered fruit acidity was stinging nerves. Cut fruits; 3-4 months calm." />
					<circle cx="640" cy="348" r="6" class="milestone-pin pin-success" data-pain="2" data-title="3-4 Months Calm" data-time="~1.1 Years Ago" data-desc="Maintained manageable baseline." />
					<circle cx="705" cy="96" r="8" class="milestone-pin pin-critical" data-pain="9" data-title="5. Exposed Roots & 4 Composite Patches" data-time="~1.0 Years Ago" data-desc="1 month at 9/10 pain. Dentist placed 4 composite patches over exposed dentin; 6 months relief." />
					<circle cx="775" cy="400" r="6" class="milestone-pin pin-success" data-pain="0.5" data-title="6 Months Relief" data-time="~8 Months Ago" data-desc="Shielded dentin stopped the burn." />
					<circle cx="855" cy="60" r="8" class="milestone-pin pin-critical" data-pain="10" data-title="6. Patches Wore Down (10/10 Agony)" data-time="~7 Months Ago" data-desc="Patches degraded. Living fire returned at 10/10. Cut all vegetables, fruits, and grains." />
					<circle cx="890" cy="348" r="7" class="milestone-pin" data-pain="2" data-title="Carnivore Transition" data-time="~6 Months Ago" data-desc="All-meat protocol starved chemical fuel. Pain dropped to 2/10." />
					<circle cx="920" cy="240" r="6" class="milestone-pin pin-yoyo" data-pain="5" data-title="Yo-Yo Cycle #1 (5/10 Max)" data-time="~5.5 Months Ago" data-desc="Cheat food spiked pain to 5/10. Meat reset returned baseline to 1-2/10." />
					<circle cx="978" cy="240" r="6" class="milestone-pin pin-yoyo" data-pain="5" data-title="Yo-Yo Cycle #2 (5/10 Max)" data-time="~5 Months Ago" data-desc="Second cheat flare peaked at 5/10." />
					<circle cx="1036" cy="240" r="6" class="milestone-pin pin-yoyo" data-pain="5" data-title="Yo-Yo Cycle #3 (5/10 Max)" data-time="~4.5 Months Ago" data-desc="Third cheat flare peaked at 5/10." />
					<circle cx="1092" cy="240" r="6" class="milestone-pin pin-yoyo" data-pain="5" data-title="Yo-Yo Cycle #4 (5/10 Max)" data-time="~4 Months Ago" data-desc="Fourth cheat flare. Radical acceptance locked in." />
					<circle cx="1150" cy="400" r="7" class="milestone-pin pin-success" data-pain="0.5" data-title="1-Year Remission Baseline" data-time="Present Day" data-desc="Strict meat, eggs, seafood baseline (0 to 1/10)." />
					<circle cx="1198" cy="384" r="6" class="milestone-pin" data-pain="1" data-title="Cheese Tolerance Blip" data-time="Present Day" data-desc="2 meals with cheese creates minor 1/10 blip." />
				</g>

				<!-- Interactive Crosshair & Cursor Point -->
				<g id="interactive-cursor" class="interactive-cursor-layer" style="display: none;">
					<line id="cursor-vertical-line" x1="0" y1="50" x2="0" y2="420" class="cursor-line" />
					<circle id="cursor-point" cx="0" cy="0" r="8" class="cursor-pulse-point" />
				</g>

				<!-- X-Axis Timeline Labels -->
				<g class="x-axis-labels">
					<text x="80" y="455" class="axis-time-label label-start">3 Years Ago (Start: 0/10)</text>
					<text x="210" y="455" class="axis-time-label">2.8 Yrs</text>
					<text x="365" y="455" class="axis-time-label">2.0 Yrs</text>
					<text x="510" y="455" class="axis-time-label">1.5 Yrs</text>
					<text x="705" y="455" class="axis-time-label">1.0 Yr</text>
					<text x="870" y="455" class="axis-time-label">6 Mo (Yo-Yo)</text>
					<text x="1150" y="455" class="axis-time-label label-end">Today (Remission)</text>
				</g>
			</svg>

			<!-- Floating Tooltip Box -->
			<div id="chart-tooltip" class="chart-tooltip" style="display: none;">
				<div class="tooltip-header">
					<span id="tooltip-time" class="tooltip-time">Timeframe</span>
					<span id="tooltip-pain" class="tooltip-pain-pill">Pain 5/10</span>
				</div>
				<h4 id="tooltip-title" class="tooltip-title">Milestone Title</h4>
				<p id="tooltip-desc" class="tooltip-desc">Description text</p>
			</div>
		</div>
	</div>
</div>

<style>
	.interactive-progression-container {
		background: radial-gradient(120% 120% at 50% 0%, #1e1136 0%, #0d081a 60%, #080410 100%);
		border: 1px solid rgba(168, 85, 247, 0.25);
		border-radius: 1.25rem;
		padding: 1.75rem;
		margin: 2.5rem 0;
		color: #e2e8f0;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		position: relative;
		overflow: hidden;
	}

	.widget-header {
		margin-bottom: 1.25rem;
		border-bottom: 1px solid rgba(168, 85, 247, 0.15);
		padding-bottom: 0.85rem;
	}

	.widget-title {
		font-size: 1.45rem;
		font-weight: 700;
		color: #f8fafc;
		margin: 0;
		line-height: 1.3;
	}

	/* Chart Canvas */
	.chart-wrapper {
		position: relative;
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		background: rgba(10, 6, 20, 0.6);
		border-radius: 0.75rem;
		border: 1px solid rgba(255, 255, 255, 0.05);
		padding: 0.5rem 0;
	}

	.chart-canvas-inner {
		min-width: 900px;
		position: relative;
	}

	.progression-svg {
		width: 100%;
		height: auto;
		display: block;
		user-select: none;
	}

	/* SVG Styles */
	.zone-label {
		font-size: 11px;
		font-weight: 600;
		text-anchor: end;
	}
	.zone-red { fill: #f87171; opacity: 0.7; }
	.zone-amber { fill: #fbbf24; opacity: 0.7; }
	.zone-green { fill: #34d399; opacity: 0.7; }

	.grid-line {
		stroke: rgba(255, 255, 255, 0.08);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}
	.line-10 {
		stroke: rgba(239, 68, 68, 0.25);
	}
	.line-highlight {
		stroke: rgba(245, 158, 11, 0.3);
		stroke-dasharray: 6 3;
	}
	.axis-x-base {
		stroke: rgba(255, 255, 255, 0.25);
		stroke-width: 1.5;
		stroke-dasharray: none;
	}

	.axis-label {
		fill: #94a3b8;
		font-size: 12px;
		font-weight: 600;
		text-anchor: end;
	}
	.val-5 { fill: #fbbf24; font-weight: 700; }

	.phase-divider-line {
		stroke: rgba(168, 85, 247, 0.35);
		stroke-width: 1.5;
		stroke-dasharray: 6 4;
	}
	.phase-badge-bg {
		fill: #2e1065;
		stroke: rgba(168, 85, 247, 0.5);
		stroke-width: 1;
	}
	.phase-divider-text {
		fill: #e9d5ff;
		font-size: 10px;
		font-weight: 700;
		text-anchor: middle;
	}

	.annotation-arrow {
		stroke-width: 1.5;
		opacity: 0.8;
	}
	.peak-text {
		fill: #f87171;
		font-size: 10px;
		font-weight: 700;
		text-anchor: middle;
	}
	.valley-text {
		fill: #6ee7b7;
		font-size: 10px;
		font-weight: 600;
		text-anchor: middle;
	}
	.phase2-text {
		fill: #38bdf8;
		font-size: 10px;
		font-weight: 700;
		text-anchor: middle;
	}
	.yo-yo-text {
		fill: #fbbf24;
		font-size: 10px;
		font-weight: 700;
		text-anchor: middle;
	}
	.remission-text {
		fill: #34d399;
		font-size: 11px;
		font-weight: 700;
		text-anchor: middle;
	}
	.cheese-text {
		fill: #a7f3d0;
		font-size: 9.5px;
		font-weight: 600;
		text-anchor: middle;
	}

	.axis-time-label {
		fill: #cbd5e1;
		font-size: 11px;
		font-weight: 600;
		text-anchor: middle;
	}
	.label-start { text-anchor: start; fill: #34d399; font-weight: 700; }
	.label-end { text-anchor: end; fill: #34d399; font-weight: 700; }

	/* Milestone Pins */
	.milestone-pin {
		fill: #0f172a;
		stroke: #38bdf8;
		stroke-width: 2.5;
		cursor: pointer;
		transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.milestone-pin:hover {
		fill: #38bdf8;
		stroke: #ffffff;
		stroke-width: 3.5;
		r: 9;
		filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.8));
	}
	.pin-critical {
		stroke: #ef4444;
	}
	.pin-critical:hover {
		fill: #ef4444;
		filter: drop-shadow(0 0 8px rgba(239, 68, 68, 0.8));
	}
	.pin-yoyo {
		stroke: #f59e0b;
	}
	.pin-yoyo:hover {
		fill: #f59e0b;
		filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.8));
	}
	.pin-success {
		stroke: #10b981;
	}
	.pin-success:hover {
		fill: #10b981;
		filter: drop-shadow(0 0 8px rgba(16, 185, 129, 0.8));
	}

	/* Interactive Cursor */
	.cursor-line {
		stroke: rgba(168, 85, 247, 0.6);
		stroke-width: 1.5;
		stroke-dasharray: 4 4;
	}
	.cursor-pulse-point {
		fill: #a855f7;
		stroke: #ffffff;
		stroke-width: 2.5;
		filter: drop-shadow(0 0 10px #a855f7);
	}

	/* Tooltip */
	.chart-tooltip {
		position: absolute;
		pointer-events: none;
		background: rgba(15, 23, 42, 0.95);
		border: 1px solid #a855f7;
		border-radius: 0.65rem;
		padding: 0.75rem 1rem;
		width: 240px;
		color: #f8fafc;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
		backdrop-filter: blur(8px);
		z-index: 20;
		transform: translate(-50%, -120%);
		transition: opacity 0.15s ease, transform 0.15s ease;
	}

	.tooltip-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.35rem;
	}
	.tooltip-time {
		font-size: 0.75rem;
		color: #94a3b8;
		font-weight: 600;
	}
	.tooltip-pain-pill {
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.15rem 0.45rem;
		border-radius: 9999px;
		background: rgba(239, 68, 68, 0.2);
		color: #f87171;
		border: 1px solid rgba(239, 68, 68, 0.4);
	}
	.tooltip-title {
		font-size: 0.875rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 0.35rem 0;
		line-height: 1.3;
	}
	.tooltip-desc {
		font-size: 0.775rem;
		color: #cbd5e1;
		margin: 0;
		line-height: 1.4;
	}
</style>

<script>
	function initProgressionChart() {
		const widget = document.getElementById('bms-progression-widget');
		if (!widget) return;

		const svg = document.getElementById('progression-svg') as unknown as SVGSVGElement;
		const tooltip = document.getElementById('chart-tooltip');
		const tooltipTime = document.getElementById('tooltip-time');
		const tooltipPain = document.getElementById('tooltip-pain');
		const tooltipTitle = document.getElementById('tooltip-title');
		const tooltipDesc = document.getElementById('tooltip-desc');

		const cursorLayer = document.getElementById('interactive-cursor');
		const cursorLine = document.getElementById('cursor-vertical-line');
		const cursorPoint = document.getElementById('cursor-point');
		const pins = widget.querySelectorAll('.milestone-pin');

		if (!svg) return;

		pins.forEach((pin) => {
			pin.addEventListener('mouseenter', () => {
				const cx = parseFloat(pin.getAttribute('cx') || '0');
				const cy = parseFloat(pin.getAttribute('cy') || '0');
				const pain = pin.getAttribute('data-pain');
				const title = pin.getAttribute('data-title');
				const time = pin.getAttribute('data-time');
				const desc = pin.getAttribute('data-desc');

				if (tooltip && tooltipTime && tooltipPain && tooltipTitle && tooltipDesc) {
					tooltipTime.textContent = time || '';
					tooltipPain.textContent = `Pain ${pain}/10`;
					tooltipTitle.textContent = title || '';
					tooltipDesc.textContent = desc || '';

					const svgRect = svg.getBoundingClientRect();
					const scaleX = svgRect.width / 1300;
					const scaleY = svgRect.height / 480;

					tooltip.style.left = `${cx * scaleX}px`;
					tooltip.style.top = `${cy * scaleY - 15}px`;
					tooltip.style.display = 'block';
				}
			});

			pin.addEventListener('mouseleave', () => {
				if (tooltip) tooltip.style.display = 'none';
			});
		});

		// Mouse tracking on SVG
		svg.addEventListener('mousemove', (e: MouseEvent) => {
			const rect = svg.getBoundingClientRect();
			const x = ((e.clientX - rect.left) / rect.width) * 1300;
			const y = ((e.clientY - rect.top) / rect.height) * 480;

			if (cursorLayer && cursorLine && cursorPoint && x >= 70 && x <= 1250) {
				cursorLayer.style.display = 'block';
				cursorLine.setAttribute('x1', `${x}`);
				cursorLine.setAttribute('x2', `${x}`);
				cursorPoint.setAttribute('cx', `${x}`);
				cursorPoint.setAttribute('cy', `${Math.min(Math.max(y, 60), 420)}`);
			}
		});

		svg.addEventListener('mouseleave', () => {
			if (cursorLayer) cursorLayer.style.display = 'none';
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProgressionChart);
	} else {
		initProgressionChart();
	}
	document.addEventListener('astro:page-load', initProgressionChart);
</script>
