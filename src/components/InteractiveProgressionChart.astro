---
// InteractiveProgressionChart.astro - Universal Interactive BMS Pain Progression Graph (0-10 Scale over 3 Years)
interface Props {
	class?: string;
	title?: string;
}

const {
	class: className = '',
	title = "My 3-Year BMS Progression"
} = Astro.props;
---

<div class={`interactive-progression-container ${className}`} id="bms-progression-widget">
	<!-- Header -->
	<div class="widget-header">
		<h3 class="widget-title">{title}</h3>
	</div>

	<!-- Chart Box -->
	<div class="chart-wrapper" id="chart-scroll-container">
		<div class="chart-canvas-inner">
			<!-- SVG Data Canvas -->
			<svg 
				id="progression-svg" 
				viewBox="0 0 1380 480" 
				class="progression-svg" 
				preserveAspectRatio="xMidYMid meet"
			>
				<defs>
					<!-- Gradients for Curve and Fill -->
					<linearGradient id="curveGradient" x1="0%" y1="0%" x2="100%" y2="0%">
						<stop offset="0%" stop-color="#10b981" />
						<stop offset="6%" stop-color="#ef4444" />
						<stop offset="15%" stop-color="#10b981" />
						<stop offset="22%" stop-color="#f59e0b" />
						<stop offset="30%" stop-color="#10b981" />
						<stop offset="38%" stop-color="#f59e0b" />
						<stop offset="46%" stop-color="#10b981" />
						<stop offset="52%" stop-color="#ef4444" />
						<stop offset="60%" stop-color="#10b981" />
						<stop offset="66%" stop-color="#ef4444" />
						<stop offset="72%" stop-color="#06b6d4" />
						<stop offset="78%" stop-color="#f59e0b" />
						<stop offset="85%" stop-color="#10b981" />
						<stop offset="100%" stop-color="#10b981" />
					</linearGradient>

					<linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
						<stop offset="0%" stop-color="rgba(239, 68, 68, 0.20)" />
						<stop offset="50%" stop-color="rgba(245, 158, 11, 0.10)" />
						<stop offset="100%" stop-color="rgba(16, 185, 129, 0.02)" />
					</linearGradient>

					<!-- Glow Filter -->
					<filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
						<feGaussianBlur stdDeviation="3.5" result="blur" />
						<feMerge>
							<feMergeNode in="blur" />
							<feMergeNode in="SourceGraphic" />
						</feMerge>
					</filter>

					<!-- Arrow Markers -->
					<marker id="arrowRed" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#ef4444" />
					</marker>
					<marker id="arrowAmber" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#f59e0b" />
					</marker>
					<marker id="arrowGreen" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#10b981" />
					</marker>
				</defs>

				<!-- Background Severity Bands (Clean, subtle tint without text clutter) -->
				<rect x="70" y="60" width="1270" height="108" fill="rgba(239, 68, 68, 0.04)" />
				<rect x="70" y="168" width="1270" height="144" fill="rgba(245, 158, 11, 0.03)" />
				<rect x="70" y="312" width="1270" height="108" fill="rgba(16, 185, 129, 0.04)" />

				<!-- Horizontal Grid Lines & Y-Axis Labels (0 to 10 Scale) -->
				<g class="grid-lines">
					<line x1="70" y1="60" x2="1340" y2="60" class="grid-line line-10" />
					<text x="55" y="65" class="axis-label y-val">10</text>

					<line x1="70" y1="132" x2="1340" y2="132" class="grid-line" />
					<text x="55" y="137" class="axis-label y-val">8</text>

					<line x1="70" y1="240" x2="1340" y2="240" class="grid-line line-highlight" />
					<text x="55" y="245" class="axis-label y-val val-5">5</text>

					<line x1="70" y1="348" x2="1340" y2="348" class="grid-line" />
					<text x="55" y="353" class="axis-label y-val">2</text>

					<line x1="70" y1="420" x2="1340" y2="420" class="grid-line axis-x-base" />
					<text x="55" y="425" class="axis-label y-val">0</text>
				</g>

				<!-- Dotted Graphical Micro-Spikes Inside Valleys (Zero Text, Pure Visual Detail) -->
				<g class="valley-dotted-spikes">
					<!-- Valley 1 Dotted Micro-Spikes (X: 130 to 240) -->
					<line x1="160" y1="416" x2="160" y2="385" class="micro-spike" />
					<line x1="190" y1="416" x2="190" y2="375" class="micro-spike" />
					<line x1="215" y1="416" x2="215" y2="390" class="micro-spike" />

					<!-- Valley 2 Dotted Micro-Spikes (X: 280 to 395) -->
					<line x1="315" y1="416" x2="315" y2="380" class="micro-spike" />
					<line x1="345" y1="416" x2="345" y2="370" class="micro-spike" />
					<line x1="370" y1="416" x2="370" y2="385" class="micro-spike" />

					<!-- Valley 3 Dotted Micro-Spikes (X: 435 to 550) -->
					<line x1="470" y1="416" x2="470" y2="380" class="micro-spike" />
					<line x1="500" y1="416" x2="500" y2="375" class="micro-spike" />
					<line x1="525" y1="416" x2="525" y2="385" class="micro-spike" />

					<!-- Valley 4 Dotted Micro-Spikes (X: 590 to 680) -->
					<line x1="625" y1="416" x2="625" y2="380" class="micro-spike" />
					<line x1="655" y1="416" x2="655" y2="375" class="micro-spike" />

					<!-- Valley 5 Dotted Micro-Spikes (X: 725 to 840) -->
					<line x1="760" y1="416" x2="760" y2="385" class="micro-spike" />
					<line x1="790" y1="416" x2="790" y2="375" class="micro-spike" />
					<line x1="815" y1="416" x2="815" y2="390" class="micro-spike" />

					<!-- Baseline Dotted Spikes (X: 1060 to 1320) -->
					<line x1="1120" y1="416" x2="1120" y2="400" class="micro-spike" />
					<line x1="1160" y1="416" x2="1160" y2="395" class="micro-spike" />
					<line x1="1270" y1="416" x2="1270" y2="405" class="micro-spike" />
				</g>

				<!-- Filled Area Under Curve -->
				<path 
					id="progression-area"
					class="curve-area"
					d="
						M 70 420
						L 80 416
						L 90 132
						L 115 132
						L 125 416
						L 240 416
						L 250 132
						L 275 132
						L 285 416
						L 395 416
						L 405 132
						L 430 132
						L 440 416
						L 550 416
						L 560 132
						L 585 132
						L 595 416
						L 680 416
						L 695 96
						L 720 96
						L 730 416
						L 840 416
						L 855 60
						L 895 60
						L 920 416
						L 935 240
						L 948 416
						L 965 240
						L 978 416
						L 995 240
						L 1008 416
						L 1025 240
						L 1038 416
						L 1205 416
						L 1220 380
						L 1235 416
						L 1340 416
						L 1340 420
						Z
					"
					fill="url(#areaGradient)"
				/>

				<!-- Main Glowing Line Path (Steep Verticals, Flat 1-Mo Tops, Clean Zero Drops) -->
				<path 
					id="progression-curve"
					class="curve-line"
					d="
						M 80 416
						L 90 132
						L 115 132
						L 125 416
						L 240 416
						L 250 132
						L 275 132
						L 285 416
						L 395 416
						L 405 132
						L 430 132
						L 440 416
						L 550 416
						L 560 132
						L 585 132
						L 595 416
						L 680 416
						L 695 96
						L 720 96
						L 730 416
						L 840 416
						L 855 60
						L 895 60
						L 920 416
						L 935 240
						L 948 416
						L 965 240
						L 978 416
						L 995 240
						L 1008 416
						L 1025 240
						L 1038 416
						L 1205 416
						L 1220 380
						L 1235 416
						L 1340 416
					"
					fill="none"
					stroke="url(#curveGradient)"
					stroke-width="4.5"
					filter="url(#glow)"
				/>

				<!-- Visual Annotations & Titles -->
				<g class="annotations-layer">
					<!-- Peak 1: #1 Beer and Wine -->
					<line x1="102" y1="85" x2="102" y2="120" class="annotation-arrow" marker-end="url(#arrowRed)" />
					<text x="102" y="58" class="annotation-text peak-text">#1 Beer and Wine</text>
					<text x="102" y="74" class="annotation-text sub-peak-text">1 Month (8/10)</text>

					<!-- Valley 1: 6 Months Pain-Free (2 lines) -->
					<text x="180" y="380" class="annotation-text valley-text">6 Months</text>
					<text x="180" y="396" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 2: #2 Coffee -->
					<line x1="262" y1="85" x2="262" y2="120" class="annotation-arrow" marker-end="url(#arrowRed)" />
					<text x="262" y="58" class="annotation-text peak-text">#2 Coffee</text>
					<text x="262" y="74" class="annotation-text sub-peak-text">1 Month (8/10)</text>

					<!-- Valley 2: 6 Months Pain-Free (2 lines) -->
					<text x="340" y="380" class="annotation-text valley-text">6 Months</text>
					<text x="340" y="396" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 3: #3 Dental Cleaning -->
					<line x1="417" y1="85" x2="417" y2="120" class="annotation-arrow" marker-end="url(#arrowAmber)" />
					<text x="417" y="58" class="annotation-text peak-text">#3 Dental Cleaning</text>
					<text x="417" y="74" class="annotation-text sub-peak-text">1 Month</text>

					<!-- Valley 3: 6 Months Pain-Free (2 lines) -->
					<text x="495" y="380" class="annotation-text valley-text">6 Months</text>
					<text x="495" y="396" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 4: #4 Most Fruits -->
					<line x1="572" y1="85" x2="572" y2="120" class="annotation-arrow" marker-end="url(#arrowAmber)" />
					<text x="572" y="58" class="annotation-text peak-text">#4 Most Fruits</text>
					<text x="572" y="74" class="annotation-text sub-peak-text">1 Month</text>

					<!-- Valley 4: 3-4 Months Pain-Free (2 lines) -->
					<text x="635" y="380" class="annotation-text valley-text">3-4 Months</text>
					<text x="635" y="396" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 5: #5 4 Patches -->
					<line x1="707" y1="52" x2="707" y2="85" class="annotation-arrow" marker-end="url(#arrowRed)" />
					<text x="707" y="26" class="annotation-text peak-text">#5 4 Patches</text>
					<text x="707" y="42" class="annotation-text sub-peak-text">1 Month (9/10)</text>

					<!-- Valley 5: 6 Months Pain-Free (2 lines) -->
					<text x="785" y="380" class="annotation-text valley-text">6 Months</text>
					<text x="785" y="396" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 6: #6 Two Months of Pain -->
					<line x1="875" y1="20" x2="875" y2="50" class="annotation-arrow" marker-end="url(#arrowRed)" />
					<text x="875" y="-3" class="annotation-text peak-text">#6 Two Months of Pain</text>
					<text x="875" y="12" class="annotation-text sub-peak-text">All Acids (10/10 Peak)</text>

					<!-- Vegetables (Cheats) -->
					<line x1="985" y1="195" x2="985" y2="225" class="annotation-arrow" marker-end="url(#arrowAmber)" />
					<text x="985" y="180" class="annotation-text yo-yo-text">Vegetables</text>

					<!-- Cheese -->
					<line x1="1220" y1="345" x2="1220" y2="370" class="annotation-arrow" marker-end="url(#arrowGreen)" />
					<text x="1220" y="335" class="annotation-text cheese-text">Cheese</text>
				</g>

				<!-- Interactive Milestone Nodes -->
				<g id="milestone-pins-group">
					<circle cx="80" cy="416" r="6" class="milestone-pin pin-success" data-pain="0" data-title="Start Baseline" data-time="3 Years Ago" data-desc="Zero pain prior to first alcohol trigger." />
					<circle cx="102" cy="132" r="7" class="milestone-pin pin-critical" data-pain="8" data-title="#1 Beer and Wine" data-time="Month 1" data-desc="Intense aching after dark ale. Cut alcohol completely, returning to 0 pain." />
					<circle cx="180" cy="416" r="6" class="milestone-pin pin-success" data-pain="0" data-title="6 Months Pain-Free" data-time="6 Months" data-desc="Maintained 0 pain." />
					<circle cx="262" cy="132" r="7" class="milestone-pin pin-critical" data-pain="8" data-title="#2 Coffee" data-time="Month 7" data-desc="Fire spread across palate and cheeks. Cut coffee, returning to 0 pain." />
					<circle cx="340" cy="416" r="6" class="milestone-pin pin-success" data-pain="0" data-title="6 Months Pain-Free" data-time="6 Months" data-desc="Maintained 0 pain." />
					<circle cx="417" cy="132" r="7" class="milestone-pin pin-yoyo" data-pain="8" data-title="#3 Dental Cleaning" data-time="Month 13" data-desc="Subgingival tartar fueled irritation. Professional cleaning returned pain to 0." />
					<circle cx="495" cy="416" r="6" class="milestone-pin pin-success" data-pain="0" data-title="6 Months Pain-Free" data-time="6 Months" data-desc="Maintained 0 pain." />
					<circle cx="572" cy="132" r="7" class="milestone-pin pin-yoyo" data-pain="8" data-title="#4 Most Fruits" data-time="Month 19" data-desc="Fruit acids (pH 3.0) stung nerves. Eliminated fruits; pain returned to 0." />
					<circle cx="635" cy="416" r="6" class="milestone-pin pin-success" data-pain="0" data-title="3-4 Months Pain-Free" data-time="3-4 Months" data-desc="Calm baseline." />
					<circle cx="707" cy="96" r="8" class="milestone-pin pin-critical" data-pain="9" data-title="#5 4 Patches" data-time="Month 23" data-desc="1 month at 9/10 pain. Dentist placed 4 composite patches over roots; 6 months pain-free." />
					<circle cx="785" cy="416" r="6" class="milestone-pin pin-success" data-pain="0" data-title="6 Months Pain-Free" data-time="6 Months" data-desc="Complete relief." />
					<circle cx="875" cy="60" r="8" class="milestone-pin pin-critical" data-pain="10" data-title="#6 Two Months of Pain" data-time="2 Months Peak" data-desc="Patches wore down. Peak 10/10 living fire. Transitioned to carnivore." />
					<circle cx="935" cy="240" r="6" class="milestone-pin pin-yoyo" data-pain="5" data-title="Vegetables Spike" data-time="Cheat 1" data-desc="Vegetables/popcorn triggered 5/10 flare." />
					<circle cx="965" cy="240" r="6" class="milestone-pin pin-yoyo" data-pain="5" data-title="Vegetables Spike" data-time="Cheat 2" data-desc="Vegetables triggered 5/10 flare." />
					<circle cx="995" cy="240" r="6" class="milestone-pin pin-yoyo" data-pain="5" data-title="Vegetables Spike" data-time="Cheat 3" data-desc="Vegetables triggered 5/10 flare." />
					<circle cx="1025" cy="240" r="6" class="milestone-pin pin-yoyo" data-pain="5" data-title="Vegetables Spike" data-time="Cheat 4" data-desc="Vegetables triggered 5/10 flare." />
					<circle cx="1220" cy="380" r="6" class="milestone-pin pin-success" data-pain="1" data-title="Cheese" data-time="Present" data-desc="2 meals with cheese causes mild 1/10 blip." />
				</g>

				<!-- Interactive Crosshair & Cursor Point -->
				<g id="interactive-cursor" class="interactive-cursor-layer" style="display: none;">
					<line id="cursor-vertical-line" x1="0" y1="50" x2="0" y2="420" class="cursor-line" />
					<circle id="cursor-point" cx="0" cy="0" r="8" class="cursor-pulse-point" />
				</g>

				<!-- X-Axis Clean Timeline Labels (No overlapping text) -->
				<g class="x-axis-labels">
					<text x="80" y="455" class="axis-time-label label-start">3 Years Ago</text>
					<text x="340" y="455" class="axis-time-label">2.5 Years</text>
					<text x="635" y="455" class="axis-time-label">1.5 Years</text>
					<text x="875" y="455" class="axis-time-label">1 Year Ago</text>
					<text x="1220" y="455" class="axis-time-label label-end">Today</text>
				</g>
			</svg>

			<!-- Floating Tooltip Box -->
			<div id="chart-tooltip" class="chart-tooltip" style="display: none;">
				<div class="tooltip-header">
					<span id="tooltip-time" class="tooltip-time">Timeframe</span>
					<span id="tooltip-pain" class="tooltip-pain-pill">Pain 5/10</span>
				</div>
				<h4 id="tooltip-title" class="tooltip-title">Milestone Title</h4>
				<p id="tooltip-desc" class="tooltip-desc">Description text</p>
			</div>
		</div>
	</div>
</div>

<style>
	.interactive-progression-container {
		background: radial-gradient(120% 120% at 50% 0%, #1e1136 0%, #0d081a 60%, #080410 100%);
		border: 1px solid rgba(168, 85, 247, 0.25);
		border-radius: 1.25rem;
		padding: 1.75rem;
		margin: 2.5rem 0;
		color: #e2e8f0;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		position: relative;
		overflow: hidden;
	}

	.widget-header {
		margin-bottom: 1.25rem;
		border-bottom: 1px solid rgba(168, 85, 247, 0.15);
		padding-bottom: 0.85rem;
	}

	.widget-title {
		font-size: 1.45rem;
		font-weight: 700;
		color: #f8fafc;
		margin: 0;
		line-height: 1.3;
	}

	/* Chart Canvas */
	.chart-wrapper {
		position: relative;
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		background: rgba(10, 6, 20, 0.6);
		border-radius: 0.75rem;
		border: 1px solid rgba(255, 255, 255, 0.05);
		padding: 0.5rem 0;
	}

	.chart-canvas-inner {
		min-width: 950px;
		position: relative;
	}

	.progression-svg {
		width: 100%;
		height: auto;
		display: block;
		user-select: none;
	}

	.grid-line {
		stroke: rgba(255, 255, 255, 0.08);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}
	.line-10 {
		stroke: rgba(239, 68, 68, 0.25);
	}
	.line-highlight {
		stroke: rgba(245, 158, 11, 0.3);
		stroke-dasharray: 6 3;
	}
	.axis-x-base {
		stroke: rgba(255, 255, 255, 0.25);
		stroke-width: 1.5;
		stroke-dasharray: none;
	}

	.axis-label {
		fill: #94a3b8;
		font-size: 12px;
		font-weight: 600;
		text-anchor: end;
	}
	.val-5 { fill: #fbbf24; font-weight: 700; }

	.micro-spike {
		stroke: rgba(168, 85, 247, 0.35);
		stroke-width: 1.5;
		stroke-dasharray: 2 3;
	}

	.annotation-arrow {
		stroke-width: 1.5;
		opacity: 0.8;
	}
	.peak-text {
		fill: #f87171;
		font-size: 11px;
		font-weight: 700;
		text-anchor: middle;
	}
	.sub-peak-text {
		fill: #fca5a5;
		font-size: 9.5px;
		font-weight: 600;
		text-anchor: middle;
	}
	.valley-text {
		fill: #6ee7b7;
		font-size: 10px;
		font-weight: 600;
		text-anchor: middle;
		line-height: 1.2;
	}
	.yo-yo-text {
		fill: #fbbf24;
		font-size: 11px;
		font-weight: 700;
		text-anchor: middle;
	}
	.cheese-text {
		fill: #a7f3d0;
		font-size: 10.5px;
		font-weight: 700;
		text-anchor: middle;
	}

	.axis-time-label {
		fill: #cbd5e1;
		font-size: 11px;
		font-weight: 600;
		text-anchor: middle;
	}
	.label-start { text-anchor: start; fill: #34d399; font-weight: 700; }
	.label-end { text-anchor: end; fill: #34d399; font-weight: 700; }

	/* Milestone Pins */
	.milestone-pin {
		fill: #0f172a;
		stroke: #38bdf8;
		stroke-width: 2.5;
		cursor: pointer;
		transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.milestone-pin:hover {
		fill: #38bdf8;
		stroke: #ffffff;
		stroke-width: 3.5;
		r: 9;
		filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.8));
	}
	.pin-critical {
		stroke: #ef4444;
	}
	.pin-critical:hover {
		fill: #ef4444;
		filter: drop-shadow(0 0 8px rgba(239, 68, 68, 0.8));
	}
	.pin-yoyo {
		stroke: #f59e0b;
	}
	.pin-yoyo:hover {
		fill: #f59e0b;
		filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.8));
	}
	.pin-success {
		stroke: #10b981;
	}
	.pin-success:hover {
		fill: #10b981;
		filter: drop-shadow(0 0 8px rgba(16, 185, 129, 0.8));
	}

	/* Interactive Cursor */
	.cursor-line {
		stroke: rgba(168, 85, 247, 0.6);
		stroke-width: 1.5;
		stroke-dasharray: 4 4;
	}
	.cursor-pulse-point {
		fill: #a855f7;
		stroke: #ffffff;
		stroke-width: 2.5;
		filter: drop-shadow(0 0 10px #a855f7);
	}

	/* Tooltip */
	.chart-tooltip {
		position: absolute;
		pointer-events: none;
		background: rgba(15, 23, 42, 0.95);
		border: 1px solid #a855f7;
		border-radius: 0.65rem;
		padding: 0.75rem 1rem;
		width: 240px;
		color: #f8fafc;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
		backdrop-filter: blur(8px);
		z-index: 20;
		transform: translate(-50%, -120%);
		transition: opacity 0.15s ease, transform 0.15s ease;
	}

	.tooltip-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.35rem;
	}
	.tooltip-time {
		font-size: 0.75rem;
		color: #94a3b8;
		font-weight: 600;
	}
	.tooltip-pain-pill {
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.15rem 0.45rem;
		border-radius: 9999px;
		background: rgba(239, 68, 68, 0.2);
		color: #f87171;
		border: 1px solid rgba(239, 68, 68, 0.4);
	}
	.tooltip-title {
		font-size: 0.875rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 0.35rem 0;
		line-height: 1.3;
	}
	.tooltip-desc {
		font-size: 0.775rem;
		color: #cbd5e1;
		margin: 0;
		line-height: 1.4;
	}
</style>

<script>
	function initProgressionChart() {
		const widget = document.getElementById('bms-progression-widget');
		if (!widget) return;

		const svg = document.getElementById('progression-svg') as unknown as SVGSVGElement;
		const tooltip = document.getElementById('chart-tooltip');
		const tooltipTime = document.getElementById('tooltip-time');
		const tooltipPain = document.getElementById('tooltip-pain');
		const tooltipTitle = document.getElementById('tooltip-title');
		const tooltipDesc = document.getElementById('tooltip-desc');

		const cursorLayer = document.getElementById('interactive-cursor');
		const cursorLine = document.getElementById('cursor-vertical-line');
		const cursorPoint = document.getElementById('cursor-point');
		const pins = widget.querySelectorAll('.milestone-pin');

		if (!svg) return;

		pins.forEach((pin) => {
			pin.addEventListener('mouseenter', () => {
				const cx = parseFloat(pin.getAttribute('cx') || '0');
				const cy = parseFloat(pin.getAttribute('cy') || '0');
				const pain = pin.getAttribute('data-pain');
				const title = pin.getAttribute('data-title');
				const time = pin.getAttribute('data-time');
				const desc = pin.getAttribute('data-desc');

				if (tooltip && tooltipTime && tooltipPain && tooltipTitle && tooltipDesc) {
					tooltipTime.textContent = time || '';
					tooltipPain.textContent = `Pain ${pain}/10`;
					tooltipTitle.textContent = title || '';
					tooltipDesc.textContent = desc || '';

					const svgRect = svg.getBoundingClientRect();
					const scaleX = svgRect.width / 1380;
					const scaleY = svgRect.height / 480;

					tooltip.style.left = `${cx * scaleX}px`;
					tooltip.style.top = `${cy * scaleY - 15}px`;
					tooltip.style.display = 'block';
				}
			});

			pin.addEventListener('mouseleave', () => {
				if (tooltip) tooltip.style.display = 'none';
			});
		});

		svg.addEventListener('mousemove', (e: MouseEvent) => {
			const rect = svg.getBoundingClientRect();
			const x = ((e.clientX - rect.left) / rect.width) * 1380;
			const y = ((e.clientY - rect.top) / rect.height) * 480;

			if (cursorLayer && cursorLine && cursorPoint && x >= 70 && x <= 1340) {
				cursorLayer.style.display = 'block';
				cursorLine.setAttribute('x1', `${x}`);
				cursorLine.setAttribute('x2', `${x}`);
				cursorPoint.setAttribute('cx', `${x}`);
				cursorPoint.setAttribute('cy', `${Math.min(Math.max(y, 60), 420)}`);
			}
		});

		svg.addEventListener('mouseleave', () => {
			if (cursorLayer) cursorLayer.style.display = 'none';
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProgressionChart);
	} else {
		initProgressionChart();
	}
	document.addEventListener('astro:page-load', initProgressionChart);
</script>
