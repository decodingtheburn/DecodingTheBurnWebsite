---
// InteractiveProgressionChart.astro - Universal Interactive BMS Pain Progression Graph (0-10 Scale over 4+ Years)
interface Props {
	class?: string;
	title?: string;
}

const {
	class: className = '',
	title = "My 4-Year BMS Progression"
} = Astro.props;
---

<div class={`interactive-progression-container ${className}`} id="bms-progression-widget">
	<!-- Header with Expand/Collapse Toggle & Subtitle Row -->
	<div class="widget-header">
		<div class="widget-header-content">
			<h3 class="widget-title">{title}</h3>
			<div class="widget-subtitle-row">
				<span class="widget-subtitle">Interactive 4-Year Pain & Triggers Timeline</span>
				<button 
					type="button" 
					class="chart-expand-btn" 
					id="chart-expand-toggle"
					aria-label="Toggle full width"
					title="Toggle full width"
				>
					<svg class="expand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="15 3 21 3 21 9"></polyline>
						<polyline points="9 21 3 21 3 15"></polyline>
						<line x1="21" y1="3" x2="14" y2="10"></line>
						<line x1="3" y1="21" x2="10" y2="14"></line>
					</svg>
				</button>
			</div>
		</div>
	</div>

	<!-- Chart Box -->
	<div class="chart-wrapper" id="chart-scroll-container">
		<div class="chart-canvas-inner">
			<!-- SVG Data Canvas -->
			<svg 
				id="progression-svg" 
				viewBox="0 -35 1380 525" 
				class="progression-svg" 
				preserveAspectRatio="xMidYMid meet"
			>
				<defs>
					<!-- Vertical Gradient: Top = Red, Middle = Amber, Bottom = Emerald Green -->
					<linearGradient id="curveGradient" x1="0%" y1="0%" x2="0%" y2="100%">
						<stop offset="0%" stop-color="#ef4444" />
						<stop offset="30%" stop-color="#f87171" />
						<stop offset="55%" stop-color="#f59e0b" />
						<stop offset="85%" stop-color="#10b981" />
						<stop offset="100%" stop-color="#10b981" />
					</linearGradient>

					<linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
						<stop offset="0%" stop-color="rgba(239, 68, 68, 0.18)" />
						<stop offset="50%" stop-color="rgba(245, 158, 11, 0.08)" />
						<stop offset="85%" stop-color="rgba(16, 185, 129, 0.04)" />
						<stop offset="100%" stop-color="rgba(16, 185, 129, 0.01)" />
					</linearGradient>

					<!-- Glow Filter -->
					<filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
						<feGaussianBlur stdDeviation="3.5" result="blur" />
						<feMerge>
							<feMergeNode in="blur" />
							<feMergeNode in="SourceGraphic" />
						</feMerge>
					</filter>

					<!-- Arrow Markers -->
					<marker id="arrowRed" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#ef4444" />
					</marker>
					<marker id="arrowAmber" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#f59e0b" />
					</marker>
					<marker id="arrowGreen" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#10b981" />
					</marker>
				</defs>

				<!-- Background Severity Bands -->
				<rect x="70" y="60" width="1270" height="108" fill="rgba(239, 68, 68, 0.03)" />
				<rect x="70" y="168" width="1270" height="144" fill="rgba(245, 158, 11, 0.025)" />
				<rect x="70" y="312" width="1270" height="108" fill="rgba(16, 185, 129, 0.03)" />

				<!-- Horizontal Grid Lines & Y-Axis Labels (0 to 10 Scale) -->
				<g class="grid-lines">
					<line x1="70" y1="60" x2="1340" y2="60" class="grid-line line-10" />
					<text x="55" y="65" class="axis-label y-val">10</text>

					<line x1="70" y1="132" x2="1340" y2="132" class="grid-line" />
					<text x="55" y="137" class="axis-label y-val">8</text>

					<line x1="70" y1="240" x2="1340" y2="240" class="grid-line line-highlight" />
					<text x="55" y="245" class="axis-label y-val val-5">5</text>

					<line x1="70" y1="348" x2="1340" y2="348" class="grid-line" />
					<text x="55" y="353" class="axis-label y-val">2</text>

					<line x1="70" y1="420" x2="1340" y2="420" class="grid-line axis-x-base" />
					<text x="55" y="425" class="axis-label y-val">0</text>
				</g>

				<!-- Filled Area Under Curve (Extended 3x Baseline on the Right) -->
				<path 
					id="progression-area"
					class="curve-area"
					d="
						M 70 420
						L 70 416
						L 120 416
						C 130 416, 142 132, 152 132
						C 158 132, 164 132, 170 132
						C 180 132, 188 416, 198 416
						L 290 416
						C 300 416, 312 132, 322 132
						C 328 132, 334 132, 340 132
						C 350 132, 358 416, 368 416
						L 460 416
						C 470 416, 482 132, 492 132
						C 498 132, 504 132, 510 132
						C 520 132, 528 416, 538 416
						L 630 416
						C 640 416, 652 132, 662 132
						C 668 132, 674 132, 680 132
						C 690 132, 698 416, 708 416
						L 770 416
						C 778 416, 788 96, 798 96
						C 804 96, 810 96, 816 96
						C 826 96, 832 416, 842 416
						L 910 416
						C 918 416, 928 60, 938 60
						C 944 60, 950 60, 956 60
						C 966 60, 972 416, 982 416
						C 985 416, 988 240, 992 240
						C 996 240, 999 416, 1002 416
						C 1005 416, 1008 240, 1012 240
						C 1016 240, 1019 416, 1022 416
						C 1025 416, 1028 240, 1032 240
						C 1036 240, 1039 416, 1042 416
						C 1045 416, 1048 240, 1052 240
						C 1056 240, 1059 416, 1062 416
						L 1335 416
						L 1335 420
						Z
					"
					fill="url(#areaGradient)"
				/>

				<!-- Main Glowing Line Path -->
				<path 
					id="progression-curve"
					class="curve-line"
					d="
						M 70 416
						L 120 416
						C 130 416, 142 132, 152 132
						C 158 132, 164 132, 170 132
						C 180 132, 188 416, 198 416
						L 290 416
						C 300 416, 312 132, 322 132
						C 328 132, 334 132, 340 132
						C 350 132, 358 416, 368 416
						L 460 416
						C 470 416, 482 132, 492 132
						C 498 132, 504 132, 510 132
						C 520 132, 528 416, 538 416
						L 630 416
						C 640 416, 652 132, 662 132
						C 668 132, 674 132, 680 132
						C 690 132, 698 416, 708 416
						L 770 416
						C 778 416, 788 96, 798 96
						C 804 96, 810 96, 816 96
						C 826 96, 832 416, 842 416
						L 910 416
						C 918 416, 928 60, 938 60
						C 944 60, 950 60, 956 60
						C 966 60, 972 416, 982 416
						C 985 416, 988 240, 992 240
						C 996 240, 999 416, 1002 416
						C 1005 416, 1008 240, 1012 240
						C 1016 240, 1019 416, 1022 416
						C 1025 416, 1028 240, 1032 240
						C 1036 240, 1039 416, 1042 416
						C 1045 416, 1048 240, 1052 240
						C 1056 240, 1059 416, 1062 416
						L 1335 416
					"
					fill="none"
					stroke="url(#curveGradient)"
					stroke-width="4.5"
					filter="url(#glow)"
				/>

				<!-- Rightward Continuing Arrow into the Future -->
				<g class="future-arrow-group">
					<path d="M 1324 408 L 1338 416 L 1324 424" fill="none" stroke="#10b981" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" filter="url(#glow)" />
				</g>

				<!-- Visual Annotations & Titles -->
				<g class="annotations-layer">
					<!-- Peak 1: Trigger #1 Beer & Wine (2 lines) with Hand-Drawn Arrow -->
					<text x="160" y="38" class="annotation-num">Trigger #1</text>
					<text x="160" y="60" class="annotation-title">Beer &</text>
					<text x="160" y="78" class="annotation-title">Wine</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 160 86 C 158 98, 162 108, 160 122" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 155 114 C 157 118, 159 121, 160 124 C 161 121, 163 118, 165 114" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 1: 6 Months Pain-Free (Centered in Valley floor) -->
					<text x="245" y="388" class="annotation-text valley-text">6 Months</text>
					<text x="245" y="401" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 2: Trigger #2 Coffee with Hand-Drawn Arrow -->
					<text x="330" y="46" class="annotation-num">Trigger #2</text>
					<text x="330" y="72" class="annotation-title">Coffee</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 330 82 C 328 94, 332 106, 330 122" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 325 114 C 327 118, 329 121, 330 124 C 331 121, 333 118, 335 114" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 2: 6 Months Pain-Free -->
					<text x="415" y="388" class="annotation-text valley-text">6 Months</text>
					<text x="415" y="401" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 3: Trigger #3 Dental Cleaning (2 lines) with Hand-Drawn Arrow -->
					<text x="500" y="38" class="annotation-num">Trigger #3</text>
					<text x="500" y="60" class="annotation-title">Dental</text>
					<text x="500" y="78" class="annotation-title">Cleaning</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 500 86 C 498 98, 502 108, 500 122" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 495 114 C 497 118, 499 121, 500 124 C 501 121, 503 118, 505 114" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 3: 6 Months Pain-Free -->
					<text x="585" y="388" class="annotation-text valley-text">6 Months</text>
					<text x="585" y="401" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 4: Trigger #4 Most Fruits (2 lines) with Hand-Drawn Arrow -->
					<text x="670" y="38" class="annotation-num">Trigger #4</text>
					<text x="670" y="60" class="annotation-title">Most</text>
					<text x="670" y="78" class="annotation-title">Fruits</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 670 86 C 668 98, 672 108, 670 122" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 665 114 C 667 118, 669 121, 670 124 C 671 121, 673 118, 675 114" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 4: 3-4 Months Pain-Free -->
					<text x="740" y="388" class="annotation-text valley-text">3-4 Months</text>
					<text x="740" y="401" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 5: Trigger #5 Cervical Patches (2 lines) with Hand-Drawn Arrow -->
					<text x="810" y="10" class="annotation-num">Trigger #5</text>
					<text x="810" y="32" class="annotation-title">Cervical</text>
					<text x="810" y="50" class="annotation-title">Patches</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 810 58 C 808 68, 812 76, 810 88" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 805 80 C 807 84, 809 87, 810 90 C 811 87, 813 84, 815 80" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 5: 6 Months Pain-Free -->
					<text x="880" y="388" class="annotation-text valley-text">6 Months</text>
					<text x="880" y="401" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 6: Trigger #6 All Acids with Hand-Drawn Arrow -->
					<text x="950" y="-12" class="annotation-num">Trigger #6</text>
					<text x="950" y="10" class="annotation-title">All Acids</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 950 18 C 948 28, 952 38, 950 52" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 945 44 C 947 48, 949 51, 950 54 C 951 51, 953 48, 955 44" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Vegetables (Cheats) with Hand-Drawn Arrow -->
					<text x="1022" y="180" class="annotation-text yo-yo-text">Vegetables</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 1022 190 C 1020 200, 1024 210, 1022 225" fill="none" stroke="#f59e0b" stroke-width="2.0" stroke-linecap="round" />
						<path d="M 1017 217 C 1019 221, 1021 224, 1022 227 C 1023 224, 1025 221, 1027 217" fill="none" stroke="#f59e0b" stroke-width="2.0" stroke-linecap="round" stroke-linejoin="round" />
					</g>
				</g>

				<!-- Interactive Crosshair & Cursor Point (Only shows on mouse hover for presentations!) -->
				<g id="interactive-cursor" class="interactive-cursor-layer" style="display: none;">
					<line id="cursor-vertical-line" x1="0" y1="50" x2="0" y2="420" class="cursor-line" />
					<circle id="cursor-point" cx="0" cy="0" r="7.5" class="cursor-pulse-point" />
				</g>

				<!-- X-Axis Clean Timeline Labels -->
				<g class="x-axis-labels">
					<text x="160" y="455" class="axis-time-label label-start">Approx. 4 Years Ago</text>
					<text x="950" y="455" class="axis-time-label">18 Months Ago</text>
					<text x="1062" y="455" class="axis-time-label">12 Months Ago</text>
					<text x="1335" y="455" class="axis-time-label label-end">Today</text>
				</g>
			</svg>
		</div>
	</div>
</div>

<style>
	/* Breakout Container: Naturally wider than the text column on desktop for high-impact clarity */
	.interactive-progression-container {
		background: radial-gradient(120% 120% at 50% 0%, #1e1136 0%, #0d081a 60%, #080410 100%);
		border: 1px solid rgba(168, 85, 247, 0.35);
		border-radius: 1.5rem;
		padding: 1.75rem 2rem;
		margin: 3.5rem 0;
		color: #e2e8f0;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		position: relative;
		width: 100%;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 10;
	}

	/* Wide Breakout on Desktops */
	@media (min-width: 900px) {
		.interactive-progression-container {
			width: calc(100% + 180px);
			max-width: 1080px;
			margin-left: -90px;
			margin-right: -90px;
		}
	}

	@media (min-width: 1200px) {
		.interactive-progression-container {
			width: calc(100% + 320px);
			max-width: 1200px;
			margin-left: -160px;
			margin-right: -160px;
		}
	}

	/* Full-Width In-Place Breakout Mode with 50px Padding and Rounded Corners */
	.interactive-progression-container.is-expanded {
		position: relative !important;
		width: calc(100vw - 100px) !important;
		max-width: 1600px !important;
		left: 50% !important;
		transform: translateX(-50%) !important;
		margin-top: 3.5rem !important;
		margin-bottom: 3.5rem !important;
		margin-left: 0 !important;
		margin-right: 0 !important;
		border-radius: 1.5rem !important;
		border: 1px solid rgba(168, 85, 247, 0.5) !important;
		padding: 50px !important;
		box-shadow: 0 30px 70px rgba(0, 0, 0, 0.85), 0 0 40px rgba(168, 85, 247, 0.2) !important;
		z-index: 25 !important;
	}

	@media (max-width: 768px) {
		.interactive-progression-container.is-expanded {
			width: calc(100vw - 24px) !important;
			padding: 24px 16px !important;
			border-radius: 1.15rem !important;
		}
	}

	.interactive-progression-container.is-expanded .widget-header {
		max-width: 1540px;
		margin-left: auto;
		margin-right: auto;
		width: 100%;
	}

	.interactive-progression-container.is-expanded .chart-wrapper {
		max-width: 1540px;
		margin-left: auto;
		margin-right: auto;
		width: 100%;
	}

	.interactive-progression-container.is-expanded .chart-canvas-inner {
		width: 100%;
		min-width: 1100px;
	}

	/* Header */
	.widget-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid rgba(168, 85, 247, 0.18);
		padding-bottom: 1.1rem;
		gap: 1.25rem;
	}

	.widget-header-content {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		width: 100%;
	}

	.widget-title {
		font-size: clamp(2.05rem, 4.2vw, 2.65rem);
		font-weight: 900;
		color: #ffffff;
		margin: 0;
		line-height: 1.1;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.widget-subtitle-row {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		flex-wrap: wrap;
	}

	.widget-subtitle {
		font-size: 0.95rem;
		color: #c084fc;
		font-weight: 600;
		letter-spacing: 0.01em;
	}

	/* Expand Button (Icon-Only, right next to subtitle) */
	.chart-expand-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: rgba(168, 85, 247, 0.18);
		border: 1px solid rgba(168, 85, 247, 0.45);
		color: #f3e8ff;
		width: 30px;
		height: 30px;
		padding: 0;
		border-radius: 0.5rem;
		cursor: pointer;
		transition: all 0.2s ease;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
		flex-shrink: 0;
	}

	.chart-expand-btn:hover {
		background: rgba(168, 85, 247, 0.38);
		border-color: rgba(168, 85, 247, 0.75);
		color: #ffffff;
		transform: translateY(-1px) scale(1.06);
		box-shadow: 0 4px 14px rgba(168, 85, 247, 0.35);
	}

	.expand-icon {
		width: 16px;
		height: 16px;
		transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.interactive-progression-container.is-expanded .expand-icon {
		transform: rotate(180deg);
	}

	/* Chart Canvas */
	.chart-wrapper {
		position: relative;
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		background: rgba(10, 6, 20, 0.6);
		border-radius: 0.85rem;
		border: 1px solid rgba(255, 255, 255, 0.06);
		padding: 0.75rem 0;
	}

	.chart-canvas-inner {
		min-width: 950px;
		position: relative;
	}

	.progression-svg {
		width: 100%;
		height: auto;
		display: block;
		user-select: none;
	}

	.grid-line {
		stroke: rgba(255, 255, 255, 0.08);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}
	.line-10 {
		stroke: rgba(239, 68, 68, 0.25);
	}
	.line-highlight {
		stroke: rgba(245, 158, 11, 0.3);
		stroke-dasharray: 6 3;
	}
	.axis-x-base {
		stroke: rgba(255, 255, 255, 0.25);
		stroke-width: 1.5;
		stroke-dasharray: none;
	}

	.axis-label {
		fill: #94a3b8;
		font-size: 12px;
		font-weight: 600;
		text-anchor: end;
	}
	.val-5 { fill: #fbbf24; font-weight: 700; }

	.annotation-num {
		fill: #f87171;
		font-size: 15.5px;
		font-weight: 800;
		text-anchor: middle;
		letter-spacing: 0.02em;
		filter: drop-shadow(0 0 6px rgba(239, 68, 68, 0.45));
	}

	.annotation-title {
		fill: #ffffff;
		font-size: 14px;
		font-weight: 800;
		text-anchor: middle;
		letter-spacing: 0.01em;
	}

	.valley-text {
		fill: #6ee7b7;
		font-size: 11px;
		font-weight: 700;
		text-anchor: middle;
		dominant-baseline: middle;
	}

	.hand-drawn-arrow-group path {
		filter: drop-shadow(0 0 4px rgba(239, 68, 68, 0.4));
	}
	
	.yo-yo-text {
		fill: #fbbf24;
		font-size: 12px;
		font-weight: 800;
		text-anchor: middle;
	}

	.axis-time-label {
		fill: #cbd5e1;
		font-size: 11.5px;
		font-weight: 600;
		text-anchor: middle;
	}
	.label-start { text-anchor: start; fill: #34d399; font-weight: 700; }
	.label-end { text-anchor: end; fill: #34d399; font-weight: 700; }

	/* Interactive Cursor */
	.cursor-line {
		stroke: rgba(168, 85, 247, 0.6);
		stroke-width: 1.5;
		stroke-dasharray: 4 4;
	}
	.cursor-pulse-point {
		fill: #a855f7;
		stroke: #ffffff;
		stroke-width: 2.5;
		filter: drop-shadow(0 0 10px #a855f7);
	}
</style>

<script>
	function initProgressionChart() {
		const widget = document.getElementById('bms-progression-widget');
		if (!widget) return;

		const expandBtn = document.getElementById('chart-expand-toggle');
		const svg = document.getElementById('progression-svg') as unknown as SVGSVGElement;
		const cursorLayer = document.getElementById('interactive-cursor');
		const cursorLine = document.getElementById('cursor-vertical-line');
		const cursorPoint = document.getElementById('cursor-point');

		// Toggle In-Place Full-Width mode
		if (expandBtn) {
			expandBtn.addEventListener('click', () => {
				const isExpanded = widget.classList.toggle('is-expanded');
				expandBtn.setAttribute('title', isExpanded ? 'Collapse to standard width' : 'Expand to full width');
				expandBtn.setAttribute('aria-label', isExpanded ? 'Collapse to standard width' : 'Expand to full width');
			});

			// Close on Escape key
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && widget.classList.contains('is-expanded')) {
					widget.classList.remove('is-expanded');
					expandBtn.setAttribute('title', 'Expand to full width');
					expandBtn.setAttribute('aria-label', 'Expand to full width');
				}
			});
		}

		if (!svg) return;

		// Interactive presentation pointer following mouse / touch across the timeline
		svg.addEventListener('mousemove', (e: MouseEvent) => {
			const rect = svg.getBoundingClientRect();
			const x = ((e.clientX - rect.left) / rect.width) * 1380;
			const y = ((e.clientY - rect.top) / rect.height) * 525 - 35;

			if (cursorLayer && cursorLine && cursorPoint && x >= 70 && x <= 1340) {
				cursorLayer.style.display = 'block';
				cursorLine.setAttribute('x1', `${x}`);
				cursorLine.setAttribute('x2', `${x}`);
				cursorPoint.setAttribute('cx', `${x}`);
				cursorPoint.setAttribute('cy', `${Math.min(Math.max(y, 60), 420)}`);
			}
		});

		svg.addEventListener('mouseleave', () => {
			if (cursorLayer) cursorLayer.style.display = 'none';
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProgressionChart);
	} else {
		initProgressionChart();
	}
	document.addEventListener('astro:page-load', initProgressionChart);
</script>
