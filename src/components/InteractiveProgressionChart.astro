---
// InteractiveProgressionChart.astro - Universal Interactive BMS Pain Progression Graph (0-10 Scale over 3 Years)
interface Props {
	class?: string;
	title?: string;
}

const {
	class: className = '',
	title = "My 3-Year BMS Progression"
} = Astro.props;
---

<div class={`interactive-progression-container ${className}`} id="bms-progression-widget">
	<!-- Header -->
	<div class="widget-header">
		<h3 class="widget-title">{title}</h3>
	</div>

	<!-- Chart Box -->
	<div class="chart-wrapper" id="chart-scroll-container">
		<div class="chart-canvas-inner">
			<!-- SVG Data Canvas -->
			<svg 
				id="progression-svg" 
				viewBox="0 0 1380 480" 
				class="progression-svg" 
				preserveAspectRatio="xMidYMid meet"
			>
				<defs>
					<!-- Vertical Gradient: Top = Red, Middle = Amber, Bottom = Emerald Green -->
					<linearGradient id="curveGradient" x1="0%" y1="0%" x2="0%" y2="100%">
						<stop offset="0%" stop-color="#ef4444" />
						<stop offset="30%" stop-color="#f87171" />
						<stop offset="55%" stop-color="#f59e0b" />
						<stop offset="85%" stop-color="#10b981" />
						<stop offset="100%" stop-color="#10b981" />
					</linearGradient>

					<linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
						<stop offset="0%" stop-color="rgba(239, 68, 68, 0.18)" />
						<stop offset="50%" stop-color="rgba(245, 158, 11, 0.08)" />
						<stop offset="85%" stop-color="rgba(16, 185, 129, 0.04)" />
						<stop offset="100%" stop-color="rgba(16, 185, 129, 0.01)" />
					</linearGradient>

					<!-- Glow Filter -->
					<filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
						<feGaussianBlur stdDeviation="3.5" result="blur" />
						<feMerge>
							<feMergeNode in="blur" />
							<feMergeNode in="SourceGraphic" />
						</feMerge>
					</filter>

					<!-- Arrow Markers -->
					<marker id="arrowRed" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#ef4444" />
					</marker>
					<marker id="arrowAmber" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#f59e0b" />
					</marker>
					<marker id="arrowGreen" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#10b981" />
					</marker>
				</defs>

				<!-- Background Severity Bands -->
				<rect x="70" y="60" width="1270" height="108" fill="rgba(239, 68, 68, 0.03)" />
				<rect x="70" y="168" width="1270" height="144" fill="rgba(245, 158, 11, 0.025)" />
				<rect x="70" y="312" width="1270" height="108" fill="rgba(16, 185, 129, 0.03)" />

				<!-- Horizontal Grid Lines & Y-Axis Labels (0 to 10 Scale) -->
				<g class="grid-lines">
					<line x1="70" y1="60" x2="1340" y2="60" class="grid-line line-10" />
					<text x="55" y="65" class="axis-label y-val">10</text>

					<line x1="70" y1="132" x2="1340" y2="132" class="grid-line" />
					<text x="55" y="137" class="axis-label y-val">8</text>

					<line x1="70" y1="240" x2="1340" y2="240" class="grid-line line-highlight" />
					<text x="55" y="245" class="axis-label y-val val-5">5</text>

					<line x1="70" y1="348" x2="1340" y2="348" class="grid-line" />
					<text x="55" y="353" class="axis-label y-val">2</text>

					<line x1="70" y1="420" x2="1340" y2="420" class="grid-line axis-x-base" />
					<text x="55" y="425" class="axis-label y-val">0</text>
				</g>

				<!-- Dotted Micro-Spikes Inside Valleys (Zero Text, Pure Visual Detail) -->
				<g class="valley-dotted-spikes">
					<line x1="165" y1="416" x2="165" y2="385" class="micro-spike" />
					<line x1="195" y1="416" x2="195" y2="375" class="micro-spike" />
					<line x1="220" y1="416" x2="220" y2="390" class="micro-spike" />

					<line x1="325" y1="416" x2="325" y2="380" class="micro-spike" />
					<line x1="355" y1="416" x2="355" y2="370" class="micro-spike" />
					<line x1="375" y1="416" x2="375" y2="385" class="micro-spike" />

					<line x1="480" y1="416" x2="480" y2="380" class="micro-spike" />
					<line x1="510" y1="416" x2="510" y2="375" class="micro-spike" />
					<line x1="530" y1="416" x2="530" y2="385" class="micro-spike" />

					<line x1="635" y1="416" x2="635" y2="380" class="micro-spike" />
					<line x1="660" y1="416" x2="660" y2="375" class="micro-spike" />

					<line x1="775" y1="416" x2="775" y2="385" class="micro-spike" />
					<line x1="805" y1="416" x2="805" y2="375" class="micro-spike" />
					<line x1="825" y1="416" x2="825" y2="390" class="micro-spike" />

					<line x1="1130" y1="416" x2="1130" y2="400" class="micro-spike" />
					<line x1="1170" y1="416" x2="1170" y2="395" class="micro-spike" />
					<line x1="1280" y1="416" x2="1280" y2="405" class="micro-spike" />
				</g>

				<!-- Filled Area Under Curve (Smooth Curvy Béziers) -->
				<path 
					id="progression-area"
					class="curve-area"
					d="
						M 70 420
						L 80 416
						C 88 416, 96 132, 110 132
						C 120 132, 130 132, 138 132
						C 148 132, 155 416, 170 416
						L 235 416
						C 245 416, 252 132, 268 132
						C 278 132, 288 132, 296 132
						C 306 132, 314 416, 330 416
						L 390 416
						C 400 416, 408 132, 424 132
						C 434 132, 444 132, 452 132
						C 462 132, 470 416, 485 416
						L 545 416
						C 555 416, 563 132, 579 132
						C 589 132, 599 132, 607 132
						C 617 132, 625 416, 640 416
						L 685 416
						C 695 416, 703 96, 720 96
						C 730 96, 740 96, 748 96
						C 758 96, 766 416, 780 416
						L 840 416
						C 850 416, 860 60, 882 60
						C 896 60, 908 60, 920 60
						C 932 60, 940 416, 952 416
						C 957 416, 961 240, 968 240
						C 974 240, 978 416, 983 416
						C 988 416, 992 240, 999 240
						C 1005 240, 1009 416, 1014 416
						C 1019 416, 1023 240, 1030 240
						C 1036 240, 1040 416, 1045 416
						C 1050 416, 1054 240, 1061 240
						C 1067 240, 1071 416, 1076 416
						L 1210 416
						C 1216 416, 1220 380, 1226 380
						C 1232 380, 1236 416, 1242 416
						L 1340 416
						L 1340 420
						Z
					"
					fill="url(#areaGradient)"
				/>

				<!-- Main Glowing Line Path (Smooth Curves, Curvy Tops & Bottoms) -->
				<path 
					id="progression-curve"
					class="curve-line"
					d="
						M 80 416
						C 88 416, 96 132, 110 132
						C 120 132, 130 132, 138 132
						C 148 132, 155 416, 170 416
						L 235 416
						C 245 416, 252 132, 268 132
						C 278 132, 288 132, 296 132
						C 306 132, 314 416, 330 416
						L 390 416
						C 400 416, 408 132, 424 132
						C 434 132, 444 132, 452 132
						C 462 132, 470 416, 485 416
						L 545 416
						C 555 416, 563 132, 579 132
						C 589 132, 599 132, 607 132
						C 617 132, 625 416, 640 416
						L 685 416
						C 695 416, 703 96, 720 96
						C 730 96, 740 96, 748 96
						C 758 96, 766 416, 780 416
						L 840 416
						C 850 416, 860 60, 882 60
						C 896 60, 908 60, 920 60
						C 932 60, 940 416, 952 416
						C 957 416, 961 240, 968 240
						C 974 240, 978 416, 983 416
						C 988 416, 992 240, 999 240
						C 1005 240, 1009 416, 1014 416
						C 1019 416, 1023 240, 1030 240
						C 1036 240, 1040 416, 1045 416
						C 1050 416, 1054 240, 1061 240
						C 1067 240, 1071 416, 1076 416
						L 1210 416
						C 1216 416, 1220 380, 1226 380
						C 1232 380, 1236 416, 1242 416
						L 1340 416
					"
					fill="none"
					stroke="url(#curveGradient)"
					stroke-width="4.5"
					filter="url(#glow)"
				/>

				<!-- Visual Annotations & Titles (Large Numbers, Clean Title Underneath, Zero Sub-Headlines) -->
				<g class="annotations-layer">
					<!-- Peak 1: #1 Beer and Wine -->
					<line x1="124" y1="92" x2="124" y2="122" class="annotation-arrow" marker-end="url(#arrowRed)" />
					<text x="124" y="60" class="annotation-num">#1</text>
					<text x="124" y="80" class="annotation-title">Beer & Wine</text>

					<!-- Valley 1: 6 Months Pain-Free -->
					<text x="195" y="380" class="annotation-text valley-text">6 Months</text>
					<text x="195" y="396" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 2: #2 Coffee -->
					<line x1="282" y1="92" x2="282" y2="122" class="annotation-arrow" marker-end="url(#arrowRed)" />
					<text x="282" y="60" class="annotation-num">#2</text>
					<text x="282" y="80" class="annotation-title">Coffee</text>

					<!-- Valley 2: 6 Months Pain-Free -->
					<text x="355" y="380" class="annotation-text valley-text">6 Months</text>
					<text x="355" y="396" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 3: #3 Dental Cleaning -->
					<line x1="438" y1="92" x2="438" y2="122" class="annotation-arrow" marker-end="url(#arrowAmber)" />
					<text x="438" y="60" class="annotation-num">#3</text>
					<text x="438" y="80" class="annotation-title">Dental Cleaning</text>

					<!-- Valley 3: 6 Months Pain-Free -->
					<text x="510" y="380" class="annotation-text valley-text">6 Months</text>
					<text x="510" y="396" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 4: #4 Most Fruits -->
					<line x1="593" y1="92" x2="593" y2="122" class="annotation-arrow" marker-end="url(#arrowAmber)" />
					<text x="593" y="60" class="annotation-num">#4</text>
					<text x="593" y="80" class="annotation-title">Most Fruits</text>

					<!-- Valley 4: 3-4 Months Pain-Free -->
					<text x="655" y="380" class="annotation-text valley-text">3-4 Months</text>
					<text x="655" y="396" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 5: #5 4 Cervical Patches -->
					<line x1="734" y1="58" x2="734" y2="88" class="annotation-arrow" marker-end="url(#arrowRed)" />
					<text x="734" y="26" class="annotation-num">#5</text>
					<text x="734" y="46" class="annotation-title">4 Cervical Patches</text>

					<!-- Valley 5: 6 Months Pain-Free -->
					<text x="805" y="380" class="annotation-text valley-text">6 Months</text>
					<text x="805" y="396" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 6: #6 All Acids -->
					<line x1="901" y1="22" x2="901" y2="52" class="annotation-arrow" marker-end="url(#arrowRed)" />
					<text x="901" y="-8" class="annotation-num">#6</text>
					<text x="901" y="12" class="annotation-title">All Acids</text>

					<!-- Vegetables (Cheats) -->
					<line x1="1014" y1="195" x2="1014" y2="225" class="annotation-arrow" marker-end="url(#arrowAmber)" />
					<text x="1014" y="180" class="annotation-text yo-yo-text">Vegetables</text>

					<!-- Cheese -->
					<line x1="1226" y1="345" x2="1226" y2="370" class="annotation-arrow" marker-end="url(#arrowGreen)" />
					<text x="1226" y="335" class="annotation-text cheese-text">Cheese</text>
				</g>

				<!-- Interactive Crosshair & Cursor Point (Only shows on mouse hover!) -->
				<g id="interactive-cursor" class="interactive-cursor-layer" style="display: none;">
					<line id="cursor-vertical-line" x1="0" y1="50" x2="0" y2="420" class="cursor-line" />
					<circle id="cursor-point" cx="0" cy="0" r="7.5" class="cursor-pulse-point" />
				</g>

				<!-- X-Axis Clean Timeline Labels -->
				<g class="x-axis-labels">
					<text x="80" y="455" class="axis-time-label label-start">3 Years Ago</text>
					<text x="355" y="455" class="axis-time-label">2.5 Years</text>
					<text x="655" y="455" class="axis-time-label">1.5 Years</text>
					<text x="901" y="455" class="axis-time-label">1 Year Ago</text>
					<text x="1226" y="455" class="axis-time-label label-end">Today</text>
				</g>
			</svg>

			<!-- Floating Tooltip Box -->
			<div id="chart-tooltip" class="chart-tooltip" style="display: none;">
				<div class="tooltip-header">
					<span id="tooltip-time" class="tooltip-time">Timeframe</span>
					<span id="tooltip-pain" class="tooltip-pain-pill">Pain 5/10</span>
				</div>
				<h4 id="tooltip-title" class="tooltip-title">Milestone Title</h4>
				<p id="tooltip-desc" class="tooltip-desc">Description text</p>
			</div>
		</div>
	</div>
</div>

<style>
	.interactive-progression-container {
		background: radial-gradient(120% 120% at 50% 0%, #1e1136 0%, #0d081a 60%, #080410 100%);
		border: 1px solid rgba(168, 85, 247, 0.25);
		border-radius: 1.25rem;
		padding: 1.75rem;
		margin: 2.5rem 0;
		color: #e2e8f0;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		position: relative;
		overflow: hidden;
	}

	.widget-header {
		margin-bottom: 1.25rem;
		border-bottom: 1px solid rgba(168, 85, 247, 0.15);
		padding-bottom: 0.85rem;
	}

	.widget-title {
		font-size: 1.45rem;
		font-weight: 700;
		color: #f8fafc;
		margin: 0;
		line-height: 1.3;
	}

	/* Chart Canvas */
	.chart-wrapper {
		position: relative;
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		background: rgba(10, 6, 20, 0.6);
		border-radius: 0.75rem;
		border: 1px solid rgba(255, 255, 255, 0.05);
		padding: 0.5rem 0;
	}

	.chart-canvas-inner {
		min-width: 950px;
		position: relative;
	}

	.progression-svg {
		width: 100%;
		height: auto;
		display: block;
		user-select: none;
	}

	.grid-line {
		stroke: rgba(255, 255, 255, 0.08);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}
	.line-10 {
		stroke: rgba(239, 68, 68, 0.25);
	}
	.line-highlight {
		stroke: rgba(245, 158, 11, 0.3);
		stroke-dasharray: 6 3;
	}
	.axis-x-base {
		stroke: rgba(255, 255, 255, 0.25);
		stroke-width: 1.5;
		stroke-dasharray: none;
	}

	.axis-label {
		fill: #94a3b8;
		font-size: 12px;
		font-weight: 600;
		text-anchor: end;
	}
	.val-5 { fill: #fbbf24; font-weight: 700; }

	.micro-spike {
		stroke: rgba(168, 85, 247, 0.35);
		stroke-width: 1.5;
		stroke-dasharray: 2 3;
	}

	.annotation-arrow {
		stroke-width: 1.5;
		opacity: 0.8;
	}
	
	.annotation-num {
		fill: #f87171;
		font-size: 16px;
		font-weight: 800;
		text-anchor: middle;
	}

	.annotation-title {
		fill: #fca5a5;
		font-size: 11.5px;
		font-weight: 700;
		text-anchor: middle;
	}

	.valley-text {
		fill: #6ee7b7;
		font-size: 10px;
		font-weight: 600;
		text-anchor: middle;
		line-height: 1.2;
	}
	
	.yo-yo-text {
		fill: #fbbf24;
		font-size: 11.5px;
		font-weight: 700;
		text-anchor: middle;
	}
	
	.cheese-text {
		fill: #a7f3d0;
		font-size: 11px;
		font-weight: 700;
		text-anchor: middle;
	}

	.axis-time-label {
		fill: #cbd5e1;
		font-size: 11px;
		font-weight: 600;
		text-anchor: middle;
	}
	.label-start { text-anchor: start; fill: #34d399; font-weight: 700; }
	.label-end { text-anchor: end; fill: #34d399; font-weight: 700; }

	/* Interactive Cursor */
	.cursor-line {
		stroke: rgba(168, 85, 247, 0.6);
		stroke-width: 1.5;
		stroke-dasharray: 4 4;
	}
	.cursor-pulse-point {
		fill: #a855f7;
		stroke: #ffffff;
		stroke-width: 2.5;
		filter: drop-shadow(0 0 10px #a855f7);
	}

	/* Tooltip */
	.chart-tooltip {
		position: absolute;
		pointer-events: none;
		background: rgba(15, 23, 42, 0.95);
		border: 1px solid #a855f7;
		border-radius: 0.65rem;
		padding: 0.75rem 1rem;
		width: 240px;
		color: #f8fafc;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
		backdrop-filter: blur(8px);
		z-index: 20;
		transform: translate(-50%, -120%);
		transition: opacity 0.15s ease, transform 0.15s ease;
	}

	.tooltip-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.35rem;
	}
	.tooltip-time {
		font-size: 0.75rem;
		color: #94a3b8;
		font-weight: 600;
	}
	.tooltip-pain-pill {
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.15rem 0.45rem;
		border-radius: 9999px;
		background: rgba(239, 68, 68, 0.2);
		color: #f87171;
		border: 1px solid rgba(239, 68, 68, 0.4);
	}
	.tooltip-title {
		font-size: 0.875rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 0.35rem 0;
		line-height: 1.3;
	}
	.tooltip-desc {
		font-size: 0.775rem;
		color: #cbd5e1;
		margin: 0;
		line-height: 1.4;
	}
</style>

<script>
	function initProgressionChart() {
		const widget = document.getElementById('bms-progression-widget');
		if (!widget) return;

		const svg = document.getElementById('progression-svg') as unknown as SVGSVGElement;
		const tooltip = document.getElementById('chart-tooltip');
		const tooltipTime = document.getElementById('tooltip-time');
		const tooltipPain = document.getElementById('tooltip-pain');
		const tooltipTitle = document.getElementById('tooltip-title');
		const tooltipDesc = document.getElementById('tooltip-desc');

		const cursorLayer = document.getElementById('interactive-cursor');
		const cursorLine = document.getElementById('cursor-vertical-line');
		const cursorPoint = document.getElementById('cursor-point');

		if (!svg) return;

		// Dynamic hover tracking along the timeline
		svg.addEventListener('mousemove', (e: MouseEvent) => {
			const rect = svg.getBoundingClientRect();
			const x = ((e.clientX - rect.left) / rect.width) * 1380;
			const y = ((e.clientY - rect.top) / rect.height) * 480;

			if (cursorLayer && cursorLine && cursorPoint && x >= 70 && x <= 1340) {
				cursorLayer.style.display = 'block';
				cursorLine.setAttribute('x1', `${x}`);
				cursorLine.setAttribute('x2', `${x}`);
				cursorPoint.setAttribute('cx', `${x}`);
				cursorPoint.setAttribute('cy', `${Math.min(Math.max(y, 60), 420)}`);

				// Calculate approximate pain & milestone based on X position
				let painVal = "0";
				let timeVal = "";
				let titleVal = "";
				let descVal = "";

				if (x < 150) {
					painVal = x < 95 ? "0 to 8" : "8";
					timeVal = "3 Years Ago";
					titleVal = "#1 Beer & Wine";
					descVal = "Intense aching triggered by dark ale/alcohol. Elimination stopped the pain.";
				} else if (x < 240) {
					painVal = "0";
					timeVal = "2.8 Years Ago";
					titleVal = "6 Months Pain-Free";
					descVal = "Maintained zero pain after alcohol elimination.";
				} else if (x < 310) {
					painVal = "8";
					timeVal = "2.3 Years Ago";
					titleVal = "#2 Coffee";
					descVal = "Spreading nerve fire. Cutting coffee brought relief back to zero.";
				} else if (x < 390) {
					painVal = "0";
					timeVal = "2.0 Years Ago";
					titleVal = "6 Months Pain-Free";
					descVal = "Maintained zero pain after coffee elimination.";
				} else if (x < 460) {
					painVal = "8";
					timeVal = "1.8 Years Ago";
					titleVal = "#3 Dental Cleaning";
					descVal = "Deep cleaning removed subgingival tartar, returning pain to zero.";
				} else if (x < 545) {
					painVal = "0";
					timeVal = "1.6 Years Ago";
					titleVal = "6 Months Pain-Free";
					descVal = "Post-cleaning relief window.";
				} else if (x < 620) {
					painVal = "8";
					timeVal = "1.4 Years Ago";
					titleVal = "#4 Most Fruits";
					descVal = "Plant acids (pH 3.0) stung nerve endings. Fruit elimination restored zero pain.";
				} else if (x < 685) {
					painVal = "0";
					timeVal = "1.2 Years Ago";
					titleVal = "3-4 Months Pain-Free";
					descVal = "Calm baseline window.";
				} else if (x < 760) {
					painVal = "9";
					timeVal = "1.0 Year Ago";
					titleVal = "#5 4 Cervical Patches";
					descVal = "Severe root recession. 4 composite bonding patches shielded dentin.";
				} else if (x < 840) {
					painVal = "0";
					timeVal = "9 Months Ago";
					titleVal = "6 Months Pain-Free";
					descVal = "Shielded dentin stopped the burn.";
				} else if (x < 940) {
					painVal = "10";
					timeVal = "7 Months Ago";
					titleVal = "#6 All Acids";
					descVal = "Patches degraded. Living fire returned at 10/10. Switched to carnivore.";
				} else if (x < 1080) {
					painVal = "2 to 5";
					timeVal = "6-4 Months Ago";
					titleVal = "Vegetables Flares";
					descVal = "Cheat meals triggered 5/10 flares with 72h latency; meat resets returned to 0-1.";
				} else if (x < 1250) {
					painVal = "0 to 1";
					timeVal = "Present Day";
					titleVal = "Cheese Nuance";
					descVal = "2 meals with cheese creates minor 1/10 blip; otherwise 0 pain.";
				} else {
					painVal = "0";
					timeVal = "Today";
					titleVal = "Pain-Free Baseline";
					descVal = "Strict meat, eggs, seafood baseline.";
				}

				if (tooltip && tooltipTime && tooltipPain && tooltipTitle && tooltipDesc) {
					tooltipTime.textContent = timeVal;
					tooltipPain.textContent = `Pain ${painVal}/10`;
					tooltipTitle.textContent = titleVal;
					tooltipDesc.textContent = descVal;

					const svgRect = svg.getBoundingClientRect();
					const scaleX = svgRect.width / 1380;
					const scaleY = svgRect.height / 480;

					tooltip.style.left = `${x * scaleX}px`;
					tooltip.style.top = `${Math.min(Math.max(y, 60), 420) * scaleY - 15}px`;
					tooltip.style.display = 'block';
				}
			}
		});

		svg.addEventListener('mouseleave', () => {
			if (cursorLayer) cursorLayer.style.display = 'none';
			if (tooltip) tooltip.style.display = 'none';
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProgressionChart);
	} else {
		initProgressionChart();
	}
	document.addEventListener('astro:page-load', initProgressionChart);
</script>
