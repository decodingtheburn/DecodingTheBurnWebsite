---
// InteractiveProgressionChart.astro - Universal Interactive BMS Pain Progression Graph (0-10 Scale over 3 Years)
interface Props {
	class?: string;
	title?: string;
}

const {
	class: className = '',
	title = "My 3-Year BMS Progression"
} = Astro.props;
---

<div class={`interactive-progression-container ${className}`} id="bms-progression-widget">
	<!-- Header with Expand/Collapse Toggle -->
	<div class="widget-header">
		<div class="widget-header-left">
			<h3 class="widget-title">{title}</h3>
			<span class="widget-subtitle">Interactive 3-Year Pain & Triggers Timeline</span>
		</div>
		<button 
			type="button" 
			class="chart-expand-btn" 
			id="chart-expand-toggle"
			aria-label="Toggle wide view"
			title="Expand to full width"
		>
			<svg class="expand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="15 3 21 3 21 9"></polyline>
				<polyline points="9 21 3 21 3 15"></polyline>
				<line x1="21" y1="3" x2="14" y2="10"></line>
				<line x1="3" y1="21" x2="10" y2="14"></line>
			</svg>
			<span class="btn-text">Expand View</span>
		</button>
	</div>

	<!-- Chart Box -->
	<div class="chart-wrapper" id="chart-scroll-container">
		<div class="chart-canvas-inner">
			<!-- SVG Data Canvas -->
			<svg 
				id="progression-svg" 
				viewBox="0 0 1380 480" 
				class="progression-svg" 
				preserveAspectRatio="xMidYMid meet"
			>
				<defs>
					<!-- Vertical Gradient: Top = Red, Middle = Amber, Bottom = Emerald Green -->
					<linearGradient id="curveGradient" x1="0%" y1="0%" x2="0%" y2="100%">
						<stop offset="0%" stop-color="#ef4444" />
						<stop offset="30%" stop-color="#f87171" />
						<stop offset="55%" stop-color="#f59e0b" />
						<stop offset="85%" stop-color="#10b981" />
						<stop offset="100%" stop-color="#10b981" />
					</linearGradient>

					<linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
						<stop offset="0%" stop-color="rgba(239, 68, 68, 0.18)" />
						<stop offset="50%" stop-color="rgba(245, 158, 11, 0.08)" />
						<stop offset="85%" stop-color="rgba(16, 185, 129, 0.04)" />
						<stop offset="100%" stop-color="rgba(16, 185, 129, 0.01)" />
					</linearGradient>

					<!-- Glow Filter -->
					<filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
						<feGaussianBlur stdDeviation="3.5" result="blur" />
						<feMerge>
							<feMergeNode in="blur" />
							<feMergeNode in="SourceGraphic" />
						</feMerge>
					</filter>

					<!-- Arrow Markers -->
					<marker id="arrowRed" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#ef4444" />
					</marker>
					<marker id="arrowAmber" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#f59e0b" />
					</marker>
					<marker id="arrowGreen" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#10b981" />
					</marker>
				</defs>

				<!-- Background Severity Bands -->
				<rect x="70" y="60" width="1270" height="108" fill="rgba(239, 68, 68, 0.03)" />
				<rect x="70" y="168" width="1270" height="144" fill="rgba(245, 158, 11, 0.025)" />
				<rect x="70" y="312" width="1270" height="108" fill="rgba(16, 185, 129, 0.03)" />

				<!-- Horizontal Grid Lines & Y-Axis Labels (0 to 10 Scale) -->
				<g class="grid-lines">
					<line x1="70" y1="60" x2="1340" y2="60" class="grid-line line-10" />
					<text x="55" y="65" class="axis-label y-val">10</text>

					<line x1="70" y1="132" x2="1340" y2="132" class="grid-line" />
					<text x="55" y="137" class="axis-label y-val">8</text>

					<line x1="70" y1="240" x2="1340" y2="240" class="grid-line line-highlight" />
					<text x="55" y="245" class="axis-label y-val val-5">5</text>

					<line x1="70" y1="348" x2="1340" y2="348" class="grid-line" />
					<text x="55" y="353" class="axis-label y-val">2</text>

					<line x1="70" y1="420" x2="1340" y2="420" class="grid-line axis-x-base" />
					<text x="55" y="425" class="axis-label y-val">0</text>
				</g>

				<!-- Filled Area Under Curve (Smooth Curvy Béziers) -->
				<path 
					id="progression-area"
					class="curve-area"
					d="
						M 70 420
						L 80 416
						C 88 416, 96 132, 110 132
						C 120 132, 130 132, 138 132
						C 148 132, 155 416, 170 416
						L 235 416
						C 245 416, 252 132, 268 132
						C 278 132, 288 132, 296 132
						C 306 132, 314 416, 330 416
						L 390 416
						C 400 416, 408 132, 424 132
						C 434 132, 444 132, 452 132
						C 462 132, 470 416, 485 416
						L 545 416
						C 555 416, 563 132, 579 132
						C 589 132, 599 132, 607 132
						C 617 132, 625 416, 640 416
						L 685 416
						C 695 416, 703 96, 720 96
						C 730 96, 740 96, 748 96
						C 758 96, 766 416, 780 416
						L 840 416
						C 850 416, 860 60, 882 60
						C 896 60, 908 60, 920 60
						C 932 60, 940 416, 952 416
						C 957 416, 961 240, 968 240
						C 974 240, 978 416, 983 416
						C 988 416, 992 240, 999 240
						C 1005 240, 1009 416, 1014 416
						C 1019 416, 1023 240, 1030 240
						C 1036 240, 1040 416, 1045 416
						C 1050 416, 1054 240, 1061 240
						C 1067 240, 1071 416, 1076 416
						L 1210 416
						C 1216 416, 1220 380, 1226 380
						C 1232 380, 1236 416, 1242 416
						L 1340 416
						L 1340 420
						Z
					"
					fill="url(#areaGradient)"
				/>

				<!-- Main Glowing Line Path (Smooth Curves, Curvy Tops & Bottoms) -->
				<path 
					id="progression-curve"
					class="curve-line"
					d="
						M 80 416
						C 88 416, 96 132, 110 132
						C 120 132, 130 132, 138 132
						C 148 132, 155 416, 170 416
						L 235 416
						C 245 416, 252 132, 268 132
						C 278 132, 288 132, 296 132
						C 306 132, 314 416, 330 416
						L 390 416
						C 400 416, 408 132, 424 132
						C 434 132, 444 132, 452 132
						C 462 132, 470 416, 485 416
						L 545 416
						C 555 416, 563 132, 579 132
						C 589 132, 599 132, 607 132
						C 617 132, 625 416, 640 416
						L 685 416
						C 695 416, 703 96, 720 96
						C 730 96, 740 96, 748 96
						C 758 96, 766 416, 780 416
						L 840 416
						C 850 416, 860 60, 882 60
						C 896 60, 908 60, 920 60
						C 932 60, 940 416, 952 416
						C 957 416, 961 240, 968 240
						C 974 240, 978 416, 983 416
						C 988 416, 992 240, 999 240
						C 1005 240, 1009 416, 1014 416
						C 1019 416, 1023 240, 1030 240
						C 1036 240, 1040 416, 1045 416
						C 1050 416, 1054 240, 1061 240
						C 1067 240, 1071 416, 1076 416
						L 1210 416
						C 1216 416, 1220 380, 1226 380
						C 1232 380, 1236 416, 1242 416
						L 1340 416
					"
					fill="none"
					stroke="url(#curveGradient)"
					stroke-width="4.5"
					filter="url(#glow)"
				/>

				<!-- Visual Annotations & Titles (Large Numbers, Pure White Titles Underneath) -->
				<g class="annotations-layer">
					<!-- Peak 1: #1 Beer and Wine with Hand-Drawn Arrow -->
					<text x="124" y="58" class="annotation-num">#1</text>
					<text x="124" y="80" class="annotation-title annotation-beer-wine">Beer & Wine</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 124 88 C 122 98, 126 108, 124 122" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 119 114 C 121 118, 123 121, 124 124 C 125 121, 127 118, 129 114" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 1: 6 Months Pain-Free (Centered in Valley floor) -->
					<text x="202" y="388" class="annotation-text valley-text">6 Months</text>
					<text x="202" y="400" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 2: #2 Coffee with Hand-Drawn Arrow -->
					<text x="282" y="58" class="annotation-num">#2</text>
					<text x="282" y="80" class="annotation-title">Coffee</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 282 88 C 280 98, 284 108, 282 122" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 277 114 C 279 118, 281 121, 282 124 C 283 121, 285 118, 287 114" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 2: 6 Months Pain-Free -->
					<text x="360" y="388" class="annotation-text valley-text">6 Months</text>
					<text x="360" y="400" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 3: #3 Dental Cleaning with Hand-Drawn Arrow -->
					<text x="438" y="58" class="annotation-num">#3</text>
					<text x="438" y="80" class="annotation-title">Dental Cleaning</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 438 88 C 436 98, 440 108, 438 122" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 433 114 C 435 118, 437 121, 438 124 C 439 121, 441 118, 443 114" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 3: 6 Months Pain-Free -->
					<text x="515" y="388" class="annotation-text valley-text">6 Months</text>
					<text x="515" y="400" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 4: #4 Most Fruits with Hand-Drawn Arrow -->
					<text x="593" y="58" class="annotation-num">#4</text>
					<text x="593" y="80" class="annotation-title">Most Fruits</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 593 88 C 591 98, 595 108, 593 122" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 588 114 C 590 118, 592 121, 593 124 C 594 121, 596 118, 598 114" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 4: 3-4 Months Pain-Free -->
					<text x="662" y="388" class="annotation-text valley-text">3-4 Months</text>
					<text x="662" y="400" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 5: #5 4 Cervical Patches with Hand-Drawn Arrow -->
					<text x="734" y="24" class="annotation-num">#5</text>
					<text x="734" y="46" class="annotation-title">4 Cervical Patches</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 734 54 C 732 64, 736 74, 734 88" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 729 80 C 731 84, 733 87, 734 90 C 735 87, 737 84, 739 80" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 5: 6 Months Pain-Free -->
					<text x="810" y="388" class="annotation-text valley-text">6 Months</text>
					<text x="810" y="400" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 6: #6 All Acids with Hand-Drawn Arrow -->
					<text x="901" y="-10" class="annotation-num">#6</text>
					<text x="901" y="12" class="annotation-title">All Acids</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 901 20 C 899 30, 903 40, 901 52" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 896 44 C 898 48, 900 51, 901 54 C 902 51, 904 48, 906 44" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Vegetables (Cheats) with Hand-Drawn Arrow -->
					<text x="1014" y="180" class="annotation-text yo-yo-text">Vegetables</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 1014 190 C 1012 200, 1016 210, 1014 225" fill="none" stroke="#f59e0b" stroke-width="2.0" stroke-linecap="round" />
						<path d="M 1009 217 C 1011 221, 1013 224, 1014 227 C 1015 224, 1017 221, 1019 217" fill="none" stroke="#f59e0b" stroke-width="2.0" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Cheese with Hand-Drawn Arrow -->
					<text x="1226" y="335" class="annotation-text cheese-text">Cheese</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 1226 342 C 1225 350, 1227 358, 1226 368" fill="none" stroke="#10b981" stroke-width="2.0" stroke-linecap="round" />
						<path d="M 1222 360 C 1224 364, 1225 367, 1226 370 C 1227 367, 1228 364, 1230 360" fill="none" stroke="#10b981" stroke-width="2.0" stroke-linecap="round" stroke-linejoin="round" />
					</g>
				</g>

				<!-- Interactive Crosshair & Cursor Point (Only shows on mouse hover for presentations!) -->
				<g id="interactive-cursor" class="interactive-cursor-layer" style="display: none;">
					<line id="cursor-vertical-line" x1="0" y1="50" x2="0" y2="420" class="cursor-line" />
					<circle id="cursor-point" cx="0" cy="0" r="7.5" class="cursor-pulse-point" />
				</g>

				<!-- X-Axis Clean Timeline Labels (April 2023 ... April 2025 ... Today) -->
				<g class="x-axis-labels">
					<text x="80" y="455" class="axis-time-label label-start">April 2023</text>
					<text x="900" y="455" class="axis-time-label">April 2025</text>
					<text x="1320" y="455" class="axis-time-label label-end">Today</text>
				</g>
			</svg>
		</div>
	</div>
</div>

<style>
	/* Breakout Container: Naturally wider than the text column on desktop for high-impact clarity */
	.interactive-progression-container {
		background: radial-gradient(120% 120% at 50% 0%, #1e1136 0%, #0d081a 60%, #080410 100%);
		border: 1px solid rgba(168, 85, 247, 0.3);
		border-radius: 1.25rem;
		padding: 1.5rem 1.75rem;
		margin: 3rem 0;
		color: #e2e8f0;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		position: relative;
		width: 100%;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 10;
	}

	/* Wide Breakout on Desktops */
	@media (min-width: 900px) {
		.interactive-progression-container {
			width: calc(100% + 180px);
			max-width: 1080px;
			margin-left: -90px;
			margin-right: -90px;
		}
	}

	@media (min-width: 1200px) {
		.interactive-progression-container {
			width: calc(100% + 320px);
			max-width: 1200px;
			margin-left: -160px;
			margin-right: -160px;
		}
	}

	/* Fullscreen / Full-Width Expand Mode */
	.interactive-progression-container.is-expanded {
		position: fixed !important;
		top: 2.5vh;
		left: 2.5vw;
		width: 95vw !important;
		max-width: 1500px !important;
		height: 95vh;
		margin: 0 !important;
		z-index: 99999 !important;
		display: flex;
		flex-direction: column;
		box-shadow: 0 30px 100px rgba(0, 0, 0, 0.9), 0 0 0 100vmax rgba(0, 0, 0, 0.85);
		padding: 2rem 2.5rem;
		backdrop-filter: blur(12px);
	}

	.interactive-progression-container.is-expanded .chart-wrapper {
		flex: 1;
		display: flex;
		align-items: center;
	}

	.interactive-progression-container.is-expanded .chart-canvas-inner {
		width: 100%;
		min-width: 1000px;
	}

	/* Header */
	.widget-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.25rem;
		border-bottom: 1px solid rgba(168, 85, 247, 0.18);
		padding-bottom: 0.85rem;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.widget-header-left {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.widget-title {
		font-size: 1.4rem;
		font-weight: 800;
		color: #ffffff;
		margin: 0;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	.widget-subtitle {
		font-size: 0.82rem;
		color: #c084fc;
		font-weight: 500;
		letter-spacing: 0.01em;
	}

	/* Expand Button */
	.chart-expand-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(168, 85, 247, 0.15);
		border: 1px solid rgba(168, 85, 247, 0.35);
		color: #e9d5ff;
		padding: 0.45rem 0.85rem;
		border-radius: 0.5rem;
		font-size: 0.82rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.chart-expand-btn:hover {
		background: rgba(168, 85, 247, 0.3);
		border-color: rgba(168, 85, 247, 0.6);
		color: #ffffff;
		transform: translateY(-1px);
	}

	.expand-icon {
		width: 15px;
		height: 15px;
	}

	/* Chart Canvas */
	.chart-wrapper {
		position: relative;
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		background: rgba(10, 6, 20, 0.6);
		border-radius: 0.75rem;
		border: 1px solid rgba(255, 255, 255, 0.05);
		padding: 0.5rem 0;
	}

	.chart-canvas-inner {
		min-width: 950px;
		position: relative;
	}

	.progression-svg {
		width: 100%;
		height: auto;
		display: block;
		user-select: none;
	}

	.grid-line {
		stroke: rgba(255, 255, 255, 0.08);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}
	.line-10 {
		stroke: rgba(239, 68, 68, 0.25);
	}
	.line-highlight {
		stroke: rgba(245, 158, 11, 0.3);
		stroke-dasharray: 6 3;
	}
	.axis-x-base {
		stroke: rgba(255, 255, 255, 0.25);
		stroke-width: 1.5;
		stroke-dasharray: none;
	}

	.axis-label {
		fill: #94a3b8;
		font-size: 12px;
		font-weight: 600;
		text-anchor: end;
	}
	.val-5 { fill: #fbbf24; font-weight: 700; }

	.annotation-arrow {
		stroke-width: 1.5;
		opacity: 0.8;
	}
	
	.annotation-num {
		fill: #f87171;
		font-size: 16px;
		font-weight: 800;
		text-anchor: middle;
	}

	.annotation-title {
		fill: #ffffff;
		font-size: 13.5px;
		font-weight: 700;
		text-anchor: middle;
		letter-spacing: 0.01em;
	}

	.annotation-beer-wine {
		fill: #ffffff;
		font-size: 15px;
		font-weight: 800;
	}

	.valley-text {
		fill: #6ee7b7;
		font-size: 10.5px;
		font-weight: 600;
		text-anchor: middle;
		dominant-baseline: middle;
	}

	.hand-drawn-arrow-group path {
		filter: drop-shadow(0 0 4px rgba(239, 68, 68, 0.4));
	}
	
	.yo-yo-text {
		fill: #fbbf24;
		font-size: 11.5px;
		font-weight: 700;
		text-anchor: middle;
	}
	
	.cheese-text {
		fill: #a7f3d0;
		font-size: 11px;
		font-weight: 700;
		text-anchor: middle;
	}

	.axis-time-label {
		fill: #cbd5e1;
		font-size: 11px;
		font-weight: 600;
		text-anchor: middle;
	}
	.label-start { text-anchor: start; fill: #34d399; font-weight: 700; }
	.label-end { text-anchor: end; fill: #34d399; font-weight: 700; }

	/* Interactive Cursor */
	.cursor-line {
		stroke: rgba(168, 85, 247, 0.6);
		stroke-width: 1.5;
		stroke-dasharray: 4 4;
	}
	.cursor-pulse-point {
		fill: #a855f7;
		stroke: #ffffff;
		stroke-width: 2.5;
		filter: drop-shadow(0 0 10px #a855f7);
	}
</style>

<script>
	function initProgressionChart() {
		const widget = document.getElementById('bms-progression-widget');
		if (!widget) return;

		const expandBtn = document.getElementById('chart-expand-toggle');
		const svg = document.getElementById('progression-svg') as unknown as SVGSVGElement;
		const cursorLayer = document.getElementById('interactive-cursor');
		const cursorLine = document.getElementById('cursor-vertical-line');
		const cursorPoint = document.getElementById('cursor-point');

		// Toggle Expand / Breakout mode
		if (expandBtn) {
			expandBtn.addEventListener('click', () => {
				const isExpanded = widget.classList.toggle('is-expanded');
				const btnText = expandBtn.querySelector('.btn-text');
				if (btnText) {
					btnText.textContent = isExpanded ? 'Exit Fullscreen' : 'Expand View';
				}
				if (isExpanded) {
					document.body.style.overflow = 'hidden';
				} else {
					document.body.style.overflow = '';
				}
			});

			// Close on Escape key
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && widget.classList.contains('is-expanded')) {
					widget.classList.remove('is-expanded');
					document.body.style.overflow = '';
					const btnText = expandBtn.querySelector('.btn-text');
					if (btnText) btnText.textContent = 'Expand View';
				}
			});
		}

		if (!svg) return;

		// Interactive presentation pointer following mouse / touch across the timeline
		svg.addEventListener('mousemove', (e: MouseEvent) => {
			const rect = svg.getBoundingClientRect();
			const x = ((e.clientX - rect.left) / rect.width) * 1380;
			const y = ((e.clientY - rect.top) / rect.height) * 480;

			if (cursorLayer && cursorLine && cursorPoint && x >= 70 && x <= 1340) {
				cursorLayer.style.display = 'block';
				cursorLine.setAttribute('x1', `${x}`);
				cursorLine.setAttribute('x2', `${x}`);
				cursorPoint.setAttribute('cx', `${x}`);
				cursorPoint.setAttribute('cy', `${Math.min(Math.max(y, 60), 420)}`);
			}
		});

		svg.addEventListener('mouseleave', () => {
			if (cursorLayer) cursorLayer.style.display = 'none';
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProgressionChart);
	} else {
		initProgressionChart();
	}
	document.addEventListener('astro:page-load', initProgressionChart);
</script>
