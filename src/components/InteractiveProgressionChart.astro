---
// InteractiveProgressionChart.astro - Universal Interactive BMS Pain Progression Graph (0-10 Scale over 4+ Years)
interface Props {
	class?: string;
	title?: string;
}

const {
	class: className = '',
	title = ""
} = Astro.props;
---

<div class={`interactive-progression-container tts-ignore ${className}`} id="bms-progression-widget">
	<!-- Discreet Grayscale Maximize Toggle in the Upper Right -->
	<button 
		type="button" 
		class="chart-expand-btn" 
		id="chart-expand-toggle"
		aria-label="Toggle full width"
		title="Toggle full width"
	>
		<svg class="expand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
			<polyline points="15 3 21 3 21 9"></polyline>
			<polyline points="9 21 3 21 3 15"></polyline>
			<line x1="21" y1="3" x2="14" y2="10"></line>
			<line x1="3" y1="21" x2="10" y2="14"></line>
		</svg>
	</button>

	<!-- Header with Title & Non-Wrapping Subheadline -->
	<div class="widget-header">
		<div class="widget-header-content">
			<h3 class="widget-title">
				<span class="widget-title-main">My BMS Experiments</span>
			</h3>
			<div class="widget-subtitle-row">
				<span class="widget-subtitle">Experiment List and Pain Levels</span>
			</div>
		</div>
	</div>

	<!-- Chart Box -->
	<div class="chart-wrapper" id="chart-scroll-container">
		<div class="chart-canvas-inner">
			<!-- SVG Data Canvas (Generous padding ensuring sideways Pain Level, Solution #6, and 4-Year timeline are never clipped) -->
			<svg 
				id="progression-svg" 
				viewBox="-55 -70 1485 610" 
				class="progression-svg" 
				preserveAspectRatio="xMidYMid meet"
			>
				<defs>
					<!-- Discrete Stepped Gradient: 5-10 = Red, 2-5 = Yellow, 0-2 = Emerald Green (Sharp boundaries, no soft blends) -->
					<linearGradient id="curveGradient" x1="0%" y1="0%" x2="0%" y2="100%">
						<!-- Pain 5 to 10 (Y=60 to Y=240, 50%): Pure Red -->
						<stop offset="0%" stop-color="#ef4444" />
						<stop offset="50%" stop-color="#ef4444" />
						<!-- Sharp Step into Yellow at Pain 5 (Y=240, 50%) -->
						<stop offset="50%" stop-color="#f59e0b" />
						<stop offset="80%" stop-color="#f59e0b" />
						<!-- Sharp Step into Emerald Green at Pain 2 (Y=348, 80%) -->
						<stop offset="80%" stop-color="#10b981" />
						<stop offset="100%" stop-color="#10b981" />
					</linearGradient>

					<linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
						<!-- Pain 5 to 10: Red tint -->
						<stop offset="0%" stop-color="rgba(239, 68, 68, 0.18)" />
						<stop offset="50%" stop-color="rgba(239, 68, 68, 0.18)" />
						<!-- Pain 2 to 5: Amber tint -->
						<stop offset="50%" stop-color="rgba(245, 158, 11, 0.10)" />
						<stop offset="80%" stop-color="rgba(245, 158, 11, 0.10)" />
						<!-- Pain 0 to 2: Green tint -->
						<stop offset="80%" stop-color="rgba(16, 185, 129, 0.05)" />
						<stop offset="100%" stop-color="rgba(16, 185, 129, 0.02)" />
					</linearGradient>

					<!-- Glow Filter -->
					<filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
						<feGaussianBlur stdDeviation="3.5" result="blur" />
						<feMerge>
							<feMergeNode in="blur" />
							<feMergeNode in="SourceGraphic" />
						</feMerge>
					</filter>

					<!-- Arrow Markers -->
					<marker id="arrowRed" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#ef4444" />
					</marker>
					<marker id="arrowAmber" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#f59e0b" />
					</marker>
					<marker id="arrowGreen" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
						<path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#10b981" />
					</marker>
					<marker id="arrowTimeline" viewBox="0 0 12 12" refX="8" refY="6" markerWidth="8" markerHeight="8" orient="auto">
						<path d="M 1 2 L 10 6 L 1 10 z" fill="#a855f7" />
					</marker>
				</defs>

				<!-- Background Discrete Severity Bands (0-2 Green, 2-5 Yellow/Amber, 5-10 Red) -->
				<rect x="70" y="60" width="1340" height="180" fill="rgba(239, 68, 68, 0.035)" />
				<rect x="70" y="240" width="1340" height="108" fill="rgba(245, 158, 11, 0.028)" />
				<rect x="70" y="348" width="1340" height="72" fill="rgba(16, 185, 129, 0.035)" />

				<!-- Vertical Milestone Divider Lines -->
				<g class="milestone-dividers">
					<line x1="160" y1="60" x2="160" y2="468" class="milestone-divider-line" />
					<line x1="950" y1="60" x2="950" y2="468" class="milestone-divider-line line-highlight-divider" />
					<line x1="1180" y1="60" x2="1180" y2="468" class="milestone-divider-line" />
					<line x1="1400" y1="60" x2="1400" y2="468" class="milestone-divider-line line-today-divider" />
				</g>

				<!-- Sideways Pain Level Title (Title Case) -->
				<g class="y-axis-sideways-group">
					<text transform="rotate(-90)" x="-240" y="-18" class="y-axis-sideways-title">Pain Level</text>
				</g>

				<!-- Horizontal Grid Lines & Y-Axis Labels (10/10, High Pain, 5/10, Medium Pain, 2/10, Low Pain, 0/10) -->
				<g class="grid-lines">
					<line x1="70" y1="60" x2="1410" y2="60" class="grid-line line-10" />
					<text x="38" y="65" class="axis-label y-val val-10">10/10</text>

					<!-- High Pain stacked label in red zone (Title Case) -->
					<text x="38" y="142" class="zone-label-horizontal label-high">
						<tspan x="38" dy="0">High</tspan>
						<tspan x="38" dy="14">Pain</tspan>
					</text>

					<line x1="70" y1="240" x2="1410" y2="240" class="grid-line line-highlight" />
					<text x="38" y="245" class="axis-label y-val val-5">5/10</text>

					<!-- Medium Pain stacked label in amber zone (Title Case) -->
					<text x="38" y="288" class="zone-label-horizontal label-medium">
						<tspan x="38" dy="0">Medium</tspan>
						<tspan x="38" dy="14">Pain</tspan>
					</text>

					<line x1="70" y1="348" x2="1410" y2="348" class="grid-line line-green" />
					<text x="38" y="353" class="axis-label y-val val-2">2/10</text>

					<!-- Low Pain stacked label in green zone (Title Case) -->
					<text x="38" y="378" class="zone-label-horizontal label-low">
						<tspan x="38" dy="0">Low</tspan>
						<tspan x="38" dy="14">Pain</tspan>
					</text>

					<line x1="70" y1="420" x2="1410" y2="420" class="grid-line axis-x-base" />
					<text x="38" y="425" class="axis-label y-val val-0">0/10</text>
				</g>

				<!-- Filled Area Under Curve (Descending Yo-Yo Valleys & 0/10 Baseline on the Right) -->
				<path 
					id="progression-area"
					class="curve-area"
					d="
						M 70 420
						L 70 416
						L 120 416
						C 130 416, 142 132, 152 132
						C 158 132, 164 132, 170 132
						C 180 132, 188 416, 198 416
						L 290 416
						C 300 416, 312 132, 322 132
						C 328 132, 334 132, 340 132
						C 350 132, 358 416, 368 416
						L 460 416
						C 470 416, 482 132, 492 132
						C 498 132, 504 132, 510 132
						C 520 132, 528 416, 538 416
						L 630 416
						C 640 416, 652 132, 662 132
						C 668 132, 674 132, 680 132
						C 690 132, 698 416, 708 416
						L 770 416
						C 778 416, 788 96, 798 96
						C 804 96, 810 96, 816 96
						C 826 96, 832 416, 842 416
						L 910 416
						C 918 416, 928 60, 938 60
						C 944 60, 950 60, 956 60
						C 966 60, 972 348, 978 348
						C 981 348, 986 220, 991 220
						C 996 220, 1000 350, 1005 350
						C 1009 350, 1014 240, 1019 240
						C 1024 240, 1028 355, 1033 355
						C 1037 355, 1042 260, 1047 260
						C 1052 260, 1056 360, 1061 360
						C 1065 360, 1070 285, 1075 285
						C 1080 285, 1084 370, 1089 370
						C 1093 370, 1098 305, 1103 305
						C 1108 305, 1112 382, 1117 382
						C 1121 382, 1126 325, 1131 325
						C 1136 325, 1140 395, 1145 395
						C 1149 395, 1154 350, 1159 350
						C 1164 350, 1168 405, 1173 405
						C 1176 405, 1178 380, 1180 380
						C 1182 380, 1184 416, 1188 416
						L 1400 416
						L 1400 420
						Z
					"
					fill="url(#areaGradient)"
				/>

				<!-- Main Glowing Line Path -->
				<path 
					id="progression-curve"
					class="curve-line"
					d="
						M 70 416
						L 120 416
						C 130 416, 142 132, 152 132
						C 158 132, 164 132, 170 132
						C 180 132, 188 416, 198 416
						L 290 416
						C 300 416, 312 132, 322 132
						C 328 132, 334 132, 340 132
						C 350 132, 358 416, 368 416
						L 460 416
						C 470 416, 482 132, 492 132
						C 498 132, 504 132, 510 132
						C 520 132, 528 416, 538 416
						L 630 416
						C 640 416, 652 132, 662 132
						C 668 132, 674 132, 680 132
						C 690 132, 698 416, 708 416
						L 770 416
						C 778 416, 788 96, 798 96
						C 804 96, 810 96, 816 96
						C 826 96, 832 416, 842 416
						L 910 416
						C 918 416, 928 60, 938 60
						C 944 60, 950 60, 956 60
						C 966 60, 972 348, 978 348
						C 981 348, 986 220, 991 220
						C 996 220, 1000 350, 1005 350
						C 1009 350, 1014 240, 1019 240
						C 1024 240, 1028 355, 1033 355
						C 1037 355, 1042 260, 1047 260
						C 1052 260, 1056 360, 1061 360
						C 1065 360, 1070 285, 1075 285
						C 1080 285, 1084 370, 1089 370
						C 1093 370, 1098 305, 1103 305
						C 1108 305, 1112 382, 1117 382
						C 1121 382, 1126 325, 1131 325
						C 1136 325, 1140 395, 1145 395
						C 1149 395, 1154 350, 1159 350
						C 1164 350, 1168 405, 1173 405
						C 1176 405, 1178 380, 1180 380
						C 1182 380, 1184 416, 1188 416
						L 1400 416
					"
					fill="none"
					stroke="url(#curveGradient)"
					stroke-width="4.5"
					filter="url(#glow)"
				/>

				<!-- Rightward Continuing Arrow into the Future -->
				<g class="future-arrow-group">
					<path d="M 1390 408 L 1405 416 L 1390 424" fill="none" stroke="#10b981" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" filter="url(#glow)" />
				</g>

				<!-- Visual Annotations & Titles -->
				<g class="annotations-layer">
					<!-- Peak 1: Experiment #1 with Hand-Drawn Arrow -->
					<text x="160" y="24" class="annotation-num">Experiment #1</text>
					<text x="160" y="44" class="annotation-title">Eliminate</text>
					<text x="160" y="62" class="annotation-title">Beer & Wine</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 160 70 C 158 84, 162 98, 160 122" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 155 114 C 157 118, 159 121, 160 124 C 161 121, 163 118, 165 114" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 1: ~6 Months Pain-Free -->
					<text x="245" y="388" class="annotation-text valley-text">~6 Months</text>
					<text x="245" y="401" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 2: Experiment #2 with Hand-Drawn Arrow -->
					<text x="330" y="24" class="annotation-num">Experiment #2</text>
					<text x="330" y="44" class="annotation-title">Eliminate</text>
					<text x="330" y="62" class="annotation-title">Coffee</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 330 70 C 328 84, 332 98, 330 122" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 325 114 C 327 118, 329 121, 330 124 C 331 121, 333 118, 335 114" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 2: ~6 Months Pain-Free -->
					<text x="415" y="388" class="annotation-text valley-text">~6 Months</text>
					<text x="415" y="401" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 3: Experiment #3 Dental Cleaning with Hand-Drawn Arrow -->
					<text x="500" y="38" class="annotation-num">Experiment #3</text>
					<text x="500" y="60" class="annotation-title">Dental</text>
					<text x="500" y="78" class="annotation-title">Cleaning</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 500 86 C 498 98, 502 108, 500 122" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 495 114 C 497 118, 499 121, 500 124 C 501 121, 503 118, 505 114" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 3: ~6 Months Pain-Free -->
					<text x="585" y="388" class="annotation-text valley-text">~6 Months</text>
					<text x="585" y="401" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 4: Experiment #4 with Hand-Drawn Arrow -->
					<text x="670" y="24" class="annotation-num">Experiment #4</text>
					<text x="670" y="44" class="annotation-title">Eliminate</text>
					<text x="670" y="62" class="annotation-title">Most Fruit</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 670 70 C 668 84, 672 98, 670 122" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 665 114 C 667 118, 669 121, 670 124 C 671 121, 673 118, 675 114" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 4: ~6 Months Pain-Free -->
					<text x="740" y="388" class="annotation-text valley-text">~6 Months</text>
					<text x="740" y="401" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 5: Experiment #5 Cervical Patches with Hand-Drawn Arrow -->
					<text x="810" y="10" class="annotation-num">Experiment #5</text>
					<text x="810" y="32" class="annotation-title">Cervical</text>
					<text x="810" y="50" class="annotation-title">Patches</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 810 58 C 808 68, 812 76, 810 88" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 805 80 C 807 84, 809 87, 810 90 C 811 87, 813 84, 815 80" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- Valley 5: ~6 Months Pain-Free -->
					<text x="880" y="388" class="annotation-text valley-text">~6 Months</text>
					<text x="880" y="401" class="annotation-text valley-text">Pain-Free</text>

					<!-- Peak 6: Experiment #6 with Hand-Drawn Arrow -->
					<text x="948" y="-30" class="annotation-num">Experiment #6</text>
					<text x="948" y="-12" class="annotation-title">Eliminate All Fruits,</text>
					<text x="948" y="6" class="annotation-title">Grains & Vegetables</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 948 14 C 946 26, 950 38, 948 52" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" />
						<path d="M 943 44 C 945 48, 947 51, 948 54 C 949 51, 951 48, 953 44" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- 1 Year Yo-Yo: Alternating between carnivore & plant-based diet -->
					<text x="1080" y="156" class="annotation-text yo-yo-text">1 Year Yo-Yo</text>
					<text x="1080" y="174" class="annotation-text yo-yo-subtext">Alternating between carnivore</text>
					<text x="1080" y="188" class="annotation-text yo-yo-subtext">&amp; plant-based diet</text>
					<g class="hand-drawn-arrow-group">
						<path d="M 1080 196 C 1078 206, 1082 216, 1080 226" fill="none" stroke="#f59e0b" stroke-width="2.0" stroke-linecap="round" />
						<path d="M 1075 218 C 1077 222, 1079 225, 1080 228 C 1081 225, 1083 222, 1085 218" fill="none" stroke="#f59e0b" stroke-width="2.0" stroke-linecap="round" stroke-linejoin="round" />
					</g>

					<!-- 6 Months Strict Carnivore Baseline Annotation (Cleanly spaced above 0/10 baseline) -->
					<text x="1290" y="372" class="annotation-text valley-text">~6 Months Strict</text>
					<text x="1290" y="388" class="annotation-text valley-text">Carnivore (0/10)</text>
				</g>

				<!-- Interactive Cursor Point (Only shows on mouse hover for presentations!) -->
				<g id="interactive-cursor" class="interactive-cursor-layer" style="display: none;">
					<circle id="cursor-point" cx="0" cy="0" r="8" class="cursor-pulse-point" />
				</g>

				<!-- X-Axis 4-Year Timeline Track & Milestone Labels (Zero overlap, generous spacing) -->
				<g class="x-axis-timeline-group">
					<!-- Horizontal 4-Year Timeline Line with Arrow Pointing Right -->
					<line x1="70" y1="468" x2="1415" y2="468" class="timeline-axis-line" marker-end="url(#arrowTimeline)" />

					<!-- Big Prominent 4-Year Timeline Heading (Title Case) -->
					<text x="740" y="508" class="timeline-main-title">4-Year Timeline</text>

					<!-- Milestone Ticks & Timestamps (Centered above vertical divider line) -->
					<line x1="160" y1="462" x2="160" y2="474" class="timeline-tick" />
					<text x="160" y="452" class="axis-time-label label-milestone">Approx. 4 Years Ago</text>

					<line x1="950" y1="462" x2="950" y2="474" class="timeline-tick" />
					<text x="950" y="452" class="axis-time-label label-milestone">18 Months Ago</text>

					<line x1="1180" y1="462" x2="1180" y2="474" class="timeline-tick" />
					<text x="1180" y="452" class="axis-time-label label-milestone">6 Months Ago</text>

					<line x1="1400" y1="462" x2="1400" y2="474" class="timeline-tick tick-today" />
					<text x="1400" y="452" class="axis-time-label label-milestone label-today">Today</text>
				</g>
			</svg>
		</div>
	</div>
</div>

<style>
	/* Breakout Container: Naturally wider than the text column on desktop for high-impact clarity */
	.interactive-progression-container {
		background: radial-gradient(120% 120% at 50% 0%, #1e1136 0%, #0d081a 60%, #080410 100%);
		border: 1px solid rgba(168, 85, 247, 0.35);
		border-radius: 1.5rem;
		padding: 1.6rem 2rem 1.75rem 2rem;
		margin: 3.5rem auto;
		color: #e2e8f0;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		position: relative;
		width: 100%;
		box-sizing: border-box;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 10;
	}

	/* Wide Breakout on Desktops: Expands across viewport with comfortable side margins, eliminating scrollbars */
	@media (min-width: 960px) {
		.interactive-progression-container {
			width: min(calc(100vw - 64px), 1380px);
			max-width: 1380px;
			position: relative;
			left: 50%;
			transform: translateX(-50%);
			margin-left: 0;
			margin-right: 0;
			padding: 1.85rem 2.25rem 2rem 2.25rem;
		}

		.chart-canvas-inner {
			min-width: 0 !important;
			width: 100%;
		}
	}

	@media (min-width: 1440px) {
		.interactive-progression-container {
			width: min(calc(100vw - 96px), 1420px);
			max-width: 1420px;
		}
	}

	/* Full-Width In-Place Breakout Mode with 50px Padding and Rounded Corners */
	.interactive-progression-container.is-expanded {
		position: relative !important;
		width: calc(100vw - 64px) !important;
		max-width: 1600px !important;
		left: 50% !important;
		transform: translateX(-50%) !important;
		margin-top: 3.5rem !important;
		margin-bottom: 3.5rem !important;
		margin-left: 0 !important;
		margin-right: 0 !important;
		border-radius: 1.5rem !important;
		border: 1px solid rgba(168, 85, 247, 0.5) !important;
		padding: 2.25rem !important;
		box-shadow: 0 30px 70px rgba(0, 0, 0, 0.85), 0 0 40px rgba(168, 85, 247, 0.2) !important;
		z-index: 25 !important;
	}

	@media (max-width: 768px) {
		.interactive-progression-container.is-expanded {
			width: calc(100vw - 24px) !important;
			padding: 24px 16px !important;
			border-radius: 1.15rem !important;
		}
	}

	.interactive-progression-container.is-expanded .widget-header {
		max-width: 1540px;
		margin-left: auto;
		margin-right: auto;
		width: 100%;
	}

	.interactive-progression-container.is-expanded .chart-wrapper {
		max-width: 1540px;
		margin-left: auto;
		margin-right: auto;
		width: 100%;
	}

	.interactive-progression-container.is-expanded .chart-canvas-inner {
		width: 100%;
		min-width: 0 !important;
	}

	/* Header */
	.widget-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.25rem;
		border-bottom: 1px solid rgba(168, 85, 247, 0.18);
		padding-bottom: 0.95rem;
		padding-right: 2.5rem; /* Room for expand button */
		gap: 1.25rem;
	}

	.widget-header-content {
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	.widget-title {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		margin: 0;
		line-height: 1.15;
		letter-spacing: -0.03em;
	}

	.widget-title-main {
