---
// AsicIonChannelDiagram.astro - Dual 3D medical visual explaining anatomical oral ASIC distribution map, molecular ion channel depolarization, and whole-body density ranking table
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

// Simplified Human Body ASIC Density Ranking (3 Core Metrics: Zone, Density, Reaction)
const asicDensityRankings = [
	{
		rank: "#1",
		zone: "Dental Pulp (Inside Teeth)",
		density: "Extreme (~1,000+ terminals/mm³)",
		percent: 100,
		reaction: "Excruciating 10/10 Trigeminal Fire",
		highlight: "red"
	},
	{
		rank: "#2",
		zone: "Cornea of the Eye",
		density: "Ultra-High (~300–600 terminals/mm²)",
		percent: 85,
		reaction: "Instant Reflexive Agony & Stinging",
		highlight: "red"
	},
	{
		rank: "#3",
		zone: "Tongue (Lingual Surface)",
		density: "Extreme (~200–500 terminals/mm²)",
		percent: 75,
		reaction: "Severe Burning & Chronic Aching",
		highlight: "red"
	},
	{
		rank: "#4",
		zone: "Hard Palate (Roof of Mouth)",
		density: "High (~100–250 terminals/mm²)",
		percent: 55,
		reaction: "Chronic Palatal Roof Burning",
		highlight: "yellow"
	},
	{
		rank: "#5",
		zone: "Heart Sensory Afferents",
		density: "Moderate-High (Ischemic Sensors)",
		percent: 40,
		reaction: "Angina & Chest Ischemic Pain",
		highlight: "yellow"
	},
	{
		rank: "#6",
		zone: "Esophagus (Reflux Zone)",
		density: "Moderate (Acid Reflux Sensors)",
		percent: 30,
		reaction: "Heartburn & Reflux Burning",
		highlight: "yellow"
	},
	{
		rank: "#7",
		zone: "Skeletal Muscle (Plank / Pose)",
		density: "Moderate-Low (~30–50 terminals/mm³)",
		percent: 18,
		reaction: "Temporary Muscle Fatigue Burn",
		highlight: "green"
	},
	{
		rank: "#8",
		zone: "Body Skin (Arms, Back, Legs)",
		density: "Lowest (~10–20 terminals/mm²)",
		percent: 5,
		reaction: "Zero Pain (Blocked by Keratin)",
		highlight: "green"
	}
];
---

<div class={`asic-diagram-wrapper ${className}`}>
	<div class="asic-diagram-card">
		<!-- Header -->
		<div class="asic-diagram-header">
			<span class="asic-kicker">Neurobiological Mapping</span>
			<h4 class="asic-diagram-title">Where ASICs Live: The Oral Acid&nbsp;Sensors</h4>
			<p class="asic-diagram-desc">
				Human sensory nerve endings in the tongue, dental pulp, and palate are densely populated with <strong>Acid-Sensing Ion Channels (ASICs)</strong>. The oral cavity possesses up to <strong>10x higher nociceptor density than regular skin</strong>, making the mouth uniquely hyper-reactive to acidic chemical&nbsp;contact.
			</p>
		</div>

		<!-- Macro Visual: Anatomical Distribution Map -->
		<div class="asic-showcase-block">
			<div class="asic-image-wrapper">
				<img 
					src="/oral-cavity-asic-receptor-density-map.jpg" 
					alt="3D medical anatomical visualization of the human oral cavity showing the dense distribution of Acid-Sensing Ion Channels on the tongue, dental pulp, and hard palate connecting to the Trigeminal ganglion" 
					class="asic-image"
					loading="lazy"
				/>
			</div>

			<div class="asic-map-details">
				<h5 class="asic-block-heading">Anatomical Hotspots of Oral Acid Sensitivity</h5>
				<div class="asic-hotspots-grid">
					<div class="asic-hotspot-item">
						<span class="hotspot-num">01</span>
						<div class="hotspot-info">
							<strong>Tip &amp; Lateral Tongue:</strong>
							<p>Innervated by the Lingual Nerve (CN V3). Houses the highest concentration of ASIC3 and ASIC1 channels in the human oral&nbsp;cavity.</p>
						</div>
					</div>
					<div class="asic-hotspot-item">
						<span class="hotspot-num">02</span>
						<div class="hotspot-info">
							<strong>Dental Pulp &amp; Roots:</strong>
							<p>Exposed tubules channel acids directly into intradental A-delta and C-fibers, which abundantly express proton-activated ASIC&nbsp;receptors.</p>
						</div>
					</div>
					<div class="asic-hotspot-item">
						<span class="hotspot-num">03</span>
						<div class="hotspot-info">
							<strong>Hard Palate (Roof of Mouth):</strong>
							<p>Supplied by the Greater Palatine and Nasopalatine nerves (CN V2), creating the upper roof burning sensation during acid&nbsp;exposure.</p>
						</div>
					</div>
					<div class="asic-hotspot-item">
						<span class="hotspot-num">04</span>
						<div class="hotspot-info">
							<strong>Gingival Margins:</strong>
							<p>Subgingival sulcular nerves detect localized pH drops caused by bacterial lactic acid fermentation along the gum&nbsp;line.</p>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Micro Visual: Molecular Channel Influx & Depolarization -->
		<div class="asic-showcase-block" style="margin-top: 2.5rem;">
			<div class="asic-image-wrapper">
				<img 
					src="/acid-sensing-ion-channels-asic-nerve.jpg" 
					alt="3D close-up medical visualization of Acid-Sensing Ion Channels (ASIC) on a Trigeminal nerve ending opening in response to acid protons (H+) and allowing sodium (Na+) influx" 
					class="asic-image"
					loading="lazy"
				/>
			</div>

			<!-- Explanatory Breakdown Box -->
			<div class="asic-breakdown-box">
				<div class="asic-stat-row">
					<div class="asic-stat-item">
						<span class="asic-label">Nociceptor Density</span>
						<strong class="asic-val">5x to 10x Higher Than Body Skin</strong>
					</div>
					<div class="asic-stat-item">
						<span class="asic-label">The Chemical Key</span>
						<strong class="asic-val">Hydrogen Protons (H⁺ / Acid)</strong>
					</div>
					<div class="asic-stat-item">
						<span class="asic-label">The Electrical Result</span>
						<strong class="asic-val">Sodium (Na⁺) Influx &rarr; 10/10 Burning</strong>
					</div>
				</div>

				<div class="asic-points-list">
					<div class="asic-point">
						<h6>1. Protons (H⁺) Bind to the Outer Gate:</h6>
						<p>
							When dietary acids or bacterial lactic acid wash over exposed tubules or sensitive mucosal nerve endings, free hydrogen ions (H⁺) bind directly to the extracellular loops of the ASIC protein.
						</p>
					</div>
					<div class="asic-point">
						<h6>2. The Channel Flips Open (Sodium Influx):</h6>
						<p>
							Binding forces a conformational shift that opens the central channel pore. Positively charged sodium ions (Na⁺) and calcium ions (Ca²⁺) rush into the nerve cell, depolarizing the neuronal membrane.
						</p>
					</div>
					<div class="asic-point">
						<h6>3. Why the Tissue Looks Normal to Dentists:</h6>
						<p>
							This rapid depolarization fires continuous electrical action potentials down the <strong>Trigeminal nerve (CN V3 and CN V2)</strong>. Because this is a molecular electrochemical reaction rather than a gross visual ulcer, oral tissues look completely pink and healthy on routine dental exams, even while the patient experiences severe 10/10&nbsp;fire.
						</p>
					</div>
				</div>
			</div>
		</div>

		<!-- Whole-Body ASIC Density Spectrum (Red / Yellow / Green Zones) -->
		<div class="asic-density-scale-section" style="margin-top: 2.75rem;">
			<div class="asic-density-scale-header">
				<span class="asic-kicker">Comparative Human Electrophysiology</span>
				<h4 class="asic-density-scale-title">Whole-Body ASIC Density Spectrum</h4>
				<p class="asic-density-scale-desc">
					Human body tissues ranked from highest acid-sensing receptor density down to the lowest. The dental pulp and tongue sit at the absolute peak of human acid sensitivity, explaining why a drop of acid that skin ignores triggers agonizing burning in the&nbsp;mouth.
				</p>
			</div>

			<div class="density-zones-stack">
				
				<!-- ================= RED ZONE: EXTREME DENSITY ================= -->
				<div class="zone-block">
					<div class="zone-header red-zone-header">
						<div class="zone-title-wrap">
							<span class="zone-name-badge red-badge-text">RED ZONE</span>
							<h5 class="zone-heading">EXTREME DENSITY: Instant Trigeminal Agony</h5>
						</div>
						<p class="zone-subtitle">
							Massive nociceptor concentration (200 to 1,000+ nerve terminals / mm³). Minimal or zero keratin barrier allows free acid protons (H⁺) to trigger unbuffered 10/10 electrical&nbsp;shock.
						</p>
					</div>

					<div class="density-items-stack">
						<!-- Cornea (Dense 2,000–7,000 / mm² surface terminal density) -->
						<div class="density-row red-density-row">
							<div class="density-card-header">
								<h6 class="density-title-wide">Cornea of the Eye</h6>
							</div>
							<div class="density-card-main">
								<div class="density-text-col">
									<div class="density-level-type red-level-type">Reaction: Instant Reflexive Agony &amp; Stinging</div>
									<p class="density-description">Highest sensory nerve terminal density in the entire human body (Trigeminal V1). Unprotected by keratin, reacting immediately to any acidic droplet.</p>
								</div>
								<div class="density-stat-box red-stat-box">
									<div class="density-stat-icon">👁️</div>
									<span class="stat-category-label red-label-text">Density</span>
									<div class="stat-main-value">2,000–7,000 / mm²</div>
								</div>
							</div>
						</div>

						<!-- Dental Pulp & Tubules (~1,000+ terminals/mm³ volume) -->
						<div class="density-row red-density-row">
							<div class="density-card-header">
								<h6 class="density-title-wide">Dental Pulp &amp; Exposed Tubules</h6>
							</div>
							<div class="density-card-main">
								<div class="density-text-col">
									<div class="density-level-type red-level-type">Reaction: Excruciating 10/10 Trigeminal Fire</div>
									<p class="density-description">Plexus of Raschkow houses millions of proton-gated ASIC3 channels. When enamel or gums recede, acid flows directly into open pulp tubules.</p>
								</div>
								<div class="density-stat-box red-stat-box">
									<div class="density-stat-icon">🦷</div>
									<span class="stat-category-label red-label-text">Density</span>
									<div class="stat-main-value">~1,000+ / mm³</div>
								</div>
							</div>
						</div>

						<!-- Tongue -->
						<div class="density-row red-density-row">
							<div class="density-card-header">
								<h6 class="density-title-wide">Tongue (Tip &amp; Lateral Edges)</h6>
							</div>
							<div class="density-card-main">
								<div class="density-text-col">
									<div class="density-level-type red-level-type">Reaction: Severe Burning &amp; Chronic Stinging</div>
									<p class="density-description">Lingual nerve (CN V3) endings sit right below thin non-keratinized mucosa, causing continuous burning upon acid contact.</p>
								</div>
								<div class="density-stat-box red-stat-box">
									<div class="density-stat-icon">👅</div>
									<span class="stat-category-label red-label-text">Density</span>
									<div class="stat-main-value">200–500 / mm²</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- ================= YELLOW ZONE: MODERATE DENSITY ================= -->
				<div class="zone-block">
					<div class="zone-header yellow-zone-header">
						<div class="zone-title-wrap">
							<span class="zone-name-badge yellow-badge-text">YELLOW ZONE</span>
							<h5 class="zone-heading">MODERATE DENSITY: Visceral &amp; Deep Tissue Warning</h5>
						</div>
						<p class="zone-subtitle">
							Moderate ASIC3 and ASIC1 expression (30 to 250 terminals / mm²). Detects internal ischemic lactic acid and acid reflux rather than external surface&nbsp;contact.
						</p>
					</div>

					<div class="density-items-stack">
						<div class="density-row yellow-density-row">
							<div class="density-card-header">
								<h6 class="density-title-wide">Hard Palate &amp; Gum Margins</h6>
							</div>
							<div class="density-card-main">
								<div class="density-text-col">
									<div class="density-level-type yellow-level-type">Reaction: Chronic Palatal Roof Burning</div>
									<p class="density-description">Supplied by Greater Palatine (CN V2) and sulcular nerves. Detects pooling microbial acid along the dental gingiva.</p>
								</div>
								<div class="density-stat-box yellow-stat-box">
									<div class="density-stat-icon">👄</div>
									<span class="stat-category-label yellow-label-text">Density</span>
									<div class="stat-main-value">100–250 / mm²</div>
								</div>
							</div>
						</div>

						<div class="density-row yellow-density-row">
							<div class="density-card-header">
								<h6 class="density-title-wide">Heart Sensory Afferents (Myocardium)</h6>
							</div>
							<div class="density-card-main">
								<div class="density-text-col">
									<div class="density-level-type yellow-level-type">Reaction: Angina &amp; Ischemic Chest Pain</div>
									<p class="density-description">Cardiac ASIC3 detects anaerobic lactic acid buildup during poor coronary flow, generating the deep chest pain of angina.</p>
								</div>
								<div class="density-stat-box yellow-stat-box">
									<div class="density-stat-icon">❤️</div>
									<span class="stat-category-label yellow-label-text">Density</span>
									<div class="stat-main-value">Moderate-High</div>
								</div>
							</div>
						</div>

						<div class="density-row yellow-density-row">
							<div class="density-card-header">
								<h6 class="density-title-wide">Esophageal Mucosa (Reflux Zone)</h6>
							</div>
							<div class="density-card-main">
								<div class="density-text-col">
									<div class="density-level-type yellow-level-type">Reaction: Heartburn &amp; Acid Reflux Burning</div>
									<p class="density-description">Mucosal ASIC1 and ASIC3 sense stomach acid breaches when mucosal bicarbonate barriers are overwhelmed.</p>
								</div>
								<div class="density-stat-box yellow-stat-box">
									<div class="density-stat-icon">🫁</div>
									<span class="stat-category-label yellow-label-text">Density</span>
									<div class="stat-main-value">Moderate</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- ================= GREEN ZONE: LOWEST DENSITY ================= -->
				<div class="zone-block">
					<div class="zone-header green-zone-header">
						<div class="zone-title-wrap">
							<span class="zone-name-badge green-badge-text">GREEN ZONE</span>
							<h5 class="zone-heading">LOWEST DENSITY: Protected &amp; Buffered Tissue</h5>
						</div>
						<p class="zone-subtitle">
							Low ASIC density or dense structural keratin shielding (10 to 50 terminals / mm³). Tolerates acid contact or clears lactic acid rapidly within&nbsp;seconds.
						</p>
					</div>

					<div class="density-items-stack">
						<div class="density-row green-density-row">
							<div class="density-card-header">
								<h6 class="density-title-wide">Skeletal Muscle (Plank / Superman Pose)</h6>
							</div>
							<div class="density-card-main">
								<div class="density-text-col">
									<div class="density-level-type green-level-type">Reaction: Temporary Muscle Fatigue Burn</div>
									<p class="density-description">Group III/IV muscle afferents sense anaerobic lactate buildup during sustained isometric holds, disappearing once blood flow restores.</p>
								</div>
								<div class="density-stat-box green-stat-box">
									<div class="density-stat-icon">🏋️</div>
									<span class="stat-category-label green-label-text">Density</span>
									<div class="stat-main-value">30–50 / mm³</div>
								</div>
							</div>
						</div>

						<div class="density-row green-density-row">
							<div class="density-card-header">
								<h6 class="density-title-wide">Body Skin (Epidermis: Arms, Back, Legs)</h6>
							</div>
							<div class="density-card-main">
								<div class="density-text-col">
									<div class="density-level-type green-level-type">Reaction: Zero Pain (Protected by Keratin)</div>
									<p class="density-description">Shielded by 15–20 layers of dead, dry keratin (*stratum corneum*) that completely block acid penetration to underlying nerve endings.</p>
								</div>
								<div class="density-stat-box green-stat-box">
									<div class="density-stat-icon">🧴</div>
									<span class="stat-category-label green-label-text">Density</span>
									<div class="stat-main-value">10–20 / mm²</div>
								</div>
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>

	</div>
</div>

<style>
	.asic-diagram-wrapper {
		margin: 3.5rem 0;
		width: 100%;
		box-sizing: border-box;
	}

	.asic-diagram-card {
		background: radial-gradient(120% 120% at 50% 0%, #1c1032 0%, #0d081a 60%, #080410 100%);
		border: 1px solid rgba(168, 85, 247, 0.35);
		border-radius: 1.5rem;
		padding: clamp(1.5rem, 3.5vw, 2.75rem);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		color: #e2e8f0;
	}

	.asic-diagram-header {
		text-align: center;
		margin-bottom: 2.25rem;
		max-width: 800px;
		margin-left: auto;
		margin-right: auto;
	}

	.asic-kicker {
		font-size: 0.82rem;
		font-weight: 700;
		color: #c084fc;
		letter-spacing: 0.04em;
		display: block;
		margin-bottom: 0.35rem;
	}

	.asic-diagram-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(1.45rem, 2.8vw, 2.05rem);
		font-weight: 900;
		color: #ffffff;
		margin: 0 0 0.85rem 0;
		line-height: 1.25;
		text-wrap: balance;
		letter-spacing: -0.02em;
	}

	.asic-diagram-desc {
		font-size: clamp(0.95rem, 1.6vw, 1.05rem);
		line-height: 1.65;
		color: #cbd5e1;
		margin: 0;
		text-wrap: pretty;
	}

	.asic-showcase-block {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		width: 100%;
		max-width: 800px;
		margin: 0 auto;
	}

	.asic-image-wrapper {
		width: 100%;
		background: rgba(10, 6, 20, 0.6);
		border-radius: 1.25rem;
		border: 1px solid rgba(168, 85, 247, 0.3);
		padding: 0.65rem;
		box-sizing: border-box;
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
		overflow: hidden;
	}

	.asic-image {
		width: 100%;
		height: auto;
		max-height: 480px;
		object-fit: contain;
		display: block;
		margin: 0 auto;
		border-radius: 0.85rem;
	}

	/* Map Details Grid */
	.asic-map-details {
		background: rgba(15, 23, 42, 0.75);
		border: 1px solid rgba(168, 85, 247, 0.28);
		border-radius: 1.15rem;
		padding: 1.35rem 1.6rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.asic-block-heading {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: 1.12rem;
		font-weight: 800;
		color: #ffffff;
		margin: 0;
		line-height: 1.3;
	}

	.asic-hotspots-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.asic-hotspot-item {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		background: rgba(10, 6, 20, 0.5);
		border: 1px solid rgba(168, 85, 247, 0.2);
		border-radius: 0.75rem;
		padding: 0.85rem 1rem;
	}

	.hotspot-num {
		font-size: 0.85rem;
		font-weight: 900;
		color: #c084fc;
		background: rgba(168, 85, 247, 0.15);
		border: 1px solid rgba(168, 85, 247, 0.35);
		padding: 0.2rem 0.5rem;
		border-radius: 0.35rem;
		flex-shrink: 0;
	}

	.hotspot-info strong {
		display: block;
		font-size: 0.94rem;
		color: #fde047;
		margin-bottom: 0.25rem;
		line-height: 1.25;
	}

	.hotspot-info p {
		font-size: 0.85rem;
		line-height: 1.5;
		color: #cbd5e1;
		margin: 0;
		text-wrap: pretty;
	}

	/* Molecular Breakdown Box */
	.asic-breakdown-box {
		background: rgba(15, 23, 42, 0.75);
		border: 1px solid rgba(168, 85, 247, 0.28);
		border-radius: 1.15rem;
		padding: 1.35rem 1.6rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.asic-stat-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 0.85rem;
		border-bottom: 1px solid rgba(168, 85, 247, 0.2);
		padding-bottom: 1rem;
	}

	.asic-stat-item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.asic-label {
		font-size: 0.76rem;
		font-weight: 700;
		color: #c084fc;
		letter-spacing: 0.03em;
	}

	.asic-val {
		font-size: 0.95rem;
		color: #ffffff;
		line-height: 1.35;
	}

	.asic-points-list {
		display: flex;
		flex-direction: column;
		gap: 0.95rem;
	}

	.asic-point h6 {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: 0.98rem;
		font-weight: 800;
		color: #fde047;
		margin: 0 0 0.25rem 0;
		line-height: 1.3;
	}

	.asic-point p {
		font-size: 0.92rem;
		line-height: 1.6;
		color: #cbd5e1;
		margin: 0;
		text-wrap: pretty;
	}

	.asic-point p strong {
		color: #ffffff;
	}

	/* Whole-Body ASIC Density Spectrum (Matching AcidFoodScale Template) */
	.asic-density-scale-section {
		max-width: 800px;
		margin: 0 auto;
		background: rgba(13, 8, 26, 0.7);
		border: 1px solid rgba(168, 85, 247, 0.3);
		border-radius: 1.25rem;
		padding: clamp(1.25rem, 2.5vw, 1.75rem);
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
	}

	.asic-density-scale-header {
		margin-bottom: 2rem;
		text-align: left;
	}

	.asic-density-scale-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(1.25rem, 2.4vw, 1.6rem);
