---
// AsicIonChannelDiagram.astro - Dual 3D medical visual explaining anatomical oral ASIC distribution map, molecular ion channel depolarization, and whole-body density ranking table
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

// Simplified Human Body ASIC Density Ranking (3 Core Metrics: Zone, Density, Reaction)
const asicDensityRankings = [
	{
		rank: "#1",
		zone: "Dental Pulp (Inside Teeth)",
		density: "Extreme (~1,000+ terminals/mm³)",
		percent: 100,
		reaction: "Excruciating 10/10 Trigeminal Fire",
		highlight: "red"
	},
	{
		rank: "#2",
		zone: "Cornea of the Eye",
		density: "Ultra-High (~300–600 terminals/mm²)",
		percent: 85,
		reaction: "Instant Reflexive Agony & Stinging",
		highlight: "red"
	},
	{
		rank: "#3",
		zone: "Tongue (Lingual Surface)",
		density: "Extreme (~200–500 terminals/mm²)",
		percent: 75,
		reaction: "Severe Burning & Chronic Aching",
		highlight: "red"
	},
	{
		rank: "#4",
		zone: "Hard Palate (Roof of Mouth)",
		density: "High (~100–250 terminals/mm²)",
		percent: 55,
		reaction: "Chronic Palatal Roof Burning",
		highlight: "yellow"
	},
	{
		rank: "#5",
		zone: "Heart Sensory Afferents",
		density: "Moderate-High (Ischemic Sensors)",
		percent: 40,
		reaction: "Angina & Chest Ischemic Pain",
		highlight: "yellow"
	},
	{
		rank: "#6",
		zone: "Esophagus (Reflux Zone)",
		density: "Moderate (Acid Reflux Sensors)",
		percent: 30,
		reaction: "Heartburn & Reflux Burning",
		highlight: "yellow"
	},
	{
		rank: "#7",
		zone: "Skeletal Muscle (Plank / Pose)",
		density: "Moderate-Low (~30–50 terminals/mm³)",
		percent: 18,
		reaction: "Temporary Muscle Fatigue Burn",
		highlight: "green"
	},
	{
		rank: "#8",
		zone: "Body Skin (Arms, Back, Legs)",
		density: "Lowest (~10–20 terminals/mm²)",
		percent: 5,
		reaction: "Zero Pain (Blocked by Keratin)",
		highlight: "green"
	}
];
---

<div class={`asic-diagram-wrapper ${className}`}>
	<div class="asic-diagram-card">
		<!-- Header -->
		<div class="asic-diagram-header">
			<span class="asic-kicker">Neurobiological Mapping</span>
			<h4 class="asic-diagram-title">Where ASICs Live: The Oral Acid&nbsp;Sensors</h4>
			<p class="asic-diagram-desc">
				Human sensory nerve endings in the tongue, dental pulp, and palate are densely populated with <strong>Acid-Sensing Ion Channels (ASICs)</strong>. The oral cavity possesses up to <strong>10x higher nociceptor density than regular skin</strong>, making the mouth uniquely hyper-reactive to acidic chemical&nbsp;contact.
			</p>
		</div>

		<!-- Macro Visual: Anatomical Distribution Map -->
		<div class="asic-showcase-block">
			<div class="asic-image-wrapper">
				<img 
					src="/oral-cavity-asic-receptor-density-map.jpg" 
					alt="3D medical anatomical visualization of the human oral cavity showing the dense distribution of Acid-Sensing Ion Channels on the tongue, dental pulp, and hard palate connecting to the Trigeminal ganglion" 
					class="asic-image"
					loading="lazy"
				/>
			</div>

			<div class="asic-map-details">
				<h5 class="asic-block-heading">Anatomical Hotspots of Oral Acid Sensitivity</h5>
				<div class="asic-hotspots-grid">
					<div class="asic-hotspot-item">
						<span class="hotspot-num">01</span>
						<div class="hotspot-info">
							<div class="hotspot-header-row">
								<strong>Tip &amp; Lateral Tongue:</strong>
								<span class="hotspot-qty-badge">Quantity: ~200–500 receptors/mm²</span>
							</div>
							<p>Innervated by the Lingual Nerve (CN V3). Houses the highest concentration of ASIC3 and ASIC1 channels in the human oral&nbsp;cavity.</p>
						</div>
					</div>
					<div class="asic-hotspot-item">
						<span class="hotspot-num">02</span>
						<div class="hotspot-info">
							<div class="hotspot-header-row">
								<strong>Dental Pulp &amp; Roots:</strong>
								<span class="hotspot-qty-badge">Quantity: ~1,000+ receptors/mm³</span>
							</div>
							<p>Exposed tubules channel acids directly into intradental A-delta and C-fibers, which abundantly express proton-activated ASIC&nbsp;receptors.</p>
						</div>
					</div>
					<div class="asic-hotspot-item">
						<span class="hotspot-num">03</span>
						<div class="hotspot-info">
							<div class="hotspot-header-row">
								<strong>Hard Palate (Roof of Mouth):</strong>
								<span class="hotspot-qty-badge">Quantity: ~100–250 receptors/mm²</span>
							</div>
							<p>Supplied by the Greater Palatine and Nasopalatine nerves (CN V2), creating the upper roof burning sensation during acid&nbsp;exposure.</p>
						</div>
					</div>
					<div class="asic-hotspot-item">
						<span class="hotspot-num">04</span>
						<div class="hotspot-info">
							<div class="hotspot-header-row">
								<strong>Gingival Margins:</strong>
								<span class="hotspot-qty-badge">Quantity: ~80–180 receptors/mm²</span>
							</div>
							<p>Subgingival sulcular nerves detect localized pH drops caused by bacterial lactic acid fermentation along the gum&nbsp;line.</p>
						</div>
					</div>
				</div>
			</div>
		</div>

	</div>
</div>

<style>
	.asic-diagram-wrapper {
		margin: 3.5rem 0;
		width: 100%;
		box-sizing: border-box;
	}

	.asic-diagram-card {
		background: radial-gradient(120% 120% at 50% 0%, #1c1032 0%, #0d081a 60%, #080410 100%);
		border: 1px solid rgba(168, 85, 247, 0.35);
		border-radius: 1.5rem;
		padding: clamp(1.5rem, 3.5vw, 2.75rem);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		color: #e2e8f0;
	}

	.asic-diagram-header {
		text-align: center;
		margin-bottom: 2.25rem;
		max-width: 800px;
		margin-left: auto;
		margin-right: auto;
	}

	.asic-kicker {
		font-size: 0.82rem;
		font-weight: 700;
		color: #c084fc;
		letter-spacing: 0.04em;
		display: block;
		margin-bottom: 0.35rem;
	}

	.asic-diagram-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(1.45rem, 2.8vw, 2.05rem);
		font-weight: 900;
		color: #ffffff;
		margin: 0 0 0.85rem 0;
		line-height: 1.25;
		text-wrap: balance;
		letter-spacing: -0.02em;
	}

	.asic-diagram-desc {
		font-size: clamp(0.95rem, 1.6vw, 1.05rem);
		line-height: 1.65;
		color: #cbd5e1;
		margin: 0;
		text-wrap: pretty;
	}

	.asic-showcase-block {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		width: 100%;
		max-width: 800px;
		margin: 0 auto;
	}

	.asic-image-wrapper {
		width: 100%;
		background: rgba(10, 6, 20, 0.6);
		border-radius: 1.25rem;
		border: 1px solid rgba(168, 85, 247, 0.3);
		padding: 0.65rem;
		box-sizing: border-box;
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
		overflow: hidden;
	}

	.asic-image {
		width: 100%;
		height: auto;
		max-height: 480px;
		object-fit: contain;
		display: block;
		margin: 0 auto;
		border-radius: 0.85rem;
	}

	/* Map Details Grid */
	.asic-map-details {
		background: rgba(15, 23, 42, 0.75);
		border: 1px solid rgba(168, 85, 247, 0.28);
		border-radius: 1.15rem;
		padding: 1.35rem 1.6rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.asic-block-heading {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: 1.12rem;
		font-weight: 800;
		color: #ffffff;
		margin: 0;
		line-height: 1.3;
	}

	.asic-hotspots-grid {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.asic-hotspot-item {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
		background: rgba(10, 6, 20, 0.5);
		border: 1px solid rgba(168, 85, 247, 0.2);
		border-radius: 0.75rem;
		padding: 0.85rem 1.1rem;
	}

	.hotspot-num {
		font-size: 0.85rem;
		font-weight: 900;
		color: #c084fc;
		background: rgba(168, 85, 247, 0.15);
		border: 1px solid rgba(168, 85, 247, 0.35);
		padding: 0.2rem 0.5rem;
		border-radius: 0.35rem;
		flex-shrink: 0;
	}

	.hotspot-info {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		width: 100%;
	}

	.hotspot-header-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		width: 100%;
	}

	.hotspot-info strong {
		font-size: 0.96rem;
		color: #fde047;
		margin: 0;
		line-height: 1.25;
	}

	.hotspot-qty-badge {
		font-size: 0.76rem;
		font-weight: 800;
		color: #38bdf8;
		background: rgba(56, 189, 248, 0.12);
		border: 1px solid rgba(56, 189, 248, 0.3);
		padding: 0.15rem 0.55rem;
		border-radius: 9999px;
	}

	.hotspot-info p {
		font-size: 0.85rem;
		line-height: 1.5;
		color: #cbd5e1;
		margin: 0;
		text-wrap: pretty;
	}

	/* Molecular Breakdown Box */
	.asic-breakdown-box {
		background: rgba(15, 23, 42, 0.75);
		border: 1px solid rgba(168, 85, 247, 0.28);
		border-radius: 1.15rem;
		padding: 1.35rem 1.6rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.asic-stat-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 0.85rem;
		border-bottom: 1px solid rgba(168, 85, 247, 0.2);
		padding-bottom: 1rem;
	}

	.asic-stat-item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.asic-label {
		font-size: 0.76rem;
		font-weight: 700;
		color: #c084fc;
		letter-spacing: 0.03em;
	}

	.asic-val {
		font-size: 0.95rem;
		color: #ffffff;
		line-height: 1.35;
	}

	.asic-points-list {
		display: flex;
		flex-direction: column;
		gap: 0.95rem;
	}

	.asic-point h6 {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: 0.98rem;
		font-weight: 800;
		color: #fde047;
		margin: 0 0 0.25rem 0;
		line-height: 1.3;
	}

	.asic-point p {
		font-size: 0.92rem;
		line-height: 1.6;
		color: #cbd5e1;
		margin: 0;
		text-wrap: pretty;
	}

	.asic-point p strong {
		color: #ffffff;
	}

	/* Whole-Body ASIC Density Spectrum (Matching AcidFoodScale Template) */
	.asic-density-scale-section {
		max-width: 800px;
		margin: 0 auto;
		background: rgba(13, 8, 26, 0.7);
		border: 1px solid rgba(168, 85, 247, 0.3);
		border-radius: 1.25rem;
		padding: clamp(1.25rem, 2.5vw, 1.75rem);
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
	}

	.asic-density-scale-header {
		margin-bottom: 2rem;
		text-align: left;
	}

	.asic-density-scale-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(1.25rem, 2.4vw, 1.6rem);
		font-weight: 800;
		color: #ffffff;
		margin: 0 0 0.5rem 0;
		line-height: 1.3;
		text-wrap: balance;
	}

	.asic-density-scale-desc {
		font-size: 0.92rem;
		line-height: 1.6;
		color: #cbd5e1;
		margin: 0;
		text-wrap: pretty;
	}

	.density-zones-stack {
		display: flex;
		flex-direction: column;
		gap: 2.25rem;
	}

	.zone-block {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	/* Zone Headers */
	.zone-header {
		padding: 1rem 1.25rem;
		border-radius: 0.9rem;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.red-zone-header {
		background: rgba(239, 68, 68, 0.12);
		border: 1px solid rgba(239, 68, 68, 0.35);
	}

	.yellow-zone-header {
		background: rgba(245, 158, 11, 0.12);
		border: 1px solid rgba(245, 158, 11, 0.35);
	}

	.green-zone-header {
		background: rgba(16, 185, 129, 0.12);
		border: 1px solid rgba(16, 185, 129, 0.35);
	}

	.zone-title-wrap {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
	}

	.zone-name-badge {
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.05em;
	}

	.red-badge-text { color: #f87171; }
	.yellow-badge-text { color: #fbbf24; }
	.green-badge-text { color: #34d399; }

	.zone-heading {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		font-weight: 900;
		color: #ffffff;
		margin: 0;
		line-height: 1.25;
	}

	.zone-subtitle {
		font-size: 0.86rem;
		line-height: 1.5;
		color: #cbd5e1;
		margin: 0;
		text-wrap: pretty;
	}

	.density-items-stack {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	/* Density Row (Full top title, emoji left, details middle, density right) */
	.density-row {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		background: rgba(15, 23, 42, 0.65);
		border: 1px solid rgba(255, 255, 255, 0.09);
		border-radius: 1.1rem;
		padding: 1.15rem 1.4rem;
		transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
	}

	.density-row:hover {
		transform: translateX(4px);
		background: rgba(15, 23, 42, 0.85);
	}

	.red-density-row:hover { border-color: rgba(239, 68, 68, 0.45); }
	.yellow-density-row:hover { border-color: rgba(245, 158, 11, 0.45); }
	.green-density-row:hover { border-color: rgba(16, 185, 129, 0.45); }

	.density-card-header {
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding-bottom: 0.5rem;
	}

	.density-title-wide {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: 1.12rem;
		font-weight: 900;
		color: #ffffff;
		margin: 0;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.density-card-main {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 1.25rem;
	}

	/* Text Column */
	.density-text-col {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.density-level-type {
		font-size: 0.88rem;
		font-weight: 700;
		line-height: 1.35;
	}

	.red-level-type { color: #fca5a5; }
	.yellow-level-type { color: #fde047; }
	.green-level-type { color: #6ee7b7; }

	.density-description {
		font-size: 0.84rem;
		line-height: 1.5;
		color: #94a3b8;
		margin: 0;
		text-wrap: pretty;
	}

	/* Right-Side Stat Box (Density + Icon inside) */
	.density-stat-box {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 0.65rem 1rem;
		border-radius: 0.85rem;
		min-width: 125px;
		flex-shrink: 0;
		text-align: center;
		gap: 0.2rem;
	}

	.density-stat-icon {
		font-size: 1.85rem;
		line-height: 1;
		margin-bottom: 0.15rem;
		filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.4));
	}

	.red-stat-box {
		background: rgba(239, 68, 68, 0.18);
		border: 1px solid rgba(239, 68, 68, 0.4);
	}

	.yellow-stat-box {
		background: rgba(245, 158, 11, 0.18);
		border: 1px solid rgba(245, 158, 11, 0.4);
	}

	.green-stat-box {
		background: rgba(16, 185, 129, 0.18);
		border: 1px solid rgba(16, 185, 129, 0.4);
	}

	.stat-category-label {
		font-size: 0.7rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.stat-main-value {
		font-size: 0.92rem;
		font-weight: 900;
		color: #ffffff;
		line-height: 1.2;
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.density-card-main {
			grid-template-columns: 1fr;
			gap: 0.85rem;
		}

		.density-stat-box {
			flex-direction: row;
			justify-content: space-between;
			padding: 0.55rem 0.85rem;
			min-width: unset;
			width: 100%;
			box-sizing: border-box;
		}

		.density-stat-icon {
			font-size: 1.4rem;
			margin-bottom: 0;
		}

		.stat-category-label {
			margin-bottom: 0;
		}

		.asic-hotspots-grid {
			grid-template-columns: 1fr;
		}

		.asic-stat-row {
			grid-template-columns: 1fr;
		}
	}
</style>
