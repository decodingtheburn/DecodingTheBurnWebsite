---
// TableOfContents.astro - Floating Side Drawer with Media Jump Links and [T] Keyboard Shortcut
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

// Curated sections with direct media / illustration anchor targets
const navSections = [
	{ 
		number: "1", 
		title: "Introduction", 
		href: "#introduction",
		media: [
			{ type: "chart", label: "18M Carnivore Timeline", target: "#carnivore-timeline-intro-box", icon: "chart", title: "Jump to 18-Month Carnivore Timeline" },
			{ type: "box", label: "5 Discoveries", target: "#key-discoveries-box", icon: "box", title: "Jump to 5 Key Discoveries" }
		]
	},
	{ 
		number: "2", 
		title: "Disclaimers", 
		href: "#disclaimers",
		media: []
	},
	{ 
		number: "3", 
		title: "7 Experiments That Lowered My Pain", 
		href: "#7-experiments-that-lowered-my-pain-over-the-last-four-years",
		media: [
			{ type: "chart", label: "Timeline Chart", target: "#progression-chart-box", icon: "chart", title: "Jump to Progression Chart" },
			{ type: "image", label: "3D Crown Render", target: "#crown-decay-photo-box", icon: "image", title: "Jump to 3D Crown Cavities Render" }
		]
	},
	{ 
		number: "4", 
		title: "What Didn't Work for Me", 
		href: "#what-didnt-work-for-me-testing-50-supplements--water-filtration",
		media: [
			{ type: "image", label: "50+ Supplements Photo", target: "#supplements-photo-box", icon: "image", title: "Jump to Supplements Inventory Photo" },
			{ type: "table", label: "Supplements Table", target: "#supplements-accordion-box", icon: "table", title: "Jump to Supplements Accordion" }
		]
	},
	{ 
		number: "5", 
		title: "What I Eat Now", 
		href: "#what-i-eat-now",
		media: [
			{ type: "box", label: "Diet Foods Cards", target: "#diet-cards-box", icon: "box", title: "Jump to Zero-Acid Diet Cards" }
		]
	},
	{ 
		number: "6", 
		title: "My Theory on Why Carnivore Works", 
		href: "#my-theory-on-why-the-carnivore-diet-works",
		media: [
			{ type: "table", label: "Vegetable Sugar Scale", target: "#veg-sugar-scale-box", icon: "chart", title: "Jump to Vegetable Sugar Scale" },
			{ type: "box", label: "Fermentation Diagram", target: "#oral-fermentation-diagram-box", icon: "box", title: "Jump to Acid Fermentation Diagram" },
			{ type: "box", label: "Tubule Recession Diagram", target: "#tubule-recession-diagram-box", icon: "box", title: "Jump to Tubule Recession Diagram" },
			{ type: "box", label: "ASIC Channel Diagram", target: "#asic-ion-diagram-box", icon: "box", title: "Jump to ASIC Ion Channel Diagram" },
			{ type: "box", label: "Trigeminal Diagram", target: "#trigeminal-radiating-diagram-box", icon: "box", title: "Jump to Trigeminal Radiating Pain Diagram" }
		]
	},
	{ 
		number: "7", 
		title: "The Acidity of 30 Common Foods & Drinks", 
		href: "#the-acidity-of-30-common-foods--drinks",
		media: [
			{ type: "table", label: "30 Foods Acidity Table", target: "#acid-food-scale-box", icon: "table", title: "Jump to 30 Foods Acidity Table" }
		]
	},
	{ 
		number: "8", 
		title: "Who I Learned the Carnivore Diet From", 
		href: "#who-i-learned-the-carnivore-diet-from",
		media: [
			{ type: "video", label: "Doctors Video Guides", target: "#carnivore-doctors-box", icon: "video", title: "Jump to Carnivore Doctors Video Guides" }
		]
	},
	{ 
		number: "9", 
		title: "My Next Dentist Visits", 
		href: "#my-next-dentist-visits",
		media: [
			{ type: "image", label: "Dental Hardware Photo", target: "#dentist-visits-photo-box", icon: "image", title: "Jump to Dental Hardware Photo" }
		]
	},
	{ 
		number: "10", 
		title: "Summary of What I've Done", 
		href: "#summary-of-what-ive-done",
		media: [
			{ type: "box", label: "Summary Recap", target: "#summary-of-what-ive-done", icon: "box", title: "Jump to Summary Recap" }
		]
	}
];
---

<!-- 1. Floating Trigger Button (Vertically centered in viewport on the right edge) -->
<button 
	type="button" 
	id="floating-toc-trigger" 
	class="floating-toc-btn" 
	title="Table of Contents [T]" 
	aria-label="Table of Contents [T]"
	aria-controls="floating-toc-drawer"
	aria-expanded="false"
>
	<span class="floating-toc-btn-inner">
		<!-- Minimalist Table of Contents / Index SVG Icon -->
		<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
			<line x1="8" y1="6" x2="21" y2="6"></line>
			<line x1="8" y1="12" x2="21" y2="12"></line>
			<line x1="8" y1="18" x2="21" y2="18"></line>
			<circle cx="3.5" cy="6" r="1.5" fill="currentColor"></circle>
			<circle cx="3.5" cy="12" r="1.5" fill="currentColor"></circle>
			<circle cx="3.5" cy="18" r="1.5" fill="currentColor"></circle>
		</svg>
	</span>
	<span class="floating-toc-shortcut-badge">T</span>
</button>

<!-- 2. Sliding Drawer / Slide-Out Table of Contents Panel -->
<div 
	id="floating-toc-drawer" 
	class="floating-toc-drawer" 
	role="dialog" 
	aria-modal="false" 
	aria-label="Table of Contents"
	style="display: none;"
>
	<div class="floating-drawer-backdrop" id="floating-toc-backdrop"></div>
	
	<div class="floating-drawer-panel">
		<!-- Drawer Header -->
		<div class="floating-drawer-header">
			<div class="floating-drawer-title-wrap">
				<h3 class="floating-drawer-title">Table of Contents</h3>
				<span class="floating-drawer-shortcut-hint" title="Press T on keyboard to toggle">[T]</span>
			</div>
			<button 
				type="button" 
				id="floating-drawer-close" 
				class="floating-drawer-close-btn" 
				title="Close Table of Contents [T or Esc]" 
				aria-label="Close"
			>
				<svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.2" fill="none">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>

		<!-- Drawer Navigation List -->
		<div class="floating-drawer-body">
			<ol class="floating-drawer-list">
				{navSections.map((section) => (
					<li class="floating-drawer-item">
						<div class="floating-item-main-row">
							<a href={section.href} class="floating-section-link" data-target={section.href.replace('#', '')}>
								<span class="floating-section-num">{section.number}.</span>
								<span class="floating-section-title">{section.title}</span>
							</a>

							<!-- Quick Media / Box / Table Jumper Badges -->
							{section.media && section.media.length > 0 && (
								<div class="floating-media-badges">
									{section.media.map((m) => (
										<a 
											href={m.target} 
											class={`floating-media-pill media-pill-${m.type}`} 
											title={m.title}
											aria-label={m.title}
											data-target-element={m.target.replace('#', '')}
										>
											{m.icon === 'image' && (
												<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
													<circle cx="8.5" cy="8.5" r="1.5"></circle>
													<polyline points="21 15 16 10 5 21"></polyline>
												</svg>
											)}
											{m.icon === 'table' && (
												<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<rect x="3" y="3" width="18" height="18" rx="2"></rect>
													<line x1="3" y1="9" x2="21" y2="9"></line>
													<line x1="3" y1="15" x2="21" y2="15"></line>
													<line x1="12" y1="3" x2="12" y2="21"></line>
												</svg>
											)}
											{m.icon === 'chart' && (
												<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<line x1="18" y1="20" x2="18" y2="10"></line>
													<line x1="12" y1="20" x2="12" y2="4"></line>
													<line x1="6" y1="20" x2="6" y2="14"></line>
												</svg>
											)}
											{m.icon === 'box' && (
												<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
													<polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
													<line x1="12" y1="22.08" x2="12" y2="12"></line>
												</svg>
											)}
											{m.icon === 'video' && (
												<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<polygon points="5 3 19 12 5 21 5 3"></polygon>
												</svg>
											)}
										</a>
									))}
								</div>
							)}
						</div>
					</li>
				))}
			</ol>
		</div>

		<!-- Footer Note -->
		<div class="floating-drawer-footer">
			<span class="floating-footer-text">Click icons to jump directly to photos, charts &amp; tables</span>
		</div>
	</div>
</div>

<script is:inline>
	(function() {
		function setupFloatingTOC() {
			const triggerBtn = document.getElementById('floating-toc-trigger');
			const drawer = document.getElementById('floating-toc-drawer');
			const closeBtn = document.getElementById('floating-drawer-close');
			const backdrop = document.getElementById('floating-toc-backdrop');

			if (!triggerBtn || !drawer) return;

			// Teleport drawer and trigger to document.body so fixed layout is never broken
			if (triggerBtn.parentElement !== document.body) {
				document.body.appendChild(triggerBtn);
			}
			if (drawer.parentElement !== document.body) {
				document.body.appendChild(drawer);
			}

			let isOpen = false;

			function openDrawer() {
				isOpen = true;
				drawer.style.display = 'block';
				// Force reflow
				void drawer.offsetWidth;
				drawer.classList.add('is-open');
				triggerBtn.classList.add('is-active');
				triggerBtn.setAttribute('aria-expanded', 'true');
			}

			function closeDrawer() {
				isOpen = false;
				drawer.classList.remove('is-open');
				triggerBtn.classList.remove('is-active');
				triggerBtn.setAttribute('aria-expanded', 'false');
				setTimeout(function() {
					if (!isOpen) drawer.style.display = 'none';
				}, 220);
			}

			function toggleDrawer() {
				if (isOpen) {
					closeDrawer();
				} else {
					openDrawer();
				}
			}

			triggerBtn.onclick = function(e) {
				e.preventDefault();
				e.stopPropagation();
				toggleDrawer();
			};

			if (closeBtn) {
				closeBtn.onclick = function(e) {
					e.preventDefault();
					e.stopPropagation();
					closeDrawer();
				};
			}

			if (backdrop) {
				backdrop.onclick = function(e) {
					e.preventDefault();
					closeDrawer();
				};
			}

			// Close drawer when clicking section links
			const sectionLinks = drawer.querySelectorAll('.floating-section-link');
			sectionLinks.forEach(function(link) {
				link.onclick = function(e) {
					closeDrawer();
				};
			});

			// Media pill click handler: smooth scroll & brief highlight pulse
			const mediaPills = drawer.querySelectorAll('.floating-media-pill');
			mediaPills.forEach(function(pill) {
				pill.onclick = function(e) {
					const targetId = pill.getAttribute('data-target-element');
					if (!targetId) return;
					const targetEl = document.getElementById(targetId);
					if (targetEl) {
						e.preventDefault();
						closeDrawer();
						targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
						targetEl.classList.remove('toc-target-highlight');
						void targetEl.offsetWidth;
						targetEl.classList.add('toc-target-highlight');
						setTimeout(function() {
							targetEl.classList.remove('toc-target-highlight');
						}, 2500);
					}
				};
			});

			// Keyboard shortcut: Press T / t to toggle; Esc to close
			window.addEventListener('keydown', function(e) {
				const activeEl = document.activeElement;
				if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.isContentEditable)) {
					return;
				}
				if (e.key === 't' || e.key === 'T') {
					e.preventDefault();
					toggleDrawer();
				} else if (e.key === 'Escape' && isOpen) {
					e.preventDefault();
					closeDrawer();
				}
			});

			// Highlight active section on scroll
			const sectionIds = Array.from(sectionLinks).map(function(l) { return l.getAttribute('data-target'); });

			function onScroll() {
				if (!isOpen) return;
				const scrollPos = window.scrollY + 180;
				let currentId = '';

				for (let i = 0; i < sectionIds.length; i++) {
					const el = document.getElementById(sectionIds[i]);
					if (el && el.offsetTop <= scrollPos) {
						currentId = sectionIds[i];
					}
				}

				sectionLinks.forEach(function(link) {
					if (link.getAttribute('data-target') === currentId) {
						link.classList.add('active');
					} else {
						link.classList.remove('active');
					}
				});
			}

			window.addEventListener('scroll', onScroll, { passive: true });
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', setupFloatingTOC);
		} else {
			setupFloatingTOC();
		}
		document.addEventListener('astro:page-load', setupFloatingTOC);
	})();
</script>

<style>
	/* 1. Floating Trigger Button (Vertically Centered on Right Screen Edge) */
	:global(#floating-toc-trigger) {
		position: fixed !important;
		top: 50% !important;
		right: 0 !important;
		transform: translateY(-50%) !important;
		z-index: 99998 !important;
		display: flex !important;
		flex-direction: column !important;
		align-items: center !important;
		justify-content: center !important;
		gap: 3px !important;
		padding: 0.65rem 0.5rem 0.6rem 0.65rem !important;
		background: #ffffff !important;
		color: #1e293b !important;
		border: 1px solid #cbd5e1 !important;
		border-right: none !important;
		border-top-left-radius: 12px !important;
		border-bottom-left-radius: 12px !important;
		box-shadow: -3px 4px 18px rgba(15, 23, 42, 0.12), -1px 2px 6px rgba(15, 23, 42, 0.06) !important;
		cursor: pointer !important;
		transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
		user-select: none !important;
	}

	:global(#floating-toc-trigger:hover) {
		background: #f8fafc !important;
		color: #c8382c !important;
		border-color: #94a3b8 !important;
		transform: translateY(-50%) translateX(-2px) !important;
		box-shadow: -4px 6px 22px rgba(200, 56, 44, 0.18) !important;
	}

	:global(#floating-toc-trigger.is-active) {
		background: #0f172a !important;
		color: #ffffff !important;
		border-color: #0f172a !important;
		transform: translateY(-50%) translateX(-4px) !important;
	}

	:global(.floating-toc-btn-inner) {
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
	}

	:global(.floating-toc-shortcut-badge) {
		font-size: 0.65rem !important;
		font-weight: 800 !important;
		line-height: 1 !important;
		color: #64748b !important;
		background: #f1f5f9 !important;
		border: 1px solid #e2e8f0 !important;
		padding: 1px 4px !important;
		border-radius: 4px !important;
		margin-top: 2px !important;
		transition: all 0.15s ease !important;
	}

	:global(#floating-toc-trigger:hover .floating-toc-shortcut-badge) {
		color: #c8382c !important;
		border-color: #fca5a5 !important;
		background: #fef2f2 !important;
	}

	:global(#floating-toc-trigger.is-active .floating-toc-shortcut-badge) {
		color: #ffffff !important;
		background: #334155 !important;
		border-color: #475569 !important;
	}

	/* 2. Slide-out Drawer Structure */
	:global(#floating-toc-drawer) {
		position: fixed !important;
		inset: 0 !important;
		z-index: 99999 !important;
		pointer-events: none !important;
	}

	:global(#floating-toc-drawer.is-open) {
		pointer-events: auto !important;
	}

	:global(.floating-drawer-backdrop) {
		position: absolute !important;
		inset: 0 !important;
		background: rgba(15, 23, 42, 0.35) !important;
		backdrop-filter: blur(2px) !important;
		opacity: 0 !important;
		transition: opacity 0.22s ease !important;
	}

	:global(#floating-toc-drawer.is-open .floating-drawer-backdrop) {
		opacity: 1 !important;
	}

	:global(.floating-drawer-panel) {
		position: absolute !important;
		top: 0 !important;
		right: 0 !important;
		bottom: 0 !important;
		width: 100% !important;
		max-width: 380px !important;
		background: #ffffff !important;
		box-shadow: -6px 0 28px rgba(15, 23, 42, 0.22) !important;
		display: flex !important;
		flex-direction: column !important;
		transform: translateX(100%) !important;
		transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1) !important;
		box-sizing: border-box !important;
		font-family: system-ui, -apple-system, sans-serif !important;
	}

	:global(#floating-toc-drawer.is-open .floating-drawer-panel) {
		transform: translateX(0) !important;
	}

	/* Header */
	:global(.floating-drawer-header) {
		display: flex !important;
		align-items: center !important;
		justify-content: space-between !important;
		padding: 1.1rem 1.25rem 0.9rem 1.25rem !important;
		border-bottom: 1px solid #e2e8f0 !important;
		background: #fafaf9 !important;
		flex-shrink: 0 !important;
	}

	:global(.floating-drawer-title-wrap) {
		display: flex !important;
		align-items: center !important;
		gap: 0.6rem !important;
	}

	:global(.floating-drawer-title) {
		font-size: 1.05rem !important;
		font-weight: 700 !important;
		color: #0f172a !important;
		margin: 0 !important;
		line-height: 1.2 !important;
		letter-spacing: -0.01em !important;
	}

	:global(.floating-drawer-shortcut-hint) {
		font-size: 0.72rem !important;
		font-weight: 700 !important;
		color: #64748b !important;
		background: #f1f5f9 !important;
		border: 1px solid #e2e8f0 !important;
		padding: 0.15rem 0.45rem !important;
		border-radius: 5px !important;
		user-select: none !important;
	}

	:global(.floating-drawer-close-btn) {
		display: flex !important;
		align-items: center !important;
		justify-content: center !important;
		background: #f1f5f9 !important;
		border: 1px solid #e2e8f0 !important;
		color: #64748b !important;
		width: 32px !important;
		height: 32px !important;
		border-radius: 8px !important;
		cursor: pointer !important;
		transition: all 0.15s ease !important;
	}

	:global(.floating-drawer-close-btn:hover) {
		background: #fee2e2 !important;
		border-color: #fca5a5 !important;
		color: #dc2626 !important;
	}

	/* Body & List */
	:global(.floating-drawer-body) {
		flex: 1 1 auto !important;
		overflow-y: auto !important;
		padding: 0.85rem 0.85rem 1rem 0.85rem !important;
	}

	:global(.floating-drawer-list) {
		list-style: none !important;
		padding: 0 !important;
		margin: 0 !important;
		display: flex !important;
		flex-direction: column !important;
		gap: 0.35rem !important;
	}

	:global(.floating-drawer-item) {
		display: block !important;
		margin: 0 !important;
		padding: 0 !important;
	}

	:global(.floating-item-main-row) {
		display: flex !important;
		align-items: center !important;
		justify-content: space-between !important;
		gap: 0.4rem !important;
		padding: 0.35rem 0.5rem !important;
		border-radius: 8px !important;
		transition: background 0.15s ease !important;
	}

	:global(.floating-item-main-row:hover) {
		background: #f8fafc !important;
	}

	:global(.floating-section-link) {
		display: flex !important;
		align-items: baseline !important;
		gap: 0.5rem !important;
		flex: 1 1 auto !important;
		min-width: 0 !important;
		color: #334155 !important;
		text-decoration: none !important;
		font-size: 0.86rem !important;
		font-weight: 600 !important;
		line-height: 1.35 !important;
		transition: color 0.15s ease !important;
	}

	:global(.floating-section-link:hover) {
		color: #c8382c !important;
		text-decoration: none !important;
	}

	:global(.floating-section-link.active) {
		color: #c8382c !important;
		font-weight: 700 !important;
	}

	:global(.floating-section-num) {
		font-size: 0.78rem !important;
		font-weight: 700 !important;
		color: #94a3b8 !important;
		flex-shrink: 0 !important;
		width: 1.3rem !important;
	}

	:global(.floating-section-link.active .floating-section-num) {
		color: #c8382c !important;
	}

	:global(.floating-section-title) {
		flex: 1 1 auto !important;
		overflow: hidden !important;
		text-overflow: ellipsis !important;
	}

	/* Media Badges */
	:global(.floating-media-badges) {
