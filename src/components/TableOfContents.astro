---
// TableOfContents.astro - Centered compact card matching AudioReader dimensions and styling
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

// Curated sections in exact chronological narrative order (matching compiled MDX heading IDs)
const navItems = [
	{ number: "1", title: "Introduction", href: "#introduction" },
	{ number: "2", title: "Disclaimers", href: "#disclaimers" },
	{ number: "3", title: "7 Experiments That Lowered My Pain", href: "#7-experiments-that-lowered-my-pain-over-the-last-four-years" },
	{ number: "4", title: "What Didn't Work for Me", href: "#what-didnt-work-for-me-testing-50-supplements--water-filtration" },
	{ number: "5", title: "What I Eat Now", href: "#what-i-eat-now" },
	{ number: "6", title: "My Theory on Why Carnivore Works", href: "#my-theory-on-why-the-carnivore-diet-works" },
	{ number: "7", title: "The Acidity of 30 Common Foods & Drinks", href: "#the-acidity-of-30-common-foods--drinks" },
	{ number: "8", title: "Who I Learned the Carnivore Diet From", href: "#who-i-learned-the-carnivore-diet-from" },
	{ number: "9", title: "My Next Dentist Visits", href: "#my-next-dentist-visits" },
	{ number: "10", title: "Summary of What I've Done", href: "#summary-of-what-ive-done" }
];
---

<div class={`toc-reader-wrapper ${className}`} id="top-toc-card">
	<!-- 1. Top Compact Bar (Auto-collapsed by default, matches AudioReader) -->
	<div class="toc-card">
		<div class="toc-compact-bar" id="toc-compact-bar">
			<div class="toc-compact-left">
				<span class="toc-compact-title">Table of Contents</span>
				<span class="toc-compact-time">10 sections</span>
			</div>

			<div class="toc-compact-right">
				<!-- Plain monochrome pin icon on right with [T] shortcut hint -->
				<button 
					type="button" 
					class="toc-plain-pin-btn" 
					id="toc-pin-trigger" 
					title="Float in margin [T]"
					aria-label="Float in margin [T]"
				>
					<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="12" y1="17" x2="12" y2="22"></line>
						<path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.89A2 2 0 0 1 15 10.76V6h1a1 1 0 0 0 0-2H8a1 1 0 0 0 0 2h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.89A2 2 0 0 0 5 15.24Z"></path>
					</svg>
				</button>

				<!-- Expand / Collapse Drawer Toggle Button (Same position as AudioReader) -->
				<button 
					type="button" 
					class="toc-expand-toggle" 
					id="toc-collapse-toggle" 
					aria-expanded="false" 
					aria-controls="toc-expanded-drawer"
					title="Expand or collapse table of contents"
				>
					<span class="toc-expand-text">Sections</span>
					<svg class="toc-expand-chevron" viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2.3" fill="none">
						<polyline points="6 9 12 15 18 9"></polyline>
					</svg>
				</button>
			</div>
		</div>

		<!-- 2. Expandable Options Drawer (Hidden by default / auto-collapsed) -->
		<div class="toc-expanded-drawer" id="toc-expanded-drawer" style="display: none;">
			<div class="toc-drawer-content">
				<ol class="toc-list" id="top-toc-list">
					{navItems.map((item) => (
						<li class="toc-item">
							<a href={item.href} class="toc-link">
								<span class="toc-num">{item.number}.</span>
								<span class="toc-text">{item.title}</span>
							</a>
						</li>
					))}
				</ol>
			</div>
		</div>
	</div>
</div>

<!-- 3. Compact Floating Margin Box (~1 inch width container, 2x smaller font, [T] shortcut hint + X) -->
<div 
	id="floating-toc-box" 
	class="floating-margin-box" 
	style="display: none;"
	aria-label="Floating Table of Contents"
>
	<div class="floating-box-header">
		<span class="floating-key-hint" title="Keyboard Shortcut: Press T to toggle">[T]</span>
		<button type="button" id="floating-box-close" class="floating-close-btn" title="Close [T or Esc]" aria-label="Close">✕</button>
	</div>
	<ul class="floating-box-list">
		{navItems.map((item) => (
			<li class="floating-box-item">
				<a href={item.href} class="floating-box-link" data-target={item.href.replace('#', '')}>
					<span class="floating-box-num">{item.number}.</span>
					<span class="floating-box-text">{item.title}</span>
				</a>
			</li>
		))}
	</ul>
</div>

<script is:inline>
	(function() {
		function setupTOC() {
			const toggleBtn = document.getElementById('toc-collapse-toggle');
			const drawer = document.getElementById('toc-expanded-drawer');
			const pinBtn = document.getElementById('toc-pin-trigger');
			const floatingBox = document.getElementById('floating-toc-box');
			const closeBtn = document.getElementById('floating-box-close');
			const topCard = document.getElementById('top-toc-card');

			if (toggleBtn && drawer) {
				// Expand / Collapse Drawer Toggle
				toggleBtn.onclick = function(e) {
					e.preventDefault();
					e.stopPropagation();
					const isCurrentlyExpanded = drawer.style.display !== 'none';
					if (isCurrentlyExpanded) {
						drawer.style.display = 'none';
						toggleBtn.classList.remove('is-expanded');
						toggleBtn.setAttribute('aria-expanded', 'false');
					} else {
						drawer.style.display = 'block';
						toggleBtn.classList.add('is-expanded');
						toggleBtn.setAttribute('aria-expanded', 'true');
					}
				};

				// Collapse drawer when clicking a link
				const links = drawer.querySelectorAll('.toc-link');
				links.forEach(function(l) {
					l.onclick = function() {
						drawer.style.display = 'none';
						toggleBtn.classList.remove('is-expanded');
						toggleBtn.setAttribute('aria-expanded', 'false');
					};
				});
			}

			if (!pinBtn || !floatingBox) return;

			// Teleport floating box directly to body so position: fixed is NEVER trapped by parents
			if (floatingBox.parentElement !== document.body) {
				document.body.appendChild(floatingBox);
			}

			let isVisible = false;

			function setFloating(show, scrollToTop) {
				isVisible = show;
				if (show) {
					floatingBox.style.display = 'block';
					pinBtn.classList.add('is-active');
					try { localStorage.setItem('toc_floating_active', 'true'); } catch(e){}
				} else {
					floatingBox.style.display = 'none';
					pinBtn.classList.remove('is-active');
					try { localStorage.setItem('toc_floating_active', 'false'); } catch(e){}
					if (scrollToTop && topCard) {
						topCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
					}
				}
			}

			// Restore state on wide screens
			try {
				if (localStorage.getItem('toc_floating_active') === 'true' && window.innerWidth >= 1024) {
					setFloating(true, false);
				}
			} catch(e) {}

			// Avoid attaching multiple event listeners on page transitions
			pinBtn.onclick = function() {
				setFloating(!isVisible, false);
			};

			if (closeBtn) {
				closeBtn.onclick = function() {
					setFloating(false, false);
				};
			}

			// Keyboard shortcut: Press T / t to toggle; Esc to close
			window.addEventListener('keydown', function(e) {
				const activeEl = document.activeElement;
				if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.isContentEditable)) {
					return;
				}
				if (e.key === 't' || e.key === 'T') {
					e.preventDefault();
					setFloating(!isVisible, false);
				} else if (e.key === 'Escape' && isVisible) {
					setFloating(false, false);
				}
			});

			// Close on small mobile screens
			window.addEventListener('resize', function() {
				if (window.innerWidth < 900 && isVisible) {
					setFloating(false, false);
				}
			});

			// Highlight active section on scroll
			const floatLinks = floatingBox.querySelectorAll('.floating-box-link');
			const sectionIds = Array.from(floatLinks).map(function(l) { return l.getAttribute('data-target'); });

			function onScroll() {
				if (!isVisible) return;
				const scrollPos = window.scrollY + 160;
				let currentId = '';

				for (let i = 0; i < sectionIds.length; i++) {
					const el = document.getElementById(sectionIds[i]);
					if (el && el.offsetTop <= scrollPos) {
						currentId = sectionIds[i];
					}
				}

				floatLinks.forEach(function(link) {
					if (link.getAttribute('data-target') === currentId) {
						link.classList.add('active');
					} else {
						link.classList.remove('active');
					}
				});
			}

			window.addEventListener('scroll', onScroll, { passive: true });
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', setupTOC);
		} else {
			setupTOC();
		}
		document.addEventListener('astro:page-load', setupTOC);
	})();
</script>

<style>
	/* 1. Top Card Wrapper (Matches AudioReader width, margins, font) */
	.toc-reader-wrapper {
		margin: 1.5rem auto 1.75rem auto;
		max-width: var(--reading-max-width, 58ch);
		position: relative;
		font-family: var(--font-body, system-ui, sans-serif);
		transition: max-width 0.2s ease;
	}

	.toc-card {
		background: #ffffff;
		border: 1px solid #e2e8f0;
		border-radius: 14px;
		box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.05);
		overflow: hidden;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.toc-card:hover {
		border-color: #cbd5e1;
		box-shadow: 0 6px 22px -4px rgba(15, 23, 42, 0.08);
	}

	/* Compact Top Bar */
	.toc-compact-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.65rem 1rem;
		gap: 0.75rem;
		background: #ffffff;
	}

	.toc-compact-left {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex: 1 1 auto;
		min-width: 0;
	}

	.toc-compact-title {
		font-size: 0.9rem;
		font-weight: 700;
		color: #0f172a;
		letter-spacing: -0.01em;
	}

	.toc-compact-time {
		font-size: 0.72rem;
		font-weight: 600;
		color: #64748b;
		background: #f1f5f9;
		padding: 0.15rem 0.5rem;
		border-radius: 6px;
	}

	.toc-compact-right {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
	}

	.toc-expand-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.4rem 0.72rem;
		font-size: 0.78rem;
		font-weight: 600;
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
		color: #475569;
		cursor: pointer;
		transition: all 0.16s ease;
	}

	.toc-expand-toggle:hover {
		background: #f1f5f9;
		color: #0f172a;
		border-color: #cbd5e1;
	}

	.toc-expand-toggle.is-expanded {
		background: #0f172a;
		color: #ffffff;
		border-color: #0f172a;
	}

	.toc-expand-toggle.is-expanded .toc-expand-chevron {
		transform: rotate(180deg);
	}

	.toc-expand-chevron {
		transition: transform 0.2s ease;
	}

	/* Plain monochrome pin icon on upper right */
	.toc-plain-pin-btn {
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		padding: 0.4rem 0.5rem;
		color: #64748b;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 8px;
		transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
	}

	.toc-plain-pin-btn:hover {
		background: #f1f5f9;
		color: #0f172a;
		border-color: #cbd5e1;
	}

	.toc-plain-pin-btn.is-active {
		background: #0f172a;
		color: #ffffff;
		border-color: #0f172a;
	}

	/* 2. Expandable Drawer */
	.toc-expanded-drawer {
		background: #fafaf9;
		border-top: 1px solid #f1f5f9;
		animation: drawerSlide 0.22s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@keyframes drawerSlide {
		from { opacity: 0; transform: translateY(-6px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.toc-drawer-content {
		padding: 0.85rem 1.15rem;
	}

	.toc-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.toc-item {
		display: flex;
	}

	.toc-link {
		display: inline-flex;
		align-items: baseline;
		gap: 0.55rem;
		color: #334155;
		text-decoration: none;
		font-size: 0.88rem;
		line-height: 1.4;
		padding: 0.35rem 0.55rem;
		border-radius: 6px;
		transition: all 0.15s ease;
		width: 100%;
	}

	.toc-link:hover {
		color: #c8382c;
		background: #ffffff;
		box-shadow: 0 1px 4px rgba(0,0,0,0.04);
		transform: translateX(3px);
		text-decoration: none;
	}

	.toc-num {
		font-weight: 700;
		color: #94a3b8;
		font-size: 0.82rem;
		width: 1.4rem;
		flex-shrink: 0;
	}

	.toc-link:hover .toc-num {
		color: #c8382c;
	}

	.toc-text {
		font-weight: 600;
	}

	/* 3. Floating Margin Box */
	:global(.floating-margin-box) {
		position: fixed !important;
		top: 130px !important;
		right: max(16px, calc(50vw - 390px - 106px)) !important;
		width: 98px !important; /* ~1 inch box */
		max-width: 98px !important;
		background: #ffffff !important;
		border: 1px solid #cbd5e1 !important;
		border-radius: 8px !important;
		box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.14), 0 2px 6px rgba(0, 0, 0, 0.04) !important;
		padding: 0.3rem 0.35rem 0.45rem 0.35rem !important;
		z-index: 99999 !important;
		box-sizing: border-box !important;
		font-family: system-ui, -apple-system, sans-serif !important;
	}

	:global(.floating-box-header) {
		display: flex !important;
		justify-content: space-between !important;
		align-items: center !important;
		margin-bottom: 0.2rem !important;
		padding-bottom: 0.15rem !important;
		border-bottom: 1px solid #f1f5f9 !important;
	}

	:global(.floating-key-hint) {
		font-size: 0.52rem !important;
		font-weight: 700 !important;
		color: #94a3b8 !important;
		letter-spacing: 0.02em !important;
		user-select: none !important;
		line-height: 1 !important;
	}

	:global(.floating-close-btn) {
		background: transparent !important;
		border: none !important;
		color: #94a3b8 !important;
		font-size: 0.72rem !important;
		font-weight: 800 !important;
		cursor: pointer !important;
		padding: 1px 3px !important;
		line-height: 1 !important;
		border-radius: 3px !important;
		transition: color 0.15s ease, background 0.15s ease !important;
	}

	:global(.floating-close-btn:hover) {
		color: #dc2626 !important;
		background: #fee2e2 !important;
	}

	:global(.floating-box-list) {
		list-style: none !important;
		padding: 0 !important;
		margin: 0 !important;
		display: flex !important;
		flex-direction: column !important;
		gap: 0.22rem !important;
	}

	:global(.floating-box-item) {
		display: block !important;
		margin: 0 !important;
		padding: 0 !important;
	}

	:global(.floating-box-link) {
		display: flex !important;
		align-items: flex-start !important;
		gap: 0.2rem !important;
		color: #475569 !important;
		text-decoration: none !important;
		font-size: 0.58rem !important;
		line-height: 1.25 !important;
		padding: 0.15rem 0.2rem !important;
		border-radius: 3px !important;
		transition: all 0.12s ease !important;
		white-space: normal !important;
		word-break: break-word !important;
		overflow-wrap: break-word !important;
	}

	:global(.floating-box-link:hover) {
		color: #c8382c !important;
		background: #f8fafc !important;
		text-decoration: none !important;
	}

	:global(.floating-box-link.active) {
		color: #c8382c !important;
		background: #fef2f2 !important;
		font-weight: 700 !important;
	}

	:global(.floating-box-num) {
		font-weight: 700 !important;
		color: #94a3b8 !important;
		font-size: 0.55rem !important;
		flex-shrink: 0 !important;
		width: 0.7rem !important;
	}

	:global(.floating-box-link.active .floating-box-num) {
		color: #c8382c !important;
	}

	:global(.floating-box-text) {
		flex: 1 !important;
		white-space: normal !important;
		word-break: break-word !important;
		overflow-wrap: break-word !important;
	}

	@media (max-width: 900px) {
		.toc-plain-pin-btn {
			display: none !important;
		}
		:global(.floating-margin-box) {
			display: none !important;
		}
	}
</style>
