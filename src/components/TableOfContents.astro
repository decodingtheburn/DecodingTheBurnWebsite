---
// TableOfContents.astro - Centered top card Table of Contents with a compact floating margin box
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

// Curated sections in exact chronological narrative order (matching compiled MDX heading IDs)
const navItems = [
	{ number: "1", title: "Who Am I?", href: "#who-am-i" },
	{ number: "2", title: "Disclaimers", href: "#disclaimers" },
	{ number: "3", title: "My BMS Experiments", href: "#my-bms-experiments" },
	{ number: "4", title: "What I Eat Now", href: "#what-i-eat-now" },
	{ number: "5", title: "My Theory", href: "#my-theory" },
	{ number: "6", title: "The Acidity of 30 Common Foods & Drinks", href: "#the-acidity-of-30-common-foods--drinks" },
	{ number: "7", title: "Dentist Visits", href: "#dentist-visits" },
	{ number: "8", title: "Conclusion & Takeaways", href: "#conclusion--takeaways" }
];
---

<!-- 1. Top Static Centered Card (Always present above post content) -->
<nav class={`toc-card-single ${className}`} id="top-toc-card" aria-label="Table of Contents">
	<div class="toc-header-bar">
		<h4 class="toc-title">Table of Contents</h4>
		<!-- Plain monochrome pin icon on upper right with [T] shortcut hint in title -->
		<button 
			type="button" 
			class="toc-plain-pin-btn" 
			id="toc-pin-trigger" 
			title="Float in margin [T]"
			aria-label="Float in margin [T]"
		>
			<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="12" y1="17" x2="12" y2="22"></line>
				<path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.89A2 2 0 0 1 15 10.76V6h1a1 1 0 0 0 0-2H8a1 1 0 0 0 0 2h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.89A2 2 0 0 0 5 15.24Z"></path>
			</svg>
		</button>
	</div>

	<ol class="toc-list">
		{navItems.map((item) => (
			<li class="toc-item">
				<a href={item.href} class="toc-link">
					<span class="toc-num">{item.number}.</span>
					<span class="toc-text">{item.title}</span>
				</a>
			</li>
		))}
	</ol>
</nav>

<!-- 2. Compact Floating Margin Box (~1 inch width container, 2x smaller font, clean wrapping, [T] hint + X) -->
<div 
	id="floating-toc-box" 
	class="floating-margin-box" 
	style="display: none;"
	aria-label="Floating Table of Contents"
>
	<div class="floating-box-header">
		<span class="floating-key-hint" title="Keyboard Shortcut: Press T to toggle">[T]</span>
		<button type="button" id="floating-box-close" class="floating-close-btn" title="Close [T or Esc]" aria-label="Close">✕</button>
	</div>
	<ul class="floating-box-list">
		{navItems.map((item) => (
			<li class="floating-box-item">
				<a href={item.href} class="floating-box-link" data-target={item.href.replace('#', '')}>
					<span class="floating-box-num">{item.number}.</span>
					<span class="floating-box-text">{item.title}</span>
				</a>
			</li>
		))}
	</ul>
</div>

<script is:inline>
	(function() {
		function setupTOC() {
			const pinBtn = document.getElementById('toc-pin-trigger');
			const floatingBox = document.getElementById('floating-toc-box');
			const closeBtn = document.getElementById('floating-box-close');
			const topCard = document.getElementById('top-toc-card');

			if (!pinBtn || !floatingBox) return;

			// Teleport floating box directly to body so position: fixed is NEVER trapped by parents
			if (floatingBox.parentElement !== document.body) {
				document.body.appendChild(floatingBox);
			}

			let isVisible = false;

			function setFloating(show, scrollToTop) {
				isVisible = show;
				if (show) {
					floatingBox.style.display = 'block';
					pinBtn.classList.add('is-active');
					try { localStorage.setItem('toc_floating_active', 'true'); } catch(e){}
				} else {
					floatingBox.style.display = 'none';
					pinBtn.classList.remove('is-active');
					try { localStorage.setItem('toc_floating_active', 'false'); } catch(e){}
					if (scrollToTop && topCard) {
						topCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
					}
				}
			}

			// Restore state on wide screens
			try {
				if (localStorage.getItem('toc_floating_active') === 'true' && window.innerWidth >= 1024) {
					setFloating(true, false);
				}
			} catch(e) {}

			// Avoid attaching multiple event listeners on page transitions
			pinBtn.onclick = function() {
				setFloating(!isVisible, false);
			};

			if (closeBtn) {
				closeBtn.onclick = function() {
					setFloating(false, false);
				};
			}

			// Keyboard shortcut: Press T / t to toggle; Esc to close
			window.addEventListener('keydown', function(e) {
				const activeEl = document.activeElement;
				if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.isContentEditable)) {
					return;
				}
				if (e.key === 't' || e.key === 'T') {
					e.preventDefault();
					setFloating(!isVisible, false);
				} else if (e.key === 'Escape' && isVisible) {
					setFloating(false, false);
				}
			});

			// Close on small mobile screens
			window.addEventListener('resize', function() {
				if (window.innerWidth < 900 && isVisible) {
					setFloating(false, false);
				}
			});

			// Highlight active section on scroll
			const floatLinks = floatingBox.querySelectorAll('.floating-box-link');
			const sectionIds = Array.from(floatLinks).map(function(l) { return l.getAttribute('data-target'); });

			function onScroll() {
				if (!isVisible) return;
				const scrollPos = window.scrollY + 160;
				let currentId = '';

				for (let i = 0; i < sectionIds.length; i++) {
					const el = document.getElementById(sectionIds[i]);
					if (el && el.offsetTop <= scrollPos) {
						currentId = sectionIds[i];
					}
				}

				floatLinks.forEach(function(link) {
					if (link.getAttribute('data-target') === currentId) {
						link.classList.add('active');
					} else {
						link.classList.remove('active');
					}
				});
			}

			window.addEventListener('scroll', onScroll, { passive: true });
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', setupTOC);
		} else {
			setupTOC();
		}
		document.addEventListener('astro:page-load', setupTOC);
	})();
</script>

<style>
	/* 1. Top Static Centered Card */
	.toc-card-single {
		background: #ffffff;
		border: 1px solid #e2e8f0;
		border-radius: 16px;
		padding: 1.25rem 0.8rem;
		box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.05);
		width: 100%;
		max-width: 460px;
		margin: 2rem auto 2.5rem auto;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.toc-header-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding-bottom: 0.65rem;
		border-bottom: 1px solid #f1f5f9;
	}

	.toc-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: 1.08rem;
		font-weight: 800;
		color: #0f172a;
		margin: 0;
		letter-spacing: -0.01em;
	}

	/* Plain monochrome pin icon on upper right, no border, no background */
	.toc-plain-pin-btn {
		background: transparent;
		border: none;
		padding: 4px;
		color: #64748b;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 6px;
		transition: color 0.15s ease, transform 0.15s ease;
	}

	.toc-plain-pin-btn:hover {
		color: #7c3aed;
		transform: scale(1.1);
	}

	.toc-plain-pin-btn.is-active {
		color: #7c3aed;
	}

	.toc-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.toc-item {
		display: flex;
	}

	.toc-link {
		display: inline-flex;
		align-items: baseline;
		gap: 0.55rem;
		color: #334155;
		text-decoration: none;
		font-size: 0.92rem;
		line-height: 1.4;
		padding: 0.35rem 0.55rem;
		border-radius: 6px;
		transition: all 0.15s ease;
		width: 100%;
	}

	.toc-link:hover {
		color: #7c3aed;
		background: #f8fafc;
		transform: translateX(3px);
		text-decoration: none;
	}

	.toc-num {
		font-weight: 700;
		color: #94a3b8;
		font-size: 0.85rem;
		width: 1.25rem;
		flex-shrink: 0;
	}

	.toc-link:hover .toc-num {
		color: #7c3aed;
	}

	.toc-text {
		font-weight: 600;
	}

	/* 2. Floating Margin Box - guaranteed fixed viewport position in right margin */
	:global(.floating-margin-box) {
		position: fixed !important;
		top: 130px !important;
		right: max(16px, calc(50vw - 390px - 106px)) !important;
		width: 98px !important; /* ~1 inch box */
		max-width: 98px !important;
		background: #ffffff !important;
		border: 1px solid #cbd5e1 !important;
		border-radius: 8px !important;
		box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.14), 0 2px 6px rgba(0, 0, 0, 0.04) !important;
		padding: 0.3rem 0.35rem 0.45rem 0.35rem !important;
		z-index: 99999 !important;
		box-sizing: border-box !important;
		font-family: system-ui, -apple-system, sans-serif !important;
	}

	:global(.floating-box-header) {
		display: flex !important;
		justify-content: space-between !important;
		align-items: center !important;
		margin-bottom: 0.2rem !important;
		padding-bottom: 0.15rem !important;
		border-bottom: 1px solid #f1f5f9 !important;
	}

	:global(.floating-key-hint) {
		font-size: 0.52rem !important;
		font-weight: 700 !important;
		color: #94a3b8 !important;
		letter-spacing: 0.02em !important;
		user-select: none !important;
		line-height: 1 !important;
	}

	:global(.floating-close-btn) {
		background: transparent !important;
		border: none !important;
		color: #94a3b8 !important;
		font-size: 0.72rem !important;
		font-weight: 800 !important;
		cursor: pointer !important;
		padding: 1px 3px !important;
		line-height: 1 !important;
		border-radius: 3px !important;
		transition: color 0.15s ease, background 0.15s ease !important;
	}

	:global(.floating-close-btn:hover) {
		color: #dc2626 !important;
		background: #fee2e2 !important;
	}

	:global(.floating-box-list) {
		list-style: none !important;
		padding: 0 !important;
		margin: 0 !important;
		display: flex !important;
		flex-direction: column !important;
		gap: 0.22rem !important;
	}

	:global(.floating-box-item) {
		display: block !important;
		margin: 0 !important;
		padding: 0 !important;
	}

	:global(.floating-box-link) {
		display: flex !important;
		align-items: flex-start !important;
		gap: 0.2rem !important;
		color: #475569 !important;
		text-decoration: none !important;
		font-size: 0.58rem !important; /* 2x smaller than body/TOC font */
		line-height: 1.25 !important;
		padding: 0.15rem 0.2rem !important;
		border-radius: 3px !important;
		transition: all 0.12s ease !important;
		white-space: normal !important;
		word-break: break-word !important;
		overflow-wrap: break-word !important;
	}

	:global(.floating-box-link:hover) {
		color: #7c3aed !important;
		background: #f8fafc !important;
		text-decoration: none !important;
	}

	:global(.floating-box-link.active) {
		color: #7c3aed !important;
		background: #f3e8ff !important;
		font-weight: 700 !important;
	}

	:global(.floating-box-num) {
		font-weight: 700 !important;
		color: #94a3b8 !important;
		font-size: 0.55rem !important;
		flex-shrink: 0 !important;
		width: 0.7rem !important;
	}

	:global(.floating-box-link.active .floating-box-num) {
		color: #7c3aed !important;
	}

	:global(.floating-box-text) {
		flex: 1 !important;
		white-space: normal !important;
		word-break: break-word !important;
		overflow-wrap: break-word !important;
	}

	@media (max-width: 900px) {
		.toc-plain-pin-btn {
			display: none !important;
		}
		:global(.floating-margin-box) {
			display: none !important;
		}
	}
</style>
