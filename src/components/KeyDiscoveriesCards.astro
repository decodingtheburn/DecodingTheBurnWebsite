---
// KeyDiscoveriesCards.astro - 5 Core BMS Discoveries (3 Icons per Card with Red X / Green Check Overlays)
---

<div class="discoveries-container">
	<div class="discoveries-stack">
		<!-- Discovery #1: Acidic Drinks -->
		<div class="discovery-card">
			<div class="discovery-number">Discovery #1</div>
			<div class="discovery-emoji-group">
				<span class="discovery-emoji-item">🍺</span>
				<span class="discovery-emoji-item">🥤</span>
				<span class="discovery-emoji-item">☕</span>
				<svg class="discovery-thin-x" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
					<line x1="18" y1="18" x2="82" y2="82" stroke="#ef4444" stroke-width="1.8" stroke-linecap="round" />
					<line x1="82" y1="18" x2="18" y2="82" stroke="#ef4444" stroke-width="1.8" stroke-linecap="round" />
				</svg>
			</div>
			<h4 class="discovery-title">Acidic drinks are a direct trigger</h4>
			<p class="discovery-desc">
				<strong>My discovery:</strong> Eliminating acidic drinks like beer, sodas, and coffee immediately protected my sensitive oral nerves and brought fast, noticeable&nbsp;relief.
			</p>
		</div>

		<!-- Discovery #2: Sugary Food & Fruits -->
		<div class="discovery-card">
			<div class="discovery-number">Discovery #2</div>
			<div class="discovery-emoji-group">
				<span class="discovery-emoji-item">🍌</span>
				<span class="discovery-emoji-item">🍇</span>
				<span class="discovery-emoji-item">🍎</span>
				<svg class="discovery-thin-x" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
					<line x1="18" y1="18" x2="82" y2="82" stroke="#ef4444" stroke-width="1.8" stroke-linecap="round" />
					<line x1="82" y1="18" x2="18" y2="82" stroke="#ef4444" stroke-width="1.8" stroke-linecap="round" />
				</svg>
			</div>
			<h4 class="discovery-title">Sugary food and drinks are a trigger</h4>
			<p class="discovery-desc">
				<strong>My discovery:</strong> Eliminating all sugars that convert into acid completely stopped bacteria fermentation and spared my mouth from continuous nerve&nbsp;irritation.
			</p>
		</div>

		<!-- Discovery #3: Vegetables with Hidden Sugars -->
		<div class="discovery-card">
			<div class="discovery-number">Discovery #3</div>
			<div class="discovery-emoji-group">
				<span class="discovery-emoji-item">🥦</span>
				<span class="discovery-emoji-item">🥕</span>
				<span class="discovery-emoji-item">🫑</span>
				<svg class="discovery-thin-x" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
					<line x1="18" y1="18" x2="82" y2="82" stroke="#ef4444" stroke-width="1.8" stroke-linecap="round" />
					<line x1="82" y1="18" x2="18" y2="82" stroke="#ef4444" stroke-width="1.8" stroke-linecap="round" />
				</svg>
			</div>
			<h4 class="discovery-title">Every vegetable has sugar</h4>
			<p class="discovery-desc">
				<strong>My discovery:</strong> Eliminating vegetables and their hidden fermentable sugars removed the last subtle dietary trigger and calmed my oral nervous&nbsp;system.
			</p>
		</div>

		<!-- Discovery #4: Carnivore Diet (Meat, Seafood, Eggs) -->
		<div class="discovery-card">
			<div class="discovery-number">Discovery #4</div>
			<div class="discovery-emoji-group">
				<div class="discovery-badge-item">
					<span class="discovery-emoji-item">🥩</span>
					<div class="discovery-mini-check" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="20 6 9 17 4 12"></polyline>
						</svg>
					</div>
				</div>
				<div class="discovery-badge-item">
					<span class="discovery-emoji-item">🦐</span>
					<div class="discovery-mini-check" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="20 6 9 17 4 12"></polyline>
						</svg>
					</div>
				</div>
				<div class="discovery-badge-item">
					<span class="discovery-emoji-item">🥚</span>
					<div class="discovery-mini-check" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="20 6 9 17 4 12"></polyline>
						</svg>
					</div>
				</div>
			</div>
			<h4 class="discovery-title">Meat has zero acid and zero sugar</h4>
			<p class="discovery-desc">
				<strong>My discovery:</strong> Switching to a carnivore diet provided zero-acid, zero-sugar nutrition that starved oral bacteria and allowed my tissues to finally heal in&nbsp;peace.
			</p>
		</div>

		<!-- Discovery #5: Dental Repair & Testing (Tooth, Smile, Testing) -->
		<div class="discovery-card">
			<div class="discovery-number">Discovery #5</div>
			<div class="discovery-emoji-group">
				<div class="discovery-badge-item">
					<span class="discovery-emoji-item">🦷</span>
					<div class="discovery-mini-check" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="20 6 9 17 4 12"></polyline>
						</svg>
					</div>
				</div>
				<div class="discovery-badge-item">
					<span class="discovery-emoji-item">😁</span>
					<div class="discovery-mini-check" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="20 6 9 17 4 12"></polyline>
						</svg>
					</div>
				</div>
				<div class="discovery-badge-item">
					<span class="discovery-emoji-item">🔬</span>
					<div class="discovery-mini-check" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="20 6 9 17 4 12"></polyline>
						</svg>
					</div>
				</div>
			</div>
			<h4 class="discovery-title">Dental repair has reduced pain as well</h4>
			<p class="discovery-desc">
				<strong>My discovery:</strong> Discovering and repairing dental leaks permanently sealed nerve pathways, removing all lingering pain from the lower half of my&nbsp;jaw.
			</p>
		</div>
	</div>
</div>

<style>
	.discoveries-container {
		width: 100%;
		margin: 2.75rem 0;
		display: flex;
		justify-content: center;
	}

	.discoveries-stack {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.25rem;
		width: 100%;
	}

	.discovery-card {
		background: #ffffff;
		border: 1.5px solid #e2e8f0;
		border-radius: 1.5rem;
		/* 75% of reading container width with generous spacious padding */
		width: 82%;
		max-width: 46ch;
		padding: 2.75rem 2.25rem 2.5rem 2.25rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		/* Enhanced deep drop shadow */
		box-shadow: 0 18px 45px rgba(15, 23, 42, 0.09), 0 4px 14px rgba(15, 23, 42, 0.04);
		transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
		box-sizing: border-box;
	}

	.discovery-card:hover {
		transform: translateY(-4px);
		border-color: #cbd5e1;
		box-shadow: 0 24px 54px rgba(15, 23, 42, 0.13), 0 6px 18px rgba(124, 58, 237, 0.09);
	}

	/* Discovery Number Label (Positioned cleanly above the emoji) */
	.discovery-number {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: 0.95rem;
		font-weight: 800;
		color: #7c3aed;
		letter-spacing: 0.03em;
		margin-bottom: 0.95rem;
		text-transform: uppercase;
	}

	/* 3D Emoji Group */
	.discovery-emoji-group {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.85rem;
		margin-bottom: 1.25rem;
		position: relative;
		padding: 0.35rem 0.75rem;
	}

	.discovery-emoji-item {
		font-size: 3.65rem;
		line-height: 1;
		filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.14));
		display: inline-block;
		transition: transform 0.25s ease;
	}

	.discovery-card:hover .discovery-emoji-item:nth-child(1) {
		transform: scale(1.08) rotate(-4deg);
	}
	.discovery-card:hover .discovery-emoji-item:nth-child(2) {
		transform: scale(1.12);
	}
	.discovery-card:hover .discovery-emoji-item:nth-child(3) {
		transform: scale(1.08) rotate(4deg);
	}

	/* Large Thin Red X Covering the 3 Trigger Icons */
	.discovery-thin-x {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		filter: drop-shadow(0 1px 3px rgba(239, 68, 68, 0.35));
		opacity: 0.92;
	}

	/* Individual Badge Item with Mini Green Notification Check */
	.discovery-badge-item {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.discovery-mini-check {
		position: absolute;
		top: -4px;
		right: -6px;
		background: #10b981;
		border: 2px solid #ffffff;
		border-radius: 50%;
		width: 22px;
		height: 22px;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 3px 8px rgba(16, 185, 129, 0.4);
		transition: transform 0.2s ease;
	}

	.discovery-card:hover .discovery-mini-check {
		transform: scale(1.15);
	}

	/* Card Title */
	.discovery-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(1.35rem, 2.2vw, 1.65rem);
		font-weight: 900;
		color: #0f172a;
		margin: 0 0 0.95rem 0;
		letter-spacing: -0.02em;
		line-height: 1.22;
		text-wrap: balance;
	}

	/* Card Description */
	.discovery-desc {
		font-size: 1.02rem;
		color: #334155;
		line-height: 1.58;
		margin: 0;
		text-wrap: pretty;
	}

	.discovery-desc strong {
		color: #0f172a;
		font-weight: 800;
	}

	@media (max-width: 640px) {
		.discovery-card {
			width: 100%;
			max-width: 100%;
			padding: 2.25rem 1.35rem 2rem 1.35rem;
		}

		.discovery-emoji-item {
			font-size: 2.85rem;
		}
	}
</style>
