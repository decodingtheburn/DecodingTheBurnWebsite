---
interface Props {
  variant?: 'inline' | 'stacked';
  size?: 'normal' | 'large' | 'compact';
}

const { variant = 'inline', size = 'normal' } = Astro.props;
---

<div class={`acid-triggered-logo ${variant} ${size}`}>
  <!-- ACID-TRIGGERED in 14-Letter Rainbow Spectrum with Inter 900 -->
  <div class="title-row">
    <span style="color: #dc2626;">A</span><span style="color: #ea580c;">C</span><span style="color: #f97316;">I</span><span style="color: #d97706;">D</span><span style="color: #ca8a04;">-</span><span style="color: #a16207;">T</span><span style="color: #65a30d;">R</span><span style="color: #16a34a;">I</span><span style="color: #059669;">G</span><span style="color: #0891b2;">G</span><span style="color: #0284c7;">E</span><span style="color: #2563eb;">R</span><span style="color: #4f46e5;">E</span><span style="color: #7c3aed;">D</span>
  </div>

  <!-- Subtitle: MOUTH PAIN RELIEF Centered in High-Contrast Deep Slate / Black -->
  <div class="subtitle-row">
    MOUTH PAIN RELIEF
  </div>
</div>

<style>
  .acid-triggered-logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    user-select: none;
    text-decoration: none;
    line-height: 1;
    gap: 0.22rem;
  }

  .title-row {
    display: inline-flex;
    align-items: baseline;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 1;
    /* Clean subtle drop shadow for crisp definition on white */
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .subtitle-row {
    width: 100%;
    font-weight: 900;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    line-height: 1;
    text-align: center;
    color: #0f172a;
    transition: color 0.2s ease;
  }

  /* Dark mode support */
  :global(.dark) .subtitle-row,
  :global([data-theme="dark"]) .subtitle-row,
  :global(.navbar-dark) .subtitle-row {
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  :global(.dark) .title-row,
  :global([data-theme="dark"]) .title-row,
  :global(.navbar-dark) .title-row {
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  /* Sizes */
  .acid-triggered-logo.normal .title-row {
    font-size: 1.55rem;
  }
  .acid-triggered-logo.normal .subtitle-row {
    font-size: 0.78rem;
  }

  .acid-triggered-logo.compact .title-row {
    font-size: 1.25rem;
  }
  .acid-triggered-logo.compact .subtitle-row {
    font-size: 0.65rem;
  }

  .acid-triggered-logo.large .title-row {
    font-size: 2.35rem;
  }
  .acid-triggered-logo.large .subtitle-row {
    font-size: 1.15rem;
  }

  @media (max-width: 640px) {
    .acid-triggered-logo.normal .title-row {
      font-size: 1.3rem;
    }
    .acid-triggered-logo.normal .subtitle-row {
      font-size: 0.68rem;
    }
  }
</style>
