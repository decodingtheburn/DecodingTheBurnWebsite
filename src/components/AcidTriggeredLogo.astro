---
interface Props {
  variant?: 'inline' | 'stacked';
  size?: 'normal' | 'large' | 'compact';
}

const { variant = 'inline', size = 'normal' } = Astro.props;

// "BMS TRIGGERS" in 11 letters across the rainbow spectrum
// B: #dc2626 (red)
// M: #ea580c (orange-red)
// S: #f97316 (orange)
// [space]
// T: #d97706 (amber)
// R: #ca8a04 (yellow-amber)
// I: #65a30d (lime)
// G: #16a34a (green)
// G: #059669 (emerald)
// E: #0891b2 (cyan)
// R: #2563eb (blue)
// S: #7c3aed (purple)
---

<div class={`bms-triggers-logo ${variant} ${size}`}>
  <div class="title-row">
    <span class="word-bms">
      <span style="color: #dc2626;">B</span><span style="color: #ea580c;">M</span><span style="color: #f97316;">S</span>
    </span>
    <span class="word-spacer">&nbsp;</span>
    <span class="word-triggers">
      <span style="color: #d97706;">T</span><span style="color: #ca8a04;">R</span><span style="color: #65a30d;">I</span><span style="color: #16a34a;">G</span><span style="color: #059669;">G</span><span style="color: #0891b2;">E</span><span style="color: #2563eb;">R</span><span style="color: #7c3aed;">S</span>
    </span>
  </div>
</div>

<style>
  .bms-triggers-logo {
    display: inline-flex;
    align-items: center;
    font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    user-select: none;
    text-decoration: none;
    line-height: 1;
  }

  .title-row {
    display: inline-flex;
    align-items: baseline;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1;
    text-shadow: none !important;
  }

  .word-bms, .word-triggers {
    display: inline-flex;
    align-items: baseline;
  }

  /* Sizes */
  .bms-triggers-logo.normal .title-row {
    font-size: 1.65rem;
  }

  .bms-triggers-logo.compact .title-row {
    font-size: 1.35rem;
  }

  .bms-triggers-logo.large .title-row {
    font-size: 2.5rem;
  }

  @media (max-width: 640px) {
    .bms-triggers-logo.normal .title-row {
      font-size: 1.35rem;
    }
  }
</style>
