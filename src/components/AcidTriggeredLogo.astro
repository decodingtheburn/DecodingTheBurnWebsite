---
interface Props {
  variant?: 'inline' | 'stacked';
  size?: 'normal' | 'large' | 'compact';
}

const { variant = 'inline', size = 'normal' } = Astro.props;

// "BMS" in Solid Pure Black
// "TRIGGERS" in 8-letter Rainbow Spectrum (Red to Purple):
// T: #dc2626 (red)
// R: #ea580c (orange-red)
// I: #d97706 (amber)
// G: #65a30d (lime)
// G: #16a34a (green)
// E: #0891b2 (cyan)
// R: #2563eb (blue)
// S: #7c3aed (purple)
---

<div class={`bms-triggers-logo ${variant} ${size}`}>
  <div class="title-row">
    <span class="word-bms">BMS</span>
    <span class="word-spacer">&nbsp;</span>
    <span class="word-triggers">
      <span style="color: #dc2626;">T</span><span style="color: #ea580c;">R</span><span style="color: #d97706;">I</span><span style="color: #65a30d;">G</span><span style="color: #16a34a;">G</span><span style="color: #0891b2;">E</span><span style="color: #2563eb;">R</span><span style="color: #7c3aed;">S</span>
    </span>
  </div>
</div>

<style>
  .bms-triggers-logo {
    display: inline-flex;
    align-items: center;
    font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    user-select: none;
    text-decoration: none;
    line-height: 1;
  }

  .title-row {
    display: inline-flex;
    align-items: baseline;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1;
    text-shadow: none !important;
  }

  .word-bms {
    color: #000000 !important;
  }

  .word-triggers {
    display: inline-flex;
    align-items: baseline;
  }

  /* Sizes */
  .bms-triggers-logo.normal .title-row {
    font-size: 1.65rem;
  }

  .bms-triggers-logo.compact .title-row {
    font-size: 1.35rem;
  }

  .bms-triggers-logo.large .title-row {
    font-size: 2.5rem;
  }

  @media (max-width: 640px) {
    .bms-triggers-logo.normal .title-row {
      font-size: 1.35rem;
    }
  }
</style>
