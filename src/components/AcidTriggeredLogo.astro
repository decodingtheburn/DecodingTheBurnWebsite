---
interface Props {
  variant?: 'inline' | 'stacked';
  size?: 'normal' | 'large' | 'compact';
}

const { variant = 'inline', size = 'normal' } = Astro.props;
---

<div class={`acid-triggered-logo ${variant} ${size}`}>
  <!-- ACID-TRIGGERED in 14-Letter Rainbow Spectrum with Tight Kerning -->
  <div class="title-row">
    <span style="color: #ef4444;">A</span><span style="color: #f45b36;">C</span><span style="color: #f97316;">I</span><span style="color: #fb923c;">D</span><span style="color: #f59e0b;">-</span><span style="color: #eab308;">T</span><span style="color: #84cc16;">R</span><span style="color: #22c55e;">I</span><span style="color: #10b981;">G</span><span style="color: #06b6d4;">G</span><span style="color: #0ea5e9;">E</span><span style="color: #3b82f6;">R</span><span style="color: #6366f1;">E</span><span style="color: #a855f7;">D</span>
  </div>

  <!-- Subtitle: MOUTH PAIN RELIEF Left-Aligned in Crisp Solid White -->
  <div class="subtitle-row">
    MOUTH PAIN RELIEF
  </div>
</div>

<style>
  .acid-triggered-logo {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    font-family: 'Montserrat', system-ui, -apple-system, sans-serif;
    user-select: none;
    text-decoration: none;
    line-height: 1;
    gap: 0.22rem;
  }

  .title-row {
    display: inline-flex;
    align-items: baseline;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.85);
  }

  .subtitle-row {
    font-weight: 900;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    line-height: 1;
    text-align: left;
    color: #0f172a;
    transition: color 0.2s ease;
  }

  /* White subtitle for dark mode / dark navbar backgrounds */
  :global(.dark) .subtitle-row,
  :global([data-theme="dark"]) .subtitle-row,
  :global(.navbar-dark) .subtitle-row,
  :global(.navbar) .subtitle-row {
    color: #ffffff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
  }

  /* Sizes */
  .acid-triggered-logo.normal .title-row {
    font-size: 1.55rem;
  }
  .acid-triggered-logo.normal .subtitle-row {
    font-size: 0.78rem;
  }

  .acid-triggered-logo.compact .title-row {
    font-size: 1.25rem;
  }
  .acid-triggered-logo.compact .subtitle-row {
    font-size: 0.65rem;
  }

  .acid-triggered-logo.large .title-row {
    font-size: 2.35rem;
  }
  .acid-triggered-logo.large .subtitle-row {
    font-size: 1.15rem;
  }

  @media (max-width: 640px) {
    .acid-triggered-logo.normal .title-row {
      font-size: 1.3rem;
    }
    .acid-triggered-logo.normal .subtitle-row {
      font-size: 0.68rem;
    }
  }
</style>
