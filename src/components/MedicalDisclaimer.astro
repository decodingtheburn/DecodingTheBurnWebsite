---
// Subtle, compact Medical Disclaimer & Affiliate Notice
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`disclaimer-compact ${className}`}>
	<p class="disclaimer-text">
		<strong>Medical Disclaimer:</strong> It's my personal health journey, self-experiments, and research. It is educational and informational only, and not intended as medical advice. Always seek the advice of your physician or qualified medical provider with any questions regarding a health&nbsp;condition.
	</p>
</div>

<style>
	.disclaimer-compact {
		max-width: var(--reading-max-width, 58ch);
		width: 100%;
		margin: 0 auto;
		padding-bottom: 1.5rem;
		text-align: center;
		background: transparent;
		border: none;
	}

	.disclaimer-text {
		font-size: 0.68rem;
		line-height: 1.5;
		color: #64748b;
		margin: 0 auto;
		text-align: center;
		text-wrap: balance;
	}

	.disclaimer-text strong {
		color: #334155;
		font-weight: 700;
		margin-right: 0.2rem;
	}
</style>
