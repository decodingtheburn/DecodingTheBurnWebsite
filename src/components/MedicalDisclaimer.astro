---
// Subtle, compact Medical Disclaimer & Affiliate Notice
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`disclaimer-compact ${className}`}>
	<p class="disclaimer-text">
		<strong>Medical Disclaimer:</strong> I am sharing my personal lived experiences, self-experiments, and what worked for my own body. I am a patient, not a doctor. Always consult your physician or specialist before trying any new health&nbsp;protocol.
	</p>
	<p class="disclaimer-text">
		<strong>Notice:</strong> This site may contain affiliate links. If you make a purchase through these links, I may earn a modest commission at no extra cost to you, which helps support my ongoing&nbsp;research.
	</p>
</div>

<style>
	.disclaimer-compact {
		max-width: 860px;
		margin: 0 auto 0.85rem;
		text-align: left;
		padding: 0;
		background: transparent;
		border: none;
	}

	.disclaimer-text {
		font-size: 0.68rem; /* 1.3x smaller than standard base size */
		line-height: 1.45;
		color: #52525b; /* medium gray */
		margin: 0 0 0.35rem;
		text-wrap: pretty;
	}

	.disclaimer-text:last-child {
		margin-bottom: 0;
	}

	.disclaimer-text strong {
		color: #18181b; /* dark slate/black */
		font-weight: 700;
		margin-right: 0.25rem;
	}
</style>
