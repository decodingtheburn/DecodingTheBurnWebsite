---
// Subtle, compact Medical Disclaimer & Affiliate Notice
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`disclaimer-compact ${className}`}>
	<p class="disclaimer-text">
		<strong>Medical Disclaimer:</strong> I am sharing my personal lived experiences, self-experiments, and what worked for my own body. I am a patient, not a doctor. Always consult your physician or specialist before trying any new health&nbsp;protocol. This site might contain affiliate&nbsp;links.
	</p>
</div>

<style>
	.disclaimer-compact {
		max-width: 880px;
		width: 100%;
		margin: 0 auto;
		padding-bottom: 35px;
		text-align: left;
		background: transparent;
		border: none;
	}

	.disclaimer-text {
		font-size: 0.58rem; /* 2x smaller font size */
		line-height: 1.4;
		color: #64748b; /* subtle light-medium gray */
		margin: 0;
		text-wrap: pretty;
	}

	.disclaimer-text strong {
		color: #334155;
		font-weight: 700;
		margin-right: 0.25rem;
	}
</style>
