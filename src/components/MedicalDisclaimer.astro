---
// Subtle, compact Medical Disclaimer & Affiliate Notice
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`disclaimer-compact ${className}`}>
	<p class="disclaimer-text">
		<strong>Medical Disclaimer:</strong> I am sharing my personal lived experiences and self-experiments. I am a patient, not a doctor. Always consult your physician before trying anything&nbsp;new.
	</p>
</div>

<style>
	.disclaimer-compact {
		max-width: var(--reading-max-width, 58ch);
		width: 100%;
		margin: 0 auto;
		padding-bottom: 1.5rem;
		text-align: center;
		background: transparent;
		border: none;
	}

	.disclaimer-text {
		font-size: 0.68rem;
		line-height: 1.5;
		color: #64748b;
		margin: 0 auto;
		text-align: center;
		text-wrap: balance;
	}

	.disclaimer-text strong {
		color: #334155;
		font-weight: 700;
		margin-right: 0.2rem;
	}
</style>
