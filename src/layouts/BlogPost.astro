---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AudioReader from '../components/AudioReader.astro';
import { Image } from 'astro:assets';

interface Props extends CollectionEntry<'blog'>['data'] {
	headings?: { depth: number; slug: string; text: string }[];
	slug?: string;
	showAudioReader?: boolean;
}

const { title, description, pubDate, updatedDate, heroImage, headings = [], slug, showAudioReader = Boolean(slug) } = Astro.props;

// Filter headings to only show h2 and h3
const toc = (headings || []).filter((h) => h.depth <= 3);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="post-container">
			<article class="blog-post">
				<div class="hero-image">
					{heroImage && typeof heroImage === 'string' ? (
						<img src={heroImage} alt={title} class="post-image" />
					) : (
						heroImage && <Image src={heroImage} alt={title} class="post-image" />
					)}
				</div>

				<h1 set:html={title} />

				<div class="post-meta">
					<span>Published on <FormattedDate date={pubDate} /></span>
					{
						updatedDate && (
							<span> • Updated on <FormattedDate date={updatedDate} /></span>
						)
					}
				</div>
				<MedicalDisclaimer />

				{showAudioReader && <AudioReader title={title} />}

				<div class="blog-layout-grid">
					<div class="post-content">
						<slot />
					</div>
				</div>
				<AuthorBox />
			</article>
		</main>
		<Footer />
		<style>
			.blog-post h1 {
				font-size: 2.25rem;
				line-height: 1.22;
				letter-spacing: -0.025em;
				color: var(--text-primary);
				font-weight: 800;
				margin: 1.5rem auto 1rem auto;
				max-width: 680px;
				text-wrap: balance;
			}
			.blog-layout-grid {
				display: block;
				max-width: 680px;
				margin: 1.5rem auto 0 auto;
				position: relative;
			}
			.post-content {
				width: 100%;
			}
		</style>
	</body>
</html>
