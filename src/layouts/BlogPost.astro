---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AudioReader from '../components/AudioReader.astro';
import { Image } from 'astro:assets';
import { getPostEntryNumber, sortPostsAscending } from '../utils/postUtils';

interface Props extends CollectionEntry<'blog'>['data'] {
	headings?: { depth: number; slug: string; text: string }[];
	slug?: string;
	showAudioReader?: boolean;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	headings = [],
	slug,
	showAudioReader = Boolean(slug),
	entryNumber,
	category,
	tags = [],
} = Astro.props;

// Filter headings to only show h2 and h3
const toc = (headings || []).filter((h) => h.depth <= 3);

let postNumber = entryNumber;
if (!postNumber && slug) {
	const allPosts = await getCollection('blog', ({ data }) => !data.draft);
	const sorted = sortPostsAscending(allPosts);
	const current = allPosts.find((p) => p.id === slug);
	if (current) {
		postNumber = getPostEntryNumber(current, sorted);
	}
}
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="post-container">
			<article class="blog-post">
				<div class="hero-image">
					{heroImage && typeof heroImage === 'string' ? (
						<img src={heroImage} alt={title} class="post-image" />
					) : (
						heroImage && <Image src={heroImage} alt={title} class="post-image" />
					)}
				</div>

				<h1 set:html={title} />

				<div class="post-meta">
					<div class="post-meta-lockup">
						{postNumber && (
							<span class="post-meta-entry">
								<span class="post-entry-pill">Post #{postNumber}</span>
							</span>
						)}
						{(tags?.[0] || category) && (
							<>
								<span class="post-meta-dot" aria-hidden="true">•</span>
								<span class="post-meta-tag">{tags?.[0] || category}</span>
							</>
						)}
						<span class="post-meta-dot" aria-hidden="true">•</span>
						<span class="post-meta-date">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="post-meta-icon" aria-hidden="true">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
								<line x1="16" y1="2" x2="16" y2="6"></line>
								<line x1="8" y1="2" x2="8" y2="6"></line>
								<line x1="3" y1="10" x2="21" y2="10"></line>
							</svg>
							<span>Published on <FormattedDate date={pubDate} /></span>
						</span>
						{updatedDate && (
							<>
								<span class="post-meta-dot" aria-hidden="true">•</span>
								<span class="post-meta-updated">Updated on <FormattedDate date={updatedDate} /></span>
							</>
						)}
					</div>
				</div>
				<MedicalDisclaimer />

				{showAudioReader && <AudioReader title={title} />}

				<div class="blog-layout-grid">
					<div class="post-content">
						<slot />
					</div>
				</div>
				<AuthorBox />
			</article>
		</main>
		<Footer />
		<style>
			.blog-post h1 {
				font-size: 2.25rem;
				line-height: 1.22;
				letter-spacing: -0.025em;
				color: var(--text-primary);
				font-weight: 800;
				margin: 1.5rem auto 1rem auto;
				max-width: var(--reading-max-width, 58ch);
				text-wrap: balance;
			}
			.post-meta {
				max-width: var(--reading-max-width, 58ch);
				margin: 0 auto 1.5rem auto;
				display: flex;
				align-items: center;
			}
			.post-meta-lockup {
				display: inline-flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.45rem 0.65rem;
				padding: 0.35rem 0.85rem;
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 8px;
				font-size: 0.85rem;
				color: #64748b;
				line-height: 1.4;
			}
			.post-entry-pill {
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.76rem;
				font-weight: 700;
				color: #0f172a;
				background: #e2e8f0;
				padding: 0.18rem 0.5rem;
				border-radius: 5px;
				letter-spacing: 0.01em;
				white-space: nowrap;
			}
			.post-meta-tag {
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.74rem;
				font-weight: 700;
				color: #be123c;
				background: #fff1f2;
				border: 1px solid #fecdd3;
				padding: 0.16rem 0.5rem;
				border-radius: 5px;
				letter-spacing: 0.02em;
				white-space: nowrap;
			}
			.post-meta-dot {
				color: #cbd5e1;
				font-weight: 700;
				user-select: none;
			}
			.post-meta-date {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				color: #475569;
				font-weight: 500;
				white-space: nowrap;
			}
			.post-meta-icon {
				color: #64748b;
				flex-shrink: 0;
			}
			.post-meta-updated {
				color: #64748b;
				font-weight: 400;
				font-size: 0.82rem;
				white-space: nowrap;
			}
			.blog-layout-grid {
				display: block;
				max-width: var(--reading-max-width, 58ch);
				margin: 1.5rem auto 0 auto;
				position: relative;
				transition: max-width 0.2s ease;
			}
			.post-content {
				width: 100%;
			}

			/* Section Headings */
			.post-content :global(h2) {
				margin: 3.5rem 0 1.5rem 0;
				padding: 0;
				border: none;
				background: transparent;
				font-size: 1.65rem;
				line-height: 1.3;
				color: var(--text-primary);
				font-weight: 800;
				text-wrap: balance;
			}

			@media (max-width: 580px) {
				.post-content :global(h2) {
					font-size: 1.35rem;
					line-height: 1.25;
					margin: 2.75rem 0 1.25rem 0;
				}
			}

			/* Book Showcase Content Box for Peggy Sharr's Survival Guide */
			.post-content :global(.book-showcase-card) {
				display: flex;
				flex-direction: column;
				align-items: center;
				width: 100%;
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 18px;
				padding: 2.25rem 2rem;
				margin: 3rem 0;
				box-shadow: none;
			}

			.post-content :global(.book-cover-container) {
				width: 100%;
				max-width: 440px;
				margin: 0 auto 1.5rem auto;
				display: flex;
				justify-content: center;
			}

			.post-content :global(.book-cover-link) {
				display: block;
				width: 100%;
				text-decoration: none;
				border: none;
				outline: none;
				transition: transform 0.2s ease, opacity 0.2s ease;
			}

			.post-content :global(.book-cover-link:hover) {
				transform: translateY(-2px);
				opacity: 0.95;
			}

			.post-content :global(.book-cover-image) {
				width: 100%;
				max-width: 420px;
				height: auto;
				display: block;
				margin: 0 auto;
				border: none;
				border-radius: 0;
				box-shadow: none;
				filter: none;
				background: transparent;
			}

			.post-content :global(.book-details) {
				width: 100%;
				max-width: 680px;
				margin: 0 auto;
				text-align: center;
			}

			.post-content :global(.book-title) {
				font-size: 1.45rem;
				font-weight: 800;
				color: var(--text-primary);
				margin: 0 0 0.35rem 0;
				line-height: 1.3;
				text-wrap: balance;
			}

			.post-content :global(.book-title a) {
				color: inherit;
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.post-content :global(.book-title a:hover) {
				color: var(--accent);
				text-decoration: none;
			}

			.post-content :global(.book-byline) {
				font-size: 0.95rem;
				font-weight: 600;
				color: #64748b;
				margin: 0 0 1rem 0;
			}

			.post-content :global(.book-summary) {
				font-size: 1.05rem;
				color: var(--text-secondary);
				line-height: 1.65;
				margin: 0 0 1.25rem 0;
				text-wrap: pretty;
			}

			.post-content :global(.book-action) {
				margin: 0.5rem 0 0 0;
			}

			.post-content :global(.book-site-link) {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 1rem;
				font-weight: 700;
				color: var(--accent);
				text-decoration: none;
				transition: opacity 0.2s ease, transform 0.2s ease;
			}

			.post-content :global(.book-site-link:hover) {
				text-decoration: none;
				opacity: 0.85;
				transform: translateX(2px);
			}

			/* Mission Callout Card with 3D Emoji */
			.post-content :global(.mission-callout-box) {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1.5rem;
				background: linear-gradient(135deg, #fff1f2 0%, #fff7ed 100%);
				border: 1px solid #fecdd3;
				border-left: 5px solid #be123c;
				border-radius: 14px;
				padding: 1.35rem 1.75rem;
				margin: 2.25rem 0;
				box-shadow: 0 4px 16px -4px rgba(190, 18, 60, 0.1);
			}

			.post-content :global(.mission-content-col) {
				flex: 1;
				min-width: 0;
			}

			.post-content :global(.mission-tag-pill) {
				display: inline-block;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.72rem;
				font-weight: 700;
				color: #be123c;
				background: #ffffff;
				border: 1px solid #fecdd3;
				padding: 0.15rem 0.55rem;
				border-radius: 4px;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				margin-bottom: 0.5rem;
			}

			.post-content :global(.mission-callout-text) {
				font-size: 1.05rem;
				line-height: 1.55;
				color: #881337;
				font-weight: 600;
				margin: 0;
				text-wrap: pretty;
			}

			.post-content :global(.mission-emoji-col) {
				flex-shrink: 0;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.post-content :global(.mission-3d-emoji) {
				font-size: 3.5rem;
				line-height: 1;
				display: inline-block;
				filter: drop-shadow(0 6px 14px rgba(190, 18, 60, 0.28));
				transform: scale(1.05) rotate(-4deg);
				transition: transform 0.3s ease;
				user-select: none;
			}

			.post-content :global(.mission-callout-box:hover .mission-3d-emoji) {
				transform: scale(1.15) rotate(0deg);
			}

			@media (max-width: 580px) {
				.post-content :global(.mission-callout-box) {
					flex-direction: column-reverse;
					align-items: flex-start;
					gap: 1rem;
					padding: 1.25rem 1.25rem;
				}

				.post-content :global(.mission-3d-emoji) {
					font-size: 2.75rem;
				}
			}

			/* Physician Disclaimer Box */
			.post-content :global(.physician-disclaimer-box) {
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-left: 4px solid #64748b;
				border-radius: 10px;
				padding: 1.15rem 1.4rem;
				margin: 1.75rem 0;
			}

			.post-content :global(.physician-disclaimer-box p) {
				margin: 0;
				font-size: 0.92rem;
				color: #475569;
				line-height: 1.6;
				text-wrap: pretty;
			}

			.post-content :global(.physician-disclaimer-box strong) {
				color: #0f172a;
				font-weight: 700;
			}

			/* Episode & Trigger Progression Cards (Compact Architecture) */
			.post-content :global(.episode-card) {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 14px;
				padding: 1.25rem 1.6rem;
				margin: 1.5rem 0;
				box-shadow: 0 3px 14px -2px rgba(0, 0, 0, 0.04);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.post-content :global(.episode-card:hover) {
				box-shadow: 0 6px 20px -3px rgba(0, 0, 0, 0.07);
			}

			.post-content :global(.episode-card-header) {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				margin-bottom: 0.95rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid #f1f5f9;
				flex-wrap: wrap;
			}

			.post-content :global(.episode-badge) {
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.72rem;
				font-weight: 700;
				color: #4338ca;
				background: #eef2ff;
				border: 1px solid #c7d2fe;
				padding: 0.16rem 0.55rem;
				border-radius: 5px;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				white-space: nowrap;
			}

			.post-content :global(.episode-card-title) {
				font-size: 1.18rem;
				font-weight: 800;
				color: #0f172a;
				margin: 0;
				line-height: 1.3;
				letter-spacing: -0.015em;
			}

			.post-content :global(.episode-row) {
				display: flex;
				align-items: baseline;
				gap: 0.75rem;
				margin-bottom: 0.65rem;
				font-size: 0.94rem;
				line-height: 1.55;
				color: #334155;
				text-wrap: pretty;
			}

			.post-content :global(.episode-row:last-child) {
				margin-bottom: 0;
			}

			.post-content :global(.field-label) {
				flex-shrink: 0;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.7rem;
				font-weight: 800;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				padding: 0.15rem 0.5rem;
				border-radius: 4px;
				line-height: 1.2;
				white-space: nowrap;
			}

			.post-content :global(.label-trigger) {
				color: #be123c;
				background: #fff1f2;
				border: 1px solid #fecdd3;
			}

			.post-content :global(.label-symptom) {
				color: #c2410c;
				background: #fff7ed;
				border: 1px solid #fed7aa;
			}

			.post-content :global(.label-action) {
				color: #1d4ed8;
				background: #eff6ff;
				border: 1px solid #bfdbfe;
			}

			.post-content :global(.label-discovery) {
				color: #047857;
				background: #ecfdf5;
				border: 1px solid #a7f3d0;
			}

			.post-content :global(.label-logic) {
				color: #6b21a8;
				background: #faf5ff;
				border: 1px solid #e9d5ff;
			}

			.post-content :global(.field-text) {
				margin: 0;
				flex: 1;
				color: #334155;
				line-height: 1.55;
			}

			.post-content :global(.field-text strong) {
				color: #0f172a;
			}

			.post-content :global(.field-discovery-wrap) {
				background: #f8fafc;
				border-left: 3px solid #059669;
				padding: 0.7rem 1rem;
				border-radius: 0 8px 8px 0;
				margin-top: 0.45rem;
				display: flex;
				align-items: baseline;
				gap: 0.75rem;
			}

			.post-content :global(.field-discovery-text) {
				margin: 0;
				flex: 1;
				font-size: 0.93rem;
				color: #064e3b;
				line-height: 1.55;
				font-weight: 500;
				text-wrap: pretty;
			}

			.post-content :global(.field-value-logic) {
				background: #faf5ff;
				border-left: 3px solid #9333ea;
				padding: 0.85rem 1.15rem;
				border-radius: 0 8px 8px 0;
				font-size: 0.95rem;
				color: #581c87;
				line-height: 1.6;
				margin: 0;
				font-weight: 500;
				text-wrap: pretty;
			}

			@media (max-width: 600px) {
				.post-content :global(.episode-card) {
					padding: 1.15rem 1.15rem;
					margin: 1.25rem 0;
				}

				.post-content :global(.episode-card-header) {
					flex-direction: column-reverse;
					align-items: flex-start;
					gap: 0.35rem;
				}

				.post-content :global(.episode-row),
				.post-content :global(.field-discovery-wrap) {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.3rem;
				}

				.post-content :global(.episode-card-title) {
					font-size: 1.1rem;
				}
			}
		</style>
	</body>
</html>
