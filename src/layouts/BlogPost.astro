---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AudioReader from '../components/AudioReader.astro';
import { Image } from 'astro:assets';
import { getPostEntryNumber, sortPostsAscending } from '../utils/postUtils';

interface Props extends CollectionEntry<'blog'>['data'] {
	headings?: { depth: number; slug: string; text: string }[];
	slug?: string;
	showAudioReader?: boolean;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	headings = [],
	slug,
	showAudioReader = Boolean(slug),
	entryNumber,
} = Astro.props;

// Filter headings to only show h2 and h3
const toc = (headings || []).filter((h) => h.depth <= 3);

let postNumber = entryNumber;
if (!postNumber && slug) {
	const allPosts = await getCollection('blog', ({ data }) => !data.draft);
	const sorted = sortPostsAscending(allPosts);
	const current = allPosts.find((p) => p.id === slug);
	if (current) {
		postNumber = getPostEntryNumber(current, sorted);
	}
}
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="post-container">
			<article class="blog-post">
				<div class="hero-image">
					{heroImage && typeof heroImage === 'string' ? (
						<img src={heroImage} alt={title} class="post-image" />
					) : (
						heroImage && <Image src={heroImage} alt={title} class="post-image" />
					)}
				</div>

				<h1 set:html={title} />

				<div class="post-meta">
					<div class="post-meta-lockup">
						{postNumber && (
							<span class="post-meta-entry">
								<span class="post-entry-pill">Entry #{postNumber}</span>
							</span>
						)}
						{postNumber && <span class="post-meta-dot" aria-hidden="true">•</span>}
						<span class="post-meta-date">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="post-meta-icon" aria-hidden="true">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
								<line x1="16" y1="2" x2="16" y2="6"></line>
								<line x1="8" y1="2" x2="8" y2="6"></line>
								<line x1="3" y1="10" x2="21" y2="10"></line>
							</svg>
							<span>Published on <FormattedDate date={pubDate} /></span>
						</span>
						{updatedDate && (
							<>
								<span class="post-meta-dot" aria-hidden="true">•</span>
								<span class="post-meta-updated">Updated on <FormattedDate date={updatedDate} /></span>
							</>
						)}
					</div>
				</div>
				<MedicalDisclaimer />

				{showAudioReader && <AudioReader title={title} />}

				<div class="blog-layout-grid">
					<div class="post-content">
						<slot />
					</div>
				</div>
				<AuthorBox />
			</article>
		</main>
		<Footer />
		<style>
			.blog-post h1 {
				font-size: 2.25rem;
				line-height: 1.22;
				letter-spacing: -0.025em;
				color: var(--text-primary);
				font-weight: 800;
				margin: 1.5rem auto 1rem auto;
				max-width: var(--reading-max-width, 58ch);
				text-wrap: balance;
			}
			.post-meta {
				max-width: var(--reading-max-width, 58ch);
				margin: 0 auto 1.5rem auto;
				display: flex;
				align-items: center;
			}
			.post-meta-lockup {
				display: inline-flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.45rem 0.65rem;
				padding: 0.35rem 0.85rem;
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 8px;
				font-size: 0.85rem;
				color: #64748b;
				line-height: 1.4;
			}
			.post-entry-pill {
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.76rem;
				font-weight: 700;
				color: #0f172a;
				background: #e2e8f0;
				padding: 0.18rem 0.5rem;
				border-radius: 5px;
				letter-spacing: 0.01em;
				white-space: nowrap;
			}
			.post-meta-dot {
				color: #cbd5e1;
				font-weight: 700;
				user-select: none;
			}
			.post-meta-date {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				color: #475569;
				font-weight: 500;
				white-space: nowrap;
			}
			.post-meta-icon {
				color: #64748b;
				flex-shrink: 0;
			}
			.post-meta-updated {
				color: #64748b;
				font-weight: 400;
				font-size: 0.82rem;
				white-space: nowrap;
			}
			.blog-layout-grid {
				display: block;
				max-width: var(--reading-max-width, 58ch);
				margin: 1.5rem auto 0 auto;
				position: relative;
				transition: max-width 0.2s ease;
			}
			.post-content {
				width: 100%;
			}

			/* Section Headings */
			.post-content :global(h2) {
				margin: 3.5rem 0 1.5rem 0;
				padding: 0;
				border: none;
				background: transparent;
				font-size: 1.65rem;
				line-height: 1.3;
				color: var(--text-primary);
				font-weight: 800;
				text-wrap: balance;
			}

			@media (max-width: 580px) {
				.post-content :global(h2) {
					font-size: 1.35rem;
					line-height: 1.25;
					margin: 2.75rem 0 1.25rem 0;
				}
			}

			/* Book Showcase Content Box for Peggy Sharr's Survival Guide */
			.post-content :global(.book-showcase-card) {
				display: flex;
				flex-direction: column;
				align-items: center;
				width: 100%;
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 18px;
				padding: 2.25rem 2rem;
				margin: 3rem 0;
				box-shadow: none;
			}

			.post-content :global(.book-cover-container) {
				width: 100%;
				max-width: 440px;
				margin: 0 auto 1.5rem auto;
				display: flex;
				justify-content: center;
			}

			.post-content :global(.book-cover-link) {
				display: block;
				width: 100%;
				text-decoration: none;
				border: none;
				outline: none;
				transition: transform 0.2s ease, opacity 0.2s ease;
			}

			.post-content :global(.book-cover-link:hover) {
				transform: translateY(-2px);
				opacity: 0.95;
			}

			.post-content :global(.book-cover-image) {
				width: 100%;
				max-width: 420px;
				height: auto;
				display: block;
				margin: 0 auto;
				border: none;
				border-radius: 0;
				box-shadow: none;
				filter: none;
				background: transparent;
			}

			.post-content :global(.book-details) {
				width: 100%;
				max-width: 680px;
				margin: 0 auto;
				text-align: center;
			}

			.post-content :global(.book-title) {
				font-size: 1.45rem;
				font-weight: 800;
				color: var(--text-primary);
				margin: 0 0 0.35rem 0;
				line-height: 1.3;
				text-wrap: balance;
			}

			.post-content :global(.book-title a) {
				color: inherit;
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.post-content :global(.book-title a:hover) {
				color: var(--accent);
				text-decoration: none;
			}

			.post-content :global(.book-byline) {
				font-size: 0.95rem;
				font-weight: 600;
				color: #64748b;
				margin: 0 0 1rem 0;
			}

			.post-content :global(.book-summary) {
				font-size: 1.05rem;
				color: var(--text-secondary);
				line-height: 1.65;
				margin: 0 0 1.25rem 0;
				text-wrap: pretty;
			}

			.post-content :global(.book-action) {
				margin: 0.5rem 0 0 0;
			}

			.post-content :global(.book-site-link) {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 1rem;
				font-weight: 700;
				color: var(--accent);
				text-decoration: none;
				transition: opacity 0.2s ease, transform 0.2s ease;
			}

			.post-content :global(.book-site-link:hover) {
				text-decoration: none;
				opacity: 0.85;
				transform: translateX(2px);
			}
		</style>
	</body>
</html>
