---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { Image } from 'astro:assets';

interface Props extends CollectionEntry<'blog'>['data'] {
	headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, pubDate, updatedDate, heroImage, headings = [] } = Astro.props;

// Filter headings to only show h2 and h3
const toc = (headings || []).filter((h) => h.depth <= 3);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="post-container">
			<article class="blog-post">
				<div class="hero-image">
					{heroImage && typeof heroImage === 'string' ? (
						<img src={heroImage} alt={title} class="post-image" />
					) : (
						heroImage && <Image src={heroImage} alt={title} class="post-image" />
					)}
				</div>

				<h1>{title}</h1>

				<div class="post-meta">
					<span>Published on <FormattedDate date={pubDate} /></span>
					{
						updatedDate && (
							<span> • Updated on <FormattedDate date={updatedDate} /></span>
						)
					}
				</div>
				<MedicalDisclaimer />
				<div class="affiliate-notice">
					Notice: This site may contain affiliate links. If you make a purchase through these links, I may earn a modest commission at no extra cost to you, which helps support my ongoing research.
				</div>

				<div class="blog-layout-grid">
					<div class="post-content">
						<slot />
					</div>
				</div>
				<AuthorBox />
			</article>
		</main>
		<Footer />
		<style>
			.affiliate-notice {
				background: #ffffff;
				border: 1px solid var(--card-border);
				padding: 0.9rem 1.25rem;
				border-radius: 10px;
				margin-top: -1rem;
				margin-bottom: 2.5rem;
				font-size: 0.85rem;
				color: var(--text-secondary);
				font-style: italic;
				border-left: 3px solid var(--accent);
				box-shadow: var(--shadow-sm);
			}
			.blog-layout-grid {
				display: block;
				max-width: 700px;
				margin: 0 auto;
				position: relative;
			}
			.post-content {
				width: 100%;
			}
		</style>
	</body>
</html>
