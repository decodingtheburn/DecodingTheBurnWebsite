---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AudioReader from '../components/AudioReader.astro';
import { Image } from 'astro:assets';

interface Props extends CollectionEntry<'blog'>['data'] {
	headings?: { depth: number; slug: string; text: string }[];
	slug?: string;
	showAudioReader?: boolean;
}

const { title, description, pubDate, updatedDate, heroImage, headings = [], slug, showAudioReader = Boolean(slug) } = Astro.props;

// Filter headings to only show h2 and h3
const toc = (headings || []).filter((h) => h.depth <= 3);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="post-container">
			<article class="blog-post">
				<div class="hero-image">
					{heroImage && typeof heroImage === 'string' ? (
						<img src={heroImage} alt={title} class="post-image" />
					) : (
						heroImage && <Image src={heroImage} alt={title} class="post-image" />
					)}
				</div>

				<h1 set:html={title} />

				<div class="post-meta">
					<span>Published on <FormattedDate date={pubDate} /></span>
					{
						updatedDate && (
							<span> • Updated on <FormattedDate date={updatedDate} /></span>
						)
					}
				</div>
				<MedicalDisclaimer />

				{showAudioReader && <AudioReader title={title} />}

				<div class="blog-layout-grid">
					<div class="post-content">
						<slot />
					</div>
				</div>
				<AuthorBox />
			</article>
		</main>
		<Footer />
		<style>
			.blog-post h1 {
				font-size: 2.25rem;
				line-height: 1.22;
				letter-spacing: -0.025em;
				color: var(--text-primary);
				font-weight: 800;
				margin: 1.5rem auto 1rem auto;
				max-width: var(--reading-max-width, 58ch);
				text-wrap: balance;
			}
			.blog-layout-grid {
				display: block;
				max-width: var(--reading-max-width, 58ch);
				margin: 1.5rem auto 0 auto;
				position: relative;
				transition: max-width 0.2s ease;
			}
			.post-content {
				width: 100%;
			}

			/* Section Headings with Standalone 3x Right-Aligned Contextual Vector Emojis */
			.post-content :global(h2) {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1.5rem;
				margin: 3.5rem 0 1.5rem 0;
				padding: 0;
				border: none;
				background: transparent;
			}

			.post-content :global(h2 > span) {
				flex: 1 1 auto;
				min-width: 0;
				font-size: 1.65rem;
				line-height: 1.3;
				color: var(--text-primary);
				font-weight: 800;
				text-wrap: balance;
			}

			.post-content :global(.heading-emoji-3x) {
				flex: 0 0 3.25rem;
				width: 3.25rem;
				height: 3.25rem;
				object-fit: contain;
				display: block;
				margin: 0;
				padding: 0;
				background: transparent;
				border: none;
				box-shadow: none;
				filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.08));
			}

			@media (max-width: 580px) {
				.post-content :global(h2) {
					gap: 1rem;
					margin: 2.75rem 0 1.25rem 0;
				}
				.post-content :global(h2 > span) {
					font-size: 1.35rem;
					line-height: 1.25;
				}
				.post-content :global(.heading-emoji-3x) {
					flex: 0 0 2.5rem;
					width: 2.5rem;
					height: 2.5rem;
				}
			}

			/* Book Showcase Card for Peggy Sharr's Survival Guide */
			.post-content :global(.book-showcase-card) {
				display: flex;
				align-items: center;
				gap: 1.75rem;
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 16px;
				padding: 1.75rem;
				margin: 2.5rem 0;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}

			.post-content :global(.book-cover-container) {
				flex-shrink: 0;
				width: 145px;
			}

			.post-content :global(.book-cover-image) {
				width: 100%;
				height: auto;
				border-radius: 6px;
				box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
				display: block;
			}

			.post-content :global(.book-details) {
				flex: 1;
			}

			.post-content :global(.book-badge) {
				display: inline-block;
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--accent);
				margin-bottom: 0.35rem;
			}

			.post-content :global(.book-title) {
				font-size: 1.25rem;
				font-weight: 800;
				color: var(--text-primary);
				margin: 0 0 0.25rem 0;
				line-height: 1.3;
			}

			.post-content :global(.book-byline) {
				font-size: 0.88rem;
				font-weight: 600;
				color: #64748b;
				margin: 0 0 0.75rem 0;
			}

			.post-content :global(.book-summary) {
				font-size: 0.95rem;
				color: var(--text-secondary);
				line-height: 1.6;
				margin: 0;
			}

			@media (max-width: 600px) {
				.post-content :global(.book-showcase-card) {
					flex-direction: column;
					text-align: center;
				}
				.post-content :global(.book-cover-container) {
					width: 130px;
					margin: 0 auto;
				}
			}
		</style>
	</body>
</html>
