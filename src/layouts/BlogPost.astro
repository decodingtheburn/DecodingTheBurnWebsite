---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AudioReader from '../components/AudioReader.astro';
import GlossaryTooltip from '../components/GlossaryTooltip.astro';
import ShareStoryCTA from '../components/ShareStoryCTA.astro';
import { Image } from 'astro:assets';
import { getPostEntryNumber, sortPostsAscending } from '../utils/postUtils';

interface Props extends CollectionEntry<'blog'>['data'] {
	headings?: { depth: number; slug: string; text: string }[];
	slug?: string;
	showAudioReader?: boolean;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	headings = [],
	slug,
	showAudioReader = Boolean(slug),
	entryNumber,
	category,
	tags = [],
	draft = false,
} = Astro.props;

// Filter headings to only show h2 and h3
const toc = (headings || []).filter((h) => h.depth <= 3);

let postNumber = entryNumber;
if (!postNumber && slug) {
	const allPosts = await getCollection('blog', ({ data }) => !data.draft);
	const sorted = sortPostsAscending(allPosts);
	const current = allPosts.find((p) => p.id === slug);
	if (current) {
		postNumber = getPostEntryNumber(current, sorted);
	}
}
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} noindex={draft} />
	</head>

	<body>
		<Header />
		<main class="post-container">
			<article class="blog-post">
				<div class="hero-image">
					{heroImage && typeof heroImage === 'string' ? (
						<img src={heroImage} alt={title} class="post-image" />
					) : (
						heroImage && <Image src={heroImage} alt={title} class="post-image" />
					)}
				</div>

				<h1 set:html={title} />

				<div class="post-meta">
					<p class="post-meta-text">
						<span>Published on <FormattedDate date={pubDate} /></span>
						{postNumber && (
							<>
								<span class="post-meta-dot" aria-hidden="true">•</span>
								<span class="post-meta-entry">Post #{postNumber}</span>
							</>
						)}
						{updatedDate && (
							<>
								<span class="post-meta-dot" aria-hidden="true">•</span>
								<span class="post-meta-updated">Updated on <FormattedDate date={updatedDate} /></span>
							</>
						)}
					</p>
				</div>
				<MedicalDisclaimer />

				{showAudioReader && <AudioReader title={title} />}

				<div class="blog-layout-grid">
					<div class="post-content" id="blog-post-content">
						<slot />
					</div>
				</div>
				<AuthorBox />
				<ShareStoryCTA variant="end" />
				<GlossaryTooltip />
			</article>
		</main>
		<Footer />

		<!-- Slide-in Toast at 50% scroll -->
		<div id="story-slide-toast" class="story-slide-toast" role="complementary" aria-label="Share Your Story Prompt">
			<button class="slide-toast-close" id="slide-toast-close" aria-label="Dismiss">&times;</button>
			<div class="slide-toast-content">
				<div class="slide-toast-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect width="20" height="16" x="2" y="4" rx="2"></rect>
						<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
					</svg>
				</div>
				<div class="slide-toast-text">
					<strong class="slide-toast-title">Share Your BMS&nbsp;Story</strong>
					<p class="slide-toast-desc">What worked or didn't work for you? Every pattern helps the community.</p>
				</div>
			</div>
			<a href="/share-your-story" class="slide-toast-btn">
				<span>Send Your Story</span>
			</a>
		</div>

		<div id="image-lightbox" class="lightbox-modal" role="dialog" aria-modal="true" aria-label="Expanded Image">
			<button class="lightbox-close-btn" id="lightbox-close" aria-label="Close image">✕</button>
			<img id="lightbox-img" src="" alt="Enlarged view" />
		</div>

		<!-- Full-Screen Medical Disclaimer Modal (Toggled by Key 1) -->
		<div class="blog-disclaimer-overlay" id="blog-disclaimer-overlay" role="dialog" aria-modal="true" aria-labelledby="blog-disclaimer-title">
			<div class="blog-disclaimer-container">
				<button type="button" class="blog-disclaimer-close-btn" id="blog-disclaimer-close-btn" title="Close Disclaimer [1 or Esc]" aria-label="Close Disclaimer">&times;</button>
				
				<h2 class="blog-disclaimer-title" id="blog-disclaimer-title">Medical &amp; Research Disclaimer</h2>
				
				<p class="blog-disclaimer-text">
					I am sharing my personal lived experiences and self-experiments. I am a patient, not a doctor. Always consult your physician before trying anything&nbsp;new.
				</p>
			</div>
		</div>

		<script>
			function initLightbox() {
				const triggers = document.querySelectorAll('.zoomable-image-trigger');
				const modal = document.getElementById('image-lightbox');
				const modalImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
				const closeBtn = document.getElementById('lightbox-close');

				if (!modal || !modalImg) return;

				triggers.forEach((trigger) => {
					trigger.addEventListener('click', (e) => {
						e.preventDefault();
						const img = trigger.querySelector('img');
						if (img && modalImg) {
							modalImg.src = img.src;
							modalImg.alt = img.alt || 'Enlarged view';
							modal.classList.add('active');
							document.body.style.overflow = 'hidden';
						}
					});
				});

				function closeModal() {
					if (modal) {
						modal.classList.remove('active');
						document.body.style.overflow = '';
					}
				}

				if (closeBtn) closeBtn.addEventListener('click', closeModal);
				modal.addEventListener('click', (e) => {
					if (e.target === modal || e.target === closeBtn) {
						closeModal();
					}
				});

				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && modal.classList.contains('active')) {
						closeModal();
					}
				});
			}

			function initSlideToast() {
				const toast = document.getElementById('story-slide-toast');
				const closeBtn = document.getElementById('slide-toast-close');
				if (!toast) return;

				let dismissed = false;
				let shown = false;

				closeBtn?.addEventListener('click', () => {
					toast.classList.remove('visible');
					dismissed = true;
				});

				window.addEventListener('scroll', () => {
					if (dismissed || shown) return;

					const docHeight = document.documentElement.scrollHeight - window.innerHeight;
					if (docHeight <= 0) return;

					const scrollPercent = (window.scrollY / docHeight) * 100;
					if (scrollPercent >= 50) {
						toast.classList.add('visible');
						shown = true;
					}
				}, { passive: true });
			}

			function initTopicKeyboardNavigation() {
				// Gather all topic heading anchors in order
				function getTopics(): HTMLElement[] {
					const postContent = document.getElementById('blog-post-content');
					if (!postContent) return [];
					
					const selectors = 'h2, h3, .casebook-item, .tldr-card, .casebook-substep, .story-cta-card';
					const elements = Array.from(postContent.querySelectorAll<HTMLElement>(selectors));
					
					// Filter out hidden elements or nested sub-elements
					return elements.filter((el) => {
						const isVisible = el.offsetWidth > 0 && el.offsetHeight > 0;
						return isVisible;
					});
				}

				function navigateTopic(direction: 'next' | 'prev') {
					const topics = getTopics();
					if (topics.length === 0) return;

					const offsetMargin = 90; // Header clearance
					const currentScrollY = window.scrollY + offsetMargin;

					if (direction === 'next') {
						// Find first topic positioned strictly below current reading view
						const nextTopic = topics.find((el) => {
							const top = el.getBoundingClientRect().top + window.scrollY;
							return top > currentScrollY + 15;
						});

						if (nextTopic) {
							const targetY = nextTopic.getBoundingClientRect().top + window.scrollY - 80;
							window.scrollTo({ top: Math.max(0, targetY), behavior: 'smooth' });
						}
					} else {
						// Find previous topic strictly above current reading view
						const prevTopics = topics.filter((el) => {
							const top = el.getBoundingClientRect().top + window.scrollY;
							return top < currentScrollY - 15;
						});

						if (prevTopics.length > 0) {
							const prevTopic = prevTopics[prevTopics.length - 1];
							const targetY = prevTopic.getBoundingClientRect().top + window.scrollY - 80;
							window.scrollTo({ top: Math.max(0, targetY), behavior: 'smooth' });
						} else {
							// If at top topic, scroll to post headline
							window.scrollTo({ top: 0, behavior: 'smooth' });
						}
					}
				}

				window.addEventListener('keydown', (e: KeyboardEvent) => {
					// Never intercept keys when user is typing in forms or search boxes
					const activeTag = (document.activeElement?.tagName || '').toUpperCase();
					const isInputActive = ['INPUT', 'TEXTAREA', 'SELECT'].includes(activeTag) || (document.activeElement as HTMLElement)?.isContentEditable;
					if (isInputActive) return;

					// Don't intercept if modifier keys like Ctrl / Meta / Alt are pressed (unless Shift)
					if (e.ctrlKey || e.metaKey || e.altKey) return;

					// 1. Spacebar / Shift+Spacebar: Next / Prev topic
					// Check if audio reader is actively playing; if playing, let audio reader toggle pause
					const isAudioPlaying = (window as any).__ttsPlaybackState === 'PLAYING';

					if (e.code === 'Space' && !isAudioPlaying) {
						e.preventDefault();
						if (e.shiftKey) {
							navigateTopic('prev');
						} else {
							navigateTopic('next');
						}
					} else if (e.key === 'j' || e.key === 'J' || e.key === 'n' || e.key === 'N') {
						// Vi / Reader style shortcut: J or N for Next topic
						e.preventDefault();
						navigateTopic('next');
					} else if (e.key === 'k' || e.key === 'K' || e.key === 'p' || e.key === 'P') {
						// Vi / Reader style shortcut: K or P for Previous topic
						e.preventDefault();
						navigateTopic('prev');
					}
				});
			}

			function initDisclaimerModal() {
				const overlay = document.getElementById('blog-disclaimer-overlay');
				const closeBtn = document.getElementById('blog-disclaimer-close-btn');
				if (!overlay) return;

				function openModal() {
					overlay?.classList.add('active');
					document.body.style.overflow = 'hidden';
				}

				function closeModal() {
					overlay?.classList.remove('active');
					document.body.style.overflow = '';
				}

				function toggleModal() {
					if (overlay?.classList.contains('active')) {
						closeModal();
					} else {
						openModal();
					}
				}

				closeBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					closeModal();
				});

				overlay.addEventListener('click', (e) => {
					if (e.target === overlay) {
						closeModal();
					}
				});

				window.addEventListener('keydown', (e: KeyboardEvent) => {
					const activeTag = (document.activeElement?.tagName || '').toUpperCase();
					const isInputActive = ['INPUT', 'TEXTAREA', 'SELECT'].includes(activeTag) || (document.activeElement as HTMLElement)?.isContentEditable;
					if (isInputActive) return;
					if (e.ctrlKey || e.metaKey || e.altKey) return;

					if (e.code === 'Digit1' || e.code === 'Numpad1' || e.key === '1') {
						e.preventDefault();
						toggleModal();
					} else if (e.key === 'Escape' && overlay.classList.contains('active')) {
						e.preventDefault();
						closeModal();
					}
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', () => {
					initLightbox();
					initSlideToast();
					initTopicKeyboardNavigation();
					initDisclaimerModal();
				});
			} else {
				initLightbox();
				initSlideToast();
				initTopicKeyboardNavigation();
				initDisclaimerModal();
			}
		</script>
		<style>
			/* Full-Screen Medical Disclaimer Modal (Key 1 Toggle) */
			.blog-disclaimer-overlay {
				position: fixed;
				inset: 0;
				width: 100vw;
				height: 100vh;
				background: rgba(4, 6, 10, 0.94);
				backdrop-filter: blur(14px);
				display: none;
				align-items: center;
				justify-content: center;
				z-index: 9999;
				padding: clamp(1.5rem, 4vw, 3.5rem);
				box-sizing: border-box;
				animation: fadeInBlogDisclaimer 0.2s ease-out;
			}

			.blog-disclaimer-overlay.active {
				display: flex;
			}

			@keyframes fadeInBlogDisclaimer {
				from {
					opacity: 0;
					transform: scale(0.98);
				}
				to {
					opacity: 1;
					transform: scale(1);
				}
			}

			.blog-disclaimer-container {
				background: #0b0f17;
				border: 1.5px solid rgba(239, 68, 68, 0.45);
				border-radius: 16px;
				box-shadow: 0 30px 70px rgba(0, 0, 0, 0.9), 0 0 40px rgba(239, 68, 68, 0.12);
				max-width: 900px;
				width: 90vw;
				padding: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
				box-sizing: border-box;
				position: relative;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				gap: 2rem;
			}

			.blog-disclaimer-close-btn {
				position: absolute;
				top: 1.25rem;
				right: 1.25rem;
				background: rgba(255, 255, 255, 0.06);
				border: 1px solid rgba(255, 255, 255, 0.15);
				color: #cbd5e1;
				font-size: 1.6rem;
				width: 44px;
				height: 44px;
				border-radius: 8px;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: all 0.15s ease;
				line-height: 1;
			}

			.blog-disclaimer-close-btn:hover {
				background: rgba(239, 68, 68, 0.25);
				border-color: #ef4444;
				color: #ffffff;
			}

			.blog-disclaimer-title {
				font-family: var(--font-heading, system-ui, sans-serif);
				font-size: clamp(2rem, 3.8vw, 3rem);
				font-weight: 900;
				color: #ffffff;
				margin: 0;
				text-align: center;
				letter-spacing: -0.02em;
				text-wrap: balance;
			}

			.blog-disclaimer-text {
				font-size: clamp(1.35rem, 2.2vw, 1.85rem);
				line-height: 1.6;
				color: #f1f5f9;
				font-weight: 500;
				text-align: center;
				margin: 0;
				max-width: 780px;
				text-wrap: balance;
			}

			/* Slide-in Toast Notification at 50% scroll */
			.story-slide-toast {
				position: fixed;
				bottom: 24px;
				right: 24px;
				background: #0f172a;
				border: 1px solid rgba(239, 68, 68, 0.4);
				border-radius: 16px;
				padding: 1.15rem 1.35rem;
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
				max-width: 340px;
				width: calc(100vw - 32px);
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(239, 68, 68, 0.15);
				z-index: 1000;
				transform: translateY(120px) scale(0.95);
				opacity: 0;
				pointer-events: none;
				transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
			}

			.story-slide-toast.visible {
				transform: translateY(0) scale(1);
				opacity: 1;
				pointer-events: auto;
			}

			.slide-toast-close {
				position: absolute;
				top: 8px;
				right: 12px;
				background: transparent;
				border: none;
				color: #94a3b8;
				font-size: 1.4rem;
				line-height: 1;
				cursor: pointer;
				padding: 2px;
				transition: color 0.15s ease;
			}

			.slide-toast-close:hover {
				color: #ffffff;
			}

			.slide-toast-content {
				display: flex;
				align-items: flex-start;
				gap: 0.85rem;
			}

			.slide-toast-icon {
				width: 36px;
				height: 36px;
				border-radius: 50%;
				background: rgba(239, 68, 68, 0.15);
				color: #ef4444;
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
			}

			.slide-toast-icon svg {
				width: 18px;
				height: 18px;
			}

			.slide-toast-text {
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}

			.slide-toast-title {
				color: #ffffff;
				font-size: 0.95rem;
				font-weight: 700;
				line-height: 1.2;
			}

			.slide-toast-desc {
				color: #cbd5e1;
				font-size: 0.78rem;
				line-height: 1.35;
				margin: 0;
			}

			.slide-toast-btn {
				background: linear-gradient(135deg, #c8382c 0%, #991b1b 100%);
				color: #ffffff;
				font-size: 0.85rem;
				font-weight: 700;
				text-align: center;
				padding: 0.55rem 1rem;
				border-radius: 8px;
				text-decoration: none;
				transition: transform 0.15s ease, filter 0.15s ease;
			}

			.slide-toast-btn:hover {
				filter: brightness(1.1);
				transform: translateY(-1px);
			}
			.blog-post h1 {
				font-size: clamp(2.4rem, 5.2vw, 4.0rem);
				line-height: 1.14;
				letter-spacing: -0.035em;
				color: var(--text-primary);
				font-weight: 800;
				margin: 2rem auto 1.25rem auto;
				max-width: 920px;
				width: 100%;
				text-wrap: balance;
				text-align: center;
			}
			.post-meta {
				max-width: var(--reading-max-width, 58ch);
				margin: 0 auto 1.25rem auto;
				display: flex;
				justify-content: center;
			}
			.post-meta-text {
				font-size: 0.88rem;
				color: #000000;
				font-weight: 600;
				margin: 0;
				line-height: 1.5;
				display: flex;
				align-items: center;
				justify-content: center;
				flex-wrap: wrap;
				gap: 0.45rem;
				text-align: center;
			}
			.post-meta-entry {
				font-weight: 700;
				color: #000000;
			}
			.post-meta-dot {
				color: #000000;
				font-weight: 800;
				user-select: none;
			}
			.post-meta-updated {
				color: #000000;
				font-weight: 500;
				font-size: 0.85rem;
			}
			.blog-layout-grid {
				display: block;
				max-width: var(--reading-max-width, 58ch);
				margin: 1.5rem auto 0 auto;
				position: relative;
				transition: max-width 0.2s ease;
			}
			.post-content {
				width: 100%;
			}

			/* Section Headings */
			.post-content :global(h2) {
				margin: 3.5rem 0 1.5rem 0;
				padding: 0;
				border: none;
				background: transparent;
				font-size: 1.65rem;
				line-height: 1.3;
				color: var(--text-primary);
				font-weight: 800;
				text-wrap: balance;
			}

			@media (max-width: 580px) {
				.post-content :global(h2) {
					font-size: 1.35rem;
					line-height: 1.25;
					margin: 2.75rem 0 1.25rem 0;
				}
			}

			/* Book Showcase Content Box for Peggy Sharr's Survival Guide */
			.post-content :global(.book-showcase-card) {
				display: flex;
				flex-direction: column;
				align-items: center;
				width: 100%;
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 18px;
				padding: 2.25rem 2rem;
				margin: 3rem 0;
				box-shadow: none;
			}

			.post-content :global(.book-cover-container) {
				width: 100%;
				max-width: 440px;
				margin: 0 auto 1.5rem auto;
				display: flex;
				justify-content: center;
			}

			.post-content :global(.book-cover-link) {
				display: block;
				width: 100%;
				text-decoration: none;
				border: none;
				outline: none;
				transition: transform 0.2s ease, opacity 0.2s ease;
			}

			.post-content :global(.book-cover-link:hover) {
				transform: translateY(-2px);
				opacity: 0.95;
			}

			.post-content :global(.book-cover-image) {
				width: 100%;
				max-width: 420px;
				height: auto;
				display: block;
				margin: 0 auto;
				border: none;
				border-radius: 0;
				box-shadow: none;
				filter: none;
				background: transparent;
			}

			.post-content :global(.book-details) {
				width: 100%;
				max-width: 680px;
				margin: 0 auto;
				text-align: center;
			}

			.post-content :global(.book-title) {
				font-size: 1.45rem;
				font-weight: 800;
				color: var(--text-primary);
				margin: 0 0 0.35rem 0;
				line-height: 1.3;
				text-wrap: balance;
			}

			.post-content :global(.book-title a) {
				color: inherit;
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.post-content :global(.book-title a:hover) {
				color: var(--accent);
				text-decoration: none;
			}

			.post-content :global(.book-byline) {
				font-size: 0.95rem;
				font-weight: 600;
				color: #64748b;
				margin: 0 0 1rem 0;
			}

			.post-content :global(.book-summary) {
				font-size: 1.05rem;
				color: var(--text-secondary);
				line-height: 1.65;
				margin: 0 0 1.25rem 0;
				text-wrap: pretty;
			}

			.post-content :global(.book-action) {
				margin: 0.5rem 0 0 0;
			}

			.post-content :global(.book-site-link) {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 1rem;
				font-weight: 700;
				color: var(--accent);
				text-decoration: none;
				transition: opacity 0.2s ease, transform 0.2s ease;
			}

			.post-content :global(.book-site-link:hover) {
				text-decoration: none;
				opacity: 0.85;
				transform: translateX(2px);
			}

			/* TL;DR Executive Summary Card */
