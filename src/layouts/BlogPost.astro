---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AudioReader from '../components/AudioReader.astro';
import GlossaryTooltip from '../components/GlossaryTooltip.astro';
import { Image } from 'astro:assets';
import { getPostEntryNumber, sortPostsAscending } from '../utils/postUtils';

interface Props extends CollectionEntry<'blog'>['data'] {
	headings?: { depth: number; slug: string; text: string }[];
	slug?: string;
	showAudioReader?: boolean;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	headings = [],
	slug,
	showAudioReader = Boolean(slug),
	entryNumber,
	category,
	tags = [],
} = Astro.props;

// Filter headings to only show h2 and h3
const toc = (headings || []).filter((h) => h.depth <= 3);

let postNumber = entryNumber;
if (!postNumber && slug) {
	const allPosts = await getCollection('blog', ({ data }) => !data.draft);
	const sorted = sortPostsAscending(allPosts);
	const current = allPosts.find((p) => p.id === slug);
	if (current) {
		postNumber = getPostEntryNumber(current, sorted);
	}
}
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="post-container">
			<article class="blog-post">
				<div class="hero-image">
					{heroImage && typeof heroImage === 'string' ? (
						<img src={heroImage} alt={title} class="post-image" />
					) : (
						heroImage && <Image src={heroImage} alt={title} class="post-image" />
					)}
				</div>

				<h1 set:html={title} />

				<div class="post-meta">
					<p class="post-meta-text">
						<span>Published on <FormattedDate date={pubDate} /></span>
						{postNumber && (
							<>
								<span class="post-meta-dot" aria-hidden="true">•</span>
								<span class="post-meta-entry">Post #{postNumber}</span>
							</>
						)}
						{updatedDate && (
							<>
								<span class="post-meta-dot" aria-hidden="true">•</span>
								<span class="post-meta-updated">Updated on <FormattedDate date={updatedDate} /></span>
							</>
						)}
					</p>
				</div>
				<MedicalDisclaimer />

				{showAudioReader && <AudioReader title={title} />}

				<div class="blog-layout-grid">
					<div class="post-content">
						<slot />
					</div>
				</div>
				<AuthorBox />
				<GlossaryTooltip />
			</article>
		</main>
		<Footer />

		<div id="image-lightbox" class="lightbox-modal" role="dialog" aria-modal="true" aria-label="Expanded Image">
			<button class="lightbox-close-btn" id="lightbox-close" aria-label="Close image">✕</button>
			<img id="lightbox-img" src="" alt="Enlarged view" />
		</div>

		<script>
			function initLightbox() {
				const triggers = document.querySelectorAll('.zoomable-image-trigger');
				const modal = document.getElementById('image-lightbox');
				const modalImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
				const closeBtn = document.getElementById('lightbox-close');

				if (!modal || !modalImg) return;

				triggers.forEach((trigger) => {
					trigger.addEventListener('click', (e) => {
						e.preventDefault();
						const img = trigger.querySelector('img');
						if (img && modalImg) {
							modalImg.src = img.src;
							modalImg.alt = img.alt || 'Enlarged view';
							modal.classList.add('active');
							document.body.style.overflow = 'hidden';
						}
					});
				});

				function closeModal() {
					if (modal) {
						modal.classList.remove('active');
						document.body.style.overflow = '';
					}
				}

				if (closeBtn) closeBtn.addEventListener('click', closeModal);
				modal.addEventListener('click', (e) => {
					if (e.target === modal || e.target === closeBtn) {
						closeModal();
					}
				});

				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && modal.classList.contains('active')) {
						closeModal();
					}
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initLightbox);
			} else {
				initLightbox();
			}
		</script>
		<style>
			.blog-post h1 {
				font-size: 2.25rem;
				line-height: 1.22;
				letter-spacing: -0.025em;
				color: var(--text-primary);
				font-weight: 800;
				margin: 1.5rem auto 1rem auto;
				max-width: var(--reading-max-width, 58ch);
				text-wrap: balance;
			}
			.post-meta {
				max-width: var(--reading-max-width, 58ch);
				margin: 0 auto 1.25rem auto;
			}
			.post-meta-text {
				font-size: 0.88rem;
				color: #64748b;
				margin: 0;
				line-height: 1.5;
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.45rem;
			}
			.post-meta-entry {
				font-weight: 600;
				color: #475569;
			}
			.post-meta-dot {
				color: #cbd5e1;
				font-weight: 700;
				user-select: none;
			}
			.post-meta-updated {
				color: #64748b;
				font-weight: 400;
				font-size: 0.85rem;
			}
			.blog-layout-grid {
				display: block;
				max-width: var(--reading-max-width, 58ch);
				margin: 1.5rem auto 0 auto;
				position: relative;
				transition: max-width 0.2s ease;
			}
			.post-content {
				width: 100%;
			}

			/* Section Headings */
			.post-content :global(h2) {
				margin: 3.5rem 0 1.5rem 0;
				padding: 0;
				border: none;
				background: transparent;
				font-size: 1.65rem;
				line-height: 1.3;
				color: var(--text-primary);
				font-weight: 800;
				text-wrap: balance;
			}

			@media (max-width: 580px) {
				.post-content :global(h2) {
					font-size: 1.35rem;
					line-height: 1.25;
					margin: 2.75rem 0 1.25rem 0;
				}
			}

			/* Book Showcase Content Box for Peggy Sharr's Survival Guide */
			.post-content :global(.book-showcase-card) {
				display: flex;
				flex-direction: column;
				align-items: center;
				width: 100%;
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 18px;
				padding: 2.25rem 2rem;
				margin: 3rem 0;
				box-shadow: none;
			}

			.post-content :global(.book-cover-container) {
				width: 100%;
				max-width: 440px;
				margin: 0 auto 1.5rem auto;
				display: flex;
				justify-content: center;
			}

			.post-content :global(.book-cover-link) {
				display: block;
				width: 100%;
				text-decoration: none;
				border: none;
				outline: none;
				transition: transform 0.2s ease, opacity 0.2s ease;
			}

			.post-content :global(.book-cover-link:hover) {
				transform: translateY(-2px);
				opacity: 0.95;
			}

			.post-content :global(.book-cover-image) {
				width: 100%;
				max-width: 420px;
				height: auto;
				display: block;
				margin: 0 auto;
				border: none;
				border-radius: 0;
				box-shadow: none;
				filter: none;
				background: transparent;
			}

			.post-content :global(.book-details) {
				width: 100%;
				max-width: 680px;
				margin: 0 auto;
				text-align: center;
			}

			.post-content :global(.book-title) {
				font-size: 1.45rem;
				font-weight: 800;
				color: var(--text-primary);
				margin: 0 0 0.35rem 0;
				line-height: 1.3;
				text-wrap: balance;
			}

			.post-content :global(.book-title a) {
				color: inherit;
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.post-content :global(.book-title a:hover) {
				color: var(--accent);
				text-decoration: none;
			}

			.post-content :global(.book-byline) {
				font-size: 0.95rem;
				font-weight: 600;
				color: #64748b;
				margin: 0 0 1rem 0;
			}

			.post-content :global(.book-summary) {
				font-size: 1.05rem;
				color: var(--text-secondary);
				line-height: 1.65;
				margin: 0 0 1.25rem 0;
				text-wrap: pretty;
			}

			.post-content :global(.book-action) {
				margin: 0.5rem 0 0 0;
			}

			.post-content :global(.book-site-link) {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 1rem;
				font-weight: 700;
				color: var(--accent);
				text-decoration: none;
				transition: opacity 0.2s ease, transform 0.2s ease;
			}

			.post-content :global(.book-site-link:hover) {
				text-decoration: none;
				opacity: 0.85;
				transform: translateX(2px);
			}

			/* TL;DR Executive Summary Card */
			.post-content :global(.tldr-card) {
				background: linear-gradient(135deg, #faf5ff 0%, #f5f3ff 100%);
				border: 1px solid #e9d5ff;
				border-left: 4px solid #7c3aed;
				border-radius: 14px;
				padding: 1.35rem 1.65rem;
				margin: 1.75rem 0 2.25rem 0;
				box-shadow: 0 4px 18px -4px rgba(124, 58, 237, 0.08);
			}

			.post-content :global(.tldr-header) {
				display: flex;
				align-items: center;
				gap: 0.55rem;
				margin-bottom: 0.75rem;
			}

			.post-content :global(.tldr-badge) {
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.75rem;
				font-weight: 800;
				color: #ffffff;
				background: #7c3aed;
				padding: 0.18rem 0.55rem;
				border-radius: 4px;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}

			.post-content :global(.tldr-title) {
				font-size: 1.08rem;
				font-weight: 800;
				color: #0f172a;
				margin: 0;
				letter-spacing: -0.015em;
			}

			.post-content :global(.tldr-list) {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 0.55rem;
			}

			.post-content :global(.tldr-list li) {
				position: relative;
				padding-left: 1.4rem;
				font-size: 0.94rem;
				line-height: 1.6;
				color: #334155;
				text-wrap: pretty;
			}

			.post-content :global(.tldr-list li::before) {
				content: "◆";
				position: absolute;
				left: 0;
				top: 0.08rem;
				font-size: 0.68rem;
				color: #7c3aed;
			}

			.post-content :global(.tldr-list strong) {
				color: #0f172a;
				font-weight: 700;
			}

			/* Mission Callout Card with 3D Emoji */
			.post-content :global(.mission-callout-box) {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1.5rem;
				background: linear-gradient(135deg, #fff1f2 0%, #fff7ed 100%);
				border: 1px solid #fecdd3;
				border-left: 5px solid #be123c;
				border-radius: 14px;
				padding: 1.35rem 1.75rem;
				margin: 2.25rem 0;
				box-shadow: 0 4px 16px -4px rgba(190, 18, 60, 0.1);
			}

			.post-content :global(.mission-content-col) {
				flex: 1;
				min-width: 0;
			}

			.post-content :global(.mission-tag-pill) {
				display: inline-block;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.72rem;
				font-weight: 700;
				color: #be123c;
				background: #ffffff;
				border: 1px solid #fecdd3;
				padding: 0.15rem 0.55rem;
				border-radius: 4px;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				margin-bottom: 0.5rem;
			}

			.post-content :global(.mission-callout-text) {
				font-size: 1.05rem;
				line-height: 1.55;
				color: #881337;
				font-weight: 600;
				margin: 0;
				text-wrap: pretty;
			}

			.post-content :global(.mission-emoji-col) {
				flex-shrink: 0;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.post-content :global(.mission-3d-emoji) {
				font-size: 3.5rem;
				line-height: 1;
				display: inline-block;
				filter: drop-shadow(0 6px 14px rgba(190, 18, 60, 0.28));
				transform: scale(1.05) rotate(-4deg);
				transition: transform 0.3s ease;
				user-select: none;
			}

			.post-content :global(.mission-callout-box:hover .mission-3d-emoji) {
				transform: scale(1.15) rotate(0deg);
			}

			@media (max-width: 580px) {
				.post-content :global(.mission-callout-box) {
					flex-direction: column-reverse;
					align-items: flex-start;
					gap: 1rem;
					padding: 1.25rem 1.25rem;
				}

				.post-content :global(.mission-3d-emoji) {
					font-size: 2.75rem;
				}
			}

			/* Physician Disclaimer Box */
			.post-content :global(.physician-disclaimer-box) {
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-left: 4px solid #64748b;
				border-radius: 10px;
				padding: 1.15rem 1.4rem;
				margin: 1.75rem 0;
			}

			.post-content :global(.physician-disclaimer-box p) {
				margin: 0;
				font-size: 0.92rem;
				color: #475569;
				line-height: 1.6;
				text-wrap: pretty;
			}

			.post-content :global(.physician-disclaimer-box strong) {
				color: #0f172a;
				font-weight: 700;
			}

			/* ============================================================
			   MINIMALIST EDITORIAL CASEBOOK (Stripe Press / NYT Magazine)
			   ============================================================ */
			.post-content :global(.casebook-timeline) {
				position: relative;
				margin: 3rem 0 2rem 0;
				padding-left: 2.75rem;
			}

			/* Milestone Item */
			.post-content :global(.casebook-item) {
				position: relative;
				margin-bottom: 2.75rem;
			}

			.post-content :global(.casebook-item:last-child) {
				margin-bottom: 1.5rem;
			}

			/* Step Marker Node - Unified Brand Purple */
			.post-content :global(.casebook-node) {
				position: absolute;
				left: -2.75rem;
				top: 0.15rem;
				width: 1.95rem;
				height: 1.95rem;
				border-radius: 50%;
				background: #faf5ff;
				border: 1.5px solid #a855f7;
				display: flex;
				align-items: center;
				justify-content: center;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.72rem;
				font-weight: 700;
				color: #7c3aed;
				box-shadow: 0 1px 3px rgba(124, 58, 237, 0.12);
				z-index: 1;
			}

			/* Header */
			.post-content :global(.casebook-eyebrow) {
				display: block;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: #64748b;
				margin-bottom: 0.25rem;
			}

			.post-content :global(.casebook-title) {
				font-size: 1.28rem;
				font-weight: 800;
				color: #0f172a;
				line-height: 1.35;
				letter-spacing: -0.02em;
				margin: 0 0 0.75rem 0;
			}

			/* Narrative intro paragraph (larger prominent font) */
			.post-content :global(.casebook-narrative) {
				font-size: 1.125rem;
				line-height: 1.75;
				color: #1e293b;
				margin: 0 0 1rem 0;
				text-wrap: pretty;
			}

			/* Outcome / Finding (Plain Typographic, No Background, No Box) */
			.post-content :global(.casebook-outcome) {
				margin-top: 0.85rem;
				padding: 0;
			}

			.post-content :global(.casebook-outcome-title) {
				font-size: 0.95rem;
				font-weight: 800;
				letter-spacing: -0.01em;
				color: #7c3aed;
				margin: 0 0 0.35rem 0;
			}

			.post-content :global(.casebook-outcome-text) {
				font-size: 0.96rem;
				line-height: 1.65;
				color: #475569;
				margin: 0;
				text-wrap: pretty;
			}

			/* Zoomable Image / Lightbox Container - Branded Subtle Background & Border Accent */
			.post-content :global(.zoomable-image-container) {
				margin: 1.5rem 0;
				border-radius: 12px;
				overflow: hidden;
				border: none;
				border-top: 3px solid #7c3aed;
				border-bottom: 3px solid #7c3aed;
				background: #faf5ff;
				box-shadow: 0 4px 18px -2px rgba(124, 58, 237, 0.08);
			}

			.post-content :global(.zoomable-image-trigger) {
				display: block;
				position: relative;
				cursor: zoom-in;
				margin: 0;
				padding: 0;
			}

			.post-content :global(.zoomable-image-trigger img) {
				width: 100%;
				height: auto;
				display: block;
				border-radius: 9px;
				transition: transform 0.25s ease, filter 0.25s ease;
			}

			.post-content :global(.zoomable-image-trigger:hover img) {
				filter: brightness(1.03);
			}

			/* Supplement Clean Diamond Bullet Lists */
			.post-content :global(.supplement-section-block) {
				margin: 1.5rem 0 2rem 0;
			}

			.post-content :global(.supplement-cat-title) {
				font-size: 1.05rem;
				font-weight: 800;
				color: #0f172a;
				margin: 1.25rem 0 0.5rem 0;
				letter-spacing: -0.015em;
			}

			.post-content :global(.supplement-diamond-list) {
				list-style: none;
				padding-left: 0;
				margin: 0 0 1.25rem 0;
			}

			.post-content :global(.supplement-diamond-list li) {
				position: relative;
				padding-left: 1.35rem;
				margin-bottom: 0.4rem;
				font-size: 0.98rem;
				line-height: 1.6;
				color: #334155;
				text-wrap: pretty;
			}

			.post-content :global(.supplement-diamond-list li::before) {
				content: "◆";
				position: absolute;
				left: 0;
				top: 0.05rem;
				font-size: 0.68rem;
				color: #be123c; /* Brand pink / rose-red */
			}

			/* Casebook Plain Text Subsections */
			.post-content :global(.casebook-plain-section) {
				margin-top: 1.25rem;
				padding-top: 0.75rem;
			}

			.post-content :global(.casebook-plain-section .casebook-outcome-title) {
				margin-top: 1.15rem;
				margin-bottom: 0.35rem;
			}

			.post-content :global(.casebook-plain-section .casebook-narrative) {
				margin-bottom: 0.85rem;
			}

			.post-content :global(.casebook-item.state-breakthrough .casebook-outcome-title) {
				color: #7c3aed;
			}

			/* Lightbox modal overlay */
			.lightbox-modal {
				position: fixed;
				inset: 0;
				background: rgba(15, 23, 42, 0.92);
				backdrop-filter: blur(8px);
				z-index: 9999;
				display: none;
				align-items: center;
				justify-content: center;
				padding: 1.5rem;
				cursor: zoom-out;
			}

			.lightbox-modal.active {
				display: flex;
			}

			.lightbox-modal img {
				max-width: 95vw;
				max-height: 90vh;
				object-fit: contain;
				border-radius: 8px;
				box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
				cursor: default;
			}

			.lightbox-close-btn {
				position: absolute;
				top: 1.5rem;
				right: 1.5rem;
				background: rgba(255, 255, 255, 0.15);
				border: 1px solid rgba(255, 255, 255, 0.3);
				color: #ffffff;
				font-size: 1.5rem;
				line-height: 1;
				width: 2.75rem;
				height: 2.75rem;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: background 0.2s ease, transform 0.2s ease;
			}

			.lightbox-close-btn:hover {
				background: rgba(255, 255, 255, 0.3);
				transform: scale(1.08);
			}

			/* Breakthrough Obsidian Master Card */
			.post-content :global(.casebook-breakthrough-box) {
				background: linear-gradient(145deg, #090d16 0%, #15102a 100%);
				color: #f8fafc;
				border: 1px solid rgba(168, 85, 247, 0.3);
				border-radius: 18px;
				padding: 2.25rem 2.5rem;
				margin: 3.5rem 0 2rem 0;
				box-shadow: 0 16px 40px -8px rgba(15, 23, 42, 0.35);
			}

			.post-content :global(.casebook-breakthrough-box h3) {
				color: #ffffff;
				font-size: 1.5rem;
				font-weight: 800;
				margin: 0 0 1rem 0;
				letter-spacing: -0.025em;
			}

			.post-content :global(.casebook-breakthrough-box p) {
				color: #cbd5e1;
				font-size: 1.02rem;
				line-height: 1.7;
				margin: 0 0 1.5rem 0;
				text-wrap: pretty;
			}

			.post-content :global(.logic-grid) {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 1.25rem;
				margin-top: 1.5rem;
			}

