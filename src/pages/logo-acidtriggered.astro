---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Acid Triggered Logo Exploration | Design Studio" 
			description="Logo design studio exploring 24 brand concepts for Acid Triggered. Featuring chemical pH indicators, molecular sparks, electrical trigger spikes, and precision medical typography." 
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Figtree:wght@700;800;900&family=Outfit:wght@700;800;900&family=Plus+Jakarta+Sans:wght@700;800;900&family=Syne:wght@700;800;900&family=Urbanist:wght@800;900&display=swap" rel="stylesheet">
		<style>
			:root {
				--acid-citron: #eab308;
				--acid-lime: #84cc16;
				--acid-neon: #a3e635;
				--flame-orange: #f97316;
				--flame-red: #ef4444;
				--flame-crimson: #dc2626;
				--deep-slate: #050811;
			}

			.logo-studio-body {
				background-color: #030712;
				color: #f1f5f9;
				margin: 0;
				font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
			}

			.studio-header {
				text-align: center;
				padding: 3.5rem 1.5rem 2rem;
				max-width: 900px;
				margin: 0 auto;
			}

			.studio-title {
				font-size: clamp(2.2rem, 4vw, 3.2rem);
				font-weight: 900;
				letter-spacing: -0.03em;
				margin-bottom: 0.8rem;
				text-wrap: balance;
				background: linear-gradient(135deg, #a3e635 0%, #facc15 45%, #ef4444 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.studio-subtitle {
				font-size: 1.1rem;
				color: #94a3b8;
				line-height: 1.6;
				margin: 0 auto 1.5rem;
				text-wrap: balance;
				max-width: 680px;
			}

			.studio-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
				gap: 2rem;
				max-width: 1400px;
				margin: 0 auto;
				padding: 1rem 1.5rem 5rem;
			}

			.concept-card {
				background: #090d16;
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 16px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
			}

			.concept-card:hover {
				transform: translateY(-3px);
				border-color: rgba(234, 179, 8, 0.4);
				box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
			}

			.card-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 1rem 1.25rem 0.75rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
			}

			.concept-id {
				font-size: 0.8rem;
				font-weight: 800;
				letter-spacing: 0.05em;
				color: #eab308;
			}

			.concept-style {
				font-size: 0.82rem;
				color: #94a3b8;
				font-weight: 600;
			}

			.card-stage {
				min-height: 190px;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 2.2rem 1.5rem;
				background: radial-gradient(circle at center, #0e1526 0%, #030712 100%);
			}

			.canvas-pitch {
				background: #000000 !important;
			}

			.canvas-light {
				background: #f8fafc !important;
			}

			.card-footer {
				padding: 0.9rem 1.25rem;
				font-size: 0.85rem;
				color: #94a3b8;
				line-height: 1.45;
				border-top: 1px solid rgba(255, 255, 255, 0.05);
				background: rgba(0, 0, 0, 0.25);
			}
		</style>
	</head>
	<body class="logo-studio-body">
		<Header />

		<main>
			<header class="studio-header">
				<h1 class="studio-title">Acid Triggered Logo Exploration</h1>
				<p class="studio-subtitle">
					24 brand identities exploring chemical pH triggers, neural electric sparks, calibrated typography, and responsive favicons.
				</p>
			</header>

			<div class="studio-grid">

				<!-- Concept 1: The Chemical Catalyst (pH Drop to Nerve Fire) -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 1</span>
						<span class="concept-style">The Chemical Catalyst (Two-Tone Bold Sans)</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; align-items: baseline; gap: 0.35rem; font-family: 'Plus Jakarta Sans', sans-serif;">
							<span style="font-size: 2.5rem; font-weight: 900; letter-spacing: -0.04em; color: #a3e635; line-height: 1;">Acid</span>
							<span style="font-size: 2.5rem; font-weight: 900; letter-spacing: -0.04em; color: #ef4444; line-height: 1;">Triggered</span>
						</div>
					</div>
					<div class="card-footer">
						Pure typographic impact: Bio-acid lime green (#a3e635) contrasting directly with inflammatory red (#ef4444).
					</div>
				</article>

				<!-- Concept 2: The Spark Lightning Incline -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 2</span>
						<span class="concept-style">Electric Trigger Lightning Glyph</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; align-items: center; gap: 0.75rem; font-family: 'Plus Jakarta Sans', sans-serif;">
							<div style="width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, #a3e635 0%, #ef4444 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(239,68,68,0.4);">
								<svg viewBox="0 0 24 24" width="22" height="22" fill="#ffffff">
									<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
								</svg>
							</div>
							<div style="display: flex; flex-direction: column; line-height: 1;">
								<span style="font-size: 1.6rem; font-weight: 900; letter-spacing: -0.03em; color: #ffffff;">ACID</span>
								<span style="font-size: 1.25rem; font-weight: 800; letter-spacing: 0.08em; color: #ef4444;">TRIGGERED</span>
							</div>
						</div>
					</div>
					<div class="card-footer">
						Neural spike icon: Represents ion channels (ASIC3) tripping an instantaneous electric pain response.
					</div>
				</article>

				<!-- Concept 3: The Chemical Formula Lockup (H+) -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 3</span>
						<span class="concept-style">Proton Ion Badge (H+)</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; align-items: center; gap: 0.65rem; font-family: 'Outfit', sans-serif;">
							<span style="font-size: 2.3rem; font-weight: 900; letter-spacing: -0.03em; color: #ffffff;">Acid</span>
							<span style="display: inline-flex; align-items: center; justify-content: center; background: #ef4444; color: #ffffff; font-size: 0.75rem; font-weight: 900; padding: 0.15rem 0.45rem; border-radius: 6px; transform: translateY(-0.6rem);">H+</span>
							<span style="font-size: 2.3rem; font-weight: 900; letter-spacing: -0.03em; color: #ef4444;">Triggered</span>
						</div>
					</div>
					<div class="card-footer">
						Medical authenticity: The hydrogen proton badge (H+) represents acid chemistry activating peripheral nerves.
					</div>
				</article>

				<!-- Concept 4: The pH Gradient Meter -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 4</span>
						<span class="concept-style">Thermal pH Diagnostic Gradient</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; flex-direction: column; align-items: center; gap: 0.35rem; font-family: 'Plus Jakarta Sans', sans-serif;">
							<div style="font-size: 2.4rem; font-weight: 900; letter-spacing: -0.03em; background: linear-gradient(90deg, #a3e635 0%, #facc15 35%, #f97316 70%, #dc2626 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; line-height: 1;">
								AcidTriggered
							</div>
							<div style="width: 100%; height: 4px; border-radius: 9999px; background: linear-gradient(90deg, #a3e635 0%, #facc15 35%, #f97316 70%, #dc2626 100%);"></div>
						</div>
					</div>
					<div class="card-footer">
						One seamless wordmark showing the continuous shift from neutral pH green into acute inflammatory red.
					</div>
				</article>

				<!-- Concept 5: The Acid Drop Flare Icon -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 5</span>
						<span class="concept-style">Acid Droplet / Ignition Flare Symbol</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; align-items: center; gap: 0.85rem; font-family: 'Plus Jakarta Sans', sans-serif;">
							<svg viewBox="0 0 32 32" width="38" height="38">
								<defs>
									<linearGradient id="drop-grad" x1="0" y1="0" x2="0" y2="1">
										<stop offset="0%" stop-color="#bef264"/>
										<stop offset="60%" stop-color="#f59e0b"/>
										<stop offset="100%" stop-color="#ef4444"/>
									</linearGradient>
								</defs>
								<path d="M16 3 C16 3 6 15 6 22 C6 27.5 10.5 31 16 31 C21.5 31 26 27.5 26 22 C26 15 16 3 16 3 Z" fill="url(#drop-grad)"/>
								<circle cx="16" cy="22" r="3.5" fill="#ffffff" opacity="0.9"/>
							</svg>
							<div style="display: flex; align-items: baseline; gap: 0.3rem;">
								<span style="font-size: 2.2rem; font-weight: 900; letter-spacing: -0.03em; color: #ffffff;">Acid</span>
								<span style="font-size: 2.2rem; font-weight: 900; letter-spacing: -0.03em; color: #f97316;">Triggered</span>
							</div>
						</div>
					</div>
					<div class="card-footer">
						Droplet symbol transitioning from chemical lime to flame orange, with a reactive core.
					</div>
				</article>

				<!-- Concept 6: Precision Medical Serif & Sans -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 6</span>
						<span class="concept-style">Editorial Medical Journal Aesthetic</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; align-items: baseline; gap: 0.45rem;">
							<span style="font-family: 'Cinzel', serif; font-size: 2.1rem; font-weight: 900; letter-spacing: 0.02em; color: #ffffff;">ACID</span>
							<span style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2.1rem; font-weight: 800; letter-spacing: -0.03em; color: #ef4444;">TRIGGERED</span>
						</div>
					</div>
					<div class="card-footer">
						High scientific gravitas: Authoritative medical serif "ACID" paired with modern bold sans "TRIGGERED".
					</div>
				</article>

				<!-- Concept 7: The Target / Crosshair Reflex -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 7</span>
						<span class="concept-style">Trigger Target Lockup</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; align-items: center; gap: 0.65rem; font-family: 'Plus Jakarta Sans', sans-serif;">
							<span style="font-size: 2.4rem; font-weight: 900; letter-spacing: -0.04em; color: #ffffff;">Acid</span>
							<div style="position: relative; display: inline-flex; align-items: center;">
								<span style="font-size: 2.4rem; font-weight: 900; letter-spacing: -0.04em; color: #ef4444;">Triggered</span>
								<svg viewBox="0 0 24 24" width="18" height="18" style="position: absolute; right: -22px; top: -6px;" fill="none" stroke="#ef4444" stroke-width="2.5">
									<circle cx="12" cy="12" r="8"/>
									<line x1="12" y1="2" x2="12" y2="6"/>
									<line x1="12" y1="18" x2="12" y2="22"/>
									<line x1="2" y1="12" x2="6" y2="12"/>
									<line x1="18" y1="12" x2="22" y2="12"/>
								</svg>
							</div>
						</div>
					</div>
					<div class="card-footer">
						Precision target reticle indicating identification and isolation of specific chemical triggers.
					</div>
				</article>

				<!-- Concept 8: The "AT" Monogram Emblem (Favicon Ready) -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 8</span>
						<span class="concept-style">The "AT" Interlocking Monogram Emblem</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; align-items: center; gap: 1rem; font-family: 'Plus Jakarta Sans', sans-serif;">
							<!-- AT Badge -->
							<div style="width: 54px; height: 54px; border-radius: 14px; background: #0c1222; border: 2px solid rgba(255,255,255,0.12); display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(0,0,0,0.4);">
								<span style="font-size: 1.9rem; font-weight: 900; letter-spacing: -0.07em; line-height: 1;">
									<span style="color: #a3e635;">A</span><span style="color: #ef4444;">T</span>
								</span>
							</div>
							<div style="display: flex; flex-direction: column; line-height: 1;">
								<span style="font-size: 1.7rem; font-weight: 900; letter-spacing: -0.03em; color: #ffffff;">Acid</span>
								<span style="font-size: 1.7rem; font-weight: 900; letter-spacing: -0.03em; color: #ef4444;">Triggered</span>
							</div>
						</div>
					</div>
					<div class="card-footer">
						Versatile emblem system: The AT square icon scales down cleanly to a 16px/32px favicon or mobile app icon.
					</div>
				</article>

				<!-- Concept 9: The Pulse Spike (Cardiogram/Electrophysiology) -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 9</span>
						<span class="concept-style">Electrophysiology Nerve Spike</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; flex-direction: column; align-items: center; gap: 0.2rem; font-family: 'Outfit', sans-serif;">
							<div style="display: flex; align-items: baseline; gap: 0.35rem;">
								<span style="font-size: 2.3rem; font-weight: 900; color: #ffffff;">Acid</span>
								<span style="font-size: 2.3rem; font-weight: 900; color: #ef4444;">Triggered</span>
							</div>
							<svg viewBox="0 0 160 18" width="160" height="18" fill="none" stroke-width="2.5">
								<path d="M 0 9 L 60 9 L 70 2 L 78 16 L 86 4 L 94 13 L 100 9 L 160 9" stroke="#ef4444" stroke-linecap="round"/>
							</svg>
						</div>
					</div>
					<div class="card-footer">
						Depicts the electrical action potential spike generated when acids trigger trigeminal nociceptors.
					</div>
				</article>

				<!-- Concept 10: Deep Citron & Fiery Red High Contrast -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 10</span>
						<span class="concept-style">Citron Gold & Pure Vermillion</span>
					</div>
					<div class="card-stage canvas-pitch">
						<div style="display: flex; align-items: baseline; gap: 0.35rem; font-family: 'Plus Jakarta Sans', sans-serif;">
							<span style="font-size: 2.5rem; font-weight: 900; letter-spacing: -0.03em; color: #facc15; line-height: 1;">Acid</span>
							<span style="font-size: 2.5rem; font-weight: 900; letter-spacing: -0.03em; color: #dc2626; line-height: 1;">Triggered</span>
						</div>
					</div>
					<div class="card-footer">
						Deep pitch black canvas: Citron yellow (#facc15) evokes citrus/acidic bite, burning vermillion (#dc2626) denotes pain.
					</div>
				</article>

				<!-- Concept 11: The Downward pH Arrow Shift -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 11</span>
						<span class="concept-style">Integrated pH Drop Vector</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; align-items: center; gap: 0.45rem; font-family: 'Plus Jakarta Sans', sans-serif;">
							<div style="display: inline-flex; align-items: center; gap: 0.2rem;">
								<span style="font-size: 2.4rem; font-weight: 900; color: #a3e635; line-height: 1;">Acid</span>
								<svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="#a3e635" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
									<line x1="8" y1="2" x2="8" y2="14"/>
									<polyline points="3 9 8 14 13 9"/>
								</svg>
							</div>
							<span style="font-size: 2.4rem; font-weight: 900; color: #ef4444; line-height: 1;">Triggered</span>
						</div>
					</div>
					<div class="card-footer">
						Downward green arrow signifies rapid pH drop (acidification), which activates the trigger cascade.
					</div>
				</article>

				<!-- Concept 12: The Clean Monochrome Slate (Clinical Minimalism) -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 12</span>
						<span class="concept-style">Clinical Monochrome & Red Accent</span>
					</div>
					<div class="card-stage canvas-pitch">
						<div style="display: flex; align-items: baseline; gap: 0.4rem; font-family: 'Plus Jakarta Sans', sans-serif;">
							<span style="font-size: 2.5rem; font-weight: 900; letter-spacing: -0.04em; color: #f8fafc; line-height: 1;">Acid</span>
							<span style="font-size: 2.5rem; font-weight: 900; letter-spacing: -0.04em; color: #ef4444; line-height: 1;">Triggered</span>
							<span style="width: 8px; height: 8px; border-radius: 9999px; background: #ef4444; display: inline-block;"></span>
						</div>
					</div>
					<div class="card-footer">
						Understated, modern laboratory aesthetic with a single terminal trigger dot in clinical red.
					</div>
				</article>

				<!-- Concept 13: The Biohazard Caution Ring -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 13</span>
						<span class="concept-style">Chemical Reaction Hexagon</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; align-items: center; gap: 0.75rem; font-family: 'Plus Jakarta Sans', sans-serif;">
							<svg viewBox="0 0 36 36" width="38" height="38">
								<polygon points="18,3 32,10.5 32,25.5 18,33 4,25.5 4,10.5" fill="none" stroke="#eab308" stroke-width="2.5"/>
								<path d="M18 9 L18 22 M18 26 L18 27" stroke="#ef4444" stroke-width="3" stroke-linecap="round"/>
							</svg>
							<div style="display: flex; flex-direction: column; line-height: 1;">
								<span style="font-size: 1.55rem; font-weight: 900; color: #eab308; letter-spacing: -0.02em;">ACID</span>
								<span style="font-size: 1.55rem; font-weight: 900; color: #ef4444; letter-spacing: -0.02em;">TRIGGERED</span>
							</div>
						</div>
					</div>
					<div class="card-footer">
						Benzene molecular ring with internal warning indicator representing chemical bio-irritants.
					</div>
				</article>

				<!-- Concept 14: Futuristic High-Tech Tech/Biotech -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 14</span>
						<span class="concept-style">Modern Biotech Syne Geometry</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; align-items: baseline; gap: 0.35rem; font-family: 'Syne', sans-serif;">
							<span style="font-size: 2.3rem; font-weight: 800; letter-spacing: -0.02em; color: #ffffff;">Acid</span>
							<span style="font-size: 2.3rem; font-weight: 800; letter-spacing: -0.02em; color: #f97316;">Triggered</span>
						</div>
					</div>
					<div class="card-footer">
						Expansive, modern European biotech typography with wide tracking and deep orange ignition.
					</div>
				</article>

				<!-- Concept 15: The Nerve Axon Cutaway -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 15</span>
						<span class="concept-style">Trigeminal Axon Cutaway Symbol</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; align-items: center; gap: 0.8rem; font-family: 'Plus Jakarta Sans', sans-serif;">
							<div style="width: 40px; height: 40px; border-radius: 9999px; border: 2.5px solid #a3e635; display: flex; align-items: center; justify-content: center; position: relative;">
								<div style="width: 14px; height: 14px; border-radius: 9999px; background: #ef4444; box-shadow: 0 0 10px rgba(239,68,68,0.8);"></div>
								<div style="position: absolute; right: -4px; top: -4px; width: 8px; height: 8px; border-radius: 9999px; background: #facc15;"></div>
							</div>
							<div style="display: flex; align-items: baseline; gap: 0.3rem;">
								<span style="font-size: 2.2rem; font-weight: 900; letter-spacing: -0.03em; color: #ffffff;">Acid</span>
								<span style="font-size: 2.2rem; font-weight: 900; letter-spacing: -0.03em; color: #ef4444;">Triggered</span>
							</div>
						</div>
					</div>
					<div class="card-footer">
						Cross-section of a peripheral sensory nerve showing the reactive axonal core in inflammatory red.
					</div>
				</article>

				<!-- Concept 16: The Split-Field Dual Shield -->
				<article class="concept-card">
					<div class="card-meta">
						<span class="concept-id">CONCEPT 16</span>
						<span class="concept-style">Acid vs Defense Barrier Shield</span>
					</div>
					<div class="card-stage">
						<div style="display: flex; align-items: center; gap: 0.75rem; font-family: 'Plus Jakarta Sans', sans-serif;">
							<svg viewBox="0 0 32 36" width="34" height="38">
								<defs>
									<linearGradient id="shield-half" x1="0" y1="0" x2="1" y2="0">
										<stop offset="50%" stop-color="#a3e635"/>
										<stop offset="50%" stop-color="#ef4444"/>
									</linearGradient>
								</defs>
								<path d="M16 2 L4 7 L4 18 C4 26 16 34 16 34 C16 34 28 26 28 18 L28 7 Z" fill="url(#shield-half)"/>
							</svg>
