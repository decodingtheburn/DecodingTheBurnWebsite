          <polyline points="70,42 25,26 0,26" fill="none" stroke="#0f172a" stroke-width="1.75" marker-end="url(#arrow-left-black)" stroke-linecap="round"/>

          <!-- 2. MOUTH / DENTAL FOCAL POINT & ARROW TO CARD 2 (Touches top-left of Card 2 at X=140, Y=26) -->
          <circle cx="70" cy="68" r="4.5" fill="#dc2626"/>
