            <div class="p-row"><span class="p-row-label">Acidic fruits</span><span class="p-badge-amber">10%</span></div>
            <div class="p-row"><span class="p-row-label">Salivary loss &amp; stress</span><span class="p-badge-amber">10%</span></div>
          </div>

          <!-- Stretched Full-Width Others Category Button -->
          <div style="margin-top: 0.85rem; padding: 0.55rem 0.75rem; background: #fff7ed; border: 1.5px solid #fed7aa; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: background 0.15s ease;">
            <span style="font-size: 0.88rem; font-weight: 700; color: #9a3412; text-decoration: underline; text-underline-offset: 3px;">Others (20) &rsaquo;</span>
            <span style="font-size: 0.75rem; font-weight: 700; color: #ea580c; background: #ffedd5; padding: 0.15rem 0.5rem; border-radius: 4px;">0%</span>
          </div>
        </div>

      </div>

    </div>
  </div>

</div>

