      <!-- RIGHT COLUMN: 2 CARDS -->
      <div style="display: flex; flex-direction: column; gap: 2rem;">
        
        <!-- CARD 2: DENTAL ISSUES (Oral Cavity) -->
        <div class="p-card" style="border-radius: 0 12px 12px 12px; border-left: 2px solid #dc2626; display: flex; flex-direction: column;">
