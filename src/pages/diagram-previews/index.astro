            <span style="font-size: 0.88rem; font-weight: 700; color: #991b1b; text-decoration: underline; text-underline-offset: 3px;">Others (20) &rsaquo;</span>
            <span style="font-size: 0.75rem; font-weight: 700; color: #dc2626; background: #fee2e2; padding: 0.15rem 0.5rem; border-radius: 4px;">0%</span>
          </div>
        </div>

        <!-- CARD 3: DIETARY TRIGGERS (Stomach & Saliva) -->
        <div class="p-card" style="border-radius: 0 12px 12px 12px; border-left: 2px solid #ea580c; display: flex; flex-direction: column;">
          <div class="p-card-header" style="margin-bottom: 0.6rem; padding-bottom: 0.45rem;">
            <div>
              <div class="p-card-title" style="font-size: 1.25rem;">Dietary Triggers</div>
              <div class="p-card-sub">Stomach &amp; Saliva</div>
