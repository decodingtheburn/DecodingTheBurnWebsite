          <polyline points="70,155 110,240 140,240" fill="none" stroke="#ea580c" stroke-width="1.75" marker-end="url(#arrow-right-orange)" stroke-linecap="round"/>

          <!-- 4. GUT / SYSTEMIC FOCAL POINT & ARROW TO CARD 4 (Touches top-right of Card 4 at X=0, Y=240) -->
          <circle cx="70" cy="225" r="4.5" fill="#334155"/>
