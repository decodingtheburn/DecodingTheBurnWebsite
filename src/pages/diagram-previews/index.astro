  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggleBtns = document.querySelectorAll('.expand-toggle-btn');
      toggleBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          const triggerId = btn.getAttribute('data-trigger');
          if (!targetId) return;
          const drawer = document.getElementById(targetId);
          const triggerWrapper = triggerId ? document.getElementById(triggerId) : null;
          if (drawer) {
            drawer.style.display = 'flex';
            if (triggerWrapper) {
              triggerWrapper.style.display = 'none';
            }
          }
        });
      });
    });
  </script>

