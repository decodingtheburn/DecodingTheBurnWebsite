---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Thank You | Weekly Group Call Notification | Decoding The Burn" 
			description="Thank you for joining the weekly Burning Mouth Syndrome discussion group call notification list." 
		/>
	</head>
	<body>
		<Header />
		<main class="thank-you-main">
			<section class="thank-you-card">
				<div class="thank-you-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
						<polyline points="22 4 12 14.01 9 11.01"></polyline>
					</svg>
				</div>

				<h1 class="thank-you-title">You're on the&nbsp;List!</h1>
				
				<div class="thank-you-badge">
					<span>Weekly Discussion Circle • Wednesday Nights at 7:00 PM Eastern Time</span>
				</div>

				<div class="thank-you-content">
					<p class="thank-you-lead">
						Thank you for signing up. I have received your email, and you are now registered for our weekly group call notifications.
					</p>

					<div class="next-steps-box">
						<h2 class="next-steps-heading">What Happens Next</h2>
						<ul class="next-steps-list">
							<li>
								<strong>Attendance Confirmation:</strong> We require a minimum of 3 participants to run each live session.
							</li>
							<li>
								<strong>Tuesday Evening Email:</strong> 24 hours before Wednesday's call, you will receive an email confirming if that week's call is on, along with the private video link.
							</li>
							<li>
								<strong>Come as You Are:</strong> Whether you want to share your story or simply listen in with your camera off, you are warmly welcome.
							</li>
						</ul>
					</div>

					<div class="thank-you-actions">
						<a href="/blog/1-my-bms-18-months-carnivore-experiment/" class="btn btn-primary">Read My 18-Month Story &rarr;</a>
						<a href="/research/" class="btn btn-secondary">Explore BMS Research &rarr;</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.thank-you-main {
		max-width: 820px;
		margin: 3rem auto 5rem;
		padding: 0 1.5rem;
		display: flex;
		justify-content: center;
	}

	.thank-you-card {
		background: #ffffff;
		border: 1.5px solid #e2e8f0;
		border-radius: 24px;
		padding: clamp(2rem, 4vw, 3.5rem);
		text-align: center;
		box-shadow: 0 10px 35px -5px rgba(15, 23, 42, 0.08);
		width: 100%;
		box-sizing: border-box;
	}

	.thank-you-icon {
		width: 80px;
		height: 80px;
		border-radius: 50%;
		background: #dcfce7;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1.5rem auto;
		box-shadow: 0 0 20px rgba(34, 197, 94, 0.2);
	}

	.thank-you-title {
		font-family: var(--font-heading, system-ui, sans-serif);
		font-size: clamp(2.2rem, 4.5vw, 3.2rem);
		font-weight: 800;
		color: #0f172a;
		margin: 0 0 1rem 0;
		line-height: 1.15;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.thank-you-badge {
		display: inline-block;
		background: #fee2e2;
		color: #991b1b;
		padding: 0.55rem 1.25rem;
		border-radius: 30px;
		font-size: 0.88rem;
		font-weight: 700;
		margin-bottom: 2rem;
		border: 1px solid #fecaca;
	}

	.thank-you-content {
		max-width: 680px;
		margin: 0 auto;
		text-align: left;
	}

	.thank-you-lead {
		font-size: 1.15rem;
		line-height: 1.7;
		color: #334155;
		margin-bottom: 2rem;
		text-align: center;
		text-wrap: balance;
	}

	.next-steps-box {
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 16px;
		padding: 1.75rem 2rem;
		margin-bottom: 2.5rem;
	}

	.next-steps-heading {
		font-size: 1.25rem;
		font-weight: 800;
		color: #0f172a;
		margin: 0 0 1rem 0;
		line-height: 1.3;
	}

	.next-steps-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.next-steps-list li {
		position: relative;
		padding-left: 1.4rem;
		font-size: 0.98rem;
		line-height: 1.6;
		color: #475569;
	}

	.next-steps-list li::before {
		content: "•";
		color: #dc2626;
		font-size: 1.4rem;
		position: absolute;
		left: 0;
		top: -3px;
	}

	.next-steps-list strong {
		color: #0f172a;
	}

	.thank-you-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: center;
		margin-top: 2rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.85rem 1.6rem;
		font-size: 0.98rem;
		font-weight: 700;
		border-radius: 10px;
		text-decoration: none;
		transition: all 0.2s ease;
		cursor: pointer;
	}

	.btn-primary {
		background: #dc2626;
		color: #ffffff;
		border: 1px solid #b91c1c;
	}

	.btn-primary:hover {
		background: #b91c1c;
		color: #ffffff;
		transform: translateY(-2px);
		box-shadow: 0 6px 16px rgba(220, 38, 38, 0.25);
	}

	.btn-secondary {
		background: #f1f5f9;
		color: #1e293b;
		border: 1px solid #cbd5e1;
	}

	.btn-secondary:hover {
		background: #e2e8f0;
		color: #0f172a;
		transform: translateY(-2px);
	}

	@media (max-width: 600px) {
		.thank-you-actions {
			flex-direction: column;
			width: 100%;
		}
		.btn {
			width: 100%;
		}
		.next-steps-box {
			padding: 1.25rem 1.25rem;
		}
	}
</style>
