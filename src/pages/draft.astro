			/* ==========================================================================
			   Print Media Architecture: Clean Page Breaks & Crisp Printable Dossier
			   ========================================================================== */
			@media print {
				/* Hide web navigation, headers, footers, toolbars, and floating tabs */
				header,
				footer,
				.reading-toolbar-wrapper,
				.book-margin-actions,
				.site-header,
				.site-footer,
				#bms_print_btn,
				#bms_clear_btn,
				#bms_persist_status {
					display: none !important;
				}

				/* Reset body and page wrappers for pure print canvas */
				html, body {
					background: #ffffff !important;
					color: #000000 !important;
					font-size: 11pt !important;
					line-height: 1.45 !important;
					margin: 0 !important;
					padding: 0 !important;
				}

				.book-layout,
				.book-container {
					max-width: 100% !important;
					width: 100% !important;
					margin: 0 !important;
					padding: 0 !important;
				}

				/* Enforce clean page break at the end of each physical book page */
				.book-page,
				.book-page-toc,
				.book-page-frontmatter,
				.book-cover {
					page-break-after: always !important;
					break-after: page !important;
					min-height: 10in;
					height: 10in;
					position: relative !important;
					box-shadow: none !important;
					border: none !important;
					border-radius: 0 !important;
					padding: 0.48in 0.58in 0.68in 0.62in !important;
					margin: 0 !important;
					box-sizing: border-box !important;
				}

				.page-number-footer {
					position: absolute !important;
					bottom: 0.32in !important;
					left: 0.62in !important;
					right: 0.58in !important;
					margin: 0 !important;
					padding-top: 0.35rem !important;
					border-top: 1px solid #cbd5e1 !important;
					background: #ffffff !important;
				}

				/* Preserve form checkmarks and radio states */
				input[type="checkbox"],
				input[type="radio"] {
					print-color-adjust: exact !important;
					-webkit-print-color-adjust: exact !important;
				}

				/* Avoid splitting cards across pages */
				.quiz-book-card {
					page-break-inside: avoid !important;
					break-inside: avoid !important;
					border: 1px solid #cbd5e1 !important;
					box-shadow: none !important;
				}
			}

			/* Three-Column Diagnostic Checkbox Grid & Top-Aligned Custom Checkbox */
			.bms-grid-3col {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 0.65rem 1rem;
			}

			@media (max-width: 900px) {
