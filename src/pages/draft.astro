				<button id="close-draft-dialog-btn" type="button" aria-label="Close" style="position: absolute; top: 1.25rem; right: 1.25rem; background: #f1f5f9; border: 1px solid #cbd5e1; color: #0f172a; border-radius: 8px; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 20px; font-weight: 700;">&times;</button>
				<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #ffe4e6; color: #be123c; border: 1px solid #fecdd3; font-size: 0.78rem; font-weight: 800; padding: 0.25rem 0.65rem; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.85rem;">
					Draft Copy &bull; Work In Progress
				</div>
				<h3 style="font-size: 1.35rem; font-weight: 900; margin: 0 0 0.75rem; color: #0f172a; letter-spacing: -0.02em;">Active Working Manuscript</h3>
				<p style="font-size: 0.95rem; line-height: 1.65; color: #334155; margin: 0 0 1rem;">
					This book is being actively researched, revised, and expanded in real time. Chapters, citation counts, medical diagrams, and protocols are updated as new clinical findings and patient feedback emerge.
				</p>
				<p style="font-size: 0.88rem; line-height: 1.6; color: #64748b; margin: 0 0 1.5rem;">
					This preview does not represent the final print edition. For notifications when official published editions are released, visit <a href="/books" style="color: #e11d48; font-weight: 700; text-decoration: underline;">the books catalog</a>.
				</p>
				<button id="confirm-draft-dialog-btn" type="button" style="width: 100%; background: #e11d48; color: #ffffff; font-weight: 800; font-size: 0.95rem; padding: 0.75rem; border: none; border-radius: 10px; cursor: pointer; transition: background 0.15s ease;">Understood, Continue Reading</button>
			</div>
		</div>

		<script>
			document.querySelectorAll('.page-draft-stamp').forEach(btn => {
				btn.addEventListener('click', (e) => {
					e.preventDefault();
					const dialog = document.getElementById('draft-disclaimer-dialog');
					if (dialog) dialog.style.display = 'flex';
				});
			});

			const closeDialog = () => {
				const dialog = document.getElementById('draft-disclaimer-dialog');
				if (dialog) dialog.style.display = 'none';
			};

			document.getElementById('close-draft-dialog-btn')?.addEventListener('click', closeDialog);
			document.getElementById('confirm-draft-dialog-btn')?.addEventListener('click', closeDialog);
			document.getElementById('draft-disclaimer-dialog')?.addEventListener('click', (e) => {
				if (e.target === e.currentTarget) closeDialog();
			});
		</script>
