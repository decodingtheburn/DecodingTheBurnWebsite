			<!-- Chapter 10: Test Your Acidity Threshold (Page 1 of 4: Introduction & Option 1 Zero-Acid Carnivore Baseline) -->

			<section class="book-page" id="page-52">
				<div id="chapter-13" style="scroll-margin-top: 5rem;"></div>
				<div id="chapter-22" style="scroll-margin-top: 5rem;"></div>
				<div id="ch21-carnivore" style="scroll-margin-top: 5rem;"></div>
