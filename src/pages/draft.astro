				margin-bottom: 0.55rem;
			}
			@media (max-width: 640px) {
				.bms-pain-grid {
					grid-template-columns: repeat(6, minmax(0, 1fr));
					gap: 0.4rem;
				}
			}
			.bms-pain-box {
				position: relative;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: 0.5rem 0.15rem;
				background: #ffffff;
				border: 1.5px solid #cbd5e1;
				border-radius: 8px;
				cursor: pointer;
				transition: all 0.15s ease;
				user-select: none;
			}
			.bms-pain-box input[type="radio"] {
				position: absolute;
				opacity: 0;
				width: 100%;
				height: 100%;
				margin: 0;
				cursor: pointer;
				z-index: 2;
			}
			.bms-pain-box .pain-num {
				font-size: 1.15rem;
				font-weight: 800;
				color: #1e293b;
				line-height: 1.1;
			}
			.bms-pain-box .pain-indicator {
				width: 13px;
				height: 13px;
				border-radius: 50%;
				border: 1.5px solid #94a3b8;
				margin-top: 0.25rem;
				background: #ffffff;
