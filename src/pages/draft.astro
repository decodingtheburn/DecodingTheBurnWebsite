<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // BMS Questionnaire LocalStorage Persistence & Interactive Controls
    const STORAGE_KEY = 'bms_book_questionnaire_v1';
    
    // Elements
    const inputs = document.querySelectorAll('.bms-input-persist');
    const painSlider = document.getElementById('bms_pain_slider');
    const painDisplay = document.getElementById('bms_pain_val_display');
    const printBtn = document.getElementById('bms_print_btn');
    const clearBtn = document.getElementById('bms_clear_btn');
    const statusText = document.getElementById('bms_persist_status');

    if (!inputs.length) return;

    // Load saved answers
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      inputs.forEach(input => {
        const name = input.name;
        if (!name || saved[name] === undefined) return;

        if (input.type === 'checkbox') {
          input.checked = Boolean(saved[name]);
        } else if (input.type === 'radio') {
          if (input.value === saved[name]) input.checked = true;
        } else if (input.type === 'range') {
          input.value = saved[name];
          if (painDisplay) painDisplay.textContent = saved[name] + ' / 10';
        } else if (input.type === 'radio' && input.name === 'bms_pain_scale') {
          if (input.value === String(saved[name])) {
            input.checked = true;
            if (painDisplay) painDisplay.textContent = input.value + ' / 10';
          }
        } else {
          input.value = saved[name];
        }
      });
    } catch (e) {
      console.warn('Could not load BMS questionnaire data', e);
    }

    // Save helper
    function saveAll() {
      const data = {};
      inputs.forEach(input => {
        const name = input.name;
        if (!name) return;
        if (input.type === 'checkbox') {
          data[name] = input.checked;
        } else if (input.type === 'radio') {
          if (input.checked) data[name] = input.value;
        } else {
          data[name] = input.value;
        }
      });
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
        if (statusText) {
          statusText.textContent = 'Answers saved automatically in this browser.';
        }
      } catch (e) {
        console.warn('Could not save BMS questionnaire data', e);
      }
    }

    // Attach listeners
    inputs.forEach(input => {
      input.addEventListener('change', saveAll);
      input.addEventListener('input', () => {
        if (input.type === 'range' && painDisplay) {
          painDisplay.textContent = input.value + ' / 10';
        }
        if (input.tagName === 'TEXTAREA' || input.type === 'text') {
          saveAll();
        }
      });
    });

    // Slider listener (legacy fallback) & Print-Ready 0-10 Radio Scale listener
    if (painSlider && painDisplay) {
      painSlider.addEventListener('input', (e) => {
        painDisplay.textContent = e.target.value + ' / 10';
      });
    }

    const painRadios = document.querySelectorAll('input[name="bms_pain_scale"]');
    painRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        if (radio.checked && painDisplay) {
          painDisplay.textContent = radio.value + ' / 10';
        }
      });
    });

    // Print button
    if (printBtn) {
      printBtn.addEventListener('click', () => {
        window.print();
      });
    }

    // Clear button
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (confirm('Are you sure you want to clear your saved answers in this questionnaire?')) {
          localStorage.removeItem(STORAGE_KEY);
          inputs.forEach(input => {
            if (input.type === 'checkbox' || input.type === 'radio') {
              input.checked = false;
            } else if (input.type === 'range') {
              input.value = 7;
              if (painDisplay) painDisplay.textContent = '7 / 10';
            } else {
              input.value = '';
            }
          });
          if (statusText) statusText.textContent = 'Fields cleared.';
        }
      });
    }

    // Option B: Comprehensive Dual Pagination Sync (Roman Frontmatter + Arabic Main Text + Dynamic TOC/Menu Sync)
    function toRoman(num) {
      const lookup = [
        ['m', 1000], ['cm', 900], ['d', 500], ['cd', 400],
        ['c', 100], ['xc', 90], ['l', 50], ['xl', 40],
        ['x', 10], ['ix', 9], ['v', 5], ['iv', 4], ['i', 1]
      ];
      let roman = '';
      for (const [letter, val] of lookup) {
        while (num >= val) {
          roman += letter;
          num -= val;
        }
      }
      return roman;
    }

    const allBookPages = Array.from(document.querySelectorAll('.book-page'));
    let inMain = false;
    let mainPageNum = 0;
    let frontMatterNum = 0;
    const pageMap = {};

    allBookPages.forEach((sec) => {
      const sid = sec.id || '';
      // Skip unnumbered physical prelims: half title, epigraph, title page, copyright, back flyleaf
      if (['half-title-page', 'epigraph-page', 'title-page', 'copyright-page', 'flyleaf-back'].includes(sid)) {
        return;
      }

      // Main book begins at Part 1 Page / Chapter 1
      if (sid === 'part-1-page' || sid === 'page-1-intro-1' || sid === 'page-1') {
        inMain = true;
      }

      const footerSpan = sec.querySelector('.page-number-footer span');
      const countLbl = sec.querySelector('.page-running-head .page-count-label');

      if (!inMain) {
        frontMatterNum++;
        const rStr = toRoman(frontMatterNum);
        pageMap[sid] = rStr;
        sec.querySelectorAll('[id]').forEach((child) => {
          if (child.id && !pageMap[child.id]) pageMap[child.id] = rStr;
        });
        if (footerSpan && !footerSpan.textContent.includes('Contents')) {
          footerSpan.textContent = rStr;
        }
        if (countLbl && countLbl.textContent.includes('Page')) {
          countLbl.textContent = countLbl.textContent.replace(/Page\s+[a-zA-Z0-9]+/i, 'Page ' + rStr);
        }
      } else {
        mainPageNum++;
        const numStr = String(mainPageNum);
        pageMap[sid] = numStr;
        sec.querySelectorAll('[id]').forEach((child) => {
          if (child.id && !pageMap[child.id]) pageMap[child.id] = numStr;
        });
        if (footerSpan) footerSpan.textContent = numStr;
        if (countLbl) countLbl.textContent = 'Page ' + numStr;
      }
    });

    // Synchronize Table of Contents dot leaders and page numbers
    document.querySelectorAll('.toc-item, .toc-sub-row').forEach((item) => {
      const link = item.querySelector('a.toc-link, a.toc-sub-link');
      const numSpan = item.querySelector('.toc-num, .toc-sub-num');
      if (!link || !numSpan) return;
      const href = link.getAttribute('href');
      if (!href || !href.startsWith('#')) return;
      let tid = href.slice(1);
      if (tid === 'bibliography') tid = 'page-83';
      if (pageMap[tid]) numSpan.textContent = pageMap[tid];
    });

    // Synchronize Sticky Navigation toolbar menu page numbers
    document.querySelectorAll('.toolbar-menu a').forEach((link) => {
      const href = link.getAttribute('href');
      const numSpan = link.querySelector('.menu-num');
      if (!href || !href.startsWith('#') || !numSpan) return;
      const tid = href.slice(1);
      if (pageMap[tid]) {
        numSpan.textContent = (pageMap[tid].startsWith('Contents') || ['i','ii','iii','iv','v','vi','vii','viii'].includes(pageMap[tid])) 
          ? pageMap[tid] 
          : 'p. ' + pageMap[tid];
      }
    });
  });

	// Mobile TOC Drawer Interactive Controller
	const mobileTocToggleBtn = document.getElementById('mobile-toc-toggle-btn');
	const mobileTocCloseBtn = document.getElementById('mobile-toc-close-btn');
	const mobileTocDropdown = document.querySelector('.mobile-toc-dropdown');
	const mobileDrawerLinks = document.querySelectorAll('.mobile-drawer-link');

	if (mobileTocToggleBtn && mobileTocDropdown) {
		mobileTocToggleBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			const isOpen = mobileTocDropdown.classList.toggle('is-open');
			mobileTocToggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
		});
	}

	if (mobileTocCloseBtn && mobileTocDropdown) {
		mobileTocCloseBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			mobileTocDropdown.classList.remove('is-open');
			if (mobileTocToggleBtn) mobileTocToggleBtn.setAttribute('aria-expanded', 'false');
		});
	}

	if (mobileDrawerLinks && mobileTocDropdown) {
		mobileDrawerLinks.forEach(link => {
			link.addEventListener('click', () => {
				mobileTocDropdown.classList.remove('is-open');
				if (mobileTocToggleBtn) mobileTocToggleBtn.setAttribute('aria-expanded', 'false');
			});
		});
	}

	document.addEventListener('click', (e) => {
		if (mobileTocDropdown && mobileTocDropdown.classList.contains('is-open')) {
			if (!mobileTocDropdown.contains(e.target)) {
				mobileTocDropdown.classList.remove('is-open');
				if (mobileTocToggleBtn) mobileTocToggleBtn.setAttribute('aria-expanded', 'false');
			}
		}
	});
</script>


