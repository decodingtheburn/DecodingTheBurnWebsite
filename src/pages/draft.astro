					<div class="chapter-content is-first-page" style="max-width: 620px; margin: 2rem auto 0; text-align: center;">
						<div class="chapter-opener-header" style="text-align: center; margin-bottom: 1.75rem;">
							<div class="chapter-opener-num" style="font-size: 0.95rem; letter-spacing: 0.08em; text-transform: uppercase;">Part III &bull; Community Action</div>
							<h2 class="chapter-title chapter-opener-title" style="font-size: 2.15rem; line-height: 1.25; margin: 0.5rem 0 0.85rem; border-bottom: none; padding-bottom: 0;">
