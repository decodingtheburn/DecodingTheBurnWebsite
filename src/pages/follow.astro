---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Join the Community | Decoding The Burn" 
			description="Join our open science community on Facebook, YouTube, our weekly live group calls, and email list as we decode Burning Mouth Syndrome." 
		/>
	</head>
	<body>
		<Header />
		<main class="follow-page-container">
			<div class="disclaimer-wrap">
				<MedicalDisclaimer />
			</div>

			<!-- Hero Header -->
			<header class="follow-hero">
				<h1 class="follow-title">Join the Community</h1>
				<p class="follow-subtitle">
					Join other patients, dentists, doctors, and researchers and stay updated on the latest research and discoveries of Burning Mouth&nbsp;Syndrome.
				</p>
			</header>

			<!-- 4 Clear Action Blocks: 1. Mailing List, 2. Facebook, 3. YouTube, 4. Reddit -->
			<section class="action-steps-container">
				
				<!-- Action 1: Mailing List -->
				<div class="action-card card-email">
					<div class="card-body">
						<div class="card-icon-wrap" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="144" height="144" fill="#7c3aed">
								<path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
							</svg>
						</div>
						<h2 class="card-heading">Join the Mailing List</h2>
						<p class="card-text">
							Get notified when new case studies and research updates are&nbsp;published.
						</p>
						
						<form 
							id="follow-newsletter-form" 
							action="https://formsubmit.co/denis@denisethier.com" 
							method="POST" 
							class="follow-form"
						>
							<input type="hidden" name="_subject" value="[Decoding The Burn] New Newsletter Subscriber" />
							<input type="hidden" name="_captcha" value="false" />
							<input type="hidden" name="_template" value="table" />
							<input type="hidden" name="_next" value="https://www.decodingtheburn.com/thank-you-newsletter/" />
							<input type="hidden" name="form_type" value="Main Newsletter Subscription" />
							<input type="hidden" name="Submission_Page" value="Follow the Discoveries (/follow/)" />
							<input type="hidden" name="Page_URL" value="https://www.decodingtheburn.com/follow/" />
							<input type="hidden" name="Thank_You_Page_Shown" value="https://www.decodingtheburn.com/thank-you-newsletter/" />
							<input type="hidden" name="_autoresponse" value="Welcome to Decoding The Burn! Thank you for following our research discoveries, dietary self-experiments, and open science updates on Burning Mouth Syndrome. - Denis Ethier" />

							<div class="form-input-stack">
								<input 
									type="email" 
									name="email" 
									placeholder="Enter your email address..." 
									required 
									class="email-input-field"
									aria-label="Email address for newsletter"
								/>
								<button type="submit" id="follow-submit-btn" class="big-action-btn email-submit-btn">
									<span class="btn-label">Join Mailing List &rarr;</span>
								</button>
							</div>
						</form>
					</div>
				</div>

				<!-- Action 2: BMS Community Research (Facebook Group) -->
				<div class="action-card card-facebook">
					<div class="card-body">
						<div class="card-icon-wrap" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="144" height="144" fill="#1877f2">
								<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
							</svg>
						</div>
						<h2 class="card-heading">BMS Community Research</h2>
						<p class="card-text">
							Join our Facebook group to connect with fellow patients, compare observations, and ask questions in real&nbsp;time.
						</p>
						<div class="card-btn-wrap">
							<a 
								href="https://www.facebook.com/groups/decodingtheburn/" 
								target="_blank" 
								rel="noopener noreferrer" 
								class="big-action-btn facebook-btn"
							>
								<span>Join on Facebook &rarr;</span>
							</a>
						</div>
					</div>
				</div>

				<!-- Action 3: YouTube -->
				<div class="action-card card-youtube">
					<div class="card-body">
						<div class="card-icon-wrap" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="144" height="144" fill="#ff0000">
								<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
							</svg>
						</div>
						<h2 class="card-heading">Subscribe on YouTube</h2>
						<p class="card-text">
							Watch video podcast interviews, case studies, and radiograph&nbsp;breakdowns.
						</p>
						<div class="card-btn-wrap">
							<a 
								href="https://www.youtube.com/@DecodingTheBurning?sub_confirmation=1" 
								target="_blank" 
								rel="noopener noreferrer" 
								class="big-action-btn youtube-btn"
							>
								<span>Subscribe on YouTube &rarr;</span>
							</a>
						</div>
					</div>
				</div>

				<!-- Action 4: Weekly Group Call -->
				<div class="action-card card-weekly-group">
					<div class="card-body">
						<div class="card-icon-wrap" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="144" height="144" fill="#0284c7">
								<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
							</svg>
						</div>
						<h2 class="card-heading">Weekly Group Call</h2>
						<p class="card-text">
							Join our live Wednesday night discussion circles to troubleshoot triggers with other patients and compare daily&nbsp;observations.
						</p>
						<div class="card-btn-wrap">
							<a 
								href="/troubleshooting-night/" 
								class="big-action-btn weekly-group-btn"
							>
								<span>Join Weekly Call &rarr;</span>
							</a>
						</div>
					</div>
				</div>

			</section>

			<!-- Quick Backlinks -->
			<div class="bottom-nav-links">
				<a href="/podcast" class="subtle-link">&larr; Visit Podcast Hub</a>
				<a href="/mission" class="subtle-link">Read Our Mission &rarr;</a>
			</div>
		</main>
		<Footer />

		<style>
			.follow-page-container {
				max-width: 980px;
				margin: 0 auto;
				padding: 2.5rem 1.5rem 6rem 1.5rem;
			}

			.disclaimer-wrap {
				margin-bottom: 2rem;
			}

			.follow-hero {
				text-align: center;
				margin-bottom: 3.5rem;
			}

			.follow-title {
				font-size: clamp(2.1rem, 4.5vw, 3.2rem);
				font-weight: 800;
				color: #0f172a;
				letter-spacing: -0.025em;
				line-height: 1.15;
				margin: 0 auto 1.25rem auto;
				text-wrap: balance;
			}

			.follow-subtitle {
				font-size: 1.2rem;
				line-height: 1.6;
				color: #334155;
				max-width: 740px;
				margin: 0 auto;
				text-wrap: balance;
			}

			.action-steps-container {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 2rem;
				margin-bottom: 3.5rem;
			}

			.action-card {
				background: #ffffff;
				border: 1px solid rgba(15, 23, 42, 0.08);
				border-radius: 24px;
				padding: 2.75rem 2rem;
				display: flex;
				flex-direction: column;
				position: relative;
				box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.10), 0 8px 20px -4px rgba(15, 23, 42, 0.05);
				transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
			}

			.action-card:hover {
				transform: translateY(-4px);
				border-color: rgba(15, 23, 42, 0.15);
				box-shadow: 0 28px 60px -12px rgba(15, 23, 42, 0.16), 0 12px 24px -4px rgba(15, 23, 42, 0.08);
			}

			.card-body {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				height: 100%;
			}

			.card-icon-wrap {
				display: flex;
				justify-content: center;
				align-items: center;
				margin-bottom: 1.5rem;
			}

			.card-heading {
				font-size: 1.65rem;
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 0.75rem 0;
				letter-spacing: -0.02em;
				text-wrap: balance;
			}

			.card-text {
				font-size: 0.98rem;
				line-height: 1.5;
				color: #64748b;
				max-width: 270px;
				margin: 0 auto 1.75rem auto;
				text-wrap: balance;
				flex-grow: 1;
			}

			.big-action-btn {
				display: block;
				width: 100%;
				text-align: center;
				padding: 1.1rem 1.25rem;
				border-radius: 14px;
				font-size: 1.05rem;
				font-weight: 800;
				text-decoration: none;
				cursor: pointer;
				border: none;
				transition: all 0.2s ease;
			}

			.youtube-btn {
				background: #ff0000;
				color: #ffffff;
				box-shadow: 0 6px 20px -3px rgba(255, 0, 0, 0.35);
			}

			.youtube-btn:hover {
				background: #cc0000;
				color: #ffffff;
				transform: translateY(-1px);
			}

			.facebook-btn {
				background: #1877f2;
				color: #ffffff;
				box-shadow: 0 6px 20px -3px rgba(24, 119, 242, 0.35);
			}

			.facebook-btn:hover {
				background: #166fe5;
				color: #ffffff;
				transform: translateY(-1px);
			}

			.weekly-group-btn {
				background: #0284c7;
				color: #ffffff;
				box-shadow: 0 6px 20px -3px rgba(2, 132, 199, 0.35);
			}

			.weekly-group-btn:hover {
				background: #0369a1;
				color: #ffffff;
				transform: translateY(-1px);
			}

			.email-submit-btn {
				background: #7c3aed;
				color: #ffffff;
				box-shadow: 0 6px 20px -3px rgba(124, 58, 237, 0.35);
			}

			.email-submit-btn:hover {
				background: #6d28d9;
				transform: translateY(-1px);
			}

			.follow-form {
				width: 100%;
			}

			.form-input-stack {
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
			}

			.email-input-field {
				width: 100%;
				padding: 0.95rem 1.25rem;
				border: 1.5px solid #cbd5e1;
				border-radius: 12px;
				font-size: 1rem;
				color: #0f172a;
				background: #ffffff;
				outline: none;
				box-sizing: border-box;
				transition: border-color 0.2s ease;
			}

			.email-input-field:focus {
				border-color: #7c3aed;
				box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
			}

			.follow-success-msg {
				background: #ecfdf5;
				border: 1.5px solid #a7f3d0;
				border-radius: 12px;
				padding: 1rem 1.25rem;
				color: #065f46;
				font-weight: 700;
				display: flex;
				align-items: center;
				gap: 0.75rem;
				font-size: 0.98rem;
			}

			.check-icon {
				font-size: 1.2rem;
				font-weight: 900;
			}

			.bottom-nav-links {
				display: flex;
				justify-content: center;
				gap: 2rem;
				margin-top: 2rem;
			}

			.subtle-link {
				color: #64748b;
				font-size: 0.95rem;
				font-weight: 600;
				text-decoration: none;
			}

			.subtle-link:hover {
				color: #0f172a;
				text-decoration: underline;
			}

			.hidden {
				display: none !important;
			}

			@media (max-width: 768px) {
				.action-steps-container {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
