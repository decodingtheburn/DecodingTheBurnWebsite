---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Follow the Discoveries | Decoding The Burn" 
			description="Follow our open science discoveries on YouTube, Facebook, Reddit, and our private email list as we decode Burning Mouth Syndrome." 
		/>
	</head>
	<body>
		<Header />
		<main class="follow-page-container">
			<div class="disclaimer-wrap">
				<MedicalDisclaimer />
			</div>

			<!-- Hero Header -->
			<header class="follow-hero">
				<h1 class="follow-title">Follow the Discoveries</h1>
				<p class="follow-subtitle">
					Join other patients, dentists, and researchers following our real-time investigations, case studies, and clinical data to decode Burning Mouth&nbsp;Syndrome.
				</p>
			</header>

			<!-- 4 Clear Action Blocks: YouTube, Facebook, Reddit, Email -->
			<section class="action-steps-container">
				
				<!-- Action 1: YouTube -->
				<div class="action-card card-youtube">
					<div class="card-body">
						<div class="card-icon-wrap" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="144" height="144" fill="#ff0000">
								<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
							</svg>
						</div>
						<h2 class="card-heading">Subscribe on YouTube</h2>
						<p class="card-text">
							Watch video podcast interviews, case studies, and radiograph&nbsp;breakdowns.
						</p>
						<div class="card-btn-wrap">
							<a 
								href="https://www.youtube.com/@DecodingTheBurning?sub_confirmation=1" 
								target="_blank" 
								rel="noopener noreferrer" 
								class="big-action-btn youtube-btn"
							>
								<span>Subscribe on YouTube &rarr;</span>
							</a>
						</div>
					</div>
				</div>

				<!-- Action 2: Facebook Group -->
				<div class="action-card card-facebook">
					<div class="card-body">
						<div class="card-icon-wrap" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="144" height="144" fill="#1877f2">
								<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
							</svg>
						</div>
						<h2 class="card-heading">Join Facebook Group</h2>
						<p class="card-text">
							Connect with fellow patients, share observations, and ask questions in real&nbsp;time.
						</p>
						<div class="card-btn-wrap">
							<a 
								href="https://www.facebook.com/groups/decodingtheburn/" 
								target="_blank" 
								rel="noopener noreferrer" 
								class="big-action-btn facebook-btn"
							>
								<span>Join Facebook Group &rarr;</span>
							</a>
						</div>
					</div>
				</div>

				<!-- Action 3: Reddit Community -->
				<div class="action-card card-reddit">
					<div class="card-body">
						<div class="card-icon-wrap" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="144" height="144" fill="#ff4500">
								<path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.56 1.25 1.248a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.56 12 8 12.56 8 13.25c0 .687.56 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/>
							</svg>
						</div>
						<h2 class="card-heading">Join r/DecodingBMS</h2>
						<p class="card-text">
							Discuss symptoms, compare protocols, and engage with the Reddit BMS&nbsp;community.
						</p>
						<div class="card-btn-wrap">
							<a 
								href="https://www.reddit.com/r/DecodingBMS/" 
								target="_blank" 
								rel="noopener noreferrer" 
								class="big-action-btn reddit-btn"
							>
								<span>Join on Reddit &rarr;</span>
							</a>
						</div>
					</div>
				</div>

				<!-- Action 4: Mailing List -->
				<div class="action-card card-email">
					<div class="card-body">
						<div class="card-icon-wrap" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="144" height="144" fill="#7c3aed">
								<path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
							</svg>
						</div>
						<h2 class="card-heading">Join the Mailing List</h2>
						<p class="card-text">
							Get notified when new case studies and research updates are&nbsp;published.
						</p>
						
						<form 
							id="follow-newsletter-form" 
							action="https://formsubmit.co/denis@denisethier.com" 
							method="POST" 
							class="follow-form"
						>
							<input type="hidden" name="_subject" value="[Decoding The Burn] New Newsletter Subscriber" />
							<input type="hidden" name="_captcha" value="false" />
							<input type="hidden" name="_template" value="table" />
							<input type="hidden" name="form_type" value="Main Newsletter Subscription" />

							<div class="form-input-stack">
								<input 
									type="email" 
									name="email" 
									placeholder="Enter your email address..." 
									required 
									class="email-input-field"
									aria-label="Email address for newsletter"
								/>
								<button type="submit" id="follow-submit-btn" class="big-action-btn email-submit-btn">
									<span class="btn-label">Join Mailing List &rarr;</span>
									<span class="btn-spinner hidden" aria-hidden="true">Joining...</span>
								</button>
							</div>
						</form>

						<div id="follow-success-box" class="follow-success-msg hidden" role="alert">
							<span class="check-icon">✓</span>
							<span>You are on the list! Thank you for joining our community.</span>
						</div>
					</div>
				</div>

			</section>

			<!-- Quick Backlinks -->
			<div class="bottom-nav-links">
				<a href="/podcast" class="subtle-link">&larr; Visit Podcast Hub</a>
				<a href="/mission" class="subtle-link">Read Our Mission &rarr;</a>
			</div>
		</main>
		<Footer />

		<script>
			const form = document.getElementById('follow-newsletter-form') as HTMLFormElement;
			const submitBtn = document.getElementById('follow-submit-btn') as HTMLButtonElement;
			const btnLabel = submitBtn?.querySelector('.btn-label');
			const btnSpinner = submitBtn?.querySelector('.btn-spinner');
			const successBox = document.getElementById('follow-success-box');

			if (form) {
				form.addEventListener('submit', async (e) => {
					e.preventDefault();
					if (btnLabel && btnSpinner && submitBtn) {
						btnLabel.classList.add('hidden');
						btnSpinner.classList.remove('hidden');
						submitBtn.disabled = true;
					}

					try {
						const formData = new FormData(form);
						const response = await fetch(form.action, {
							method: 'POST',
							body: formData,
							headers: { 'Accept': 'application/json' }
						});

						if (response.ok) {
							form.reset();
							form.classList.add('hidden');
							successBox?.classList.remove('hidden');
						} else {
							form.submit(); // fallback
						}
					} catch (err) {
						form.submit(); // fallback
					}
				});
			}
		</script>

		<style>
			.follow-page-container {
				max-width: 980px;
				margin: 0 auto;
				padding: 2.5rem 1.5rem 6rem 1.5rem;
			}

			.disclaimer-wrap {
				margin-bottom: 2rem;
			}

			.follow-hero {
				text-align: center;
				margin-bottom: 3.5rem;
			}

			.follow-title {
				font-size: clamp(2.1rem, 4.5vw, 3.2rem);
				font-weight: 800;
				color: #0f172a;
				letter-spacing: -0.025em;
				line-height: 1.15;
				margin: 0 auto 1.25rem auto;
				text-wrap: balance;
			}

			.follow-subtitle {
				font-size: 1.2rem;
				line-height: 1.6;
				color: #334155;
				max-width: 740px;
				margin: 0 auto;
				text-wrap: balance;
			}

			.action-steps-container {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 2rem;
				margin-bottom: 3.5rem;
			}

			.action-card {
				background: #ffffff;
				border: 1px solid rgba(15, 23, 42, 0.08);
				border-radius: 24px;
				padding: 2.75rem 2rem;
				display: flex;
				flex-direction: column;
				position: relative;
				box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.10), 0 8px 20px -4px rgba(15, 23, 42, 0.05);
				transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
			}

			.action-card:hover {
				transform: translateY(-4px);
				border-color: rgba(15, 23, 42, 0.15);
				box-shadow: 0 28px 60px -12px rgba(15, 23, 42, 0.16), 0 12px 24px -4px rgba(15, 23, 42, 0.08);
			}

			.card-body {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				height: 100%;
			}

			.card-icon-wrap {
				display: flex;
				justify-content: center;
				align-items: center;
				margin-bottom: 1.5rem;
			}

			.card-heading {
				font-size: 1.65rem;
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 0.75rem 0;
				letter-spacing: -0.02em;
				text-wrap: balance;
			}

			.card-text {
				font-size: 0.98rem;
				line-height: 1.5;
				color: #64748b;
				max-width: 270px;
				margin: 0 auto 1.75rem auto;
				text-wrap: balance;
				flex-grow: 1;
			}

			.big-action-btn {
				display: block;
				width: 100%;
				text-align: center;
				padding: 1.1rem 1.25rem;
				border-radius: 14px;
				font-size: 1.05rem;
				font-weight: 800;
				text-decoration: none;
				cursor: pointer;
				border: none;
				transition: all 0.2s ease;
			}

			.youtube-btn {
				background: #ff0000;
				color: #ffffff;
				box-shadow: 0 6px 20px -3px rgba(255, 0, 0, 0.35);
			}

			.youtube-btn:hover {
				background: #cc0000;
				color: #ffffff;
				transform: translateY(-1px);
			}

			.facebook-btn {
				background: #1877f2;
				color: #ffffff;
				box-shadow: 0 6px 20px -3px rgba(24, 119, 242, 0.35);
			}

			.facebook-btn:hover {
				background: #166fe5;
				color: #ffffff;
				transform: translateY(-1px);
			}

			.reddit-btn {
				background: #ff4500;
				color: #ffffff;
				box-shadow: 0 6px 20px -3px rgba(255, 69, 0, 0.35);
			}

			.reddit-btn:hover {
				background: #e03d00;
				color: #ffffff;
				transform: translateY(-1px);
			}

			.email-submit-btn {
				background: #7c3aed;
				color: #ffffff;
				box-shadow: 0 6px 20px -3px rgba(124, 58, 237, 0.35);
			}

			.email-submit-btn:hover {
				background: #6d28d9;
				transform: translateY(-1px);
			}

			.follow-form {
				width: 100%;
			}

			.form-input-stack {
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
			}

			.email-input-field {
				width: 100%;
				padding: 0.95rem 1.25rem;
				border: 1.5px solid #cbd5e1;
				border-radius: 12px;
				font-size: 1rem;
				color: #0f172a;
				background: #ffffff;
				outline: none;
				box-sizing: border-box;
				transition: border-color 0.2s ease;
			}

			.email-input-field:focus {
				border-color: #7c3aed;
				box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
			}

			.follow-success-msg {
				background: #ecfdf5;
				border: 1.5px solid #a7f3d0;
				border-radius: 12px;
				padding: 1rem 1.25rem;
				color: #065f46;
				font-weight: 700;
				display: flex;
				align-items: center;
				gap: 0.75rem;
				font-size: 0.98rem;
			}

			.check-icon {
				font-size: 1.2rem;
				font-weight: 900;
			}

			.bottom-nav-links {
				display: flex;
				justify-content: center;
				gap: 2rem;
				margin-top: 2rem;
			}

			.subtle-link {
				color: #64748b;
				font-size: 0.95rem;
				font-weight: 600;
				text-decoration: none;
			}

			.subtle-link:hover {
				color: #0f172a;
				text-decoration: underline;
			}

			.hidden {
				display: none !important;
			}

			@media (max-width: 768px) {
				.action-steps-container {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
