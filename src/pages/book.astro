			.copyright-title-block {
				margin-bottom: 2rem;
			}

			.copyright-book-title {
				font-family: 'Montserrat', sans-serif !important;
				font-size: 1.05rem;
				font-weight: 700;
				color: #0f172a;
				margin-bottom: 0.25rem;
