				gap: 3.5rem;
			}

			.interior-title-eyebrow {
				font-family: 'Cinzel', serif;
				font-size: 0.84rem;
				font-weight: 700;
				letter-spacing: 0.24em;
				color: #7c3aed;
				text-transform: uppercase;
				margin-bottom: 1.5rem;
			}

			.interior-title-main {
				font-family: 'Cinzel', serif;
				font-size: 2.85rem;
				font-weight: 800;
				line-height: 1.15;
				color: #0f172a;
				margin: 0 0 1rem;
			}

			.interior-title-subtitle {
				font-family: 'Lora', serif;
				font-size: 1.08rem;
				font-style: italic;
				color: #475569;
				line-height: 1.65;
				max-width: 620px;
				margin: 0 auto 2.5rem;
				text-wrap: balance;
			}

			.interior-title-device {
				width: 80px;
				height: 80px;
				margin: 2rem auto;
				opacity: 0.85;
			}

			.interior-title-author {
				font-family: 'Cinzel', serif;
				font-size: 1.35rem;
				font-weight: 700;
				letter-spacing: 0.16em;
				color: #0f172a;
				text-transform: uppercase;
				margin-bottom: 0.4rem;
			}

			.interior-title-cred {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.88rem;
				color: #64748b;
				margin-bottom: 2.5rem;
			}

			.interior-title-imprint {
				border-top: 1px solid #e2e8f0;
				padding-top: 1.5rem;
				width: 100%;
				max-width: 380px;
			}

			.interior-title-publisher {
				font-family: 'Cinzel', serif;
				font-size: 0.82rem;
				font-weight: 700;
				letter-spacing: 0.18em;
				color: #1e293b;
				text-transform: uppercase;
				margin-bottom: 0.25rem;
			}

			.interior-title-loc {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.76rem;
				color: #94a3b8;
			}

			/* Copyright Notice Page */
			.copyright-page-wrap {
				height: 100%;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				padding: 2rem 0;
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.82rem;
				line-height: 1.7;
				color: #475569;
			}

			.copyright-title-block {
				margin-bottom: 2rem;
			}

			.copyright-book-title {
				font-family: 'Cinzel', serif;
				font-size: 1.05rem;
				font-weight: 700;
				color: #0f172a;
				margin-bottom: 0.25rem;
			}

			.copyright-book-sub {
				font-family: 'Lora', serif;
				font-style: italic;
				color: #64748b;
