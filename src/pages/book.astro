			<!-- Chapter 27: The Two Bottlenecks (Page 1 of 4) -->

			<section class="book-page" id="page-67">
				<div id="chapter-26" style="scroll-margin-top: 5rem;"></div>
				<div id="ch26-bottlenecks" style="scroll-margin-top: 5rem;"></div>

				<div class="page-body-content">
					<div class="page-running-head">
						<span class="chapter-header-label">Chapter 27: The Two Bottlenecks</span>
