				background: linear-gradient(180deg, rgba(251, 113, 133, 0.35) 0%, rgba(147, 51, 234, 0.2) 50%, rgba(251, 113, 133, 0.3) 100%);
				box-shadow: -2px 0 8px rgba(0, 0, 0, 0.8);
				z-index: 5;
			}

			.backcover-gold-border {
				border: 1.5px solid rgba(168, 85, 247, 0.35);
				border-radius: 8px;
				padding: 3.85rem 2.75rem 3.25rem;
				position: relative;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				height: 100%;
				min-height: 940px;
				box-sizing: border-box;
				background: radial-gradient(circle at 50% 50%, rgba(147, 51, 234, 0.08) 0%, transparent 80%);
			}

			.backcover-header {
				font-family: 'Cinzel', serif;
				font-size: 0.92rem;
				font-weight: 700;
				letter-spacing: 0.22em;
				color: #e9d5ff;
				text-transform: uppercase;
				margin-bottom: 1rem;
			}

			.backcover-tagline {
				font-family: 'Cinzel', serif;
				font-size: 2.15rem;
				font-weight: 800;
				line-height: 1.2;
				color: #ffffff;
				margin-bottom: 1.5rem;
				text-wrap: balance;
			}

			.backcover-blurb {
				font-family: 'Lora', serif;
				font-size: 1.05rem;
				line-height: 1.72;
				color: #e2e8f0;
				margin-bottom: 1.35rem;
				text-wrap: pretty;
			}

			.backcover-figure {
				margin: 1.5rem 0;
				border: 1px solid rgba(168, 85, 247, 0.35);
				border-radius: 8px;
				overflow: hidden;
				background: rgba(8, 3, 16, 0.75);
				box-shadow: 0 10px 25px rgba(0, 0, 0, 0.55);
			}

			.backcover-figure img {
				display: block;
				width: 100%;
				max-height: 215px;
				object-fit: cover;
			}

			.backcover-features {
				list-style: none;
				padding: 0;
				margin: 1.5rem 0 1.75rem;
			}

			.backcover-features li {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.96rem;
