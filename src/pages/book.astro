			/* Callout / Pull quote inside book */
			.book-callout {
				margin: 1.5rem 0;
				padding: 1.15rem 1.35rem 1.15rem 1.25rem;
				background: #f8fafc;
				border-left: 3.5px solid #7c3aed;
				font-style: italic;
				color: #334155;
				border-radius: 0 8px 8px 0;
				display: flex;
				align-items: flex-start;
				gap: 0.85rem;
				box-sizing: border-box;
			}

			.book-callout-icon {
				flex-shrink: 0;
				width: 20px;
				height: 20px;
				color: #7c3aed;
				margin-top: 0.15rem;
				display: inline-flex;
				align-items: center;
				justify-content: center;
			}

			.book-callout-text {
				flex: 1;
				margin: 0;
			}

			.book-callout p {
				margin: 0 !important;
				line-height: 1.65;
