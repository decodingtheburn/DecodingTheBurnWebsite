			/* Reported Interventions & Triggers Research Table (2-Column, Pure Black Typography) */
			.research-table-wrapper {
				margin: 1.25rem 0 1.5rem;
				border: 1.5px solid #000000;
				border-radius: 6px;
				overflow-x: auto;
				background: #ffffff;
