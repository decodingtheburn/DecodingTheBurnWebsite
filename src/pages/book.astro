			.backcover-pricing {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 1.05rem;
				font-weight: 700;
				color: #ffffff;
				margin-bottom: 0.35rem;
			}

			.backcover-author-tag {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.88rem;
				color: #94a3b8;
			}

			.backcover-barcode-card {
				background: #ffffff;
				padding: 0.85rem 1rem 0.65rem;
				border-radius: 6px;
				box-shadow: 0 6px 18px rgba(0, 0, 0, 0.6);
				display: flex;
				flex-direction: column;
				align-items: center;
				color: #000000;
			}

			.backcover-barcode-card svg {
				display: block;
			}

			.backcover-isbn-text {
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				margin-top: 0.25rem;
				color: #000000;
			}

			/* Part Introduction Box */
			.part-intro-box {
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-left: 4px solid #7c3aed;
				border-radius: 0 8px 8px 0;
				padding: 1.15rem 1.35rem;
				margin-bottom: 1.65rem;
			}

			.part-intro-tag {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.72rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #7c3aed;
				margin-bottom: 0.35rem;
			}

			.part-intro-title {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 1.05rem;
				font-weight: 700;
				color: #0f172a;
				margin-bottom: 0.5rem;
