			.flyleaf-subtle {
				font-family: 'Cinzel', serif;
				font-size: 0.85rem;
				letter-spacing: 0.28em;
				text-transform: uppercase;
				color: #cbd5e1;
				user-select: none;
			}

			/* Interior Title Page */
			.interior-title-wrap {
				min-height: 960px;
				height: 100%;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				text-align: center;
				padding: 3.5rem 1.5rem;
