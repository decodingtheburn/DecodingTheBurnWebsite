---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AudioReader from '../components/AudioReader.astro';
import InteractiveProgressionChart from '../components/InteractiveProgressionChart.astro';
import Carnivore18MonthTimeline from '../components/Carnivore18MonthTimeline.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Decoding the Burn (Book Draft) | First Principles of BMS" 
			description="A look at the first principles of pain receptors in Burning Mouth Syndrome: Dental Hardware Leaks, Acid Chemistry, and Calming the Oral Neuropathic Circuit." 
			noindex={true}
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		<style>
			:root {
				--book-bg: #ecefe6;
				--paper-color: #ffffff;
				--paper-border: #e2e8f0;
				--ink-color: #1a202c;
				--ink-subtle: #4a5568;
				--book-spine-gold: #c5a059;
				--book-cover-bg: #090514;
				--brand-purple-deep: #1e0b38;
				--brand-purple-dark: #2a0845;
				--brand-rose-subtle: #fb7185;
			}

			/* On the book reader page, the main site header scrolls away naturally */
			:global(.navbar) {
				position: relative !important;
				top: auto !important;
				margin: 6px auto 0 !important;
			}

			html,
			body {
				overflow-x: clip !important;
				overflow-y: visible !important;
			}

			body {
				background-color: #0d091a;
				color: var(--ink-color);
				font-family: 'Lora', Georgia, serif;
				margin: 0;
				padding: 0;
				-webkit-font-smoothing: antialiased;
			}

			.book-viewport {
				max-width: 880px;
				margin: 1.5rem auto 7rem;
				padding: 0 1.5rem;
			}

			/* Sticky Reader Ribbon Wrapper (Locks to top: 0 as the always-on sticky menu) */
			.reading-toolbar-wrapper {
				position: -webkit-sticky;
				position: sticky;
				top: 0;
				left: 0;
				width: 100%;
				z-index: 1000;
				display: flex;
				justify-content: center;
				pointer-events: none; /* Let clicks pass through empty wrapper margins */
			}

			/* Book Secondary Sticky Navigation Bar (Clean, 1-Line High with Dropdowns) */
			.reading-toolbar {
				pointer-events: auto; /* Re-enable pointer events for the bar */
				display: flex;
				justify-content: center;
				align-items: center;
				background: rgba(14, 8, 26, 0.98);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				padding: 0 1.25rem;
				height: 48px;
				border: 1px solid rgba(168, 85, 247, 0.28);
				border-top: none;
				box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.75);
				margin: 0 auto;
				font-family: 'Plus Jakarta Sans', sans-serif;
				width: 100%;
				max-width: 880px;
				box-sizing: border-box;
				border-radius: 0 0 12px 12px;
			}

			.toolbar-actions {
				display: flex;
				align-items: center;
				gap: 0.35rem;
				height: 100%;
				width: 100%;
				max-width: 820px;
				justify-content: space-between;
			}

			.toolbar-nav-group {
				display: flex;
				align-items: center;
				gap: 0.25rem;
				height: 100%;
			}

			/* Individual Dropdown Item in Sticky Bar */
			.toolbar-dropdown {
				position: relative;
				display: inline-flex;
				align-items: center;
				height: 100%;
			}

			.toolbar-trigger {
				background: transparent;
				border: none;
				color: #cbd5e1;
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.82rem;
				font-weight: 700;
				padding: 0.35rem 0.65rem;
				border-radius: 6px;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
				transition: all 0.15s ease;
				text-decoration: none;
				white-space: nowrap;
				line-height: 1;
			}

			.toolbar-trigger svg {
				transition: transform 0.2s ease;
				stroke: #94a3b8;
			}

			.toolbar-trigger:hover,
			.toolbar-dropdown:hover .toolbar-trigger,
			.toolbar-dropdown.is-open .toolbar-trigger {
				color: #ffffff;
				background: rgba(168, 85, 247, 0.18);
			}

			.toolbar-trigger:hover svg,
			.toolbar-dropdown:hover .toolbar-trigger svg,
			.toolbar-dropdown.is-open .toolbar-trigger svg {
				stroke: #c084fc;
				transform: rotate(180deg);
			}

			/* Dropdown Menu Container (Single-Line Items Guaranteed) */
			.toolbar-menu {
				position: absolute;
				top: 100%;
				left: 0;
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 10px;
				box-shadow: 0 18px 40px -10px rgba(0, 0, 0, 0.35), 0 4px 12px rgba(0, 0, 0, 0.08);
				width: max-content;
				min-width: 280px;
				max-width: calc(100vw - 32px);
				padding: 0.45rem;
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
				opacity: 0;
				pointer-events: none;
				transform: translateY(4px);
				transition: opacity 0.18s ease, transform 0.18s ease;
				z-index: 1000;
			}

			/* Invisible hover bridge: bridges the gap when moving mouse from button into menu */
			.toolbar-menu::before {
				content: '';
				position: absolute;
				top: -14px;
				left: 0;
				right: 0;
				height: 14px;
				background: transparent;
				pointer-events: auto;
			}

			.toolbar-dropdown:hover .toolbar-menu,
			.toolbar-dropdown:focus-within .toolbar-menu,
			.toolbar-dropdown.is-open .toolbar-menu {
				opacity: 1;
				pointer-events: auto;
				transform: translateY(0px);
			}

			.toolbar-menu-header,
			.toolbar-menu a.toolbar-menu-header {
				display: block;
				font-size: 0.7rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: #7c3aed !important;
				padding: 0.45rem 0.65rem 0.3rem !important;
				border-bottom: 1px solid #f1f5f9 !important;
				margin-bottom: 0.25rem !important;
				white-space: nowrap !important;
				text-decoration: none !important;
				border-radius: 4px;
				transition: color 0.15s ease, background 0.15s ease;
			}

			.toolbar-menu a.toolbar-menu-header:hover {
				color: #5b21b6 !important;
				background: rgba(124, 58, 237, 0.08) !important;
			}

			.toolbar-menu a {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.45rem 0.65rem;
				color: #1e293b;
				font-size: 0.8rem;
				font-weight: 600;
				text-decoration: none;
				border-radius: 6px;
				transition: background 0.15s ease, color 0.15s ease;
				line-height: 1.3;
				white-space: nowrap;
			}

			.toolbar-menu a span:first-child {
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.toolbar-menu a .menu-num {
				font-size: 0.72rem;
				font-weight: 700;
				color: #7c3aed;
				margin-left: 0.65rem;
				white-space: nowrap;
				flex-shrink: 0;
			}

			.toolbar-menu a:hover {
				background: #f5f3ff;
				color: #7c3aed;
			}

			.toolbar-start-btn {
				background: #7c3aed;
				color: #ffffff;
				font-size: 0.78rem;
				font-weight: 700;
				padding: 0.38rem 0.85rem;
				border-radius: 6px;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				transition: background 0.15s ease, transform 0.15s ease;
				white-space: nowrap;
			}

			.toolbar-start-btn:hover {
				background: #6d28d9;
				transform: translateY(-1px);
			}

			/* Book Cover (Full Page Dimensions Matching .book-page) */
			.book-cover-container {
				display: flex;
				justify-content: center;
				margin-top: 2rem;
				margin-bottom: 4rem;
				width: 100%;
			}

			.book-cover {
				position: relative;
				width: 100%;
				max-width: 100%;
				min-height: 1050px;
				height: auto;
				background: radial-gradient(circle at 50% 25%, #240b3b 0%, #150726 55%, #080310 100%);
				color: #ffffff;
				border-radius: 8px;
				box-shadow: 
					0 30px 70px -15px rgba(0, 0, 0, 0.75),
					0 10px 30px rgba(42, 8, 69, 0.45),
					0 0 0 1px rgba(168, 85, 247, 0.2),
					inset 16px 0 26px rgba(0, 0, 0, 0.85);
				text-align: center;
				overflow: hidden;
				border-left: 22px solid #06020c;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				padding: 5.5rem 4.75rem 4.5rem calc(4.75rem - 22px);
				box-sizing: border-box;
			}

			/* Book Spine Ridge highlight */
			.book-cover::before {
				content: '';
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				width: 3px;
				background: linear-gradient(180deg, rgba(251, 113, 133, 0.35) 0%, rgba(147, 51, 234, 0.2) 50%, rgba(251, 113, 133, 0.3) 100%);
				box-shadow: 2px 0 8px rgba(0, 0, 0, 0.8);
				z-index: 5;
			}

			.cover-gold-border {
				border: 1.5px solid rgba(168, 85, 247, 0.35);
				border-radius: 8px;
				padding: 3.85rem 2.5rem 3.25rem;
				position: relative;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				height: 100%;
				min-height: 940px;
				box-sizing: border-box;
				background: radial-gradient(circle at 50% 50%, rgba(147, 51, 234, 0.08) 0%, transparent 80%);
			}

			.cover-eyebrow {
				font-family: 'Cinzel', serif;
				font-size: 1.05rem;
				font-weight: 700;
				letter-spacing: 0.28em;
				color: #e9d5ff;
				text-transform: uppercase;
				margin-bottom: 1.25rem;
			}

			.cover-title {
				font-family: 'Cinzel', serif;
				margin: 0 0 1.25rem;
				text-shadow: 0 6px 35px rgba(0, 0, 0, 0.9);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				width: 100%;
			}

			.cover-title-line-1 {
				display: inline-block;
				font-size: clamp(3.7rem, 7.2vw, 5.81rem);
				font-weight: 800;
				line-height: 1.05;
				letter-spacing: 0.18em;
				text-indent: 0.18em;
				color: #ffffff;
				text-align: center;
				width: auto;
				max-width: 100%;
				margin: 0 auto;
				white-space: nowrap;
			}

			.cover-title-line-2 {
				display: inline-block;
				font-size: clamp(4.49rem, 8.9vw, 7.08rem);
				font-weight: 900;
				line-height: 1.02;
				letter-spacing: 0.06em;
				text-indent: 0.06em;
				color: #ffffff;
				text-align: center;
				width: auto;
				max-width: 100%;
				margin: 0.25rem auto 0;
				white-space: nowrap;
			}

			.cover-subtitle {
				font-family: 'Lora', serif;
				font-size: 1.12rem;
				font-weight: 400;
				color: #e2e8f0;
				line-height: 1.6;
				max-width: 680px;
				margin: 0 auto;
				text-wrap: balance;
			}

			/* Center Illustration */
			.cover-illustration-wrap {
				position: relative;
				display: flex;
				justify-content: center;
				align-items: center;
				margin: 2.75rem 0;
			}

			.cover-tooth-glow {
				position: absolute;
				width: 260px;
				height: 260px;
				border-radius: 50%;
				background: radial-gradient(circle, rgba(147, 51, 234, 0.4) 0%, rgba(225, 29, 72, 0.25) 50%, transparent 75%);
				filter: blur(28px);
				pointer-events: none;
			}

			.cover-tooth-img {
				position: relative;
				z-index: 2;
				max-height: 310px;
				width: auto;
				object-fit: contain;
				filter: drop-shadow(0 20px 35px rgba(0, 0, 0, 0.85)) drop-shadow(0 0 25px rgba(168, 85, 247, 0.4));
				opacity: 0.96;
				transition: transform 0.4s ease, opacity 0.4s ease;
			}

			.book-cover:hover .cover-tooth-img {
				transform: scale(1.03);
				opacity: 0.98;
			}

			.cover-anatomy-img {
				position: relative;
				z-index: 2;
				max-height: 330px;
				width: 100%;
				max-width: 580px;
				object-fit: cover;
				border-radius: 12px;
				box-shadow: 0 16px 36px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.25);
				border: 1px solid rgba(168, 85, 247, 0.3);
				transition: transform 0.4s ease, box-shadow 0.4s ease;
			}

			.book-cover:hover .cover-anatomy-img {
				transform: scale(1.02);
				box-shadow: 0 22px 50px rgba(0, 0, 0, 0.92), 0 0 42px rgba(168, 85, 247, 0.4);
			}

			.cover-pain-head-img {
				position: relative;
				z-index: 2;
				max-height: 330px;
				width: auto;
				object-fit: contain;
				filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.85)) drop-shadow(0 0 35px rgba(244, 63, 94, 0.35));
				transition: transform 0.4s ease, filter 0.4s ease;
			}

			.book-cover:hover .cover-pain-head-img {
				transform: scale(1.03);
				filter: drop-shadow(0 25px 50px rgba(0, 0, 0, 0.9)) drop-shadow(0 0 45px rgba(244, 63, 94, 0.5));
			}

			/* ==========================================================================
			   Dedicated Part Divider Pages (Clean, Standalone Full-Page Presentation)
			   ========================================================================== */
			.book-part-page {
				background: #ffffff;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				align-items: stretch;
				min-height: 1050px;
				box-sizing: border-box;
			}

			.part-page-container {
				min-height: 860px;
				height: 100%;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				text-align: center;
				padding: 4.5rem 2rem 3.5rem;
				box-sizing: border-box;
				gap: 2.25rem;
			}

			.part-page-header-block {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.85rem;
				width: 100%;
			}

			.part-page-num {
				font-family: 'Cinzel', serif;
				font-size: 1.15rem;
				font-weight: 800;
				letter-spacing: 0.32em;
				text-indent: 0.32em;
				color: #7c3aed;
				text-transform: uppercase;
				margin: 0;
			}

			.part-page-title {
				font-family: 'Cinzel', serif;
				font-size: clamp(2.3rem, 4.2vw, 3.2rem);
				font-weight: 800;
				line-height: 1.18;
				letter-spacing: 0.04em;
				color: #0f172a;
				margin: 0.25rem auto 0;
				max-width: 720px;
				text-wrap: balance;
			}

			.part-page-divider {
				width: 100px;
				height: 2px;
				background: linear-gradient(90deg, transparent, #a855f7, transparent);
				margin: 0.5rem auto 0;
			}

			.part-page-desc {
				font-family: 'Lora', serif;
				font-size: 1.18rem;
				font-style: italic;
				color: #475569;
				line-height: 1.7;
				max-width: 600px;
				margin: 0 auto;
				text-wrap: balance;
			}

			.part-page-emblem-block {
				display: flex;
				align-items: center;
				justify-content: center;
				margin-top: 1rem;
			}

			.part-page-emblem-img {
				width: 110px;
				height: 110px;
				object-fit: cover;
				border-radius: 50%;
				border: 2px solid #ede9fe;
				box-shadow: 0 12px 28px -4px rgba(124, 58, 237, 0.16), 0 0 0 1px rgba(0, 0, 0, 0.04);
			}

			.part-page-emblem-img.contain-emblem {
				border-radius: 0;
				border: none;
				box-shadow: none;
				object-fit: contain;
				filter: drop-shadow(0 10px 20px rgba(124, 58, 237, 0.18));
			}

			.toc-part-link {
				color: inherit;
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.toc-part-link:hover {
				color: #7c3aed;
			}

			.cover-divider {
				width: 120px;
				height: 2px;
				background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.8), transparent);
				margin: 1.5rem auto;
			}

			.cover-author {
				font-family: 'Cinzel', serif;
				font-size: 1.65rem;
				font-weight: 700;
				letter-spacing: 0.18em;
				color: #f8fafc;
				text-transform: uppercase;
				margin-bottom: 0.5rem;
			}

			.cover-author-sub {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 1.05rem;
				color: #cbd5e1;
				font-weight: 500;
			}

			.cover-edition-tag {
				display: block;
				margin-top: 1rem;
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.88rem;
				font-weight: 600;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: #a78bfa;
			}

			/* Proportional Book Page (Content Pages) */
			.book-page {
				background-color: #ffffff;
				border-radius: 8px;
				box-shadow: 
					0 18px 40px -8px rgba(0, 0, 0, 0.25),
					0 6px 18px rgba(0, 0, 0, 0.15),
					0 0 0 1px rgba(0, 0, 0, 0.06);
				padding: 4.25rem 4.75rem 4rem;
				margin-bottom: 4rem;
				position: relative;
				border-left: 1px solid #f1f5f9;
				min-height: 1050px;
				height: auto;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			/* Single-Page Table of Contents (Exception Layout) */
			.book-page-toc {
				background-color: #ffffff;
				border-radius: 8px;
				box-shadow: 
					0 18px 40px -8px rgba(0, 0, 0, 0.25),
					0 6px 18px rgba(0, 0, 0, 0.15),
					0 0 0 1px rgba(0, 0, 0, 0.06);
				padding: 3.5rem 4rem 3rem;
				margin-bottom: 4rem;
				position: relative;
				border-left: 1px solid #f1f5f9;
				min-height: 1050px;
				height: auto;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			/* Page Book Spine Shadow on Left Edge */
			.book-page::before,
			.book-page-toc::before {
				content: '';
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				width: 18px;
				background: linear-gradient(90deg, rgba(0, 0, 0, 0.045) 0%, rgba(0, 0, 0, 0.012) 60%, transparent 100%);
				pointer-events: none;
			}

			/* Page Header & Running Head */
			.page-running-head {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				color: #475569;
				text-transform: uppercase;
				border-bottom: 1px solid #e2e8f0;
				padding-bottom: 0.85rem;
				margin-bottom: 40px;
			}

			.page-running-head .chapter-header-label {
				color: #94a3b8;
			}

			.page-running-head .page-count-label {
				display: none !important;
			}

			.page-number-footer {
				display: flex;
				justify-content: center;
				align-items: center;
				margin-top: 2rem;
				padding-top: 1.25rem;
				border-top: 1px solid #f8fafc;
				font-family: 'Cinzel', serif;
				font-size: 0.92rem;
				font-weight: 600;
				color: #94a3b8;
			}

			/* Major Part Hero Header (Takes ~1/3 of the page, centered, large & stylish) */
			.part-hero-block {
				min-height: 280px;
				background: radial-gradient(circle at 50% 40%, #faf5ff 0%, #ffffff 85%);
				border: 1.5px solid #ede9fe;
				border-radius: 14px;
				padding: 2.75rem 2rem 2.25rem;
				margin-bottom: 2.75rem;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				position: relative;
				overflow: hidden;
				box-shadow: 0 10px 30px -10px rgba(124, 58, 237, 0.08);
				box-sizing: border-box;
			}

			.part-hero-block::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 4px;
				background: linear-gradient(90deg, #c084fc 0%, #7c3aed 50%, #c084fc 100%);
			}

			.part-hero-ornament {
				display: flex;
				align-items: center;
