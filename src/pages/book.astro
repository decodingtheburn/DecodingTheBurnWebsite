			.toc-dots {
				flex-grow: 1;
				border-bottom: 1px dotted #cbd5e1;
				margin: 0 0.4rem;
				height: 1px;
			}

			.toc-num {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.78rem;
				font-weight: 600;
				color: #64748b;
