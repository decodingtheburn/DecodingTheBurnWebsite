			.backcover-features li::before {
				content: '•';
				position: absolute;
				left: 0;
				color: #a855f7;
				font-weight: 900;
				font-size: 1.1rem;
				line-height: 1;
			}

			.backcover-bottom {
				border-top: 1px solid rgba(168, 85, 247, 0.35);
				padding-top: 1.75rem;
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				gap: 2rem;
			}

			.backcover-meta {
				flex: 1;
			}

			.backcover-category {
				font-family: 'Cinzel', serif;
				font-size: 0.86rem;
				font-weight: 700;
				letter-spacing: 0.16em;
				color: #c084fc;
				text-transform: uppercase;
				margin-bottom: 0.35rem;
