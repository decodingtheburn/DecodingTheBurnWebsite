		<script is:inline>
			(() => {
				// --- Selection Action Toolbar (Play Audio & Feedback) ---
				const triggerToolbar = document.getElementById('selection-floating-toolbar');
				const playBtn = document.getElementById('selection-play-btn');
				const triggerBtn = document.getElementById('selection-feedback-btn');
				const modal = document.getElementById('feedback-modal');
				const closeBtn = document.getElementById('feedback-modal-close-btn');
				const cancelBtn = document.getElementById('feedback-cancel-btn');
				const nextBtn = document.getElementById('feedback-next-btn');
				const backBtn = document.getElementById('feedback-back-btn');
				const submitBtn = document.getElementById('feedback-submit-btn');
				const skipEmailBtn = document.getElementById('feedback-skip-email-btn');
				
				const quoteDisplay = document.getElementById('feedback-quote-display');
				const commentInput = document.getElementById('feedback-comment-input');
				const emailInput = document.getElementById('feedback-email-input');
				
				const step1 = document.getElementById('feedback-step-1');
				const step2 = document.getElementById('feedback-step-2');
				const stepSuccess = document.getElementById('feedback-step-success');

				// --- Contributor Application Modal Elements ---
				const openContribBtn = document.getElementById('open-contributor-modal-btn');
				const contribModal = document.getElementById('contributor-modal');
				const closeContribBtn = document.getElementById('contributor-modal-close-btn');
				const cancelContribBtn = document.getElementById('contributor-cancel-btn');
				const contribForm = document.getElementById('contributor-form');
				const contribSubmitBtn = document.getElementById('contributor-submit-btn');
				const contribSuccessState = document.getElementById('contributor-success-state');

				const contribNameInput = document.getElementById('contrib-name');
				const contribRoleInput = document.getElementById('contrib-role');
				const contribNotesInput = document.getElementById('contrib-notes');
				const contribEmailInput = document.getElementById('contrib-email');

				// --- Contributor Modal Logic ---
				function openContributorModal() {
					if (contribForm) contribForm.style.display = 'block';
					if (contribSuccessState) contribSuccessState.style.display = 'none';
					if (contribModal) contribModal.style.display = 'flex';
					setTimeout(() => contribNameInput?.focus(), 80);
				}

				function closeContributorModal() {
					if (contribModal) contribModal.style.display = 'none';
				}

				openContribBtn?.addEventListener('click', openContributorModal);
				document.querySelectorAll('.contributor-request-trigger-btn').forEach(btn => {
					btn.addEventListener('click', () => {
						const defaultRole = btn.getAttribute('data-default-role');
						if (defaultRole && contribRoleInput) contribRoleInput.value = defaultRole;
						openContributorModal();
					});
				});
				closeContribBtn?.addEventListener('click', closeContributorModal);
				cancelContribBtn?.addEventListener('click', closeContributorModal);

				contribModal?.addEventListener('click', (e) => {
					if (e.target === contribModal) {
						closeContributorModal();
					}
				});

				contribForm?.addEventListener('submit', async (e) => {
					e.preventDefault();
					const name = contribNameInput?.value.trim() || '';
					const role = contribRoleInput?.value.trim() || '';
					const notes = contribNotesInput?.value.trim() || '';
					const email = contribEmailInput?.value.trim() || '';

					if (!name || !role || !notes || !email) return;

					const originalBtnText = contribSubmitBtn ? contribSubmitBtn.textContent : '';
					if (contribSubmitBtn) {
						contribSubmitBtn.textContent = 'Submitting...';
						contribSubmitBtn.disabled = true;
					}

					const payload = {
						_subject: `[Book Contributor Application] ${name} (${role})`,
						_template: "table",
						_captcha: "false",
						Applicant_Name: name,
						Role_or_Perspective: role,
						Key_Findings_or_Notes: notes,
						Contact_Email: email,
						Submission_Date: new Date().toLocaleString()
					};

					try {
						await fetch("https://formsubmit.co/ajax/denis@decodingtheburn.com", {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"Accept": "application/json"
							},
							body: JSON.stringify(payload)
						});
					} catch (err) {
						console.warn("Contributor submission notice:", err);
					}

					if (contribForm) contribForm.style.display = 'none';
					if (contribSuccessState) contribSuccessState.style.display = 'block';

					setTimeout(() => {
						closeContributorModal();
						if (contribForm) {
							contribForm.reset();
							contribForm.style.display = 'block';
						}
						if (contribSuccessState) contribSuccessState.style.display = 'none';
						if (contribSubmitBtn) {
							contribSubmitBtn.textContent = originalBtnText || 'Submit Contribution';
							contribSubmitBtn.disabled = false;
						}
					}, 2800);
				});

				let currentSelectedQuote = '';
				let currentAnchorNode = null;
				let userCommentText = '';

				function updateTriggerPosition(overrideX, overrideY) {
					if (modal && modal.style.display === 'flex') return;

					const selection = window.getSelection();
					if (!selection || selection.isCollapsed) {
						if (triggerToolbar) triggerToolbar.style.display = 'none';
						return;
					}

					const selectedText = selection.toString().trim();
					if (selectedText.length < 3) {
						if (triggerToolbar) triggerToolbar.style.display = 'none';
						return;
					}

					// Verify selection is within the book content
					const anchorNode = selection.anchorNode;
					if (!anchorNode || !anchorNode.parentElement?.closest('.book-viewport')) {
						if (triggerToolbar) triggerToolbar.style.display = 'none';
						return;
					}

					try {
						currentSelectedQuote = selectedText;
						currentAnchorNode = anchorNode;

						if (overrideX !== undefined && overrideY !== undefined) {
							if (triggerToolbar) {
								triggerToolbar.style.top = `${overrideY}px`;
								triggerToolbar.style.left = `${overrideX}px`;
								triggerToolbar.style.display = 'inline-flex';
							}
							return;
						}

						const range = selection.getRangeAt(0);
						const rect = range.getBoundingClientRect();
						if (rect && rect.width > 0) {
							const scrollY = window.pageYOffset || document.documentElement.scrollTop;
							const scrollX = window.pageXOffset || document.documentElement.scrollLeft;
							
							if (triggerToolbar) {
								triggerToolbar.style.top = `${scrollY + rect.top}px`;
								triggerToolbar.style.left = `${scrollX + rect.left + (rect.width / 2)}px`;
								triggerToolbar.style.display = 'inline-flex';
							}
						}
					} catch (e) {
						if (triggerToolbar) triggerToolbar.style.display = 'none';
					}
				}

				// Play Audio button click
				playBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					if (!currentSelectedQuote) {
						const sel = window.getSelection();
						currentSelectedQuote = sel ? sel.toString().trim() : '';
						currentAnchorNode = sel ? sel.anchorNode : null;
					}
					if (typeof window.audioReaderPlayFromText === 'function') {
						const played = window.audioReaderPlayFromText(currentSelectedQuote, currentAnchorNode);
						if (played && triggerToolbar) {
							triggerToolbar.style.display = 'none';
						}
					}
				});

				// Right-click (contextmenu) on selected text trigger
				document.addEventListener('contextmenu', (e) => {
					const selection = window.getSelection();
					if (selection && !selection.isCollapsed) {
						const text = selection.toString().trim();
						if (text.length >= 3) {
							const anchor = selection.anchorNode;
							if (anchor && anchor.parentElement?.closest('.book-viewport')) {
								e.preventDefault();
								updateTriggerPosition(e.pageX, e.pageY);
							}
						}
					}
				});

				// Listen for selection events with debounce
				let selTimeout;
				const handleSelectionChange = () => {
					clearTimeout(selTimeout);
					selTimeout = setTimeout(updateTriggerPosition, 140);
				};

				document.addEventListener('mouseup', handleSelectionChange);
				document.addEventListener('touchend', handleSelectionChange);
				document.addEventListener('selectionchange', handleSelectionChange);

				// Hide toolbar on document click if clicking outside
				document.addEventListener('mousedown', (e) => {
					if (triggerToolbar && !triggerToolbar.contains(e.target) && !modal?.contains(e.target)) {
						const sel = window.getSelection();
						if (!sel || sel.isCollapsed) {
							triggerToolbar.style.display = 'none';
						}
					}
				});

				// Open modal on trigger click
				triggerBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					if (!currentSelectedQuote) {
						const sel = window.getSelection();
						currentSelectedQuote = sel ? sel.toString().trim() : '';
					}
					if (!currentSelectedQuote) return;

					if (quoteDisplay) {
						quoteDisplay.textContent = `"${currentSelectedQuote}"`;
					}
					if (commentInput) {
						commentInput.value = '';
					}
					if (emailInput) {
						emailInput.value = '';
					}

					// Reset steps
					if (step1) step1.style.display = 'block';
					if (step2) step2.style.display = 'none';
					if (stepSuccess) stepSuccess.style.display = 'none';

					if (modal) modal.style.display = 'flex';
					if (triggerToolbar) triggerToolbar.style.display = 'none';
					setTimeout(() => commentInput?.focus(), 80);
				});

				// Margin Feedback Button (can be clicked anytime, even without text selected)
				const marginFeedbackBtn = document.getElementById('book-margin-feedback-btn');
				marginFeedbackBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					const sel = window.getSelection();
					const text = sel ? sel.toString().trim() : '';

					if (text && text.length >= 5) {
						currentSelectedQuote = text;
						if (quoteDisplay) {
							quoteDisplay.textContent = `"${currentSelectedQuote}"`;
							quoteDisplay.style.display = 'block';
						}
					} else {
						currentSelectedQuote = 'Overall Book / General Feedback';
						if (quoteDisplay) {
							quoteDisplay.textContent = '💡 Tip: You can also highlight any sentence in the book, then click "Send Feedback" to quote that exact passage.';
							quoteDisplay.style.display = 'block';
						}
					}

					if (commentInput) commentInput.value = '';
					if (emailInput) emailInput.value = '';

					if (step1) step1.style.display = 'block';
					if (step2) step2.style.display = 'none';
					if (stepSuccess) stepSuccess.style.display = 'none';

					if (modal) modal.style.display = 'flex';
					setTimeout(() => commentInput?.focus(), 80);
				});

				// Close modal
				function closeModal() {
					if (modal) modal.style.display = 'none';
					window.getSelection()?.removeAllRanges();
					currentSelectedQuote = '';
					userCommentText = '';
				}

				closeBtn?.addEventListener('click', closeModal);
				cancelBtn?.addEventListener('click', closeModal);

				// Step 1 -> Step 2
				function goToStep2() {
					const comment = commentInput?.value.trim();
					if (!comment) {
						if (commentInput) {
							commentInput.style.borderColor = '#ef4444';
							commentInput.focus();
							setTimeout(() => {
								if (commentInput) commentInput.style.borderColor = '#cbd5e1';
							}, 1500);
						}
						return;
					}
					userCommentText = comment;
					if (step1) step1.style.display = 'none';
					if (step2) step2.style.display = 'block';
					setTimeout(() => emailInput?.focus(), 80);
				}

				nextBtn?.addEventListener('click', goToStep2);

				// Press Enter in textarea (without Shift) triggers Next
				commentInput?.addEventListener('keydown', (e) => {
					if (e.key === 'Enter' && !e.shiftKey) {
						e.preventDefault();
						goToStep2();
					}
				});

				// Step 2 -> Back to Step 1
				backBtn?.addEventListener('click', () => {
					if (step2) step2.style.display = 'none';
					if (step1) step1.style.display = 'block';
					setTimeout(() => commentInput?.focus(), 80);
				});

				// Send submission
				async function sendFeedback(emailValue) {
					if (!userCommentText) return;

					const originalSubmitText = submitBtn ? submitBtn.textContent : '';
					if (submitBtn) {
						submitBtn.textContent = 'Sending...';
						submitBtn.disabled = true;
					}
					if (skipEmailBtn) skipEmailBtn.disabled = true;

					const quoteSnippet = currentSelectedQuote.length > 50 
						? currentSelectedQuote.substring(0, 48) + '...' 
						: currentSelectedQuote;

					const payload = {
						_subject: `[Book Reader Note] "${quoteSnippet}"`,
						_template: "table",
						_captcha: "false",
						Selected_Passage: currentSelectedQuote,
						Reader_Comment: userCommentText,
						Reader_Email: emailValue || "Anonymous (No email provided)",
						Book_Page_URL: window.location.href,
						Submission_Date: new Date().toLocaleString()
					};

					try {
						await fetch("https://formsubmit.co/ajax/denis@decodingtheburn.com", {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"Accept": "application/json"
							},
							body: JSON.stringify(payload)
						});
					} catch (err) {
						console.warn("Feedback submission notice:", err);
					}

					// Show success state
					if (step2) step2.style.display = 'none';
					if (stepSuccess) stepSuccess.style.display = 'block';

					setTimeout(() => {
						closeModal();
						if (submitBtn) {
							submitBtn.textContent = originalSubmitText || 'Send Feedback';
							submitBtn.disabled = false;
						}
						if (skipEmailBtn) skipEmailBtn.disabled = false;
					}, 2400);
				}

				submitBtn?.addEventListener('click', () => {
					const email = emailInput?.value.trim() || '';
					sendFeedback(email);
				});

				skipEmailBtn?.addEventListener('click', () => {
					sendFeedback('');
				});

				// Press Enter in email input triggers submit
				emailInput?.addEventListener('keydown', (e) => {
					if (e.key === 'Enter') {
						e.preventDefault();
						const email = emailInput?.value.trim() || '';
						sendFeedback(email);
					}
				});
			})();
		</script>

		<!-- Contributor Case Detail Modal -->
		<div id="case-detail-modal" class="case-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="case-modal-title">
			<div class="case-modal-card">
				<button id="case-modal-close-btn" class="case-modal-close" type="button" aria-label="Close dialog">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
				<div class="case-modal-header">
					<div class="case-modal-avatar">
						<img id="case-modal-avatar-img" src="" alt="" width="72" height="72" />
					</div>
					<div>
						<h3 id="case-modal-title" class="case-modal-name"></h3>
						<p id="case-modal-meta" class="case-modal-meta"></p>
					</div>
				</div>
				<div class="case-modal-section-title">Case Background and Protocol</div>
				<p id="case-modal-bio" class="case-modal-bio"></p>
				<div class="case-modal-box case-modal-box-better">
					<span class="case-modal-box-label" style="color: #166534;">What Made It Better</span>
					<p id="case-modal-better" class="case-modal-box-text"></p>
				</div>
				<div class="case-modal-box case-modal-box-worst">
					<span class="case-modal-box-label" style="color: #991b1b;">What Made It Worse</span>
					<p id="case-modal-worst" class="case-modal-box-text"></p>
				</div>
			</div>
		</div>

		<script is:inline>
			(function() {
				const modal = document.getElementById('case-detail-modal');
				const closeBtn = document.getElementById('case-modal-close-btn');
				const avatarImg = document.getElementById('case-modal-avatar-img');
				const nameEl = document.getElementById('case-modal-title');
				const metaEl = document.getElementById('case-modal-meta');
				const bioEl = document.getElementById('case-modal-bio');
				const betterEl = document.getElementById('case-modal-better');
				const worstEl = document.getElementById('case-modal-worst');

				function openCaseModal(btn) {
					if (!modal) return;
					const name = btn.getAttribute('data-name') || '';
					const role = btn.getAttribute('data-role') || '';
					const location = btn.getAttribute('data-location') || '';
					const avatar = btn.getAttribute('data-avatar') || '';
					const bio = btn.getAttribute('data-bio') || '';
					const better = btn.getAttribute('data-better') || '';
					const worst = btn.getAttribute('data-worst') || '';

					if (nameEl) nameEl.textContent = name;
					if (metaEl) metaEl.textContent = role + (location ? ' • ' + location : '');
					if (avatarImg) {
						avatarImg.src = avatar;
						avatarImg.alt = name;
					}
					if (bioEl) bioEl.textContent = bio;
					if (betterEl) betterEl.textContent = better;
					if (worstEl) worstEl.textContent = worst;

					modal.style.display = 'flex';
					document.body.style.overflow = 'hidden';
				}

				function closeCaseModal() {
					if (!modal) return;
					modal.style.display = 'none';
					document.body.style.overflow = '';
				}

				document.querySelectorAll('.contributor-read-more-btn').forEach(btn => {
					btn.addEventListener('click', () => openCaseModal(btn));
				});

				closeBtn?.addEventListener('click', closeCaseModal);

				modal?.addEventListener('click', (e) => {
					if (e.target === modal) {
						closeCaseModal();
					}
				});

				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
						closeCaseModal();
					}
				});
			})();

			// Sticky Reader Navigation Toolbar Dropdown click toggle with hover intent
			(function() {
				const dropdowns = document.querySelectorAll('.toolbar-dropdown');
				dropdowns.forEach(dd => {
					const trigger = dd.querySelector('.toolbar-trigger');
					let closeTimer = null;

					// Smooth mouseover with 220ms grace window so cursor never drops menu
					dd.addEventListener('mouseenter', () => {
						if (closeTimer) clearTimeout(closeTimer);
						dropdowns.forEach(d => {
							if (d !== dd) {
								d.classList.remove('is-open');
								d.querySelector('.toolbar-trigger')?.setAttribute('aria-expanded', 'false');
							}
						});
						dd.classList.add('is-open');
						trigger?.setAttribute('aria-expanded', 'true');
					});

					dd.addEventListener('mouseleave', () => {
						closeTimer = setTimeout(() => {
							dd.classList.remove('is-open');
							trigger?.setAttribute('aria-expanded', 'false');
						}, 220);
					});

					trigger?.addEventListener('click', (e) => {
						e.stopPropagation();
						const isOpen = dd.classList.contains('is-open');
						dropdowns.forEach(d => {
							d.classList.remove('is-open');
							d.querySelector('.toolbar-trigger')?.setAttribute('aria-expanded', 'false');
						});
						if (!isOpen) {
							dd.classList.add('is-open');
							trigger.setAttribute('aria-expanded', 'true');
						}
					});

					// Immediately close dropdown when user clicks any destination link
					dd.querySelectorAll('.toolbar-menu a').forEach(link => {
						link.addEventListener('click', () => {
							dd.classList.remove('is-open');
							trigger?.setAttribute('aria-expanded', 'false');
						});
					});
				});

				// Close when clicking any menu item or outside
				document.addEventListener('click', (e) => {
					dropdowns.forEach(dd => {
						if (!dd.contains(e.target)) {
							dd.classList.remove('is-open');
							dd.querySelector('.toolbar-trigger')?.setAttribute('aria-expanded', 'false');
						}
					});
				});

				// Close on Escape key
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') {
						dropdowns.forEach(dd => {
							dd.classList.remove('is-open');
							dd.querySelector('.toolbar-trigger')?.setAttribute('aria-expanded', 'false');
						});
					}
				});
			})();
		</script>

		<Footer />
	
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // BMS Questionnaire LocalStorage Persistence & Interactive Controls
    const STORAGE_KEY = 'bms_book_questionnaire_v1';
    
    // Elements
    const inputs = document.querySelectorAll('.bms-input-persist');
    const painSlider = document.getElementById('bms_pain_slider');
    const painDisplay = document.getElementById('bms_pain_val_display');
    const printBtn = document.getElementById('bms_print_btn');
    const clearBtn = document.getElementById('bms_clear_btn');
    const statusText = document.getElementById('bms_persist_status');

    if (!inputs.length) return;

    // Load saved answers
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      inputs.forEach(input => {
        const name = input.name;
        if (!name || saved[name] === undefined) return;

        if (input.type === 'checkbox') {
          input.checked = Boolean(saved[name]);
        } else if (input.type === 'radio') {
          if (input.value === saved[name]) input.checked = true;
        } else if (input.type === 'range') {
          input.value = saved[name];
          if (painDisplay) painDisplay.textContent = saved[name] + ' / 10';
        } else {
          input.value = saved[name];
        }
      });
    } catch (e) {
      console.warn('Could not load BMS questionnaire data', e);
    }

    // Save helper
    function saveAll() {
      const data = {};
      inputs.forEach(input => {
        const name = input.name;
        if (!name) return;
        if (input.type === 'checkbox') {
          data[name] = input.checked;
        } else if (input.type === 'radio') {
          if (input.checked) data[name] = input.value;
        } else {
          data[name] = input.value;
        }
      });
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
        if (statusText) {
          statusText.textContent = 'Answers saved automatically in this browser.';
        }
      } catch (e) {
        console.warn('Could not save BMS questionnaire data', e);
      }
    }

    // Attach listeners
    inputs.forEach(input => {
      input.addEventListener('change', saveAll);
      input.addEventListener('input', () => {
        if (input.type === 'range' && painDisplay) {
          painDisplay.textContent = input.value + ' / 10';
        }
        if (input.tagName === 'TEXTAREA' || input.type === 'text') {
          saveAll();
        }
      });
    });

    // Slider listener
    if (painSlider && painDisplay) {
      painSlider.addEventListener('input', (e) => {
        painDisplay.textContent = e.target.value + ' / 10';
      });
    }

    // Print button
    if (printBtn) {
      printBtn.addEventListener('click', () => {
        window.print();
      });
    }

    // Clear button
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (confirm('Are you sure you want to clear your saved answers in this questionnaire?')) {
          localStorage.removeItem(STORAGE_KEY);
          inputs.forEach(input => {
            if (input.type === 'checkbox' || input.type === 'radio') {
              input.checked = false;
            } else if (input.type === 'range') {
              input.value = 7;
              if (painDisplay) painDisplay.textContent = '7 / 10';
            } else {
              input.value = '';
            }
          });
          if (statusText) statusText.textContent = 'Fields cleared.';
        }
      });
    }

    // Automatically synchronize sequential Arabic page numbers and TOC/menu references across all book pages
    const allBookPages = Array.from(document.querySelectorAll('.book-viewport > .book-page'));
    let inMain = false;
    let mainPageNum = 0;
    const pageMap = {};
    allBookPages.forEach((sec) => {
      if (sec.id === 'part-1-page' || sec.id === 'page-1') inMain = true;
      if (!inMain) return;
      mainPageNum++;
      const numStr = String(mainPageNum);
      pageMap[sec.id] = numStr;
      // Also map all anchor IDs located inside this section so chapter anchors match the page they start on
      sec.querySelectorAll('[id]').forEach((child) => {
        if (child.id && !pageMap[child.id]) {
          pageMap[child.id] = numStr;
        }
      });
      const footerSpan = sec.querySelector('.page-number-footer span');
      if (footerSpan) footerSpan.textContent = numStr;
      const countLbl = sec.querySelector('.page-running-head .page-count-label');
      if (countLbl) countLbl.textContent = 'Page ' + numStr;
    });

    document.querySelectorAll('.toc-item, .toc-sub-row').forEach((item) => {
      const link = item.querySelector('a.toc-link, a.toc-sub-link');
      const numSpan = item.querySelector('.toc-num, .toc-sub-num');
      if (!link || !numSpan) return;
      const href = link.getAttribute('href');
      if (!href || !href.startsWith('#')) return;
      let tid = href.slice(1);
      if (tid === 'bibliography') tid = 'page-83';
      if (pageMap[tid]) numSpan.textContent = pageMap[tid];
    });

    document.querySelectorAll('.toolbar-menu a').forEach((link) => {
      const href = link.getAttribute('href');
      const numSpan = link.querySelector('.menu-num');
      if (!href || !href.startsWith('#') || !numSpan) return;
      const tid = href.slice(1);
      if (pageMap[tid]) numSpan.textContent = 'p. ' + pageMap[tid];
    });
  });
</script>

