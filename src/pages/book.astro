				position: absolute;
				top: 1.1rem;
				right: 1.1rem;
				background: transparent;
				border: none;
				color: #94a3b8;
				font-size: 1.35rem;
				cursor: pointer;
				line-height: 1;
				padding: 0.25rem 0.5rem;
				border-radius: 6px;
				transition: color 0.15s, background 0.15s;
