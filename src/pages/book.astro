			.copyright-disclaimer-box {
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 6px;
				padding: 0.85rem 1rem;
				margin-top: 1.25rem;
				font-size: 0.75rem;
				line-height: 1.55;
				color: #64748b;
