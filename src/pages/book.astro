---
// Redirect /book to /books (the catalog index)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/books" />
    <link rel="canonical" href="https://decodingtheburn.com/books" />
    <title>Redirecting to Books...</title>
    <script is:inline>
      const hash = window.location.hash || '';
      const search = window.location.search || '';
      // If someone requested a specific page/chapter anchor from the old /book URL, route directly to /draft#anchor
      if (hash) {
        window.location.replace('/draft' + search + hash);
      } else {
        window.location.replace('/books' + search);
      }
    </script>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem; text-align: center; color: #334155; background: #020005;">
    <p style="color: #cbd5e1;">Redirecting to <a href="/books" id="redirect-link" style="color: #c084fc; font-weight: 700;">Books &amp; Publications</a>...</p>
    <script is:inline>
      const link = document.getElementById('redirect-link');
      if (link && window.location.hash) {
        link.href = '/draft' + window.location.hash;
        link.textContent = 'Decoding The Burn (Draft)';
      }
    </script>
  </body>
</html>
