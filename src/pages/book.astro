						<div id="ch19-emergency-warning" class="quiz-book-card bms-emergency-alert-card" style="margin-bottom: 1.25rem; padding: 1.15rem 1.35rem; background: #fef2f2; border: 1.5px solid #ef4444; border-radius: 10px;">
