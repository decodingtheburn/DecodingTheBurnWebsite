			/* 2-Column Single-Page Table of Contents */
			.toc-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				column-gap: 2.5rem;
				row-gap: 1.5rem;
				margin-top: 1.25rem;
			}

			.toc-main-title {
				font-family: 'Cinzel', serif;
				font-size: clamp(2.25rem, 4vw, 2.85rem);
				font-weight: 800;
				letter-spacing: 0.16em;
				text-indent: 0.05em;
				line-height: 1.15;
				color: #0f172a;
				text-transform: uppercase;
				padding: 2.25rem 0 2rem 1.25rem;
				margin: 0 0 2rem 0;
				border-bottom: 2px solid #f1f5f9;
				text-align: left;
			}

			.toc-centered-container {
				max-width: 660px;
				margin: 1.85rem auto 1rem;
			}

			.toc-centered-container .toc-group {
				margin-bottom: 2.25rem;
			}

			.toc-centered-container .toc-group:last-child {
				margin-bottom: 0.5rem;
			}

			.toc-centered-container .toc-part-header {
				font-size: 0.96rem;
				letter-spacing: 0.04em;
				color: #7c3aed;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				margin-bottom: 0.85rem;
				padding-bottom: 0.4rem;
			}

			.toc-centered-container .toc-item {
				padding: 0.45rem 0;
				font-size: 1.02rem;
			}

			.toc-centered-container .toc-link {
				max-width: 500px;
			}

			.toc-group {
				margin-bottom: 0.5rem;
			}

			.toc-part-header {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.8rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #7c3aed;
				margin-bottom: 0.35rem;
				border-bottom: 1.5px solid #e2e8f0;
				padding-bottom: 0.25rem;
			}

			.toc-part-purpose {
				font-family: 'Lora', Georgia, serif;
				font-size: 0.86rem;
				font-style: italic;
				line-height: 1.5;
				color: #475569;
				margin: 0 0 0.65rem;
				text-wrap: pretty;
			}

			.toc-item {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				padding: 0.22rem 0;
				font-family: 'Lora', serif;
				font-size: 0.88rem;
			}

			.toc-link {
				color: #1e293b;
				text-decoration: none;
				transition: color 0.15s ease;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
