			/* Book Back Cover (Full Page Dimensions Matching .book-page) */
			.book-backcover-container {
				display: flex;
				justify-content: center;
				margin-top: 2rem;
				margin-bottom: 4rem;
				width: 100%;
			}

			.book-backcover {
				position: relative;
				width: 100%;
				max-width: 100%;
				min-height: 1050px;
				height: auto;
				background: radial-gradient(circle at 50% 25%, #240b3b 0%, #150726 55%, #080310 100%);
				color: #ffffff;
				border-radius: 8px;
				box-shadow: 
					0 30px 70px -15px rgba(0, 0, 0, 0.75),
					0 10px 30px rgba(42, 8, 69, 0.45),
					0 0 0 1px rgba(168, 85, 247, 0.2),
					inset -16px 0 26px rgba(0, 0, 0, 0.85);
				overflow: hidden;
				border-right: 22px solid #06020c;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				padding: 5.5rem 4.75rem 4.5rem;
				box-sizing: border-box;
				text-align: left;
			}

			.book-backcover::before {
				content: '';
				position: absolute;
				top: 0;
				bottom: 0;
				right: 0;
