				padding: 3.5rem 1.5rem;
				box-sizing: border-box;
				gap: 3.5rem;
			}

			.interior-title-eyebrow {
				font-family: 'Montserrat', sans-serif !important;
				font-size: 0.84rem;
				font-weight: 700;
				letter-spacing: 0.24em;
				color: #7c3aed;
				text-transform: uppercase;
				margin-bottom: 1.5rem;
			}

			.interior-title-main {
				font-family: 'Montserrat', sans-serif !important;
				font-size: 2.85rem;
				font-weight: 800;
				line-height: 1.15;
				color: #0f172a;
				margin: 0 0 1rem;
