				border-radius: 0 8px 8px 0;
				padding: 1.25rem 1.45rem;
				margin-top: 0.5rem;
			}

			.exec-takeaway-title {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.95rem;
				font-weight: 800;
