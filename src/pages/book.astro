			/* Blank Flyleaf Page */
			.book-page-blank {
				background-color: #ffffff;
				border-radius: 8px;
				box-shadow: 
					0 18px 40px -8px rgba(0, 0, 0, 0.25),
					0 6px 18px rgba(0, 0, 0, 0.15),
					0 0 0 1px rgba(0, 0, 0, 0.06);
				padding: 4.25rem 4.75rem 4rem;
				margin-bottom: 4rem;
				position: relative;
				border-left: 1px solid #f1f5f9;
				min-height: 1050px;
				height: auto;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
