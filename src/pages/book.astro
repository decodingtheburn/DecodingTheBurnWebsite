			.interior-title-publisher {
				font-family: 'Montserrat', sans-serif !important;
				font-size: 0.82rem;
				font-weight: 700;
				letter-spacing: 0.18em;
				color: #1e293b;
				text-transform: uppercase;
				margin-bottom: 0.25rem;
			}

			.interior-title-loc {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.76rem;
				color: #94a3b8;
