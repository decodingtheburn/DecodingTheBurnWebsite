---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Decoding the Burn (Book Draft) | First Principles of BMS" 
			description="A look at the first principles of pain receptors in Burning Mouth Syndrome: Dental Hardware Leaks, Acid Chemistry, and Calming the Oral Neuropathic Circuit." 
			noindex={true}
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		<style>
			:root {
				--book-bg: #ecefe6;
				--paper-color: #ffffff;
				--paper-border: #e2e8f0;
				--ink-color: #1a202c;
				--ink-subtle: #4a5568;
				--book-spine-gold: #c5a059;
				--book-cover-bg: #090514;
				--brand-purple-deep: #1e0b38;
				--brand-purple-dark: #2a0845;
				--brand-rose-subtle: #fb7185;
			}

			body {
				background-color: #0d091a;
				color: var(--ink-color);
				font-family: 'Lora', Georgia, serif;
				margin: 0;
				padding: 0;
				-webkit-font-smoothing: antialiased;
			}

			.book-viewport {
				max-width: 880px;
				margin: 3rem auto 7rem;
				padding: 0 1.5rem;
			}

			/* Book Secondary Sticky Navigation Bar (Clean, 1-Line High with Dropdowns) */
			.reading-toolbar {
				position: -webkit-sticky;
				position: sticky;
				top: 70px;
				z-index: 950;
				display: flex;
				justify-content: center;
				align-items: center;
				background: rgba(14, 8, 26, 0.98);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				padding: 0 1.25rem;
				height: 48px;
				border: 1px solid rgba(168, 85, 247, 0.28);
				border-top: none;
				box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.75);
				margin: 0 auto 3rem;
				font-family: 'Plus Jakarta Sans', sans-serif;
				width: 100%;
				box-sizing: border-box;
				border-radius: 0 0 12px 12px;
			}

			.toolbar-actions {
				display: flex;
				align-items: center;
				gap: 0.35rem;
				height: 100%;
				width: 100%;
				max-width: 820px;
				justify-content: space-between;
			}

			.toolbar-nav-group {
				display: flex;
				align-items: center;
				gap: 0.25rem;
				height: 100%;
			}

			/* Individual Dropdown Item in Sticky Bar */
			.toolbar-dropdown {
				position: relative;
				display: inline-flex;
				align-items: center;
				height: 100%;
			}

			.toolbar-trigger {
				background: transparent;
				border: none;
				color: #cbd5e1;
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.82rem;
				font-weight: 700;
				padding: 0.35rem 0.65rem;
				border-radius: 6px;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
				transition: all 0.15s ease;
				text-decoration: none;
				white-space: nowrap;
				line-height: 1;
			}

			.toolbar-trigger svg {
				transition: transform 0.2s ease;
				stroke: #94a3b8;
			}

			.toolbar-trigger:hover,
			.toolbar-dropdown:hover .toolbar-trigger,
			.toolbar-dropdown.is-open .toolbar-trigger {
				color: #ffffff;
				background: rgba(168, 85, 247, 0.18);
			}

			.toolbar-trigger:hover svg,
			.toolbar-dropdown:hover .toolbar-trigger svg,
			.toolbar-dropdown.is-open .toolbar-trigger svg {
				stroke: #c084fc;
				transform: rotate(180deg);
			}

			/* Dropdown Menu Container (Single-Line Items Guaranteed) */
			.toolbar-menu {
				position: absolute;
				top: 100%;
				left: 0;
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 10px;
				box-shadow: 0 18px 40px -10px rgba(0, 0, 0, 0.35), 0 4px 12px rgba(0, 0, 0, 0.08);
				width: max-content;
				min-width: 280px;
				max-width: calc(100vw - 32px);
				padding: 0.45rem;
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
				opacity: 0;
				pointer-events: none;
				transform: translateY(6px);
				transition: opacity 0.18s ease, transform 0.18s ease;
				z-index: 1000;
			}

			.toolbar-dropdown:hover .toolbar-menu,
			.toolbar-dropdown:focus-within .toolbar-menu,
			.toolbar-dropdown.is-open .toolbar-menu {
				opacity: 1;
				pointer-events: auto;
				transform: translateY(2px);
			}

			.toolbar-menu-header {
				font-size: 0.68rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: #7c3aed;
				padding: 0.4rem 0.65rem 0.25rem;
				border-bottom: 1px solid #f1f5f9;
				margin-bottom: 0.2rem;
				white-space: nowrap;
			}

			.toolbar-menu a {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.45rem 0.65rem;
				color: #1e293b;
				font-size: 0.8rem;
				font-weight: 600;
				text-decoration: none;
				border-radius: 6px;
				transition: background 0.15s ease, color 0.15s ease;
				line-height: 1.3;
				white-space: nowrap;
			}

			.toolbar-menu a span:first-child {
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.toolbar-menu a .menu-num {
				font-size: 0.72rem;
				font-weight: 700;
				color: #7c3aed;
				margin-left: 0.65rem;
				white-space: nowrap;
				flex-shrink: 0;
			}

			.toolbar-menu a:hover {
				background: #f5f3ff;
				color: #7c3aed;
			}

			.toolbar-start-btn {
				background: #7c3aed;
				color: #ffffff;
				font-size: 0.78rem;
				font-weight: 700;
				padding: 0.38rem 0.85rem;
				border-radius: 6px;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				transition: background 0.15s ease, transform 0.15s ease;
				white-space: nowrap;
			}

			.toolbar-start-btn:hover {
				background: #6d28d9;
				transform: translateY(-1px);
			}

			/* Book Cover (Proportional 1:1.5 Aspect Ratio) */
			.book-cover-container {
				display: flex;
				justify-content: center;
				margin-bottom: 4rem;
			}

			.book-cover {
				position: relative;
				width: 100%;
				max-width: 540px;
				aspect-ratio: 1 / 1.52; /* Standard 6"x9" book cover proportion */
				background: radial-gradient(circle at 50% 25%, #240b3b 0%, #150726 55%, #080310 100%);
				color: #ffffff;
				border-radius: 10px 18px 18px 10px;
				box-shadow: 
					0 30px 70px -15px rgba(0, 0, 0, 0.75),
					0 10px 30px rgba(42, 8, 69, 0.45),
					0 0 0 1px rgba(168, 85, 247, 0.2),
					inset 14px 0 24px rgba(0, 0, 0, 0.85);
				text-align: center;
				overflow: hidden;
				border-left: 20px solid #06020c;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				padding: 3rem 2.25rem 2.5rem;
				box-sizing: border-box;
			}

			/* Book Spine Ridge highlight */
			.book-cover::before {
				content: '';
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				width: 3px;
				background: linear-gradient(180deg, rgba(251, 113, 133, 0.35) 0%, rgba(147, 51, 234, 0.2) 50%, rgba(251, 113, 133, 0.3) 100%);
				box-shadow: 2px 0 8px rgba(0, 0, 0, 0.8);
				z-index: 5;
			}

			.cover-gold-border {
				border: 1.5px solid rgba(168, 85, 247, 0.35);
				border-radius: 8px;
				padding: 2.25rem 1.75rem;
				position: relative;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				height: 100%;
				box-sizing: border-box;
				background: radial-gradient(circle at 50% 50%, rgba(147, 51, 234, 0.08) 0%, transparent 80%);
			}

			.cover-eyebrow {
				font-family: 'Cinzel', serif;
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.22em;
				color: #e9d5ff;
				text-transform: uppercase;
				margin-bottom: 0.75rem;
			}

			.cover-title {
				font-family: 'Cinzel', serif;
				font-size: clamp(2rem, 4.2vw, 2.75rem);
				font-weight: 800;
				line-height: 1.15;
				color: #ffffff;
				margin: 0 0 0.85rem;
				text-shadow: 0 4px 25px rgba(0, 0, 0, 0.85);
			}

			.cover-subtitle {
				font-family: 'Lora', serif;
				font-size: 0.95rem;
				font-weight: 400;
				font-style: italic;
				color: #e2e8f0;
				line-height: 1.55;
				max-width: 440px;
				margin: 0 auto;
			}

			/* Center Illustration */
			.cover-illustration-wrap {
				position: relative;
				display: flex;
				justify-content: center;
				align-items: center;
				margin: 1.5rem 0;
			}

			.cover-tooth-glow {
				position: absolute;
				width: 180px;
				height: 180px;
				border-radius: 50%;
				background: radial-gradient(circle, rgba(147, 51, 234, 0.35) 0%, rgba(225, 29, 72, 0.2) 50%, transparent 75%);
				filter: blur(22px);
				pointer-events: none;
			}

			.cover-tooth-img {
				position: relative;
				z-index: 2;
				max-height: 190px;
				width: auto;
				object-fit: contain;
				filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.8)) drop-shadow(0 0 15px rgba(168, 85, 247, 0.3));
				opacity: 0.94;
				transition: transform 0.4s ease, opacity 0.4s ease;
			}

			.book-cover:hover .cover-tooth-img {
				transform: scale(1.03);
				opacity: 0.98;
			}

			.cover-divider {
				width: 70px;
				height: 1.5px;
				background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.7), transparent);
				margin: 1rem auto;
			}

			.cover-author {
				font-family: 'Cinzel', serif;
				font-size: 1.15rem;
				font-weight: 700;
				letter-spacing: 0.16em;
				color: #f8fafc;
				text-transform: uppercase;
				margin-bottom: 0.35rem;
			}

			.cover-author-sub {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.82rem;
				color: #cbd5e1;
				font-weight: 500;
			}

			.cover-edition-tag {
				display: block;
				margin-top: 0.75rem;
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.76rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: #a78bfa;
			}

			/* Proportional Book Page (Content Pages) */
			.book-page {
				background-color: #ffffff;
				border-radius: 8px;
				box-shadow: 
					0 18px 40px -8px rgba(0, 0, 0, 0.25),
					0 6px 18px rgba(0, 0, 0, 0.15),
					0 0 0 1px rgba(0, 0, 0, 0.06);
				padding: 4.25rem 4.75rem 4rem;
				margin-bottom: 4rem;
				position: relative;
				border-left: 1px solid #f1f5f9;
				min-height: 1050px;
				height: auto;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			/* Single-Page Table of Contents (Exception Layout) */
			.book-page-toc {
				background-color: #ffffff;
				border-radius: 8px;
				box-shadow: 
					0 18px 40px -8px rgba(0, 0, 0, 0.25),
					0 6px 18px rgba(0, 0, 0, 0.15),
					0 0 0 1px rgba(0, 0, 0, 0.06);
				padding: 3.5rem 4rem 3rem;
				margin-bottom: 4rem;
				position: relative;
				border-left: 1px solid #f1f5f9;
				min-height: 1050px;
				height: auto;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			/* Page Book Spine Shadow on Left Edge */
			.book-page::before,
			.book-page-toc::before {
				content: '';
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				width: 18px;
				background: linear-gradient(90deg, rgba(0, 0, 0, 0.045) 0%, rgba(0, 0, 0, 0.012) 60%, transparent 100%);
				pointer-events: none;
			}

			/* Page Header & Running Head */
			.page-running-head {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				color: #475569;
				text-transform: uppercase;
				border-bottom: 1px solid #e2e8f0;
				padding-bottom: 0.85rem;
				margin-bottom: 2.25rem;
			}

			.page-running-head .chapter-header-label {
				color: #7c3aed;
			}

			.page-running-head .page-count-label {
				color: #94a3b8;
				font-weight: 600;
			}

			.page-number-footer {
				display: flex;
				justify-content: center;
				align-items: center;
				margin-top: 2rem;
				padding-top: 1.25rem;
				border-top: 1px solid #f8fafc;
				font-family: 'Cinzel', serif;
				font-size: 0.92rem;
				font-weight: 600;
				color: #94a3b8;
			}

			/* Section / Part Header Banner (Top of Chapter Opening Page) */
			.part-break-banner {
				background: #f8fafc;
				border-left: 4px solid #7c3aed;
				padding: 0.9rem 1.25rem;
				margin-bottom: 1.75rem;
				border-radius: 0 8px 8px 0;
			}

			.part-break-title {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.82rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: #7c3aed;
				margin: 0;
			}

			.chapter-title {
				font-family: 'Lora', Georgia, serif;
				font-size: clamp(1.6rem, 3vw, 2.1rem);
				font-weight: 600;
				line-height: 1.25;
				color: #0f172a;
				margin-bottom: 1.85rem;
				text-wrap: balance;
			}

			.page-body-content {
				flex-grow: 1;
			}

			.chapter-content p {
				font-size: 1.02rem;
				line-height: 1.78;
				color: #27272a;
				margin-bottom: 1.25rem;
				text-wrap: pretty;
			}

			/* First paragraph drop cap on Chapter opening page */
			.chapter-content.is-first-page p:first-of-type::first-letter {
				font-family: 'Cinzel', serif;
				font-size: 3.2rem;
				float: left;
				line-height: 0.82;
				padding-right: 0.65rem;
				padding-top: 0.2rem;
				color: #09060f;
				font-weight: 700;
			}

			.chapter-content h3, 
			.chapter-content h4 {
				font-family: 'Plus Jakarta Sans', sans-serif;
				color: #0f172a;
				font-weight: 700;
				margin-top: 1.6rem;
				margin-bottom: 0.75rem;
				line-height: 1.35;
			}

			.chapter-content h3 {
				font-size: 1.18rem;
				border-bottom: 1px solid #f1f5f9;
				padding-bottom: 0.35rem;
			}

			.chapter-content h4 {
				font-size: 1.02rem;
			}

			/* Callout / Pull quote inside book */
			.book-callout {
				margin: 1.25rem 0;
				padding: 1rem 1.35rem;
				background: #f8fafc;
				border-left: 3px solid #7c3aed;
				font-style: italic;
				color: #334155;
				border-radius: 0 6px 6px 0;
			}

			/* 2-Column Single-Page Table of Contents */
			.toc-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				column-gap: 2.5rem;
				row-gap: 1.5rem;
				margin-top: 1.25rem;
			}

			.toc-centered-container {
				max-width: 660px;
				margin: 1.85rem auto 1rem;
			}

			.toc-centered-container .toc-group {
				margin-bottom: 2.25rem;
			}

			.toc-centered-container .toc-group:last-child {
				margin-bottom: 0.5rem;
			}

			.toc-centered-container .toc-part-header {
				font-size: 0.88rem;
				letter-spacing: 0.08em;
				margin-bottom: 0.85rem;
				padding-bottom: 0.4rem;
			}

			.toc-centered-container .toc-item {
				padding: 0.45rem 0;
				font-size: 1.02rem;
			}

			.toc-centered-container .toc-link {
				max-width: 500px;
			}

			.toc-group {
				margin-bottom: 0.5rem;
			}

			.toc-part-header {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.8rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #7c3aed;
				margin-bottom: 0.45rem;
				border-bottom: 1.5px solid #e2e8f0;
				padding-bottom: 0.25rem;
			}

			.toc-item {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				padding: 0.22rem 0;
				font-family: 'Lora', serif;
				font-size: 0.88rem;
			}

			.toc-link {
				color: #1e293b;
				text-decoration: none;
				transition: color 0.15s ease;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				max-width: 250px;
			}

			.toc-link:hover {
				color: #7c3aed;
			}

			.toc-dots {
				flex-grow: 1;
				border-bottom: 1px dotted #cbd5e1;
				margin: 0 0.4rem;
				height: 1px;
			}

			.toc-num {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.78rem;
				font-weight: 600;
				color: #64748b;
			}

			/* Book Overview Typography (Grouped by Part) */
			.overview-part-block {
				margin-bottom: 2.25rem;
			}

			.overview-part-title {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.88rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #7c3aed;
				margin-bottom: 1.15rem;
				border-bottom: 1.5px solid #e2e8f0;
				padding-bottom: 0.4rem;
			}

			.overview-chapter-row {
				display: grid;
				grid-template-columns: 1.55fr 1fr;
				gap: 1.75rem;
				align-items: center;
				margin-bottom: 1.85rem;
				padding-bottom: 1.35rem;
				border-bottom: 1px dashed #e2e8f0;
			}

			.overview-chapter-row:last-child {
				border-bottom: none;
				margin-bottom: 0.5rem;
				padding-bottom: 0;
			}

			.overview-main {
				flex: 1;
			}

			.overview-item-title {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.98rem;
				font-weight: 700;
				color: #0f172a;
				margin-top: 0;
				margin-bottom: 0.45rem;
			}

			.overview-item-title a {
				color: #0f172a;
				text-decoration: none;
				transition: color 0.15s ease;
			}

			.overview-item-title a:hover {
				color: #7c3aed;
			}

			.overview-sentence {
				font-family: 'Lora', Georgia, serif;
				font-size: 0.98rem;
				line-height: 1.72;
				color: #27272a;
				margin-bottom: 0.55rem;
				text-wrap: pretty;
			}

			.overview-subtopics {
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-left: 3.5px solid #7c3aed;
				border-radius: 0 8px 8px 0;
				padding: 0.95rem 1.15rem 0.95rem 1.25rem;
			}

			.overview-subtopics-header {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.72rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #7c3aed;
				margin-bottom: 0.6rem;
			}

			.overview-subtopics ol {
				margin: 0;
				padding-left: 1.25rem;
			}

			.overview-subtopics li {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.82rem;
				line-height: 1.5;
				color: #334155;
				margin-bottom: 0.45rem;
			}

			.overview-subtopics li:last-child {
				margin-bottom: 0;
			}

			/* Reported Interventions & Triggers Research Table */
			.research-table-wrapper {
				margin: 1.5rem 0 1.75rem;
				border: 1px solid #e2e8f0;
