						<h2 class="chapter-title chapter-opener-title">Test Your Acidity&nbsp;Threshold</h2>
						<div class="chapter-opener-divider"></div>
					</div>

					<div class="chapter-content is-first-page">
						<div class="book-callout" style="margin-top: 0; margin-bottom: 1.15rem; border-left: 4px solid #7c3aed; background: #fdf4ff;">
							<span class="book-callout-icon" aria-hidden="true" style="color: #7c3aed;">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
