					<span>28a2</span>
				</div>
			</section>

			<!-- Chapter 10: How Pain Is Created (Page 4 of 11: Master Catalog Part 1) -->

			<section class="book-page" id="page-28b">
				<div class="page-body-content">
					<div class="page-running-head">
						<span class="chapter-header-label">Part III &bull; Chapter 10: How Pain Is Created</span>
						<span class="page-count-label">Page 28b</span>
