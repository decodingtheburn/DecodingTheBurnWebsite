			/* Copyright Notice Page */
			.copyright-page-wrap {
				height: 100%;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				padding: 2rem 0;
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.82rem;
				line-height: 1.7;
				color: #475569;
