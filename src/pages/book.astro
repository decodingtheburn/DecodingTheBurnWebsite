				<div id="chapter-27" style="scroll-margin-top: 5rem;"></div>
				<div id="ch27-outcomes" style="scroll-margin-top: 5rem;"></div>

				<div class="page-body-content">
					<div class="page-running-head">
						<span class="chapter-header-label">Chapter 28: Remission vs. Progression</span>
						<span class="page-count-label">Page 71</span>
