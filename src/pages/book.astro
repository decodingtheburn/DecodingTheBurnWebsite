			.interior-title-author {
				font-family: 'Montserrat', sans-serif !important;
				font-size: 1.35rem;
				font-weight: 700;
				letter-spacing: 0.16em;
				color: #0f172a;
				text-transform: uppercase;
				margin-bottom: 0.4rem;
			}

			.interior-title-cred {
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.88rem;
				color: #64748b;
