			/* Inline Selection Feedback Trigger & Modal */
			.selection-feedback-trigger {
				position: absolute;
				display: none;
				align-items: center;
				gap: 0.45rem;
				background: #1e112a;
				color: #f5f3ff;
				border: 1px solid #7c3aed;
				padding: 0.42rem 0.85rem;
				border-radius: 8px;
				font-family: 'Plus Jakarta Sans', sans-serif;
				font-size: 0.78rem;
				font-weight: 700;
				box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.45), 0 0 14px rgba(124, 58, 237, 0.4);
				cursor: pointer;
				z-index: 1000;
				transform: translate(-50%, -100%);
				margin-top: -10px;
				transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
				user-select: none;
			}

			.selection-feedback-trigger:hover {
				background: #2e104b;
				box-shadow: 0 12px 28px -4px rgba(0, 0, 0, 0.5), 0 0 18px rgba(168, 85, 247, 0.55);
				transform: translate(-50%, -100%) scale(1.03);
			}

			.selection-feedback-trigger::after {
				content: '';
				position: absolute;
				top: 100%;
				left: 50%;
				transform: translateX(-50%);
				border-width: 6px;
				border-style: solid;
				border-color: #1e112a transparent transparent transparent;
			}

			.feedback-modal-backdrop {
				position: fixed;
				inset: 0;
				background: rgba(8, 3, 16, 0.75);
				backdrop-filter: blur(4px);
				display: none;
				justify-content: center;
				align-items: center;
				z-index: 9999;
				padding: 1.25rem;
			}

			.feedback-modal-card {
