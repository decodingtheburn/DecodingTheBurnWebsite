---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import authorPhoto from '../assets/denis-ethier.png';
import { sortPostsDescending } from '../utils/postUtils';

const rawPosts = await getCollection('blog', ({ data }) => !data.draft);
// Show posts tagged 'clinician' or 'both'
const clinicianPosts = sortPostsDescending(rawPosts).filter(post => {
	const tags = post.data.tags || [];
	return tags.includes('clinician') || tags.includes('both');
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="For Clinicians & Researchers | Decoding The Burn" 
			description="How dentists, periodontists, and physicians can collaborate with patient-led time-series data to discover clinical blind spots in Burning Mouth Syndrome." 
		/>
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section Following Homepage Model -->
			<section class="hero-centered-wrapper">
				<div class="hero-centered-header">
					<MedicalDisclaimer />
					<h1 class="hero-centered-title">
						How Clinicians &amp; Dentists Can Use This&nbsp;Site
					</h1>
					<p class="hero-centered-subtitle">
						When patients present with 10/10 oral burning and normal mucosa, standard exams reach their limits.
						Here is how dense, longitudinal patient data can help uncover hidden clinical blind&nbsp;spots.
					</p>
				</div>

				<!-- Video on Top -->
				<div class="hero-video-centered">
					<div class="video-placeholder-wrapper" style="cursor: default;">
						<Image 
							src={authorPhoto} 
							alt="Denis Ethier - BMS Clinician Orientation Video" 
							class="video-placeholder-img" 
							width={1400} 
							height={788}
						/>
					</div>
				</div>

				<!-- Clinician Message Card Under Video -->
				<article class="personal-story-section">
					<h2 class="story-heading">A Message to Clinicians: Why I Am Not Mad at&nbsp;You</h2>
					<div class="story-lead">
						<p>
							As a patient who spent months in agony consulting five dentists and five physicians, I know firsthand the impossible spot practitioners are placed in. You are given 15 minutes per patient, strict clinical guidelines, and textbooks that label BMS as 'idiopathic' or&nbsp;psychogenic.
						</p>
						<p>
							I am not mad at you. Routine in-office visits simply cannot capture microscopic biofilm dynamics, subtle CEJ micro-leaks, or hourly acid responses. This platform is built to partner with curious practitioners by sharing dense, longitudinal patient elimination data that bridges the gap between patient symptoms and clinical&nbsp;discovery.
						</p>
						<p class="continue-reading-p">
							<a href="/blog/the-stateless-clinic-and-time-series-medicine/" class="continue-reading-link">Read about time-series medicine and clinical blind spots &rarr;</a>
						</p>
					</div>
				</article>
			</section>

			<!-- 3 Core Ways Clinicians Can Leverage This Research -->
			<section class="methodology-container">
				<h2 class="section-heading">Clinical Blind Spots We&nbsp;Investigate</h2>
				<div class="methodology-grid">
					<div class="method-card">
						<div class="method-num">01</div>
						<h3 class="method-title">Biomechanical Micro-Leaks</h3>
						<p class="method-text">
							Explore how subtle cervical restoration overhangs, micro-abfractions along the cemento-enamel junction (CEJ), and exposed dentinal tubules create peripheral neuropathic firing loops that look completely normal on standard visual&nbsp;inspection.
						</p>
					</div>

					<div class="method-card">
						<div class="method-num">02</div>
						<h3 class="method-title">Phase-Contrast Microscopy &amp; Biofilms</h3>
						<p class="method-text">
							Review clinical protocols (such as Dr. Mark Bonner's periodontology method) evaluating subgingival parasites (<em>Entamoeba gingivalis</em>) and motile amoebae that conventional scaling and radiographs routinely&nbsp;miss.
						</p>
					</div>

					<div class="method-card">
						<div class="method-num">03</div>
						<h3 class="method-title">Time-Series Patient Elimination&nbsp;Data</h3>
						<p class="method-text">
							Analyze dense N=1 longitudinal datasets mapping dietary acid exposure (coffee, alcohol, citrus), nocturnal salivary evaporation, and oral mucosal recovery across thousands of tracked&nbsp;hours.
						</p>
					</div>
				</div>
			</section>

			<!-- Relevant Articles for Clinicians -->
			<section class="section-header recent-posts-header">
				<h2 class="recent-posts-title">Clinical Investigations &amp; Case&nbsp;Studies</h2>
				<p class="recent-posts-subtitle">Technical dissections, periodontal microscopy, and hardware mechanics for dentists and medical&nbsp;doctors.</p>
			</section>

			<div class="grid">
				{
					clinicianPosts.map((post, index) => {
						const postNumber = post.data.entryNumber ?? (index + 1);
						const imageSrc = typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage?.src;
						return (
							<article class="card">
								<a href={`/blog/${post.id}/`}>
									<div class="card-img" style={`background-image: url(${imageSrc || '/blog-placeholder-2.jpg'})`}></div>
									<div class="card-body">
										<div class="card-meta">
											<span class="meta-post-info"><strong class="meta-post-number">Post #{postNumber}</strong> • <FormattedDate date={post.data.pubDate} /></span>
										</div>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
										<span class="view-story">Read Clinical Case &rarr;</span>
									</div>
								</a>
							</article>
						);
					})
				}
			</div>

			<div style="text-align: center; margin: 3rem 0;">
				<a href="/blog" class="btn btn-outline" style="padding: 0.85rem 2.25rem;">View All Blog Entries +</a>
			</div>
		</main>
		<Footer />

		<style>
			.methodology-container {
				max-width: 1080px;
				margin: 1.5rem auto 4.5rem;
				padding: 0 1.5rem;
			}

			.section-heading {
				font-size: clamp(1.75rem, 3.5vw, 2.25rem);
				font-weight: 800;
				color: #0f172a;
				text-align: center;
				margin: 0 0 2rem 0;
				letter-spacing: -0.02em;
			}

			.methodology-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 2rem;
			}

			.method-card {
				background: #ffffff;
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 2.25rem 2rem;
				box-shadow: 0 4px 16px -4px rgba(15, 23, 42, 0.04);
			}

			.method-num {
				font-size: 1.5rem;
				font-weight: 900;
				color: #1d4ed8;
				margin-bottom: 0.75rem;
			}

			.method-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 0.75rem 0;
			}

			.method-text {
				font-size: 1rem;
				line-height: 1.65;
				color: #475569;
				margin: 0;
				text-wrap: pretty;
			}
		</style>
	</body>
</html>
