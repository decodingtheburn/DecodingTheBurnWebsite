---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "BMS Triggers & Protectors Catalog";
const description = "Comprehensive categorization of Burning Mouth Syndrome triggers and protectors: drinks, foods, dental factors, medications, and protective buffers.";

// 1. DRINKS CATEGORY
const drinkItems = [
	{
		name: "Soda & Energy Drinks",
		emoji: "🥤",
		status: "High Acid Trigger",
		zone: "red",
		metric: "pH 2.5",
		submetric: "Phosphoric & Citric Acid",
		desc: "Extremely corrosive chemical wash that strips tooth smear plugs and triggers ASIC3 sensors in seconds.",
		impact: "+10 Spike"
	},
	{
		name: "Wine (Red & White)",
		emoji: "🍷",
		status: "High Acid Trigger",
		zone: "red",
		metric: "pH 3.4",
		submetric: "Tartaric & Malic Acid",
		desc: "Ethanol opens mucosal permeability while sharp organic plant acids irritate underlying trigeminal nerve endings.",
		impact: "+10 Spike"
	},
	{
		name: "Sparkling & Carbonated Water",
		emoji: "🫧",
		status: "Acid Trigger",
		zone: "red",
		metric: "pH 3.6",
		submetric: "Carbonic Acid Wash",
		desc: "Even unflavored carbonation depresses oral pH, keeping tissues below the critical safety threshold.",
		impact: "+8 Spike"
	},
	{
		name: "Beer & Hard Ciders",
		emoji: "🍺",
		status: "Acid & Fermentation",
		zone: "red",
		metric: "pH 4.2",
		submetric: "Maltose & Organic Acid",
		desc: "Acidic liquid combined with fast-fermenting maltose sugars feeds oral bacteria to produce continuous acid.",
		impact: "+9 Spike"
	},
	{
		name: "Coffee (Regular & Decaf)",
		emoji: "☕",
		status: "Acid & Tannins",
		zone: "red",
		metric: "pH 5.0",
		submetric: "Chlorogenic & Quinic Acid",
		desc: "Moderate acidity combined with drying tannins penetrates exposed cervical root dentin.",
		impact: "+8 Spike"
	},
	{
		name: "Green & Herbal Teas",
		emoji: "🍵",
		status: "Astringent / Mild Acid",
		zone: "yellow",
		metric: "pH 5.5",
		submetric: "Tannins & Polyphenols",
		desc: "Mild acidity with drying astringency that can cause friction on sensitized tongue papillae.",
		impact: "+4 Delayed"
	},
	{
		name: "Plain Filtered Neutral Water",
		emoji: "💧",
		status: "Protective Buffer",
		zone: "green",
		metric: "pH 7.4",
		submetric: "Neutral Saliva Hydration",
		desc: "Restores normal oral moisture, flushes residual chemical acids, and dilutes bacterial byproducts.",
		impact: "-6 Relief"
	}
];

// 2. FOODS & DIET CATEGORY
const foodItems = [
	{
		name: "Lemon & Lime Juice",
		emoji: "🍋",
		status: "Aggressive Acid",
		zone: "red",
		metric: "pH 2.2",
		submetric: "Concentrated Citric Acid",
		desc: "Dissolves protective dentin smear plugs and floods ASIC3 proton receptors across tongue and palate.",
		impact: "+10 Spike"
	},
	{
		name: "Vinegar & Salad Dressings",
		emoji: "🥒",
		status: "High Volatile Acid",
		zone: "red",
		metric: "pH 2.6",
		submetric: "Acetic Acid",
		desc: "Highly volatile acetic acid penetrates open micro-tubules and causes immediate neurogenic firing.",
		impact: "+9 Spike"
	},
	{
		name: "Tomatoes & Pasta Sauces",
		emoji: "🍅",
		status: "Acidic Nightshade",
		zone: "red",
		metric: "pH 4.3",
		submetric: "Citric & Malic Acids",
		desc: "Concentrated fruit acids pool on the tongue and palate, causing persistent 48-hour flares.",
		impact: "+7 Spike"
	},
	{
		name: "Sweet & Savory Vegetables",
		emoji: "🥕",
		status: "Fermentable Sugar",
		zone: "yellow",
		metric: "6g to 9g Sugar",
		submetric: "Streptococcus Lactic Fuel",
		desc: "While raw vegetables have neutral pH, oral bacteria ferment residual sugars into localized lactic acid within 20 minutes.",
		impact: "+5 Delayed"
	},
	{
		name: "Bread, Starches & Grains",
		emoji: "🍞",
		status: "Fermentable Starch",
		zone: "yellow",
		metric: "Starch Pool",
		submetric: "Amylase to Maltose",
		desc: "Sticky starches adhere to tooth margins and break down into bacterial fuel over 12 to 24 hours.",
		impact: "+5 Delayed"
	},
	{
		name: "Beef, Lamb, Veal & Poultry",
		emoji: "🥩",
		status: "Zero-Acid Shield",
		zone: "green",
		metric: "pH 6.8",
		submetric: "0% Sugar / Non-Fermentable",
		desc: "Zero chemical plant acids and zero fermentable carbohydrates; cuts off oral bacterial lactic fuel completely.",
		impact: "-9 Relief"
	},
	{
		name: "Eggs & Animal Fats (Butter, Tallow)",
		emoji: "🍳",
		status: "Protective Lipid Shield",
		zone: "green",
		metric: "pH 7.0",
		submetric: "Mucosal Barrier Layer",
		desc: "Forms a non-acidic lipid barrier over exposed tooth margins and calms mucosal friction.",
		impact: "-8 Relief"
	}
];

// 3. DENTITION & DENTAL HARDWARE CATEGORY
const dentalItems = [
	{
		name: "Crown Margin Micro-Leakage",
		emoji: "🦷",
		status: "Bacterial Seepage",
		zone: "red",
		metric: "Sub-Micron",
		submetric: "Cement Margin Washout",
		desc: "Microscopic gaps between crown and natural tooth harbor bacteria that brew acid directly against dentinal nerves.",
		impact: "+9 Chronic"
	},
	{
		name: "Cervical Root Recession",
		emoji: "📐",
		status: "Exposed Conduits",
		zone: "red",
		metric: "20,000+ Tubules",
		submetric: "Open Fluid Micro-Canals",
		desc: "Receded gums leave porous root dentin unsealed, allowing everyday dietary acids to wash directly into the nerve pulp.",
		impact: "+10 Spike"
	},
	{
		name: "Periodontal Pockets (> 3mm)",
		emoji: "🔬",
		status: "Anaerobic Reservoir",
		zone: "red",
		metric: "Depth > 3mm",
		submetric: "Subgingival Biofilm",
		desc: "Deep pockets shelter bacteria that release continuous acidic byproducts where daily brushing cannot reach.",
		impact: "+7 Chronic"
	},
	{
		name: "Canine Guidance Bite Overload",
		emoji: "⚖️",
		status: "Mechanical Trauma",
		zone: "red",
		metric: "Excess Force",
		submetric: "Periodontal Ligament Strain",
		desc: "Occlusal prematurity inflames root ligaments, lowering firing thresholds and spreading pain through cranial branches.",
		impact: "+5 Sensitizing"
	},
	{
		name: "Class V Composite Bonding Shield",
		emoji: "🛡️",
		status: "Physical Tubule Seal",
		zone: "green",
		metric: "Resin Barrier",
		submetric: "Blocks Fluid & Acid Flow",
		desc: "Carefully placed composite resin over exposed root dentin permanently seals tubules against acid protons.",
		impact: "-9 Relief"
	},
	{
		name: "Crown Replacement & Airtight Seal",
		emoji: "✨",
		status: "Hardware Restoration",
		zone: "green",
		metric: "Zero Margin Gap",
		submetric: "Eliminates Decay Pocket",
		desc: "Removing compromised hardware, decontaminating decay, and placing a fresh sealed crown stops internal acid percolation.",
		impact: "-10 Relief"
	}
];

// 4. MEDICATIONS & SYSTEMIC FACTORS
const medicineItems = [
	{
		name: "Antihistamines & Decongestants",
		emoji: "💊",
		status: "Salivary Suppressor",
		zone: "red",
		metric: "Dry Mouth",
		submetric: "Strips Bicarbonate Buffer",
		desc: "Dries oral tissues and depletes saliva, leaving mucosal nerves defenseless against mild food acids.",
		impact: "+8 Flare"
	},
	{
		name: "Blood Pressure Drugs (Diuretics)",
		emoji: "🩺",
		status: "Fluid Reducer",
		zone: "red",
		metric: "Reduced Saliva",
		submetric: "Increases Acid Contact Time",
		desc: "Lowers resting salivary output, preventing natural dilution and remineralization after meals.",
		impact: "+6 Flare"
	},
	{
		name: "Toothpastes with SLS Detergent",
		emoji: "🪥",
		status: "Caustic Surfactant",
		zone: "red",
		metric: "Sodium Lauryl Sulfate",
		submetric: "Mucin Layer Stripping",
		desc: "Harsh foaming detergents strip the protective mucosal mucin layer, exposing bare nerve receptors.",
		impact: "+8 Spike"
	},
	{
		name: "Vitamin B12 (Methylcobalamin)",
		emoji: "🧬",
		status: "Myelin Protector",
		zone: "green",
		metric: "Target > 600 pg/mL",
		submetric: "Nerve Insulation Support",
		desc: "Supports peripheral nerve myelin sheath integrity, raising electrical firing thresholds so nerves resist irritation.",
		impact: "-6 Baseline"
	},
	{
		name: "Baking Soda (Sodium Bicarb) Rinse",
		emoji: "🧂",
		status: "Alkaline Buffer",
		zone: "green",
		metric: "pH 8.3",
		submetric: "Immediate Proton Scavenger",
		desc: "A mild rinse neutralizes acidic oral drops immediately after meals, calming burning flares rapidly.",
		impact: "-6 Relief"
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style is:global>
			body {
				background-color: #ffffff !important;
				color: #0f172a !important;
				font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
				margin: 0;
				padding: 0;
				line-height: 1.6;
			}

			.triggers-page {
				background-color: #ffffff;
				min-height: 100vh;
				padding-bottom: 6rem;
			}

			.hero-section {
				padding: 4rem 1.5rem 2.5rem;
				text-align: center;
				max-width: 980px;
				margin: 0 auto;
			}

			.hero-title {
				font-size: clamp(2.35rem, 5vw, 3.65rem);
				font-weight: 900;
				line-height: 1.25;
				letter-spacing: -0.03em;
				color: #0f172a;
				margin-bottom: 1.25rem;
				text-wrap: balance;
			}

			.hero-title span {
				color: #7c3aed;
			}

			.hero-desc {
				font-size: 1.15rem;
				line-height: 1.8;
				color: #334155;
				max-width: 820px;
				margin: 0 auto 2.5rem;
				text-wrap: pretty;
			}

			.score-overview-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
				gap: 1.5rem;
				max-width: 1140px;
				margin: 0 auto 3.5rem;
				padding: 0 1.5rem;
			}

			.overview-card {
				border-radius: 16px;
				padding: 1.85rem;
				border: 1.5px solid #e2e8f0;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
			}

			.card-red {
				border-top: 5px solid #dc2626;
				background: #fff5f5;
			}

			.card-yellow {
				border-top: 5px solid #d97706;
				background: #fffbeb;
			}

			.card-green {
				border-top: 5px solid #059669;
				background: #f0fdf4;
			}

			.overview-card h3 {
				font-size: 1.3rem;
				font-weight: 800;
				margin-bottom: 0.75rem;
				line-height: 1.35;
			}

			.card-red h3 { color: #991b1b; }
			.card-yellow h3 { color: #92400e; }
			.card-green h3 { color: #065f46; }

			.overview-card p {
				font-size: 0.95rem;
				line-height: 1.65;
				color: #334155;
				margin-bottom: 1.25rem;
			}

			.score-tag {
				display: inline-block;
				font-size: 0.85rem;
				font-weight: 800;
				padding: 0.35rem 0.85rem;
				border-radius: 9999px;
			}

			.score-tag.red { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
			.score-tag.yellow { background: #fef3c7; color: #92400e; border: 1px solid #fcd34d; }
			.score-tag.green { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }

			.content-container {
				max-width: 1140px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}

			/* UNIFIED SCALE FORMAT FOR ALL CATEGORIES */
			.category-section {
				margin-bottom: 4rem;
			}

			.category-header-wrap {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				border-bottom: 2px solid #e2e8f0;
				padding-bottom: 1rem;
				margin-bottom: 1.75rem;
				flex-wrap: wrap;
				gap: 0.75rem;
			}

			.category-title {
				font-size: 1.75rem;
				font-weight: 900;
				color: #0f172a;
				margin: 0;
				line-height: 1.3;
			}

			.category-subtitle {
				font-size: 1rem;
				color: #475569;
				margin: 0;
			}

			.items-stack {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			/* ROW CARD IN ACID-SPECTRUM FORMAT */
			.spectrum-row {
				display: grid;
				grid-template-columns: auto 1fr auto;
				align-items: center;
				gap: 1.5rem;
				background: #ffffff;
				border: 1.5px solid #e2e8f0;
				border-radius: 1.15rem;
				padding: 1.25rem 1.65rem;
				box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
			}

			.spectrum-row:hover {
				transform: translateX(4px);
				box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
			}

			.row-red {
				border-left: 6px solid #ef4444;
			}
			.row-red:hover { border-color: #fca5a5; border-left-color: #ef4444; }

			.row-yellow {
				border-left: 6px solid #f59e0b;
			}
			.row-yellow:hover { border-color: #fcd34d; border-left-color: #f59e0b; }

			.row-green {
				border-left: 6px solid #10b981;
			}
			.row-green:hover { border-color: #6ee7b7; border-left-color: #10b981; }

			.emoji-col {
				font-size: 3.25rem;
				line-height: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 4.25rem;
				flex-shrink: 0;
			}

			.text-col {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				min-width: 0;
			}

			.item-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: #0f172a;
				margin: 0;
				line-height: 1.3;
			}

			.item-meta {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				flex-wrap: wrap;
				font-size: 0.92rem;
				font-weight: 700;
			}

			.meta-red { color: #dc2626; }
			.meta-yellow { color: #d97706; }
			.meta-green { color: #059669; }

			.item-submetric {
				color: #64748b;
				font-weight: 600;
			}

			.item-description {
				font-size: 0.95rem;
				line-height: 1.65;
				color: #334155;
				margin: 0;
				text-wrap: pretty;
			}

			.stat-box-col {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: 0.65rem 1.15rem;
				border-radius: 0.85rem;
				min-width: 110px;
				flex-shrink: 0;
				text-align: center;
			}

			.stat-box-red {
				background: #fee2e2;
				border: 1.5px solid #fca5a5;
			}

			.stat-box-yellow {
				background: #fef3c7;
				border: 1.5px solid #fcd34d;
			}

			.stat-box-green {
				background: #d1fae5;
				border: 1.5px solid #6ee7b7;
			}

			.stat-metric {
				font-size: 1.2rem;
				font-weight: 900;
				line-height: 1.2;
			}

			.stat-box-red .stat-metric { color: #991b1b; }
			.stat-box-yellow .stat-metric { color: #92400e; }
			.stat-box-green .stat-metric { color: #065f46; }

			.stat-label {
				font-size: 0.78rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-top: 0.2rem;
			}

			.stat-box-red .stat-label { color: #b91c1c; }
			.stat-box-yellow .stat-label { color: #b45309; }
			.stat-box-green .stat-label { color: #047857; }

			.cta-banner {
				margin-top: 4rem;
				background: #f8fafc;
				border: 2px solid #e2e8f0;
				border-radius: 20px;
				padding: 3.5rem 2rem;
				text-align: center;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
			}

			.cta-banner h2 {
				font-size: 2.15rem;
				font-weight: 900;
				color: #0f172a;
				margin-bottom: 1rem;
				line-height: 1.3;
			}

			.cta-banner p {
				font-size: 1.1rem;
				color: #334155;
				max-width: 720px;
				margin: 0 auto 2rem;
				line-height: 1.75;
			}

			.cta-btn-group {
				display: flex;
				justify-content: center;
				gap: 1rem;
				flex-wrap: wrap;
			}

			.btn-cta {
				display: inline-block;
				font-weight: 700;
				font-size: 1rem;
				padding: 0.85rem 1.75rem;
				border-radius: 9999px;
				text-decoration: none;
				transition: all 0.2s ease;
			}

			.btn-cta-primary {
				background: #7c3aed;
				color: #ffffff;
				box-shadow: 0 4px 14px rgba(124, 58, 237, 0.4);
			}

			.btn-cta-primary:hover {
				background: #6d28d9;
				transform: translateY(-2px);
				box-shadow: 0 6px 20px rgba(124, 58, 237, 0.5);
			}

			.btn-cta-secondary {
				background: #ffffff;
				color: #0f172a;
				border: 1.5px solid #cbd5e1;
			}

			.btn-cta-secondary:hover {
				background: #f1f5f9;
			}

			@media (max-width: 768px) {
				.spectrum-row {
					grid-template-columns: 1fr;
					gap: 1rem;
					text-align: left;
				}

				.emoji-col {
					width: auto;
					justify-content: flex-start;
				}

				.stat-box-col {
					align-self: flex-start;
				}
			}
		</style>
	</head>
	<body class="triggers-page">
		<Header />

		<main>
			<section class="hero-section">
				<h1 class="hero-title">
					BMS Triggers <span>&amp; Protectors</span>
				</h1>
				<p class="hero-desc">
					Stop guessing why your mouth is burning. Every liquid, food, medication, and dental factor either fuels oral nerve activation or actively shields your tissues. Below is the complete catalog categorized by domain.
				</p>
			</section>

			<!-- 3 High Level Categories Overview -->
			<div class="score-overview-grid">
				<div class="overview-card card-red">
					<h3>🔥 Direct Acid Triggers</h3>
					<p>Chemical acids with pH below 5.5 that strip tooth mineral smear plugs and directly open Acid-Sensing Ion Channels (ASIC3) on trigeminal nerve endings.</p>
					<span class="score-tag red">Impact: +7 to +10/10 Pain Spike</span>
				</div>

				<div class="overview-card card-yellow">
					<h3>🌾 Microbial &amp; Physical Triggers</h3>
					<p>Fermentable sugars, medications that dry saliva, and dental hardware gaps that conduct bacterial lactic acid into porous dentin.</p>
					<span class="score-tag yellow">Impact: +3 to +6/10 Delayed Ache</span>
				</div>

				<div class="overview-card card-green">
					<h3>🛡️ Protectors &amp; Barriers</h3>
					<p>Zero-acid nutrition, salivary buffers, composite tubule seals, and neuro-nutrients that prevent acid contact and allow nerves to heal.</p>
					<span class="score-tag green">Impact: -5 to -10/10 Pain Relief</span>
				</div>
			</div>

			<div class="content-container">

				<!-- 1. DRINKS CATEGORY -->
				<section class="category-section">
					<div class="category-header-wrap">
						<h2 class="category-title">1. Drinks &amp; Beverages</h2>
						<p class="category-subtitle">Liquids wash over every tooth surface, margin, and mucosal fold instantly.</p>
					</div>
					<div class="items-stack">
						{drinkItems.map(item => (
							<div class={`spectrum-row row-${item.zone}`}>
								<div class="emoji-col">{item.emoji}</div>
								<div class="text-col">
									<h3 class="item-title">{item.name}</h3>
									<div class="item-meta">
										<span class={`meta-${item.zone}`}>{item.status}</span>
										<span class="item-submetric">&bull; {item.submetric}</span>
									</div>
									<p class="item-description">{item.desc}</p>
								</div>
								<div class={`stat-box-col stat-box-${item.zone}`}>
									<span class="stat-metric">{item.metric}</span>
									<span class="stat-label">{item.impact}</span>
								</div>
							</div>
						))}
					</div>
				</section>

				<!-- 2. FOODS & DIET CATEGORY -->
				<section class="category-section">
					<div class="category-header-wrap">
						<h2 class="category-title">2. Foods &amp; Dietary Ingredients</h2>
						<p class="category-subtitle">Distinguishing direct plant acids from fermentable bacterial fuels and safe proteins.</p>
					</div>
					<div class="items-stack">
						{foodItems.map(item => (
							<div class={`spectrum-row row-${item.zone}`}>
								<div class="emoji-col">{item.emoji}</div>
								<div class="text-col">
									<h3 class="item-title">{item.name}</h3>
									<div class="item-meta">
										<span class={`meta-${item.zone}`}>{item.status}</span>
										<span class="item-submetric">&bull; {item.submetric}</span>
									</div>
