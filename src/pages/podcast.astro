---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { sortPostsDescending } from '../utils/postUtils';

const rawPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = sortPostsDescending(rawPosts);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="The Decoding the Burning Mouth Syndrome Podcast | Denis Ethier" 
			description="The Decoding the Burning Mouth Syndrome Podcast. Advancing scientific research on Burning Mouth Syndrome through radical data transparency and patient-clinician conversations." 
		/>
	</head>
	<body>
		<Header />
		<main class="podcast-page-container">
			<div class="podcast-disclaimer-wrap">
				<MedicalDisclaimer />
			</div>

			<!-- Hero Section -->
			<header class="podcast-hero">
				<h1 class="podcast-title">The Decoding the Burning Mouth Syndrome Podcast</h1>
				<p class="podcast-lead-subhead">
					Advancing scientific research on Burning Mouth Syndrome through radical data transparency, patient-clinician conversations, and forensic root-cause&nbsp;investigation.
				</p>

				<!-- Quick Nav Action Buttons -->
				<div class="podcast-quick-actions">
					<a href="#episodes" class="btn btn-primary action-btn">
						<span>🎧 Browse Episodes</span>
					</a>
					<a href="/podcast/guest-guide" class="btn btn-outline action-btn">
						<span>📋 BMS Sufferer Guest Guide</span>
					</a>
					<a href="#apply" class="btn btn-outline action-btn">
						<span>🎙️ Apply to Be a Guest</span>
					</a>
				</div>

				<!-- Notify of New Episode Box -->
				<div class="podcast-notify-box" id="notify">
					<div class="notify-icon-badge" aria-hidden="true">🎙️</div>
					<h2 class="notify-title">Get Notified of New Episodes</h2>
					<p class="notify-subtext">
						Drop your email below to receive a direct link as new podcast interviews and case studies go live. No spam,&nbsp;ever.
					</p>

					<form 
						id="podcast-notify-form" 
						action="https://formsubmit.co/denis@denisethier.com" 
						method="POST" 
						class="notify-form"
					>
						<input type="hidden" name="_subject" value="[BMS Podcast] New Episode Subscriber" />
						<input type="hidden" name="_captcha" value="false" />
						<input type="hidden" name="_template" value="table" />
						<input type="hidden" name="form_type" value="Podcast Episode Notification" />

						<div class="notify-input-row">
							<input 
								type="email" 
								name="email" 
								placeholder="Enter your email address..." 
								required 
								class="notify-email-input"
								aria-label="Email address for podcast notification"
							/>
							<button type="submit" id="notify-submit-btn" class="btn btn-primary notify-submit-btn">
								<span class="notify-btn-text">Notify Me &rarr;</span>
								<span class="notify-btn-spinner hidden" aria-hidden="true">Subscribing...</span>
							</button>
						</div>
					</form>

					<div id="notify-success-box" class="notify-success-msg hidden" role="alert">
						<span class="notify-check-icon">✓</span>
						<span>You are on the list! I will email you as soon as the next episode&nbsp;airs.</span>
					</div>
				</div>
			</header>

			<!-- Episodes & Casebook Archive Section -->
			<section class="episodes-section" id="episodes">
				<div class="section-header-row">
					<div>
						<h2 class="episodes-heading">Podcast Episodes & Research Notes</h2>
						<p class="episodes-subheading">Listen, read, and explore our full series of deep dives, self-experiments, and clinical case studies.</p>
					</div>
					<a href="/podcast/guest-guide" class="guest-guide-link">
						<span>View Guest Guide & Questions →</span>
					</a>
				</div>

				<div class="episodes-grid">
					{
						posts.map((post, index) => {
							const episodeNumber = post.data.entryNumber ?? (posts.length - index);
							const imageSrc = typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage?.src;
							return (
								<article class="episode-card">
									<a href={`/blog/${post.id}/`} class="episode-card-link">
										<div class="episode-img" style={`background-image: url(${imageSrc || '/how-i-solved-my-bms-youtube-thumbnail.jpg'})`}>
											<span class="episode-badge">Episode #{episodeNumber}</span>
										</div>
										<div class="episode-body">
											<div class="episode-meta">
												<span class="meta-date"><FormattedDate date={post.data.pubDate} /></span>
												{post.data.category && (
													<>
														<span class="meta-dot">•</span>
														<span class="meta-category">{post.data.category}</span>
													</>
												)}
											</div>
											<h3 class="episode-title" set:html={post.data.title} />
											<p class="episode-desc">{post.data.description}</p>
											<div class="episode-footer">
												<span class="listen-link">Listen & Read Episode →</span>
											</div>
										</div>
									</a>
								</article>
							);
						})
					}
				</div>
			</section>

			<!-- Guest Categories Grid -->
			<section class="guest-categories-section">
				<div class="section-center-head">
					<h2 class="section-title">Who We Interview on the Podcast</h2>
					<p class="section-subtitle">We bring four key perspectives together to advance scientific understanding from every angle.</p>
				</div>

				<div class="guest-categories-grid" aria-label="Who we are inviting">
					<div class="category-card">
						<div class="category-icon-wrapper" aria-hidden="true">
							<span class="category-emoji">👤</span>
						</div>
						<h3 class="category-title">BMS Patients</h3>
						<p class="category-description">
							Share your timeline, onset triggers, pain fluctuations, what failed, and what strategies brought you&nbsp;relief.
						</p>
						<a href="/podcast/guest-guide" class="category-guide-link">View Sufferer Questions →</a>
					</div>

					<div class="category-card">
						<div class="category-icon-wrapper" aria-hidden="true">
							<span class="category-emoji">🦷</span>
						</div>
						<h3 class="category-title">Dentists & Specialists</h3>
						<p class="category-description">
							Discuss cervical margins, exposed tubules, hidden crown decay, galvanism, and periodontal biofilm&nbsp;pathways.
						</p>
					</div>

					<div class="category-card">
						<div class="category-icon-wrapper" aria-hidden="true">
							<span class="category-emoji">🩺</span>
						</div>
						<h3 class="category-title">Medical Doctors</h3>
						<p class="category-description">
							Explore small-fiber neuropathy, trigeminal sensory pathways, autonomic dysfunction, and gaps in modern clinical&nbsp;training.
						</p>
					</div>

					<div class="category-card">
						<div class="category-icon-wrapper" aria-hidden="true">
							<span class="category-emoji">🔬</span>
						</div>
						<h3 class="category-title">Researchers</h3>
						<p class="category-description">
							Highlight emerging science on acid-sensing ion channels (ASIC/TRPV1), salivary chemistry, and dietary elimination&nbsp;trials.
						</p>
					</div>
				</div>
			</section>

			<!-- Apply to Be a Guest Section -->
			<section class="podcast-form-card" id="apply">
				<div class="form-header">
					<h2 class="form-heading">Apply to Be a Guest on the Podcast</h2>
					<p class="form-subtext">
						Whether you are a patient living with BMS or a clinician with insights to share, Denis reviews every submission personally.
					</p>
					<div class="guest-guide-callout">
						<span>Looking for the interview format? Check out the </span>
						<a href="/podcast/guest-guide" class="inline-guide-link"><strong>BMS Sufferer Guest Guide & Question List →</strong></a>
					</div>
				</div>

				<form 
					id="podcast-guest-form" 
					action="https://formsubmit.co/denis@denisethier.com" 
					method="POST" 
					class="guest-form"
				>
					<input type="hidden" name="_subject" value="[BMS Podcast Guest Application] Decoding The Burn" />
					<input type="hidden" name="_captcha" value="false" />
					<input type="hidden" name="_template" value="table" />

					<!-- Guest Role Selection -->
					<div class="form-group">
						<label class="form-label">I am applying as a:</label>
						<div class="role-selector-grid">
							<label class="role-pill">
								<input type="radio" name="guest_role" value="BMS Patient" checked />
								<span class="role-label-content">👤 BMS Patient</span>
							</label>

							<label class="role-pill">
								<input type="radio" name="guest_role" value="Dentist / Periodontist" />
								<span class="role-label-content">🦷 Dentist / Periodontist</span>
							</label>

							<label class="role-pill">
								<input type="radio" name="guest_role" value="Medical Doctor" />
								<span class="role-label-content">🩺 Medical Doctor</span>
							</label>

							<label class="role-pill">
								<input type="radio" name="guest_role" value="Scientific Researcher" />
								<span class="role-label-content">🔬 Researcher</span>
							</label>

							<label class="role-pill">
								<input type="radio" name="guest_role" value="Other Specialist" />
								<span class="role-label-content">💡 Other Specialist</span>
							</label>
						</div>
					</div>

					<div class="form-row">
						<div class="form-group flex-1">
							<label for="guest-name" class="form-label">Your Name</label>
							<input 
								type="text" 
								id="guest-name" 
								name="name" 
								placeholder="e.g., Denis Ethier" 
								required 
								class="text-input" 
							/>
						</div>

						<div class="form-group flex-1">
							<label for="guest-email" class="form-label">Your Email Address</label>
							<input 
								type="email" 
								id="guest-email" 
								name="email" 
								placeholder="e.g., name@example.com" 
								required 
								class="text-input" 
							/>
						</div>
					</div>

					<div class="form-group">
						<label for="guest-story" class="form-label">
							What is your background, and what would you like to share?
						</label>
						<textarea 
							id="guest-story" 
							name="background_and_story" 
							rows="5" 
							placeholder="Tell me about your clinical background, research focus, or personal journey with Burning Mouth Syndrome. What insights would you bring to fellow listeners?" 
							required 
							class="text-area-input"
						></textarea>
					</div>

					<div class="form-submit-row">
						<button type="submit" id="guest-submit-btn" class="btn btn-primary submit-btn">
							<span class="btn-text">Send Guest Application &rarr;</span>
							<span class="btn-spinner hidden" aria-hidden="true">Submitting...</span>
						</button>
					</div>

					<p class="privacy-notice">
						Your email and information remain strictly confidential. I will only use your details to coordinate podcast appearances.
					</p>
				</form>

				<!-- Success State Card -->
				<div id="form-success-box" class="form-success-card hidden" role="alert">
					<div class="success-icon-circle">✓</div>
					<h3 class="success-title">Thank you for your application!</h3>
					<p class="success-message">
						Your details have been sent directly to Denis Ethier at <strong class="user-email-highlight">denis@denisethier.com</strong>.
					</p>
					<p class="success-followup">
						I review every application personally and will reach out to you by email to coordinate scheduling.
					</p>
					<button type="button" id="reset-form-btn" class="btn btn-outline success-reset-btn">
						Submit Another Note
					</button>
				</div>

				<!-- Error Banner -->
				<div id="form-error-banner" class="form-error-banner hidden" role="alert">
					An error occurred while submitting. Please try again, or email Denis directly at 
					<a href="mailto:denis@denisethier.com">denis@denisethier.com</a>.
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const setupGuestForm = () => {
				const form = document.getElementById('podcast-guest-form') as HTMLFormElement | null;
				const submitBtn = document.getElementById('guest-submit-btn') as HTMLButtonElement | null;
				const btnText = submitBtn?.querySelector('.btn-text');
				const btnSpinner = submitBtn?.querySelector('.btn-spinner');
				const successBox = document.getElementById('form-success-box');
				const errorBanner = document.getElementById('form-error-banner');
				const resetBtn = document.getElementById('reset-form-btn');

				if (!form || !submitBtn) return;

				form.addEventListener('submit', async (e) => {
					e.preventDefault();
					errorBanner?.classList.add('hidden');

					submitBtn.disabled = true;
					btnText?.classList.add('hidden');
					btnSpinner?.classList.remove('hidden');

					const formData = new FormData(form);

					try {
						const response = await fetch(form.action, {
							method: 'POST',
							body: formData,
							headers: {
								'Accept': 'application/json'
							}
						});

						if (response.ok) {
							form.classList.add('hidden');
							successBox?.classList.remove('hidden');
							successBox?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
						} else {
							form.submit();
						}
					} catch (err) {
						form.submit();
					} finally {
						submitBtn.disabled = false;
						btnText?.classList.remove('hidden');
						btnSpinner?.classList.add('hidden');
					}
				});

				resetBtn?.addEventListener('click', () => {
					form.reset();
					successBox?.classList.add('hidden');
					form.classList.remove('hidden');
				});

				// Top Notify Form Handler
				const notifyForm = document.getElementById('podcast-notify-form') as HTMLFormElement | null;
				const notifySubmitBtn = document.getElementById('notify-submit-btn') as HTMLButtonElement | null;
				const notifyBtnText = notifySubmitBtn?.querySelector('.notify-btn-text');
				const notifyBtnSpinner = notifySubmitBtn?.querySelector('.notify-btn-spinner');
				const notifySuccessBox = document.getElementById('notify-success-box');

				if (notifyForm && notifySubmitBtn) {
					notifyForm.addEventListener('submit', async (e) => {
						e.preventDefault();

						notifySubmitBtn.disabled = true;
						notifyBtnText?.classList.add('hidden');
						notifyBtnSpinner?.classList.remove('hidden');

						const formData = new FormData(notifyForm);

						try {
							const response = await fetch(notifyForm.action, {
								method: 'POST',
								body: formData,
								headers: {
									'Accept': 'application/json'
								}
							});

							if (response.ok) {
								notifyForm.classList.add('hidden');
								notifySuccessBox?.classList.remove('hidden');
							} else {
								notifyForm.submit();
							}
						} catch (err) {
							notifyForm.submit();
						} finally {
							notifySubmitBtn.disabled = false;
							notifyBtnText?.classList.remove('hidden');
							notifyBtnSpinner?.classList.add('hidden');
						}
					});
				}
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', setupGuestForm);
			} else {
				setupGuestForm();
			}
		</script>

		<style>
			.podcast-page-container {
				max-width: 1080px;
				margin: 1.5rem auto 5rem;
				padding: 0 1.5rem;
			}

			.podcast-disclaimer-wrap {
				margin-bottom: 2rem;
			}

			.podcast-hero {
				text-align: center;
				margin-bottom: 4rem;
				max-width: 860px;
				margin-left: auto;
				margin-right: auto;
			}

			.podcast-title {
				font-size: clamp(2.25rem, 5vw, 3.25rem);
				font-weight: 800;
				color: #000000;
				letter-spacing: -0.03em;
				line-height: 1.15;
				margin-bottom: 1.25rem;
				text-wrap: balance;
			}

			.podcast-lead-subhead {
				font-size: clamp(1.05rem, 2.5vw, 1.25rem);
				color: #334155;
				line-height: 1.65;
				max-width: 760px;
				margin: 0 auto;
				text-wrap: balance;
			}

			.podcast-quick-actions {
				display: flex;
				justify-content: center;
				gap: 0.85rem;
				flex-wrap: wrap;
				margin-top: 2rem;
			}

			.action-btn {
				padding: 0.75rem 1.4rem;
				font-weight: 700;
				text-decoration: none;
				font-size: 0.95rem;
			}

			/* Top Notify Box */
			.podcast-notify-box {
				background: #ffffff;
				border: 1px solid #fecaca;
				border-radius: 20px;
				padding: 2.25rem 2rem;
				max-width: 640px;
				margin: 2.5rem auto 0;
				text-align: center;
				box-shadow: 0 12px 32px -8px rgba(200, 56, 44, 0.08);
			}

			.notify-icon-badge {
				font-size: 1.75rem;
				line-height: 1;
				margin-bottom: 0.75rem;
			}

			.notify-title {
				font-size: 1.5rem;
				font-weight: 800;
				color: #0f172a;
				letter-spacing: -0.02em;
				margin-bottom: 0.5rem;
				text-wrap: balance;
			}

			.notify-subtext {
				font-size: 0.95rem;
				color: #475569;
				line-height: 1.55;
				margin-bottom: 1.25rem;
				text-wrap: pretty;
			}

			.notify-input-row {
				display: flex;
				gap: 0.75rem;
			}

			@media (max-width: 540px) {
				.notify-input-row {
					flex-direction: column;
				}
			}

			.notify-email-input {
				flex: 1;
				padding: 0.85rem 1.1rem;
				border-radius: 12px;
				border: 1px solid #cbd5e1;
				background: #ffffff;
				font-family: inherit;
				font-size: 0.95rem;
				color: #0f172a;
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
			}

			.notify-email-input:focus {
				outline: none;
				border-color: #c8382c;
				box-shadow: 0 0 0 3px rgba(200, 56, 44, 0.12);
			}

			.notify-submit-btn {
				padding: 0.85rem 1.5rem;
				font-size: 0.95rem;
				font-weight: 700;
				border-radius: 12px;
				white-space: nowrap;
			}

			.notify-success-msg {
				margin-top: 1rem;
				padding: 0.85rem 1rem;
				background: #f0fdf4;
				border: 1px solid #bbf7d0;
				border-radius: 10px;
				color: #166534;
				font-size: 0.92rem;
				font-weight: 600;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
			}

			/* Episodes Section */
			.episodes-section {
				margin-bottom: 5rem;
			}

			.section-header-row {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				margin-bottom: 2rem;
				gap: 1.5rem;
				flex-wrap: wrap;
				border-bottom: 2px solid #f1f5f9;
				padding-bottom: 1.25rem;
			}

			.episodes-heading {
				font-size: clamp(1.75rem, 3.5vw, 2.25rem);
				font-weight: 800;
				color: #0f172a;
				letter-spacing: -0.025em;
				margin: 0 0 0.4rem 0;
			}

			.episodes-subheading {
				font-size: 1.05rem;
				color: #64748b;
				margin: 0;
			}

			.guest-guide-link {
				font-weight: 700;
				color: #be123c;
				font-size: 0.95rem;
				text-decoration: none;
				white-space: nowrap;
				transition: color 0.15s ease;
			}

			.guest-guide-link:hover {
				color: #9f1239;
				text-decoration: underline;
			}

			.episodes-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
				gap: 1.75rem;
			}

			.episode-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 16px;
				overflow: hidden;
				box-shadow: 0 4px 16px -4px rgba(15, 23, 42, 0.05);
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
				display: flex;
				flex-direction: column;
			}

			.episode-card:hover {
				transform: translateY(-3px);
				box-shadow: 0 10px 25px -4px rgba(15, 23, 42, 0.08);
				border-color: #cbd5e1;
			}

			.episode-card-link {
				color: inherit;
				text-decoration: none;
				display: flex;
				flex-direction: column;
				height: 100%;
			}

			.episode-img {
				width: 100%;
				height: 190px;
				background-size: cover;
				background-position: center;
				position: relative;
				border-bottom: 1px solid #f1f5f9;
			}

			.episode-badge {
				position: absolute;
				bottom: 0.75rem;
				left: 0.75rem;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.74rem;
				font-weight: 800;
				color: #ffffff;
				background: rgba(15, 23, 42, 0.85);
				backdrop-filter: blur(4px);
				padding: 0.2rem 0.6rem;
				border-radius: 6px;
				letter-spacing: 0.02em;
			}

			.episode-body {
				padding: 1.35rem 1.5rem 1.5rem;
				display: flex;
				flex-direction: column;
				flex: 1;
			}

			.episode-meta {
				display: flex;
				align-items: center;
				gap: 0.45rem;
				font-size: 0.8rem;
				color: #64748b;
				margin-bottom: 0.6rem;
			}

			.meta-dot {
				color: #cbd5e1;
			}

			.meta-category {
				font-weight: 600;
				color: #be123c;
			}

			.episode-title {
				font-size: 1.2rem;
				font-weight: 800;
				line-height: 1.35;
				color: #0f172a;
				margin: 0 0 0.65rem 0;
				letter-spacing: -0.015em;
			}

			.episode-desc {
				font-size: 0.92rem;
				line-height: 1.55;
				color: #475569;
				margin: 0 0 1.25rem 0;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
				flex: 1;
			}

			.episode-footer {
				margin-top: auto;
				padding-top: 0.75rem;
				border-top: 1px solid #f1f5f9;
			}

			.listen-link {
				font-size: 0.88rem;
				font-weight: 700;
				color: #be123c;
			}

