											</div>
										</div>
									)}
								</div>
							</div>
						</div>
					))}
				</div>

				<div class="action-banner">
					<h2>See How the Triggers Stack in Presentation Mode</h2>
					<p>
						Explore the complete 25-slide step-by-step narrative detailing how eliminating acid and sealing dental hardware brings pain down to zero.
					</p>
					<a href="/presentation2" class="action-btn">Watch Presentation Flow</a>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			function initTree() {
				// Main Branch Card Headers
				const nodeHeaders = document.querySelectorAll('.node-header');
				nodeHeaders.forEach((header) => {
					header.addEventListener('click', () => {
						const card = header.closest('.node-card');
						if (!card) return;
						const isOpen = card.classList.toggle('open');
						header.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
					});

					header.addEventListener('keydown', (e: any) => {
						if (e.key === 'Enter' || e.key === ' ') {
							e.preventDefault();
							(header as HTMLElement).click();
						}
					});
				});

				// Sub-branch Accordions
				const subHeaders = document.querySelectorAll('.sub-branch-header');
				subHeaders.forEach((subHeader) => {
					subHeader.addEventListener('click', (e) => {
						e.stopPropagation();
						const accordion = subHeader.closest('.sub-branch-accordion');
						if (!accordion) return;
						const isOpen = accordion.classList.toggle('open');
						subHeader.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
					});

					subHeader.addEventListener('keydown', (e: any) => {
						if (e.key === 'Enter' || e.key === ' ') {
							e.preventDefault();
							(subHeader as HTMLElement).click();
						}
					});
				});

				// Show More / Show Less for Items Beyond 3
				const showMoreBtns = document.querySelectorAll('.show-more-btn');
				showMoreBtns.forEach((btn) => {
					btn.addEventListener('click', (e) => {
						e.stopPropagation();
						const wrap = btn.closest('.sub-branch-content');
						if (!wrap) return;
						const list = wrap.querySelector('.leaf-list');
						if (!list) return;

						const isExpanded = list.classList.toggle('is-expanded');
						btn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
						const count = btn.getAttribute('data-count') || 'More';

						if (isExpanded) {
							btn.textContent = "- Show Less";
						} else {
							const titleEl = btn.closest('.sub-branch-accordion')?.querySelector('.sub-branch-title');
							const section = titleEl ? titleEl.textContent?.replace(/[\u{1F300}-\u{1F9FF}]/gu, '').trim() : 'Items';
							btn.textContent = `+ Show ${count} More ${section}`;
						}
					});
				});

				// Global Expand / Collapse Buttons
				const expandBtn = document.getElementById('expandAllBtn');
				const collapseBtn = document.getElementById('collapseAllBtn');

				expandBtn?.addEventListener('click', () => {
					document.querySelectorAll('.node-card').forEach((card) => {
						card.classList.add('open');
						card.querySelector('.node-header')?.setAttribute('aria-expanded', 'true');
					});
					document.querySelectorAll('.sub-branch-accordion').forEach((acc) => {
						acc.classList.add('open');
						acc.querySelector('.sub-branch-header')?.setAttribute('aria-expanded', 'true');
					});
					document.querySelectorAll('.leaf-list').forEach((list) => {
						list.classList.add('is-expanded');
					});
					document.querySelectorAll('.show-more-btn').forEach((btn) => {
						btn.setAttribute('aria-expanded', 'true');
						btn.textContent = "- Show Less";
					});
				});

				collapseBtn?.addEventListener('click', () => {
					document.querySelectorAll('.node-card').forEach((card) => {
						card.classList.remove('open');
						card.querySelector('.node-header')?.setAttribute('aria-expanded', 'false');
					});
					document.querySelectorAll('.sub-branch-accordion').forEach((acc) => {
						acc.classList.remove('open');
						acc.querySelector('.sub-branch-header')?.setAttribute('aria-expanded', 'false');
					});
					document.querySelectorAll('.leaf-list').forEach((list) => {
						list.classList.remove('is-expanded');
					});
					document.querySelectorAll('.show-more-btn').forEach((btn) => {
						btn.setAttribute('aria-expanded', 'false');
						const count = btn.getAttribute('data-count') || 'More';
						const titleEl = btn.closest('.sub-branch-accordion')?.querySelector('.sub-branch-title');
						const section = titleEl ? titleEl.textContent?.replace(/[\u{1F300}-\u{1F9FF}]/gu, '').trim() : 'Items';
						btn.textContent = `+ Show ${count} More ${section}`;
					});
				});
			}

			// Run on initial load and view transitions
			initTree();
			document.addEventListener('astro:after-swap', initTree);
		</script>
	</body>
</html>
