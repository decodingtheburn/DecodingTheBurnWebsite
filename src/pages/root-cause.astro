<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			:root {
				--tree-line: #cbd5e1;
				--brand-purple: #7c3aed;
				--brand-purple-hover: #6d28d9;
			}
			.root-hero {
				padding: 3.5rem 1.5rem 2.25rem;
				text-align: center;
				max-width: 960px;
				margin: 0 auto;
			}
			.root-hero h1 {
				font-size: clamp(2.1rem, 4vw, 3.2rem);
				font-weight: 900;
				color: #0f172a;
				line-height: 1.35;
				margin-bottom: 1rem;
				text-wrap: balance;
			}
			.root-hero p {
				font-size: clamp(1.05rem, 1.8vw, 1.25rem);
				color: #334155;
				line-height: 1.6;
				max-width: 820px;
				margin: 0 auto 1.5rem;
				text-wrap: pretty;
			}
			.tree-controls {
				display: flex;
				justify-content: center;
				gap: 0.75rem;
				margin-top: 1.25rem;
				flex-wrap: wrap;
			}
			.tree-control-btn {
				background: #ffffff;
				border: 1px solid #cbd5e1;
				color: #1e293b;
				font-size: 0.9rem;
				font-weight: 600;
				padding: 0.5rem 1.15rem;
				border-radius: 0.5rem;
				cursor: pointer;
				transition: all 0.2s ease;
			}
			.tree-control-btn:hover {
				background: #f1f5f9;
				border-color: #94a3b8;
			}

			.visual-tree-container {
				max-width: 920px;
				margin: 0 auto 5rem;
				padding: 0 1.25rem;
			}

			/* Trunk Header: Soft Purple Gradient */
			.tree-trunk {
				background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
				border: 1px solid #d8b4fe;
				border-radius: 1.25rem;
				padding: 2rem 2.25rem;
				box-shadow: 0 4px 20px -4px rgba(124, 58, 237, 0.08);
				margin-bottom: 2.5rem;
				position: relative;
				z-index: 10;
			}
			.trunk-content {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			.trunk-text h2 {
				font-size: clamp(1.4rem, 2.6vw, 1.95rem);
				font-weight: 800;
				color: #4c1d95;
				margin: 0;
				line-height: 1.35;
			}
			.trunk-text p {
				font-size: 1.05rem;
				color: #581c87;
				margin: 0;
				line-height: 1.55;
			}

			/* Tree Wrapper & Branches */
			.tree-branches {
				position: relative;
				padding-left: 1.75rem;
			}
			@media (min-width: 768px) {
				.tree-branches {
					padding-left: 3rem;
				}
			}

			/* Vertical Spine */
			.tree-branches::before {
				content: '';
				position: absolute;
				top: -2.5rem;
				left: 0.65rem;
				bottom: 2.5rem;
				width: 3px;
				background: #cbd5e1;
				border-radius: 2px;
			}
			@media (min-width: 768px) {
				.tree-branches::before {
					left: 1rem;
				}
			}

			/* Branch Node */
			.tree-branch-node {
				position: relative;
				margin-bottom: 2.25rem;
				z-index: 1;
			}
			.tree-branch-node:hover,
			.tree-branch-node:focus-within {
				z-index: 100;
			}

			/* Horizontal Connector */
			.tree-branch-node::before {
				content: '';
				position: absolute;
				top: 2rem;
				left: -1.1rem;
				width: 1.1rem;
				height: 3px;
				background: #cbd5e1;
			}
			@media (min-width: 768px) {
				.tree-branch-node::before {
					left: -2rem;
					width: 2rem;
				}
			}

			/* Node Card with Rich Colored Background & Subtle Drop Shadow */
			.node-card {
				border-radius: 1.25rem;
				overflow: visible;
				box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.node-card:hover {
				transform: translateY(-2px);
				box-shadow: 0 16px 32px -6px rgba(15, 23, 42, 0.12), 0 10px 14px -6px rgba(15, 23, 42, 0.06);
			}

			/* Main Node Header with Tinted Header Bar */
			.node-header {
				padding: 1.25rem 1.5rem;
				cursor: pointer;
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				user-select: none;
				gap: 1rem;
				border-radius: 1.25rem;
				transition: background 0.15s ease, border-radius 0.15s ease;
			}
			.node-card.open .node-header {
				border-radius: 1.25rem 1.25rem 0 0;
			}
			.node-header-left {
				display: flex;
				align-items: flex-start;
				gap: 1.15rem;
				flex: 1;
				min-width: 0;
			}

			/* Large Number & Pure Emoji to the Left */
			.node-identity-wrap {
				display: flex;
				align-items: center;
				justify-content: flex-start;
				gap: 0.85rem;
				width: 7.25rem;
				flex-shrink: 0;
				margin-top: 0.15rem;
			}
			.node-large-number {
				font-size: clamp(2.3rem, 3.8vw, 3.1rem);
				font-weight: 900;
				color: #0f172a;
				line-height: 1;
				letter-spacing: -0.04em;
				width: 2.1rem;
				flex-shrink: 0;
			}
			.node-emoji {
				font-size: 3.4rem;
				line-height: 1;
				display: block;
				filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.12));
			}
			.node-svg-wrap {
				width: 3.5rem;
				height: 3.5rem;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.neuron-icon {
				width: 3.5rem;
				height: 3.5rem;
				display: block;
				filter: drop-shadow(0 2px 6px rgba(67, 56, 202, 0.25));
			}

			.node-title-wrap {
				flex: 1;
				min-width: 0;
			}
			.node-title-row {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				flex-wrap: wrap;
				margin-bottom: 0.35rem;
			}
			.node-title-wrap h3 {
				font-size: clamp(2rem, 3.6vw, 2.85rem);
				font-weight: 800;
				color: #0f172a;
				margin: 0;
				line-height: 1.15;
				letter-spacing: -0.02em;
			}
			.prevalence-tag-wrap {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.35rem;
				margin-top: 0.35rem;
				margin-bottom: 0.45rem;
			}
			.prevalence-tag {
				font-size: 0.85rem;
				font-weight: 700;
				color: #ffffff;
				background: #4c1d95;
				border: none;
				padding: 0.25rem 0.7rem;
				border-radius: 0.35rem;
				white-space: nowrap;
				line-height: 1.35;
			}
			.study-ref-wrap {
				position: relative;
				display: inline-block;
			}
			.prevalence-study-link {
				font-size: 0.85rem;
				font-weight: 500;
				color: #4338ca;
				text-decoration: underline;
				text-underline-offset: 2px;
				line-height: 1.35;
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
				transition: color 0.15s ease;
			}
			.prevalence-study-link:hover {
				color: #312e81;
			}
			.study-popover {
				display: none;
				position: absolute;
				top: 100%;
				left: 0;
				margin-top: 4px;
				width: min(540px, 90vw);
				max-height: 70vh;
				overflow-y: auto;
				background: #ffffff;
				border: 1px solid #cbd5e1;
				border-radius: 0.75rem;
				padding: 1.1rem 1.25rem;
				box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.18), 0 4px 10px -2px rgba(15, 23, 42, 0.08);
				z-index: 60;
				text-align: left;
				cursor: default;
			}
			.study-popover::before {
				content: '';
				position: absolute;
				top: -10px;
				left: 0;
				right: 0;
				height: 10px;
			}
			@media (max-width: 768px) {
				.study-popover {
					position: fixed;
					left: 1rem !important;
					right: 1rem !important;
					top: 50% !important;
					transform: translateY(-50%);
					width: auto !important;
					max-height: 75vh;
					margin-top: 0;
					box-shadow: 0 20px 40px rgba(15, 23, 42, 0.3);
				}
			}
			.study-ref-wrap:hover .study-popover,
			.study-ref-wrap:focus-within .study-popover {
				display: block;
			}
			.study-popover-header {
				display: flex;
				align-items: flex-start;
				gap: 1rem;
				margin-bottom: 0.45rem;
			}
			.study-popover-icon {
				font-size: 2.75rem;
				line-height: 1;
				flex-shrink: 0;
			}
			.study-popover-cite {
				font-size: 0.92rem;
				font-weight: 700;
				color: #0f172a;
				padding-top: 0.25rem;
			}
			.study-popover-summary {
				font-size: 0.9rem;
				line-height: 1.55;
				color: #1e293b;
				margin: 0 0 0.75rem;
				padding-left: 3.75rem;
				white-space: pre-line;
			}
			.study-popover-ext {
				display: inline-block;
				padding-left: 3.75rem;
				font-size: 0.84rem;
				font-weight: 600;
				color: #4338ca;
				text-decoration: underline;
				text-underline-offset: 2px;
			}
			.study-popover-ext:hover {
				color: #312e81;
			}
			.node-analogy {
				font-size: 0.95rem;
				color: #334155;
				font-weight: 500;
				margin: 0;
				line-height: 1.45;
			}

			.node-chevron {
				font-size: 0.82rem;
				font-weight: 600;
				color: #334155;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.3rem 0.65rem;
				border-radius: 0.45rem;
				background: rgba(255, 255, 255, 0.75);
				flex-shrink: 0;
				align-self: flex-start;
				margin-top: 0.25rem;
				transition: background 0.15s ease, color 0.15s ease;
			}
			.node-chevron::before {
				content: 'Expand';
			}
			.node-card.open .node-chevron::before {
				content: 'Collapse';
			}
			.node-chevron::after {
				content: '▼';
				font-size: 0.7rem;
				transition: transform 0.2s ease;
			}
			.node-card.open .node-chevron::after {
				transform: rotate(180deg);
			}
			.node-card.open .node-chevron {
				background: rgba(255, 255, 255, 0.9);
				color: #0f172a;
			}

			/* Node Body */
			.node-body {
				display: none;
				padding: 0.5rem 1.5rem 1.75rem;
				background: rgba(255, 255, 255, 0.65);
				border-top: 1px solid rgba(0, 0, 0, 0.06);
				border-radius: 0 0 1.25rem 1.25rem;
			}
			.node-card.open .node-body {
				display: block;
			}

			/* Orientation Card for Stacked Multiple Factors */
			.stacked-orientation-card {
				background: #ffffff;
				border-radius: 1rem;
				padding: 1.85rem 2rem;
				box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.06);
				margin-top: 0.75rem;
			}
			.stacked-orientation-badge {
				display: inline-block;
				background: #ffe4e6;
				color: #9f1239;
				font-size: 0.88rem;
				font-weight: 800;
				padding: 0.35rem 0.85rem;
				border-radius: 0.5rem;
				margin-bottom: 0.85rem;
			}
			.stacked-orientation-title {
				font-size: 1.6rem;
				font-weight: 900;
				color: #000000;
				margin: 0 0 0.65rem;
				line-height: 1.3;
				letter-spacing: -0.02em;
			}
			.stacked-orientation-lead {
				font-size: 1.05rem;
				line-height: 1.6;
				color: #334155;
				margin: 0 0 1.35rem;
			}
			.stacked-orientation-guide {
				border-top: 1px solid #f1f5f9;
				padding-top: 1.15rem;
			}
			.guide-intro {
				font-size: 1rem;
				color: #0f172a;
				margin: 0 0 1rem;
				line-height: 1.5;
			}
			.guide-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 0.75rem;
			}
			.guide-item {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				background: #f8fafc;
				padding: 0.75rem 1rem;
				border-radius: 0.65rem;
				border: 1px solid #e2e8f0;
			}
			.guide-num {
				font-weight: 900;
				font-size: 0.95rem;
				color: #e11d48;
				background: #ffe4e6;
				padding: 0.2rem 0.5rem;
				border-radius: 0.35rem;
			}
			.guide-label {
				font-weight: 700;
				font-size: 0.92rem;
				color: #0f172a;
			}

			/* Stacked Sub-Branches Layout */
			.sub-tree-layout {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				margin-top: 1rem;
			}

			/* Collapsible Sub-Branch Accordion Section */
			.sub-branch-accordion {
				position: relative;
				z-index: 1;
				border: none;
				border-radius: 0.95rem;
				background: #ffffff;
				overflow: visible;
				box-shadow: 0 4px 12px -2px rgba(15, 23, 42, 0.05), 0 2px 4px -2px rgba(15, 23, 42, 0.03);
				transition: transform 0.15s ease, box-shadow 0.15s ease;
			}
			.sub-branch-accordion:hover,
			.sub-branch-accordion:focus-within {
				z-index: 100;
			}
			.sub-branch-header {
				padding: 0.95rem 1.25rem;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: space-between;
				user-select: none;
				background: #ffffff;
				border-radius: 0.95rem;
				border-bottom: 1px solid rgba(0, 0, 0, 0.04);
				transition: background 0.15s ease, border-radius 0.15s ease;
			}
			.sub-branch-header:hover {
				background: #fbfcfe;
			}
			.sub-branch-accordion.open .sub-branch-header {
				border-radius: 0.95rem 0.95rem 0 0;
				border-bottom: 1px solid rgba(0, 0, 0, 0.05);
			}

			.sub-branch-title {
				display: flex;
				align-items: center;
				gap: 1rem;
				font-size: 1.68rem;
				font-weight: 900;
				color: #000000;
				margin: 0;
				line-height: 1.25;
				letter-spacing: -0.02em;
			}
			.home-tests-title,
			.tests-title,
			.specialties-title,
			.solutions-title {
				color: #000000;
			}

			/* Large Sub-Section Emojis */
			.sub-branch-emoji {
				font-size: 2.75rem;
				line-height: 1;
				display: inline-block;
				filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.12));
			}
			.sub-branch-chevron {
				font-size: 0.8rem;
				font-weight: 600;
				color: #475569;
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				flex-shrink: 0;
			}
			.sub-branch-chevron::before {
				content: 'Expand';
			}
			.sub-branch-accordion.open .sub-branch-chevron::before {
				content: 'Collapse';
			}
			.sub-branch-chevron::after {
				content: '▼';
				font-size: 0.65rem;
				transition: transform 0.2s ease;
			}
			.sub-branch-accordion.open .sub-branch-chevron::after {
				transform: rotate(180deg);
			}
			.sub-branch-accordion.open .sub-branch-chevron {
				color: #0f172a;
			}

			/* Sub-Branch Content Area with Alignment to Title Text */
			.sub-branch-content {
				display: none;
				padding: 1.15rem 1.25rem 1.35rem 4.45rem;
				background: #ffffff;
				border-radius: 0 0 0.95rem 0.95rem;
			}
			.sub-branch-accordion.open .sub-branch-content {
				display: block;
			}

			/* Leaf Item Ordered List */
			.leaf-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 0.95rem;
				counter-reset: leaf-counter;
			}
			.leaf-item {
				position: relative;
				padding-left: 1.75rem;
				font-size: 0.98rem;
				line-height: 1.5;
				color: #1e293b;
				max-width: 80%;
				counter-increment: leaf-counter;
			}
			.leaf-item::before {
				content: counter(leaf-counter) ".";
				position: absolute;
				left: 0;
				top: 0.05rem;
				font-weight: 800;
				font-size: 1.05rem;
				color: #000000;
			}
			.leaf-label {
				font-weight: 700;
				font-size: 1.2rem;
				color: #0f172a;
				display: block;
				margin-bottom: 0.25rem;
				line-height: 1.3;
			}
			.leaf-desc {
				color: #334155;
				line-height: 1.5;
			}
			.leaf-study-box {
				margin-top: 0.6rem;
				padding: 0;
				background: transparent;
				border: none;
				font-size: 0.98rem;
				line-height: 1.5;
				display: flex;
				align-items: flex-start;
				gap: 0.45rem;
			}
			.leaf-study-label {
				font-weight: 400;
				font-style: normal;
				color: #0f172a;
				flex-shrink: 0;
			}
			.leaf-study-meta {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.15rem;
				margin-bottom: 0.25rem;
			}
			.leaf-study-tag {
				font-weight: 700;
				font-size: 0.98rem;
				color: #0f172a;
			}
			.leaf-study-link {
				color: #4338ca;
				font-weight: 400;
				font-size: 0.85rem;
				text-decoration: underline;
				text-underline-offset: 2px;
			}
			.leaf-study-link:hover {
				color: #312e81;
			}
			.leaf-study-insight {
				color: #1e293b;
				margin: 0;
				font-size: 0.98rem;
				line-height: 1.5;
			}
				color: #475569;
				margin: 0;
				font-size: 0.86rem;
			}

			/* Show All Items by Default */
			.leaf-item.is-extra {
				display: list-item;
			}
			.leaf-list.is-expanded .leaf-item.is-extra {
				display: list-item;
			}

			/* Hide Show More / Show Less Button */
			.show-more-wrap {
				display: none;
			}
			.show-more-btn {
				background: transparent;
				border: none;
				color: var(--brand-purple);
				font-size: 0.88rem;
				font-weight: 700;
				padding: 0.25rem 0;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				transition: color 0.15s ease;
			}
			.show-more-btn:hover {
				color: var(--brand-purple-hover);
				text-decoration: underline;
			}

			/* Callout Banner */
			.action-banner {
				background: #0f172a;
				border-radius: 1.25rem;
				padding: 2.5rem 2rem;
				text-align: center;
				color: #ffffff;
				margin-top: 3.5rem;
			}
			.action-banner h2 {
				color: #ffffff;
				font-size: 1.85rem;
				font-weight: 800;
				margin-bottom: 0.75rem;
				line-height: 1.38;
			}
			.action-banner p {
				color: #cbd5e1;
				font-size: 1.05rem;
				max-width: 660px;
				margin: 0 auto 1.5rem;
				line-height: 1.55;
			}
			.action-btn {
				display: inline-block;
				background: var(--brand-purple);
				color: #ffffff;
				font-weight: 700;
				padding: 0.85rem 1.85rem;
				border-radius: 0.65rem;
				text-decoration: none;
				transition: background 0.2s ease;
			}
			.action-btn:hover {
				background: var(--brand-purple-hover);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="root-hero">
				<h1>Root Causes of Burning Mouth</h1>
				<p>
					Burning Mouth Syndrome is rarely a single phantom defect. Explore the interactive biological tree below to see how chemical triggers, failing oral hardware, and depleted biological protection converge, along with clinical study prevalence rates, diagnostic tests, medical specialties, and potential solutions.
				</p>
				<div class="tree-controls">
					<button class="tree-control-btn" id="expandAllBtn" type="button">Expand All</button>
					<button class="tree-control-btn" id="collapseAllBtn" type="button">Collapse All</button>
				</div>
			</section>

			<section class="visual-tree-container">
				<!-- Medical Disclaimer -->
				<div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 0.85rem; padding: 1rem 1.35rem; margin-bottom: 1.5rem; font-size: 0.92rem; line-height: 1.5; color: #334155;">
					<strong style="color: #0f172a;">Medical Disclaimer:</strong> This guide is for educational purposes only and does not constitute medical advice. Please consult a qualified physician, dentist, or orofacial pain specialist before trying any new diagnostic test, supplement, or treatment.
				</div>
				<!-- Trunk Header -->
				<div class="tree-trunk">
					<div class="trunk-content">
						<div class="trunk-text">
							<h2>List of BMS Root Causes</h2>
							<p>Discover the clinical evidence, biological factors, everyday triggers, diagnostic tests, medical specialties, and targeted treatment solutions for each pattern.</p>
						</div>
					</div>
				</div>

				<!-- Visual Tree Branches -->
				<div class="tree-branches">
					{treeData.map((node) => (
						<div class="tree-branch-node" id={`branch-${node.id}`}>
							<div 
								class="node-card" 
								data-node={node.id}
								style={`background: ${node.cardBg}; border: 1px solid ${node.cardBorder};`}
							>
								<div 
									class="node-header" 
									role="button" 
									tabindex="0" 
									aria-expanded="false"
									style={`background: ${node.headerBg};`}
								>
									<div class="node-header-left">
										<!-- Branch Large Number & Icon Header -->
										<div class="node-identity-wrap">
											<span class="node-large-number">{node.number}</span>
											{node.id === 'neuropathy' ? (
												<span class="node-emoji node-svg-wrap" title="Peripheral & Trigeminal Nerve Arborization">
													<svg class="neuron-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
														<!-- Soma / Neuron Cell Body -->
														<circle cx="32" cy="24" r="9" fill="#4338ca" />
														<circle cx="32" cy="24" r="5" fill="#818cf8" />
														<circle cx="32" cy="24" r="2.5" fill="#ffffff" />
														<!-- Dendrite branches spreading out -->
														<path d="M26 18L15 10M15 10L12 4M15 10L6 12M23 24L11 23M11 23L4 18M11 23L5 28M27 30L17 37M17 37L10 38M17 37L15 45M32 15L32 5M32 5L26 2M32 5L38 2M37 18L48 10M48 10L49 3M48 10L57 11M41 24L53 23M53 23L60 18M53 23L59 28M37 30L47 37M47 37L54 38M47 37L49 45" stroke="#4338ca" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
														<!-- Main Axon Trunk descending -->
														<path d="M32 33V50" stroke="#4338ca" stroke-width="3.2" stroke-linecap="round" />
														<!-- Myelin Sheath segments -->
														<rect x="29.5" y="35" width="5" height="4" rx="2" fill="#6366f1" />
														<rect x="29.5" y="41" width="5" height="4" rx="2" fill="#6366f1" />
														<rect x="29.5" y="47" width="5" height="4" rx="2" fill="#6366f1" />
														<!-- Axon terminal branches -->
														<path d="M32 52L24 60M24 60L18 61M24 60L25 54M32 52L40 60M40 60L46 61M40 60L39 54M32 52L32 62" stroke="#4338ca" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
														<!-- Synaptic Boutons / Nerve Sparks -->
														<circle cx="18" cy="61" r="1.8" fill="#ec4899" />
														<circle cx="46" cy="61" r="1.8" fill="#ec4899" />
														<circle cx="32" cy="62" r="1.8" fill="#ec4899" />
													</svg>
												</span>
											) : (
												<span class="node-emoji">{node.icon}</span>
											)}
										</div>
										<div class="node-title-wrap">
											<h3 class={node.id === 'neuropathy' ? 'featured-branch-title' : ''}>{node.title}</h3>
											<div class="prevalence-tag-wrap">
												<span class="prevalence-tag" style={`background: ${node.badgeBg};`}>{node.prevalence}</span>
												<div class="study-ref-wrap" onclick="event.stopPropagation();">
													<a 
														href={node.studyUrl} 
														target="_blank" 
														rel="noopener noreferrer" 
														class="prevalence-study-link"
													>
														{node.studyCitation} ↗
													</a>
													<div class="study-popover" role="tooltip">
														<div class="study-popover-header">
															<span class="study-popover-icon">📄</span>
															<span class="study-popover-cite">{node.studyCitation}</span>
														</div>
														<p class="study-popover-summary" set:html={node.studySummary}></p>
														<a 
															href={node.studyUrl} 
															target="_blank" 
															rel="noopener noreferrer" 
															class="study-popover-ext"
														>
															View full study on PubMed ↗
														</a>
													</div>
												</div>
											</div>
											<p class="node-analogy">{node.analogy}</p>
										</div>
									</div>
									<div class="node-chevron" aria-hidden="true"></div>
								</div>

								<div class="node-body">
									{node.id === 'combination' ? (
										<!-- Orientation Card for Stacked Multiple Factors -->
										<div class="stacked-orientation-card">
											<div class="stacked-orientation-badge">68% of Patients Report Multiple Overlapping Factors</div>
											<h4 class="stacked-orientation-title">The Real-World Reality of Burning Mouth</h4>
											<p class="stacked-orientation-lead">
												Clinical data shows that nearly 7 out of 10 patients do not suffer from a single isolated cause. Instead, their burning is ignited when multiple underlying factors stack together to push the trigeminal alarm over its threshold.
											</p>
											<div class="stacked-orientation-guide">
												<p class="guide-intro">
													<strong>Explore Root Causes #2 through #7 below</strong> to identify your individual primary and secondary contributors:
												</p>
												<div class="guide-grid">
													<div class="guide-item">
														<span class="guide-num">#2</span>
														<span class="guide-label">Nerve Trauma & Neuropathy (62%)</span>
													</div>
													<div class="guide-item">
														<span class="guide-num">#3</span>
														<span class="guide-label">Lack of Saliva (58%)</span>
													</div>
													<div class="guide-item">
														<span class="guide-num">#4</span>
														<span class="guide-label">Bite Pressure Overload (47%)</span>
													</div>
													<div class="guide-item">
														<span class="guide-num">#5</span>
														<span class="guide-label">Dental Issues (32%)</span>
													</div>
													<div class="guide-item">
														<span class="guide-num">#6</span>
														<span class="guide-label">Nutrient Deficiencies (28%)</span>
													</div>
													<div class="guide-item">
														<span class="guide-num">#7</span>
														<span class="guide-label">True Idiopathic BMS (2%)</span>
													</div>
												</div>
											</div>
										</div>
									) : (
										<div class="sub-tree-layout">
											{node.commonSymptoms && node.commonSymptoms.length > 0 && (
												<div class="sub-branch-accordion">
													<div class="sub-branch-header" role="button" tabindex="0" aria-expanded="false">
														<h4 class="sub-branch-title">
															<span class="sub-branch-emoji">🚩</span>
															Common Symptoms
														</h4>
														<span class="sub-branch-chevron" aria-hidden="true"></span>
													</div>
													<div class="sub-branch-content">
														<ol class="leaf-list">
															{node.commonSymptoms.map((item) => (
																<li class="leaf-item">
																	<span class="leaf-label">{item.label}</span>
																	<span class="leaf-desc">{item.desc}</span>
																</li>
															))}
														</ol>
													</div>
												</div>
											)}
											{node.whyItHurts && (
												<div class="sub-branch-accordion">
													<div class="sub-branch-header" role="button" tabindex="0" aria-expanded="false">
														<h4 class="sub-branch-title">
															<span class="sub-branch-emoji">💡</span>
															Why It Generates Pain
														</h4>
														<span class="sub-branch-chevron" aria-hidden="true"></span>
													</div>
													<div class="sub-branch-content">
														<p class="leaf-desc" style="margin: 0; padding-left: 1.75rem; max-width: 80%; white-space: pre-line;">{node.whyItHurts}</p>
													</div>
												</div>
											)}
											<!-- Root Factors Collapsible -->
											<div class="sub-branch-accordion open">
												<div class="sub-branch-header" role="button" tabindex="0" aria-expanded="true">
													<h4 class="sub-branch-title">
														<span class="sub-branch-emoji">🔬</span>
														Root Factors
													</h4>
													<span class="sub-branch-chevron" aria-hidden="true"></span>
												</div>
												<div class="sub-branch-content">
													<ol class="leaf-list">
														{node.rootFactors.map((item, idx) => (
															<li class={`leaf-item ${idx >= 3 ? 'is-extra' : ''}`}>
																<span class="leaf-label">{item.label}</span>
																<span class="leaf-desc">
																	{item.desc}
																	{item.studyCitation && (
																		<span class="study-ref-wrap" onclick="event.stopPropagation();">
																			{" "}<a href={item.studyUrl} target="_blank" rel="noopener noreferrer" class="leaf-study-link">See study</a>
																			<span class="study-popover" role="tooltip">
																				<span class="study-popover-header">
																					<span class="study-popover-icon">📄</span>
																					<span class="study-popover-cite">{item.studyCitation}</span>
																				</span>
																				<span class="study-popover-summary" style="display:block;" set:html={item.studyInsight}></span>
																				<a href={item.studyUrl} target="_blank" rel="noopener noreferrer" class="study-popover-ext">View full study on PubMed ↗</a>
																			</span>
																		</span>
																	)}
																</span>
															</li>
														))}
													</ol>
													{node.rootFactors.length > 3 && (
														<div class="show-more-wrap">
															<button 
																class="show-more-btn" 
																type="button" 
																data-count={node.rootFactors.length - 3}
																aria-expanded="false"
															>
																+ Show {node.rootFactors.length - 3} More Root Factors
															</button>
														</div>
													)}
												</div>
											</div>

											<!-- Daily Triggers Collapsible -->
											<div class="sub-branch-accordion open">
												<div class="sub-branch-header" role="button" tabindex="0" aria-expanded="true">
													<h4 class="sub-branch-title">
														<span class="sub-branch-emoji">🔥</span>
														Daily Triggers
													</h4>
													<span class="sub-branch-chevron" aria-hidden="true"></span>
												</div>
												<div class="sub-branch-content">
													<ol class="leaf-list">
														{node.dailyTriggers.map((item, idx) => (
															<li class={`leaf-item ${idx >= 3 ? 'is-extra' : ''}`}>
																<span class="leaf-label">{item.label}</span>
																<span class="leaf-desc">
																	{item.desc}
																	{item.studyCitation && (
																		<span class="study-ref-wrap" onclick="event.stopPropagation();">
																			{" "}<a href={item.studyUrl} target="_blank" rel="noopener noreferrer" class="leaf-study-link">See study</a>
																			<span class="study-popover" role="tooltip">
																				<span class="study-popover-header">
																					<span class="study-popover-icon">📄</span>
																					<span class="study-popover-cite">{item.studyCitation}</span>
																				</span>
																				<span class="study-popover-summary" style="display:block;" set:html={item.studyInsight}></span>
																				<a href={item.studyUrl} target="_blank" rel="noopener noreferrer" class="study-popover-ext">View full study on PubMed ↗</a>
																			</span>
																		</span>
																	)}
																</span>
															</li>
														))}
													</ol>
													{node.dailyTriggers.length > 3 && (
														<div class="show-more-wrap">
															<button 
																class="show-more-btn" 
																type="button" 
																data-count={node.dailyTriggers.length - 3}
																aria-expanded="false"
															>
																+ Show {node.dailyTriggers.length - 3} More Daily Triggers
															</button>
														</div>
													)}
												</div>
											</div>

											<!-- Home Tests Collapsible -->
											{node.homeTests && node.homeTests.length > 0 && (
												<div class="sub-branch-accordion home-tests-accordion">
													<div class="sub-branch-header" role="button" tabindex="0" aria-expanded="false">
														<h4 class="sub-branch-title home-tests-title">
															<span class="sub-branch-emoji">🏠</span>
															Home Tests
														</h4>
														<span class="sub-branch-chevron" aria-hidden="true"></span>
													</div>
													<div class="sub-branch-content">
														<ol class="leaf-list">
															{node.homeTests.map((item, idx) => (
																<li class={`leaf-item ${idx >= 3 ? 'is-extra' : ''}`}>
																	<span class="leaf-label">{item.label}</span>
																	<span class="leaf-desc">
																		{item.desc}
																		{item.studyCitation && (
																			<span class="study-ref-wrap" onclick="event.stopPropagation();">
																				{" "}<a href={item.studyUrl} target="_blank" rel="noopener noreferrer" class="leaf-study-link">See study</a>
																				<span class="study-popover" role="tooltip">
																					<span class="study-popover-header">
																						<span class="study-popover-icon">📄</span>
																						<span class="study-popover-cite">{item.studyCitation}</span>
																					</span>
																					<span class="study-popover-summary" style="display:block;" set:html={item.studyInsight}></span>
																					<a href={item.studyUrl} target="_blank" rel="noopener noreferrer" class="study-popover-ext">View full study on PubMed ↗</a>
																				</span>
																			</span>
																		)}
																	</span>
																</li>
															))}
														</ol>
														{node.homeTests.length > 3 && (
															<div class="show-more-wrap">
																<button 
																	class="show-more-btn" 
																	type="button" 
																	data-count={node.homeTests.length - 3}
																	aria-expanded="false"
																>
																	+ Show {node.homeTests.length - 3} More Home Tests
																</button>
															</div>
														)}
													</div>
												</div>
											)}

											<!-- Clinical Diagnostic Tests Collapsible -->
											{node.clinicalTests && node.clinicalTests.length > 0 && (
												<div class="sub-branch-accordion tests-accordion">
													<div class="sub-branch-header" role="button" tabindex="0" aria-expanded="false">
														<h4 class="sub-branch-title tests-title">
															<span class="sub-branch-emoji">🧪</span>
															Clinical Tests
														</h4>
														<span class="sub-branch-chevron" aria-hidden="true"></span>
													</div>
													<div class="sub-branch-content">
														<ol class="leaf-list">
															{node.clinicalTests.map((item, idx) => (
																<li class={`leaf-item ${idx >= 3 ? 'is-extra' : ''}`}>
																	<span class="leaf-label">{item.label}</span>
																	<span class="leaf-desc">
																		{item.desc}
																		{item.studyCitation && (
																			<span class="study-ref-wrap" onclick="event.stopPropagation();">
																				{" "}<a href={item.studyUrl} target="_blank" rel="noopener noreferrer" class="leaf-study-link">See study</a>
																				<span class="study-popover" role="tooltip">
																					<span class="study-popover-header">
																						<span class="study-popover-icon">📄</span>
																						<span class="study-popover-cite">{item.studyCitation}</span>
																					</span>
																					<span class="study-popover-summary" style="display:block;" set:html={item.studyInsight}></span>
																					<a href={item.studyUrl} target="_blank" rel="noopener noreferrer" class="study-popover-ext">View full study on PubMed ↗</a>
																				</span>
																			</span>
																		)}
																	</span>
																</li>
															))}
														</ol>
														{node.clinicalTests.length > 3 && (
															<div class="show-more-wrap">
																<button 
																	class="show-more-btn" 
																	type="button" 
																	data-count={node.clinicalTests.length - 3}
																	aria-expanded="false"
																>
																	+ Show {node.clinicalTests.length - 3} More Clinical Tests
																</button>
															</div>
														)}
													</div>
												</div>
											)}

											<!-- Medical Specialties Collapsible -->
											<div class="sub-branch-accordion specialties-accordion open">
												<div class="sub-branch-header" role="button" tabindex="0" aria-expanded="true">
													<h4 class="sub-branch-title specialties-title">
														<span class="sub-branch-emoji">🩺</span>
														Medical Specialties
													</h4>
													<span class="sub-branch-chevron" aria-hidden="true"></span>
												</div>
												<div class="sub-branch-content">
													<ol class="leaf-list">
														{node.medicalSpecialties.map((item, idx) => (
															<li class={`leaf-item ${idx >= 3 ? 'is-extra' : ''}`}>
																<span class="leaf-label">{item.label}</span>
																<span class="leaf-desc">{item.desc}</span>
															</li>
														))}
													</ol>
													{node.medicalSpecialties.length > 3 && (
														<div class="show-more-wrap">
															<button 
																class="show-more-btn" 
																type="button" 
																data-count={node.medicalSpecialties.length - 3}
																aria-expanded="false"
															>
																+ Show {node.medicalSpecialties.length - 3} More Medical Specialties
															</button>
														</div>
													)}
												</div>
											</div>

											<!-- Potential Solutions Collapsible -->
											<div class="sub-branch-accordion solutions-accordion open">
												<div class="sub-branch-header" role="button" tabindex="0" aria-expanded="true">
													<h4 class="sub-branch-title solutions-title">
														<span class="sub-branch-emoji">💡</span>
														Potential Solutions
													</h4>
													<span class="sub-branch-chevron" aria-hidden="true"></span>
												</div>
												<div class="sub-branch-content">
													<ol class="leaf-list">
														{node.potentialSolutions.map((item, idx) => (
															<li class={`leaf-item ${idx >= 3 ? 'is-extra' : ''}`}>
																<span class="leaf-label">{item.label}</span>
																<span class="leaf-desc">{item.desc}</span>
															</li>
														))}
													</ol>
													{node.potentialSolutions.length > 3 && (
														<div class="show-more-wrap">
															<button 
																class="show-more-btn" 
																type="button" 
																data-count={node.potentialSolutions.length - 3}
																aria-expanded="false"
															>
																+ Show {node.potentialSolutions.length - 3} More Potential Solutions
															</button>
														</div>
