---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const editions = [
  {
    id: "decoding-the-burn-ed1",
    title: "Decoding the Burn",
    edition: "First Edition & Clinical Manuscript",
    status: "Free Online Draft & Interactive Reader",
    pages: "92 Pages",
    readTime: "3.5 Hours",
    description: "An investigative clinical blueprint decoding the electrochemistry of Burning Mouth Syndrome (BMS). Dissecting acid-sensing ion channels (ASIC1 & ASIC3), crown margin micro-leakage, open dentinal tubule hydrodynamics, and the 4-phase clinical de-escalation protocol.",
    coverImg: "/cover.png",
    readDraftLink: "/draft",
    amazonLink: "https://www.amazon.com/dp/B0DGBZ8XZP", // Amazon buy link placeholder / ready for listing
    highlights: [
      "Full 13-Chapter Interactive Reader & Clinical Tables",
      "Interactive Multi-Source Pain & Cranial Nerve Convergence Diagram",
      "The 0–10 Printable Clinical Intake Questionnaire",
      "Over 40 Peer-Reviewed Literature & ICOP / ICHD-3 Citations"
    ],
    publishedDate: "November 2026",
    badge: "Available Now"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Books & Publications | ${SITE_TITLE}`}
      description="Explore official books, clinical manuscripts, and interactive investigative editions on Burning Mouth Syndrome and first-principles orofacial pain science."
    />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col selection:bg-purple-600 selection:text-white">
    <Header />

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
      <!-- Header Banner -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-white mb-4 [text-wrap:balance]">
          Books &amp; Publications
        </h1>
        <p class="text-lg sm:text-xl text-purple-200/90 leading-relaxed [text-wrap:pretty]">
          First-principles investigations and peer-reviewed manuscripts decoding the biological hardware of chronic oral burning.
        </p>
      </div>

      <!-- Books Grid / Collection -->
      <div class="space-y-12">
        {editions.map((book) => (
          <article class="bg-[#130924] border border-purple-900/60 rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] hover:border-purple-600/80 transition-all duration-300">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 p-6 sm:p-8 lg:p-10 items-center">
              
              <!-- Book Cover Column (Left) -->
              <div class="md:col-span-5 lg:col-span-4 flex justify-center">
                <a href={book.readDraftLink} class="group block relative w-full max-w-[280px] sm:max-w-[320px] rounded-xl overflow-hidden shadow-2xl transition-transform duration-300 group-hover:scale-[1.02]">
                  <img
                    src={book.coverImg}
                    alt={book.title}
                    class="w-full h-auto object-cover rounded-xl border border-purple-500/30"
                    loading="eager"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center p-6">
                    <span class="bg-purple-600 text-white text-sm font-bold px-4 py-2 rounded-lg shadow-lg">
                      Read Online Free &rarr;
                    </span>
                  </div>
                </a>
              </div>

              <!-- Book Details Column (Right) -->
              <div class="md:col-span-7 lg:col-span-8 flex flex-col justify-between h-full space-y-6">
                <div>
                  <div class="flex flex-wrap items-center gap-3 mb-3">
                    <span class="text-xs font-extrabold uppercase tracking-wider text-purple-300 bg-purple-950/80 border border-purple-700/60 px-3 py-1 rounded-full">
                      {book.edition}
                    </span>
                    <span class="text-xs font-bold text-emerald-400 bg-emerald-950/60 border border-emerald-800/60 px-3 py-1 rounded-full flex items-center gap-1.5">
                      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                      Read Free Online Draft
                    </span>
                  </div>

                  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight mb-2">
                    <a href={book.readDraftLink} class="hover:text-purple-300 transition-colors">
                      {book.title}
                    </a>
                  </h2>

                  <div class="flex items-center gap-4 text-xs sm:text-sm text-slate-400 mb-4 font-medium">
                    <span>{book.pages}</span>
                    <span>&bull;</span>
                    <span>{book.readTime}</span>
                    <span>&bull;</span>
                    <span>Published {book.publishedDate}</span>
                  </div>

                  <p class="text-slate-300 text-base leading-relaxed mb-6 [text-wrap:pretty]">
                    {book.description}
                  </p>

                  <!-- Highlights List -->
                  <div class="mb-6 bg-[#1a0f30]/60 border border-purple-900/40 rounded-xl p-4 sm:p-5">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-purple-300 mb-3">
                      Key Highlights Included
                    </h3>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-slate-200">
                      {book.highlights.map((item) => (
                        <li class="flex items-start gap-2">
                          <svg class="w-4 h-4 text-purple-400 mt-1 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                          </svg>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <!-- CTA Actions (Read Now Free & Buy on Amazon) -->
                <div class="flex flex-wrap items-center gap-4 pt-2">
                  <!-- Read Now Free Button -->
                  <a
                    href={book.readDraftLink}
                    class="inline-flex items-center justify-center gap-2.5 bg-purple-600 hover:bg-purple-500 text-white font-bold px-6 py-3.5 rounded-xl shadow-lg hover:shadow-purple-600/30 transition-all text-sm sm:text-base"
                  >
                    <svg class="w-5 h-5 text-purple-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                    <span>Read Now Free</span>
                  </a>

                  <!-- Buy on Amazon Button -->
                  <a
                    href={book.amazonLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2.5 bg-[#f59e0b] hover:bg-[#d97706] text-slate-950 font-extrabold px-6 py-3.5 rounded-xl shadow-lg hover:shadow-amber-500/20 transition-all text-sm sm:text-base"
                  >
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M13.958 10.09c0 1.272-.047 2.336-.713 3.447-.52.868-1.277 1.406-2.148 1.406-1.18 0-1.734-.89-1.734-2.197 0-2.57 2.197-3.033 4.595-3.033v.377zm3.176 7.424c-.266.236-.653.256-.96.079-.884-.717-1.042-1.05-1.528-1.737-1.46 1.48-2.52 1.954-4.398 1.954-2.28 0-4.048-1.397-4.048-3.99 0-2.032 1.15-3.483 2.766-4.22 1.403-.645 3.37-.76 4.847-.932v-.36c0-.687-.07-1.488-.507-2.025-.386-.48-1.04-.71-1.666-.71-1.144 0-2.164.557-2.42 1.764-.06.27-.247.503-.52.503l-3.064-.326c-.24-.047-.493-.217-.42-.563.66-3.13 3.454-4.32 6.467-4.32 1.63 0 3.75.433 4.987 1.673 1.257 1.24 1.153 2.923 1.153 4.707v4.614c0 1.397.587 1.99 1.153 2.747.2.273.233.593-.02.793l-1.847 1.734zm-8.82 4.148c7.18 2.373 14.186-.64 15.533-1.64.28-.21.133-.51-.186-.38-1.32.533-5.26 2.08-11.467.4-2.28-.627-4.433-1.84-4.14-1.407.3 1.34 3.073 2.38 6.26 3.027z" />
                    </svg>
                    <span>Buy on Amazon</span>
                  </a>
                </div>

              </div>
            </div>
          </article>
        ))}

        <!-- Upcoming Editions Placeholder -->
        <div class="border border-dashed border-purple-900/40 rounded-2xl p-8 sm:p-10 text-center bg-[#0d0517]/40">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-purple-950 border border-purple-800 text-purple-300 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2">Future Editions &amp; Translated Manuscripts</h2>
          <p class="text-sm text-slate-400 max-w-xl mx-auto [text-wrap:pretty]">
            Clinical translations, updated research monographs, and specialized clinician guides will be cataloged here as new peer-reviewed findings emerge.
          </p>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
