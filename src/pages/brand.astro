---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Brand Review: Trigeminal Nerve (V2 & V3) Anatomy" description="Confidential review" />
		<meta name="robots" content="noindex, nofollow" />
		<style>
			html, body {
				background-color: #06040d !important;
				background-image: none !important;
				color: #ffffff !important;
			}
			/* Scope styling specifically inside brand-content to isolate from global styles */
			.brand-content h1 {
				color: #ffffff !important;
				font-size: 2.25rem !important;
				font-weight: 800 !important;
				line-height: 1.25 !important;
				margin-bottom: 0.5rem !important;
			}
			.brand-content h2 {
				color: #ffffff !important;
				font-size: 1.4rem !important;
				font-weight: 700 !important;
				line-height: 1.3 !important;
				margin-bottom: 0.5rem !important;
			}
			.brand-content p {
				color: #cbd5e1 !important;
				font-size: 0.95rem !important;
				line-height: 1.5 !important;
			}
			.brand-box {
				background-color: #110d24 !important;
				border: 1px solid rgba(255, 255, 255, 0.12) !important;
			}
			.img-frame {
				background-color: #030108 !important;
				border: 1px solid rgba(255, 255, 255, 0.08) !important;
			}
		</style>
	</head>
	<body class="min-h-screen">
		<Header />
		<main class="brand-content py-12 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
			<div class="mb-12 text-center">
				<h1 class="tracking-tight">
					Trigeminal Nerve Pathways (V2 &amp;&nbsp;V3)
				</h1>
				<p class="text-base sm:text-lg max-w-2xl mx-auto">
					Photorealistic 3D anatomical visualizations showing real neural arborization in glowing ruby red, free of diagrammatic vector lines or&nbsp;labels.
				</p>
			</div>

			<!-- Option A: Frontal Coronal View -->
			<div class="brand-box rounded-2xl p-6 sm:p-10 mb-12 shadow-2xl">
				<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-6 mb-6 border-b border-white/10 gap-4">
					<div>
						<h2>
							Option A: Frontal Coronal View (Full Face &amp; Oral Cavity)
						</h2>
						<p>
							Direct anterior perspective looking into the open mouth showing bilateral ganglia, V2 branches wrapping the upper dental arch and palate, and V3 lingual &amp; inferior alveolar pathways.
						</p>
					</div>
					<a
						href="/trigeminal-v2-v3-frontal.jpg"
						download="trigeminal-v2-v3-frontal.jpg"
						class="inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-purple-600 hover:bg-purple-500 rounded-lg shadow transition whitespace-nowrap"
					>
						Download High-Res JPG &darr;
					</a>
				</div>

				<div class="img-frame flex justify-center items-center py-4 rounded-xl overflow-hidden">
					<img
						src="/trigeminal-v2-v3-frontal.jpg"
						alt="3D medical render of Trigeminal V2 and V3 nerves in glowing red - Frontal view"
						class="max-w-full sm:max-w-2xl rounded-lg shadow-2xl"
					/>
				</div>
			</div>

			<!-- Option B: 3/4 Oblique Depth View -->
			<div class="brand-box rounded-2xl p-6 sm:p-10 mb-12 shadow-2xl">
				<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-6 mb-6 border-b border-white/10 gap-4">
					<div>
						<h2>
							Option B: 3/4 Oblique Depth View
						</h2>
						<p>
							Angled depth perspective highlighting the 3D anatomical depth of the ganglion in Meckel's cave and the lingual nerve curving around into the substance of the tongue.
						</p>
					</div>
					<a
						href="/trigeminal-v2-v3-nerves-real.jpg"
						download="trigeminal-v2-v3-nerves-depth.jpg"
						class="inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-purple-600 hover:bg-purple-500 rounded-lg shadow transition whitespace-nowrap"
					>
						Download High-Res JPG &darr;
					</a>
				</div>

				<div class="img-frame flex justify-center items-center py-4 rounded-xl overflow-hidden">
					<img
						src="/trigeminal-v2-v3-nerves-real.jpg"
						alt="3D medical render of Trigeminal V2 and V3 nerves in glowing red - Angled perspective"
						class="max-w-full sm:max-w-2xl rounded-xl shadow-2xl"
					/>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
