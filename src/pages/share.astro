---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import { Image } from 'astro:assets';
import authorPhoto from '../assets/denis-ethier.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Share Your BMS Story | Decoding The Burn" 
			description="Share your personal Burning Mouth Syndrome journey, triggers, dental findings, or recovery observations directly with Denis Ethier." 
		/>
	</head>
	<body>
		<Header />
		<main class="contact-main-container">
			<div class="contact-hero-image-wrapper">
				<Image 
					src={authorPhoto} 
					alt="Denis Ethier" 
					class="contact-hero-img" 
					width={1200} 
					height={675} 
				/>
			</div>

			<h1 class="contact-page-title">Share Your BMS&nbsp;Story</h1>

			<div class="contact-disclaimer-wrapper">
				<MedicalDisclaimer />
			</div>

			<p class="contact-lead-text">
				Everyone's experience with Burning Mouth Syndrome is different. I am genuinely interested in learning what you have been through, what makes your pain worse, what makes it better, and any dental or dietary patterns you have discovered. Feel free to share your story&nbsp;below.
			</p>
			
			<div class="contact-form-card">
				<form id="contact-page-form" action="https://formsubmit.co/denis@decodingtheburn.com" method="POST" class="contact-form-inner">
					<input type="hidden" name="_subject" value="[Shared Story from Reader] Decoding The Burn" />
					<input type="hidden" name="_captcha" value="false" />
					<input type="hidden" name="_template" value="table" />
					<input type="hidden" name="_next" value="https://www.decodingtheburn.com/thank-you-contact/" />
					<input type="hidden" name="Submission_Page" value="Share Story (/share/)" />
					<input type="hidden" name="Page_URL" value="https://www.decodingtheburn.com/share/" />
					<input type="hidden" name="Thank_You_Page_Shown" value="https://www.decodingtheburn.com/thank-you-contact/" />

					<div class="form-group">
						<label for="contact-name">Your Name</label>
						<input type="text" id="contact-name" name="name" placeholder="Your name or handle" required />
					</div>
					
					<div class="form-group">
						<label for="contact-email">Your Email</label>
						<input type="email" id="contact-email" name="email" placeholder="name@example.com" required />
					</div>
					
					<div class="form-group">
						<label for="contact-message">Your Story &amp; Observations</label>
						<textarea id="contact-message" name="message" rows="6" placeholder="Tell me about your journey, when the burning started, what specialists you've seen, your dental work, food triggers, or what has provided relief..." required></textarea>
					</div>
					
					<button type="submit" id="contact-submit-btn" class="btn btn-primary contact-submit-btn">
						<span class="btn-text">Share Your Story &rarr;</span>
					</button>
				</form>
			</div>
		</main>
		<Footer />

		<style>
			.contact-main-container {
				max-width: 760px;
				margin: 1.5rem auto 4.5rem;
				padding: 0 1.5rem;
			}

			.contact-hero-image-wrapper {
				width: 100%;
				aspect-ratio: 16 / 9;
				border-radius: 20px;
				overflow: hidden;
				box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.18);
				margin-bottom: 2rem;
				background: #0f172a;
				border: 1px solid rgba(15, 23, 42, 0.08);
			}

			.contact-hero-img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 20%;
				display: block;
			}

			.contact-page-title {
				font-size: 2.5rem;
				font-weight: 800;
				color: #0f172a;
				line-height: 1.15;
				margin-bottom: 1.5rem;
				text-wrap: balance;
			}

			.contact-disclaimer-wrapper {
				margin-bottom: 2rem;
			}

			.contact-lead-text {
				font-size: 1.15rem;
				line-height: 1.65;
				color: #475569;
				margin-bottom: 2.5rem;
				text-wrap: pretty;
			}

			.contact-form-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 20px;
				padding: 2.5rem;
				box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.05);
			}

			.contact-form-inner {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			.form-group {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.form-group label {
				font-size: 0.95rem;
				font-weight: 600;
				color: #1e293b;
			}

			.form-group input,
			.form-group textarea {
				padding: 0.85rem 1.1rem;
				border: 1.5px solid #cbd5e1;
				border-radius: 12px;
				font-family: inherit;
				font-size: 1rem;
				color: #0f172a;
				transition: border-color 0.2s, box-shadow 0.2s;
				outline: none;
				background: #f8fafc;
			}

			.form-group input:focus,
			.form-group textarea:focus {
				border-color: #6366f1;
				box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
				background: #ffffff;
			}

			.contact-submit-btn {
				margin-top: 0.5rem;
				padding: 1rem 2rem;
				font-size: 1.05rem;
				font-weight: 700;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				border-radius: 12px;
				background: #6366f1;
				color: #ffffff;
				border: none;
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.contact-submit-btn:hover {
				background: #4f46e5;
				transform: translateY(-2px);
				box-shadow: 0 10px 20px -5px rgba(99, 102, 241, 0.4);
			}

			@media (max-width: 640px) {
				.contact-page-title {
					font-size: 2rem;
				}

				.contact-form-card {
					padding: 1.5rem;
				}
			}
		</style>
	</body>
</html>
