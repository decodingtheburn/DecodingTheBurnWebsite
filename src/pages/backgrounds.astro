---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import authorPhoto from '../assets/denis-ethier.png';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';

// Demo post data for preview
const demoDate = new Date('2026-09-05');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Background Variations | ${SITE_TITLE}`} description="Interactive preview of medical-grade backgrounds" />
		<style>
			/* Switcher Bar */
			.bg-switcher-bar {
				position: sticky;
				top: 75px;
				z-index: 999;
				background: rgba(15, 23, 42, 0.94);
				backdrop-filter: blur(16px);
				padding: 0.85rem 1.5rem;
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				align-items: center;
				justify-content: center;
				border-radius: 14px;
				max-width: 1200px;
				margin: 1rem auto 2rem;
				box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
				border: 1px solid rgba(255, 255, 255, 0.12);
			}

			.bg-switcher-title {
				color: #f8fafc;
				font-size: 0.92rem;
				font-weight: 700;
				margin-right: 0.5rem;
				letter-spacing: 0.3px;
			}

			.bg-btn {
				background: rgba(255, 255, 255, 0.08);
				border: 1px solid rgba(255, 255, 255, 0.18);
				color: #e2e8f0;
				padding: 0.45rem 0.95rem;
				border-radius: 8px;
				font-size: 0.85rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.bg-btn:hover {
				background: rgba(255, 255, 255, 0.2);
				color: #ffffff;
			}

			.bg-btn.active {
				background: #c8382c;
				border-color: #ef4444;
				color: #ffffff;
				box-shadow: 0 0 15px rgba(200, 56, 44, 0.5);
			}

			.bg-preview-label {
				text-align: center;
				padding: 1rem 0;
				font-size: 1.1rem;
				font-weight: 700;
				color: #1e293b;
			}

			.bg-container {
				border-radius: 24px;
				margin: 0 auto 4rem;
				max-width: 1360px;
				box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
				border: 1px solid #e2e8f0;
				overflow: hidden;
				transition: all 0.35s ease;
			}

			/* =========================================================
			   PRESET 1: Pure Clinical White with Subtle Thermal Flame Curves
			   ========================================================= */
			.preset-1-thermal-subtle {
				background-color: #ffffff;
				background-image:
					/* Subtle flame thermal heat curve on outer left */
					radial-gradient(ellipse 35% 60% at 2% 20%, rgba(244, 63, 94, 0.045), transparent 70%),
					radial-gradient(ellipse 30% 50% at 0% 60%, rgba(251, 146, 60, 0.035), transparent 70%),
					/* Subtle flame thermal heat curve on outer right */
					radial-gradient(ellipse 35% 60% at 98% 20%, rgba(244, 63, 94, 0.045), transparent 70%),
					radial-gradient(ellipse 30% 50% at 100% 60%, rgba(251, 146, 60, 0.035), transparent 70%),
					/* Ultra-clean pure white center, crisp & medical-grade */
					linear-gradient(90deg, #fafafa 0%, #ffffff 18%, #ffffff 82%, #fafafa 100%);
			}

			/* =========================================================
			   PRESET 2: Medical Flame Micro-Vector & Platinum Grey
			   ========================================================= */
			.preset-2-flame-vector {
				background-color: #fafbfc;
				background-image: 
					/* Left flame wave SVG */
					radial-gradient(ellipse 40% 60% at 0% 30%, rgba(225, 29, 72, 0.04), transparent 70%),
					radial-gradient(ellipse 40% 60% at 100% 30%, rgba(225, 29, 72, 0.04), transparent 70%),
					/* Subtle micro-filament thermal flame paths on outer flanks */
					url("data:image/svg+xml,%3Csvg width='160' height='160' viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30,160 C15,120 45,90 35,50 C28,25 42,10 40,0 C45,15 35,35 48,60 C58,80 35,115 50,160' fill='none' stroke='%23e11d48' stroke-width='0.75' stroke-opacity='0.04'/%3E%3Cpath d='M130,160 C145,120 115,90 125,50 C132,25 118,10 120,0 C115,15 125,35 112,60 C102,80 125,115 110,160' fill='none' stroke='%23e11d48' stroke-width='0.75' stroke-opacity='0.04'/%3E%3C/svg%3E"),
					linear-gradient(90deg, #f8fafc 0%, #ffffff 15%, #ffffff 85%, #f8fafc 100%);
			}

			/* =========================================================
			   PRESET 3: Ultra-Clean Precision Medical Grid + Platinum
			   ========================================================= */
			.preset-3-precision-grid {
				background-color: #ffffff;
				background-image: 
					radial-gradient(circle 800px at 50% 0%, rgba(200, 56, 44, 0.025), transparent 75%),
					linear-gradient(to right, rgba(226, 232, 240, 0.5) 1px, transparent 1px),
					linear-gradient(to bottom, rgba(226, 232, 240, 0.5) 1px, transparent 1px),
					linear-gradient(90deg, #f8fafc 0%, #ffffff 20%, #ffffff 80%, #f8fafc 100%);
				background-size: 100% 100%, 36px 36px, 36px 36px, 100% 100%;
			}

			/* =========================================================
			   PRESET 4: Clean Pure Clinical Light Gray / Crisp White
			   ========================================================= */
			.preset-4-clinical-platinum {
				background-color: #fcfcfd;
				background-image: 
					radial-gradient(circle 900px at 50% -100px, rgba(241, 245, 249, 0.9), transparent 80%),
					linear-gradient(180deg, #ffffff 0%, #f8fafc 50%, #ffffff 100%);
			}

			/* =========================================================
			   PRESET 5: Biomedical Pulse Wave & Pure Pure Center
			   ========================================================= */
			.preset-5-pulse-flame {
				background-color: #ffffff;
				background-image: 
					radial-gradient(ellipse 35% 55% at 0% 15%, rgba(220, 38, 38, 0.04), transparent 65%),
					radial-gradient(ellipse 35% 55% at 100% 15%, rgba(220, 38, 38, 0.04), transparent 65%),
					url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0,50 Q25,30 50,50 T100,50' fill='none' stroke='%23f43f5e' stroke-width='0.5' stroke-opacity='0.035'/%3E%3C/svg%3E"),
					linear-gradient(90deg, #fbfbfe 0%, #ffffff 18%, #ffffff 82%, #fbfbfe 100%);
				background-size: 100% 100%, 100% 100%, 100px 100px, 100% 100%;
			}

			.preview-header-badge {
				display: inline-block;
				background: #0f172a;
				color: #f8fafc;
				padding: 0.35rem 0.85rem;
				border-radius: 6px;
				font-size: 0.82rem;
				font-weight: 700;
				margin-bottom: 0.5rem;
