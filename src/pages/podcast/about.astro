---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MedicalDisclaimer from '../../components/MedicalDisclaimer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="About the Podcast | Decoding The Burn" 
			description="About The Decoding the Burning Mouth Syndrome Podcast hosted by Denis Ethier, BMS patient in Quebec, Canada. Advancing patient-led science and clinical solutions." 
		/>
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section Following Homepage Model -->
			<section class="hero-centered-wrapper">
				<div class="hero-centered-header">
					<MedicalDisclaimer />
					<h1 class="hero-centered-title">
						About the Podcast
					</h1>
					<p class="hero-centered-subtitle">
						Interviews with patients, dentists, and researchers exploring biophysical root causes.
						Here is why open dialogue and clinical transparency are the key to permanent&nbsp;answers.
					</p>
				</div>

				<!-- Thumbnail on Top (Using existing podcast thumbnail) -->
				<div class="hero-video-centered">
					<div class="video-placeholder-wrapper" style="cursor: default;">
						<img 
							src="/about-podcast-thumbnail.jpg" 
							alt="The Decoding the Burning Mouth Syndrome Podcast hosted by Denis Ethier" 
							class="video-placeholder-img" 
							loading="eager"
						/>
					</div>
				</div>

				<!-- Story Card Under Video -->
				<article class="personal-story-section">
					<h2 class="story-heading">My Story &amp; Why I Started This&nbsp;Podcast</h2>
					<div class="story-lead">
						<p>
							I created this podcast because millions of people with Burning Mouth Syndrome are told that their agonizing pain is all in their head. After consulting five dentists and five medical doctors who couldn't find a physical cause, I realized that traditional 15-minute appointments were not designed to solve complex chronic&nbsp;conditions.
						</p>
						<p>
							As a patient who reached sustained remission after four agonizing years of testing and elimination, I interview patients, dentists, periodontists, and medical researchers to investigate real biophysical triggers. Our mission is radical data transparency, connecting clinical minds, and accelerating real discoveries so no one navigates this fire&nbsp;alone.
						</p>
						<p class="continue-reading-p">
							<a href="/blog/my-burning-mouth-syndrome-triggers-bms-acid-sugar/" class="continue-reading-link">Read my complete 4-year recovery story &rarr;</a>
						</p>
					</div>
				</article>
			</section>

			<!-- Action Cards: Join, Subscribe & Follow -->
			<section class="podcast-content-container">
				<h2 class="section-title">Follow &amp; Support the Podcast</h2>
				<p class="section-subhead">Join our growing community of patients and clinicians decoding Burning Mouth&nbsp;Syndrome.</p>

				<div class="action-grid-centered">
					<!-- Action 1: YouTube -->
					<div class="action-tile youtube-tile">
						<div class="tile-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="48" height="48" fill="#ff0000">
								<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
							</svg>
						</div>
						<h3 class="tile-title">Subscribe on YouTube</h3>
						<p class="tile-text">Watch video podcast episodes, case presentations, and radiographic&nbsp;breakdowns.</p>
						<a href="https://www.youtube.com/@DecodingTheBurning?sub_confirmation=1" target="_blank" rel="noopener noreferrer" class="tile-btn youtube-btn">
							Subscribe on YouTube &rarr;
						</a>
					</div>

					<!-- Action 2: Email List -->
					<div class="action-tile email-tile">
						<div class="tile-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="48" height="48" fill="#7c3aed">
								<path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
							</svg>
						</div>
						<h3 class="tile-title">Join Episode Updates</h3>
						<p class="tile-text">Get notified directly when new patient interviews and clinical findings&nbsp;air.</p>
						<a href="/podcast#notify" class="tile-btn email-btn">
							Get Notified of New Episodes &rarr;
						</a>
					</div>

					<!-- Action 3: Be a Guest -->
					<div class="action-tile guest-tile">
						<div class="tile-icon" aria-hidden="true">
							<span style="font-size: 2.75rem; line-height: 1;">🎙️</span>
						</div>
						<h3 class="tile-title">Apply to Be a Guest</h3>
						<p class="tile-text">Whether you're a patient with a story or a clinician with insights, join the&nbsp;show.</p>
						<a href="/podcast#apply" class="tile-btn guest-btn">
							Apply to Be a Guest &rarr;
						</a>
					</div>
				</div>

				<!-- Host & Guide Links Section -->
				<div class="host-info-card">
					<div class="host-info-content">
						<h3 class="host-name">Denis Ethier</h3>
						<p class="host-subtitle">BMS Patient &amp; Host &bull; Quebec, Canada</p>
						<p class="host-bio">
							Leading patient-led clinical research to connect sufferers with compassionate dentists, periodontists, and medical researchers worldwide.
						</p>
					</div>
					<div class="guide-links-row">
						<a href="/podcast/guest-guide" class="guide-link">Guest Preparation Guide &rarr;</a>
						<a href="/podcast/professional-guide" class="guide-link">Clinician Discussion Guide &rarr;</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<style>
			.podcast-content-container {
				max-width: 1080px;
				margin: 1rem auto 5rem;
				padding: 0 1.5rem;
			}

			.section-title {
				font-size: clamp(1.75rem, 3.5vw, 2.25rem);
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 0.5rem 0;
				letter-spacing: -0.02em;
				text-align: center;
				text-wrap: balance;
			}

			.section-subhead {
				font-size: 1.05rem;
				color: #64748b;
				max-width: 600px;
				margin: 0 auto 2.5rem auto;
				line-height: 1.6;
				text-align: center;
				text-wrap: balance;
			}

			.action-grid-centered {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 2rem;
				justify-content: center;
				margin-bottom: 3.5rem;
			}

			.action-tile {
				background: #ffffff;
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 2.5rem 2rem;
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				box-shadow: 0 4px 16px -4px rgba(15, 23, 42, 0.05);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.action-tile:hover {
				transform: translateY(-3px);
				box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.09);
			}

			.tile-icon {
				margin-bottom: 1.25rem;
				height: 52px;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.tile-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 0.65rem 0;
			}

			.tile-text {
				font-size: 0.98rem;
				line-height: 1.6;
				color: #475569;
				margin: 0 0 1.5rem 0;
				flex: 1;
				text-wrap: pretty;
			}

			.tile-btn {
				width: 100%;
				padding: 0.85rem 1.25rem;
				border-radius: 12px;
				font-size: 0.95rem;
				font-weight: 800;
				text-decoration: none;
				display: inline-block;
				text-align: center;
				transition: background 0.2s ease, transform 0.2s ease;
			}

			.youtube-btn {
				background: #ff0000;
				color: #ffffff !important;
			}

			.youtube-btn:hover {
				background: #cc0000;
				transform: translateY(-1px);
			}

			.email-btn {
				background: #7c3aed;
				color: #ffffff !important;
			}

			.email-btn:hover {
				background: #6d28d9;
				transform: translateY(-1px);
			}

			.guest-btn {
				background: #0f172a;
				color: #ffffff !important;
			}

			.guest-btn:hover {
				background: #000000;
				transform: translateY(-1px);
			}

			/* Host Info Card */
			.host-info-card {
				background: #ffffff;
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 2.5rem;
				text-align: center;
				box-shadow: 0 4px 16px -4px rgba(15, 23, 42, 0.04);
				margin-top: 1rem;
			}

			.host-name {
				font-size: 1.4rem;
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 0.35rem 0;
			}

			.host-subtitle {
				font-size: 1.05rem;
				font-weight: 700;
				color: #be123c;
				margin: 0 0 1rem 0;
			}

			.host-bio {
				font-size: 1.05rem;
				line-height: 1.65;
				color: #475569;
				max-width: 650px;
				margin: 0 auto 1.75rem auto;
				text-wrap: pretty;
			}

			.guide-links-row {
				display: flex;
				justify-content: center;
				gap: 2rem;
				flex-wrap: wrap;
				padding-top: 1.5rem;
				border-top: 1px solid #f1f5f9;
			}

			.guide-link {
				font-size: 0.95rem;
				font-weight: 700;
				color: #7c3aed;
				text-decoration: none;
				transition: color 0.15s ease;
			}

			.guide-link:hover {
				color: #5b21b6;
				text-decoration: underline;
			}
		</style>
	</body>
</html>
