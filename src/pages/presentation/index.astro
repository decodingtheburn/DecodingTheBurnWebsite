---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

const slidesOutline = [
  {
    slideNumber: 1,
    title: "BMS and Acidity",
    concept: "A personal presentation by Denis Ethier on uncovering the chemical drivers of burning mouth pain.",
    emoji: "🎯",
    renderType: "img",
    renderSrc: "/bms-head-transparent-pain-map.png",
    renderClass: "render-transparent render-glow-red",
    bullets: [
      "My Research and Discoveries on BMS",
      "I wish I would have found something else much easier, but I've been pain-free for 8 months (0/10, or 1/10 when it flares).",
      "I'll be as honest and direct as I can."
    ]
  },
  {
    slideNumber: 2,
    title: "Disclaimer",
    concept: "Important legal and medical context before sharing personal experiences and observations.",
    emoji: "⚠️",
    renderType: "img",
    renderSrc: "/denis-transparent.png",
    renderClass: "render-portrait",
    bullets: [
      "I am not a doctor; this presentation is not medical advice.",
      "I am a patient and I experimented on myself.",
      "Always consult your doctor or dentist regarding your health.",
      "Every mouth is unique, and this approach might not work for everyone.",
      "This is work in progress; this research is not finished and comes solely from my personal experience."
    ]
  },
  {
    slideNumber: 3,
    title: "What I Tried Before Realizing Acid Was an Issue",
    concept: "Documenting the exhaustive search across medical consultations and conventional remedies.",
    emoji: "❌",
    renderType: "svg",
    renderId: "svg-supplements",
    bullets: [
      "Consulted 5 dentists and 5 doctors who all said everything was completely normal.",
      "Tested over 50 vitamins, mineral supplements, and specialized oral rinses.",
      "Prescription nerve medications that only dulled cognition.",
      "None of these stopped the burning pain."
    ]
  },
  {
    slideNumber: 4,
    title: "My Discovery on Acid",
    concept: "The foundational realization after years of negative exams that oral pain is driven by physical chemical inputs.",
    emoji: "🍋",
    renderType: "svg",
    renderId: "svg-acid",
    bullets: [
      "Giving up these foods and drinks was one of the hardest things I have ever done.",
      "Category 1: Alcohol",
      "Category 2: Coffee",
      "Category 3: Fruits",
      "Category 4: Vegetables and Condiments"
    ]
  },
  {
    slideNumber: 5,
    title: "Finding the Root Cause Part 1",
    concept: "Looking back at personal history to trace how physical triggers were identified.",
    emoji: "🥩",
    renderType: "svg",
    renderId: "svg-cooling-reset",
    bullets: [
      "I found some videos about the carnivore diet.",
      "I had never heard of it before and it sounded crazy, but I was willing to try anything.",
      "Learned that many doctors actually discuss and recommend it for inflammatory issues.",
      "Within weeks of trying it, the burning pain completely went away."
    ]
  },
  {
    slideNumber: 6,
    title: "Why Acid Burns",
    concept: "How underlying dental hardware and vulnerable entry points allow acid to provoke nerve pain.",
    emoji: "🦷",
    renderType: "img",
    renderSrc: "/tooth-transparent.png",
    renderClass: "render-transparent render-glow-violet",
    bullets: [
      "It is very often a multi-cause.",
      "Cavities and hidden decay under restorations create open pathways for acid.",
      "Gum recessions expose sensitive dentin tubules directly to liquids and food.",
      "Misaligned bite points create excessive focal pressure and micro-strain."
    ]
  },
  {
    slideNumber: 7,
    title: "Finding the Root Cause Part 2: Going Back to the Dentist",
    concept: "How targeted dental procedures lowered flare intensity and shifted pain locations.",
    emoji: "🩺",
    renderType: "img",
    renderSrc: "/tooth-transparent-premolar-backup.png",
    renderClass: "render-transparent render-glow-blue",
    bullets: [
      "Targeted dental procedures significantly lowered the intensity of flares.",
      "The lower arch pain completely went away after removing tooth 36 decay.",
      "In the upper arch, the burning pain left the back teeth and tongue completely.",
      "The remaining sensation is now localized specifically around the canines."
    ]
  },
  {
    slideNumber: 8,
    title: "Other Triggers: Cumulative Pain",
    concept: "Understanding how secondary factors like stress and mechanical habits stack.",
    emoji: "⚡",
    renderType: "img",
    renderSrc: "/trigeminal-nerves-glowing-red.png",
    renderClass: "render-feathered render-glow-red",
    bullets: [
      "Referred pain and cumulative nerve stacking across the trigeminal network.",
      "Psychological and physical stress amplify baseline sensitivity.",
      "Subtle clenching, tongue friction, and bite pressure add continuous strain.",
      "Multiple sub-threshold inputs stack until they trigger noticeable burning."
    ]
  },
  {
    slideNumber: 9,
    title: "The Realization: Why Cutting Some Acid Isn't Enough",
    concept: "Understanding why partial elimination fails to deliver lasting zero pain.",
    emoji: "💡",
    renderType: "svg",
    renderId: "svg-bucket",
    bullets: [
      "Eliminating beer or coffee gave temporary 6-month windows of partial relief.",
      "Remaining dietary acids (fruits, vinegar, sauces) kept baseline inflammation simmering below the surface.",
      "The bucket analogy: as long as acid inputs exceed nerve-firing threshold, the brainstem remains sensitized.",
      "Realization: to achieve lasting remission, oral acid must be driven completely below the nerve activation threshold."
    ]
  },
  {
    slideNumber: 10,
    title: "Step 1: Remove Acids as Much as Possible",
    concept: "The actionable step-by-step testing roadmap for sufferers to prove cause and effect.",
    emoji: "🧪",
    renderType: "svg",
    renderId: "svg-water-reset",
    bullets: [
      "Step 1: Remove acids as much as possible.",
      "Step 2: Notice after a few days or a few weeks if you see a difference.",
      "Step 3: Notice what happens to the pain if you cheat on your diet."
    ]
  },
  {
    slideNumber: 11,
    title: "From Worrying to Peace",
    concept: "The transition from fearful anxiety to calm, permanent remission.",
    emoji: "🕊️",
    renderType: "svg",
    renderId: "svg-peace-wave",
    bullets: [
      "Last 7 months completely pain-free, with only one minor 1/10 flare recorded.",
      "No more fear, no more panic about flares: complete understanding of physical cause and effect.",
      "Moving from helpless patient to empowered lead investigator of your own health.",
      "Proof that systematic recovery and peace of mind are completely achievable."
    ]
  },
  {
    slideNumber: 12,
    title: "Acceptance",
    concept: "Reframing pain not as a curse, but as the body's protective alarm system.",
    emoji: "❤️",
    renderType: "svg",
    renderId: "svg-glass-heart",
    bullets: [
      "I wish I could still eat and drink whatever I enjoyed before without consequence.",
      "Acid is inherently destructive to teeth and enamel over time.",
      "Our mouths have dedicated pain receptors specifically to detect acid.",
      "The pain was a clear biological alarm that what I was consuming was destroying my teeth."
    ]
  },
  {
    slideNumber: 13,
    title: "Contribute to the Research",
    concept: "An open invitation to connect directly, share personal experiences, and explore the research.",
    emoji: "🤝",
    renderType: "img",
    renderSrc: "/bms-tracking-sheet-mockup-3pages.png",
    renderClass: "render-mockup",
    bullets: [
      "Share your story in comments when you see my posts or send me a direct message.",
      "Visit decodingtheburn.com to explore tracking sheets and resources.",
      "I am actively compiling a comprehensive master list of what triggers or relieves pain for others (dietary acids, B12, alpha-lipoic acid, zinc, etc.).",
      "Let's combine our observations to map every trigger and help more people find relief."
    ]
  }
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`BMS and Acidity | ${SITE_TITLE}`}
			description="Complete bullet-point outline and brand-purple minimalist presentation mode of Denis Ethier's BMS acid trigger recovery presentation."
			noindex={true}
		/>
		<style>
			:root {
				--bg-page: #f8fafc;
				--card-bg: #ffffff;
				--text-main: #0f172a;
				--text-muted: #334155;
				--brand-purple: #7c3aed;
				--brand-purple-dark: #5b21b6;
			}

			body.outline-body {
				background-color: var(--bg-page);
				color: var(--text-main);
				font-family: 'Inter', system-ui, -apple-system, sans-serif;
				margin: 0;
				padding: 0;
			}

			body.presentation-active {
				overflow: hidden;
				height: 100vh;
			}

			/* =========================================
			   OUTLINE VIEW STYLES
			   ========================================= */
			.outline-container {
				max-width: 960px;
				margin: 2.5rem auto 5rem;
				padding: 0 1.5rem;
			}

			.outline-header {
				text-align: center;
				margin-bottom: 3rem;
				padding-bottom: 2rem;
				border-bottom: 2px solid #e2e8f0;
			}

			.outline-meta {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--brand-purple);
				margin-bottom: 0.5rem;
			}

			.outline-title {
				font-size: clamp(2rem, 4vw, 3rem);
				font-weight: 900;
				color: var(--text-main);
				line-height: 1.2;
				letter-spacing: -0.025em;
				margin: 0 0 1rem;
				text-wrap: balance;
			}

			.outline-lead {
				font-size: 1.12rem;
				color: var(--text-muted);
				max-width: 760px;
				margin: 0 auto 1.75rem;
				line-height: 1.65;
				text-wrap: balance;
			}

			.view-switcher {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				background: #eef2f6;
				padding: 0.35rem;
				border-radius: 14px;
				border: 1px solid #cbd5e1;
			}

			.view-switch-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				border: none;
				background: transparent;
				color: #1e293b;
				font-family: inherit;
				font-size: 0.98rem;
				font-weight: 700;
				padding: 0.65rem 1.25rem;
				border-radius: 10px;
				cursor: pointer;
				transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
			}

			.view-switch-btn:hover {
				color: #0f172a;
				background: rgba(255, 255, 255, 0.7);
			}

			.view-switch-btn.is-active {
				background: var(--brand-purple);
				color: #ffffff;
				box-shadow: 0 4px 12px rgba(124, 58, 237, 0.28);
			}

			.slides-list {
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}

			.slide-outline-card {
				background: var(--card-bg);
				border: 1.5px solid #e2e8f0;
				border-radius: 16px;
				padding: 2rem 2.25rem;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.slide-outline-card:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
			}

			.card-top-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 0.75rem;
				gap: 1rem;
			}

			.card-top-left {
				display: flex;
				align-items: center;
				gap: 0.9rem;
				flex-wrap: wrap;
			}

			.slide-number-label {
				font-size: 0.95rem;
				font-weight: 800;
				color: var(--brand-purple);
			}

			.present-from-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				background: #f5f3ff;
				color: var(--brand-purple-dark);
				border: 1px solid #ddd6fe;
				border-radius: 8px;
				padding: 0.35rem 0.75rem;
				font-family: inherit;
				font-size: 0.85rem;
				font-weight: 700;
				cursor: pointer;
				transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
			}

			.present-from-btn:hover {
				background: var(--brand-purple);
				color: #ffffff;
				border-color: var(--brand-purple);
			}

			.slide-card-emoji {
				font-size: 5rem;
				line-height: 1;
				user-select: none;
				filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.08));
			}

			.slide-card-title {
				font-size: 1.45rem;
				font-weight: 900;
				color: #0f172a;
				line-height: 1.35;
				margin: 0;
				text-wrap: balance;
			}

			.slide-concept {
				font-size: 1.05rem;
				color: #334155;
				font-style: italic;
				margin: 0.5rem 0 1.25rem;
				line-height: 1.5;
				text-wrap: pretty;
			}

			.slide-bullets-ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
				border-top: 1px solid #f1f5f9;
				padding-top: 1.25rem;
			}

			.slide-bullet-li {
				display: flex;
				align-items: flex-start;
				gap: 0.75rem;
				font-size: 1.08rem;
				line-height: 1.6;
				color: #1e293b;
				text-wrap: pretty;
			}

			.bullet-check-dot {
				flex-shrink: 0;
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: #7c3aed;
				margin-top: 0.65rem;
			}

			.slide-bullet-text {
				flex: 1;
			}

			/* =========================================
			   BRAND DARK PURPLE / PURE WHITE PRESENTATION VIEW
			   Exact Book-Cover Aesthetic + Single Transparent Render
			   + Clean Icon-Only Floating Rail on Right Edge
			   ========================================= */
			.presentation-stage {
				/* Default: Book Cover Brand Dark Purple */
				--stage-bg-image: radial-gradient(circle at 75% 50%, rgba(124, 58, 237, 0.22) 0%, rgba(45, 16, 84, 0.16) 42%, transparent 72%),
					linear-gradient(155deg, #1d0935 0%, #130524 52%, #0a0314 100%);
				--stage-bg-solid: #130524;
				--stage-title: #ffffff;
				--stage-bullet: #e9e4f5;
				--stage-bullet-latest: #ffffff;
				--stage-accent: #c084fc;
				--stage-accent-glow: rgba(192, 132, 252, 0.24);
				--stage-divider: rgba(255, 255, 255, 0.14);
				--rail-bg: rgba(26, 10, 48, 0.68);
				--rail-border: rgba(255, 255, 255, 0.14);
				--rail-icon: rgba(233, 228, 245, 0.85);
				--rail-icon-hover: #ffffff;
				--rail-hover-bg: rgba(255, 255, 255, 0.12);
				--stage-track: rgba(255, 255, 255, 0.1);

				position: fixed;
				inset: 0;
				width: 100vw;
				height: 100vh;
				z-index: 9999;
				display: none;
				background-color: var(--stage-bg-solid);
				background-image: var(--stage-bg-image);
				overflow: hidden;
				user-select: none;
				cursor: pointer;
				transition: background-color 0.35s ease;
			}

			.presentation-stage.theme-white {
				--stage-bg-image: radial-gradient(circle at 75% 50%, rgba(124, 58, 237, 0.06) 0%, transparent 62%);
				--stage-bg-solid: #ffffff;
				--stage-title: #0f172a;
				--stage-bullet: #1e293b;
				--stage-bullet-latest: #0f172a;
				--stage-accent: #7c3aed;
				--stage-accent-glow: rgba(124, 58, 237, 0.18);
				--stage-divider: rgba(15, 23, 42, 0.1);
				--rail-bg: rgba(255, 255, 255, 0.86);
				--rail-border: rgba(15, 23, 42, 0.12);
				--rail-icon: #334155;
				--rail-icon-hover: #0f172a;
				--rail-hover-bg: rgba(15, 23, 42, 0.07);
				--stage-track: rgba(15, 23, 42, 0.08);
			}

			.presentation-stage.is-open {
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			/* Direct-on-background slide content column (left ~60%, zero box, zero scroll) */
			.deck-canvas {
				position: relative;
				z-index: 10;
				height: 100vh;
				flex: 1 1 auto;
				max-width: min(60vw, 880px);
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: flex-start;
				padding: clamp(2.5rem, 6vh, 4.5rem) clamp(1.5rem, 3vw, 2.5rem) clamp(2.5rem, 6vh, 4.5rem) clamp(3rem, 7vw, 7rem);
				overflow: hidden;
			}

			.deck-slide-inner {
				width: 100%;
				animation: slideTextFadeIn 0.42s cubic-bezier(0.22, 1, 0.36, 1);
			}

			@keyframes slideTextFadeIn {
				from {
					opacity: 0;
					transform: translateY(8px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			.deck-slide-title {
				font-size: clamp(2rem, min(3.7vw, 5.4vh), 3.45rem);
				font-weight: 900;
				color: var(--stage-title);
				line-height: 1.18;
				letter-spacing: -0.028em;
				margin: 0 0 clamp(1.25rem, 3vh, 2.25rem);
				text-wrap: balance;
			}

			.deck-bullets-list {
				list-style: none;
				padding: clamp(1rem, 2.2vh, 1.75rem) 0 0;
				margin: 0;
				border-top: 1.5px solid var(--stage-divider);
				display: flex;
				flex-direction: column;
				gap: clamp(0.85rem, 2.1vh, 1.5rem);
			}

			.deck-bullets-list :global(.deck-bullet-item) {
				display: flex;
				align-items: flex-start;
				gap: clamp(0.95rem, 1.4vw, 1.3rem);
				font-size: clamp(1.42rem, min(2.35vw, 3.4vh), 2.15rem);
				line-height: 1.4;
				color: var(--stage-bullet);
				font-weight: 500;
				text-wrap: pretty;
				opacity: 0;
				transform: translateY(12px);
				transition: opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1),
					transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
				pointer-events: none;
			}

			.deck-bullets-list :global(.deck-bullet-item.is-revealed) {
				opacity: 1;
				transform: translateY(0);
				pointer-events: auto;
			}

			.deck-bullets-list :global(.deck-bullet-dot) {
				flex-shrink: 0;
				width: 12px;
				height: 12px;
				border-radius: 50%;
				background: var(--stage-accent);
				margin-top: 0.52em;
				transition: transform 0.3s ease, box-shadow 0.3s ease;
			}

			.deck-bullets-list :global(.deck-bullet-item.is-latest .deck-bullet-dot) {
				transform: scale(1.25);
				box-shadow: 0 0 0 6px var(--stage-accent-glow);
			}

			.deck-bullets-list :global(.deck-bullet-item.is-latest .deck-bullet-copy) {
				font-weight: 600;
				color: var(--stage-bullet-latest);
			}

			.deck-bullets-list :global(.deck-bullet-copy) {
				flex: 1;
			}

			/* Single Rendered Transparent Visual Stage (Right Side, Book-Cover Style) */
			.deck-render-zone {
				position: relative;
				z-index: 5;
				width: min(36vw, 480px);
				height: 100vh;
				margin-right: clamp(4.25rem, 5.5vw, 5.75rem);
				display: flex;
				align-items: center;
				justify-content: center;
				pointer-events: none;
			}

			.deck-render-item {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				opacity: 0;
				transform: scale(0.96) translateY(8px);
				transition: opacity 0.65s ease, transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
			}

			.deck-render-item.is-current {
				opacity: 1;
				transform: scale(1) translateY(0);
			}

			.deck-render-item img {
				max-width: 100%;
				max-height: 70vh;
				width: auto;
				height: auto;
				object-fit: contain;
				display: block;
			}

			.deck-render-item svg {
				width: min(31vw, 390px);
				height: min(31vw, 390px);
				display: block;
				overflow: visible;
			}

			.render-transparent {
				filter: drop-shadow(0 24px 55px rgba(0, 0, 0, 0.45));
			}

			.presentation-stage.theme-white .render-transparent {
				filter: drop-shadow(0 20px 42px rgba(15, 23, 42, 0.16));
			}

			.render-glow-red {
				filter: drop-shadow(0 0 42px rgba(239, 68, 68, 0.36)) drop-shadow(0 24px 48px rgba(0, 0, 0, 0.45));
			}

			.render-glow-violet {
				filter: drop-shadow(0 0 42px rgba(168, 85, 247, 0.32)) drop-shadow(0 24px 48px rgba(0, 0, 0, 0.45));
			}

			.render-glow-blue {
				filter: drop-shadow(0 0 42px rgba(96, 165, 250, 0.28)) drop-shadow(0 24px 48px rgba(0, 0, 0, 0.45));
			}

			.presentation-stage.theme-white .render-glow-red,
			.presentation-stage.theme-white .render-glow-violet,
			.presentation-stage.theme-white .render-glow-blue {
				filter: drop-shadow(0 18px 36px rgba(15, 23, 42, 0.18));
			}

			.render-portrait {
				max-height: 62vh !important;
				-webkit-mask-image: linear-gradient(180deg, #000000 72%, transparent 100%);
				mask-image: linear-gradient(180deg, #000000 72%, transparent 100%);
				filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.38));
			}

			.render-feathered {
				border-radius: 50%;
				-webkit-mask-image: radial-gradient(ellipse 68% 72% at 50% 48%, #000000 54%, rgba(0, 0, 0, 0.5) 72%, transparent 94%);
				mask-image: radial-gradient(ellipse 68% 72% at 50% 48%, #000000 54%, rgba(0, 0, 0, 0.5) 72%, transparent 94%);
			}

			.render-mockup {
				border-radius: 18px;
				max-height: 54vh !important;
				box-shadow: 0 28px 65px rgba(0, 0, 0, 0.55);
				border: 1px solid rgba(255, 255, 255, 0.12);
			}

			/* Clean, zero-text floating icon rail on the right edge */
			.deck-floating-rail {
				position: fixed;
				right: 1.1rem;
				top: 50%;
				transform: translateY(-50%);
				z-index: 30;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.28rem;
				padding: 0.45rem 0.35rem;
				background: var(--rail-bg);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border: 1px solid var(--rail-border);
				border-radius: 999px;
				box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
				opacity: 0.28;
				transition: opacity 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
			}

			.deck-floating-rail:hover {
				opacity: 1 !important;
			}

			.presentation-stage.hud-idle .deck-floating-rail {
				opacity: 0.14;
			}

			.rail-icon-btn {
				width: 34px;
				height: 34px;
				border-radius: 50%;
				border: none;
				background: transparent;
				color: var(--rail-icon);
				display: inline-flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				padding: 0;
				transition: background-color 0.18s ease, color 0.18s ease, transform 0.15s ease;
			}

			.rail-icon-btn:hover {
				background: var(--rail-hover-bg);
				color: var(--rail-icon-hover);
			}

			.rail-icon-btn:active {
				transform: scale(0.92);
			}

			.rail-icon-btn:disabled {
				opacity: 0.25;
				cursor: not-allowed;
			}

			.rail-divider {
				width: 18px;
				height: 1px;
				background: var(--rail-border);
				margin: 0.2rem 0;
			}

			.rail-step-dots {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 5px;
				padding: 0.3rem 0;
			}

			.rail-step-dots :global(.rail-dot) {
				width: 5px;
				height: 5px;
				border-radius: 50%;
				background: var(--rail-icon);
				opacity: 0.28;
				transition: opacity 0.25s ease, transform 0.25s ease, background-color 0.25s ease;
			}

			.rail-step-dots :global(.rail-dot.is-filled) {
				background: var(--stage-accent);
				opacity: 1;
				transform: scale(1.25);
			}

			/* Whisper-thin bottom progress line */
			.deck-progress-track {
				position: fixed;
				bottom: 0;
				left: 0;
				right: 0;
				height: 3px;
				background: var(--stage-track);
				z-index: 25;
			}

			.deck-progress-fill {
				height: 100%;
				width: 0%;
				background: linear-gradient(90deg, #9333ea, #c084fc);
				transition: width 0.35s ease;
			}

			@media (max-width: 960px) {
				.deck-canvas {
					max-width: 58vw;
					padding: 2.5rem 1.25rem 2.5rem 2.25rem;
				}
				.deck-render-zone {
					width: min(34vw, 320px);
					margin-right: 3.75rem;
				}
				.deck-render-item svg {
					width: min(30vw, 280px);
					height: min(30vw, 280px);
				}
			}

			@media (max-width: 680px) {
				.slide-outline-card {
					padding: 1.5rem 1.25rem;
				}
				.slide-card-title {
					font-size: 1.25rem;
				}
				.slide-bullet-li {
					font-size: 1rem;
				}
				.presentation-stage.is-open {
					flex-direction: column-reverse;
					justify-content: center;
				}
				.deck-render-zone {
					width: 100vw;
					height: 28vh;
					margin-right: 0;
					padding-top: 1.5rem;
				}
				.deck-render-item img {
					max-height: 24vh !important;
				}
				.deck-render-item svg {
					width: 24vh;
					height: 24vh;
				}
				.deck-canvas {
					height: auto;
					max-width: 100vw;
					padding: 1.5rem 4rem 2.5rem 1.5rem;
				}
				.deck-floating-rail {
					right: 0.6rem;
				}
			}
		</style>
	</head>
	<body class="outline-body">
		<Header />

		<!-- OUTLINE VIEW -->
		<main class="outline-container" id="outline-view">
			<header class="outline-header">
				<div class="outline-meta">Presentation Deck (13 Slides)</div>
				<h1 class="outline-title">
					BMS and&nbsp;Acidity
				</h1>
				<p class="outline-lead">
					Switch between the stacked outline below and brand-purple presentation mode with transparent topic visuals and one-by-one bullet&nbsp;reveal.
				</p>

				<div class="view-switcher" role="tablist" aria-label="Presentation view mode">
					<button
						type="button"
						class="view-switch-btn is-active"
						id="btn-outline-view"
						role="tab"
						aria-selected="true"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<line x1="8" y1="6" x2="21" y2="6"></line>
							<line x1="8" y1="12" x2="21" y2="12"></line>
							<line x1="8" y1="18" x2="21" y2="18"></line>
							<line x1="3" y1="6" x2="3.01" y2="6"></line>
							<line x1="3" y1="12" x2="3.01" y2="12"></line>
							<line x1="3" y1="18" x2="3.01" y2="18"></line>
						</svg>
						<span>Outline View</span>
					</button>
					<button
						type="button"
						class="view-switch-btn"
						id="btn-present-view"
						role="tab"
						aria-selected="false"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
							<line x1="8" y1="21" x2="16" y2="21"></line>
							<line x1="12" y1="17" x2="12" y2="21"></line>
						</svg>
						<span>Presentation View</span>
					</button>
				</div>
			</header>

			<div class="slides-list">
				{slidesOutline.map((slide, index) => (
					<section class="slide-outline-card">
						<div class="card-top-row">
							<div class="card-top-left">
								<span class="slide-number-label">Slide {slide.slideNumber}</span>
								<button
									type="button"
									class="present-from-btn"
									data-start-slide={index}
									aria-label={`Present starting from Slide ${slide.slideNumber}`}
								>
									<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<polygon points="5 3 19 12 5 21 5 3"></polygon>
									</svg>
									<span>Present from here</span>
								</button>
							</div>
							{slide.emoji && <span class="slide-card-emoji">{slide.emoji}</span>}
						</div>
						<h2 class="slide-card-title">{slide.title}</h2>
						<p class="slide-concept">{slide.concept}</p>
						<ul class="slide-bullets-ul">
							{slide.bullets.map((point) => (
								<li class="slide-bullet-li">
									<span class="bullet-check-dot"></span>
									<span class="slide-bullet-text">{point}</span>
								</li>
							))}
						</ul>
					</section>
				))}
			</div>
		</main>

		<!-- BRAND DARK PURPLE / PURE WHITE PRESENTATION VIEW -->
		<div
			class="presentation-stage"
			id="presentation-stage"
			role="region"
			aria-label="Full-screen slide presentation"
