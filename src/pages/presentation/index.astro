---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

const slidesOutline = [
  {
    slideNumber: 1,
    title: "My Discovery on BMS",
    concept: "A personal presentation by Denis Ethier on uncovering the chemical drivers of burning mouth pain.",
    emoji: "🎯",
    bgImage: "/images/presentation/slide-01.jpg",
    bullets: [
      "My Research and Discoveries on BMS",
      "I wish I would have found something else much easier, but I've been pain-free for 8 months (0/10, or 1/10 when it flares).",
      "I'll be as honest and direct as I can."
    ]
  },
  {
    slideNumber: 2,
    title: "Disclaimer",
    concept: "Important legal and medical context before sharing personal experiences and observations.",
    emoji: "⚠️",
    bgImage: "/images/presentation/slide-02.jpg",
    bullets: [
      "I am not a doctor; this presentation is not medical advice.",
      "I am a patient and I experimented on myself.",
      "Always consult your doctor or dentist regarding your health.",
      "Every mouth is unique, and this approach might not work for everyone.",
      "This is work in progress; this research is not finished and comes solely from my personal experience."
    ]
  },
  {
    slideNumber: 3,
    title: "What I Tried Before Realizing Acid Was an Issue",
    concept: "Documenting the exhaustive search across medical consultations and conventional remedies.",
    emoji: "❌",
    bgImage: "/images/presentation/slide-03.jpg",
    bullets: [
      "Consulted 5 dentists and 5 doctors who all said everything was completely normal.",
      "Tested over 50 vitamins, mineral supplements, and specialized oral rinses.",
      "Prescription nerve medications that only dulled cognition.",
      "None of these stopped the burning pain."
    ]
  },
  {
    slideNumber: 4,
    title: "My Discovery on Acid",
    concept: "The foundational realization after years of negative exams that oral pain is driven by physical chemical inputs.",
    emoji: "🍋",
    bgImage: "/images/presentation/slide-04.jpg",
    bullets: [
      "Giving up these foods and drinks was one of the hardest things I have ever done.",
      "Category 1: Alcohol",
      "Category 2: Coffee",
      "Category 3: Fruits",
      "Category 4: Vegetables and Condiments"
    ]
  },
  {
    slideNumber: 5,
    title: "Finding the Root Cause Part 1",
    concept: "Looking back at personal history to trace how physical triggers were identified.",
    emoji: "🥩",
    bgImage: "/images/presentation/slide-05.jpg",
    bullets: [
      "I found some videos about the carnivore diet.",
      "I had never heard of it before and it sounded crazy, but I was willing to try anything.",
      "Learned that many doctors actually discuss and recommend it for inflammatory issues.",
      "Within weeks of trying it, the burning pain completely went away."
    ]
  },
  {
    slideNumber: 6,
    title: "Why Acid Burns",
    concept: "How underlying dental hardware and vulnerable entry points allow acid to provoke nerve pain.",
    emoji: "🦷",
    bgImage: "/images/presentation/slide-06.jpg",
    bullets: [
      "It is very often a multi-cause.",
      "Cavities and hidden decay under restorations create open pathways for acid.",
      "Gum recessions expose sensitive dentin tubules directly to liquids and food.",
      "Misaligned bite points create excessive focal pressure and micro-strain."
    ]
  },
  {
    slideNumber: 7,
    title: "Finding the Root Cause Part 2: Going Back to the Dentist",
    concept: "How targeted dental procedures lowered flare intensity and shifted pain locations.",
    emoji: "🩺",
    bgImage: "/images/presentation/slide-07.jpg",
    bullets: [
      "Targeted dental procedures significantly lowered the intensity of flares.",
      "The lower arch pain completely went away after removing tooth 36 decay.",
      "In the upper arch, the burning pain left the back teeth and tongue completely.",
      "The remaining sensation is now localized specifically around the canines."
    ]
  },
  {
    slideNumber: 8,
    title: "Other Triggers: Cumulative Pain",
    concept: "Understanding how secondary factors like stress and mechanical habits stack.",
    emoji: "⚡",
    bgImage: "/images/presentation/slide-08.jpg",
    bullets: [
      "Referred pain and cumulative nerve stacking across the trigeminal network.",
      "Psychological and physical stress amplify baseline sensitivity.",
      "Subtle clenching, tongue friction, and bite pressure add continuous strain.",
      "Multiple sub-threshold inputs stack until they trigger noticeable burning."
    ]
  },
  {
    slideNumber: 9,
    title: "The Realization: Why Cutting Some Acid Isn't Enough",
    concept: "Understanding why partial elimination fails to deliver lasting zero pain.",
    emoji: "💡",
    bgImage: "/images/presentation/slide-09.jpg",
    bullets: [
      "Eliminating beer or coffee gave temporary 6-month windows of partial relief.",
      "Remaining dietary acids (fruits, vinegar, sauces) kept baseline inflammation simmering below the surface.",
      "The bucket analogy: as long as acid inputs exceed nerve-firing threshold, the brainstem remains sensitized.",
      "Realization: to achieve lasting remission, oral acid must be driven completely below the nerve activation threshold."
    ]
  },
  {
    slideNumber: 10,
    title: "Step 1: Remove Acids as Much as Possible",
    concept: "The actionable step-by-step testing roadmap for sufferers to prove cause and effect.",
    emoji: "🧪",
    bgImage: "/images/presentation/slide-10.jpg",
    bullets: [
      "Step 1: Remove acids as much as possible.",
      "Step 2: Notice after a few days or a few weeks if you see a difference.",
      "Step 3: Notice what happens to the pain if you cheat on your diet."
    ]
  },
  {
    slideNumber: 11,
    title: "From Worrying to Peace",
    concept: "The transition from fearful anxiety to calm, permanent remission.",
    emoji: "🕊️",
    bgImage: "/images/presentation/slide-11.jpg",
    bullets: [
      "Last 7 months completely pain-free, with only one minor 1/10 flare recorded.",
      "No more fear, no more panic about flares: complete understanding of physical cause and effect.",
      "Moving from helpless patient to empowered lead investigator of your own health.",
      "Proof that systematic recovery and peace of mind are completely achievable."
    ]
  },
  {
    slideNumber: 12,
    title: "Acceptance",
    concept: "Reframing pain not as a curse, but as the body's protective alarm system.",
    emoji: "❤️",
    bgImage: "/images/presentation/slide-12.jpg",
    bullets: [
      "I wish I could still eat and drink whatever I enjoyed before without consequence.",
      "Acid is inherently destructive to teeth and enamel over time.",
      "Our mouths have dedicated pain receptors specifically to detect acid.",
      "The pain was a clear biological alarm that what I was consuming was destroying my teeth."
    ]
  },
  {
    slideNumber: 13,
    title: "Contribute to the Research",
    concept: "An open invitation to connect directly, share personal experiences, and explore the research.",
    emoji: "🤝",
    bgImage: "/images/presentation/slide-13.jpg",
    bullets: [
      "Share your story in comments when you see my posts or send me a direct message.",
      "Visit decodingtheburn.com to explore tracking sheets and resources.",
      "I am actively compiling a comprehensive master list of what triggers or relieves pain for others (dietary acids, B12, alpha-lipoic acid, zinc, etc.).",
      "Let's combine our observations to map every trigger and help more people find relief."
    ]
  }
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Presentation Slides | ${SITE_TITLE}`}
			description="Complete bullet-point outline and minimalist borderless presentation mode of Denis Ethier's BMS acid trigger recovery presentation."
			noindex={true}
		/>
		<style>
			:root {
				--bg-page: #f8fafc;
				--card-bg: #ffffff;
				--text-main: #0f172a;
				--text-muted: #334155;
				--brand-purple: #7c3aed;
				--brand-purple-dark: #5b21b6;
			}

			body.outline-body {
				background-color: var(--bg-page);
				color: var(--text-main);
				font-family: 'Inter', system-ui, -apple-system, sans-serif;
				margin: 0;
				padding: 0;
			}

			body.presentation-active {
				overflow: hidden;
				height: 100vh;
			}

			/* =========================================
			   OUTLINE VIEW STYLES
			   ========================================= */
			.outline-container {
				max-width: 960px;
				margin: 2.5rem auto 5rem;
				padding: 0 1.5rem;
			}

			.outline-header {
				text-align: center;
				margin-bottom: 3rem;
				padding-bottom: 2rem;
				border-bottom: 2px solid #e2e8f0;
			}

			.outline-meta {
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--brand-purple);
				margin-bottom: 0.5rem;
			}

			.outline-title {
				font-size: clamp(2rem, 4vw, 3rem);
				font-weight: 900;
				color: var(--text-main);
				line-height: 1.2;
				letter-spacing: -0.025em;
				margin: 0 0 1rem;
				text-wrap: balance;
			}

			.outline-lead {
				font-size: 1.12rem;
				color: var(--text-muted);
				max-width: 760px;
				margin: 0 auto 1.75rem;
				line-height: 1.65;
				text-wrap: balance;
			}

			/* View Mode Switcher */
			.view-switcher {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				background: #eef2f6;
				padding: 0.35rem;
				border-radius: 14px;
				border: 1px solid #cbd5e1;
			}

			.view-switch-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				border: none;
				background: transparent;
				color: #1e293b;
				font-family: inherit;
				font-size: 0.98rem;
				font-weight: 700;
				padding: 0.65rem 1.25rem;
				border-radius: 10px;
				cursor: pointer;
				transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
			}

			.view-switch-btn:hover {
				color: #0f172a;
				background: rgba(255, 255, 255, 0.7);
			}

			.view-switch-btn.is-active {
				background: var(--brand-purple);
				color: #ffffff;
				box-shadow: 0 4px 12px rgba(124, 58, 237, 0.28);
			}

			.slides-list {
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}

			.slide-outline-card {
				background: var(--card-bg);
				border: 1.5px solid #e2e8f0;
				border-radius: 16px;
				padding: 2rem 2.25rem;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.slide-outline-card:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
			}

			.card-top-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 0.75rem;
				gap: 1rem;
			}

			.card-top-left {
				display: flex;
				align-items: center;
				gap: 0.9rem;
				flex-wrap: wrap;
			}

			.slide-number-label {
				font-size: 0.95rem;
				font-weight: 800;
				color: var(--brand-purple);
			}

			.present-from-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				background: #f5f3ff;
				color: var(--brand-purple-dark);
				border: 1px solid #ddd6fe;
				border-radius: 8px;
				padding: 0.35rem 0.75rem;
				font-family: inherit;
				font-size: 0.85rem;
				font-weight: 700;
				cursor: pointer;
				transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
			}

			.present-from-btn:hover {
				background: var(--brand-purple);
				color: #ffffff;
				border-color: var(--brand-purple);
			}

			.slide-card-emoji {
				font-size: 5rem;
				line-height: 1;
				user-select: none;
				filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.08));
			}

			.slide-card-title {
				font-size: 1.45rem;
				font-weight: 900;
				color: #0f172a;
				line-height: 1.35;
				margin: 0;
				text-wrap: balance;
			}

			.slide-concept {
				font-size: 1.05rem;
				color: #334155;
				font-style: italic;
				margin: 0.5rem 0 1.25rem;
				line-height: 1.5;
				text-wrap: pretty;
			}

			.slide-bullets-ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
				border-top: 1px solid #f1f5f9;
				padding-top: 1.25rem;
			}

			.slide-bullet-li {
				display: flex;
				align-items: flex-start;
				gap: 0.75rem;
				font-size: 1.08rem;
				line-height: 1.6;
				color: #1e293b;
				text-wrap: pretty;
			}

			.bullet-check-dot {
				flex-shrink: 0;
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: #7c3aed;
				margin-top: 0.65rem;
			}

			.slide-bullet-text {
				flex: 1;
			}

			/* =========================================
			   MINIMALIST BORDERLESS PRESENTATION VIEW
			   Direct on pure white / dark canvas, zero cards, zero scrollbars
			   ========================================= */
			.presentation-stage {
				--stage-bg: #ffffff;
				--stage-title: #0f172a;
				--stage-bullet: #1e293b;
				--stage-bullet-latest: #0f172a;
				--stage-label: #5b21b6;
				--stage-divider: rgba(15, 23, 42, 0.1);
				--stage-hint: #334155;
				--stage-hud-bg: rgba(255, 255, 255, 0.88);
				--stage-hud-border: #cbd5e1;
				--stage-hud-text: #0f172a;
				--stage-hud-hover: #f1f5f9;
				--stage-pip-empty: #cbd5e1;
				--stage-track: #e2e8f0;

				position: fixed;
				inset: 0;
				width: 100vw;
				height: 100vh;
				z-index: 9999;
				display: none;
				background-color: var(--stage-bg);
				overflow: hidden;
				user-select: none;
				cursor: pointer;
				transition: background-color 0.35s ease;
			}

			.presentation-stage.theme-dark {
				--stage-bg: #080a0f;
				--stage-title: #f8fafc;
				--stage-bullet: #e2e8f0;
				--stage-bullet-latest: #ffffff;
				--stage-label: #c4b5fd;
				--stage-divider: rgba(248, 250, 252, 0.14);
				--stage-hint: #cbd5e1;
				--stage-hud-bg: rgba(15, 23, 42, 0.82);
				--stage-hud-border: rgba(255, 255, 255, 0.18);
				--stage-hud-text: #f8fafc;
				--stage-hud-hover: rgba(255, 255, 255, 0.12);
				--stage-pip-empty: rgba(255, 255, 255, 0.28);
				--stage-track: rgba(255, 255, 255, 0.14);
			}

			.presentation-stage.is-open {
				display: block;
			}

			/* Right-side calming fine-art visual smoothly feathered into solid pure canvas */
			.deck-backgrounds {
				position: absolute;
				top: 0;
				right: 0;
				bottom: 0;
				width: 44vw;
				z-index: 0;
				overflow: hidden;
				pointer-events: none;
				-webkit-mask-image: linear-gradient(
					90deg,
					transparent 0%,
					rgba(0, 0, 0, 0.12) 22%,
					rgba(0, 0, 0, 0.68) 54%,
					#000000 88%
				);
				mask-image: linear-gradient(
					90deg,
					transparent 0%,
					rgba(0, 0, 0, 0.12) 22%,
					rgba(0, 0, 0, 0.68) 54%,
					#000000 88%
				);
			}

			.deck-bg-layer {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				opacity: 0;
				transform: scale(1.02);
				transition: opacity 0.8s ease-in-out, transform 12s ease-out, filter 0.35s ease;
				pointer-events: none;
			}

			.deck-bg-layer.is-current {
				opacity: 0.92;
				transform: scale(1);
			}

			.presentation-stage.theme-dark .deck-bg-layer.is-current {
				opacity: 0.68;
				filter: brightness(0.75) contrast(1.08);
			}

			/* Upper-right signature slide emoji */
			.deck-corner-emoji {
				position: fixed;
				top: clamp(1.5rem, 3.5vh, 2.75rem);
				right: clamp(2rem, 4vw, 3.5rem);
				z-index: 12;
				font-size: clamp(3.25rem, min(5.5vw, 7.5vh), 5rem);
				line-height: 1;
				pointer-events: none;
				filter: drop-shadow(0 6px 16px rgba(15, 23, 42, 0.16));
			}

			/* Direct-on-background content zone (left 64%, zero box, zero scrolling) */
			.deck-canvas {
				position: relative;
				z-index: 10;
				height: 100vh;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: flex-start;
				padding: clamp(3.5rem, 7vh, 5.25rem) clamp(2rem, 4vw, 4rem) clamp(4.5rem, 9vh, 6rem) clamp(2.5rem, 6.5vw, 6.5rem);
				max-width: min(65vw, 940px);
				overflow: hidden;
			}

			.deck-slide-inner {
				width: 100%;
				animation: slideTextFadeIn 0.42s cubic-bezier(0.22, 1, 0.36, 1);
			}

			@keyframes slideTextFadeIn {
				from {
					opacity: 0;
					transform: translateY(10px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			.deck-slide-step-label {
				font-size: clamp(0.95rem, min(1.25vw, 1.85vh), 1.15rem);
				font-weight: 700;
				color: var(--stage-label);
				margin-bottom: clamp(0.45rem, 1.1vh, 0.85rem);
			}

			.deck-slide-title {
				font-size: clamp(1.85rem, min(3.6vw, 5.2vh), 3.4rem);
				font-weight: 900;
				color: var(--stage-title);
				line-height: 1.2;
				letter-spacing: -0.028em;
				margin: 0 0 clamp(1.2rem, 2.8vh, 2.15rem);
				text-wrap: balance;
			}

			.deck-bullets-list {
				list-style: none;
				padding: clamp(1rem, 2.1vh, 1.65rem) 0 0;
				margin: 0;
				border-top: 2px solid var(--stage-divider);
				display: flex;
				flex-direction: column;
				gap: clamp(0.8rem, 2vh, 1.45rem);
			}

			.deck-bullets-list :global(.deck-bullet-item) {
				display: flex;
				align-items: flex-start;
				gap: clamp(0.8rem, 1.3vw, 1.15rem);
				font-size: clamp(1.08rem, min(1.75vw, 2.65vh), 1.65rem);
				line-height: 1.45;
				color: var(--stage-bullet);
				font-weight: 500;
				text-wrap: pretty;
				opacity: 0;
				transform: translateY(14px);
				transition: opacity 0.42s cubic-bezier(0.22, 1, 0.36, 1),
					transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
				pointer-events: none;
			}

			.deck-bullets-list :global(.deck-bullet-item.is-revealed) {
				opacity: 1;
				transform: translateY(0);
				pointer-events: auto;
			}

			.deck-bullets-list :global(.deck-bullet-dot) {
				flex-shrink: 0;
				width: 11px;
				height: 11px;
				border-radius: 50%;
				background: #7c3aed;
				margin-top: 0.54em;
				transition: transform 0.3s ease, box-shadow 0.3s ease;
			}

			.presentation-stage.theme-dark .deck-bullets-list :global(.deck-bullet-dot) {
				background: #a78bfa;
			}

			.deck-bullets-list :global(.deck-bullet-item.is-latest .deck-bullet-dot) {
				transform: scale(1.28);
				box-shadow: 0 0 0 6px rgba(124, 58, 237, 0.2);
			}

			.deck-bullets-list :global(.deck-bullet-item.is-latest .deck-bullet-copy) {
				font-weight: 600;
				color: var(--stage-bullet-latest);
			}

			.deck-bullets-list :global(.deck-bullet-copy) {
				flex: 1;
			}

			.deck-prompt-hint {
				margin-top: clamp(1rem, 2.2vh, 1.6rem);
				font-size: 0.96rem;
				font-weight: 600;
				color: var(--stage-hint);
				opacity: 0.78;
				transition: opacity 0.3s ease;
			}

			.deck-prompt-hint.is-hidden {
				opacity: 0;
				pointer-events: none;
			}

			/* Subtle floating controls (auto-fade when mouse is idle) */
			.deck-top-hud {
				position: fixed;
				top: 1.25rem;
				left: 1.5rem;
				z-index: 20;
				display: flex;
				align-items: center;
				gap: 0.55rem;
				transition: opacity 0.35s ease;
			}

			.presentation-stage.hud-idle .deck-top-hud,
			.presentation-stage.hud-idle .deck-bottom-hud {
				opacity: 0.12;
			}

			.deck-top-hud:hover,
			.deck-bottom-hud:hover {
				opacity: 1 !important;
			}

			.hud-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				background: var(--stage-hud-bg);
				color: var(--stage-hud-text);
				border: 1px solid var(--stage-hud-border);
				backdrop-filter: blur(10px);
				border-radius: 10px;
				padding: 0.5rem 0.95rem;
				font-family: inherit;
				font-size: 0.9rem;
				font-weight: 700;
				cursor: pointer;
				box-shadow: 0 2px 10px rgba(15, 23, 42, 0.06);
				transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
			}

			.hud-btn:hover {
				background: var(--stage-hud-hover);
			}

			.hud-btn:active {
				transform: scale(0.98);
			}

			.hud-btn:disabled {
				opacity: 0.35;
				cursor: not-allowed;
			}

			.deck-bottom-hud {
				position: fixed;
				bottom: 1.35rem;
				left: 50%;
				transform: translateX(-50%);
				z-index: 20;
				display: flex;
				align-items: center;
				gap: 0.55rem;
				background: var(--stage-hud-bg);
				backdrop-filter: blur(14px);
				border: 1px solid var(--stage-hud-border);
				border-radius: 14px;
				padding: 0.4rem 0.65rem;
				color: var(--stage-hud-text);
				box-shadow: 0 8px 28px rgba(15, 23, 42, 0.1);
				transition: opacity 0.35s ease;
			}

			.deck-bottom-hud .hud-btn {
				background: transparent;
				border-color: transparent;
				box-shadow: none;
				padding: 0.45rem 0.75rem;
			}

			.deck-bottom-hud .hud-btn:hover {
				background: var(--stage-hud-hover);
				border-color: transparent;
			}

			.hud-step-status {
				font-size: 0.9rem;
				font-weight: 700;
				color: var(--stage-hud-text);
				padding: 0 0.45rem;
				white-space: nowrap;
			}

			.hud-bullet-dots {
				display: flex;
				align-items: center;
				gap: 0.38rem;
				padding: 0 0.4rem;
			}

			.hud-bullet-dots :global(.hud-bullet-pip) {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: var(--stage-pip-empty);
				transition: background-color 0.25s ease, transform 0.25s ease;
			}

			.hud-bullet-dots :global(.hud-bullet-pip.is-filled) {
				background: #7c3aed;
				transform: scale(1.18);
			}

			.presentation-stage.theme-dark .hud-bullet-dots :global(.hud-bullet-pip.is-filled) {
				background: #c4b5fd;
			}

			.deck-progress-track {
				position: fixed;
				bottom: 0;
				left: 0;
				right: 0;
				height: 4px;
				background: var(--stage-track);
				z-index: 25;
			}

			.deck-progress-fill {
				height: 100%;
				width: 0%;
				background: linear-gradient(90deg, #7c3aed, #a78bfa);
				transition: width 0.35s ease;
			}

			@media (max-width: 900px) {
				.deck-backgrounds {
					width: 34vw;
					opacity: 0.55;
				}
				.deck-canvas {
					max-width: 84vw;
					padding: 4.5rem 2rem 5.5rem;
				}
			}

			@media (max-width: 768px) {
				.slide-outline-card {
					padding: 1.5rem 1.25rem;
				}
				.slide-card-title {
					font-size: 1.25rem;
				}
				.slide-bullet-li {
					font-size: 1rem;
				}
				.deck-backgrounds {
					width: 100vw;
					opacity: 0.14;
					-webkit-mask-image: none;
					mask-image: none;
				}
				.deck-canvas {
					max-width: 100vw;
					padding: 4.5rem 1.5rem 5.5rem;
				}
				.deck-corner-emoji {
					top: 1.15rem;
					right: 1.25rem;
					font-size: 2.5rem;
				}
				.deck-bottom-hud {
					width: calc(100vw - 1.5rem);
					justify-content: space-between;
				}
				.hud-bullet-dots {
					display: none;
				}
			}
		</style>
	</head>
	<body class="outline-body">
		<Header />

		<!-- OUTLINE VIEW -->
		<main class="outline-container" id="outline-view">
			<header class="outline-header">
				<div class="outline-meta">Presentation Deck (13 Slides)</div>
				<h1 class="outline-title">
					Is Acidity a Trigger for Your Burning&nbsp;Mouth?
				</h1>
				<p class="outline-lead">
					Switch between the stacked outline below and borderless full-screen presentation mode with calming slide art and one-by-one bullet&nbsp;reveal.
				</p>

				<div class="view-switcher" role="tablist" aria-label="Presentation view mode">
					<button
						type="button"
						class="view-switch-btn is-active"
						id="btn-outline-view"
						role="tab"
						aria-selected="true"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<line x1="8" y1="6" x2="21" y2="6"></line>
							<line x1="8" y1="12" x2="21" y2="12"></line>
							<line x1="8" y1="18" x2="21" y2="18"></line>
							<line x1="3" y1="6" x2="3.01" y2="6"></line>
							<line x1="3" y1="12" x2="3.01" y2="12"></line>
							<line x1="3" y1="18" x2="3.01" y2="18"></line>
						</svg>
						<span>Outline View</span>
					</button>
					<button
						type="button"
						class="view-switch-btn"
						id="btn-present-view"
						role="tab"
						aria-selected="false"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
							<line x1="8" y1="21" x2="16" y2="21"></line>
							<line x1="12" y1="17" x2="12" y2="21"></line>
						</svg>
						<span>Presentation View</span>
					</button>
				</div>
			</header>

			<div class="slides-list">
				{slidesOutline.map((slide, index) => (
					<section class="slide-outline-card">
						<div class="card-top-row">
							<div class="card-top-left">
								<span class="slide-number-label">Slide {slide.slideNumber}</span>
								<button
									type="button"
									class="present-from-btn"
									data-start-slide={index}
									aria-label={`Present starting from Slide ${slide.slideNumber}`}
								>
									<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<polygon points="5 3 19 12 5 21 5 3"></polygon>
									</svg>
									<span>Present from here</span>
								</button>
							</div>
							{slide.emoji && <span class="slide-card-emoji">{slide.emoji}</span>}
						</div>
						<h2 class="slide-card-title">{slide.title}</h2>
						<p class="slide-concept">{slide.concept}</p>
						<ul class="slide-bullets-ul">
							{slide.bullets.map((point) => (
								<li class="slide-bullet-li">
									<span class="bullet-check-dot"></span>
									<span class="slide-bullet-text">{point}</span>
								</li>
							))}
						</ul>
					</section>
				))}
			</div>
		</main>

		<!-- MINIMALIST BORDERLESS PRESENTATION VIEW -->
		<div
			class="presentation-stage"
			id="presentation-stage"
			role="region"
			aria-label="Full-screen slide presentation"
			aria-hidden="true"
		>
			<div class="deck-backgrounds" id="deck-backgrounds">
				{slidesOutline.map((slide, idx) => (
					<img
						src={slide.bgImage}
						alt=""
						class={`deck-bg-layer ${idx === 0 ? 'is-current' : ''}`}
						data-bg-index={idx}
						loading={idx < 3 ? 'eager' : 'lazy'}
					/>
				))}
			</div>

			<div class="deck-top-hud">
				<button type="button" class="hud-btn" id="btn-exit-present">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
					<span>Outline View</span>
				</button>
				<button type="button" class="hud-btn" id="btn-toggle-theme" title="Switch White or Black Background (T)">
					<span id="theme-label">Dark Mode</span>
				</button>
				<button type="button" class="hud-btn" id="btn-toggle-fullscreen" title="Toggle Fullscreen (F)">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="15 3 21 3 21 9"></polyline>
						<polyline points="9 21 3 21 3 15"></polyline>
						<line x1="21" y1="3" x2="14" y2="10"></line>
						<line x1="3" y1="21" x2="10" y2="14"></line>
					</svg>
					<span id="fullscreen-label">Fullscreen</span>
				</button>
			</div>

			<div class="deck-corner-emoji" id="deck-slide-emoji" aria-hidden="true"></div>

			<div class="deck-canvas" id="deck-canvas">
				<div class="deck-slide-inner" id="deck-slide-inner">
					<div class="deck-slide-step-label" id="deck-slide-label">Slide 1 of 13</div>
					<h2 class="deck-slide-title" id="deck-slide-title"></h2>
					<ul class="deck-bullets-list" id="deck-bullets-list"></ul>
					<div class="deck-prompt-hint" id="deck-prompt-hint">
						Press Spacebar or click to show the next&nbsp;bullet
					</div>
				</div>
			</div>

			<div class="deck-bottom-hud" id="deck-bottom-hud">
				<button type="button" class="hud-btn" id="btn-prev-slide" title="Previous Slide (Shift + Left)">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="11 17 6 12 11 7"></polyline>
						<polyline points="18 17 13 12 18 7"></polyline>
					</svg>
				</button>
				<button type="button" class="hud-btn" id="btn-prev-step" title="Previous Step (Left Arrow)">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
					<span>Back</span>
				</button>

				<div class="hud-step-status" id="hud-step-status">Slide 1 / 13</div>
				<div class="hud-bullet-dots" id="hud-bullet-dots" aria-hidden="true"></div>

				<button type="button" class="hud-btn" id="btn-next-step" title="Next Bullet or Slide (Space / Right Arrow)">
					<span>Next</span>
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="9 18 15 12 9 6"></polyline>
					</svg>
				</button>
				<button type="button" class="hud-btn" id="btn-next-slide" title="Next Slide (Shift + Right)">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="13 17 18 12 13 7"></polyline>
						<polyline points="6 17 11 12 6 7"></polyline>
					</svg>
				</button>
			</div>

			<div class="deck-progress-track">
				<div class="deck-progress-fill" id="deck-progress-fill"></div>
			</div>
		</div>

		<Footer />

		<script define:vars={{ slidesOutline }}>
			const slides = slidesOutline;
			let isPresentationMode = false;
			let isDarkTheme = false;
			let currentSlideIndex = 0;
			let revealedBullets = 0;
			let hudIdleTimer = null;

			const stageEl = document.getElementById('presentation-stage');
			const btnOutlineView = document.getElementById('btn-outline-view');
			const btnPresentView = document.getElementById('btn-present-view');
			const btnExitPresent = document.getElementById('btn-exit-present');
			const btnToggleTheme = document.getElementById('btn-toggle-theme');
			const themeLabel = document.getElementById('theme-label');
			const btnToggleFullscreen = document.getElementById('btn-toggle-fullscreen');
			const fullscreenLabel = document.getElementById('fullscreen-label');
			const btnPrevSlide = document.getElementById('btn-prev-slide');
			const btnNextSlide = document.getElementById('btn-next-slide');
			const btnPrevStep = document.getElementById('btn-prev-step');
			const btnNextStep = document.getElementById('btn-next-step');
			const slideInner = document.getElementById('deck-slide-inner');
			const slideLabelEl = document.getElementById('deck-slide-label');
			const slideTitleEl = document.getElementById('deck-slide-title');
			const slideEmojiEl = document.getElementById('deck-slide-emoji');
			const bulletsListEl = document.getElementById('deck-bullets-list');
			const promptHintEl = document.getElementById('deck-prompt-hint');
			const hudStatusEl = document.getElementById('hud-step-status');
			const hudDotsEl = document.getElementById('hud-bullet-dots');
			const progressFillEl = document.getElementById('deck-progress-fill');
			const bgLayers = Array.from(document.querySelectorAll('.deck-bg-layer'));

			function updateUrlState() {
				const url = new URL(window.location.href);
				if (isPresentationMode) {
					url.searchParams.set('view', 'present');
					url.searchParams.set('slide', String(currentSlideIndex + 1));
				} else {
					url.searchParams.delete('view');
					url.searchParams.delete('slide');
				}
				window.history.replaceState({}, '', url.toString());
			}

			function toggleTheme() {
				isDarkTheme = !isDarkTheme;
				if (stageEl) {
					stageEl.classList.toggle('theme-dark', isDarkTheme);
				}
				if (themeLabel) {
					themeLabel.textContent = isDarkTheme ? 'White Mode' : 'Dark Mode';
				}
			}

			function resetHudIdle() {
				if (!stageEl) return;
				stageEl.classList.remove('hud-idle');
				if (hudIdleTimer) window.clearTimeout(hudIdleTimer);
				hudIdleTimer = window.setTimeout(() => {
					if (isPresentationMode) {
						stageEl.classList.add('hud-idle');
					}
				}, 3200);
			}

			function renderSlideContent(animateSlide = true) {
				const slide = slides[currentSlideIndex];
				if (!slide) return;

				bgLayers.forEach((img, idx) => {
					img.classList.toggle('is-current', idx === currentSlideIndex);
				});

				if (animateSlide && slideInner) {
					slideInner.style.animation = 'none';
					void slideInner.offsetWidth;
					slideInner.style.animation = '';
				}

				if (slideLabelEl) {
					slideLabelEl.textContent = `Slide ${slide.slideNumber} of ${slides.length}`;
				}
				if (slideTitleEl) {
					slideTitleEl.textContent = slide.title;
				}
				if (slideEmojiEl) {
					slideEmojiEl.textContent = slide.emoji || '';
				}

				if (bulletsListEl) {
					bulletsListEl.innerHTML = '';
					slide.bullets.forEach((text, i) => {
						const li = document.createElement('li');
						li.className = 'deck-bullet-item';
						li.dataset.bulletIndex = String(i);

						const dot = document.createElement('span');
						dot.className = 'deck-bullet-dot';

						const copy = document.createElement('span');
						copy.className = 'deck-bullet-copy';
						copy.textContent = text;

						li.appendChild(dot);
						li.appendChild(copy);
						bulletsListEl.appendChild(li);
					});
				}

				syncBulletVisibility();
				updateUrlState();
			}

			function syncBulletVisibility() {
				const slide = slides[currentSlideIndex];
				if (!slide) return;

				const items = bulletsListEl ? Array.from(bulletsListEl.querySelectorAll('.deck-bullet-item')) : [];
				items.forEach((item, idx) => {
					const isShown = idx < revealedBullets;
					const isLatest = idx === revealedBullets - 1;
					item.classList.toggle('is-revealed', isShown);
					item.classList.toggle('is-latest', isLatest);
				});

				if (promptHintEl) {
					const showHint = revealedBullets === 0;
					promptHintEl.classList.toggle('is-hidden', !showHint);
				}

				if (hudStatusEl) {
					hudStatusEl.textContent = `Slide ${slide.slideNumber} / ${slides.length}`;
				}

				if (hudDotsEl) {
					hudDotsEl.innerHTML = '';
					slide.bullets.forEach((_, idx) => {
						const pip = document.createElement('span');
						pip.className = `hud-bullet-pip ${idx < revealedBullets ? 'is-filled' : ''}`;
						hudDotsEl.appendChild(pip);
					});
				}

				if (progressFillEl) {
					const totalBullets = slide.bullets.length || 1;
					const slideFraction = revealedBullets / totalBullets;
					const pct = ((currentSlideIndex + slideFraction) / slides.length) * 100;
					progressFillEl.style.width = `${Math.min(100, Math.max(2, pct))}%`;
				}

				const isAtStart = currentSlideIndex === 0 && revealedBullets === 0;
				const isAtEnd = currentSlideIndex === slides.length - 1 && revealedBullets >= slide.bullets.length;

				if (btnPrevStep) btnPrevStep.disabled = isAtStart;
				if (btnNextStep) btnNextStep.disabled = isAtEnd;
				if (btnPrevSlide) btnPrevSlide.disabled = currentSlideIndex === 0;
				if (btnNextSlide) btnNextSlide.disabled = currentSlideIndex === slides.length - 1;
			}

			function nextStep() {
				const slide = slides[currentSlideIndex];
				if (!slide) return;
				if (revealedBullets < slide.bullets.length) {
					revealedBullets += 1;
					syncBulletVisibility();
				} else if (currentSlideIndex < slides.length - 1) {
					currentSlideIndex += 1;
					revealedBullets = 0;
					renderSlideContent(true);
				}
			}

			function prevStep() {
				if (revealedBullets > 0) {
					revealedBullets -= 1;
					syncBulletVisibility();
				} else if (currentSlideIndex > 0) {
					currentSlideIndex -= 1;
					revealedBullets = slides[currentSlideIndex].bullets.length;
					renderSlideContent(true);
				}
			}

			function goToSlide(index, initialBullets = 0) {
				if (index < 0 || index >= slides.length) return;
				currentSlideIndex = index;
				revealedBullets = initialBullets;
				renderSlideContent(true);
			}

			function openPresentation(startIndex = 0) {
				isPresentationMode = true;
				currentSlideIndex = Math.max(0, Math.min(slides.length - 1, startIndex));
				revealedBullets = 0;
				document.body.classList.add('presentation-active');
				if (stageEl) {
					stageEl.classList.add('is-open');
					stageEl.setAttribute('aria-hidden', 'false');
				}
				if (btnOutlineView) {
					btnOutlineView.classList.remove('is-active');
					btnOutlineView.setAttribute('aria-selected', 'false');
				}
				if (btnPresentView) {
					btnPresentView.classList.add('is-active');
					btnPresentView.setAttribute('aria-selected', 'true');
				}
				if (document.activeElement instanceof HTMLElement) {
					document.activeElement.blur();
				}
				renderSlideContent(true);
				resetHudIdle();
			}

			function closePresentation() {
				isPresentationMode = false;
				document.body.classList.remove('presentation-active');
				if (stageEl) {
					stageEl.classList.remove('is-open');
					stageEl.setAttribute('aria-hidden', 'true');
				}
				if (btnOutlineView) {
					btnOutlineView.classList.add('is-active');
					btnOutlineView.setAttribute('aria-selected', 'true');
				}
				if (btnPresentView) {
					btnPresentView.classList.remove('is-active');
					btnPresentView.setAttribute('aria-selected', 'false');
				}
				if (document.fullscreenElement) {
					document.exitFullscreen().catch(() => {});
				}
				updateUrlState();
			}

			function toggleFullscreen() {
				if (!document.fullscreenElement) {
					document.documentElement.requestFullscreen().catch(() => {});
				} else {
					document.exitFullscreen().catch(() => {});
				}
			}

			document.addEventListener('fullscreenchange', () => {
				if (fullscreenLabel) {
					fullscreenLabel.textContent = document.fullscreenElement ? 'Exit Fullscreen' : 'Fullscreen';
				}
			});

			btnPresentView?.addEventListener('click', () => openPresentation(0));
			btnOutlineView?.addEventListener('click', () => closePresentation());
			btnExitPresent?.addEventListener('click', (e) => {
				e.stopPropagation();
				closePresentation();
			});
			btnToggleTheme?.addEventListener('click', (e) => {
				e.stopPropagation();
				toggleTheme();
			});
			btnToggleFullscreen?.addEventListener('click', (e) => {
				e.stopPropagation();
				toggleFullscreen();
			});

			btnNextStep?.addEventListener('click', (e) => {
				e.stopPropagation();
				nextStep();
			});
			btnPrevStep?.addEventListener('click', (e) => {
				e.stopPropagation();
				prevStep();
			});
			btnNextSlide?.addEventListener('click', (e) => {
				e.stopPropagation();
				goToSlide(currentSlideIndex + 1, 0);
			});
			btnPrevSlide?.addEventListener('click', (e) => {
				e.stopPropagation();
				goToSlide(currentSlideIndex - 1, 0);
			});

			stageEl?.addEventListener('click', (e) => {
				if (e.target instanceof Element && e.target.closest('.deck-top-hud, .deck-bottom-hud')) {
					return;
				}
				nextStep();
			});

			document.querySelectorAll('[data-start-slide]').forEach((btn) => {
				btn.addEventListener('click', () => {
					const idx = Number(btn.getAttribute('data-start-slide') || 0);
					openPresentation(idx);
				});
			});

			stageEl?.addEventListener('mousemove', resetHudIdle);

			document.addEventListener('keydown', (e) => {
				if (!isPresentationMode) return;

				if (e.code === 'Space' || e.key === ' ') {
					e.preventDefault();
					nextStep();
					return;
				}
				if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === 'Enter') {
					e.preventDefault();
					if (e.shiftKey && e.key === 'ArrowRight') {
						goToSlide(currentSlideIndex + 1, 0);
					} else {
						nextStep();
					}
					return;
				}
				if (e.key === 'ArrowLeft' || e.key === 'PageUp' || e.key === 'Backspace') {
					e.preventDefault();
					if (e.shiftKey && e.key === 'ArrowLeft') {
						goToSlide(currentSlideIndex - 1, 0);
					} else {
						prevStep();
					}
					return;
				}
				if (e.key === 'Escape') {
					if (!document.fullscreenElement) {
						closePresentation();
					}
					return;
				}
				if (e.key === 'f' || e.key === 'F') {
					e.preventDefault();
					toggleFullscreen();
					return;
				}
				if (e.key === 't' || e.key === 'T') {
					e.preventDefault();
					toggleTheme();
					return;
				}
			});

			const initialParams = new URLSearchParams(window.location.search);
			if (initialParams.get('view') === 'present') {
				const slideNum = parseInt(initialParams.get('slide') || '1', 10);
				const idx = Number.isNaN(slideNum) ? 0 : Math.max(0, Math.min(slides.length - 1, slideNum - 1));
				openPresentation(idx);
			}
		</script>
	</body>
</html>
