---
import Layout from '../layouts/BlogPost.astro';

const pubDate = new Date('2026-01-18');
---

<Layout
	title="Contact Us"
	description="Get in touch with the Decoding The Burn team."
	pubDate={pubDate}
>
	<div class="contact-page">
		<p>Have a question, a story to share, or just want to say hello? I'd love to hear from you.</p>
		
		<div style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1); padding: 2.5rem; border-radius: 20px; margin: 3rem 0;">
			<form action="mailto:decodingtheburn@gmail.com" method="post" enctype="text/plain" style="display: flex; flex-direction: column; gap: 1.5rem;">
				<div>
					<label style="display: block; margin-bottom: 0.5rem; color: var(--accent); font-weight: 600;">Name</label>
					<input type="text" name="name" required style="width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.2); color: white;" />
				</div>
				
				<div>
					<label style="display: block; margin-bottom: 0.5rem; color: var(--accent); font-weight: 600;">Email</label>
					<input type="email" name="email" required style="width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.2); color: white;" />
				</div>
				
				<div>
					<label style="display: block; margin-bottom: 0.5rem; color: var(--accent); font-weight: 600;">Message</label>
					<textarea name="message" rows="5" required style="width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.2); color: white;"></textarea>
				</div>
				
				<button type="submit" class="btn btn-primary" style="align-self: flex-start; padding: 1rem 2.5rem;">Send Message</button>
			</form>
		</div>

		<div style="text-align: center; color: var(--text-secondary); font-size: 0.9rem;">
			<p>Direct Email: <a href="mailto:decodingtheburn@gmail.com" style="color: var(--accent);">decodingtheburn@gmail.com</a></p>
		</div>
	</div>
</Layout>
