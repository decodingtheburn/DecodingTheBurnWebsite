---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import { Image } from 'astro:assets';
import authorPhoto from '../assets/denis-ethier.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="How Patients Can Use This Site | Decoding The Burn" 
			description="How BMS sufferers can use this site, explore my elimination methodology, and navigate daily recovery tools." 
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-centered-wrapper">
				<div class="hero-centered-header">
					<MedicalDisclaimer />
					<h1 class="hero-centered-title">
						How Patients Can Use This&nbsp;Site
					</h1>
				</div>

				<!-- Author Photo on Top -->
				<div class="hero-video-centered">
					<div class="video-placeholder-wrapper" style="cursor: default;">
						<Image 
							src={authorPhoto} 
							alt="Denis Ethier - BMS Patient Story" 
							class="video-placeholder-img" 
							width={1400} 
							height={788}
						/>
					</div>
				</div>

				<!-- My Story Section -->
				<article class="personal-story-section">
					<h2 class="story-heading">My Story</h2>
					<div class="story-lead">
						<p class="story-paragraph">
							In April 2023, I woke up with severe Burning Mouth Syndrome that escalated over three years into a daily 10/10 agony. Eating felt like chewing hot glass, and five dentists and five medical doctors all told me my mouth looked completely healthy.
						</p>
						<p class="story-paragraph">
							I refused to accept that. I started systematically testing and eliminating variables: acidic foods, coffee, fruit acids, subgingival tartar, and mechanical dentin exposure. Through rigorous tracking and an all-meat elimination baseline, I brought my burning down to a stable zero-pain baseline, and now I am sharing every step so you don't have to navigate this fire alone.
						</p>
					</div>

					<!-- Call to Action -->
					<div class="collab-cta-box">
						<h3 class="collab-cta-title">Ready to explore the complete journey?</h3>
						<p class="collab-cta-text">
							Read my full recovery case study detailing every trigger, the 72-hour latency cycle, and my daily maintenance protocol.
						</p>
						<div class="collab-cta-actions">
							<a href="/blog/how-i-reduced-my-bms-pain-from-10-to-0/" class="btn btn-primary">Read Complete Story</a>
							<a href="/share-your-story" class="btn btn-secondary">Share Your Story</a>
						</div>
					</div>
				</article>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero-centered-wrapper {
		max-width: 900px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem;
	}

	.hero-centered-header {
		text-align: center;
		margin: 0 auto 2.5rem;
	}

	.hero-centered-title {
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.03em;
		color: var(--text-primary);
		margin: 1.25rem 0 0;
		text-wrap: balance;
	}

	.hero-video-centered {
		width: 100%;
		margin: 0 auto 3rem;
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
		border: 1px solid var(--border-color, rgba(0, 0, 0, 0.08));
		background: #000000;
	}

	.video-placeholder-wrapper {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.video-placeholder-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.95;
	}

	.personal-story-section {
		background: var(--bg-card, #ffffff);
		border: 1px solid var(--border-color, #e2e8f0);
		border-radius: 24px;
		padding: 3rem 2.5rem;
		margin-bottom: 2rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
	}

	.story-heading {
		font-size: 1.85rem;
		font-weight: 800;
		color: var(--text-primary);
		margin-bottom: 1.5rem;
		text-align: center;
		text-wrap: balance;
	}

	.story-lead {
		max-width: 800px;
		margin: 0 auto 2.5rem;
	}

	.story-paragraph {
		font-size: 1.15rem;
		line-height: 1.75;
		color: var(--text-secondary);
		margin-bottom: 1.5rem;
	}

	.collab-cta-box {
		background: linear-gradient(135deg, #1e1136 0%, #0d081a 100%);
		border-radius: 18px;
		padding: 2.25rem 2rem;
		text-align: center;
		color: #ffffff;
		border: 1px solid rgba(168, 85, 247, 0.3);
	}

	.collab-cta-title {
		font-size: 1.35rem;
		font-weight: 800;
		color: #ffffff;
		margin-bottom: 0.75rem;
		text-wrap: balance;
	}

	.collab-cta-text {
		font-size: 1.05rem;
		line-height: 1.6;
		color: #e2e8f0;
		max-width: 620px;
		margin: 0 auto 1.5rem;
		text-wrap: balance;
	}

	.collab-cta-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.85rem 1.75rem;
		font-weight: 700;
		border-radius: 12px;
		text-decoration: none;
		transition: transform 0.15s ease, background 0.15s ease;
	}

	.btn-primary {
		background: linear-gradient(135deg, #c8382c 0%, #991b1b 100%);
		color: #ffffff;
	}

	.btn-primary:hover {
		transform: translateY(-2px);
		filter: brightness(1.1);
	}

	.btn-secondary {
		background: rgba(255, 255, 255, 0.15);
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.3);
	}

	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.25);
		transform: translateY(-2px);
	}

	@media (max-width: 640px) {
		.personal-story-section {
			padding: 2rem 1.5rem;
		}
	}
</style>
