---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import authorPhoto from '../assets/denis-ethier.png';
import { sortPostsDescending } from '../utils/postUtils';

const rawPosts = await getCollection('blog', ({ data }) => !data.draft);
// Show posts tagged 'patient' or 'both'
const patientPosts = sortPostsDescending(rawPosts).filter(post => {
	const tags = post.data.tags || [];
	return tags.includes('patient') || tags.includes('both');
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="For Patients | Decoding The Burn" 
			description="How BMS sufferers can use this site, explore my elimination methodology, and navigate daily recovery tools." 
		/>
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section Following Homepage Model -->
			<section class="hero-centered-wrapper">
				<div class="hero-centered-header">
					<MedicalDisclaimer />
					<h1 class="hero-centered-title">
						How Patients Can Use This&nbsp;Site
					</h1>
					<p class="hero-centered-subtitle">
						When you are in agonizing 10/10 pain and tests come back normal, you need practical answers.
						Here is how to use my lived journey and elimination methodology to guide your own&nbsp;recovery.
					</p>
				</div>

				<!-- Video on Top -->
				<div class="hero-video-centered">
					<div class="video-placeholder-wrapper" style="cursor: default;">
						<Image 
							src={authorPhoto} 
							alt="Denis Ethier - BMS Patient Orientation Video" 
							class="video-placeholder-img" 
							width={1400} 
							height={788}
						/>
					</div>
				</div>

				<!-- My Story Card Under Video -->
				<article class="personal-story-section">
					<h2 class="story-heading">My Story &amp; How This Site Can Help&nbsp;You</h2>
					<div class="story-lead">
						<p>
							In early 2025, I woke up with severe Burning Mouth Syndrome that quickly escalated to a daily 10/10 agony. Eating felt like chewing hot glass, and five dentists and five medical doctors all told me my mouth looked completely&nbsp;healthy.
						</p>
						<p>
							I refused to give up. I started systematically testing and eliminating variables: acidic foods, toothpaste abrasives, and night mouth-breathing. That method helped bring my burning down to sustained remission, and now I am sharing every step so you don't have to navigate this fire&nbsp;alone.
						</p>
						<p class="continue-reading-p">
							<a href="/blog/how-i-solved-my-burning-mouth-syndrome/" class="continue-reading-link">Read my complete recovery story &rarr;</a>
						</p>
					</div>
				</article>
			</section>

			<!-- 3 Core Ways Patients Can Use This Platform -->
			<section class="methodology-container">
				<h2 class="section-heading">How My Methodology Helps&nbsp;You</h2>
				<div class="methodology-grid">
					<div class="method-card">
						<div class="method-num">01</div>
						<h3 class="method-title">The Trigger Elimination&nbsp;Process</h3>
						<p class="method-text">
							Learn how to systematically test and remove acidic foods, abrasive foaming toothpastes (SLS), and night mouth-breathing so your oral tissues have time to rest and calm&nbsp;down.
						</p>
					</div>

					<div class="method-card">
						<div class="method-num">02</div>
						<h3 class="method-title">Prepare for Your Next Dental&nbsp;Visit</h3>
						<p class="method-text">
							Use our appointment recording guide and data request checklist so you can bring structured notes to your dentist, understand clinical terms, and ask the right&nbsp;questions.
						</p>
					</div>

					<div class="method-card">
						<div class="method-num">03</div>
						<h3 class="method-title">Learn from the Podcast&nbsp;Interviews</h3>
						<p class="method-text">
							Listen to in-depth, transparent conversations with leading dentists, periodontists, and fellow sufferers who share what is actually working in clinical&nbsp;practice.
						</p>
					</div>
				</div>
			</section>

			<!-- Relevant Articles for Patients -->
			<section class="section-header recent-posts-header">
				<h2 class="recent-posts-title">Patient Guides &amp; Practical Case&nbsp;Studies</h2>
				<p class="recent-posts-subtitle">Practical articles, elimination logs, and daily habits written specifically for&nbsp;sufferers.</p>
			</section>

			<div class="grid">
				{
					patientPosts.map((post, index) => {
						const postNumber = post.data.entryNumber ?? (index + 1);
						const imageSrc = typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage?.src;
						return (
							<article class="card">
								<a href={`/blog/${post.id}/`}>
									<div class="card-img" style={`background-image: url(${imageSrc || '/blog-placeholder-1.jpg'})`}></div>
									<div class="card-body">
										<div class="card-meta">
											<span class="meta-post-info"><strong class="meta-post-number">Post #{postNumber}</strong> • <FormattedDate date={post.data.pubDate} /></span>
										</div>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
										<span class="view-story">Read Guide &rarr;</span>
									</div>
								</a>
							</article>
						);
					})
				}
			</div>

			<div style="text-align: center; margin: 3rem 0;">
				<a href="/blog" class="btn btn-outline" style="padding: 0.85rem 2.25rem;">View All Blog Entries +</a>
			</div>
		</main>
		<Footer />

		<style>
			.methodology-container {
				max-width: 1080px;
				margin: 1.5rem auto 4.5rem;
				padding: 0 1.5rem;
			}

			.section-heading {
				font-size: clamp(1.75rem, 3.5vw, 2.25rem);
				font-weight: 800;
				color: #0f172a;
				text-align: center;
				margin: 0 0 2rem 0;
				letter-spacing: -0.02em;
			}

			.methodology-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 2rem;
			}

			.method-card {
				background: #ffffff;
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 2.25rem 2rem;
				box-shadow: 0 4px 16px -4px rgba(15, 23, 42, 0.04);
			}

			.method-num {
				font-size: 1.5rem;
				font-weight: 900;
				color: #c8382c;
				margin-bottom: 0.75rem;
			}

			.method-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 0.75rem 0;
			}

			.method-text {
				font-size: 1rem;
				line-height: 1.65;
				color: #475569;
				margin: 0;
				text-wrap: pretty;
			}
		</style>
	</body>
</html>
