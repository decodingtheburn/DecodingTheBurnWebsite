---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import { Image } from 'astro:assets';
import authorPhoto from '../assets/denis-ethier.png';
import CardinalNetworkDiagram from '../components/CardinalNetworkDiagram.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="My Mission: Bridging People and Data | Decoding The Burn" 
			description="Bridging the communication and diagnostic gap between Burning Mouth Syndrome sufferers, dentists, physicians, and clinical researchers through shared data." 
		/>
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section Following Homepage Model -->
			<section class="hero-centered-wrapper">
				<div class="hero-centered-header">
					<MedicalDisclaimer />
					<h1 class="hero-centered-title">
						My Mission: Bridging People &amp;&nbsp;Data
					</h1>
					<p class="hero-centered-subtitle">
						Let's unite sufferers, dentists, doctors, and researchers around open research data.
						Connecting all four types is the key to accelerating discoveries and finding lasting&nbsp;relief.
					</p>
				</div>

				<!-- Video on Top -->
				<div class="hero-video-centered">
					<div class="video-placeholder-wrapper" style="cursor: default;">
						<Image 
							src={authorPhoto} 
							alt="Denis Ethier - Our Mission and Bridge" 
							class="video-placeholder-img" 
							width={1400} 
							height={788} 
						/>
					</div>
				</div>

				<!-- Story Card Under Video -->
				<article class="personal-story-section">
					<h2 class="story-heading">My Story &amp; Why We Need the Human&nbsp;Glue</h2>
					<div class="story-lead">
						<p>
							After consulting five dentists and five medical doctors with severe 10/10 oral pain, I witnessed firsthand the communication chasm in modern medicine. When you are in agony, you need urgency. But busy clinicians with 15-minute appointment slots must maintain detachment, often writing 'idiopathic discomfort with anxiety' in charts when you feel like your mouth is on&nbsp;fire.
						</p>
						<p>
							I realized that doctors aren't malicious, they simply lack the tools and time to capture dense time-series data. The mission of Decoding The Burn is to serve as the human glue: translating lived patient observations into objective clinical terms so patients and clinicians can solve this mystery&nbsp;together.
						</p>
						<p class="continue-reading-p">
							<a href="/podcast" class="continue-reading-link">Listen to the latest podcast discussions &rarr;</a>
						</p>
					</div>
				</article>
			</section>

			<div class="mission-content-container">
				<!-- Cardinal Diagram: Bridging People and Data -->
				<section class="mission-section">
					<h2 class="bridging-heading">Bridging People &amp;&nbsp;Data</h2>
					<p class="bridging-subtitle">
						Real discoveries happen when patient observations, dental mechanics, medical diagnostics, and laboratory science connect around open research&nbsp;data.
					</p>

					<CardinalNetworkDiagram />
				</section>

				<!-- CTA Box -->
				<section class="mission-cta-box">
					<h2 class="cta-title">Be Part of the Solution</h2>
					<p class="cta-subtitle">
						Whether you are enduring BMS, practicing dentistry, or researching neuropathic pain, your voice and data can help solve this puzzle for&nbsp;millions.
					</p>
					<div class="cta-actions">
						<a href="/podcast#apply" class="btn btn-primary cta-btn">Apply to Be a Guest &rarr;</a>
						<a href="/blog/how-i-reduced-my-bms-pain-from-10-to-0/" class="btn btn-outline cta-btn">Read Post #1: My Journey</a>
					</div>
				</section>
			</div>
		</main>
		<Footer />

		<style>
			.mission-content-container {
				max-width: 1080px;
				margin: 1rem auto 5rem;
				padding: 0 1.5rem;
			}

			.bridging-heading {
				font-size: clamp(2.5rem, 5.5vw, 3.85rem);
				font-weight: 900;
				color: #0f172a;
				line-height: 1.08;
				letter-spacing: -0.03em;
				margin: 0 auto 1.25rem auto;
				text-align: center;
				text-wrap: balance;
				max-width: 900px;
			}

			.bridging-subtitle {
				font-size: clamp(1.1rem, 2vw, 1.25rem);
				line-height: 1.6;
				color: #475569;
				max-width: 760px;
				margin: 0 auto 2.5rem auto;
				text-align: center;
				text-wrap: balance;
			}

			.story-heading {
				font-size: clamp(1.75rem, 3.5vw, 2.25rem);
				font-weight: 800;
				line-height: 1.2;
				color: #000000;
				letter-spacing: -0.02em;
				margin: 0 0 1.25rem 0;
				text-wrap: balance;
			}

			.section-title {
				font-size: clamp(1.75rem, 3.5vw, 2.25rem);
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 1.25rem 0;
				letter-spacing: -0.02em;
			}

			.section-lead {
				font-size: 1.1rem;
				line-height: 1.7;
				color: #334155;
				margin-bottom: 1.75rem;
				text-wrap: pretty;
			}

			.text-center {
				text-align: center;
			}

			/* Cardinal Network Diagram Styling */
			.cardinal-network-wrapper {
				background: #ffffff;
				border: 1px solid var(--card-border);
				border-radius: 24px;
				padding: 3rem 2rem;
				margin-top: 2rem;
				box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.05);
			}

			.cardinal-grid {
				display: grid;
				grid-template-columns: minmax(240px, 260px) minmax(270px, 290px) minmax(240px, 260px);
				grid-template-rows: auto auto auto;
				align-items: center;
				justify-content: center;
				gap: 1.25rem;
				margin: 0 auto;
			}

			.node-north {
				grid-column: 2;
				grid-row: 1;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.5rem;
			}

			.node-west {
				grid-column: 1;
				grid-row: 2;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: flex-end;
				gap: 0.5rem;
			}

			.node-center {
				grid-column: 2;
				grid-row: 2;
				display: flex;
				justify-content: center;
				align-items: center;
			}

			.node-east {
				grid-column: 3;
				grid-row: 2;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: flex-start;
				gap: 0.5rem;
			}

			.node-south {
				grid-column: 2;
				grid-row: 3;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.5rem;
			}

			.cardinal-card {
				width: 100%;
				max-width: 250px;
				border-radius: 20px;
				padding: 1.4rem 1.25rem;
				text-align: center;
				box-shadow: 0 4px 14px -2px rgba(15, 23, 42, 0.06);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.cardinal-card:hover {
				transform: translateY(-3px);
				box-shadow: 0 10px 22px -3px rgba(15, 23, 42, 0.1);
			}

			/* Patients: Warm Rose/Crimson theme */
			.card-patient {
				background: linear-gradient(180deg, #fff1f2 0%, #ffe4e6 100%);
				border: 2px solid #fda4af;
			}
			.card-patient .cardinal-title {
				color: #9f1239;
			}
			.card-patient .card-item-list li {
				color: #881337;
			}

			/* Doctors: Crisp Royal Slate-Blue theme */
			.card-doctor {
				background: linear-gradient(180deg, #eff6ff 0%, #dbeafe 100%);
				border: 2px solid #93c5fd;
			}
			.card-doctor .cardinal-title {
				color: #1e40af;
			}
			.card-doctor .card-item-list li {
				color: #1e3a8a;
			}

			/* Dentists: Dark Medium Green / Mint Forest theme */
			.card-dentist {
				background: linear-gradient(180deg, #ecfdf5 0%, #d1fae5 100%);
				border: 2px solid #6ee7b7;
			}
			.card-dentist .cardinal-title {
				color: #065f46;
			}
			.card-dentist .card-item-list li {
				color: #064e3b;
			}

			/* Researchers: Rich Indigo / Purple theme */
			.card-researcher {
				background: linear-gradient(180deg, #f5f3ff 0%, #ede9fe 100%);
				border: 2px solid #c4b5fd;
			}
			.card-researcher .cardinal-title {
				color: #5b21b6;
			}
			.card-researcher .card-item-list li {
				color: #4c1d95;
			}

			.cardinal-icon {
				font-size: 3.25rem;
				line-height: 1;
				margin-bottom: 0.5rem;
				display: block;
			}

			.cardinal-title {
				font-size: 1.75rem;
				font-weight: 800;
				margin: 0 0 0.35rem 0;
				line-height: 1.15;
			}

			.card-item-list {
				list-style-type: disc;
				padding-left: 1.15rem;
				margin: 0.5rem auto 0 auto;
				display: inline-block;
				text-align: left;
			}

			.card-item-list li {
				font-size: 0.85rem;
				font-weight: 600;
				line-height: 1.45;
				margin-bottom: 0.15rem;
			}

			.connector-arrow {
				display: flex;
				align-items: center;
				justify-content: center;
			}

			/* Center Data Circle: Elegant Crisp White Card with Multi-tone Border & Glow */
			.center-data-circle {
				width: 275px;
				height: 275px;
				border-radius: 50%;
				background: #ffffff;
				color: #0f172a;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: 1.5rem 1.25rem;
				border: 3px solid #6366f1;
				box-shadow: 0 12px 35px -5px rgba(99, 102, 241, 0.18), 0 0 0 6px rgba(238, 242, 255, 0.9);
				text-align: center;
			}

			.center-icon {
				font-size: 2.5rem;
				line-height: 1;
				display: block;
				margin-bottom: 0.2rem;
			}

			.center-mission-title {
				font-size: 1.6rem;
				font-weight: 900;
				color: #1e1b4b;
				margin: 0;
				line-height: 1.15;
				letter-spacing: -0.02em;
				text-transform: uppercase;
			}

			.center-breakthroughs-subtitle {
				font-size: 1.15rem;
				font-weight: 800;
				color: #4f46e5;
				margin-top: 0.15rem;
				line-height: 1.25;
				display: block;
			}

			.center-data-list {
				list-style-type: disc;
				padding-left: 1.15rem;
				margin: 0.55rem auto 0 auto;
				display: inline-block;
				text-align: left;
			}

			.center-data-list li {
				font-size: 0.82rem;
				font-weight: 600;
				color: #334155;
				line-height: 1.45;
				margin-bottom: 0.15rem;
			}

			/* CTA Box */
			.mission-cta-box {
				background: #fdfbf7;
				border: 1px solid var(--card-border);
				border-radius: 24px;
				padding: 3.5rem 2.5rem;
				text-align: center;
				margin-bottom: 5rem;
			}

			.cta-title {
				font-size: clamp(1.8rem, 3.5vw, 2.3rem);
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 1rem 0;
			}

			.cta-subtitle {
				font-size: 1.15rem;
				line-height: 1.65;
				color: #475569;
				max-width: 650px;
				margin: 0 auto 2rem auto;
				text-wrap: balance;
			}

			.cta-actions {
				display: flex;
				justify-content: center;
				gap: 1.25rem;
				flex-wrap: wrap;
			}

			.cta-btn {
				padding: 0.95rem 2.25rem;
				font-size: 1.05rem;
			}

			/* Responsive Adjustments */
			@media (max-width: 940px) {
				.cardinal-grid {
					display: flex;
					flex-direction: column;
					align-items: center;
					gap: 1.25rem;
				}

				.node-north, .node-west, .node-center, .node-east, .node-south {
					width: 100%;
					max-width: 320px;
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
				}

				.arrow-horizontal {
					transform: rotate(90deg);
					margin: 0.5rem 0;
				}

				.cardinal-card {
					width: 100%;
					max-width: 320px;
				}
			}
		</style>
	</body>
</html>
