---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import { Image } from 'astro:assets';
import authorPhoto from '../assets/denis-ethier.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Our Mission: Bridging People and Data | Decoding The Burn" 
			description="Bridging the communication and diagnostic gap between Burning Mouth Syndrome sufferers, dentists, physicians, and clinical researchers through shared data." 
		/>
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section Following Homepage Model -->
			<section class="hero-centered-wrapper">
				<div class="hero-centered-header">
					<MedicalDisclaimer />
					<h1 class="hero-centered-title">
						Our Mission: Bridging People &amp;&nbsp;Data
					</h1>
					<p class="hero-centered-subtitle">
						We connect lived patient observations with dental, medical, and laboratory research data.
						Here is why uniting sufferers, clinicians, and scientists around open data is the key to lasting&nbsp;relief.
					</p>
				</div>

				<!-- Video on Top -->
				<div class="hero-video-centered">
					<div class="video-placeholder-wrapper" style="cursor: default;">
						<Image 
							src={authorPhoto} 
							alt="Denis Ethier - Our Mission and Bridge" 
							class="video-placeholder-img" 
							width={1400} 
							height={788}
						/>
					</div>
				</div>

				<!-- Story Card Under Video -->
				<article class="personal-story-section">
					<h2 class="story-heading">My Story &amp; Why We Need the Human&nbsp;Glue</h2>
					<div class="story-lead">
						<p>
							After consulting five dentists and five medical doctors with severe 10/10 oral pain, I witnessed firsthand the communication chasm in modern medicine. When you are in agony, you need urgency. But busy clinicians with 15-minute appointment slots must maintain detachment, often writing 'idiopathic discomfort with anxiety' in charts when you feel like your mouth is on&nbsp;fire.
						</p>
						<p>
							I realized that doctors aren't malicious, they simply lack the tools and time to capture dense time-series data. The mission of Decoding The Burn is to serve as the human glue: translating lived patient observations into objective clinical terms so patients and clinicians can solve this mystery&nbsp;together.
						</p>
						<p class="continue-reading-p">
							<a href="/podcast" class="continue-reading-link">Listen to the latest podcast discussions &rarr;</a>
						</p>
					</div>
				</article>
			</section>

			<div class="mission-content-container">
				<!-- Cardinal Diagram: Bridging People and Data -->
				<section class="mission-section">
					<h2 class="section-title text-center">Bridging People &amp;&nbsp;Data</h2>
					<p class="section-lead text-center">
						Real discoveries happen when patient observations, dental mechanics, medical diagnostics, and laboratory science connect around open research&nbsp;data.
					</p>

					<div class="cardinal-network-wrapper">
						<!-- Cardinal Grid Layout: North (Patients), West (Doctors), East (Dentists), South (Researchers), Center (Shared Data) -->
						<div class="cardinal-grid">
							<!-- North: Patients -->
							<div class="cardinal-node node-north">
								<div class="cardinal-card card-patient">
									<span class="cardinal-icon" aria-hidden="true">🗣️</span>
									<h3 class="cardinal-title">Patients</h3>
									<ul class="card-item-list">
										<li>Type 1</li>
										<li>Type 2</li>
										<li>Type 3</li>
									</ul>
								</div>
								<div class="connector-arrow arrow-vertical" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#be123c" stroke-width="2.5">
										<path d="M12 3v18M5 10l7-7 7 7M5 14l7 7 7-7"/>
									</svg>
								</div>
							</div>

							<!-- West: Doctors -->
							<div class="cardinal-node node-west">
								<div class="cardinal-card card-doctor">
									<span class="cardinal-icon" aria-hidden="true">🩺</span>
									<h3 class="cardinal-title">Doctors</h3>
									<ul class="card-item-list">
										<li>GPs</li>
										<li>Neurologists</li>
										<li>Gastroenterologists</li>
										<li>Allergists</li>
										<li>ENTs</li>
									</ul>
								</div>
								<div class="connector-arrow arrow-horizontal arrow-west-center" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#1d4ed8" stroke-width="2.5">
										<path d="M3 12h18M10 5l-7 7 7 7M14 5l7 7-7 7"/>
									</svg>
								</div>
							</div>

							<!-- Center: Shared BMS Data Hub -->
							<div class="cardinal-node node-center">
								<div class="center-data-circle">
									<span class="center-icon" aria-hidden="true">📊</span>
									<h3 class="center-title">Shared BMS&nbsp;Data</h3>
								</div>
							</div>

							<!-- East: Dentists -->
							<div class="cardinal-node node-east">
								<div class="connector-arrow arrow-horizontal arrow-east-center" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#059669" stroke-width="2.5">
										<path d="M3 12h18M10 5l-7 7 7 7M14 5l7 7-7 7"/>
									</svg>
								</div>
								<div class="cardinal-card card-dentist">
									<span class="cardinal-icon" aria-hidden="true">🦷</span>
									<h3 class="cardinal-title">Dentists</h3>
									<ul class="card-item-list">
										<li>Periodontists</li>
										<li>Endodontists</li>
										<li>Prosthodontists</li>
										<li>Oral Surgeons</li>
										<li>Oral Medicine</li>
									</ul>
								</div>
							</div>

							<!-- South: Researchers -->
							<div class="cardinal-node node-south">
								<div class="connector-arrow arrow-vertical" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#7c3aed" stroke-width="2.5">
										<path d="M12 3v18M5 10l7-7 7 7M5 14l7 7 7-7"/>
									</svg>
								</div>
								<div class="cardinal-card card-researcher">
									<span class="cardinal-icon" aria-hidden="true">🔬</span>
									<h3 class="cardinal-title">Researchers</h3>
									<ul class="card-item-list">
										<li>Neuroscience</li>
										<li>Oral Biology</li>
										<li>Microbiology</li>
										<li>Biomechanical Physics</li>
									</ul>
								</div>
							</div>
						</div>
					</div>
				</section>

				<!-- CTA Box -->
				<section class="mission-cta-box">
					<h2 class="cta-title">Be Part of the Solution</h2>
					<p class="cta-subtitle">
						Whether you are enduring BMS, practicing dentistry, or researching neuropathic pain, your voice and data can help solve this puzzle for&nbsp;millions.
					</p>
					<div class="cta-actions">
						<a href="/podcast#apply" class="btn btn-primary cta-btn">Apply to Be a Guest &rarr;</a>
						<a href="/blog/how-i-solved-my-burning-mouth-syndrome/" class="btn btn-outline cta-btn">Read Post #1: My Journey</a>
					</div>
				</section>
			</div>
		</main>
		<Footer />

		<style>
			.mission-content-container {
				max-width: 1080px;
				margin: 1rem auto 5rem;
				padding: 0 1.5rem;
			}

			.mission-section {
				margin-bottom: 4.5rem;
			}

			.section-title {
				font-size: clamp(1.75rem, 3.5vw, 2.25rem);
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 1.25rem 0;
				letter-spacing: -0.02em;
			}

			.section-lead {
				font-size: 1.1rem;
				line-height: 1.7;
				color: #334155;
				margin-bottom: 1.75rem;
				text-wrap: pretty;
			}

			.text-center {
				text-align: center;
			}

			/* Cardinal Network Diagram Styling */
			.cardinal-network-wrapper {
				background: #ffffff;
				border: 1px solid var(--card-border);
				border-radius: 24px;
				padding: 3rem 2rem;
				margin-top: 2rem;
				box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.05);
			}

			.cardinal-grid {
				display: grid;
				grid-template-columns: minmax(240px, 270px) minmax(240px, 280px) minmax(240px, 270px);
				grid-template-rows: auto auto auto;
				align-items: center;
				justify-content: center;
				gap: 1.25rem;
				margin: 0 auto;
			}

			.node-north {
				grid-column: 2;
				grid-row: 1;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.5rem;
			}

			.node-west {
				grid-column: 1;
				grid-row: 2;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: flex-end;
				gap: 0.5rem;
			}

			.node-center {
				grid-column: 2;
				grid-row: 2;
				display: flex;
				justify-content: center;
				align-items: center;
			}

			.node-east {
				grid-column: 3;
				grid-row: 2;
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: flex-start;
				gap: 0.5rem;
			}

			.node-south {
				grid-column: 2;
				grid-row: 3;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.5rem;
			}

			.cardinal-card {
				width: 100%;
				max-width: 250px;
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 18px;
				padding: 1.35rem 1.25rem;
				text-align: center;
				box-shadow: 0 2px 8px -2px rgba(15, 23, 42, 0.05);
				transition: transform 0.2s ease, border-color 0.2s ease;
			}

			.cardinal-card:hover {
				transform: translateY(-2px);
				border-color: #cbd5e1;
			}

			.card-patient {
				border-top: 3px solid #be123c;
			}

			.card-doctor {
				border-top: 3px solid #1d4ed8;
			}

			.card-dentist {
				border-top: 3px solid #059669;
			}

			.card-researcher {
				border-top: 3px solid #7c3aed;
			}

			.cardinal-icon {
				font-size: 3.25rem;
				line-height: 1;
				margin-bottom: 0.6rem;
				display: block;
			}

			.cardinal-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 0.35rem 0;
				line-height: 1.2;
			}

			.card-item-list {
				list-style: none;
				padding: 0;
				margin: 0.5rem 0 0 0;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}

			.card-item-list li {
				font-size: 0.92rem;
				font-weight: 600;
				color: #334155;
				line-height: 1.35;
			}

			.connector-arrow {
				display: flex;
				align-items: center;
				justify-content: center;
			}

			/* Center Data Circle */
			.center-data-circle {
				width: 210px;
				height: 210px;
				border-radius: 50%;
				background: #0f172a;
				color: #ffffff;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: 1.25rem;
				border: 3px solid #3b82f6;
				box-shadow: 0 10px 30px rgba(15, 23, 42, 0.22);
				text-align: center;
			}

			.center-icon {
				font-size: 3rem;
				line-height: 1;
				display: block;
				margin-bottom: 0.4rem;
			}

			.center-title {
				font-size: 1.2rem;
				font-weight: 800;
				color: #ffffff;
				margin: 0;
				line-height: 1.25;
			}

			/* CTA Box */
			.mission-cta-box {
				background: #fdfbf7;
				border: 1px solid var(--card-border);
				border-radius: 24px;
				padding: 3.5rem 2.5rem;
				text-align: center;
				margin-bottom: 5rem;
			}

			.cta-title {
				font-size: clamp(1.8rem, 3.5vw, 2.3rem);
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 1rem 0;
			}

			.cta-subtitle {
				font-size: 1.15rem;
				line-height: 1.65;
				color: #475569;
				max-width: 650px;
				margin: 0 auto 2rem auto;
				text-wrap: balance;
			}

			.cta-actions {
				display: flex;
				justify-content: center;
				gap: 1.25rem;
				flex-wrap: wrap;
			}

			.cta-btn {
				padding: 0.95rem 2.25rem;
				font-size: 1.05rem;
			}

			/* Responsive Adjustments */
			@media (max-width: 940px) {
				.cardinal-grid {
					display: flex;
					flex-direction: column;
					align-items: center;
					gap: 1.25rem;
				}

				.node-north, .node-west, .node-center, .node-east, .node-south {
					width: 100%;
					max-width: 320px;
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
				}

				.arrow-horizontal {
					transform: rotate(90deg);
					margin: 0.5rem 0;
				}

				.cardinal-card {
					width: 100%;
					max-width: 320px;
				}
			}
		</style>
	</body>
</html>
