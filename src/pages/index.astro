---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import authorPhoto from '../assets/denis-ethier.png';

const posts = (await getCollection('blog', ({ data }) => {
	return import.meta.env.DEV || !data.draft;
})).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<!-- Top Medical Disclaimer Bar -->
		<div class="top-disclaimer-bar">
			<strong>Medical Disclaimer:</strong> I am sharing my personal lived experiences, self-experiments, and what worked for my own body. I am a patient, not a doctor. Always consult your physician or specialist before trying any new health&nbsp;protocol.
		</div>

		<Header />
		<main>
			<!-- Hero Section (Centered) -->
			<section class="hero-centered-wrapper">
				<div class="hero-centered-header">
					<h1 class="hero-centered-title">How I stopped my BMS</h1>
					<p class="hero-centered-subtitle">When my mouth started burning, doctors told me everything looked completely normal. I refused to accept that. I treated my body like a system, tracked every variable, and found the protocol that brought me lasting&nbsp;relief.</p>
				</div>

				<div class="hero-video-centered">
					<div class="video-responsive-wrapper">
						<iframe 
							src="https://www.youtube-nocookie.com/embed/BM8qUgA8yPE?rel=0" 
							title="How I stopped my BMS"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
							allowfullscreen
						></iframe>
					</div>
				</div>

				<!-- My Story Section Under Video -->
				<article class="personal-story-section">
					<h2 class="story-heading">My story</h2>
					<div class="story-lead">
						<p>
							<strong>In a nutshell:</strong> I went from an agonizing 8/10 daily oral burning down to sustained remission by treating my condition as a systems engineering problem. By halting nighttime mouth breathing with gentle tape, cutting inflammatory dietary triggers with a carnivore protocol, and restoring mucosal barrier hydration, I ended my symptoms in 30&nbsp;days. It all began in early 2025 when I woke up to a scalded sensation like a boiling spoon pressed against my tongue, followed by months of normal medical tests and doctors repeatedly telling me nothing was&nbsp;wrong.
						</p>
					</div>

					<div class="story-action-row">
						<a href="/about" class="btn-pink">Read more &rarr;</a>
						<div class="story-author-tag">
							<Image src={authorPhoto} alt="Denis Ethier" class="story-author-avatar" width={108} height={108} />
							<div class="story-author-info">
								<h4>Denis Ethier</h4>
								<p>Software designer, builder &amp; founder of Decoding The&nbsp;Burn</p>
							</div>
						</div>
					</div>
				</article>

				<!-- Email Capture CTA -->
				<div class="hero-cta-capture">
					<div class="cta-capture-box">
						<h2>Stay Updated on my progress</h2>
						<p>I document every self-experiment, clinical paper, and daily habit that keeps my BMS in remission. Drop your email below to follow&nbsp;along.</p>
						
						<!-- MailerLite Form Embed -->
						<div class="ml-embedded" data-form="0R4iAA"></div>

						<!-- Quick Email Capture Form -->
						<form class="email-capture-form" action="/join" method="get">
							<input 
								type="email" 
								name="email" 
								placeholder="Enter your email address..." 
								required 
								aria-label="Email address"
							/>
							<button type="submit" class="btn btn-primary">Follow My Journey</button>
						</form>
						<span class="privacy-note">🔒 No spam. Just honest&nbsp;notes.</span>
					</div>
				</div>
			</section>

			<!-- Recent Insights -->
			<section class="section-header" style="justify-content: center; text-align: center; flex-direction: column; align-items: center; margin: 5rem auto 2.5rem;">
				<h2 style="font-size: 2.75rem; font-weight: 800; color: #000000; letter-spacing: -1px; text-align: center; margin-bottom: 0.75rem;">Recent Posts</h2>
				<p style="max-width: 720px; margin: 0 auto; color: #000000; font-size: 1.15rem; line-height: 1.6; text-align: center; text-wrap: balance;">Here is what I've written about, the experiments I've conducted, and what I've discovered along the&nbsp;way.</p>
			</section>

			<div class="grid">
				{
					posts.slice(0, 3).map((post, index) => {
						// Entry #1 is the newest post on Monday
						const postNumber = index + 1;
						const category = post.data.category || (post.data.title.toLowerCase().includes('research') || post.data.title.toLowerCase().includes('carnivore') ? 'Research' : 'My Experience');
						return (
						<article class="card">
							<a href={`/blog/${post.id}/`}>
								<div class="card-img" style={`background-image: url(${typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage.src})`}></div>
								<div class="card-body">
									<div class="card-meta">
										<span class="meta-tag">{category}</span>
										<span class="meta-date">Entry #{postNumber} • <FormattedDate date={post.data.pubDate} /></span>
									</div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<span class="view-story">Read More →</span>
								</div>
							</a>
						</article>
					)})
				}
			</div>

			<div style="text-align: center; margin: 4rem 0;">
				<a href="/blog" class="btn btn-outline" style="padding: 0.85rem 2.25rem;">View All Entries +</a>
			</div>

			<!-- Newsletter Callout -->
			<section class="newsletter-section">
				<h2>You Don't Need To Navigate BMS&nbsp;Alone</h2>
				<p>Let's use the collective wisdom to solve BMS for more&nbsp;people.</p>
				<a href="/join" class="btn btn-primary" style="padding: 1rem 2.75rem; font-size: 1.05rem;">Participate With&nbsp;Me →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
