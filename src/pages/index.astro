---
import { getEntry, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';

// Flagship article rendered directly as the homepage
const post = await getEntry('blog', '1-my-bms-18-months-carnivore-experiment');
if (!post) {
	throw new Error('Flagship post 1-my-bms-18-months-carnivore-experiment not found');
}

const { Content, headings } = await render(post);
---

<BlogPost 
	{...post.data} 
	headings={headings} 
	slug={post.id} 
	isHomepage={true}
>
	<Content />
</BlogPost>
