---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog', ({ data }) => {
	return import.meta.env.DEV || !data.draft;
})).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section (Centered) -->
			<section class="hero-centered-wrapper">
				<div class="hero-centered-header">
					<span class="tag">My Journey & Recovery Protocol</span>
					<h1 class="hero-centered-title">How I stopped my BMS</h1>
					<p class="hero-centered-subtitle">When my mouth started burning, doctors told me everything looked completely normal. I refused to accept that. I treated my body like a system, tracked every variable, and found the protocol that finally brought me lasting relief.</p>
				</div>

				<div class="hero-video-centered">
					<div class="video-responsive-wrapper">
						<iframe 
							src="https://www.youtube-nocookie.com/embed/BM8qUgA8yPE?rel=0" 
							title="How I stopped my BMS"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
							allowfullscreen
						></iframe>
					</div>
					<p class="hero-video-disclaimer">
						<strong>Disclaimer:</strong> I am sharing my personal lived experiences, self-experiments, and what worked for my own body. I am a patient, not a doctor. Always consult your physician or specialist before trying any new health protocol.
					</p>
				</div>

				<!-- Email Capture CTA -->
				<div class="hero-cta-capture">
					<div class="cta-capture-box">
						<div class="cta-badge">📬 My Real-Time Recovery Log</div>
						<h2>Stay Updated on my progress</h2>
						<p>I document every self-experiment I conduct, new research papers I dissect, and the daily habits that keep my BMS in remission. Drop your email to follow along.</p>
						
						<!-- MailerLite Form Embed -->
						<div class="ml-embedded" data-form="0R4iAA"></div>

						<!-- Quick Email Capture Form -->
						<form class="email-capture-form" action="/join" method="get">
							<input 
								type="email" 
								name="email" 
								placeholder="Enter your email address..." 
								required 
								aria-label="Email address"
							/>
							<button type="submit" class="btn btn-primary">Follow My Journey</button>
						</form>
						<span class="privacy-note">🔒 No spam. Just honest notes from my ongoing recovery. Unsubscribe anytime.</span>
					</div>
				</div>
			</section>

			<!-- Recent Insights -->
			<section class="section-header">
				<div>
					<span class="tag">From My Journal</span>
					<h2>Recent Posts & Findings</h2>
				</div>
				<p style="max-width: 440px; color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6;">My personal notes on mouth taping, clinical research breakthroughs, diet shifts, and what I've learned living with and overcoming BMS.</p>
			</section>

			<div class="grid">
				{
					posts.slice(0, 3).map((post, index) => {
						// Calculate post number (newest is #Total, oldest is #1)
						const postNumber = posts.length - index;
						return (
						<article class="card">
							<a href={`/blog/${post.id}/`}>
								<div class="card-img" style={`background-image: url(${typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage.src})`}></div>
								<div class="card-body">
									<div class="card-meta">
										<span class="meta-tag">Research Log</span>
										<span class="meta-date">Entry #{postNumber} • <FormattedDate date={post.data.pubDate} /></span>
									</div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<span class="view-story">Read My Notes →</span>
								</div>
							</a>
						</article>
					)})
				}
			</div>

			<div style="text-align: center; margin: 4rem 0;">
				<a href="/blog" class="btn btn-outline" style="padding: 0.85rem 2.25rem;">View All Entries +</a>
			</div>

			<!-- Newsletter Callout -->
			<section class="newsletter-section">
				<h2>You don't have to navigate BMS alone.</h2>
				<p>When my burning pain was at its peak, the loneliness was just as overwhelming as the physical discomfort. I created this space so we can connect, share what actually brings relief, and stop suffering in silence.</p>
				<a href="/join" class="btn btn-primary" style="padding: 1rem 2.75rem; font-size: 1.05rem;">Participate With Me →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
