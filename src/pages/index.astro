---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog', ({ data }) => {
	return import.meta.env.DEV || !data.draft;
})).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<section class="hero-wrapper">
				<div class="hero-content">
					<span class="tag">A Patient's Experiment</span>
					<h1>Using AI to ease BMS.</h1>
					<p>I’m exploring how modern AI can help us find patterns, relief, and research we might have missed—all from a patient’s perspective.</p>
					<div class="hero-cta">
						<a href="/blog/mouth-taping-bms" class="btn btn-primary">See my latest post →</a>
					</div>
				</div>
				<div class="hero-video">
					<div class="video-placeholder">
						<div class="play-button">
							<svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
								<path d="M8 5v14l11-7z"/>
							</svg>
						</div>
						<span class="coming-soon">Coming Soon</span>
					</div>
					<div style="margin-top: 1rem;">
						<p style="font-size: 0.75rem; color: #666; font-style: italic; line-height: 1.4;"><strong>Disclaimer:</strong> This content shares personal experiences and research for information only. I am a patient, not a doctor. Always consult your medical professional before trying new treatments.</p>
					</div>
				</div>
			</section>

			<!-- Recent Insights -->
			<section class="section-header">
				<div>
					<span class="tag">The Blog</span>
					<h2>Recent Posts</h2>
				</div>
				<p style="max-width: 400px; color: var(--text-secondary); font-size: 0.9rem;">Tips, treatments, and everything from scientific breakthroughs to mental health and diet in managing BMS pain.</p>
			</section>

			<div class="grid">
				{
					posts.slice(0, 3).map((post, index) => {
						// Calculate post number (newest is #Total, oldest is #1)
						const postNumber = posts.length - index;
						return (
						<article class="card">
							<a href={`/blog/${post.id}/`}>
								<div class="card-img" style={`background-image: url(${typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage.src})`}></div>
								<div class="card-body">
									<div class="card-meta">
										<span class="meta-tag">Research</span>
										<span class="meta-date">Post #{postNumber} • <FormattedDate date={post.data.pubDate} /></span>
									</div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<span class="view-story">View Story →</span>
								</div>
							</a>
						</article>
					)})
				}
			</div>

			<div style="text-align: center; margin: 4rem 0;">
				<a href="/blog" class="btn btn-outline">View Archive +</a>
			</div>



			<!-- Newsletter Callout -->
			<section class="newsletter-section" style="text-align: center;">
				<h2>You don't have to face BMS alone.</h2>
				<p style="margin-bottom: 2.5rem;">Join our newsletter to receive weekly research summaries, management tips, and invitations to our monthly community support calls.</p>
				<a href="/join" class="btn btn-primary" style="padding: 1.2rem 3rem; font-size: 1.1rem;">Join the Community →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
