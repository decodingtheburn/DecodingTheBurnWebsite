---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import authorPhoto from '../assets/denis-ethier.png';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';

const posts = (await getCollection('blog', ({ data }) => {
	return !data.draft;
})).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Dynamic calculation of remission duration based on June 2025 (last severe burning)
const remissionStartYear = 2025;
const remissionStartMonth = 5; // June (0-indexed)
const currentDate = new Date();
const monthsInRemission = (currentDate.getFullYear() - remissionStartYear) * 12 + (currentDate.getMonth() - remissionStartMonth) + 1;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section (Centered) -->
			<section class="hero-centered-wrapper">
				<div class="hero-centered-header">
					<MedicalDisclaimer />
					<h1 class="hero-centered-title">
						<span class="title-top">
							How Removing All 
							<span class="hw-underline-wrapper"><span class="hw-word">Acid</span><svg class="hw-underline-svg" viewBox="0 0 100 16" preserveAspectRatio="none" aria-hidden="true"><path d="M 2,12 Q 50,2 98,9" fill="none" stroke="#0ea5e9" stroke-width="4.5" stroke-linecap="round"/></svg></span> 
							and All 
							<span class="hw-underline-wrapper"><span class="hw-word">Sugar</span><svg class="hw-underline-svg" viewBox="0 0 100 16" preserveAspectRatio="none" aria-hidden="true"><path d="M 2,10 Q 50,3 98,8" fill="none" stroke="#0ea5e9" stroke-width="4.5" stroke-linecap="round"/></svg></span>
						</span>
						<span class="title-bottom">Calmed My <span class="highlight-bms">Burning Mouth Syndrome</span></span>
					</h1>
					<p class="hero-centered-subtitle">Learn how my BMS symptoms went from 10/10 to 0/10 by identifying my food triggers: Acid and&nbsp;Sugars.</p>
				</div>

				<div class="hero-video-centered">
					<div class="video-placeholder-wrapper" id="videoPlaceholder" role="button" tabindex="0" aria-label="Play video: How I Stopped My BMS">
						<Image 
							src={authorPhoto} 
							alt={`Denis Ethier - How I Stopped My BMS Symptoms ${monthsInRemission} Months Ago`} 
							class="video-placeholder-img" 
							width={1400} 
							height={788}
						/>
						<div class="video-play-overlay">
							<div class="video-play-btn" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor">
									<path d="M8 5v14l11-7z"/>
								</svg>
							</div>
						</div>
					</div>
				</div>

				<!-- My Story Section Under Video -->
				<article class="personal-story-section">
					<h2 class="story-heading">My BMS Story</h2>
					<div class="story-lead">
						<p>
							In early 2025, I woke up with a searing sensation like a boiling spoon pressed against my tongue. Within weeks, the daily burning escalated to an agonizing 10/10 that made speaking and eating feel like dragging raw tissue across&nbsp;sandpaper.
						</p>
						<p>
							After consulting five dentists and five medical doctors who ran extensive tests only to tell me everything looked completely normal, I realized traditional medicine had no clear solution for my&nbsp;condition.
						</p>
						<p>
							I decided to treat my body like an engineering system. Through rigorous tracking, gentle nighttime mouth taping, and targeted nutritional protocols, I systematically brought my burning symptoms from a 10/10 down to&nbsp;0/10.
						</p>
						<p class="continue-reading-p">
							<a href="/about" class="continue-reading-link">Continue reading &rarr;</a>
						</p>
					</div>
				</article>


			</section>

			<!-- Recent Insights -->
			<section class="section-header recent-posts-header">
				<h2 class="recent-posts-title">Recent Posts</h2>
				<p class="recent-posts-subtitle">Here is what I've written about, the experiments I've conducted, and what I've discovered along the&nbsp;way.</p>
			</section>

			<div class="grid">
				{
					posts.slice(0, 3).map((post, index) => {
						const postNumber = index + 1;
						return (
						<article class="card">
							<a href={`/blog/${post.id}/`}>
								<div class="card-img" style={`background-image: url(${typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage.src})`}></div>
								<div class="card-body">
									<div class="card-meta">
										<span class="meta-entry">Entry {postNumber}</span>
										<span class="meta-date"><FormattedDate date={post.data.pubDate} /></span>
									</div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<span class="view-story">Read More →</span>
								</div>
							</a>
						</article>
					)})
				}
			</div>

			<div style="text-align: center; margin: 2.5rem 0;">
				<a href="/blog" class="btn btn-outline" style="padding: 0.85rem 2.25rem;">View All Entries +</a>
			</div>

			<!-- Bottom Newsletter Callout: Dark High Contrast with 'Stay Updated on My Progress' -->
			<section class="newsletter-section newsletter-dark">
				<h2>Stay Updated on my progress</h2>
				<p>Let's use the collective wisdom to solve BMS for more&nbsp;people.</p>
				<a href="/join" class="btn btn-primary" style="padding: 1rem 2.75rem; font-size: 1.05rem; color: #ffffff !important;">Stay updated &rarr;</a>
			</section>
		</main>
		<Footer />

		<script>
			const placeholder = document.getElementById('videoPlaceholder');
			if (placeholder) {
				const playVideo = () => {
					placeholder.innerHTML = `<iframe 
						src="https://www.youtube-nocookie.com/embed/BM8qUgA8yPE?autoplay=1&rel=0" 
						title="How I Stopped My BMS" 
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
						allowfullscreen
						style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
					></iframe>`;
				};
				placeholder.addEventListener('click', playVideo);
				placeholder.addEventListener('keydown', (e) => {
					if (e.key === 'Enter' || e.key === ' ') {
						e.preventDefault();
						playVideo();
					}
				});
			}
		</script>
	</body>
</html>
