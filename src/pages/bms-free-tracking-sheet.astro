---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title={`The Free BMS Tracking Sheet | ${SITE_TITLE}`} 
			description="Download the 100% free BMS Tracking Sheet. A doctor-ready 3-page daily flare log, 72-hour trigger record, and baseline hardware audit."
		/>
		<style>
			:root {
				--brand-purple: #7c3aed;
				--brand-purple-dark: #581c87;
				--bg-soft: #f8fafc;
				--border-card: #e2e8f0;
			}

			.free-tracking-container {
				max-width: 980px;
				margin: 2rem auto 5rem;
				padding: 0 1.5rem;
				font-family: 'Inter', system-ui, -apple-system, sans-serif;
			}

			.hero-card {
				background: linear-gradient(135deg, #090514 0%, #1e0b38 50%, #2a0845 100%);
				color: #ffffff;
				padding: 3rem 2rem 2.5rem;
				border-radius: 24px;
				margin-bottom: 2rem;
				box-shadow: 0 20px 45px rgba(0,0,0,0.3);
				border: 1px solid rgba(255, 255, 255, 0.1);
				text-align: center;
			}

			.version-label {
				display: block;
				color: #e9d5ff;
				font-size: 0.82rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				margin-bottom: 1rem;
			}

			.hero-title {
				font-size: clamp(2rem, 3.8vw, 2.9rem);
				font-weight: 800;
				line-height: 1.15;
				margin: 0 0 0.85rem;
				letter-spacing: -0.025em;
				color: #ffffff;
				text-wrap: balance;
			}

			.hero-desc {
				font-size: clamp(0.95rem, 1.3vw, 1.1rem);
				color: #e9d5ff;
				max-width: 680px;
				margin: 0 auto 1.75rem;
				line-height: 1.55;
				text-wrap: pretty;
			}

			/* Mockup Image Presentation */
			.mockup-wrapper {
				max-width: 780px;
				margin: 0 auto 2rem;
				position: relative;
				border-radius: 16px;
				overflow: hidden;
				box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
				border: 1px solid rgba(255, 255, 255, 0.12);
				background: #0d061c;
			}

			.mockup-img {
				width: 100%;
				height: auto;
				display: block;
			}

			/* Integrated CTA inside purple box under image */
			.integrated-cta-box {
				background: rgba(255, 255, 255, 0.05);
				border: 1px solid rgba(168, 85, 247, 0.35);
				border-radius: 18px;
				padding: 1.75rem 1.5rem 1.5rem;
				max-width: 520px;
				margin: 0 auto;
				backdrop-filter: blur(8px);
			}

			.cta-heading {
				font-size: 1.2rem;
				font-weight: 800;
				color: #ffffff;
				margin: 0 0 0.35rem;
			}

			.cta-subtext {
				font-size: 0.88rem;
				color: #d8b4fe;
				margin: 0 0 1.25rem;
				line-height: 1.4;
			}

			.compact-form {
				max-width: 440px;
				margin: 0 auto 1rem;
			}

			.compact-input-row {
				display: flex;
				gap: 0.5rem;
				justify-content: center;
				align-items: center;
			}

			.compact-email-input {
				flex: 1;
				max-width: 250px;
				padding: 0.7rem 0.95rem;
				font-size: 0.92rem;
				border-radius: 8px;
				border: 1.5px solid rgba(168, 85, 247, 0.45);
				background: rgba(15, 7, 30, 0.85);
				color: #ffffff;
				outline: none;
				transition: border-color 0.2s ease;
			}

			.compact-email-input:focus {
				border-color: #c084fc;
				box-shadow: 0 0 0 3px rgba(192, 132, 252, 0.2);
			}

			.compact-submit-btn {
				background: #9333ea;
				color: #ffffff;
				font-weight: 700;
				font-size: 0.9rem;
				padding: 0.7rem 1.15rem;
				border-radius: 8px;
				border: none;
				cursor: pointer;
				white-space: nowrap;
				transition: all 0.2s ease;
			}

			.compact-submit-btn:hover {
				background: #a855f7;
				transform: translateY(-1px);
			}

			/* Free direct download link under input */
			.free-pdf-link-wrap {
				margin-top: 0.75rem;
			}

			.free-pdf-link {
				color: #e9d5ff;
				font-size: 0.85rem;
				font-weight: 600;
				text-decoration: underline;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				transition: color 0.2s ease;
			}

			.free-pdf-link:hover {
				color: #ffffff;
			}

			/* Version history minimal box */
			.versions-box {
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 12px;
				padding: 1rem 1.25rem;
				text-align: center;
				color: #64748b;
				font-size: 0.82rem;
				max-width: 600px;
				margin: 0 auto;
			}

			.versions-list {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 1.25rem;
				margin-top: 0.35rem;
				font-weight: 600;
				color: #334155;
			}
		</style>
	</head>
	<body>
		<Header />

		<main class="free-tracking-container">
			<!-- Hero Card with Integrated CTA -->
			<div class="hero-card">
				<span class="version-label">Always Up-To-Date • 100% Free</span>
				<h1 class="hero-title">The Free BMS Tracking Sheet</h1>
				<p class="hero-desc">
					Printable 3-page clinical tracking sheet to log daily morning-to-evening pain curves, 72-hour food delays, and physical oral hardware leaks.
				</p>

				<!-- 3-Page Mockup Image -->
				<div class="mockup-wrapper">
					<img 
						src="/bms-tracking-sheet-mockup-3pages.png" 
						alt="3-Page BMS Tracking Sheet Mockup showing Baseline Audit, 14-Day Circadian Flare Log, and 72-Hour Delayed Rebound Tracker" 
						class="mockup-img"
						loading="eager"
					/>
				</div>

				<!-- Integrated CTA Box inside Purple Section -->
				<div class="integrated-cta-box">
					<h2 class="cta-heading">Tracking Reminders</h2>
					<p class="cta-subtext">
						Get daily reminders and automatic notifications when new markers are added.
					</p>

					<form class="compact-form" action="https://assets.mailerlite.com/jsonp/2046918/forms/0R4iAA/subscribe" method="post">
						<div class="compact-input-row">
							<input 
								type="email" 
								name="fields[email]" 
								placeholder="Enter email..." 
								required 
								aria-label="Email address"
								class="compact-email-input"
							/>
							<button type="submit" class="compact-submit-btn">Get Reminders</button>
						</div>
					</form>

					<!-- Free PDF direct link directly under the input box -->
					<div class="free-pdf-link-wrap">
						<a href="/bms-clinical-intake-questionnaire.pdf" download class="free-pdf-link">
							<span>⬇</span>
							<span>Or download free PDF directly (no email required)</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Simple Version History -->
			<div class="versions-box">
				<div>Version History</div>
				<div class="versions-list">
					<span>Version 1.0 released Nov 9, 2026</span>
					<span>•</span>
					<span>Version 1.1 released Nov 11, 2026</span>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
