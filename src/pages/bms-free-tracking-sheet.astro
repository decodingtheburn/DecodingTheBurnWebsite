---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title={`The Free BMS Tracking Sheet | ${SITE_TITLE}`} 
			description="Download the 100% free BMS Tracking Sheet. A doctor-ready 3-page daily flare log, 72-hour trigger record, and baseline hardware audit."
		/>
		<style>
			:root {
				--brand-purple: #7c3aed;
				--brand-purple-dark: #581c87;
				--bg-soft: #f8fafc;
				--border-card: #e2e8f0;
			}

			.free-tracking-container {
				max-width: 1040px;
				margin: 2rem auto 6rem;
				padding: 0 1.5rem;
				font-family: 'Inter', system-ui, -apple-system, sans-serif;
			}

			.hero-card {
				background: linear-gradient(135deg, #090514 0%, #1e0b38 50%, #2a0845 100%);
				color: #ffffff;
				padding: 3rem 2.5rem 2.5rem;
				border-radius: 20px;
				margin-bottom: 2rem;
				box-shadow: 0 20px 45px rgba(0,0,0,0.3);
				border: 1px solid rgba(255, 255, 255, 0.1);
				text-align: center;
			}

			.version-label {
				display: block;
				color: #e9d5ff;
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				margin-bottom: 1.25rem;
			}

			.hero-title {
				font-size: clamp(2rem, 3.8vw, 3rem);
				font-weight: 800;
				line-height: 1.15;
				margin: 0 0 1rem;
				letter-spacing: -0.025em;
				color: #ffffff;
				text-wrap: balance;
			}

			.hero-desc {
				font-size: clamp(1rem, 1.4vw, 1.15rem);
				color: #e9d5ff;
				max-width: 760px;
				margin: 0 auto 2rem;
				line-height: 1.6;
				text-wrap: pretty;
			}

			/* Mockup Image Presentation */
			.mockup-wrapper {
				max-width: 860px;
				margin: 0 auto 1.5rem;
				position: relative;
				border-radius: 18px;
				overflow: hidden;
				box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
				border: 1px solid rgba(255, 255, 255, 0.15);
				background: #0d061c;
			}

			.mockup-img {
				width: 100%;
				height: auto;
				display: block;
			}

			/* Download Box & Action Buttons */
			.download-card {
				background: #ffffff;
				border: 2px solid #cbd5e1;
				border-radius: 18px;
				padding: 2.25rem 2rem;
				margin-bottom: 2.5rem;
				box-shadow: 0 10px 30px rgba(0,0,0,0.06);
				text-align: center;
			}

			.action-buttons-row {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				justify-content: center;
				margin-bottom: 2rem;
			}

			.btn-direct-download {
				background: #16a34a;
				color: #ffffff;
				font-weight: 800;
				font-size: 1.05rem;
				padding: 0.95rem 1.85rem;
				border-radius: 12px;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				box-shadow: 0 6px 20px rgba(22, 163, 74, 0.25);
				transition: all 0.2s ease;
			}

			.btn-direct-download:hover {
				background: #15803d;
				transform: translateY(-2px);
				box-shadow: 0 8px 24px rgba(22, 163, 74, 0.35);
			}

			.btn-reminder-scroll {
				background: var(--brand-purple);
				color: #ffffff;
				font-weight: 800;
				font-size: 1.05rem;
				padding: 0.95rem 1.85rem;
				border-radius: 12px;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				box-shadow: 0 6px 20px rgba(124, 58, 237, 0.25);
				transition: all 0.2s ease;
			}

			.btn-reminder-scroll:hover {
				background: #6d28d9;
				transform: translateY(-2px);
			}

			/* Email reminder section */
			.reminder-section {
				border-top: 1px solid #e2e8f0;
				padding-top: 2rem;
				margin-top: 1rem;
			}

			.reminder-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 0.5rem;
			}

			.reminder-subtitle {
				font-size: 0.92rem;
				color: #64748b;
				max-width: 620px;
				margin: 0 auto 1.5rem;
				line-height: 1.5;
			}

			.signup-form {
				max-width: 580px;
				margin: 0 auto;
			}

			.input-wrapper {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65rem;
				justify-content: center;
			}

			.email-field {
				flex: 1 1 300px;
				padding: 0.85rem 1.15rem;
				font-size: 1rem;
				border: 1.5px solid #cbd5e1;
				border-radius: 10px;
				outline: none;
			}

			.email-field:focus {
				border-color: var(--brand-purple);
				box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
			}

			.submit-btn {
				background: #0f172a;
				color: #ffffff;
				font-weight: 700;
				font-size: 1rem;
				padding: 0.85rem 1.65rem;
				border-radius: 10px;
				border: none;
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.submit-btn:hover {
				background: #1e293b;
				transform: translateY(-1px);
			}

			/* Version history minimal box */
			.versions-box {
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 14px;
				padding: 1.25rem 1.5rem;
				text-align: center;
				color: #64748b;
				font-size: 0.85rem;
			}

			.versions-list {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 1.5rem;
				margin-top: 0.5rem;
				font-weight: 600;
				color: #334155;
			}
		</style>
	</head>
	<body>
		<Header />

		<main class="free-tracking-container">
			<!-- Hero -->
			<div class="hero-card">
				<span class="version-label">Always Up-To-Date • 100% Free</span>
				<h1 class="hero-title">The Free BMS Tracking Sheet</h1>
				<p class="hero-desc">
					Printable 3-page clinical tracking sheet to log daily morning-to-evening pain curves, 72-hour food delays, and physical oral hardware leaks.
				</p>

				<!-- 3-Page Mockup Image -->
				<div class="mockup-wrapper">
					<img 
						src="/bms-tracking-sheet-mockup-3pages.png" 
						alt="3-Page BMS Tracking Sheet Mockup showing Baseline Audit, 14-Day Circadian Flare Log, and 72-Hour Delayed Rebound Tracker" 
						class="mockup-img"
						loading="eager"
					/>
				</div>
			</div>

			<!-- Main Actions Card: 2 Buttons -->
			<div class="download-card">
				<div class="action-buttons-row">
					<!-- Button 1: Free Download (No login required) -->
					<a href="/bms-clinical-intake-questionnaire.pdf" download class="btn-direct-download">
						<span>⬇</span>
						<span>Free PDF Download</span>
					</a>

					<!-- Button 2: Receive Reminders -->
					<a href="#reminders" class="btn-reminder-scroll">
						<span>🔔</span>
						<span>Receive Daily Reminders</span>
					</a>
				</div>

				<!-- Email Reminder Section -->
				<div id="reminders" class="reminder-section">
					<h2 class="reminder-title">Receive Email Tracking Reminders</h2>
					<p class="reminder-subtitle">
						Enter your email to receive gentle evening reminders and automatic updates whenever new diagnostic markers are added.
					</p>

					<form class="signup-form" action="https://assets.mailerlite.com/jsonp/2046918/forms/0R4iAA/subscribe" method="post">
						<div class="input-wrapper">
							<input 
								type="email" 
								name="fields[email]" 
								placeholder="Enter your email for reminders..." 
								required 
								aria-label="Email address"
								class="email-field"
							/>
							<button type="submit" class="submit-btn">Get Reminders</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Simple Version History -->
			<div class="versions-box">
				<div>Version History</div>
				<div class="versions-list">
					<span>Version 1.0 released Nov 9, 2026</span>
					<span>•</span>
					<span>Version 1.1 released Nov 11, 2026</span>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>