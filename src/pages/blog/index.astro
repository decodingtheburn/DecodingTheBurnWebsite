---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import FormattedDate from '../../components/FormattedDate.astro';
import { sortPostsDescending } from '../../utils/postUtils';

const rawPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = sortPostsDescending(rawPosts);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Stories | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
            <section class="blog-index-header">
				<h1 class="blog-index-title">My Notes & Experiments</h1>
                <p class="blog-index-subtitle">The complete archive of my self-experiments, clinical research notes, and personal learnings living with and overcoming&nbsp;BMS.</p>
			</section>

			<div class="grid" style="margin-bottom: 8rem;">
				{
					posts.map((post, index) => {
						const postNumber = post.data.entryNumber ?? (posts.length - index);
						const displayTag = post.data.tags?.[0] || post.data.category || 'Experiment';
						return (
						<article class="card">
							<a href={`/blog/${post.id}/`}>
								<div class="card-img" style={`background-image: url(${typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage.src})`}></div>
								<div class="card-body">
									<div class="card-meta">
										<span class="meta-tag">{displayTag}</span>
										<span class="meta-date">Entry #{postNumber} • <FormattedDate date={post.data.pubDate} /></span>
									</div>
									<h3 set:html={post.data.title} />
									<p>{post.data.description}</p>
									<span class="view-story">Read My Notes →</span>
								</div>
							</a>
						</article>
					)})
				}
			</div>
		</main>
		<Footer />
		<style>
			.blog-index-header {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				max-width: 900px;
				margin: 4.5rem auto 2.5rem auto;
				padding: 0 1.5rem;
			}

			.blog-index-title {
				font-size: clamp(2.5rem, 5.5vw, 3.75rem);
				font-weight: 800;
				color: #000000;
				letter-spacing: -1.5px;
				text-align: center;
				margin: 0 auto 1rem auto;
				line-height: 1.12;
				text-wrap: balance;
			}

			.blog-index-subtitle {
				color: var(--text-secondary, #000000);
				font-size: 1.2rem;
				line-height: 1.55;
				text-align: center;
				margin: 0 auto;
				max-width: 780px;
				text-wrap: balance;
			}

			@media (max-width: 640px) {
				.blog-index-header {
					margin: 3rem auto 2rem auto;
					padding: 0 1rem;
				}
				.blog-index-subtitle {
					font-size: 1rem;
					line-height: 1.5;
				}
			}
		</style>
	</body>
</html>
