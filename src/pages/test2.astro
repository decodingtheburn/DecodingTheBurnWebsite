	<script is:inline>
		function setMathStyle(style) {
			if (style === 'sans') {
				document.body.classList.add('math-sans');
				document.getElementById('btn-math-sans').classList.add('active');
				document.getElementById('btn-math-serif').classList.remove('active');
			} else {
				document.body.classList.remove('math-sans');
				document.getElementById('btn-math-serif').classList.add('active');
				document.getElementById('btn-math-sans').classList.remove('active');
			}
		}

		// Default to modern sans-serif math
		document.addEventListener('DOMContentLoaded', () => {
			document.body.classList.add('math-sans');
		});

		function showAll() {
			document.querySelectorAll('.variant-card').forEach(c => c.style.display = 'flex');
			setActiveBtn(0);
		}

		function filterCard(cardId) {
			document.querySelectorAll('.variant-card').forEach(c => {
				if (c.id === cardId) {
					c.style.display = 'flex';
					c.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				} else {
					c.style.display = 'none';
				}
			});
			const btns = document.querySelectorAll('.btn-filter');
			btns.forEach(b => b.classList.remove('active'));
			if (window.event && window.event.target) {
				window.event.target.classList.add('active');
			}
		}

		function setActiveBtn(idx) {
			const btns = document.querySelectorAll('.btn-filter');
			btns.forEach((b, i) => {
				if (i === idx) b.classList.add('active');
				else b.classList.remove('active');
			});
		}
	</script>
