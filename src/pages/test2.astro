						Instead, as long as ambient fluid sits at a mild, everyday acidic pH between 6.2 and 6.7, ASIC3 remains wedged open in a continuous, non-inactivating <strong>"window current."</strong> Sodium ions continuously pour through the open pore minute after minute, hour after hour. This molecular discovery provides the definitive atomic proof for why your 10/10 burning was an unbroken, relentless fire rather than a brief sting.
					</p>
				</div>

				<div class="font-notes">
					<strong>Baseline Notes:</strong> Notice how Montserrat's geometric character shapes and numerals compare against the more restrained, technical proportions of Archivo, Fira, and Source Sans 3.
				</div>
			</div>

		</div>
	</div>

	<script is:inline>
		function showAll() {
			document.querySelectorAll('.variant-card').forEach(c => c.style.display = 'flex');
			setActiveBtn(0);
		}

		function filterCard(cardId) {
			document.querySelectorAll('.variant-card').forEach(c => {
				if (c.id === cardId) {
					c.style.display = 'flex';
					c.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				} else {
					c.style.display = 'none';
				}
			});
			const btns = document.querySelectorAll('.btn-filter');
			btns.forEach(b => b.classList.remove('active'));
			event.target.classList.add('active');
		}

		function setActiveBtn(idx) {
			const btns = document.querySelectorAll('.btn-filter');
			btns.forEach((b, i) => {
				if (i === idx) b.classList.add('active');
				else b.classList.remove('active');
			});
		}
	</script>
</body>
</html>
