---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TongueLogo from '../components/TongueLogo.astro';
import { SITE_TITLE } from '../consts';
import { bookPresentationSlides } from '../data/slidesData';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title={`Book Slides & Research Webinar Deck | ${SITE_TITLE}`} 
			description="Interactive presentation viewer and weekly webinar slides covering the core scientific discoveries, receptor biophysics, and patient research from Calm Your Burning Mouth."
			noindex={true}
		/>
		<style>
			:root {
				--brand-purple: #7c3aed;
				--brand-purple-dark: #581c87;
				--brand-rose: #f43f5e;
				--slide-bg: #090514;
				--card-bg: #130a24;
				--text-light: #f8fafc;
				--text-muted: #cbd5e1;
			}

			.slides-page-wrapper {
				max-width: 1400px;
				margin: 1.5rem auto 5rem;
				padding: 0 1.5rem;
				font-family: 'Inter', system-ui, -apple-system, sans-serif;
			}

			/* Header & Toolbar */
			.webinar-header {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				background: linear-gradient(135deg, #090514 0%, #1e0b38 50%, #2a0845 100%);
				color: #ffffff;
				padding: 1.75rem 2rem;
				border-radius: 18px;
				margin-bottom: 1.5rem;
				border: 1px solid rgba(255, 255, 255, 0.1);
				box-shadow: 0 16px 36px rgba(0,0,0,0.3);
			}

			.webinar-title-group h1 {
				font-size: 1.85rem;
				font-weight: 800;
				margin: 0 0 0.35rem;
				letter-spacing: -0.02em;
			}

			.webinar-title-group p {
				font-size: 0.95rem;
				color: #e9d5ff;
				margin: 0;
			}

			.webinar-actions {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.75rem;
			}

			.action-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				font-size: 0.85rem;
				font-weight: 700;
				padding: 0.6rem 1.15rem;
				border-radius: 8px;
				text-decoration: none;
				cursor: pointer;
				transition: all 0.2s ease;
				border: none;
			}

			.btn-fullscreen {
				background: #7c3aed;
				color: #ffffff;
				box-shadow: 0 4px 14px rgba(124, 58, 237, 0.35);
			}

			.btn-fullscreen:hover {
				background: #6d28d9;
				transform: translateY(-1px);
			}

			.btn-outline {
				background: rgba(255, 255, 255, 0.08);
				color: #f1f5f9;
				border: 1px solid rgba(255, 255, 255, 0.2);
			}

			.btn-outline:hover {
				background: rgba(255, 255, 255, 0.15);
				color: #ffffff;
			}

			/* Presentation Stage Container */
			.stage-outer {
				position: relative;
				width: 100%;
				background: #000000;
				border-radius: 20px;
				overflow: hidden;
				box-shadow: 0 25px 60px -15px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.1);
				aspect-ratio: 16 / 9;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			/* Fullscreen mode styling */
			.stage-outer:fullscreen, .stage-outer:-webkit-full-screen {
				width: 100vw;
				height: 100vh;
				border-radius: 0;
				aspect-ratio: auto;
			}

			.stage-canvas {
				position: relative;
				width: 100%;
				height: 100%;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				padding: 3rem 4rem 2.5rem;
				box-sizing: border-box;
				background: radial-gradient(circle at 85% 15%, rgba(124, 58, 237, 0.18) 0%, transparent 60%),
				            radial-gradient(circle at 15% 85%, rgba(244, 63, 94, 0.12) 0%, transparent 60%),
				            #0a0614;
				color: #ffffff;
			}

			/* Slide Header */
			.slide-top-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			.slide-breadcrumb {
				display: inline-flex;
				align-items: center;
				gap: 0.6rem;
				font-size: 0.85rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: #a855f7;
				background: rgba(168, 85, 247, 0.12);
				padding: 0.35rem 0.9rem;
				border-radius: 9999px;
				border: 1px solid rgba(168, 85, 247, 0.3);
			}

			.slide-counter {
				font-size: 0.95rem;
				font-weight: 800;
				color: #94a3b8;
				letter-spacing: 0.05em;
			}

			/* Slide Main Body */
			.slide-main-content {
				margin: auto 0;
			}

			.slide-main-title {
				font-size: clamp(2rem, 3.8vw, 3.4rem);
				font-weight: 800;
				line-height: 1.12;
				margin: 0 0 0.65rem;
				letter-spacing: -0.025em;
				color: #ffffff;
				text-wrap: balance;
			}

			.slide-subtitle {
				font-size: clamp(1.05rem, 1.8vw, 1.45rem);
				font-weight: 500;
				color: #c084fc;
				margin: 0 0 1.75rem;
				line-height: 1.4;
				text-wrap: pretty;
			}

			.slide-bullets-list {
				list-style: none;
				padding: 0;
				margin: 0 0 1.75rem;
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
			}

			.slide-bullet-item {
				display: flex;
				align-items: flex-start;
				gap: 0.85rem;
				font-size: clamp(1rem, 1.5vw, 1.25rem);
				line-height: 1.4;
				color: #f1f5f9;
				opacity: 0.4;
				transform: translateX(-8px);
				transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
			}

			.slide-bullet-item.active {
				opacity: 1;
				transform: translateX(0);
				color: #ffffff;
				font-weight: 600;
			}

			.bullet-check-icon {
				flex-shrink: 0;
				width: 22px;
				height: 22px;
				border-radius: 50%;
				background: rgba(124, 58, 237, 0.25);
				border: 1.5px solid #a855f7;
				display: flex;
				align-items: center;
				justify-content: center;
				color: #e9d5ff;
				font-size: 0.75rem;
				font-weight: 800;
				margin-top: 2px;
			}

			.slide-bullet-item.active .bullet-check-icon {
				background: #7c3aed;
				border-color: #c084fc;
				color: #ffffff;
				box-shadow: 0 0 12px rgba(168, 85, 247, 0.6);
			}

			.slide-takeaway-box {
				background: rgba(255, 255, 255, 0.04);
				border-left: 4px solid #f43f5e;
				padding: 0.85rem 1.25rem;
				border-radius: 0 10px 10px 0;
				font-size: clamp(0.9rem, 1.2vw, 1.05rem);
				color: #fca5a5;
				line-height: 1.45;
			}

			/* Slide Footer Navigation */
			.slide-bottom-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
				padding-top: 1.25rem;
			}

			.slide-brand-mark {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				font-size: 0.9rem;
				font-weight: 700;
				color: #94a3b8;
			}

			.slide-controls {
				display: flex;
				align-items: center;
				gap: 0.6rem;
			}

			.nav-btn {
				background: rgba(255, 255, 255, 0.1);
				border: 1px solid rgba(255, 255, 255, 0.2);
				color: #ffffff;
				width: 40px;
				height: 40px;
				border-radius: 8px;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: all 0.15s ease;
			}

			.nav-btn:hover:not(:disabled) {
				background: var(--brand-purple);
				border-color: var(--brand-purple);
				transform: scale(1.05);
			}

			.nav-btn:disabled {
				opacity: 0.3;
				cursor: not-allowed;
			}

			.slide-dots {
				display: flex;
				gap: 0.4rem;
				margin: 0 0.5rem;
			}

			.slide-dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: rgba(255, 255, 255, 0.25);
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.slide-dot.active {
				width: 24px;
				border-radius: 9999px;
				background: #a855f7;
				box-shadow: 0 0 10px rgba(168, 85, 247, 0.6);
			}

			/* Presenter Notes & Teleprompter Drawer */
			.presenter-cockpit {
				margin-top: 2rem;
				background: #ffffff;
				border: 1.5px solid #cbd5e1;
				border-radius: 16px;
				padding: 1.75rem 2rem;
				box-shadow: 0 4px 20px rgba(0,0,0,0.04);
			}

			.cockpit-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1rem;
				border-bottom: 2px solid #f1f5f9;
				padding-bottom: 0.75rem;
			}

			.cockpit-title {
				font-size: 1.15rem;
				font-weight: 800;
				color: #0f172a;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.webinar-cue-badge {
				background: #fef3c7;
				color: #92400e;
				border: 1px solid #fcd34d;
				padding: 0.35rem 0.85rem;
				border-radius: 9999px;
				font-size: 0.8rem;
				font-weight: 700;
			}

			.speaker-notes-text {
				font-size: 1rem;
				line-height: 1.65;
				color: #334155;
				margin: 0;
			}

			/* Keyboard Shortcuts Guide */
			.keyboard-legend {
				display: flex;
				flex-wrap: wrap;
				gap: 1.25rem;
				margin-top: 1.5rem;
				padding-top: 1.25rem;
				border-top: 1px solid #e2e8f0;
				font-size: 0.82rem;
				color: #64748b;
			}

			.kbd-pill {
				background: #f1f5f9;
				border: 1px solid #cbd5e1;
				border-bottom: 2px solid #94a3b8;
				padding: 0.15rem 0.45rem;
				border-radius: 4px;
				font-family: monospace;
				font-weight: 700;
				color: #1e293b;
			}
		</style>
	</head>
	<body>
		<Header />

		<main class="slides-page-wrapper">
			<!-- Header & Toolbar -->
			<div class="webinar-header">
				<div class="webinar-title-group">
					<h1>Book Slides &amp; Research Presentation</h1>
					<p>An interactive educational slide deck for weekly citizen science webinars and patient education.</p>
				</div>
				<div class="webinar-actions">
					<button type="button" class="action-btn btn-fullscreen" id="toggleFullscreenBtn" title="Launch Fullscreen Presentation (F)">
						<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.2" fill="none"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
						<span>Fullscreen [F]</span>
					</button>
					<a href="/book" class="action-btn btn-outline" title="Read Full Book Manuscript">
						<span>Read Full Book</span>
					</a>
				</div>
			</div>

			<!-- Main 16:9 Presentation Stage -->
			<div class="stage-outer" id="stageOuter" tabindex="0">
				<div class="stage-canvas">
					<!-- Top Row -->
					<div class="slide-top-row">
						<div class="slide-breadcrumb" id="slideBreadcrumb">
							<span id="slidePart">Webinar Opening</span> • <span id="slideChapter">Welcome &amp; Mission</span>
						</div>
						<div class="slide-counter" id="slideCounter">
							Slide 1 of 10
						</div>
					</div>

					<!-- Main Body -->
					<div class="slide-main-content">
						<h2 class="slide-main-title" id="slideMainTitle">Calm Your Burning Mouth</h2>
						<div class="slide-subtitle" id="slideSubtitle">A First-Principles Investigation Into Oral Nerve Pain</div>

						<ul class="slide-bullets-list" id="slideBulletsList">
							<!-- Bullets populated dynamically -->
						</ul>

						<div class="slide-takeaway-box" id="slideTakeawayBox">
							<strong>Core Law:</strong> <span id="slideTakeawayText">BMS is not an incurable psychiatric mystery; it is an electrochemical and hardware overload.</span>
						</div>
					</div>

					<!-- Bottom Row -->
					<div class="slide-bottom-bar">
						<div class="slide-brand-mark">
							<div style="width: 24px; height: 24px;">
								<TongueLogo />
							</div>
							<span>Decoding The Burn • Weekly Research Webinar</span>
						</div>

						<div class="slide-controls">
							<button type="button" class="nav-btn" id="prevSlideBtn" title="Previous (Left Arrow or Shift+Space)">
								<svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="15 18 9 12 15 6"></polyline></svg>
							</button>

							<div class="slide-dots" id="slideDotsContainer">
								<!-- Dots populated dynamically -->
							</div>

							<button type="button" class="nav-btn" id="nextSlideBtn" title="Next (Right Arrow or Spacebar)">
								<svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="9 18 15 12 9 6"></polyline></svg>
							</button>
						</div>
					</div>
				</div>
			</div>

			<!-- Presenter Notes & Teleprompter Cockpit -->
			<div class="presenter-cockpit">
				<div class="cockpit-header">
					<div class="cockpit-title">
						<span>🎙️ Denis's Webinar Speaker Notes &amp; Host Teleprompter</span>
					</div>
					<div class="webinar-cue-badge" id="webinarCueBadge">
						Opening Slide • Welcome attendees
					</div>
				</div>

				<p class="speaker-notes-text" id="speakerNotesText">
					Welcome everyone to our weekly research webinar. Whether you are a patient living in 24/7 agony or a caring dental professional looking for answers, this presentation breaks down four years of N=1 data, peer-reviewed histology, and the electrochemical laws governing oral burning.
				</p>

				<div class="keyboard-legend">
					<div><span class="kbd-pill">Space</span> or <span class="kbd-pill">&rarr;</span> Next Bullet / Slide</div>
					<div><span class="kbd-pill">Shift + Space</span> or <span class="kbd-pill">&larr;</span> Previous Bullet / Slide</div>
					<div><span class="kbd-pill">F</span> Toggle Fullscreen</div>
					<div><span class="kbd-pill">Esc</span> Exit Fullscreen</div>
				</div>
			</div>
		</main>

		<Footer />

		<!-- Interactive Presentation Script -->
		<script is:inline define:vars={{ slides: bookPresentationSlides }}>
			let currentSlideIdx = 0;
			let currentBulletIdx = slides[0].bullets.length; // Show all by default or first point

			const stageOuter = document.getElementById('stageOuter');
			const slidePart = document.getElementById('slidePart');
			const slideChapter = document.getElementById('slideChapter');
			const slideCounter = document.getElementById('slideCounter');
			const slideMainTitle = document.getElementById('slideMainTitle');
			const slideSubtitle = document.getElementById('slideSubtitle');
			const slideBulletsList = document.getElementById('slideBulletsList');
			const slideTakeawayText = document.getElementById('slideTakeawayText');
			const prevSlideBtn = document.getElementById('prevSlideBtn');
			const nextSlideBtn = document.getElementById('nextSlideBtn');
			const slideDotsContainer = document.getElementById('slideDotsContainer');
			const speakerNotesText = document.getElementById('speakerNotesText');
			const webinarCueBadge = document.getElementById('webinarCueBadge');
			const toggleFullscreenBtn = document.getElementById('toggleFullscreenBtn');

			function initDots() {
				slideDotsContainer.innerHTML = '';
				slides.forEach((_, idx) => {
					const dot = document.createElement('div');
					dot.className = `slide-dot ${idx === currentSlideIdx ? 'active' : ''}`;
					dot.addEventListener('click', () => {
						currentSlideIdx = idx;
						currentBulletIdx = slides[currentSlideIdx].bullets.length;
						renderSlide();
					});
					slideDotsContainer.appendChild(dot);
				});
			}

			function renderSlide() {
				const slide = slides[currentSlideIdx];

				slidePart.textContent = slide.part;
				slideChapter.textContent = slide.chapter;
				slideCounter.textContent = `Slide ${currentSlideIdx + 1} of ${slides.length}`;
				slideMainTitle.textContent = slide.title;
				slideSubtitle.textContent = slide.subtitle;
				slideTakeawayText.textContent = slide.takeaway;

				// Bullets
				slideBulletsList.innerHTML = '';
				slide.bullets.forEach((bulletText, bIdx) => {
					const li = document.createElement('li');
					li.className = `slide-bullet-item ${bIdx < currentBulletIdx ? 'active' : ''}`;
					li.innerHTML = `
						<div class="bullet-check-icon">${bIdx + 1}</div>
						<div>${bulletText}</div>
					`;
					slideBulletsList.appendChild(li);
				});

				// Presenter notes & cue
				speakerNotesText.textContent = slide.speakerNotes;
				webinarCueBadge.textContent = slide.webinarCue;

				// Dots
				const dots = slideDotsContainer.querySelectorAll('.slide-dot');
				dots.forEach((dot, idx) => {
					dot.className = `slide-dot ${idx === currentSlideIdx ? 'active' : ''}`;
				});

				// Buttons state
				prevSlideBtn.disabled = currentSlideIdx === 0 && currentBulletIdx <= 1;
				nextSlideBtn.disabled = currentSlideIdx === slides.length - 1 && currentBulletIdx >= slide.bullets.length;
			}

			function nextStep() {
				const slide = slides[currentSlideIdx];
				if (currentBulletIdx < slide.bullets.length) {
					currentBulletIdx++;
					renderSlide();
				} else if (currentSlideIdx < slides.length - 1) {
					currentSlideIdx++;
					currentBulletIdx = 1;
					renderSlide();
				}
			}

			function prevStep() {
				if (currentBulletIdx > 1) {
					currentBulletIdx--;
					renderSlide();
				} else if (currentSlideIdx > 0) {
					currentSlideIdx--;
					currentBulletIdx = slides[currentSlideIdx].bullets.length;
					renderSlide();
				}
			}

			nextSlideBtn.addEventListener('click', nextStep);
			prevSlideBtn.addEventListener('click', prevStep);

			// Keyboard Navigation
			window.addEventListener('keydown', (e) => {
				if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

				if (e.code === 'Space' || e.code === 'ArrowRight' || e.code === 'KeyL') {
					e.preventDefault();
					if (e.shiftKey) {
						prevStep();
					} else {
						nextStep();
					}
				} else if (e.code === 'ArrowLeft' || e.code === 'KeyH') {
					e.preventDefault();
					prevStep();
				} else if (e.code === 'KeyF') {
					e.preventDefault();
					toggleFullscreen();
				}
			});

			// Fullscreen Handler
			function toggleFullscreen() {
				if (!document.fullscreenElement) {
					if (stageOuter.requestFullscreen) {
						stageOuter.requestFullscreen();
					} else if (stageOuter.webkitRequestFullscreen) {
						stageOuter.webkitRequestFullscreen();
					}
				} else {
					if (document.exitFullscreen) {
						document.exitFullscreen();
					}
				}
			}

			toggleFullscreenBtn.addEventListener('click', toggleFullscreen);

			// Initial setup
			initDots();
			renderSlide();
		</script>
	</body>
</html>
