---
// src/pages/to-do.astro
// Private Client Acquisition & Book Launch Target Tracker
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Master Focus Target • Acid-Triggered Burning Mouth Relief</title>
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
  <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;850&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #090d16;
      color: #f1f5f9;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2.5rem 1rem 4rem;
    }
    .auth-gate {
      width: 100%;
      max-width: 440px;
      margin: 5rem auto;
      background: #111827;
      border: 1px solid #1f293d;
      border-radius: 16px;
      padding: 2.25rem;
      box-shadow: 0 25px 60px rgba(0,0,0,0.6);
      text-align: center;
    }
    .auth-gate input {
      width: 100%;
      padding: 0.95rem 1.15rem;
      border-radius: 10px;
      border: 1.5px solid #334155;
      background: #090d16;
      color: #fff;
      font-size: 1.05rem;
      margin: 1.25rem 0 0.85rem;
      outline: none;
      transition: border 0.2s;
    }
    .auth-gate input:focus {
      border-color: #a855f7;
    }
    .auth-gate button {
      width: 100%;
      padding: 0.95rem;
      border-radius: 10px;
      border: none;
      background: #9333ea;
      color: #fff;
      font-weight: 700;
      font-size: 1.05rem;
      cursor: pointer;
      transition: background 0.2s;
    }
    .auth-gate button:hover {
      background: #7e22ce;
    }
    .app-content {
      width: 100%;
      max-width: 1080px;
      display: none;
    }
    
    /* THE 1 BIG THING HERO */
    .hero-big-thing {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.95) 100%);
      border: 2px solid #ef4444;
      border-radius: 24px;
      padding: 3.5rem 3rem;
      box-shadow: 0 20px 60px rgba(239, 68, 68, 0.15), 0 0 0 1px rgba(239, 68, 68, 0.2);
      margin-bottom: 3.5rem;
      position: relative;
      overflow: hidden;
    }
    .hero-big-thing::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0; height: 6px;
      background: linear-gradient(90deg, #ef4444, #f97316, #eab308, #22c55e, #06b6d4, #a855f7);
    }
    .badge-hero {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.5rem 1.15rem;
      border-radius: 999px;
      background: rgba(239, 68, 68, 0.18);
      color: #fca5a5;
      border: 1px solid rgba(239, 68, 68, 0.4);
      font-size: 0.95rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 1.25rem;
    }
    .hero-title {
      font-size: clamp(2.6rem, 5.5vw, 4rem);
      font-weight: 850;
      line-height: 1.12;
      letter-spacing: -0.025em;
      color: #ffffff;
      margin-bottom: 1.25rem;
    }
    .hero-desc {
      font-size: 1.35rem;
      line-height: 1.65;
      color: #cbd5e1;
      max-width: 880px;
    }
    .hero-footer-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 2.25rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      flex-wrap: wrap;
      gap: 1.5rem;
    }
    .hero-stat-pill {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.15rem;
      color: #38bdf8;
    }
    .pulse-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #ef4444;
      box-shadow: 0 0 16px #ef4444;
      animation: pulse 1.8s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    /* SUB-TASKS LIST */
    .subtasks-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 2rem;
      padding: 0 0.5rem;
    }
    .subtasks-header h2 {
      font-size: 1.85rem;
      font-weight: 850;
      color: #f8fafc;
      letter-spacing: -0.02em;
    }
    .subtasks-count {
      font-size: 1.15rem;
      color: #94a3b8;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
    }

    /* 1 HOUR BLOCK = 1/3 PAGE (min-height ~32vh) WITH LARGE FONTS */
    .subtask-card {
      background: #131c2e;
      border: 1.5px solid #1f2d47;
      border-radius: 20px;
      padding: 2.5rem 2.25rem;
      margin-bottom: 2.25rem;
      min-height: 32vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.2s ease;
      box-shadow: 0 10px 30px rgba(0,0,0,0.35);
    }
    .subtask-card:hover {
      border-color: #3b82f6;
      background: #17233a;
      transform: translateY(-2px);
    }
    .subtask-card.is-completed {
      opacity: 0.45;
      background: #0f172a;
      border-color: #1e293b;
    }
    .subtask-card.is-completed .task-title-text {
      text-decoration: line-through;
      color: #64748b;
    }
    .subtask-card.is-running {
      border-color: #a855f7;
      box-shadow: 0 0 35px rgba(168, 85, 247, 0.3);
      background: #1a1b38;
    }

    .subtask-top-row {
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
      width: 100%;
    }

    /* CUSTOM BIG CHECKBOX */
    .task-checkbox-btn {
      width: 36px;
      height: 36px;
      min-width: 36px;
      min-height: 36px;
      border-radius: 10px;
      border: 2.5px solid #475569;
      background: #090d16;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s ease;
      margin-top: 0.35rem;
    }
    .task-checkbox-btn:hover {
      border-color: #9333ea;
      transform: scale(1.05);
    }
    .task-checkbox-btn.checked {
      background: #22c55e;
      border-color: #22c55e;
      color: #ffffff;
    }

    /* TASK DETAILS (LARGE TYPOGRAPHY) */
    .task-main-col {
      flex: 1;
      min-width: 0;
    }
    .task-meta-tag {
      font-size: 0.95rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #38bdf8;
      margin-bottom: 0.5rem;
      font-family: 'JetBrains Mono', monospace;
    }
    .task-title-text {
      font-size: clamp(1.6rem, 2.8vw, 2.1rem);
      font-weight: 850;
      color: #ffffff;
      line-height: 1.22;
      letter-spacing: -0.015em;
      margin-bottom: 1.15rem;
    }
    .task-bullet-list {
      list-style: none;
      padding-left: 0;
      margin: 0.85rem 0 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .task-bullet-list li {
      font-size: 1.15rem;
      line-height: 1.6;
      color: #cbd5e1;
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
    }
    .task-bullet-list li::before {
      content: "•";
      color: #a855f7;
      font-size: 1.4rem;
      line-height: 1;
      flex-shrink: 0;
    }

    /* CARD BOTTOM BAR (TIMER) */
    .subtask-bottom-row {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      padding-top: 1.25rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      margin-top: 1rem;
      width: 100%;
    }

    /* INTERACTIVE TIMER WIDGET (EXPANDED) */
    .timer-widget {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: #090d16;
      padding: 0.75rem 1.25rem;
      border-radius: 14px;
      border: 1.5px solid #1f2d47;
    }
    .timer-display {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.45rem;
      font-weight: 800;
      color: #f1f5f9;
      min-width: 85px;
      text-align: center;
    }
    .timer-btn {
      padding: 0.6rem 1.25rem;
      border-radius: 10px;
      border: none;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-timer-start {
      background: #9333ea;
      color: #fff;
    }
    .btn-timer-start:hover {
      background: #7e22ce;
      transform: scale(1.02);
    }
    .btn-timer-stop {
      background: #ef4444;
      color: #fff;
    }
    .btn-timer-reset {
      background: #334155;
      color: #cbd5e1;
      padding: 0.6rem 0.85rem;
      font-size: 1.1rem;
    }
    .btn-timer-reset:hover {
      background: #475569;
    }

    /* PARTNERSHIP CARD */
    .partner-banner {
      margin-top: 3rem;
      background: #111e2e;
      border: 1px solid #10b981;
      border-radius: 16px;
      padding: 1.75rem 2rem;
    }
    .partner-badge {
      display: inline-block;
      padding: 0.25rem 0.7rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      background: rgba(16, 185, 129, 0.2);
      color: #86efac;
      border: 1px solid rgba(16, 185, 129, 0.4);
      margin-bottom: 0.85rem;
    }
    .partner-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 0.5rem;
    }
    .partner-desc {
      font-size: 0.95rem;
      line-height: 1.6;
      color: #cbd5e1;
    }
    .partner-link {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      color: #38bdf8;
      font-weight: 700;
      text-decoration: underline;
      margin-top: 0.65rem;
    }

    @media (max-width: 768px) {
      .subtask-card {
        grid-template-columns: auto 1fr;
        gap: 1rem;
      }
      .timer-widget {
        grid-column: 1 / -1;
        justify-content: space-between;
      }
    }
  </style>
</head>
<body>

  <!-- PASSWORD GATE -->
  <div id="auth-panel" class="auth-gate">
    <div style="font-size: 0.82rem; font-weight: 800; text-transform: uppercase; color: #a855f7; letter-spacing: 0.08em; margin-bottom: 0.4rem;">Restricted Focus</div>
    <h2 style="font-size: 1.5rem; font-weight: 850; color: #fff;">Operational Dashboard</h2>
    <p style="font-size: 0.88rem; color: #94a3b8; margin-top: 0.4rem;">Enter the passcode to view the 1 Big Thing target and hourly pre-flight checklist.</p>
    
    <input type="password" id="passcode-input" placeholder="Enter passcode..." autocomplete="off">
    <div id="error-msg" style="color: #ef4444; font-size: 0.82rem; display: none; margin-bottom: 0.65rem;">Incorrect passcode. Please try again.</div>
    <button type="button" id="submit-btn">Unlock Focus Tracker</button>
  </div>

  <!-- AUTHORIZED OPERATIONAL DASHBOARD -->
  <div id="dashboard-panel" class="app-content">

    <!-- THE 1 BIG THING -->
    <div class="hero-big-thing">
      <div class="badge-hero">
        <span class="pulse-dot"></span>
        <span>The 1 Big Thing Today</span>
      </div>
      <h1 class="hero-title">Order the Physical KDP Draft Proof</h1>
      <p class="hero-desc">
        Complete all 6 production pre-flight checks, generate the 6" &times; 9" interior PDF with 300 DPI figures, upload the calibrated <em>Acid-Triggered Burning Mouth Relief</em> cover wrap, and submit the physical draft proof copy order on Amazon KDP.
      </p>

      <div class="hero-footer-bar">
        <div class="hero-stat-pill">
          <span>Target Deadline:</span>
          <strong style="color: #ffffff;">Today by 3:00 PM</strong>
          <span style="color: #64748b;">(Started 09:00 AM)</span>
        </div>
        <div class="hero-stat-pill">
          <span>Sprint Clock:</span>
          <span id="live-clock" style="color: #38bdf8;">--:--</span>
        </div>
      </div>
    </div>

    <!-- SUB-TASKS LIST WITH INTERACTIVE TIMERS -->
    <div class="subtasks-header">
      <h2>Production Milestones (Checklist &amp; Timers)</h2>
      <div class="subtasks-count" id="progress-summary">0 of 7 Completed</div>
    </div>

    <!-- PRIORITY TASK 0: CALL DENTIST -->
    <div class="subtask-card" id="card-t0" style="border: 2.5px solid #ef4444; background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(19, 28, 46, 0.98)); box-shadow: 0 0 35px rgba(239, 68, 68, 0.25);">
      <div class="subtask-top-row">
        <div class="task-checkbox-btn" data-tid="t0" role="checkbox" aria-checked="false" style="border-color: #ef4444;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div class="task-main-col">
          <div class="task-meta-tag" style="color: #f87171; font-weight: 850;">CRITICAL PRIORITY &bull; FIRST MORNING ACTION</div>
          <div class="task-title-text" style="color: #ffffff;">Request iTero Occlusion Scan</div>
          <ul class="task-bullet-list">
            <li>Call or email dentist office to request official digital scan export</li>
            <li>Ask specifically for the bite contact map and clearance heatmap from iTero Element 5D</li>
            <li>Crucial physical documentation for Chapter 13 and the interactive 3D Viewer audit</li>
          </ul>
        </div>
      </div>
      <div class="subtask-bottom-row">
        <div class="timer-widget">
          <span class="timer-display" id="time-t0" style="color: #f87171;">15:00</span>
          <button class="timer-btn btn-timer-start" data-tid="t0" data-default="900" style="background: #ef4444; color: #fff;">Start Sprint</button>
          <button class="timer-btn btn-timer-reset" data-tid="t0" data-default="900" title="Reset">&#8635;</button>
        </div>
      </div>
    </div>

    <!-- TASK 1 -->
    <div class="subtask-card" id="card-t1">
      <div class="subtask-top-row">
        <div class="task-checkbox-btn" data-tid="t1" role="checkbox" aria-checked="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div class="task-main-col">
          <div class="task-meta-tag">Hour 1 &bull; 09:00 – 10:00</div>
          <div class="task-title-text">Table of Contents Alignment</div>
          <ul class="task-bullet-list">
            <li>Re-sequence Chapters 1 to 24 continuously across Parts I through VI</li>
            <li>Resolve duplicate numbering conflict between Part II and Part III</li>
            <li>Harmonize chapter anchors, clean subsections, and verify page numbers match the interior</li>
          </ul>
        </div>
      </div>
      <div class="subtask-bottom-row">
        <div class="timer-widget">
          <span class="timer-display" id="time-t1">60:00</span>
          <button class="timer-btn btn-timer-start" data-tid="t1" data-default="3600">Start Sprint</button>
          <button class="timer-btn btn-timer-reset" data-tid="t1" data-default="3600" title="Reset">&#8635;</button>
        </div>
      </div>
    </div>

    <!-- TASK 2 -->
    <div class="subtask-card" id="card-t2">
      <div class="subtask-top-row">
        <div class="task-checkbox-btn" data-tid="t2" role="checkbox" aria-checked="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div class="task-main-col">
          <div class="task-meta-tag">Hour 2 &bull; 10:00 – 11:00</div>
          <div class="task-title-text">Cover Wrap Spine Calibration</div>
          <ul class="task-bullet-list">
            <li>Confirm front cover artwork and lock flush width margins across all 4 title lines</li>
            <li>Verify rainbow RELIEF spans the exact physical outer boundary of MOUTH</li>
            <li>Calibrate 0.669" spine width for 297 pages and verify Amazon KDP barcode safe zones</li>
          </ul>
        </div>
      </div>
      <div class="subtask-bottom-row">
        <div class="timer-widget">
          <span class="timer-display" id="time-t2">60:00</span>
          <button class="timer-btn btn-timer-start" data-tid="t2" data-default="3600">Start Sprint</button>
          <button class="timer-btn btn-timer-reset" data-tid="t2" data-default="3600" title="Reset">&#8635;</button>
        </div>
      </div>
    </div>

    <!-- TASK 3 -->
    <div class="subtask-card" id="card-t3">
      <div class="subtask-top-row">
        <div class="task-checkbox-btn" data-tid="t3" role="checkbox" aria-checked="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div class="task-main-col">
          <div class="task-meta-tag">Hour 3 &bull; 11:00 – 12:00</div>
          <div class="task-title-text">Interior Margins Running Heads</div>
          <ul class="task-bullet-list">
            <li>Audit /draft layout for strict 0.65" inside gutter margins for 6" x 9" format</li>
            <li>Verify 3-line rubber draft stamp date is synchronized across all 297 pages</li>
            <li>Inspect running head titles and confirm alternating odd-even page numbers</li>
          </ul>
        </div>
      </div>
      <div class="subtask-bottom-row">
        <div class="timer-widget">
          <span class="timer-display" id="time-t3">60:00</span>
          <button class="timer-btn btn-timer-start" data-tid="t3" data-default="3600">Start Sprint</button>
          <button class="timer-btn btn-timer-reset" data-tid="t3" data-default="3600" title="Reset">&#8635;</button>
        </div>
      </div>
    </div>

    <!-- TASK 4 -->
    <div class="subtask-card" id="card-t4">
      <div class="subtask-top-row">
        <div class="task-checkbox-btn" data-tid="t4" role="checkbox" aria-checked="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div class="task-main-col">
          <div class="task-meta-tag">Hour 4 &bull; 12:00 – 13:00</div>
          <div class="task-title-text">Scientific Figures Page Audit</div>
          <ul class="task-bullet-list">
            <li>Verify MultiSourcePainDiagram Option 6 with 62px enlarged icons and clean orthogonal lines</li>
            <li>Audit Page 30e (The Overflowing Bucket Science) with all 5 medical pioneer models</li>
            <li>Ensure high-contrast vector clarity and zero clipping on 300 DPI print output</li>
          </ul>
        </div>
      </div>
      <div class="subtask-bottom-row">
        <div class="timer-widget">
          <span class="timer-display" id="time-t4">60:00</span>
          <button class="timer-btn btn-timer-start" data-tid="t4" data-default="3600">Start Sprint</button>
          <button class="timer-btn btn-timer-reset" data-tid="t4" data-default="3600" title="Reset">&#8635;</button>
        </div>
      </div>
    </div>

    <!-- TASK 5 -->
    <div class="subtask-card" id="card-t5">
      <div class="subtask-top-row">
        <div class="task-checkbox-btn" data-tid="t5" role="checkbox" aria-checked="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div class="task-main-col">
          <div class="task-meta-tag">Hour 5 &bull; 13:00 – 14:00</div>
          <div class="task-title-text">Questionnaire Formatting Typography Audit</div>
          <ul class="task-bullet-list">
            <li>Inspect Pages 7 through 10 diagnostic questionnaire for balanced two-column alignment</li>
            <li>Execute rigorous Anti-Widow audit: bind all heading and subhead endings with non-breaking spaces</li>
            <li>Guarantee zero em-dashes, zero unescaped ampersands, and clean line-height across all cards</li>
          </ul>
        </div>
      </div>
      <div class="subtask-bottom-row">
        <div class="timer-widget">
          <span class="timer-display" id="time-t5">60:00</span>
          <button class="timer-btn btn-timer-start" data-tid="t5" data-default="3600">Start Sprint</button>
          <button class="timer-btn btn-timer-reset" data-tid="t5" data-default="3600" title="Reset">&#8635;</button>
        </div>
      </div>
    </div>

    <!-- TASK 6 -->
    <div class="subtask-card" id="card-t6">
      <div class="subtask-top-row">
        <div class="task-checkbox-btn" data-tid="t6" role="checkbox" aria-checked="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div class="task-main-col">
          <div class="task-meta-tag" style="color: #ef4444; font-weight: 850;">Hour 6 &bull; 14:00 – 15:00 &bull; FINAL MILESTONE</div>
          <div class="task-title-text">Order Physical KDP Proof</div>
          <ul class="task-bullet-list">
            <li>Export final print-ready 6" x 9" interior PDF with embedded vector graphics</li>
            <li>Upload interior PDF and calibrated cover wrap into the Amazon KDP Portal</li>
            <li>Run Amazon Print Previewer: verify zero bleed errors, zero gutter trim collisions, and place the physical proof order</li>
          </ul>
        </div>
      </div>
      <div class="subtask-bottom-row">
        <div class="timer-widget">
          <span class="timer-display" id="time-t6">60:00</span>
          <button class="timer-btn btn-timer-start" data-tid="t6" data-default="3600">Start Sprint</button>
          <button class="timer-btn btn-timer-reset" data-tid="t6" data-default="3600" title="Reset">&#8635;</button>
        </div>
      </div>
    </div>

    <!-- STRATEGIC PARTNERSHIP -->
    <div class="partner-banner">
      <div class="partner-badge">Strategic Clinical Partnership</div>
      <h3 class="partner-title">Dr. Shane Cope, DDS, MSD &bull; The Relief Room (Skool)</h3>
      <p class="partner-desc">
        Partner with Dr. Shane Cope (specialist in Oral Medicine, Orofacial Pain &amp; Periodontics) who runs <strong>The Relief Room</strong> on Skool.
        <br><br>
        <strong>Core Synergy:</strong> Provide <em>Acid-Triggered Burning Mouth Relief</em> as an official structural textbook &amp; diagnostic curriculum inside The Relief Room to help members rule out micro-leakage, exposed dentinal tubules, and chemical acid triggers.
      </p>
      <a href="https://www.skool.com/the-relief-room-6243/about?utm_source=skooldotcom&utm_medium=website&utm_campaign=user_profile_page&utm_content=b47ee493c34a49839795e36059329157" target="_blank" rel="noopener noreferrer" class="partner-link">
        <span>Visit The Relief Room on Skool</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
      </a>
    </div>

  </div>

  <script is:inline>
    const EXPECTED_PASS = "Winter2026";
    const authPanel = document.getElementById('auth-panel');
    const dashPanel = document.getElementById('dashboard-panel');
    const passInput = document.getElementById('passcode-input');
    const submitBtn = document.getElementById('submit-btn');
    const errorMsg = document.getElementById('error-msg');

    function checkAuth() {
      if (passInput.value.trim() === EXPECTED_PASS) {
        localStorage.setItem('todo_auth', 'granted');
        authPanel.style.display = 'none';
        dashPanel.style.display = 'block';
      } else {
        errorMsg.style.display = 'block';
        passInput.focus();
      }
    }

    submitBtn.addEventListener('click', checkAuth);
    passInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') checkAuth();
    });

    if (localStorage.getItem('todo_auth') === 'granted') {
      authPanel.style.display = 'none';
      dashPanel.style.display = 'block';
    }

    // CHECKBOXES & LOCAL STORAGE PERSISTENCE
    const checkBtns = document.querySelectorAll('.task-checkbox-btn');
    const progressEl = document.getElementById('progress-summary');

    function updateProgress() {
      let completed = 0;
      checkBtns.forEach(btn => {
        const tid = btn.dataset.tid;
        const card = document.getElementById('card-' + tid);
        const icon = btn.querySelector('svg');
        const isChecked = localStorage.getItem('subtask_' + tid) === 'true';

        if (isChecked) {
          btn.classList.add('checked');
          btn.setAttribute('aria-checked', 'true');
          icon.style.display = 'block';
          card.classList.add('is-completed');
          completed++;
        } else {
          btn.classList.remove('checked');
          btn.setAttribute('aria-checked', 'false');
          icon.style.display = 'none';
          card.classList.remove('is-completed');
        }
      });
      progressEl.textContent = `${completed} of ${checkBtns.length} Completed`;
    }

    checkBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tid = btn.dataset.tid;
        const currentState = localStorage.getItem('subtask_' + tid) === 'true';
        localStorage.setItem('subtask_' + tid, (!currentState).toString());
        updateProgress();
      });
    });

    updateProgress();

    // INTERACTIVE TIMERS PER SUBTASK
    const activeIntervals = {};
    const remainingSeconds = {};

    function formatTime(sec) {
      const m = Math.floor(sec / 60).toString().padStart(2, '0');
      const s = (sec % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    document.querySelectorAll('.timer-btn.btn-timer-start').forEach(btn => {
      const tid = btn.dataset.tid;
      const defaultSec = parseInt(btn.dataset.default, 10);
      const savedTime = localStorage.getItem('timer_val_' + tid);
      remainingSeconds[tid] = savedTime ? parseInt(savedTime, 10) : defaultSec;

      const display = document.getElementById('time-' + tid);
      display.textContent = formatTime(remainingSeconds[tid]);

      btn.addEventListener('click', () => {
        const card = document.getElementById('card-' + tid);
        if (activeIntervals[tid]) {
          // Pause timer
          clearInterval(activeIntervals[tid]);
          activeIntervals[tid] = null;
          btn.textContent = 'Resume';
          btn.classList.remove('btn-timer-stop');
          btn.classList.add('btn-timer-start');
          card.classList.remove('is-running');
        } else {
          // Start timer
          card.classList.add('is-running');
          btn.textContent = 'Pause';
          btn.classList.remove('btn-timer-start');
          btn.classList.add('btn-timer-stop');

          activeIntervals[tid] = setInterval(() => {
            if (remainingSeconds[tid] > 0) {
              remainingSeconds[tid]--;
              display.textContent = formatTime(remainingSeconds[tid]);
              localStorage.setItem('timer_val_' + tid, remainingSeconds[tid]);
            } else {
              clearInterval(activeIntervals[tid]);
              activeIntervals[tid] = null;
              btn.textContent = 'Done!';
              btn.classList.remove('btn-timer-stop');
              card.classList.remove('is-running');
              alert(`Hour milestone ${tid.toUpperCase()} completed!`);
            }
          }, 1000);
        }
      });
    });

    document.querySelectorAll('.timer-btn.btn-timer-reset').forEach(btn => {
      const tid = btn.dataset.tid;
      const defaultSec = parseInt(btn.dataset.default, 10);
      btn.addEventListener('click', () => {
        const card = document.getElementById('card-' + tid);
        const startBtn = document.querySelector(`.btn-timer-start[data-tid="${tid}"], .btn-timer-stop[data-tid="${tid}"]`);
        if (activeIntervals[tid]) {
          clearInterval(activeIntervals[tid]);
          activeIntervals[tid] = null;
        }
        remainingSeconds[tid] = defaultSec;
        localStorage.setItem('timer_val_' + tid, defaultSec);
        document.getElementById('time-' + tid).textContent = formatTime(defaultSec);
        startBtn.textContent = 'Start';
        startBtn.classList.remove('btn-timer-stop');
        startBtn.classList.add('btn-timer-start');
        card.classList.remove('is-running');
      });
    });

    // Live Sprint Clock
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('live-clock');
      if (el) {
        el.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      }
    }
    setInterval(updateClock, 1000);
    updateClock();
  </script>
</body>
</html>
