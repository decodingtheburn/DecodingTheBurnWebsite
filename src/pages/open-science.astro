---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import { Image } from 'astro:assets';
import authorPhoto from '../assets/denis-ethier.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Open Science | Decoding The Burn" 
			description="Our Open Science manifesto: Why all Burning Mouth Syndrome research data, transcripts, protocols, and self-experiments are published freely for patients and clinicians." 
		/>
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section Following Homepage Model -->
			<section class="hero-centered-wrapper">
				<div class="hero-centered-header">
					<MedicalDisclaimer />
					<h1 class="hero-centered-title">
						Open Science at Decoding the&nbsp;Burn
					</h1>
					<p class="hero-centered-subtitle">
						We publish all research data, clinical interview transcripts, and recovery protocols openly.
						Here is why radical data transparency and patient-led science belong to&nbsp;everyone.
					</p>
				</div>

				<!-- Video on Top -->
				<div class="hero-video-centered">
					<div class="video-placeholder-wrapper" style="cursor: default;">
						<Image 
							src={authorPhoto} 
							alt="Denis Ethier - Open Science and Patient-Led Research" 
							class="video-placeholder-img" 
							width={1400} 
							height={788}
						/>
					</div>
				</div>

				<!-- Story Card Under Video -->
				<article class="personal-story-section">
					<h2 class="story-heading">My Story &amp; Why I Committed to Open&nbsp;Science</h2>
					<div class="story-lead">
						<p>
							When I was suffering through 10/10 burning mouth agony, I quickly ran into medical silos, paywalled research papers, and fragmented clinical studies. I had to pay for academic journal access and decipher complex biochemistry on my own just to understand what was inflaming my&nbsp;tongue.
						</p>
						<p>
							I promised myself that if I found answers, I would publish everything in the open. No paywalls, no expensive courses, and no closed doors. Every symptom log, clinical consult recording, and recovery protocol on this platform is completely free and accessible for both patients and&nbsp;practitioners.
						</p>
						<p class="continue-reading-p">
							<a href="/podcast/about" class="continue-reading-link">Learn more about the podcast &rarr;</a>
						</p>
					</div>
				</article>
			</section>

			<!-- Core Manifesto Section -->
			<section class="open-science-content-container">
				<h2 class="section-title">The Open Science Manifesto</h2>
				<p class="lead-text">
					For decades, patients suffering from Burning Mouth Syndrome have been isolated behind closed medical silos, fragmented clinical studies, and expensive academic&nbsp;paywalls.
				</p>
				<p class="body-text">
					At <strong>Decoding The Burn</strong>, we believe that life-saving health insights should belong to everyone. We practice <em>Patient-Led Open Science</em>, combining authentic lived recovery experiences with rigorous clinical investigation and published&nbsp;microbiology.
				</p>

				<div class="pillar-grid">
					<!-- Pillar 1 -->
					<div class="pillar-box">
						<div class="pillar-number">01</div>
						<h3 class="pillar-title">Radical Data Transparency</h3>
						<p class="pillar-desc">
							Every self-experiment, symptom tracking timeline, dental intervention, and outcome is logged publicly so other sufferers can analyze what worked, what failed, and&nbsp;why.
						</p>
					</div>

					<!-- Pillar 2 -->
					<div class="pillar-box">
						<div class="pillar-number">02</div>
						<h3 class="pillar-title">Zero Paywalls &amp; Open Access</h3>
						<p class="pillar-desc">
							All podcast episodes, full audio/video transcripts, guest question templates, and clinical breakdowns are 100% free and licensed for open&nbsp;research.
						</p>
					</div>

					<!-- Pillar 3 -->
					<div class="pillar-box">
						<div class="pillar-number">03</div>
						<h3 class="pillar-title">Patient-Clinician Collaboration</h3>
						<p class="pillar-desc">
							We bridge the gap between patient observations and clinical science, interviewing leading dentists, periodontists, and oral medicine researchers to uncover biological root&nbsp;causes.
						</p>
					</div>
				</div>
			</section>

			<!-- What This Means For You Section -->
			<section class="open-science-content-container audience-breakdown-section">
				<h2 class="section-title">What Open Science Means For&nbsp;You</h2>

				<div class="audience-grid">
					<div class="audience-card">
						<h3 class="audience-heading">For Patients &amp; Families</h3>
						<ul class="audience-list">
							<li>Free access to structured symptom tracking frameworks and recovery&nbsp;timelines.</li>
							<li>In-depth interview transcripts you can print and bring directly to your healthcare&nbsp;provider.</li>
							<li>A supportive, research-grounded space proving your pain is real and&nbsp;biological.</li>
						</ul>
					</div>

					<div class="audience-card">
						<h3 class="audience-heading">For Clinicians &amp; Researchers</h3>
						<ul class="audience-list">
							<li>Rich, longitudinal N=1 patient datasets detailing triggers, interventions, and remission&nbsp;phases.</li>
							<li>An open platform to share clinical hypotheses, microscopy techniques, and biofilm&nbsp;findings.</li>
							<li>Direct collaboration opportunities through our podcast and case&nbsp;discussions.</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- How You Can Participate & Support -->
			<section class="open-science-content-container support-section">
				<h2 class="section-title">Engage With Our Open Research</h2>
				<p class="support-text">
					Open science grows through collective wisdom. Explore our open research, listen to the podcast, or connect with our&nbsp;community.
				</p>

				<div class="cta-actions-row">
					<a href="/podcast/" class="btn btn-primary" style="padding: 0.95rem 2.5rem; font-size: 1.05rem;">
						Explore the Podcast &rarr;
					</a>
				</div>
			</section>
		</main>
		<Footer />

		<style>
			.open-science-content-container {
				max-width: 1080px;
				margin: 1rem auto 4.5rem;
				padding: 0 1.5rem;
			}

			.section-title {
				font-size: clamp(1.75rem, 3.5vw, 2.25rem);
				font-weight: 800;
				color: #0f172a;
				letter-spacing: -0.02em;
				margin: 0 0 1.5rem 0;
				text-align: center;
				text-wrap: balance;
			}

			.lead-text {
				font-size: 1.2rem;
				font-weight: 500;
				line-height: 1.7;
				color: #1e293b;
				text-align: center;
				max-width: 800px;
				margin: 0 auto 1.5rem auto;
				text-wrap: pretty;
			}

			.body-text {
				font-size: 1.05rem;
				line-height: 1.75;
				color: #475569;
				text-align: center;
				max-width: 780px;
				margin: 0 auto 3rem auto;
				text-wrap: pretty;
			}

			/* Pillars Grid */
			.pillar-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 2rem;
				margin-top: 2rem;
			}

			.pillar-box {
				background: #ffffff;
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 2.25rem 2rem;
				text-align: left;
				box-shadow: 0 4px 16px -4px rgba(15, 23, 42, 0.04);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}

			.pillar-box:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 20px -4px rgba(15, 23, 42, 0.06);
			}

			.pillar-number {
				font-size: 1.5rem;
				font-weight: 900;
				color: #c8382c;
				margin-bottom: 0.75rem;
			}

			.pillar-title {
				font-size: 1.25rem;
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 0.75rem 0;
			}

			.pillar-desc {
				font-size: 0.98rem;
				line-height: 1.65;
				color: #475569;
				margin: 0;
				text-wrap: pretty;
			}

			/* Audience Section */
			.audience-breakdown-section {
				margin-bottom: 4.5rem;
			}

			.audience-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 2rem;
				margin-top: 2rem;
			}

			.audience-card {
				background: #ffffff;
				border: 1px solid var(--card-border);
				border-radius: 20px;
				padding: 2.5rem 2.25rem;
				box-shadow: 0 4px 16px -4px rgba(15, 23, 42, 0.04);
			}

			.audience-heading {
				font-size: 1.3rem;
				font-weight: 800;
				color: #0f172a;
				margin: 0 0 1.25rem 0;
			}

			.audience-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.audience-list li {
				position: relative;
				padding-left: 1.75rem;
				font-size: 1rem;
				line-height: 1.6;
				color: #334155;
				text-wrap: pretty;
			}

			.audience-list li::before {
				content: "✓";
				position: absolute;
				left: 0;
				top: 0;
				font-weight: 800;
				color: #c8382c;
			}

			/* Support Section */
			.support-section {
				text-align: center;
				background: #fdfbf7;
				border: 1px solid var(--card-border);
				border-radius: 24px;
				padding: 3rem 2rem;
				margin-bottom: 5rem;
			}

			.support-text {
				font-size: 1.15rem;
				line-height: 1.65;
				color: #475569;
				max-width: 680px;
				margin: 0 auto 2rem auto;
				text-wrap: balance;
			}

			.cta-actions-row {
				display: flex;
				justify-content: center;
				gap: 1rem;
			}
		</style>
	</body>
</html>
