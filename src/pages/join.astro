---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Sign up for the latest update" 
			description="Sign up for the latest updates, recovery notes, and research discoveries on Burning Mouth Syndrome." 
		/>
	</head>
	<body>
		<Header />
		<main class="join-main-wrapper">
			<div class="join-disclaimer-container">
				<MedicalDisclaimer />
			</div>

			<div class="join-clean-container">
				<div class="join-form-card">
					<h1 class="join-title">Sign up for the latest update</h1>
					<p class="join-subtitle">
						Get my latest self-experimentation logs, clinical breakdowns, and practical BMS recovery notes directly to your&nbsp;inbox.
					</p>

					<!-- MailerLite Direct Form Embed -->
					<div class="ml-embedded" data-form="0R4iAA"></div>

					<!-- Direct Email Form -->
					<form class="join-direct-form" action="https://assets.mailerlite.com/jsonp/2046918/forms/0R4iAA/subscribe" method="post">
						<div class="input-group">
							<input 
								type="email" 
								name="fields[email]" 
								placeholder="Enter your email..." 
								required 
								aria-label="Email address"
								class="join-email-input"
							/>
							<button type="submit" class="btn btn-primary join-submit-btn">Subscribe</button>
						</div>
					</form>

					<div class="join-trust-footer">
						<p class="join-privacy-text">
							You can unsubscribe at any time. View our <a href="/privacy" class="privacy-link">Privacy Policy</a>.
						</p>
					</div>
				</div>
			</div>
		</main>
		<Footer />

		<style>
			.join-main-wrapper {
				max-width: 900px;
				margin: 1.5rem auto 4.5rem;
				padding: 0 1.5rem;
			}

			.join-disclaimer-container {
				margin-bottom: 0.5rem;
			}

			.join-clean-container {
				max-width: 680px;
				margin: 0 auto;
			}

			.join-form-card {
				background: #ffffff;
				border: 1px solid var(--card-border);
				border-radius: 28px;
				padding: 3.5rem 3rem;
				box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.08);
				text-align: center;
			}

			.join-title {
				font-size: clamp(2.1rem, 4.2vw, 2.75rem);
				font-weight: 800;
				color: #000000;
				letter-spacing: -1px;
				margin: 0 0 1rem;
				line-height: 1.15;
				text-wrap: balance;
			}

			.join-subtitle {
				font-size: 1.15rem;
				color: #475569;
				line-height: 1.6;
				margin: 0 auto 2.25rem;
				max-width: 580px; /* Generous width for exactly 2 lines */
				text-wrap: balance;
			}

			.join-direct-form {
				width: 100%;
				max-width: 500px;
				margin: 0 auto;
			}

			.input-group {
				display: flex;
				gap: 0.75rem;
				width: 100%;
			}

			.join-email-input {
				flex: 1;
				padding: 0.95rem 1.25rem;
				border-radius: 12px;
				border: 1.5px solid #cbd5e1;
				font-size: 1rem;
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
				font-family: inherit;
				color: #0f172a;
				background: #f8fafc;
			}

			.join-email-input:focus {
				border-color: #c8382c;
				box-shadow: 0 0 0 3px rgba(200, 56, 44, 0.15);
				background: #ffffff;
			}

			.join-submit-btn {
				padding: 0.95rem 2.25rem;
				font-size: 1rem;
				font-weight: 700;
				border-radius: 12px;
				white-space: nowrap;
				cursor: pointer;
			}

			.ml-embedded:not(:empty) + .join-direct-form {
				display: none;
			}

			.join-trust-footer {
				margin-top: 2rem;
				padding-top: 1.5rem;
				border-top: 1px solid #f1f5f9;
			}

			.join-privacy-text {
				font-size: 0.88rem;
				color: #64748b;
				margin: 0;
				line-height: 1.5;
			}

			.privacy-link {
				color: #c8382c;
				font-weight: 600;
				text-decoration: none; /* Removed double underline */
				border-bottom: 1px solid rgba(200, 56, 44, 0.4);
				transition: all 0.15s ease;
			}

			.privacy-link:hover {
				color: #991b1b;
				border-bottom-color: #991b1b;
			}

			@media (max-width: 640px) {
				.join-form-card {
					padding: 2.5rem 1.5rem;
				}

				.input-group {
					flex-direction: column;
				}

				.join-submit-btn {
					width: 100%;
				}
			}
		</style>
	</body>
</html>
