---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Option 13 Brand Evolution Lab | Decoding The Burn" 
			description="Deep exploration of Option 13: large matching text proportions, vertical lockups, underlines on Burn, and multi-background studies." 
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400;1,700&family=Outfit:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800;900&display=swap" rel="stylesheet">
	</head>
	<body class="logo-lab-body">
		<Header />

		<main class="logo-lab-container">
			<!-- Header / Hero Section -->
			<section class="lab-hero">
				<div class="lab-badge">Option 13 Evolution Lab</div>
				<h1 class="lab-title">Option 13: Large Text &amp; Layout Riffs</h1>
				<p class="lab-subtitle">
					Exploring massive text matching the 100px mark height, underline accents on <em>"Burn"</em>, vertical layouts, and tri-color background comparisons (Light, Deep Purple, and Pure&nbsp;Black).
				</p>

				<!-- Global Background Mode Switcher -->
				<div class="theme-switcher-bar">
					<span class="switcher-label">Global Theme:</span>
					<button type="button" class="theme-btn active" data-bg="bg-light">Light Site</button>
					<button type="button" class="theme-btn" data-bg="bg-purple">Deep Purple (#0b0518)</button>
					<button type="button" class="theme-btn" data-bg="bg-dark">Pure Black (#000000)</button>
				</div>
			</section>

			<!-- SECTION 1: MASSIVE HORIZONTAL SINGLE-LINE (TEXT MATCHING LOGO HEIGHT) -->
			<section class="riff-section">
				<div class="section-header">
					<h2 class="section-title">1. Massive Single-Line Lockups (Text as Big as Logo)</h2>
					<p class="section-desc">Testing text height scaled to 75%, 90%, 100%, and 115% of the 100px mark height for monumental brand&nbsp;impact.</p>
				</div>

				<div class="cards-stack">
					<!-- 13-A: Exact 100% Optical Height Match (3.8rem ~ 68px Cap-Height) -->
					<article class="variation-card">
						<span class="var-num">13-A • 100% Height Match</span>
						<div class="lockup-horizontal">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="100" height="100">
									<defs>
										<linearGradient id="m13a-purple" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#9333ea"/><stop offset="100%" stop-color="#3b0764"/></linearGradient>
										<linearGradient id="m13a-tongue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#fb7185"/><stop offset="60%" stop-color="#e11d48"/><stop offset="100%" stop-color="#9f1239"/></linearGradient>
									</defs>
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="url(#m13a-tongue)"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="url(#m13a-purple)"/>
								</svg>
							</div>
							<div class="wm-single size-100match">
								<span class="wm-text">Decoding The Burn</span>
							</div>
						</div>
					</article>

					<!-- 13-B: Monumental Giant Scale (4.5rem) -->
					<article class="variation-card">
						<span class="var-num">13-B • Giant Monumental (4.5rem)</span>
						<div class="lockup-horizontal">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="100" height="100">
									<defs>
										<linearGradient id="m13b-purple" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#9333ea"/><stop offset="100%" stop-color="#3b0764"/></linearGradient>
										<linearGradient id="m13b-tongue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#fb7185"/><stop offset="60%" stop-color="#e11d48"/><stop offset="100%" stop-color="#9f1239"/></linearGradient>
									</defs>
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="url(#m13b-tongue)"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="url(#m13b-purple)"/>
								</svg>
							</div>
							<div class="wm-single size-giant">
								<span class="wm-text">Decoding The Burn</span>
							</div>
						</div>
					</article>

					<!-- 13-C: Ultra-Heavy All-Caps Matching Mark (3.6rem) -->
					<article class="variation-card">
						<span class="var-num">13-C • All-Caps Block Power</span>
						<div class="lockup-horizontal">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="100" height="100">
									<defs>
										<linearGradient id="m13c-purple" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#9333ea"/><stop offset="100%" stop-color="#3b0764"/></linearGradient>
										<linearGradient id="m13c-tongue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#fb7185"/><stop offset="60%" stop-color="#e11d48"/><stop offset="100%" stop-color="#9f1239"/></linearGradient>
									</defs>
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="url(#m13c-tongue)"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="url(#m13c-purple)"/>
								</svg>
							</div>
							<div class="wm-single size-caps-match">
								<span class="wm-text">DECODING THE BURN</span>
							</div>
						</div>
					</article>
				</div>
			</section>

			<!-- SECTION 2: UNDERLINE & ACCENTS ON "BURN" -->
			<section class="riff-section">
				<div class="section-header">
					<h2 class="section-title">2. Underline &amp; Heat Accents on "Burn"</h2>
					<p class="section-desc">Comparing clean text versus bold red underbars, purple-to-red gradients, and cheeky curved smile underlines.</p>
				</div>

				<div class="cards-stack">
					<!-- U-1: Clean vs Gradient Underline -->
					<article class="variation-card">
						<span class="var-num">U-1 • Fire Gradient Underbar</span>
						<div class="lockup-horizontal">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="100" height="100">
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="#e11d48"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="#7c3aed"/>
								</svg>
							</div>
							<div class="wm-single size-100match">
								<span class="wm-lead">Decoding The</span>
								<span class="wm-burn-underlined gradient-bar">Burn</span>
							</div>
						</div>
					</article>

					<!-- U-2: Solid Ruby Red Underbar -->
					<article class="variation-card">
						<span class="var-num">U-2 • Solid Ruby Red Underbar</span>
						<div class="lockup-horizontal">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="100" height="100">
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="#e11d48"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="#7c3aed"/>
								</svg>
							</div>
							<div class="wm-single size-100match">
								<span class="wm-lead">Decoding The</span>
								<span class="wm-burn-underlined ruby-bar">Burn</span>
							</div>
						</div>
					</article>

					<!-- U-3: Cheeky Curved Smile Streak -->
					<article class="variation-card">
						<span class="var-num">U-3 • Curved Smile Streak Under "The Burn"</span>
						<div class="lockup-horizontal">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="100" height="100">
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="#e11d48"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="#7c3aed"/>
								</svg>
							</div>
							<div class="wm-single size-100match">
								<span class="wm-lead">Decoding</span>
								<span class="wm-burn-curved">
									<span>The Burn</span>
									<svg class="smile-curve" viewBox="0 0 120 16" width="100%" height="10">
										<path d="M 2,4 Q 60,18 118,4" stroke="#e11d48" stroke-width="4.5" stroke-linecap="round" fill="none"/>
									</svg>
								</span>
							</div>
						</div>
					</article>

					<!-- U-4: Word "Burn" in Ruby Red (Zero Underline, Pure Contrast) -->
					<article class="variation-card">
						<span class="var-num">U-4 • Word Color Shift (Clean)</span>
						<div class="lockup-horizontal">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="100" height="100">
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="#e11d48"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="#7c3aed"/>
								</svg>
							</div>
							<div class="wm-single size-100match">
								<span class="wm-lead">Decoding The</span>
								<span class="wm-burn-color">Burn</span>
							</div>
						</div>
					</article>
				</div>
			</section>

			<!-- SECTION 3: EXACT 100PX HEIGHT MATCH (2-LINE COMPACT STACK) -->
			<section class="riff-section">
				<div class="section-header">
					<h2 class="section-title">3. Exact 100px Height Lockups (Stacked 2-Line)</h2>
					<p class="section-desc">Where the stacked 2-line text block matches the exact total 100px square frame of the cheeky tongue icon.</p>
				</div>

				<div class="cards-stack">
					<!-- S-1: 100px Proportional Stack (Decoding 32px / The Burn 56px) -->
					<article class="variation-card">
						<span class="var-num">S-1 • Optical 100px Box Match</span>
						<div class="lockup-horizontal">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="100" height="100">
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="#e11d48"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="#7c3aed"/>
								</svg>
							</div>
							<div class="wordmark-box stack-100match">
								<div class="wm-line s1-decoding">DECODING</div>
								<div class="wm-line s1-burn">THE BURN</div>
							</div>
						</div>
					</article>

					<!-- S-2: Clean Title Case 100px Stack -->
					<article class="variation-card">
						<span class="var-num">S-2 • Title Case 100px Lockup</span>
						<div class="lockup-horizontal">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="100" height="100">
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="#e11d48"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="#7c3aed"/>
								</svg>
							</div>
							<div class="wordmark-box stack-title-100">
								<div class="wm-line s2-decoding">Decoding</div>
								<div class="wm-line s2-burn">The Burn</div>
							</div>
						</div>
					</article>
				</div>
			</section>

			<!-- SECTION 4: VERTICAL / CENTERED LOCKUPS (YOUTUBE, APP SPLASH, MERCH) -->
			<section class="riff-section">
				<div class="section-header">
					<h2 class="section-title">4. Vertical Centered Lockups (YouTube &amp; Social Avatars)</h2>
					<p class="section-desc">Centered vertical formats tailored for YouTube end-cards, podcast splash screens, apparel, and profile&nbsp;headers.</p>
				</div>

				<div class="cards-grid-2">
					<!-- V-1: Vertical Single Line Underneath -->
					<article class="variation-card vertical-card">
						<span class="var-num">V-1 • Vertical Single-Line</span>
						<div class="lockup-vertical">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="110" height="110">
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="#e11d48"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="#7c3aed"/>
								</svg>
							</div>
							<div class="wm-single v-text-single">
								<span class="wm-text">Decoding The Burn</span>
							</div>
						</div>
					</article>

					<!-- V-2: Vertical 2-Line Stack Centered -->
					<article class="variation-card vertical-card">
						<span class="var-num">V-2 • Vertical 2-Line Stack</span>
						<div class="lockup-vertical">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="110" height="110">
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="#e11d48"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="#7c3aed"/>
								</svg>
							</div>
							<div class="wordmark-box v-text-stack">
								<div class="wm-line v-decoding">DECODING</div>
								<div class="wm-line v-burn">THE BURN</div>
							</div>
						</div>
					</article>
				</div>
			</section>

			<!-- SECTION 5: TRI-COLOR BACKGROUND COMPARISON MATRIX -->
			<section class="riff-section">
				<div class="section-header">
					<h2 class="section-title">5. Side-by-Side Background Comparison Matrix</h2>
					<p class="section-desc">Comparing Option 13 locked in across Light, Deep Purple (#0b0518), and Pure Black (#000000) simultaneously.</p>
				</div>

				<div class="matrix-tri-stack">
					<!-- Light Background -->
					<div class="tri-card bg-light-fixed">
						<div class="tri-meta">
							<span class="tri-label">1. Clean Light Background (#ffffff)</span>
							<span class="tri-code">Clinical &amp; Crisp</span>
						</div>
						<div class="lockup-horizontal">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="88" height="88">
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="#e11d48"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="#7c3aed"/>
								</svg>
							</div>
							<div class="wm-single size-100match">
								<span class="wm-text text-dark-mode-invert">Decoding The Burn</span>
							</div>
						</div>
					</div>

					<!-- Deep Purple Background (#0b0518) -->
					<div class="tri-card bg-purple-fixed">
						<div class="tri-meta">
							<span class="tri-label text-purple-200">2. Deep Purple Background (#0b0518)</span>
							<span class="tri-code text-purple-300">Signature Brand Theme</span>
						</div>
						<div class="lockup-horizontal">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="88" height="88">
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#05020c"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="#fb7185"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="#c084fc"/>
								</svg>
							</div>
							<div class="wm-single size-100match">
								<span class="wm-text text-white">Decoding The Burn</span>
							</div>
						</div>
					</div>

					<!-- Pure Black Background (#000000) -->
					<div class="tri-card bg-black-fixed">
						<div class="tri-meta">
							<span class="tri-label text-slate-200">3. Pure Obsidian Black (#000000)</span>
							<span class="tri-code text-slate-400">High Contrast AMOLED</span>
						</div>
						<div class="lockup-horizontal">
							<div class="mark-wrapper">
								<svg viewBox="0 0 100 100" width="88" height="88">
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#140b2a"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="#e11d48"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="#9333ea"/>
								</svg>
							</div>
							<div class="wm-single size-100match">
								<span class="wm-text text-white">Decoding The Burn</span>
							</div>
