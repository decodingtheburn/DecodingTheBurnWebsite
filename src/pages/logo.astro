---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Core Master Logo Studio | Decoding The Burn" 
			description="Master lockups featuring the royal purple and ruby red tongue mark with glued typography across light, deep purple, and pure black canvases." 
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400;1,700&family=Outfit:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800;900&display=swap" rel="stylesheet">
	</head>
	<body class="logo-lab-body">
		<Header />

		<main class="logo-lab-container">
			<!-- Header / Hero Section -->
			<section class="lab-hero">
				<h1 class="lab-title">Core Master Logo Studio</h1>
				<p class="lab-subtitle">
					Refined master lockups: glued typography ("DECODING" tight over "THE BURN"), ruby red accent, and seamless brand lockups across Light, Deep Purple, and Pure Black&nbsp;backgrounds.
				</p>
			</section>

			<!-- SECTION 1: MASTER HORIZONTAL LOCKUPS (H-03 SUITE ACROSS THEMES) -->
			<section class="section-divider">
				<h2 class="section-heading">Master Horizontal Lockups (Glued Typography)</h2>
				<p class="section-desc">Mark on the left, "DECODING" and "THE BURN" glued together with zero gap, shown on Light, Deep Purple, and Pure Black canvases.</p>
			</section>

			<section class="variations-stack">

				<!-- H-03 Light -->
				<article class="variation-card bg-light-card highlight-master">
					<span class="var-num-light">H-03 • Light Canvas</span>
					<div class="lockup-horizontal tight-gap">
						<div class="mark-box">
							<svg viewBox="12 24 76 66" width="92" height="80">
								<defs>
									<linearGradient id="hl-purple" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#9333ea"/><stop offset="100%" stop-color="#3b0764"/></linearGradient>
									<linearGradient id="hl-tongue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#fb7185"/><stop offset="60%" stop-color="#e11d48"/><stop offset="100%" stop-color="#9f1239"/></linearGradient>
								</defs>
								<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
								<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
								<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="url(#hl-tongue)"/>
								<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
								<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="url(#hl-purple)"/>
							</svg>
						</div>
						<div class="text-block text-glued-box" style="height: 80px;">
							<div class="txt-sub-darker">DECODING</div>
							<div class="txt-main-ruby">THE BURN</div>
						</div>
					</div>
				</article>

				<!-- H-03 Deep Purple -->
				<article class="variation-card bg-purple-card">
					<span class="var-num-purple">H-03 • Deep Purple Canvas (#0B0518)</span>
					<div class="lockup-horizontal tight-gap">
						<div class="mark-box">
							<svg viewBox="12 24 76 66" width="92" height="80">
								<defs>
									<linearGradient id="hp-purple" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#9333ea"/><stop offset="100%" stop-color="#3b0764"/></linearGradient>
									<linearGradient id="hp-tongue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#fb7185"/><stop offset="60%" stop-color="#e11d48"/><stop offset="100%" stop-color="#9f1239"/></linearGradient>
								</defs>
								<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
								<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
								<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="url(#hp-tongue)"/>
								<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
								<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="url(#hp-purple)"/>
							</svg>
						</div>
						<div class="text-block text-glued-box" style="height: 80px;">
							<div class="txt-sub-purple">DECODING</div>
							<div class="txt-main-ruby">THE BURN</div>
						</div>
					</div>
				</article>

				<!-- H-03 Pure Black -->
				<article class="variation-card bg-black-card">
					<span class="var-num-dark">H-03 • Pure Black Canvas (#000000)</span>
					<div class="lockup-horizontal tight-gap">
						<div class="mark-box">
							<svg viewBox="12 24 76 66" width="92" height="80">
								<defs>
									<linearGradient id="hb-purple" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#9333ea"/><stop offset="100%" stop-color="#3b0764"/></linearGradient>
									<linearGradient id="hb-tongue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#fb7185"/><stop offset="60%" stop-color="#e11d48"/><stop offset="100%" stop-color="#9f1239"/></linearGradient>
								</defs>
								<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
								<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
								<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="url(#hb-tongue)"/>
								<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
								<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="url(#hb-purple)"/>
							</svg>
						</div>
						<div class="text-block text-glued-box" style="height: 80px;">
							<div class="txt-sub-white">DECODING</div>
							<div class="txt-main-ruby">THE BURN</div>
						</div>
					</div>
				</article>

			</section>

			<!-- SECTION 2: VERTICAL LOCKUPS (CENTERED STACK) -->
			<section class="section-divider">
				<h2 class="section-heading">Master Vertical Lockups (Stacked on Top)</h2>
				<p class="section-desc">Mark positioned directly above centered typography, tested side-by-side across Light, Deep Purple, and Pure Black backgrounds.</p>
			</section>

			<div class="vertical-grid">

				<!-- V-01: Light Background -->
				<article class="vertical-card bg-light-card">
					<span class="var-num-light">Vertical • Light Theme</span>
					<div class="lockup-vertical">
						<div class="mark-box">
							<svg viewBox="12 24 76 66" width="105" height="91">
								<defs>
									<linearGradient id="vl-purple" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#9333ea"/><stop offset="100%" stop-color="#3b0764"/></linearGradient>
									<linearGradient id="vl-tongue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#fb7185"/><stop offset="60%" stop-color="#e11d48"/><stop offset="100%" stop-color="#9f1239"/></linearGradient>
								</defs>
								<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
								<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
								<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="url(#vl-tongue)"/>
								<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
								<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="url(#vl-purple)"/>
							</svg>
						</div>
						<div class="text-block-center text-glued-vert">
							<div class="txt-sub-vert text-darker">DECODING</div>
							<div class="txt-main-vert text-ruby">THE BURN</div>
						</div>
					</div>
				</article>

				<!-- V-02: Deep Purple Background (#0B0518) -->
				<article class="vertical-card bg-purple-card">
					<span class="var-num-purple">Vertical • Deep Purple (#0B0518)</span>
					<div class="lockup-vertical">
						<div class="mark-box">
							<svg viewBox="12 24 76 66" width="105" height="91">
								<defs>
									<linearGradient id="vp-purple" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#9333ea"/><stop offset="100%" stop-color="#3b0764"/></linearGradient>
									<linearGradient id="vp-tongue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#fb7185"/><stop offset="60%" stop-color="#e11d48"/><stop offset="100%" stop-color="#9f1239"/></linearGradient>
								</defs>
								<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
								<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
								<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="url(#vp-tongue)"/>
								<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
								<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="url(#vp-purple)"/>
							</svg>
						</div>
						<div class="text-block-center text-glued-vert">
							<div class="txt-sub-vert text-purple-light">DECODING</div>
							<div class="txt-main-vert text-ruby">THE BURN</div>
						</div>
					</div>
				</article>

				<!-- V-03: Pure Black Background (#000000) -->
				<article class="vertical-card bg-black-card">
					<span class="var-num-dark">Vertical • Pure Black (#000000)</span>
					<div class="lockup-vertical">
						<div class="mark-box">
							<svg viewBox="12 24 76 66" width="105" height="91">
								<defs>
									<linearGradient id="vb-purple" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#9333ea"/><stop offset="100%" stop-color="#3b0764"/></linearGradient>
									<linearGradient id="vb-tongue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#fb7185"/><stop offset="60%" stop-color="#e11d48"/><stop offset="100%" stop-color="#9f1239"/></linearGradient>
								</defs>
								<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
								<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
								<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="url(#vb-tongue)"/>
								<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
								<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="url(#vb-purple)"/>
							</svg>
						</div>
						<div class="text-block-center text-glued-vert">
							<div class="txt-sub-vert text-white">DECODING</div>
							<div class="txt-main-vert text-ruby">THE BURN</div>
						</div>
					</div>
				</article>

			</div>

		</main>

		<Footer />

		<style>
			:root {
				--font-heading: 'Figtree', system-ui, -apple-system, sans-serif;
				--font-body: 'Figtree', system-ui, -apple-system, sans-serif;
			}

			.logo-lab-body {
				background-color: #f8fafc;
				color: #0f172a;
				font-family: var(--font-body);
				min-height: 100vh;
			}

			.logo-lab-container {
				max-width: 1060px;
				margin: 0 auto;
				padding: 3rem 1.5rem 6rem;
			}

			/* Hero Header */
			.lab-hero {
				text-align: center;
				margin-bottom: 3.5rem;
				padding-top: 1.5rem;
			}

			.lab-title {
				font-size: 2.75rem;
				font-weight: 900;
				letter-spacing: -0.04em;
				color: #0f172a;
				margin-bottom: 0.75rem;
				text-wrap: balance;
			}

			.lab-subtitle {
				font-size: 1.15rem;
				color: #475569;
				max-width: 720px;
				margin: 0 auto;
				line-height: 1.6;
				text-wrap: balance;
			}

			/* Section Dividers */
			.section-divider {
				margin: 3.5rem 0 1.75rem;
				border-bottom: 1.5px solid #e2e8f0;
				padding-bottom: 1rem;
			}

			.section-heading {
				font-size: 1.5rem;
				font-weight: 900;
				color: #0f172a;
				letter-spacing: -0.03em;
				margin-bottom: 0.25rem;
			}

			.section-desc {
				font-size: 0.95rem;
				color: #64748b;
				margin: 0;
			}

			/* Variations Stack */
			.variations-stack {
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}

			.variation-card {
				border-radius: 20px;
				padding: 3.25rem 2.5rem;
				position: relative;
				box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
				transition: all 0.2s ease;
				display: flex;
				align-items: center;
				justify-content: flex-start;
			}

			.highlight-master {
				border: 2px solid #7c3aed;
				background: linear-gradient(135deg, #faf5ff 0%, #ffffff 100%);
				box-shadow: 0 8px 30px rgba(124, 58, 237, 0.12);
			}

			/* Badges */
			.var-num-light {
				position: absolute;
				top: 1.25rem;
				right: 1.25rem;
				font-size: 0.8rem;
				font-weight: 800;
				color: #475569;
				background: #f1f5f9;
				border: 1px solid #e2e8f0;
				padding: 0.2rem 0.65rem;
				border-radius: 6px;
			}

			.var-num-purple {
				position: absolute;
				top: 1.25rem;
				right: 1.25rem;
				font-size: 0.8rem;
				font-weight: 800;
				color: #e9d5ff;
				background: #190933;
				border: 1px solid #4c1d95;
				padding: 0.2rem 0.65rem;
				border-radius: 6px;
			}

			.var-num-dark {
				position: absolute;
				top: 1.25rem;
				right: 1.25rem;
				font-size: 0.8rem;
				font-weight: 800;
				color: #cbd5e1;
				background: #0f172a;
				border: 1px solid #334155;
				padding: 0.2rem 0.65rem;
				border-radius: 6px;
			}

			/* Lockup Layouts */
			.lockup-horizontal {
				display: flex;
				align-items: center;
				width: 100%;
			}

			.tight-gap {
				gap: 0.85rem;
			}

			.mark-box {
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
			}

			/* GLUED TEXT BLOCK */
			.text-glued-box {
				display: flex;
				flex-direction: column;
				justify-content: center; /* GLUED TIGHTLY TOGETHER */
				align-items: flex-start;
				gap: 0px; /* ZERO GAP */
				text-align: left;
				line-height: 1;
			}

			.txt-sub-darker,
			.txt-sub-purple,
			.txt-sub-white,
			.txt-main-ruby,
			.txt-sub-vert,
			.txt-main-vert {
				display: block;
				font-family: 'Figtree', -apple-system, BlinkMacSystemFont, sans-serif;
			}

			/* Typography Specs */
			.txt-sub-darker {
				font-size: 1.45rem;
				font-weight: 850;
				letter-spacing: 0.12em;
				color: #0f172a;
				line-height: 1;
				margin-bottom: 0px;
			}

			.txt-sub-purple {
				font-size: 1.45rem;
				font-weight: 850;
				letter-spacing: 0.12em;
				color: #c084fc;
				line-height: 1;
				margin-bottom: 0px;
			}

			.txt-sub-white {
				font-size: 1.45rem;
				font-weight: 850;
				letter-spacing: 0.12em;
				color: #ffffff;
				line-height: 1;
				margin-bottom: 0px;
			}

			.txt-main-ruby {
				font-size: 3.15rem;
				font-weight: 900;
				letter-spacing: -0.045em;
				color: #e11d48;
				line-height: 0.85; /* GLUED TO TOP LINE */
				margin-top: -2px;
			}

			/* Vertical Grid */
			.vertical-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
			}

			.vertical-card {
				border-radius: 20px;
				padding: 3.5rem 1.5rem 2.5rem;
				position: relative;
				box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
			}

			.bg-light-card {
				background: #ffffff;
				border: 1.5px solid #e2e8f0;
			}

			.bg-purple-card {
				background: #0b0518;
				border: 1.5px solid #3b0764;
			}

			.bg-black-card {
				background: #000000;
				border: 1.5px solid #1e293b;
			}

			.lockup-vertical {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1.25rem;
			}

			.text-glued-vert {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				gap: 0px;
				line-height: 1;
			}

			.txt-sub-vert {
				font-size: 1.2rem;
				font-weight: 850;
				letter-spacing: 0.14em;
				line-height: 1;
				margin-bottom: 0px;
			}

			.txt-main-vert {
				font-size: 2.55rem;
				font-weight: 900;
				letter-spacing: -0.04em;
				line-height: 0.88;
				margin-top: -2px;
			}

			/* Palette Colors */
			.text-darker { color: #0f172a; }
			.text-ruby { color: #e11d48; }
			.text-purple-light { color: #c084fc; }
			.text-white { color: #ffffff; }

			@media (max-width: 900px) {
				.vertical-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 768px) {
				.lockup-horizontal {
					flex-direction: column;
					align-items: flex-start;
					gap: 1rem;
				}
				.variation-card {
					padding: 2.5rem 1.5rem;
				}
				.lab-title {
					font-size: 2.2rem;
				}
			}
		</style>
	</body>
</html>
