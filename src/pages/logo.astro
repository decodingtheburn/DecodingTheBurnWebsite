		<script>
			// Background Theme Switcher Script
			const themeBtns = document.querySelectorAll('.theme-btn');
			const cards = document.querySelectorAll('.variation-card');
			
			themeBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					themeBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					
					const targetBg = btn.getAttribute('data-bg');
					cards.forEach(card => {
						card.classList.remove('bg-light', 'bg-purple', 'bg-dark');
						if (targetBg !== 'bg-light') {
							card.classList.add(targetBg);
						}
					});
				});
			});
