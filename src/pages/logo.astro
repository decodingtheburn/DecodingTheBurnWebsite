---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="40 Horizontal Pyramid Variations | Decoding The Burn" 
			description="40 horizontal variations of the V2-C Pyramid Lockup: DECODING smaller with tightened tracking on top, THE BURN bold and wide beneath." 
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400;1,700&display=swap" rel="stylesheet">
	</head>
	<body class="logo-lab-body">
		<Header />

		<main class="logo-lab-container">
			<!-- Header / Hero Section -->
			<section class="lab-hero">
				<div class="lab-badge">Pyramid Lockup Studio • 40 Variations</div>
				<h1 class="lab-title">Horizontal Pyramid Studio</h1>
				<p class="lab-subtitle">
					Refining the <strong>V2-C Pyramid Structure</strong>: all-caps typography with <strong>DECODING</strong> taking less space (tightened tracking) resting above a dominant, solid <strong>THE&nbsp;BURN</strong>.
				</p>

				<!-- Global Background Mode Switcher -->
				<div class="theme-switcher-bar">
					<span class="switcher-label">Global Theme:</span>
					<button type="button" class="theme-btn active" data-bg="bg-light">Light Site</button>
					<button type="button" class="theme-btn" data-bg="bg-purple">Deep Purple (#0b0518)</button>
					<button type="button" class="theme-btn" data-bg="bg-dark">Pure Black (#000000)</button>
				</div>
			</section>

			<!-- SPOTLIGHT CARD: THE REFINED V2-C PYRAMID (VERTICAL BASELINE) -->
			<section class="spotlight-pyramid">
				<div class="spotlight-card">
					<span class="spotlight-tag">⭐ Core Master Lockup (Refined V2-C)</span>
					<div class="spotlight-lockup">
						<div class="v-mark">
							<svg viewBox="0 0 100 100" width="105" height="105">
								<defs>
									<linearGradient id="sp-purple" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#9333ea"/><stop offset="100%" stop-color="#3b0764"/></linearGradient>
									<linearGradient id="sp-tongue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#fb7185"/><stop offset="60%" stop-color="#e11d48"/><stop offset="100%" stop-color="#9f1239"/></linearGradient>
								</defs>
								<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
								<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
								<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="url(#sp-tongue)"/>
								<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
								<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="url(#sp-purple)"/>
							</svg>
						</div>
						<div class="pyramid-text-v">
							<div class="p-decoding-v">DECODING</div>
							<div class="p-burn-v">THE BURN</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 40 HORIZONTAL VARIATIONS STACKED WITH GENEROUS PADDING -->
			<section class="variations-stack" id="variations-stack">
				<div class="stack-intro">
					<h2 class="stack-title">40 Horizontal Lockup Proportions</h2>
					<p class="stack-desc">Logo on the left, horizontal pyramid text on the right. Testing scale ratios, tracking, line gaps, and optical heights.</p>
				</div>

				<!-- GROUP 1: CANONICAL PYRAMID SCALE (01 - 08) -->
				<!-- 01: Canonical Standard (Decoding 1.15rem / The Burn 2.35rem) -->
				<article class="variation-card">
					<span class="var-num">01</span>
					<div class="lockup-h">
						<div class="h-mark"><svg viewBox="0 0 100 100" width="90" height="90"><use href="#global-mark"/></svg></div>
						<div class="h-pyramid text-h01"><div class="h-decoding">DECODING</div><div class="h-burn">THE BURN</div></div>
					</div>
				</article>

				<!-- 02: Tighter Top (Decoding 0.95rem tracking 0.12em / The Burn 2.45rem) -->
				<article class="variation-card">
					<span class="var-num">02</span>
