---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Brand Logo Exploration Lab | Decoding The Burn" 
			description="10 modern, simplified logo concepts for Decoding The Burn featuring open mouth, flame, purple, and minimal icons." 
		/>
	</head>
	<body class="logo-lab-body">
		<Header />

		<main class="logo-lab-container">
			<!-- Header / Coaching Intro Banner -->
			<section class="lab-hero">
				<div class="lab-badge">Cheeky Tongue &amp; Flame Lab • 10 Concepts</div>
				<h1 class="lab-title">Decoding The&nbsp;Burn</h1>
				<p class="lab-subtitle">
					Memorable, visual, and cheeky brand marks: exploring stylized tongues sticking out with flame crests and pure iconic tongue silhouettes across light, dark, and header&nbsp;contexts.
				</p>

				<!-- Global Background Mode Switcher -->
				<div class="theme-switcher-bar">
					<span class="switcher-label">Test Background:</span>
					<button type="button" class="theme-btn active" data-bg="bg-light">Light (Current Site)</button>
					<button type="button" class="theme-btn" data-bg="bg-purple">Deep Purple (#0b0518)</button>
					<button type="button" class="theme-btn" data-bg="bg-dark">Charcoal (#0f172a)</button>
				</div>
			</section>

			<!-- SPOTLIGHT: OPTION 3 CLEAN (PURPLE LIPS + RED TONGUE, NO FLAME) -->
			<section class="spotlight-section">
				<div class="spotlight-card">
					<div class="spotlight-badge">⭐ Spotlight Contender: Option 3 (No Flame)</div>
					<h2 class="spotlight-title">Royal Purple Lips + Ruby Red Cheeky Tongue</h2>
					<p class="spotlight-desc">
						Your intuition is 100% correct: <strong>Royal Purple</strong> provides the forensic, clinical authority of <em>"Decoding"</em>, while the <strong>Ruby Red</strong> tongue represents the organic heat of <em>"The Burn"</em>. Removing the flame makes it instantly iconic, timeless, and unbeatable on YouTube.
					</p>

					<div class="spotlight-demos">
						<!-- 1. Large Display -->
						<div class="spotlight-demo-card">
							<span class="demo-tag">Display Mark (100px)</span>
							<div class="spotlight-logo-box">
								<svg viewBox="0 0 100 100" width="88" height="88">
									<defs>
										<linearGradient id="spot-purple" x1="0" y1="0" x2="1" y2="1">
											<stop offset="0%" stop-color="#9333ea"/>
											<stop offset="100%" stop-color="#3b0764"/>
										</linearGradient>
										<linearGradient id="spot-tongue" x1="0" y1="0" x2="0" y2="1">
											<stop offset="0%" stop-color="#fb7185"/>
											<stop offset="60%" stop-color="#e11d48"/>
											<stop offset="100%" stop-color="#9f1239"/>
										</linearGradient>
									</defs>
									<!-- Dark Mouth Cavity -->
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<!-- White Teeth Arc -->
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<!-- Ruby Red Tongue Out -->
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="url(#spot-tongue)"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
									<!-- Royal Purple Upper Lip -->
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="url(#spot-purple)"/>
								</svg>
							</div>
						</div>

						<!-- 2. Header Lockup -->
						<div class="spotlight-demo-card">
							<span class="demo-tag">Header Lockup</span>
							<div class="spotlight-header-demo">
								<svg viewBox="0 0 100 100" width="44" height="44">
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="#e11d48"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="3" stroke-linecap="round"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="#7c3aed"/>
								</svg>
								<div class="lockup-text">
									<span class="lockup-decoding">Decoding</span>
									<span class="lockup-burn lockup-burn-red">The Burn</span>
								</div>
							</div>
						</div>

						<!-- 3. YouTube Avatar Simulator -->
						<div class="spotlight-demo-card">
							<span class="demo-tag">YouTube Avatar Simulator</span>
							<div class="yt-avatar-circle">
								<svg viewBox="0 0 100 100" width="56" height="56">
									<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
									<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
									<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="#e11d48"/>
									<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="3" stroke-linecap="round"/>
									<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="#9333ea"/>
								</svg>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 10 Logo Concepts Grid -->
			<section class="concepts-grid" id="concepts-grid">

				<!-- CONCEPT 1 -->
				<article class="concept-card highlight-card">
					<div class="card-header">
						<span class="concept-num">Option 1</span>
						<span class="concept-tag tag-red">Classic Cheeky</span>
					</div>
					<h3 class="concept-title">Classic Cheeky Tongue &amp; Flame Crest</h3>
					<p class="concept-desc">
						Open smiling mouth with a bold, rounded tongue sticking out downward, topped with an energetic 3-pronged burning flame resting on the tongue. Instantly recognizable and fun.
					</p>

					<div class="logo-preview-box">
						<!-- SVG 1 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<defs>
								<linearGradient id="t1-tongue" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0%" stop-color="#fb7185"/>
									<stop offset="60%" stop-color="#e11d48"/>
									<stop offset="100%" stop-color="#9f1239"/>
								</linearGradient>
								<linearGradient id="t1-flame" x1="0" y1="1" x2="0" y2="0">
									<stop offset="0%" stop-color="#dc2626"/>
									<stop offset="60%" stop-color="#f97316"/>
									<stop offset="100%" stop-color="#fbbf24"/>
								</linearGradient>
							</defs>
							<!-- Dark Oral Cavity -->
							<path d="M 18,46 C 18,34 32,32 50,32 C 68,32 82,34 82,46 C 82,60 68,64 50,64 C 32,64 18,60 18,46 Z" fill="#0f172a"/>
							<!-- Upper Teeth Row -->
							<path d="M 32,38 C 40,36 60,36 68,38 L 66,44 C 58,43 42,43 34,44 Z" fill="#ffffff"/>
							<!-- Tongue Sticking Out Downward -->
							<path d="M 28,48 C 28,72 34,88 50,88 C 66,88 72,72 72,48 Z" fill="url(#t1-tongue)"/>
							<!-- Center Groove Line on Tongue -->
							<line x1="50" y1="52" x2="50" y2="76" stroke="#fda4af" stroke-width="2" stroke-linecap="round"/>
							<!-- Upper Lips Contour -->
							<path d="M 14,46 C 26,34 40,32 50,36 C 60,32 74,34 86,46 C 76,52 64,52 50,52 C 36,52 24,52 14,46 Z" fill="#334155"/>
							<!-- Flame on Top of Tongue -->
							<path d="M 50,8 C 55,20 62,26 62,36 C 62,44 56,48 50,48 C 44,48 38,44 38,36 C 38,26 45,20 50,8 Z" fill="url(#t1-flame)"/>
							<!-- Inner Flame Core -->
							<path d="M 50,22 C 53,28 56,32 56,38 C 56,42 53,44 50,44 C 47,44 44,42 44,38 C 44,32 47,28 50,22 Z" fill="#ffffff" opacity="0.9"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<path d="M 18,46 C 18,34 32,32 50,32 C 68,32 82,34 82,46 C 82,60 68,64 50,64 C 32,64 18,60 18,46 Z" fill="#0f172a"/>
								<path d="M 28,48 C 28,72 34,88 50,88 C 66,88 72,72 72,48 Z" fill="#e11d48"/>
								<line x1="50" y1="52" x2="50" y2="76" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
								<path d="M 14,46 C 26,34 40,32 50,36 C 60,32 74,34 86,46 C 76,52 64,52 50,52 C 36,52 24,52 14,46 Z" fill="#334155"/>
								<path d="M 50,10 C 55,20 62,26 62,36 C 62,44 56,48 50,48 C 44,48 38,44 38,36 C 38,26 45,20 50,10 Z" fill="#f97316"/>
							</svg>
							<div class="lockup-text">
								<span class="lockup-decoding">Decoding</span>
								<span class="lockup-burn lockup-burn-red">The Burn</span>
							</div>
						</div>
					</div>
				</article>

				<!-- CONCEPT 2 -->
				<article class="concept-card">
					<div class="card-header">
						<span class="concept-num">Option 2</span>
						<span class="concept-tag tag-blue">Minimal Line Art</span>
					</div>
					<h3 class="concept-title">Minimalist Outline Tongue &amp; Flame</h3>
					<p class="concept-desc">
						Apple-grade continuous line art: a sleek curved mouth contour where a clean stylized tongue extends outward, carrying a delicate single flame dancing on top.
					</p>

					<div class="logo-preview-box">
						<!-- SVG 2 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<!-- Clean Line Mouth -->
							<path d="M 16,48 C 28,40 40,38 50,40 C 60,38 72,40 84,48" fill="none" stroke="#0f172a" stroke-width="4.5" stroke-linecap="round"/>
							<!-- Sticking Out Tongue Outline -->
							<path d="M 32,46 C 32,68 36,84 50,84 C 64,84 68,68 68,46" fill="#fee2e2" stroke="#e11d48" stroke-width="4" stroke-linejoin="round"/>
							<line x1="50" y1="52" x2="50" y2="72" stroke="#e11d48" stroke-width="3" stroke-linecap="round"/>
							<!-- Floating Flame on Top -->
							<path d="M 50,12 C 54,22 62,28 62,36 C 62,42 56,46 50,46 C 44,46 38,42 38,36 C 38,28 46,22 50,12 Z" fill="#ef4444"/>
							<circle cx="50" cy="36" r="4" fill="#fbbf24"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<path d="M 16,48 C 28,40 40,38 50,40 C 60,38 72,40 84,48" fill="none" stroke="#0f172a" stroke-width="5" stroke-linecap="round"/>
								<path d="M 32,46 C 32,68 36,84 50,84 C 64,84 68,68 68,46" fill="#fecdd3" stroke="#e11d48" stroke-width="4"/>
								<path d="M 50,14 C 54,22 60,28 60,36 C 60,42 55,46 50,46 C 45,46 40,42 40,36 C 40,28 46,22 50,14 Z" fill="#ef4444"/>
							</svg>
							<div class="lockup-text">
								<span class="lockup-decoding">Decoding</span>
								<span class="lockup-burn lockup-burn-red">The Burn</span>
							</div>
						</div>
					</div>
				</article>

				<!-- CONCEPT 3 -->
				<article class="concept-card highlight-card">
					<div class="card-header">
						<span class="concept-num">Option 3</span>
						<span class="concept-tag tag-purple">Purple + Fire Synergy</span>
					</div>
					<h3 class="concept-title">Royal Purple Lips &amp; Burning Tongue</h3>
					<p class="concept-desc">
						Deep imperial purple lips parted in a cheeky expression, sticking out a vibrant fire-red tongue with a burning golden ember resting on top. Perfect brand match.
					</p>

					<div class="logo-preview-box">
						<!-- SVG 3 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<defs>
								<linearGradient id="t3-purple" x1="0" y1="0" x2="1" y2="1">
									<stop offset="0%" stop-color="#7c3aed"/>
									<stop offset="100%" stop-color="#3b0764"/>
								</linearGradient>
								<linearGradient id="t3-tongue" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0%" stop-color="#f43f5e"/>
									<stop offset="100%" stop-color="#be123c"/>
								</linearGradient>
								<linearGradient id="t3-flame" x1="0" y1="1" x2="0" y2="0">
									<stop offset="0%" stop-color="#e11d48"/>
									<stop offset="50%" stop-color="#f97316"/>
									<stop offset="100%" stop-color="#fde047"/>
								</linearGradient>
							</defs>
							<!-- Dark Cavity -->
							<ellipse cx="50" cy="46" rx="30" ry="14" fill="#1e1b4b"/>
							<!-- Red Tongue Dropping Down -->
							<path d="M 30,46 C 30,70 36,86 50,86 C 64,86 70,70 70,46 Z" fill="url(#t3-tongue)"/>
							<line x1="50" y1="50" x2="50" y2="74" stroke="#fda4af" stroke-width="2" stroke-linecap="round"/>
							<!-- Purple Upper Lip -->
							<path d="M 14,46 C 26,32 40,30 50,34 C 60,30 74,32 86,46 C 74,52 62,52 50,52 C 38,52 26,52 14,46 Z" fill="url(#t3-purple)"/>
							<!-- Flame on Top of Tongue -->
							<path d="M 50,10 C 56,22 64,28 64,38 C 64,46 58,50 50,50 C 42,50 36,46 36,38 C 36,28 44,22 50,10 Z" fill="url(#t3-flame)"/>
							<circle cx="50" cy="38" r="4.5" fill="#ffffff" opacity="0.9"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<ellipse cx="50" cy="46" rx="30" ry="14" fill="#1e1b4b"/>
								<path d="M 30,46 C 30,70 36,86 50,86 C 64,86 70,70 70,46 Z" fill="#e11d48"/>
								<path d="M 14,46 C 26,32 40,30 50,34 C 60,30 74,32 86,46 C 74,52 62,52 50,52 C 38,52 26,52 14,46 Z" fill="#6d28d9"/>
								<path d="M 50,12 C 55,22 62,28 62,38 C 62,46 56,50 50,50 C 44,50 38,46 38,38 C 38,28 45,22 50,12 Z" fill="#fbbf24"/>
							</svg>
							<div class="lockup-text">
								<span class="lockup-decoding">Decoding</span>
								<span class="lockup-burn lockup-burn-purple">The Burn</span>
							</div>
						</div>
					</div>
				</article>

				<!-- CONCEPT 4 -->
				<article class="concept-card">
					<div class="card-header">
						<span class="concept-num">Option 4</span>
						<span class="concept-tag tag-amber">Flame-Tongue Hybrid</span>
					</div>
					<h3 class="concept-title">The Flame-Shaped Tongue</h3>
					<p class="concept-desc">
						Visual pun: the tongue sticking out between the lips organically tapers into a licking flame! The tongue literally IS the fire. Minimalist, clever, and witty.
					</p>

					<div class="logo-preview-box">
						<!-- SVG 4 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<defs>
								<linearGradient id="t4-firetongue" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0%" stop-color="#fbbf24"/>
									<stop offset="40%" stop-color="#f97316"/>
									<stop offset="80%" stop-color="#dc2626"/>
									<stop offset="100%" stop-color="#991b1b"/>
								</linearGradient>
							</defs>
							<!-- Dark Mouth Opening -->
							<path d="M 18,44 C 28,32 72,32 82,44 C 74,54 26,54 18,44 Z" fill="#0f172a"/>
							<!-- Upper Lip -->
							<path d="M 14,44 C 26,32 40,30 50,34 C 60,30 74,32 86,44 C 76,48 24,48 14,44 Z" fill="#1e293b"/>
							<!-- Tongue Morphs into Dropping Flame -->
							<path d="M 32,44 C 30,62 38,72 44,80 C 48,86 50,90 50,90 C 50,90 52,86 56,80 C 62,72 70,62 68,44 Z" fill="url(#t4-firetongue)"/>
							<!-- Center Flame Core in Tongue -->
							<path d="M 44,48 C 42,60 46,68 50,74 C 54,68 58,60 56,48 Z" fill="#fef08a"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<path d="M 14,44 C 26,32 40,30 50,34 C 60,30 74,32 86,44 C 76,48 24,48 14,44 Z" fill="#1e293b"/>
								<path d="M 32,44 C 30,62 38,72 44,80 C 48,86 50,90 50,90 C 50,90 52,86 56,80 C 62,72 70,62 68,44 Z" fill="#ea580c"/>
								<path d="M 44,48 C 42,60 46,68 50,74 C 54,68 58,60 56,48 Z" fill="#fde047"/>
							</svg>
							<div class="lockup-text">
								<span class="lockup-decoding">Decoding</span>
								<span class="lockup-burn lockup-burn-red">The Burn</span>
							</div>
						</div>
					</div>
				</article>

				<!-- CONCEPT 5 -->
				<article class="concept-card">
					<div class="card-header">
						<span class="concept-num">Option 5</span>
						<span class="concept-tag tag-red">Rock &amp; Roll Vibe</span>
					</div>
					<h3 class="concept-title">The "Rolling Fire" Bold Tongue</h3>
					<p class="concept-desc">
						A nod to the classic iconic pop-culture tongue logo: bold red tongue protruding downward with glossy highlights and fiery licking curls above the lips.
					</p>

					<div class="logo-preview-box">
						<!-- SVG 5 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<defs>
								<linearGradient id="t5-tongue" x1="0" y1="0" x2="1" y2="1">
									<stop offset="0%" stop-color="#ff2a55"/>
									<stop offset="100%" stop-color="#b91c1c"/>
								</linearGradient>
							</defs>
							<!-- Bold Charcoal Mouth Hull -->
							<path d="M 12,48 C 24,30 76,30 88,48 C 80,64 20,64 12,48 Z" fill="#09090b"/>
							<!-- Upper White Tooth Band -->
							<path d="M 28,42 C 40,38 60,38 72,42 L 70,48 C 58,45 42,45 30,48 Z" fill="#ffffff"/>
							<!-- Large Pop Tongue -->
							<path d="M 24,50 C 24,76 32,92 50,92 C 68,92 76,76 76,50 Z" fill="url(#t5-tongue)" stroke="#000000" stroke-width="2"/>
							<!-- Center Sulcus Line -->
							<path d="M 50,54 C 50,68 50,78 50,82" stroke="#4c0519" stroke-width="2.5" stroke-linecap="round"/>
							<!-- White Specular Highlight on Tongue Side -->
							<path d="M 32,56 C 30,66 34,76 40,82" stroke="#ffffff" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.8"/>
							<!-- Rising Flame Above -->
							<path d="M 50,10 C 54,20 62,26 62,34 C 56,36 50,30 46,38 C 42,28 46,20 50,10 Z" fill="#f59e0b"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<path d="M 12,48 C 24,30 76,30 88,48 C 80,64 20,64 12,48 Z" fill="#09090b"/>
								<path d="M 24,50 C 24,76 32,92 50,92 C 68,92 76,76 76,50 Z" fill="#e11d48"/>
								<path d="M 32,56 C 30,66 34,76 40,82" stroke="#ffffff" stroke-width="4" stroke-linecap="round" fill="none"/>
							</svg>
							<div class="lockup-text">
								<span class="lockup-decoding">Decoding</span>
								<span class="lockup-burn lockup-burn-red">The Burn</span>
							</div>
						</div>
					</div>
				</article>

				<!-- CONCEPT 6 -->
				<article class="concept-card highlight-card">
					<div class="card-header">
						<span class="concept-num">Option 6</span>
						<span class="concept-tag tag-blend">Pure Tongue (No Flame)</span>
					</div>
					<h3 class="concept-title">Pure Cheeky Tongue Out (Zero Flame)</h3>
					<p class="concept-desc">
						"Or just a tongue coming out. It's a bit cheeky, but it's maybe more memorable and simple." Ultra-clean, iconic, and friendly. Zero flame clutter.
					</p>

					<div class="logo-preview-box">
						<!-- SVG 6 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<defs>
								<linearGradient id="t6-tongue" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0%" stop-color="#fb7185"/>
									<stop offset="100%" stop-color="#e11d48"/>
								</linearGradient>
							</defs>
							<!-- Friendly Smiling Dark Mouth Base -->
							<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#0f172a"/>
							<!-- Upper Teeth Smile Arc -->
							<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
							<!-- Big Friendly Sticking Tongue -->
							<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="url(#t6-tongue)"/>
							<!-- Clean Groove -->
							<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
							<!-- Upper Lip Accent -->
							<path d="M 14,42 C 26,30 40,28 50,32 C 60,28 74,30 86,42 C 76,46 64,46 50,46 C 36,46 24,46 14,42 Z" fill="#334155"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#0f172a"/>
