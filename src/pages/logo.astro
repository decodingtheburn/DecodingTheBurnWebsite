---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="40 Logo & Lockup Variations | Decoding The Burn" 
			description="40 proportion, typography, and layout variations for Decoding The Burn with the 100px gradient display mark." 
		/>
	</head>
	<body class="logo-lab-body">
		<Header />

		<main class="logo-lab-container">
			<!-- Header / Hero Section -->
			<section class="lab-hero">
				<div class="lab-badge">Typography &amp; Proportion Lab</div>
				<h1 class="lab-title">40 Lockup&nbsp;Variations</h1>
				<p class="lab-subtitle">
					Comparing size ratios, letter-spacing, weights, and layout structures for <strong>Decoding The Burn</strong> with the 100px gradient display mark on the&nbsp;left.
				</p>

				<!-- Global Background Mode Switcher -->
				<div class="theme-switcher-bar">
					<span class="switcher-label">Test Background:</span>
					<button type="button" class="theme-btn active" data-bg="bg-light">Light (Current Site)</button>
					<button type="button" class="theme-btn" data-bg="bg-purple">Deep Purple (#0b0518)</button>
					<button type="button" class="theme-btn" data-bg="bg-dark">Charcoal (#0f172a)</button>
				</div>
			</section>

			<!-- 40 VARIATIONS STACKED ONE ON TOP OF EACH OTHER -->
			<section class="variations-stack" id="variations-stack">

				<!-- 01: Canonical Balanced 2-Line -->
