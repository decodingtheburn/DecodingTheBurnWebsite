---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Brand Logo Exploration Lab | Decoding The Burn" 
			description="10 modern, simplified logo concepts for Decoding The Burn featuring open mouth, flame, purple, and minimal icons." 
		/>
	</head>
	<body class="logo-lab-body">
		<Header />

		<main class="logo-lab-container">
			<!-- Header / Coaching Intro Banner -->
			<section class="lab-hero">
				<div class="lab-badge">Brand Identity Lab • 10 Concepts</div>
				<h1 class="lab-title">Decoding The&nbsp;Burn</h1>
				<p class="lab-subtitle">
					Clean, modern, and simplified brand marks. Explore mouth geometry, flame metaphors, and deep purple palettes across light, dark, and header&nbsp;contexts.
				</p>

				<!-- Global Background Mode Switcher -->
				<div class="theme-switcher-bar">
					<span class="switcher-label">Test Background:</span>
					<button type="button" class="theme-btn active" data-bg="bg-light">Light (Current Site)</button>
					<button type="button" class="theme-btn" data-bg="bg-purple">Deep Purple (#0b0518)</button>
					<button type="button" class="theme-btn" data-bg="bg-dark">Charcoal (#0f172a)</button>
				</div>
			</section>

			<!-- 10 Logo Concepts Grid -->
			<section class="concepts-grid" id="concepts-grid">

				<!-- CONCEPT 1 -->
				<article class="concept-card">
					<div class="card-header">
						<span class="concept-num">Option 1</span>
						<span class="concept-tag tag-red">Mouth Focus</span>
					</div>
					<h3 class="concept-title">Minimal Open Mouth (Neon Flame Ember)</h3>
					<p class="concept-desc">
						A drastically simplified, modern open mouth. Outer lips in sleek charcoal, inner cavity radiating glowing crimson and warm tongue heat. No clutter, instant recognition.
					</p>

					<div class="logo-preview-box">
						<!-- SVG 1 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<defs>
								<linearGradient id="c1-lip" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0%" stop-color="#1e293b"/>
									<stop offset="100%" stop-color="#0f172a"/>
								</linearGradient>
								<radialGradient id="c1-glow" cx="50%" cy="55%" r="45%">
									<stop offset="0%" stop-color="#ff4d4d"/>
									<stop offset="60%" stop-color="#dc2626"/>
									<stop offset="100%" stop-color="#7f1d1d"/>
								</radialGradient>
								<linearGradient id="c1-tongue" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0%" stop-color="#f87171"/>
									<stop offset="100%" stop-color="#ef4444"/>
								</linearGradient>
							</defs>
							<!-- Outer Lip Silhouette -->
							<path d="M 12,50 C 22,34 38,32 47,36 C 50,37 50,37 53,36 C 62,32 78,34 88,50 C 78,74 62,80 50,80 C 38,80 22,74 12,50 Z" fill="url(#c1-lip)"/>
							<!-- Inner Oral Cavity Glow -->
							<ellipse cx="50" cy="53" rx="30" ry="18" fill="url(#c1-glow)"/>
							<!-- Clean Stylized Tongue -->
							<path d="M 32,56 C 36,50 44,48 50,48 C 56,48 64,50 68,56 C 66,66 58,70 50,70 C 42,70 34,66 32,56 Z" fill="url(#c1-tongue)"/>
							<!-- Subtle Upper Tooth Arc -->
							<path d="M 40,38 C 45,37 55,37 60,38 C 58,41 42,41 40,38 Z" fill="#ffffff" opacity="0.9"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<use href="#c1-thumb"/>
								<ellipse cx="50" cy="53" rx="30" ry="18" fill="#dc2626"/>
								<path d="M 12,50 C 22,34 38,32 47,36 C 50,37 50,37 53,36 C 62,32 78,34 88,50 C 78,74 62,80 50,80 C 38,80 22,74 12,50 Z" fill="#0f172a"/>
								<ellipse cx="50" cy="53" rx="28" ry="16" fill="#ef4444"/>
								<path d="M 33,56 C 37,50 44,48 50,48 C 56,48 63,50 67,56 C 65,65 58,69 50,69 C 42,69 35,65 33,56 Z" fill="#fca5a5"/>
							</svg>
							<div class="lockup-text">
								<span class="lockup-decoding">Decoding</span>
								<span class="lockup-burn lockup-burn-red">The Burn</span>
							</div>
						</div>
					</div>
				</article>

				<!-- CONCEPT 2 -->
				<article class="concept-card highlight-card">
					<div class="card-header">
						<span class="concept-num">Option 2</span>
						<span class="concept-tag tag-purple">Purple Mandate</span>
					</div>
					<h3 class="concept-title">Royal Purple Open Mouth</h3>
					<p class="concept-desc">
						You requested purple: this translates the open mouth into an imperial violet and royal purple aesthetic. Medical authority meets modern premium design.
					</p>

					<div class="logo-preview-box">
						<!-- SVG 2 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<defs>
								<linearGradient id="c2-lip" x1="0" y1="0" x2="1" y2="1">
									<stop offset="0%" stop-color="#4c1d95"/>
									<stop offset="100%" stop-color="#2e1065"/>
								</linearGradient>
								<radialGradient id="c2-glow" cx="50%" cy="55%" r="48%">
									<stop offset="0%" stop-color="#d8b4fe"/>
									<stop offset="50%" stop-color="#9333ea"/>
									<stop offset="100%" stop-color="#581c87"/>
								</radialGradient>
								<linearGradient id="c2-tongue" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0%" stop-color="#c084fc"/>
									<stop offset="100%" stop-color="#7c3aed"/>
								</linearGradient>
							</defs>
							<!-- Lip Contour -->
							<path d="M 12,50 C 22,34 38,32 47,36 C 50,37 50,37 53,36 C 62,32 78,34 88,50 C 78,74 62,80 50,80 C 38,80 22,74 12,50 Z" fill="url(#c2-lip)"/>
							<!-- Violet Oral Cavity -->
							<ellipse cx="50" cy="53" rx="30" ry="18" fill="url(#c2-glow)"/>
							<!-- Tongue -->
							<path d="M 32,56 C 36,50 44,48 50,48 C 56,48 64,50 68,56 C 66,66 58,70 50,70 C 42,70 34,66 32,56 Z" fill="url(#c2-tongue)"/>
							<!-- Accent Arc -->
							<path d="M 40,38 C 45,37 55,37 60,38 C 58,41 42,41 40,38 Z" fill="#ffffff" opacity="0.95"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<path d="M 12,50 C 22,34 38,32 47,36 C 50,37 50,37 53,36 C 62,32 78,34 88,50 C 78,74 62,80 50,80 C 38,80 22,74 12,50 Z" fill="#3b0764"/>
								<ellipse cx="50" cy="53" rx="28" ry="16" fill="#9333ea"/>
								<path d="M 33,56 C 37,50 44,48 50,48 C 56,48 63,50 67,56 C 65,65 58,69 50,69 C 42,69 35,65 33,56 Z" fill="#c084fc"/>
							</svg>
							<div class="lockup-text">
								<span class="lockup-decoding">Decoding</span>
								<span class="lockup-burn lockup-burn-purple">The Burn</span>
							</div>
						</div>
					</div>
				</article>

				<!-- CONCEPT 3 -->
				<article class="concept-card highlight-card">
					<div class="card-header">
						<span class="concept-num">Option 3</span>
						<span class="concept-tag tag-blend">Purple + Fire Synergy</span>
					</div>
					<h3 class="concept-title">Dual-Tone Purple & Flame Ember</h3>
					<p class="concept-desc">
						The ultimate fusion: Deep royal purple lips representing scientific "Decoding", holding a living red-orange fire ember representing "The Burn".
					</p>

					<div class="logo-preview-box">
						<!-- SVG 3 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<defs>
								<linearGradient id="c3-lip" x1="0" y1="0" x2="1" y2="1">
									<stop offset="0%" stop-color="#581c87"/>
									<stop offset="100%" stop-color="#1e1b4b"/>
								</linearGradient>
								<linearGradient id="c3-fire" x1="0" y1="1" x2="0" y2="0">
									<stop offset="0%" stop-color="#b91c1c"/>
									<stop offset="50%" stop-color="#ef4444"/>
									<stop offset="100%" stop-color="#fbbf24"/>
								</linearGradient>
							</defs>
							<!-- Purple Lip Outer -->
							<path d="M 12,50 C 22,34 38,32 47,36 C 50,37 50,37 53,36 C 62,32 78,34 88,50 C 78,74 62,80 50,80 C 38,80 22,74 12,50 Z" fill="url(#c3-lip)"/>
							<!-- Deep Dark Cavity -->
							<ellipse cx="50" cy="53" rx="28" ry="17" fill="#090514"/>
							<!-- Rising Fire Tongue inside mouth -->
							<path d="M 34,60 C 36,46 46,38 48,28 C 50,36 54,42 66,60 C 60,68 40,68 34,60 Z" fill="url(#c3-fire)"/>
							<!-- Flame Heart Accent -->
							<path d="M 44,58 C 46,50 50,44 50,38 C 52,44 55,48 56,58 C 52,62 48,62 44,58 Z" fill="#ffffff" opacity="0.7"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<path d="M 12,50 C 22,34 38,32 47,36 C 50,37 50,37 53,36 C 62,32 78,34 88,50 C 78,74 62,80 50,80 C 38,80 22,74 12,50 Z" fill="#4c1d95"/>
								<ellipse cx="50" cy="53" rx="26" ry="15" fill="#0f172a"/>
								<path d="M 35,59 C 38,48 47,40 49,32 C 51,39 55,44 65,59 C 59,66 41,66 35,59 Z" fill="#ef4444"/>
								<path d="M 45,58 C 47,50 50,44 50,40 C 51,45 53,48 55,58 Z" fill="#fbbf24"/>
							</svg>
							<div class="lockup-text">
								<span class="lockup-decoding">Decoding</span>
								<span class="lockup-burn lockup-burn-red">The Burn</span>
							</div>
						</div>
					</div>
				</article>

				<!-- CONCEPT 4 -->
				<article class="concept-card">
					<div class="card-header">
						<span class="concept-num">Option 4</span>
						<span class="concept-tag tag-amber">Flame Only</span>
					</div>
					<h3 class="concept-title">Pure Minimalist Flame</h3>
					<p class="concept-desc">
						"I was thinking about flames as well, maybe just having a flame." Here is an ultra-clean, Apple/Nike-grade single continuous geometric flame glyph.
					</p>

					<div class="logo-preview-box">
						<!-- SVG 4 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<defs>
								<linearGradient id="c4-flame" x1="0" y1="1" x2="0" y2="0">
									<stop offset="0%" stop-color="#b91c1c"/>
									<stop offset="45%" stop-color="#ef4444"/>
									<stop offset="85%" stop-color="#f97316"/>
									<stop offset="100%" stop-color="#fbbf24"/>
								</linearGradient>
								<linearGradient id="c4-inner" x1="0" y1="1" x2="0" y2="0">
									<stop offset="0%" stop-color="#f97316"/>
									<stop offset="100%" stop-color="#ffffff"/>
								</linearGradient>
							</defs>
							<!-- Main Fluid Flame Silhouette -->
							<path d="M 50,12 C 54,26 62,34 72,46 C 82,58 80,74 68,84 C 58,92 42,92 32,84 C 20,74 18,58 28,46 C 36,36 34,26 36,18 C 42,26 44,36 50,12 Z" fill="url(#c4-flame)"/>
							<!-- Inner Bright Core -->
							<path d="M 50,42 C 54,52 62,58 62,68 C 62,76 56,82 50,82 C 44,82 38,76 38,68 C 38,58 46,52 50,42 Z" fill="url(#c4-inner)" opacity="0.95"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<path d="M 50,12 C 54,26 62,34 72,46 C 82,58 80,74 68,84 C 58,92 42,92 32,84 C 20,74 18,58 28,46 C 36,36 34,26 36,18 C 42,26 44,36 50,12 Z" fill="#ef4444"/>
								<path d="M 50,42 C 54,52 62,58 62,68 C 62,76 56,82 50,82 C 44,82 38,76 38,68 C 38,58 46,52 50,42 Z" fill="#fbbf24"/>
							</svg>
							<div class="lockup-text">
								<span class="lockup-decoding">Decoding</span>
								<span class="lockup-burn lockup-burn-red">The Burn</span>
							</div>
						</div>
					</div>
				</article>

				<!-- CONCEPT 5 -->
				<article class="concept-card">
					<div class="card-header">
						<span class="concept-num">Option 5</span>
						<span class="concept-tag tag-purple">Negative Space</span>
					</div>
					<h3 class="concept-title">The Negative-Space Flame Mouth</h3>
					<p class="concept-desc">
						A sleek circular badge where the open mouth cavity naturally sculpts a rising flame in negative space. Smart, memorable, and minimalist.
					</p>

					<div class="logo-preview-box">
						<!-- SVG 5 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<defs>
								<linearGradient id="c5-badge" x1="0" y1="0" x2="1" y2="1">
									<stop offset="0%" stop-color="#7c3aed"/>
									<stop offset="100%" stop-color="#4c1d95"/>
								</linearGradient>
							</defs>
							<!-- Circular Badge Background -->
							<rect x="8" y="8" width="84" height="84" rx="24" fill="url(#c5-badge)"/>
							<!-- Stylized Mouth Open Cutout -->
							<path d="M 22,50 C 30,36 44,34 50,37 C 56,34 70,36 78,50 C 70,68 58,74 50,74 C 42,74 30,68 22,50 Z" fill="#ffffff"/>
							<!-- Negative Flame Tongue inside cutout -->
							<path d="M 40,66 C 42,56 48,50 50,42 C 52,50 58,56 60,66 C 56,71 44,71 40,66 Z" fill="#ef4444"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<rect x="8" y="8" width="84" height="84" rx="22" fill="#6d28d9"/>
								<path d="M 22,50 C 30,36 44,34 50,37 C 56,34 70,36 78,50 C 70,68 58,74 50,74 C 42,74 30,68 22,50 Z" fill="#ffffff"/>
								<path d="M 40,66 C 42,56 48,50 50,42 C 52,50 58,56 60,66 Z" fill="#ef4444"/>
							</svg>
							<div class="lockup-text">
								<span class="lockup-decoding">Decoding</span>
								<span class="lockup-burn lockup-burn-purple">The Burn</span>
							</div>
						</div>
					</div>
				</article>

				<!-- CONCEPT 6 -->
				<article class="concept-card highlight-card">
					<div class="card-header">
						<span class="concept-num">Option 6</span>
						<span class="concept-tag tag-blue">Simplified Face</span>
					</div>
					<h3 class="concept-title">The Simplified Face Profile & Glowing Cavity</h3>
					<p class="concept-desc">
						"Or you can try a full face but very simplified and no writing." A continuous architectural contour of the face profile with ONLY the burning mouth illuminated in crimson heat.
					</p>

					<div class="logo-preview-box">
						<!-- SVG 6 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<defs>
								<linearGradient id="c6-glow" x1="0" y1="0" x2="1" y2="1">
									<stop offset="0%" stop-color="#ff4d4d"/>
									<stop offset="60%" stop-color="#dc2626"/>
									<stop offset="100%" stop-color="#991b1b"/>
								</linearGradient>
							</defs>
							<!-- Clean Face Contour Lines -->
							<path d="M 38,15 C 48,15 54,18 56,26 C 57,32 54,36 56,42 C 57,45 62,47 62,50 C 58,52 55,52 54,54 C 56,58 60,60 56,66 C 54,69 50,71 52,78 C 50,82 45,85 40,86" 
								fill="none" stroke="#64748b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
							<!-- Burning Oral Cavity Focal Point -->
							<ellipse cx="44" cy="56" rx="14" ry="10" fill="url(#c6-glow)"/>
							<!-- Tongue Flare -->
							<path d="M 36,58 C 40,54 46,54 48,58 C 46,63 38,63 36,58 Z" fill="#fca5a5"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<path d="M 38,15 C 48,15 54,18 56,26 C 57,32 54,36 56,42 C 57,45 62,47 62,50 C 58,52 55,52 54,54 C 56,58 60,60 56,66 C 54,69 50,71 52,78 C 50,82 45,85 40,86" 
									fill="none" stroke="#64748b" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
								<ellipse cx="44" cy="56" rx="13" ry="9" fill="#dc2626"/>
							</svg>
							<div class="lockup-text">
								<span class="lockup-decoding">Decoding</span>
								<span class="lockup-burn lockup-burn-red">The Burn</span>
							</div>
						</div>
					</div>
				</article>

				<!-- CONCEPT 7 -->
				<article class="concept-card">
					<div class="card-header">
						<span class="concept-num">Option 7</span>
						<span class="concept-tag tag-red">Tongue Focus</span>
					</div>
					<h3 class="concept-title">Stylized Tongue & Thermal Waves</h3>
					<p class="concept-desc">
						Directly targets BMS at its core: a clean modern tongue mark with 3 radiating thermal arcs above it, signaling sensory heat and burning mouth syndrome.
					</p>

					<div class="logo-preview-box">
						<!-- SVG 7 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<defs>
								<linearGradient id="c7-tongue" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0%" stop-color="#ef4444"/>
									<stop offset="100%" stop-color="#991b1b"/>
								</linearGradient>
							</defs>
							<!-- 3 Thermal Energy Waves Above -->
							<path d="M 34,26 C 42,22 58,22 66,26" fill="none" stroke="#f87171" stroke-width="2.5" stroke-linecap="round"/>
							<path d="M 38,34 C 44,30 56,30 62,34" fill="none" stroke="#ef4444" stroke-width="3" stroke-linecap="round"/>
							<path d="M 42,42 C 46,38 54,38 58,42" fill="none" stroke="#dc2626" stroke-width="3.5" stroke-linecap="round"/>
							<!-- Tongue Silhouette -->
							<path d="M 32,54 C 32,54 34,78 50,78 C 66,78 68,54 68,54 C 68,54 58,58 50,58 C 42,58 32,54 32,54 Z" fill="url(#c7-tongue)"/>
							<!-- Central Tongue Sulcus Median Groove -->
							<line x1="50" y1="58" x2="50" y2="70" stroke="#fca5a5" stroke-width="2" stroke-linecap="round"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<path d="M 36,32 C 44,28 56,28 64,32" fill="none" stroke="#ef4444" stroke-width="3" stroke-linecap="round"/>
								<path d="M 32,54 C 32,54 34,78 50,78 C 66,78 68,54 68,54 C 68,54 58,58 50,58 C 42,58 32,54 32,54 Z" fill="#dc2626"/>
								<line x1="50" y1="58" x2="50" y2="70" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
							</svg>
							<div class="lockup-text">
								<span class="lockup-decoding">Decoding</span>
								<span class="lockup-burn lockup-burn-red">The Burn</span>
							</div>
						</div>
					</div>
				</article>

				<!-- CONCEPT 8 -->
				<article class="concept-card">
					<div class="card-header">
						<span class="concept-num">Option 8</span>
						<span class="concept-tag tag-purple">Monogram Tech</span>
					</div>
					<h3 class="concept-title">Monogram 'D' + Flame Aperture</h3>
					<p class="concept-desc">
						A sleek, geometric letter 'D' for "Decoding" where the inner negative space is shaped as a rising flame in vibrant purple and red. Ultra-modern tech feel.
					</p>

					<div class="logo-preview-box">
						<!-- SVG 8 -->
						<svg class="preview-svg" viewBox="0 0 100 100" width="88" height="88">
							<defs>
								<linearGradient id="c8-d" x1="0" y1="0" x2="1" y2="1">
									<stop offset="0%" stop-color="#7c3aed"/>
									<stop offset="100%" stop-color="#4338ca"/>
								</linearGradient>
							</defs>
							<!-- Bold Geometric D Outer -->
							<path d="M 24,18 L 48,18 C 68,18 82,32 82,50 C 82,68 68,82 48,82 L 24,82 Z" fill="url(#c8-d)"/>
							<!-- Negative Flame Inner Core -->
							<path d="M 44,30 C 50,42 60,48 60,58 C 60,66 54,72 46,72 C 38,72 38,64 42,56 C 44,52 44,42 44,30 Z" fill="#fcfcfd"/>
							<circle cx="50" cy="62" r="3.5" fill="#ef4444"/>
						</svg>
					</div>

					<div class="lockup-preview">
						<div class="lockup-label">Header Lockup Preview</div>
						<div class="lockup-demo">
							<svg viewBox="0 0 100 100" width="40" height="40">
								<path d="M 24,18 L 48,18 C 68,18 82,32 82,50 C 82,68 68,82 48,82 L 24,82 Z" fill="#6d28d9"/>
								<path d="M 44,30 C 50,42 60,48 60,58 C 60,66 54,72 46,72 C 38,72 38,64 42,56 C 44,52 44,42 44,30 Z" fill="#fcfcfd"/>
							</svg>
							<div class="lockup-text">
								<span class="lockup-decoding">Decoding</span>
								<span class="lockup-burn lockup-burn-purple">The Burn</span>
							</div>
						</div>
					</div>
				</article>

				<!-- CONCEPT 9 -->
				<article class="concept-card">
					<div class="card-header">
						<span class="concept-num">Option 9</span>
						<span class="concept-tag tag-red">Polygonal Crystal</span>
					</div>
					<h3 class="concept-title">Prismatic Geometric Mouth (Simplified)</h3>
