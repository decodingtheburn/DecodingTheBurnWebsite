---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="40 Logo Lockup & Proportion Variations | Decoding The Burn" 
			description="40 proportion, typography, and layout variations for Decoding The Burn with the 100px gradient display mark on the left." 
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap" rel="stylesheet">
	</head>
	<body class="logo-lab-body">
		<Header />

		<main class="logo-lab-container">
			<!-- Header / Hero Section -->
			<section class="lab-hero">
				<div class="lab-badge">Typography &amp; Proportion Lab</div>
				<h1 class="lab-title">40 Lockup&nbsp;Variations</h1>
				<p class="lab-subtitle">
					Comparing size ratios, letter-spacing, weights, and layout structures for <strong>Decoding The Burn</strong> with the 100px gradient display mark on the&nbsp;left.
				</p>

				<!-- Global Background Mode Switcher -->
				<div class="theme-switcher-bar">
					<span class="switcher-label">Test Background:</span>
					<button type="button" class="theme-btn active" data-bg="bg-light">Light (Current Site)</button>
					<button type="button" class="theme-btn" data-bg="bg-purple">Deep Purple (#0b0518)</button>
					<button type="button" class="theme-btn" data-bg="bg-dark">Charcoal (#0f172a)</button>
				</div>
			</section>

			<!-- 40 VARIATIONS STACKED ONE ON TOP OF EACH OTHER -->
			<section class="variations-stack" id="variations-stack">

				<!-- 01: Canonical Balanced 2-Line -->
				<article class="variation-card">
					<span class="var-num">01</span>
					<div class="lockup-container">
						<div class="mark-wrapper">
							<svg viewBox="0 0 100 100" width="100" height="100">
								<defs>
									<linearGradient id="v1-purple" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#9333ea"/><stop offset="100%" stop-color="#3b0764"/></linearGradient>
									<linearGradient id="v1-tongue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#fb7185"/><stop offset="60%" stop-color="#e11d48"/><stop offset="100%" stop-color="#9f1239"/></linearGradient>
								</defs>
								<path d="M 16,42 C 24,28 76,28 84,42 C 84,62 68,68 50,68 C 32,68 16,62 16,42 Z" fill="#090514"/>
								<path d="M 28,38 C 38,34 62,34 72,38 L 70,44 C 60,41 40,41 30,44 Z" fill="#ffffff"/>
								<path d="M 28,46 C 28,74 34,88 50,88 C 66,88 72,74 72,46 Z" fill="url(#v1-tongue)"/>
								<line x1="50" y1="50" x2="50" y2="76" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" opacity="0.85"/>
								<path d="M 14,42 C 26,28 40,26 50,30 C 60,26 74,28 86,42 C 76,48 64,48 50,48 C 36,48 24,48 14,42 Z" fill="url(#v1-purple)"/>
							</svg>
						</div>
						<div class="wordmark-box wm-01">
							<div class="wm-line wm-decoding">Decoding</div>
							<div class="wm-line wm-burn">The Burn</div>
						</div>
