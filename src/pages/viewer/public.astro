---
import BaseHead from '../../components/BaseHead.astro';
import TongueLogo from '../../components/TongueLogo.astro';
import { bmsSlides } from '../../data/slidesData';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Public Viewer: How I Solved My BMS | Decoding The Burn" 
			description="Clean, borderless 16:9 public slide presentation for OBS recording and audience viewing." 
		/>
		<style>
			:root {
				--bg-black: #06080c;
				--stage-bg: #090c12;
				--accent-red: #ef4444;
			}

			html, body {
				margin: 0;
				padding: 0;
				width: 100vw;
				height: 100vh;
				background: var(--bg-black);
				overflow: hidden;
				font-family: var(--font-body, system-ui, sans-serif);
				user-select: none;
			}

			.public-canvas-wrapper {
				width: 100vw;
				height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				background: #06080c;
			}

			.public-slide-stage {
				width: 100%;
				max-width: 177.78vh;
				height: 100vh;
				background: radial-gradient(circle 1000px at 50% -20%, rgba(200, 56, 44, 0.18), transparent 70%),
				            linear-gradient(180deg, #0d1118 0%, #07090d 100%);
				padding: clamp(2rem, 5vh, 4rem) clamp(2.5rem, 6vw, 6rem);
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				box-sizing: border-box;
				position: relative;
				cursor: pointer;
			}

			.stage-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
				z-index: 10;
			}

			.header-left {
				display: flex;
				align-items: center;
				gap: 0.85rem;
			}

			.counter-pill {
				font-family: monospace;
				font-size: 0.92rem;
				font-weight: 800;
				letter-spacing: 0.08em;
				color: #f1f5f9;
				background: rgba(255, 255, 255, 0.08);
				border: 1px solid rgba(255, 255, 255, 0.18);
				padding: 0.35rem 0.85rem;
				border-radius: 6px;
			}

			.topic-pill {
				font-size: 0.88rem;
				font-weight: 800;
				letter-spacing: 0.04em;
				color: #f87171;
				background: rgba(239, 68, 68, 0.14);
				border: 1px solid rgba(239, 68, 68, 0.35);
				padding: 0.35rem 0.95rem;
				border-radius: 6px;
			}

			.header-brand {
				display: flex;
				align-items: center;
				gap: 0.85rem;
			}

			.brand-logo-box {
				width: 36px;
				height: 36px;
			}

			.brand-title {
				font-size: 1.15rem;
				font-weight: 800;
				letter-spacing: -0.01em;
				color: #ffffff;
			}

			.stage-body {
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding: 1.5rem 0;
			}

			.slide-main-title {
				font-family: var(--font-heading, system-ui, sans-serif);
				font-size: clamp(2.4rem, 4.4vw, 3.8rem);
				font-weight: 900;
				line-height: 1.15;
				color: #ffffff;
				margin-bottom: clamp(1.8rem, 3.5vh, 3rem);
				text-wrap: balance;
				letter-spacing: -0.025em;
				text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
			}

			.bullet-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: clamp(1.1rem, 2.4vh, 2rem);
			}

			.bullet-item {
				display: flex;
				align-items: center;
				gap: 1.35rem;
				font-size: clamp(1.65rem, 2.7vw, 2.4rem);
				line-height: 1.35;
				transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
			}

			.bullet-dot {
				width: clamp(14px, 1.3vw, 18px);
				height: clamp(14px, 1.3vw, 18px);
				border-radius: 50%;
				flex-shrink: 0;
				transition: all 0.2s ease;
			}

			.bullet-item.is-active {
				opacity: 1;
				transform: translateX(10px);
			}

			.bullet-item.is-active .bullet-dot {
				background: #ef4444;
				box-shadow: 0 0 16px #ef4444, 0 0 32px rgba(239, 68, 68, 0.6);
				transform: scale(1.4);
			}

			.bullet-item.is-active .bullet-text {
				color: #ffffff;
				font-weight: 800;
				text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8);
			}

			.bullet-item.is-revealed {
				opacity: 0.88;
				transform: translateX(0);
			}

			.bullet-item.is-revealed .bullet-dot {
				background: #94a3b8;
				box-shadow: none;
			}

			.bullet-item.is-revealed .bullet-text {
				color: #e2e8f0;
				font-weight: 600;
			}

			.bullet-item.is-dimmed {
				opacity: 0.38;
				transform: translateX(0);
			}

			.bullet-item.is-dimmed .bullet-dot {
				background: #475569;
			}

			.bullet-item.is-dimmed .bullet-text {
				color: #cbd5e1;
				font-weight: 500;
			}

			.stage-footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding-top: 1.25rem;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
			}

			.footer-info {
				font-size: 0.92rem;
				font-weight: 700;
				color: #94a3b8;
			}

			.footer-dots {
				display: flex;
				align-items: center;
				gap: 0.6rem;
			}

			.slide-dot {
				width: 9px;
				height: 9px;
				border-radius: 50%;
				background: rgba(255, 255, 255, 0.25);
				border: none;
				padding: 0;
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.slide-dot.is-active {
				background: #ef4444;
				transform: scale(1.4);
				box-shadow: 0 0 10px #ef4444;
			}

			.footer-controls {
				display: flex;
				align-items: center;
				gap: 0.65rem;
			}

			.ctrl-btn {
				height: 34px;
				padding: 0 0.75rem;
				border-radius: 6px;
				background: rgba(255, 255, 255, 0.08);
				border: 1px solid rgba(255, 255, 255, 0.18);
				color: #f1f5f9;
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 0.82rem;
				font-weight: 700;
				cursor: pointer;
				transition: all 0.18s ease;
			}

			.ctrl-btn:hover {
				background: rgba(255, 255, 255, 0.18);
				color: #ffffff;
				border-color: #ffffff;
			}

			:fullscreen .public-slide-stage,
			:-webkit-full-screen .public-slide-stage {
				max-width: 177.78vh;
				height: 100vh;
			}

			.help-modal {
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				background: rgba(0, 0, 0, 0.85);
				backdrop-filter: blur(8px);
				display: none;
				align-items: center;
				justify-content: center;
				z-index: 200;
			}

			.help-box {
				background: #0f131a;
				border: 1px solid #1e2638;
				border-radius: 12px;
				padding: 2rem;
				max-width: 480px;
				width: 90%;
			}

			.help-title {
				font-size: 1.25rem;
				font-weight: 700;
				color: #ffffff;
				margin-bottom: 1.25rem;
				display: flex;
				justify-content: space-between;
			}

			.help-close {
				background: transparent;
				border: none;
				color: #94a3b8;
				font-size: 1.5rem;
				cursor: pointer;
			}

			.help-list {
				display: flex;
				flex-direction: column;
				gap: 0.65rem;
			}

			.help-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 0.5rem 0.75rem;
				background: rgba(255, 255, 255, 0.03);
				border-radius: 6px;
				font-size: 0.88rem;
			}

			kbd {
				background: rgba(255, 255, 255, 0.1);
				border: 1px solid rgba(255, 255, 255, 0.2);
				border-radius: 4px;
				padding: 0.15rem 0.45rem;
				font-family: monospace;
				font-size: 0.75rem;
				color: #ffffff;
			}
		</style>
	</head>
	<body>
		<div class="public-canvas-wrapper" id="canvas-wrapper">
			<div class="public-slide-stage" id="public-stage">
				<header class="stage-header">
					<div class="header-left">
						<span class="counter-pill" id="counter-pill">SLIDE 01 / {String(bmsSlides.length).padStart(2, '0')}</span>
						<span class="topic-pill" id="topic-pill">{bmsSlides[0]?.badge || 'Setup'}</span>
					</div>
					<div class="header-brand">
						<div class="brand-logo-box">
							<TongueLogo />
						</div>
						<span class="brand-title">Decoding The Burn</span>
					</div>
				</header>

				<main class="stage-body">
					<h1 class="slide-main-title" id="slide-main-title">{bmsSlides[0]?.title}</h1>
					<ul class="bullet-list" id="bullet-list"></ul>
				</main>

				<footer class="stage-footer">
					<span class="footer-info" id="footer-info">Point 1 of {bmsSlides[0]?.bullets.length || 5}</span>
					<div class="footer-dots" id="footer-dots"></div>
					<div class="footer-controls">
						<button type="button" class="ctrl-btn" id="help-toggle-btn" title="Shortcuts Help (?)">
							<span>?</span>
						</button>
						<button type="button" class="ctrl-btn" id="fullscreen-toggle-btn" title="Toggle Fullscreen (F)">
							<svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2.5" fill="none"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
							<span>Maximize [F]</span>
						</button>
					</div>
				</footer>
			</div>
		</div>

		<div class="help-modal" id="help-modal">
			<div class="help-box">
				<div class="help-title">
					<span>Public Viewer Controls</span>
					<button type="button" class="help-close" id="help-close-btn">&times;</button>
				</div>
				<div class="help-list">
					<div class="help-row">
						<span>Next point</span>
						<div><kbd>Spacebar</kbd> or <kbd>→</kbd></div>
					</div>
					<div class="help-row">
						<span>Previous point</span>
						<div><kbd>Shift+Space</kbd> or <kbd>←</kbd></div>
					</div>
					<div class="help-row">
						<span>Next slide</span>
						<div><kbd>↓</kbd> or <kbd>PageDown</kbd></div>
					</div>
					<div class="help-row">
						<span>Previous slide</span>
						<div><kbd>↑</kbd> or <kbd>PageUp</kbd></div>
					</div>
					<div class="help-row">
						<span>Toggle Fullscreen / Maximize</span>
						<div><kbd>F</kbd></div>
					</div>
				</div>
			</div>
		</div>

		<script define:vars={{ slides: bmsSlides }}>
			(function () {
				let currentSlide = 0;
				let currentPoint = 0;
				const totalSlides = slides.length;

				const syncChannel = new BroadcastChannel('bms_deck_sync');

				const titleEl = document.getElementById('slide-main-title');
				const bulletsEl = document.getElementById('bullet-list');
				const counterPill = document.getElementById('counter-pill');
				const topicPill = document.getElementById('topic-pill');
				const footerInfo = document.getElementById('footer-info');
				const footerDots = document.getElementById('footer-dots');
				const stageEl = document.getElementById('public-stage');
				const canvasWrapper = document.getElementById('canvas-wrapper');
				const helpModal = document.getElementById('help-modal');
				const helpBtn = document.getElementById('help-toggle-btn');
				const helpClose = document.getElementById('help-close-btn');
				const fsBtn = document.getElementById('fullscreen-toggle-btn');

				function initDots() {
					if (!footerDots) return;
					footerDots.innerHTML = '';
					for (let i = 0; i < totalSlides; i++) {
						const dot = document.createElement('button');
						dot.className = `slide-dot ${i === 0 ? 'is-active' : ''}`;
						dot.addEventListener('click', (e) => {
							e.stopPropagation();
							jumpToSlide(i);
						});
						footerDots.appendChild(dot);
					}
				}

				function render() {
					const s = slides[currentSlide];
					if (!s) return;

					if (counterPill) {
						counterPill.textContent = `SLIDE ${String(currentSlide + 1).padStart(2, '0')} / ${String(totalSlides).padStart(2, '0')}`;
					}
					if (topicPill) {
						topicPill.textContent = s.badge;
					}
					if (titleEl) {
						titleEl.textContent = s.title;
					}

					if (bulletsEl) {
						bulletsEl.innerHTML = '';
						s.bullets.forEach((bText, idx) => {
							const li = document.createElement('li');
							li.className = 'bullet-item';
							if (idx === currentPoint) {
								li.classList.add('is-active');
							} else if (idx < currentPoint) {
								li.classList.add('is-revealed');
							} else {
								li.classList.add('is-dimmed');
							}
							li.innerHTML = `
								<span class="bullet-dot"></span>
								<span class="bullet-text">${bText}</span>
							`;
							li.addEventListener('click', (e) => {
								e.stopPropagation();
								currentPoint = idx;
								updateBulletStates();
								broadcastState();
							});
							bulletsEl.appendChild(li);
						});
					}

					updateDots();
					updateFooterInfo();
				}

				function updateBulletStates() {
					const items = bulletsEl?.querySelectorAll('.bullet-item') || [];
					items.forEach((item, idx) => {
						item.classList.remove('is-active', 'is-revealed', 'is-dimmed');
						if (idx === currentPoint) {
							item.classList.add('is-active');
						} else if (idx < currentPoint) {
							item.classList.add('is-revealed');
						} else {
							item.classList.add('is-dimmed');
						}
					});
					updateFooterInfo();
				}

				function updateFooterInfo() {
					const s = slides[currentSlide];
					if (footerInfo && s) {
						footerInfo.textContent = `Point ${currentPoint + 1} of ${s.bullets.length}`;
					}
				}

				function updateDots() {
					const dots = footerDots?.querySelectorAll('.slide-dot') || [];
					dots.forEach((d, idx) => {
						d.classList.toggle('is-active', idx === currentSlide);
					});
				}

				function broadcastState() {
					syncChannel.postMessage({
						slideIndex: currentSlide,
						pointIndex: currentPoint
					});
				}

				function nextStep() {
					const s = slides[currentSlide];
					if (!s) return;
					if (currentPoint < s.bullets.length - 1) {
						currentPoint++;
						updateBulletStates();
					} else if (currentSlide < totalSlides - 1) {
						currentSlide++;
						currentPoint = 0;
						render();
					}
					broadcastState();
				}

				function prevStep() {
					if (currentPoint > 0) {
						currentPoint--;
						updateBulletStates();
					} else if (currentSlide > 0) {
						currentSlide--;
						const prevS = slides[currentSlide];
						currentPoint = prevS.bullets.length - 1;
						render();
					}
					broadcastState();
				}

				function nextSlide() {
					if (currentSlide < totalSlides - 1) {
						currentSlide++;
						currentPoint = 0;
						render();
						broadcastState();
					}
				}

				function prevSlide() {
					if (currentSlide > 0) {
						currentSlide--;
						currentPoint = 0;
						render();
						broadcastState();
					}
				}

				function jumpToSlide(idx) {
					if (idx >= 0 && idx < totalSlides) {
						currentSlide = idx;
						currentPoint = 0;
						render();
						broadcastState();
					}
				}

				function toggleFullscreen() {
					const target = canvasWrapper || document.documentElement;
					if (!document.fullscreenElement) {
						if (target.requestFullscreen) {
							target.requestFullscreen();
						}
					} else {
						if (document.exitFullscreen) {
							document.exitFullscreen();
						}
					}
				}

				syncChannel.onmessage = (event) => {
					if (event.data && typeof event.data.slideIndex === 'number') {
						const { slideIndex, pointIndex } = event.data;
						if (slideIndex !== currentSlide) {
							currentSlide = slideIndex;
							currentPoint = pointIndex || 0;
							render();
						} else if (pointIndex !== currentPoint) {
							currentPoint = pointIndex;
							updateBulletStates();
						}
					}
				};

				stageEl?.addEventListener('click', (e) => {
					if (e.target.closest('button') || e.target.closest('a')) return;
					nextStep();
				});

				stageEl?.addEventListener('contextmenu', (e) => {
					e.preventDefault();
					prevStep();
				});

				window.addEventListener('keydown', (e) => {
					if (e.code === 'Space') {
						e.preventDefault();
						if (e.shiftKey) prevStep();
						else nextStep();
					} else if (e.code === 'ArrowRight') {
						e.preventDefault();
						nextStep();
					} else if (e.code === 'ArrowLeft') {
						e.preventDefault();
						prevStep();
					} else if (e.code === 'ArrowDown' || e.code === 'PageDown') {
						e.preventDefault();
						nextSlide();
					} else if (e.code === 'ArrowUp' || e.code === 'PageUp') {
						e.preventDefault();
						prevSlide();
					} else if (e.code === 'KeyF') {
						e.preventDefault();
						toggleFullscreen();
					} else if (e.code === 'KeyH' || e.key === '?') {
						e.preventDefault();
						helpModal.style.display = helpModal.style.display === 'flex' ? 'none' : 'flex';
					} else if (e.code === 'Escape') {
						helpModal.style.display = 'none';
					}
				});

				helpBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					helpModal.style.display = 'flex';
				});

				helpClose?.addEventListener('click', (e) => {
					e.stopPropagation();
					helpModal.style.display = 'none';
				});

				fsBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					toggleFullscreen();
				});

				initDots();
				render();
			})();
		</script>
	</body>
</html>
