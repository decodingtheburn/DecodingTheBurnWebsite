---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import TongueLogo from '../../components/TongueLogo.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { generateSlidesFromPost } from '../../utils/slideEngine';

// Fetch all posts including drafts, sorted by date descending
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Calculate slide count and metadata for each post
const postsWithSlides = allPosts.map((post, index) => {
	const slides = generateSlidesFromPost(post.id, post.data.title, post.data.description, post.body || '');
	const cleanTitle = post.data.title.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ');
	const postNumber = allPosts.length - index;
	const isDraft = post.data.draft === true;
	const category = post.data.category || 'My Experience';
	const compactDate = post.data.pubDate.toLocaleDateString('en-US', {
		month: 'short',
		day: 'numeric',
		year: 'numeric'
	});
	return {
		post,
		cleanTitle,
		postNumber,
		isDraft,
		category,
		compactDate,
		slideCount: slides.length
	};
});

const totalSlides = postsWithSlides.reduce((acc, p) => acc + p.slideCount, 0);
const liveCount = postsWithSlides.filter(p => !p.isDraft).length;
const draftCount = postsWithSlides.filter(p => p.isDraft).length;

// Dynamic category counts
const categoryMap = new Map<string, number>();
postsWithSlides.forEach(p => {
	categoryMap.set(p.category, (categoryMap.get(p.category) || 0) + 1);
});
const dynamicCategories = Array.from(categoryMap.entries()).sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Universal Slide Deck Hub | Decoding The Burn" 
			description="Access every blog post, preview private drafts, and launch public OBS presentation screens or private presenter cockpits." 
		/>
		<style>
			:root {
				--bg-pink: #881337;
				--bg-pink-dark: #4c0519;
				--accent-rose: #be123c;
				--accent-hover: #9f1239;
				--card-bg: #ffffff;
				--card-border: #fecdd3;
				--card-border-hover: #e11d48;
				--text-primary: #0f172a;
				--text-secondary: #475569;
				--text-muted: #64748b;
			}

			html, body {
				margin: 0;
				padding: 0;
				background-color: #881337;
				background-image: 
					radial-gradient(circle 1200px at 50% -100px, #9d174d 0%, #881337 55%, #4c0519 100%);
				background-attachment: fixed;
				color: #0f172a;
				font-family: var(--font-body, system-ui, sans-serif);
				min-height: 100vh;
			}

			/* Password Gate Styles (Light Theme Card on Dark Pink Background) */
			#viewerGate {
				max-width: 440px;
				margin: 6rem auto;
				background: #ffffff;
				padding: 3rem 2.5rem;
				border-radius: 20px;
				border: 1px solid #fecdd3;
				box-shadow: 0 25px 60px -15px rgba(76, 5, 25, 0.45), 0 10px 25px rgba(0, 0, 0, 0.15);
				text-align: center;
			}

			.gate-icon {
				font-size: 2.75rem;
				margin-bottom: 1rem;
			}

			.gate-title {
				font-size: 1.65rem;
				font-weight: 800;
				color: #881337;
				margin-bottom: 0.5rem;
			}

			.gate-subtitle {
				color: #475569;
				font-size: 0.9rem;
				line-height: 1.5;
				margin-bottom: 2rem;
			}

			.gate-form {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.gate-input {
				padding: 0.9rem 1.25rem;
				border-radius: 12px;
				border: 1.5px solid #cbd5e1;
				background: #f8fafc;
				color: #0f172a;
				font-size: 1.05rem;
				outline: none;
				text-align: center;
				transition: all 0.2s ease;
			}

			.gate-input:focus {
				border-color: #be123c;
				background: #ffffff;
				box-shadow: 0 0 0 3px rgba(190, 18, 60, 0.15);
			}

			.gate-btn {
				padding: 0.9rem;
				font-size: 0.95rem;
				font-weight: 700;
				background: #be123c;
				color: #ffffff;
				border: none;
				border-radius: 12px;
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.gate-btn:hover {
				background: #9f1239;
				box-shadow: 0 4px 15px rgba(190, 18, 60, 0.35);
			}

			.gate-error {
				color: #dc2626;
				font-size: 0.85rem;
				font-weight: 600;
				margin-top: 0.5rem;
				display: none;
			}

			/* Hub Container */
			.hub-container {
				max-width: 1440px;
				margin: 0 auto;
				padding: 2.5rem 1.5rem 5rem 1.5rem;
			}

			.hub-header {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				margin-bottom: 3rem;
				position: relative;
			}

			.hub-top-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
				margin-bottom: 1.5rem;
			}

			.hub-brand {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.hub-logo {
				width: 36px;
				height: 36px;
			}

			.hub-brand-name {
				font-size: 1.2rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				color: #ffffff;
			}

			.lock-btn {
				background: rgba(255, 255, 255, 0.16);
				border: 1px solid rgba(255, 255, 255, 0.35);
				color: #ffffff;
				font-size: 0.75rem;
				font-weight: 700;
				padding: 0.45rem 0.95rem;
				border-radius: 8px;
				cursor: pointer;
				backdrop-filter: blur(8px);
				transition: all 0.2s ease;
			}

			.lock-btn:hover {
				background: #ffffff;
				color: #881337;
				border-color: #ffffff;
			}

			.hub-title {
				font-family: var(--font-heading, system-ui, sans-serif);
				font-size: clamp(2rem, 4vw, 2.85rem);
				font-weight: 800;
				line-height: 1.15;
				color: #ffffff;
				margin: 0 auto 0.85rem auto;
				text-wrap: balance;
				text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
			}

			.hub-subheadline {
				font-size: 1.05rem;
				color: #fce7f3;
				max-width: 760px;
				margin: 0 auto;
				line-height: 1.55;
				text-wrap: balance;
				font-weight: 500;
			}

			/* Hub 2-Column Layout */
			.hub-layout {
				display: grid;
				grid-template-columns: 290px 1fr;
				gap: 2.5rem;
				align-items: start;
				margin-bottom: 3.5rem;
			}

			@media (max-width: 1024px) {
				.hub-layout {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
			}

			/* Left Sidebar (Crisp Light Card) */
			.hub-sidebar {
				background: #ffffff;
				border: 1px solid #fecdd3;
				border-radius: 20px;
				padding: 1.5rem;
				position: sticky;
				top: 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				box-shadow: 0 16px 36px -8px rgba(76, 5, 25, 0.22), 0 4px 16px -2px rgba(15, 23, 42, 0.06);
			}

			.filter-block {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.filter-label {
				font-size: 0.74rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: #881337;
			}

			.search-input-wrapper {
				position: relative;
				display: flex;
				align-items: center;
			}

			.search-icon {
				position: absolute;
				left: 0.85rem;
				color: #64748b;
				pointer-events: none;
			}

			.hub-search-input {
				width: 100%;
				padding: 0.65rem 2rem 0.65rem 2.4rem;
				background: #f8fafc;
				border: 1.5px solid #e2e8f0;
				border-radius: 8px;
				color: #0f172a;
				font-size: 0.85rem;
				outline: none;
				transition: all 0.18s ease;
				box-sizing: border-box;
			}

			.hub-search-input:focus {
				border-color: #be123c;
				background: #ffffff;
				box-shadow: 0 0 0 3px rgba(190, 18, 60, 0.12);
			}

			.search-clear-btn {
				position: absolute;
				right: 0.6rem;
				background: transparent;
				border: none;
				color: #64748b;
				font-size: 1.15rem;
				cursor: pointer;
				padding: 0.2rem;
				line-height: 1;
			}

			.search-clear-btn:hover {
				color: #be123c;
			}

			/* Status & Category Filters */
			.filter-buttons-list {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}

			.filter-pill-btn,
			.sort-pill-btn,
			.group-pill-btn,
			.col-pill-btn {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.52rem 0.75rem;
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 8px;
				color: #334155;
				font-size: 0.82rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.16s ease;
				text-align: left;
			}

			.filter-pill-btn:hover,
			.sort-pill-btn:hover,
			.group-pill-btn:hover,
			.col-pill-btn:hover {
				background: #fff1f2;
				border-color: #fecdd3;
				color: #881337;
			}

			.filter-pill-btn.active,
			.sort-pill-btn.active,
			.group-pill-btn.active,
			.col-pill-btn.active {
				background: #be123c;
				border-color: #be123c;
				color: #ffffff;
				font-weight: 700;
				box-shadow: 0 4px 12px rgba(190, 18, 60, 0.25);
			}

			.filter-pill-name {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.filter-count-badge {
				font-family: ui-monospace, SFMono-Regular, monospace;
				font-size: 0.72rem;
				padding: 0.15rem 0.5rem;
				border-radius: 4px;
				background: #e2e8f0;
				color: #475569;
			}

			.filter-pill-btn.active .filter-count-badge {
				background: #ffffff;
				color: #881337;
				font-weight: 800;
			}

			/* Category Buttons */
			.category-pill-btn {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.45rem 0.75rem;
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 6px;
				color: #475569;
				font-size: 0.8rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.16s ease;
			}

			.category-pill-btn:hover {
				color: #881337;
				background: #fff1f2;
				border-color: #fecdd3;
			}

			.category-pill-btn.active {
				background: #be123c;
				border-color: #be123c;
				color: #ffffff;
				font-weight: 700;
				box-shadow: 0 4px 12px rgba(190, 18, 60, 0.25);
			}

			.category-pill-btn .filter-count-badge {
				font-family: ui-monospace, SFMono-Regular, monospace;
				font-size: 0.72rem;
				padding: 0.12rem 0.45rem;
				border-radius: 4px;
				background: #e2e8f0;
				color: #475569;
			}

			.category-pill-btn.active .filter-count-badge {
				background: #ffffff;
				color: #881337;
				font-weight: 800;
			}

			/* Grouped Viewport Styling - Light Panel on Dark Pink Canvas */
			.hub-grouped-container {
				display: flex;
				flex-direction: column;
				gap: 2.75rem;
				margin-bottom: 2.5rem;
			}

			.hub-group-section {
				background: #ffffff;
				border: 1px solid #fecdd3;
				border-radius: 20px;
				padding: 1.75rem;
				box-shadow: 0 16px 36px -8px rgba(76, 5, 25, 0.22);
			}

			/* Semantic H2 Category Headline with Rose Header Banner */
			.hub-group-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				background: linear-gradient(135deg, #ffe4e6 0%, #fecdd3 100%);
				border: 1px solid #fda4af;
				border-radius: 14px;
				padding: 1rem 1.4rem;
				margin-bottom: 1.75rem;
				box-shadow: 0 4px 15px -2px rgba(190, 18, 60, 0.15);
			}

			.hub-group-title-wrap {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.hub-group-icon {
				color: #be123c;
				display: flex;
				align-items: center;
			}

			.hub-group-title {
				font-family: var(--font-heading, system-ui, sans-serif);
				font-size: 1.35rem;
				font-weight: 800;
				color: #881337;
				margin: 0;
				letter-spacing: -0.01em;
			}

			.hub-group-badge {
				font-family: ui-monospace, SFMono-Regular, monospace;
				font-size: 0.75rem;
				font-weight: 800;
				padding: 0.35rem 0.85rem;
				border-radius: 9999px;
				background: #be123c;
				color: #ffffff;
				letter-spacing: 0.03em;
				box-shadow: 0 2px 8px rgba(190, 18, 60, 0.35);
			}

			/* Deck Inventory Summary Card */
			.sidebar-summary-card {
				background: #fff1f2;
				border: 1px solid #fecdd3;
				border-radius: 12px;
				padding: 1rem;
			}

			.summary-card-title {
				font-size: 0.72rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: #881337;
				margin-bottom: 0.75rem;
			}

			.summary-stats-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.5rem;
				margin-bottom: 0.65rem;
			}

			.stat-box {
				background: #ffffff;
				border: 1px solid #fecdd3;
				border-radius: 6px;
				padding: 0.5rem;
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.stat-number {
				font-family: ui-monospace, SFMono-Regular, monospace;
				font-size: 1.15rem;
				font-weight: 800;
				color: #be123c;
			}

			.stat-label {
				font-size: 0.68rem;
				color: #475569;
			}

			.summary-note {
				font-size: 0.73rem;
				color: #64748b;
				line-height: 1.4;
				margin: 0;
			}

			.reset-filters-btn {
				background: #fee2e2;
				border: 1px solid #fca5a5;
				color: #b91c1c;
				padding: 0.55rem 0.85rem;
				border-radius: 8px;
				font-size: 0.8rem;
				font-weight: 700;
				cursor: pointer;
				transition: all 0.18s ease;
				text-align: center;
			}

			.reset-filters-btn:hover {
				background: #dc2626;
				border-color: #dc2626;
				color: #ffffff;
			}

			/* Results Bar */
			.results-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1.25rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.2);
			}

			.results-count-text {
				font-size: 0.88rem;
				color: #fce7f3;
			}

			.results-count-text strong {
				color: #ffffff;
				font-weight: 800;
			}

			/* Empty Results State */
			.empty-results-state {
				text-align: center;
				padding: 4rem 2rem;
				background: #ffffff;
				border: 2px dashed #fecdd3;
				border-radius: 20px;
				margin-bottom: 3.5rem;
				box-shadow: 0 16px 36px -8px rgba(76, 5, 25, 0.15);
			}

			.empty-icon {
				font-size: 2.5rem;
				margin-bottom: 1rem;
			}

			.empty-title {
				font-size: 1.2rem;
				font-weight: 800;
				color: #881337;
				margin: 0 0 0.5rem 0;
			}

			.empty-desc {
				font-size: 0.9rem;
				color: #475569;
				margin: 0 0 1.5rem 0;
			}

			.empty-reset-btn {
				background: #be123c;
				color: #ffffff;
				border: none;
				padding: 0.65rem 1.25rem;
				font-size: 0.85rem;
				font-weight: 700;
				border-radius: 8px;
				cursor: pointer;
				transition: background 0.18s ease;
			}

			.empty-reset-btn:hover {
				background: #9f1239;
			}

			/* Posts Grid & Dynamic Column Controls */
			.posts-slides-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
				gap: 1.75rem;
				margin-bottom: 2.5rem;
			}

			.posts-slides-grid.cols-1 {
				grid-template-columns: 1fr !important;
			}

			.posts-slides-grid.cols-2 {
				grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
			}

			.posts-slides-grid.cols-3 {
				grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
			}

			@media (max-width: 1024px) {
				.posts-slides-grid.cols-3 {
					grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
				}
			}

			@media (max-width: 720px) {
				.posts-slides-grid.cols-2,
				.posts-slides-grid.cols-3 {
					grid-template-columns: 1fr !important;
				}
			}

			/* Post Slide Cards: Light Theme like /blog */
			.post-slide-card {
				background: #ffffff;
				border: 1px solid #fecdd3;
				border-radius: 20px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
				box-shadow: 0 16px 36px -8px rgba(76, 5, 25, 0.15), 0 4px 16px -2px rgba(15, 23, 42, 0.04);
			}

			.post-slide-card.draft-card {
				border-color: #fcd34d;
				background: linear-gradient(180deg, #fffbeb 0%, #ffffff 35%);
			}

			.post-slide-card.draft-card:hover {
				border-color: #f59e0b;
				box-shadow: 0 24px 48px -10px rgba(245, 158, 11, 0.25);
			}

			.post-slide-card:hover {
				border-color: #be123c;
				transform: translateY(-5px);
				box-shadow: 0 24px 48px -10px rgba(76, 5, 25, 0.25), 0 8px 20px -4px rgba(15, 23, 42, 0.08);
			}

			/* Clean Thumbnail: Zero badges on image */
			.card-thumb-box {
				width: 100%;
				aspect-ratio: 16 / 9;
				background: #f1f5f9;
				position: relative;
				overflow: hidden;
				border-bottom: 1px solid #f1f5f9;
			}

			.card-thumb-img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.3s ease;
			}

			.post-slide-card:hover .card-thumb-img {
				transform: scale(1.03);
			}

			/* Card Content Box */
			.card-content-box {
				padding: 1.5rem;
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			/* Meta Header: Row 1 */
			.card-meta-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.5rem;
				margin-bottom: 0.65rem;
			}

			.meta-badges-group {
				display: flex;
				align-items: center;
				gap: 0.45rem;
				flex-wrap: wrap;
			}

			.entry-pill {
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.72rem;
				font-weight: 700;
				color: #1e293b;
				background: #f1f5f9;
				border: 1px solid #e2e8f0;
				padding: 0.2rem 0.55rem;
				border-radius: 6px;
				letter-spacing: 0.02em;
			}

			.slide-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.72rem;
				font-weight: 700;
				color: #be123c;
				background: #fff1f2;
				border: 1px solid #fecdd3;
				padding: 0.2rem 0.55rem;
				border-radius: 6px;
			}

			.meta-status-group {
				display: flex;
				align-items: center;
			}

			.status-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-size: 0.68rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				padding: 0.2rem 0.6rem;
				border-radius: 6px;
			}

			.status-live {
				background: #dcfce7;
				color: #166534;
				border: 1px solid #bbf7d0;
			}

			.status-draft {
				background: #fef3c7;
				color: #92400e;
				border: 1px solid #fde68a;
			}

			.status-dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				display: inline-block;
			}

			.dot-live {
				background: #22c55e;
			}

			.dot-draft {
				background: #f59e0b;
			}

			/* Meta Header: Row 2 Date */
			.card-date-row {
				display: flex;
				align-items: center;
				gap: 0.35rem;
				color: #64748b;
				font-size: 0.78rem;
				margin-bottom: 0.85rem;
				padding-bottom: 0.65rem;
				border-bottom: 1px solid #f1f5f9;
			}

			.date-icon {
				opacity: 0.75;
				flex-shrink: 0;
			}

			.card-date-text {
				font-weight: 500;
				letter-spacing: 0.01em;
			}

			/* Post Title & Description */
			.card-post-title {
				font-family: var(--font-heading, system-ui, sans-serif);
				font-size: 1.15rem;
				font-weight: 800;
				line-height: 1.35;
				color: #0f172a;
				margin: 0 0 0.55rem 0;
				text-wrap: balance;
			}

			.card-post-desc {
				font-size: 0.86rem;
				color: #475569;
				line-height: 1.5;
				margin-bottom: 1.4rem;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				text-wrap: pretty;
			}

			/* 2-Tier Action Buttons */
			.card-actions-wrapper {
				display: flex;
				flex-direction: column;
				gap: 0.55rem;
				margin-top: auto;
			}

			.btn-primary-article {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.45rem;
				width: 100%;
				padding: 0.65rem 1rem;
				background: #fff1f2;
				border: 1px solid #fda4af;
				border-radius: 8px;
				color: #9f1239;
				font-size: 0.82rem;
				font-weight: 700;
				text-decoration: none;
				transition: all 0.2s ease;
				box-sizing: border-box;
			}

			.btn-primary-article:hover {
				background: #be123c;
				border-color: #be123c;
				color: #ffffff;
				transform: translateY(-1px);
				box-shadow: 0 4px 12px rgba(190, 18, 60, 0.25);
			}

			.btn-arrow {
				transition: transform 0.2s ease;
				opacity: 0.8;
			}

			.btn-primary-article:hover .btn-arrow {
				transform: translateX(3px);
				opacity: 1;
			}

			.btn-deck-tools-row {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.55rem;
				width: 100%;
			}

			.deck-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.35rem;
				padding: 0.55rem 0.5rem;
				border-radius: 8px;
				font-size: 0.76rem;
				font-weight: 700;
				text-decoration: none;
				transition: all 0.18s ease;
				box-sizing: border-box;
				text-align: center;
			}

			.obs-btn {
				background: #eff6ff;
				color: #1d4ed8;
				border: 1px solid #bfdbfe;
			}

			.obs-btn:hover {
				background: #2563eb;
				color: #ffffff;
				border-color: #2563eb;
				box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
			}

			.cockpit-btn {
				background: #fff1f2;
				color: #be123c;
				border: 1px solid #fecdd3;
			}

			.cockpit-btn:hover {
				background: #be123c;
				color: #ffffff;
				border-color: #be123c;
				box-shadow: 0 4px 12px rgba(190, 18, 60, 0.25);
			}

			/* Guide Box */
			.hub-guide-box {
				background: #ffffff;
				border: 1px solid #fecdd3;
				border-radius: 16px;
				padding: 1.75rem 2rem;
				margin-bottom: 3rem;
				box-shadow: 0 12px 30px -6px rgba(76, 5, 25, 0.18);
			}

			.hub-guide-title {
				font-size: 1.05rem;
				font-weight: 800;
				color: #881337;
				margin-bottom: 1rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.guide-steps {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5rem;
			}

			.guide-step {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}

			.step-number {
				font-family: monospace;
				font-size: 0.8rem;
				font-weight: 800;
				color: #be123c;
			}

			.step-heading {
				font-size: 0.95rem;
				font-weight: 700;
				color: #0f172a;
			}

			.step-text {
				font-size: 0.85rem;
				color: #475569;
				line-height: 1.45;
			}

			kbd {
				background: #f1f5f9;
				border: 1px solid #cbd5e1;
				border-radius: 4px;
				padding: 0.15rem 0.4rem;
				font-family: monospace;
				font-size: 0.75rem;
				color: #0f172a;
			}

			.hub-footer-nav {
				display: flex;
				justify-content: center;
				gap: 1.5rem;
			}

			.hub-nav-link {
				color: #fce7f3;
				font-size: 0.9rem;
				font-weight: 600;
				text-decoration: none;
				transition: color 0.18s ease;
			}

			.hub-nav-link:hover {
				color: #ffffff;
			}
		</style>
	</head>
	<body>
		<!-- Password Gate -->
		<div id="viewerGate">
			<div class="gate-icon">🔒</div>
			<h1 class="gate-title">Cockpit Access</h1>
			<p class="gate-subtitle">Enter your presenter passcode to access all published articles, private drafts, and slide decks.</p>
			
			<form id="viewerGateForm" class="gate-form">
				<input 
					type="password" 
					id="viewerPasscode" 
					placeholder="Enter passcode..." 
					required 
					class="gate-input"
				/>
				<button type="submit" class="gate-btn">Unlock Presenter Hub →</button>
				<p id="viewerErrorMsg" class="gate-error">Incorrect passcode. Please try again.</p>
			</form>
		</div>

		<!-- Protected Content (Hidden until unlocked) -->
		<div id="viewerContent" style="display: none;">
			<main class="hub-container">
				<header class="hub-header">
					<div class="hub-top-bar">
						<div class="hub-brand">
							<div class="hub-logo">
								<TongueLogo />
							</div>
							<span class="hub-brand-name">Decoding The Burn</span>
						</div>
						<button id="viewerLockBtn" class="lock-btn">Lock Cockpit 🔒</button>
					</div>

					<h1 class="hub-title">Master Presenter &amp; Drafts&nbsp;Hub</h1>
					<p class="hub-subheadline">
						All {allPosts.length} entries (live and drafts). Each article automatically generates its 5-word presentation deck. Launch the article, public OBS screen, or teleprompter&nbsp;cockpit.
					</p>
				</header>

				<!-- Hub 2-Column Layout: Left Sidebar Filters + Right Presentations Content -->
				<div class="hub-layout">
					<!-- Left Sidebar Filters -->
					<aside class="hub-sidebar" id="hubSidebar">
						<!-- Search Filter -->
						<div class="filter-block">
							<label for="hubSearchInput" class="filter-label">Search Decks</label>
							<div class="search-input-wrapper">
								<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
								<input 
									type="text" 
									id="hubSearchInput" 
									placeholder="Filter title, keywords..." 
									class="hub-search-input"
									autocomplete="off"
								/>
								<button type="button" id="hubSearchClear" class="search-clear-btn" title="Clear search" style="display: none;">&times;</button>
							</div>
						</div>

						<!-- Status Filter -->
						<div class="filter-block">
							<span class="filter-label">Status</span>
							<div class="filter-buttons-list">
								<button type="button" class="filter-pill-btn active" data-status="all">
									<span class="filter-pill-name">All Entries</span>
									<span class="filter-count-badge">{allPosts.length}</span>
								</button>
								<button type="button" class="filter-pill-btn" data-status="live">
									<span class="filter-pill-name">
										<span class="status-dot dot-live"></span>
										Live Articles
									</span>
									<span class="filter-count-badge">{liveCount}</span>
								</button>
								<button type="button" class="filter-pill-btn" data-status="draft">
									<span class="filter-pill-name">
										<span class="status-dot dot-draft"></span>
										Private Drafts
									</span>
									<span class="filter-count-badge">{draftCount}</span>
								</button>
							</div>
						</div>

						<!-- Sort Options (Multi-button) -->
						<div class="filter-block">
							<span class="filter-label">Sort Order</span>
							<div class="filter-buttons-list sort-buttons-list">
								<button type="button" class="sort-pill-btn active" data-sort="entry-desc">
									<span class="filter-pill-name">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
										Newest First
									</span>
								</button>
								<button type="button" class="sort-pill-btn" data-sort="entry-asc">
									<span class="filter-pill-name">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
										Oldest First
									</span>
								</button>
								<button type="button" class="sort-pill-btn" data-sort="slides-desc">
									<span class="filter-pill-name">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line></svg>
										Most Slides
									</span>
								</button>
								<button type="button" class="sort-pill-btn" data-sort="title-asc">
									<span class="filter-pill-name">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h10M4 18h6"/></svg>
										Title (A - Z)
									</span>
								</button>
							</div>
						</div>

						<!-- Group By Filter (Multi-button) -->
						<div class="filter-block">
							<span class="filter-label">Group By</span>
							<div class="filter-buttons-list group-buttons-list">
								<button type="button" class="group-pill-btn active" data-group="none">
									<span class="filter-pill-name">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
										None (Flat Grid)
									</span>
								</button>
								<button type="button" class="group-pill-btn" data-group="category">
									<span class="filter-pill-name">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
										Category
									</span>
								</button>
								<button type="button" class="group-pill-btn" data-group="date">
									<span class="filter-pill-name">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
										Month &amp; Year
									</span>
								</button>
							</div>
						</div>

						<!-- Cards Per Row (1, 2, or 3 side by side) -->
						<div class="filter-block">
							<span class="filter-label">Cards Per Row</span>
							<div class="filter-buttons-list col-buttons-list">
								<button type="button" class="col-pill-btn" data-cols="1">
									<span class="filter-pill-name">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
										1 Card (Full Width)
									</span>
								</button>
								<button type="button" class="col-pill-btn active" data-cols="2">
									<span class="filter-pill-name">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="8" height="16" rx="1.5"/><rect x="13" y="4" width="8" height="16" rx="1.5"/></svg>
										2 Cards Side-by-Side
									</span>
								</button>
								<button type="button" class="col-pill-btn" data-cols="3">
									<span class="filter-pill-name">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="5.5" height="16" rx="1"/><rect x="9.25" y="4" width="5.5" height="16" rx="1"/><rect x="16.5" y="4" width="5.5" height="16" rx="1"/></svg>
										3 Cards Side-by-Side
									</span>
								</button>
							</div>
						</div>

						<!-- Category Filters -->
						<div class="filter-block">
							<span class="filter-label">Category</span>
							<div class="filter-buttons-list">
								<button type="button" class="category-pill-btn active" data-category="all">
									<span>All Categories</span>
									<span class="filter-count-badge">{allPosts.length}</span>
								</button>
								{dynamicCategories.map(([catName, count]) => (
									<button type="button" class="category-pill-btn" data-category={catName}>
										<span>{catName}</span>
										<span class="filter-count-badge">{count}</span>
									</button>
								))}
							</div>
						</div>

						<!-- Quick Presentation Deck Summary Card -->
						<div class="sidebar-summary-card">
							<div class="summary-card-title">Deck Inventory</div>
							<div class="summary-stats-grid">
								<div class="stat-box">
									<span class="stat-number">{allPosts.length}</span>
									<span class="stat-label">Decks Ready</span>
								</div>
								<div class="stat-box">
									<span class="stat-number">{totalSlides}</span>
									<span class="stat-label">Total Slides</span>
								</div>
							</div>
							<p class="summary-note">
								Every post generates teleprompter notes and clean 16:9 OBS&nbsp;screens.
							</p>
						</div>

						<!-- Reset Filters Button -->
						<button type="button" id="resetFiltersBtn" class="reset-filters-btn" style="display: none;">
							<span>Reset Filters ↺</span>
						</button>
					</aside>

					<!-- Right Main Content Area -->
					<div class="hub-main-content">
						<!-- Results Bar -->
						<div class="results-bar">
							<div class="results-count-text">
								Showing <strong id="visibleCountText">{allPosts.length}</strong> of {allPosts.length} presentations
							</div>
						</div>

						<!-- All Blog Posts as Presentation Decks & Articles -->
						<div class="posts-slides-grid cols-2" id="postsGrid">
							{postsWithSlides.map(({ post, cleanTitle, postNumber, isDraft, category, compactDate, slideCount }) => (
								<div 
									class={`post-slide-card ${isDraft ? 'draft-card' : ''}`}
									data-entry={postNumber}
									data-status={isDraft ? 'draft' : 'live'}
									data-category={category}
									data-slides={slideCount}
									data-title={cleanTitle.toLowerCase()}
									data-desc={(post.data.description || '').toLowerCase()}
									data-timestamp={post.data.pubDate.valueOf()}
									data-month-year={post.data.pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
								>
									<!-- Clean Image: Zero badges on thumbnail -->
									<div class="card-thumb-box">
										<img 
											src={post.data.heroImage || '/how_i_solved_my_bms_thumbnail.jpg'} 
											alt={cleanTitle} 
											class="card-thumb-img"
											loading="lazy"
										/>
									</div>

									<!-- Card Content -->
									<div class="card-content-box">
										<div>
											<!-- Metadata Header: Entry #, Slides, Status -->
											<div class="card-meta-header">
												<div class="meta-badges-group">
													<span class="entry-pill">Entry #{postNumber}</span>
													<span class="slide-pill">
														<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
														{slideCount} Slides
													</span>
												</div>
												<div class="meta-status-group">
													{isDraft ? (
														<span class="status-pill status-draft">
															<span class="status-dot dot-draft"></span>
															Draft
														</span>
													) : (
														<span class="status-pill status-live">
															<span class="status-dot dot-live"></span>
															Live
														</span>
													)}
												</div>
											</div>

											<!-- Compact Clean Date Row -->
											<div class="card-date-row">
												<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="date-icon"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
												<span class="card-date-text">{compactDate}</span>
											</div>

											<h3 class="card-post-title" set:html={post.data.title} />
											<p class="card-post-desc">{post.data.description}</p>
										</div>

										<!-- 2-Tier Action Buttons: Full-width Article read/preview + 50/50 Deck Tools -->
										<div class="card-actions-wrapper">
											<a href={`/blog/${post.id}/`} class="btn-primary-article" title={isDraft ? "Preview Private Draft Article" : "Read Full Article"}>
												<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
												<span>{isDraft ? 'Preview Private Draft' : 'Read Full Article'}</span>
												<span class="btn-arrow">→</span>
											</a>

											<div class="btn-deck-tools-row">
												<a href={`/viewer/${post.id}/public`} class="deck-btn obs-btn" title="Open Clean Public Screen for OBS">
													<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
													<span>Public OBS</span>
												</a>
												<a href={`/viewer/${post.id}/private`} class="deck-btn cockpit-btn" title="Open Denis's Teleprompter Cockpit">
													<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
													<span>Cockpit</span>
												</a>
											</div>
										</div>
									</div>
								</div>
							))}
						</div>
						
						<!-- Dynamic Grouped Viewport -->
						<div class="hub-grouped-container" id="hubGroupedContainer" style="display: none;"></div>

						<!-- Empty Search State -->
						<div class="empty-results-state" id="emptyState" style="display: none;">
							<div class="empty-icon">🔍</div>
							<h3 class="empty-title">No matching presentations found</h3>
							<p class="empty-desc">Try clearing your search terms or selecting a different status filter.</p>
							<button type="button" class="empty-reset-btn" id="emptyResetBtn">Reset Filters</button>
						</div>

						<!-- Quick Recording Instructions -->
						<div class="hub-guide-box">
							<div class="hub-guide-title">
								<svg viewBox="0 0 24 24" width="18" height="18" stroke="#ef4444" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
								<span>How Real-Time Sync Works</span>
							</div>
							<div class="guide-steps">
								<div class="guide-step">
									<span class="step-number">STEP 1: LAUNCH PUBLIC</span>
									<span class="step-heading">Open Public OBS View</span>
									<p class="step-text">
										Open <strong>OBS 📺</strong> in a separate window or monitor. Point OBS Window Capture directly to it.
									</p>
								</div>
								<div class="guide-step">
									<span class="step-number">STEP 2: LAUNCH COCKPIT</span>
									<span class="step-heading">Open Presenter Cockpit</span>
									<p class="step-text">
										Open <strong>Cockpit 🎙️</strong> in front of you. It shows live teleprompter speaker notes and an elapsed timer.
									</p>
								</div>
								<div class="guide-step">
									<span class="step-number">STEP 3: HIT SPACEBAR</span>
									<span class="step-heading">Automatic Instant Sync</span>
									<p class="step-text">
										Tapping <kbd>Spacebar</kbd> in your Cockpit advances BOTH your screen and the Public OBS screen simultaneously!
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>

				<footer class="hub-footer-nav">
					<a href="/blog" class="hub-nav-link">← Public Blog Archive</a>
					<span style="color: #334155;">•</span>
					<a href="/" class="hub-nav-link">Decoding The Burn Home</a>
				</footer>
			</main>
		</div>

		<!-- Password Protection & Filter Script -->
		<script is:inline>
			const PASS = 'bms2026'; // Default passcode
			const gate = document.getElementById('viewerGate');
			const content = document.getElementById('viewerContent');
			const form = document.getElementById('viewerGateForm');
			const passcode = document.getElementById('viewerPasscode');
			const errorMsg = document.getElementById('viewerErrorMsg');
			const lockBtn = document.getElementById('viewerLockBtn');

			const unlock = () => {
				if (gate && content) {
					gate.style.display = 'none';
					content.style.display = 'block';
					sessionStorage.setItem('viewer_unlocked', 'true');
				}
			};

			const lock = () => {
				if (gate && content) {
					gate.style.display = 'block';
					content.style.display = 'none';
					sessionStorage.removeItem('viewer_unlocked');
				}
			};

			// Check session storage
			if (sessionStorage.getItem('viewer_unlocked') === 'true') {
				unlock();
			}

			form?.addEventListener('submit', (e) => {
				e.preventDefault();
				const val = passcode.value.trim();
				if (val === PASS || val === 'denis' || val === 'admin') {
					unlock();
				} else {
					if (errorMsg) errorMsg.style.display = 'block';
				}
			});

			lockBtn?.addEventListener('click', lock);

			// Client-Side Filter, Multi-Button Sort & Grouping Engine
			const searchInput = document.getElementById('hubSearchInput');
			const searchClear = document.getElementById('hubSearchClear');
			const sortButtons = document.querySelectorAll('.sort-pill-btn');
			const groupButtons = document.querySelectorAll('.group-pill-btn');
			const colButtons = document.querySelectorAll('.col-pill-btn');
			const statusButtons = document.querySelectorAll('.filter-pill-btn');
			const categoryButtons = document.querySelectorAll('.category-pill-btn');
			const resetBtn = document.getElementById('resetFiltersBtn');
			const emptyResetBtn = document.getElementById('emptyResetBtn');
			const visibleCountText = document.getElementById('visibleCountText');
			const emptyState = document.getElementById('emptyState');
			const postsGrid = document.getElementById('postsGrid');
			const hubGroupedContainer = document.getElementById('hubGroupedContainer');
			const allCards = Array.from(document.querySelectorAll('.post-slide-card'));

			let currentStatus = 'all';
			let currentCategory = 'all';
			let currentSearch = '';
			let currentSort = 'entry-desc';
			let currentGroup = 'none';
			let currentCols = '2';

			function applyFiltersAndSort() {
				// Safely ensure all cards are attached to postsGrid before re-filtering and grouping
				allCards.forEach(card => {
					if (card.parentElement !== postsGrid && postsGrid) {
						postsGrid.appendChild(card);
					}
				});

				let visibleCount = 0;

				allCards.forEach((card) => {
					const cardStatus = card.getAttribute('data-status') || '';
					const cardCategory = card.getAttribute('data-category') || '';
					const cardTitle = card.getAttribute('data-title') || '';
					const cardDesc = card.getAttribute('data-desc') || '';

					const statusMatch = currentStatus === 'all' || cardStatus === currentStatus;
					const categoryMatch = currentCategory === 'all' || cardCategory === currentCategory;
					const searchMatch = !currentSearch || cardTitle.includes(currentSearch) || cardDesc.includes(currentSearch);

					if (statusMatch && categoryMatch && searchMatch) {
						card.style.display = 'flex';
						visibleCount++;
					} else {
						card.style.display = 'none';
					}
				});

				// Sort visible cards
				const visibleCards = allCards.filter(c => c.style.display !== 'none');
				visibleCards.sort((a, b) => {
					const entryA = parseInt(a.getAttribute('data-entry') || '0', 10);
					const entryB = parseInt(b.getAttribute('data-entry') || '0', 10);
					const slidesA = parseInt(a.getAttribute('data-slides') || '0', 10);
					const slidesB = parseInt(b.getAttribute('data-slides') || '0', 10);
					const titleA = a.getAttribute('data-title') || '';
					const titleB = b.getAttribute('data-title') || '';
					const timeA = parseInt(a.getAttribute('data-timestamp') || '0', 10);
					const timeB = parseInt(b.getAttribute('data-timestamp') || '0', 10);

					if (currentSort === 'entry-desc') return entryB - entryA || timeB - timeA;
					if (currentSort === 'entry-asc') return entryA - entryB || timeA - timeB;
					if (currentSort === 'slides-desc') return slidesB - slidesA || entryB - entryA;
					if (currentSort === 'title-asc') return titleA.localeCompare(titleB);
					return 0;
				});

				// Render by Group mode
				if (currentGroup === 'none') {
					if (hubGroupedContainer) {
						hubGroupedContainer.style.display = 'none';
						hubGroupedContainer.innerHTML = '';
					}
					if (postsGrid) {
						postsGrid.className = `posts-slides-grid cols-${currentCols}`;
						postsGrid.style.display = visibleCount === 0 ? 'none' : 'grid';
						visibleCards.forEach(card => postsGrid.appendChild(card));
					}
				} else {
					if (postsGrid) {
						postsGrid.style.display = 'none';
					}
					if (hubGroupedContainer) {
						hubGroupedContainer.style.display = visibleCount === 0 ? 'none' : 'flex';
						hubGroupedContainer.innerHTML = '';

						const groupsMap = new Map();

						visibleCards.forEach(card => {
							let groupKey = '';
							let groupTitle = '';
							const timestamp = parseInt(card.getAttribute('data-timestamp') || '0', 10);

							if (currentGroup === 'category') {
								groupKey = card.getAttribute('data-category') || 'Uncategorized';
								groupTitle = groupKey;
							} else if (currentGroup === 'date') {
								groupKey = card.getAttribute('data-month-year') || 'Other';
								groupTitle = groupKey;
							}

							if (!groupsMap.has(groupKey)) {
								groupsMap.set(groupKey, {
									title: groupTitle,
									cards: [],
									timestamp: timestamp
								});
							}
							groupsMap.get(groupKey).cards.push(card);
							if (timestamp > groupsMap.get(groupKey).timestamp) {
								groupsMap.get(groupKey).timestamp = timestamp;
							}
						});

						const sortedGroups = Array.from(groupsMap.values());
						if (currentGroup === 'date') {
							if (currentSort === 'entry-asc') {
								sortedGroups.sort((a, b) => a.timestamp - b.timestamp);
							} else {
								sortedGroups.sort((a, b) => b.timestamp - a.timestamp);
							}
						} else if (currentGroup === 'category') {
							sortedGroups.sort((a, b) => a.title.localeCompare(b.title));
						}

						sortedGroups.forEach(group => {
							const section = document.createElement('div');
							section.className = 'hub-group-section';

							const header = document.createElement('div');
							header.className = 'hub-group-header';

							const titleWrap = document.createElement('div');
							titleWrap.className = 'hub-group-title-wrap';

							const iconSpan = document.createElement('span');
							iconSpan.className = 'hub-group-icon';
							iconSpan.innerHTML = currentGroup === 'category' 
								? `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>`
								: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>`;

							const h2 = document.createElement('h2');
							h2.className = 'hub-group-title';
							h2.textContent = group.title;

							const badge = document.createElement('span');
							badge.className = 'hub-group-badge';
							badge.textContent = `${group.cards.length} deck${group.cards.length > 1 ? 's' : ''}`;

							titleWrap.appendChild(iconSpan);
							titleWrap.appendChild(h2);
							titleWrap.appendChild(badge);
							header.appendChild(titleWrap);
							section.appendChild(header);

							const grid = document.createElement('div');
							grid.className = `posts-slides-grid cols-${currentCols}`;
							group.cards.forEach(card => grid.appendChild(card));
							section.appendChild(grid);

							hubGroupedContainer.appendChild(section);
						});
					}
				}

				// Update results display
				if (visibleCountText) visibleCountText.textContent = String(visibleCount);
				if (emptyState) emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
				if (postsGrid && currentGroup === 'none') postsGrid.style.display = visibleCount === 0 ? 'none' : 'grid';

				// Reset / Clear buttons
				const hasActiveFilters = currentStatus !== 'all' || currentCategory !== 'all' || currentSearch.length > 0 || currentSort !== 'entry-desc' || currentGroup !== 'none' || currentCols !== '2';
				if (resetBtn) resetBtn.style.display = hasActiveFilters ? 'block' : 'none';
				if (searchClear) searchClear.style.display = currentSearch.length > 0 ? 'block' : 'none';
			}

			searchInput?.addEventListener('input', (e) => {
				currentSearch = e.target.value.trim().toLowerCase();
				applyFiltersAndSort();
			});

			searchClear?.addEventListener('click', () => {
				if (searchInput) searchInput.value = '';
				currentSearch = '';
				applyFiltersAndSort();
			});

			sortButtons.forEach(btn => {
				btn.addEventListener('click', () => {
					sortButtons.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					currentSort = btn.getAttribute('data-sort') || 'entry-desc';
					applyFiltersAndSort();
				});
			});

			groupButtons.forEach(btn => {
				btn.addEventListener('click', () => {
					groupButtons.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					currentGroup = btn.getAttribute('data-group') || 'none';
					applyFiltersAndSort();
				});
			});

			colButtons.forEach(btn => {
				btn.addEventListener('click', () => {
					colButtons.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					currentCols = btn.getAttribute('data-cols') || '2';
					applyFiltersAndSort();
				});
			});

			statusButtons.forEach(btn => {
				btn.addEventListener('click', () => {
					statusButtons.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					currentStatus = btn.getAttribute('data-status') || 'all';
					applyFiltersAndSort();
				});
			});

			categoryButtons.forEach(btn => {
				btn.addEventListener('click', () => {
					categoryButtons.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					currentCategory = btn.getAttribute('data-category') || 'all';
					applyFiltersAndSort();
				});
			});

			function resetFilters() {
				if (searchInput) searchInput.value = '';
				currentSearch = '';
				currentStatus = 'all';
				currentCategory = 'all';
				currentSort = 'entry-desc';
				currentGroup = 'none';
				currentCols = '2';

				statusButtons.forEach(b => {
					if (b.getAttribute('data-status') === 'all') b.classList.add('active');
					else b.classList.remove('active');
				});

				categoryButtons.forEach(b => {
					if (b.getAttribute('data-category') === 'all') b.classList.add('active');
					else b.classList.remove('active');
				});

				sortButtons.forEach(b => {
					if (b.getAttribute('data-sort') === 'entry-desc') b.classList.add('active');
					else b.classList.remove('active');
				});

				groupButtons.forEach(b => {
					if (b.getAttribute('data-group') === 'none') b.classList.add('active');
					else b.classList.remove('active');
				});

				colButtons.forEach(b => {
					if (b.getAttribute('data-cols') === '2') b.classList.add('active');
					else b.classList.remove('active');
				});

				applyFiltersAndSort();
			}

			resetBtn?.addEventListener('click', resetFilters);
			emptyResetBtn?.addEventListener('click', resetFilters);
		</script>
	</body>
</html>
