---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import TongueLogo from '../../components/TongueLogo.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { generateSlidesFromPost } from '../../utils/slideEngine';

// Fetch all posts including drafts, sorted by date descending
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Calculate slide count and metadata for each post
const postsWithSlides = allPosts.map((post, index) => {
	const slides = generateSlidesFromPost(post.id, post.data.title, post.data.description, post.body || '');
	const cleanTitle = post.data.title.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ');
	const postNumber = allPosts.length - index;
	const isDraft = post.data.draft === true;
	const compactDate = post.data.pubDate.toLocaleDateString('en-US', {
		month: 'short',
		day: 'numeric',
		year: 'numeric'
	});
	return {
		post,
		cleanTitle,
		postNumber,
		isDraft,
		compactDate,
		slideCount: slides.length
	};
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Universal Slide Deck Hub | Decoding The Burn" 
			description="Access every blog post, preview private drafts, and launch public OBS presentation screens or private presenter cockpits." 
		/>
		<style>
			:root {
				--bg-dark: #07090e;
				--card-dark: #0f131a;
				--border-dark: #1e2638;
				--accent-red: #c8382c;
			}

			html, body {
				margin: 0;
				padding: 0;
				background: var(--bg-dark);
				color: #f1f5f9;
				font-family: var(--font-body, system-ui, sans-serif);
				min-height: 100vh;
			}

			/* Password Gate Styles */
			#viewerGate {
				max-width: 440px;
				margin: 6rem auto;
				background: #0e131f;
				padding: 3rem 2.5rem;
				border-radius: 20px;
				border: 1px solid rgba(139, 92, 246, 0.3);
				box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8), 0 0 30px rgba(139, 92, 246, 0.15);
				text-align: center;
			}

			.gate-icon {
				font-size: 2.75rem;
				margin-bottom: 1rem;
			}

			.gate-title {
				font-size: 1.65rem;
				font-weight: 800;
				color: #ffffff;
				margin-bottom: 0.5rem;
			}

			.gate-subtitle {
				color: #94a3b8;
				font-size: 0.9rem;
				line-height: 1.5;
				margin-bottom: 2rem;
			}

			.gate-form {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.gate-input {
				padding: 0.9rem 1.25rem;
				border-radius: 12px;
				border: 1.5px solid #2d3748;
				background: #07090e;
				color: #ffffff;
				font-size: 1.05rem;
				outline: none;
				text-align: center;
				transition: border-color 0.2s ease;
			}

			.gate-input:focus {
				border-color: #8b5cf6;
			}

			.gate-btn {
				padding: 0.9rem;
				font-size: 0.95rem;
				font-weight: 700;
				background: #7c3aed;
				color: #ffffff;
				border: none;
				border-radius: 12px;
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.gate-btn:hover {
				background: #6d28d9;
			}

			.gate-error {
				color: #f87171;
				font-size: 0.85rem;
				font-weight: 600;
				margin-top: 0.5rem;
				display: none;
			}

			/* Hub Container */
			.hub-container {
				max-width: 1240px;
				margin: 0 auto;
				padding: 3rem 1.5rem 5rem 1.5rem;
			}

			.hub-header {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				margin-bottom: 3.5rem;
				position: relative;
			}

			.hub-top-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
				margin-bottom: 1.5rem;
			}

			.hub-brand {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.hub-logo {
				width: 36px;
				height: 36px;
			}

			.hub-brand-name {
				font-size: 1.2rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				color: #ffffff;
			}

			.lock-btn {
				background: rgba(255, 255, 255, 0.05);
				border: 1px solid rgba(255, 255, 255, 0.15);
				color: #94a3b8;
				font-size: 0.75rem;
				font-weight: 600;
				padding: 0.4rem 0.85rem;
				border-radius: 8px;
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.lock-btn:hover {
				background: rgba(239, 68, 68, 0.15);
				color: #f87171;
				border-color: #ef4444;
			}

			.hub-title {
				font-family: var(--font-heading, system-ui, sans-serif);
				font-size: clamp(2rem, 4vw, 2.85rem);
				font-weight: 800;
				line-height: 1.15;
				color: #ffffff;
				margin: 0 auto 0.85rem auto;
				text-wrap: balance;
			}

			.hub-subheadline {
				font-size: 1.05rem;
				color: #94a3b8;
				max-width: 760px;
				margin: 0 auto;
				line-height: 1.55;
				text-wrap: balance;
			}

			/* Posts Grid */
			.posts-slides-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
				gap: 2rem;
				margin-bottom: 3.5rem;
			}

			.post-slide-card {
				background: var(--card-dark);
				border: 1px solid var(--border-dark);
				border-radius: 16px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				transition: all 0.22s ease;
			}

			.post-slide-card.draft-card {
				border-color: rgba(245, 158, 11, 0.45);
				background: linear-gradient(180deg, rgba(245, 158, 11, 0.04) 0%, var(--card-dark) 25%);
			}

			.post-slide-card.draft-card:hover {
				border-color: #f59e0b;
				box-shadow: 0 20px 45px -10px rgba(245, 158, 11, 0.22);
			}

			.post-slide-card:hover {
				border-color: #8b5cf6;
				transform: translateY(-3px);
				box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.6);
			}

			/* Clean Thumbnail: Zero badges on image */
			.card-thumb-box {
				width: 100%;
				aspect-ratio: 16 / 9;
				background: #090c12;
				position: relative;
				overflow: hidden;
				border-bottom: 1px solid var(--border-dark);
			}

			.card-thumb-img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.3s ease;
			}

			.post-slide-card:hover .card-thumb-img {
				transform: scale(1.03);
			}

			/* Card Content Box */
			.card-content-box {
				padding: 1.4rem;
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			/* Meta Header: Row 1 */
			.card-meta-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.5rem;
				margin-bottom: 0.55rem;
			}

			.meta-badges-group {
				display: flex;
				align-items: center;
				gap: 0.45rem;
				flex-wrap: wrap;
			}

			.entry-pill {
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.72rem;
				font-weight: 700;
				color: #f1f5f9;
				background: #1e2536;
				border: 1px solid rgba(255, 255, 255, 0.15);
				padding: 0.2rem 0.55rem;
				border-radius: 6px;
				letter-spacing: 0.02em;
			}

			.slide-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.72rem;
				font-weight: 600;
				color: #d8b4fe;
				background: rgba(168, 85, 247, 0.14);
				border: 1px solid rgba(168, 85, 247, 0.35);
				padding: 0.2rem 0.55rem;
				border-radius: 6px;
			}

			.meta-status-group {
				display: flex;
				align-items: center;
			}

			.status-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-size: 0.68rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				padding: 0.2rem 0.6rem;
				border-radius: 6px;
			}

			.status-live {
				background: rgba(34, 197, 94, 0.14);
				color: #4ade80;
				border: 1px solid rgba(34, 197, 94, 0.45);
			}

			.status-draft {
				background: rgba(245, 158, 11, 0.16);
				color: #fbbf24;
				border: 1px solid rgba(245, 158, 11, 0.5);
			}

			.status-dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				display: inline-block;
			}

			.dot-live {
				background: #22c55e;
				box-shadow: 0 0 6px rgba(34, 197, 94, 0.8);
			}

			.dot-draft {
				background: #f59e0b;
				box-shadow: 0 0 6px rgba(245, 158, 11, 0.8);
			}

			/* Meta Header: Row 2 Date */
			.card-date-row {
				display: flex;
				align-items: center;
				gap: 0.35rem;
				color: #64748b;
				font-size: 0.78rem;
				margin-bottom: 0.85rem;
				padding-bottom: 0.65rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.07);
			}

			.date-icon {
				opacity: 0.75;
				flex-shrink: 0;
			}

			.card-date-text {
				font-weight: 500;
				letter-spacing: 0.01em;
			}

			/* Post Title & Description */
			.card-post-title {
				font-family: var(--font-heading, system-ui, sans-serif);
				font-size: 1.15rem;
				font-weight: 700;
				line-height: 1.35;
				color: #ffffff;
				margin: 0 0 0.55rem 0;
				text-wrap: balance;
			}

			.card-post-desc {
				font-size: 0.86rem;
				color: #94a3b8;
				line-height: 1.5;
				margin-bottom: 1.4rem;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				text-wrap: pretty;
			}

			/* 2-Tier Action Buttons */
			.card-actions-wrapper {
				display: flex;
				flex-direction: column;
				gap: 0.55rem;
				margin-top: auto;
			}

			.btn-primary-article {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.45rem;
				width: 100%;
				padding: 0.62rem 1rem;
				background: rgba(255, 255, 255, 0.07);
				border: 1px solid rgba(255, 255, 255, 0.16);
				border-radius: 8px;
				color: #f8fafc;
				font-size: 0.82rem;
				font-weight: 700;
				text-decoration: none;
				transition: all 0.2s ease;
				box-sizing: border-box;
			}

			.btn-primary-article:hover {
				background: rgba(255, 255, 255, 0.13);
				border-color: rgba(255, 255, 255, 0.35);
				color: #ffffff;
				transform: translateY(-1px);
			}

			.btn-arrow {
				transition: transform 0.2s ease;
				opacity: 0.6;
			}

			.btn-primary-article:hover .btn-arrow {
				transform: translateX(3px);
				opacity: 1;
			}

			.btn-deck-tools-row {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.55rem;
				width: 100%;
			}

			.deck-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.35rem;
				padding: 0.55rem 0.5rem;
				border-radius: 8px;
				font-size: 0.76rem;
				font-weight: 700;
				text-decoration: none;
				transition: all 0.18s ease;
				box-sizing: border-box;
				text-align: center;
			}

			.obs-btn {
				background: rgba(59, 130, 246, 0.12);
				color: #93c5fd;
				border: 1px solid rgba(59, 130, 246, 0.32);
			}

			.obs-btn:hover {
				background: #2563eb;
				color: #ffffff;
				border-color: #2563eb;
				box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
			}

			.cockpit-btn {
				background: rgba(239, 68, 68, 0.12);
				color: #fca5a5;
				border: 1px solid rgba(239, 68, 68, 0.32);
			}

			.cockpit-btn:hover {
				background: #dc2626;
				color: #ffffff;
				border-color: #dc2626;
				box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
			}

			/* Guide Box */
			.hub-guide-box {
				background: #0d1118;
				border: 1px solid #1e2638;
				border-radius: 12px;
				padding: 1.75rem 2rem;
				margin-bottom: 3rem;
			}

			.hub-guide-title {
				font-size: 1.05rem;
				font-weight: 700;
				color: #ffffff;
				margin-bottom: 1rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.guide-steps {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5rem;
			}

			.guide-step {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}

			.step-number {
				font-family: monospace;
				font-size: 0.8rem;
				font-weight: 700;
				color: #ef4444;
			}

			.step-heading {
				font-size: 0.95rem;
				font-weight: 600;
				color: #e2e8f0;
			}

			.step-text {
				font-size: 0.85rem;
				color: #94a3b8;
				line-height: 1.45;
			}

			kbd {
				background: rgba(255, 255, 255, 0.08);
				border: 1px solid rgba(255, 255, 255, 0.15);
				border-radius: 4px;
				padding: 0.15rem 0.4rem;
				font-family: monospace;
				font-size: 0.75rem;
				color: #f1f5f9;
			}

			.hub-footer-nav {
				display: flex;
				justify-content: center;
				gap: 1.5rem;
			}

			.hub-nav-link {
				color: #94a3b8;
				font-size: 0.9rem;
				text-decoration: none;
				transition: color 0.18s ease;
			}

			.hub-nav-link:hover {
				color: #ffffff;
			}
		</style>
	</head>
	<body>
		<!-- Password Gate -->
		<div id="viewerGate">
			<div class="gate-icon">🔒</div>
			<h1 class="gate-title">Cockpit Access</h1>
			<p class="gate-subtitle">Enter your presenter passcode to access all published articles, private drafts, and slide decks.</p>
			
			<form id="viewerGateForm" class="gate-form">
				<input 
					type="password" 
					id="viewerPasscode" 
					placeholder="Enter passcode..." 
					required 
					class="gate-input"
				/>
				<button type="submit" class="gate-btn">Unlock Presenter Hub →</button>
				<p id="viewerErrorMsg" class="gate-error">Incorrect passcode. Please try again.</p>
			</form>
		</div>

		<!-- Protected Content (Hidden until unlocked) -->
		<div id="viewerContent" style="display: none;">
			<main class="hub-container">
				<header class="hub-header">
					<div class="hub-top-bar">
						<div class="hub-brand">
							<div class="hub-logo">
								<TongueLogo />
							</div>
							<span class="hub-brand-name">Decoding The Burn</span>
						</div>
						<button id="viewerLockBtn" class="lock-btn">Lock Cockpit 🔒</button>
					</div>

					<h1 class="hub-title">Master Presenter &amp; Drafts&nbsp;Hub</h1>
					<p class="hub-subheadline">
						All {allPosts.length} entries (live and drafts). Each article automatically generates its 5-word presentation deck. Launch the article, public OBS screen, or teleprompter&nbsp;cockpit.
					</p>
				</header>

				<!-- All Blog Posts as Presentation Decks & Articles -->
				<div class="posts-slides-grid">
					{postsWithSlides.map(({ post, cleanTitle, postNumber, isDraft, compactDate, slideCount }) => (
						<div class={`post-slide-card ${isDraft ? 'draft-card' : ''}`}>
							<!-- Clean Image: Zero badges on thumbnail -->
							<div class="card-thumb-box">
								<img 
									src={post.data.heroImage || '/how_i_solved_my_bms_thumbnail.jpg'} 
									alt={cleanTitle} 
									class="card-thumb-img"
									loading="lazy"
								/>
							</div>

							<!-- Card Content -->
							<div class="card-content-box">
								<div>
									<!-- Metadata Header: Entry #, Slides, Status -->
									<div class="card-meta-header">
										<div class="meta-badges-group">
											<span class="entry-pill">Entry #{postNumber}</span>
											<span class="slide-pill">
												<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
												{slideCount} Slides
											</span>
										</div>
										<div class="meta-status-group">
											{isDraft ? (
												<span class="status-pill status-draft">
													<span class="status-dot dot-draft"></span>
													Draft
												</span>
											) : (
												<span class="status-pill status-live">
													<span class="status-dot dot-live"></span>
													Live
												</span>
											)}
										</div>
									</div>

									<!-- Compact Clean Date Row -->
									<div class="card-date-row">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="date-icon"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
										<span class="card-date-text">{compactDate}</span>
									</div>

									<h2 class="card-post-title" set:html={post.data.title} />
									<p class="card-post-desc">{post.data.description}</p>
								</div>

								<!-- 2-Tier Action Buttons: Full-width Article read/preview + 50/50 Deck Tools -->
								<div class="card-actions-wrapper">
									<a href={`/blog/${post.id}/`} class="btn-primary-article" title={isDraft ? "Preview Private Draft Article" : "Read Full Article"}>
										<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
										<span>{isDraft ? 'Preview Private Draft' : 'Read Full Article'}</span>
										<span class="btn-arrow">→</span>
									</a>

									<div class="btn-deck-tools-row">
										<a href={`/viewer/${post.id}/public`} class="deck-btn obs-btn" title="Open Clean Public Screen for OBS">
											<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
											<span>Public OBS</span>
										</a>
										<a href={`/viewer/${post.id}/private`} class="deck-btn cockpit-btn" title="Open Denis's Teleprompter Cockpit">
											<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
											<span>Cockpit</span>
										</a>
									</div>
								</div>
							</div>
						</div>
					))}
				</div>

				<!-- Quick Recording Instructions -->
				<div class="hub-guide-box">
					<div class="hub-guide-title">
						<svg viewBox="0 0 24 24" width="18" height="18" stroke="#ef4444" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
						<span>How Real-Time Sync Works</span>
					</div>
					<div class="guide-steps">
						<div class="guide-step">
							<span class="step-number">STEP 1: LAUNCH PUBLIC</span>
							<span class="step-heading">Open Public OBS View</span>
							<p class="step-text">
								Open <strong>OBS 📺</strong> in a separate window or monitor. Point OBS Window Capture directly to it.
							</p>
						</div>
						<div class="guide-step">
							<span class="step-number">STEP 2: LAUNCH COCKPIT</span>
