---
import BaseHead from '../../components/BaseHead.astro';
import TongueLogo from '../../components/TongueLogo.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Presentation Hub: Public & Private Viewers | Decoding The Burn" 
			description="Choose your presentation mode: Public Viewer for OBS screen capture or Private Presenter Cockpit with speaker notes and teleprompter." 
		/>
		<style>
			:root {
				--bg-dark: #07090e;
				--card-dark: #0f131a;
				--border-dark: #1e2638;
				--accent-red: #c8382c;
			}

			html, body {
				margin: 0;
				padding: 0;
				background: var(--bg-dark);
				color: #f1f5f9;
				font-family: var(--font-body, system-ui, sans-serif);
				min-height: 100vh;
			}

			.hub-container {
				max-width: 1080px;
				margin: 0 auto;
				padding: 3rem 1.5rem;
			}

			.hub-header {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				margin-bottom: 3.5rem;
			}

			.hub-brand {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 1.25rem;
			}

			.hub-logo {
				width: 38px;
				height: 38px;
			}

			.hub-brand-name {
				font-size: 1.25rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				color: #ffffff;
			}

			.hub-title {
				font-family: var(--font-heading, system-ui, sans-serif);
				font-size: clamp(2rem, 4vw, 2.75rem);
				font-weight: 800;
				line-height: 1.15;
				color: #ffffff;
				margin-bottom: 1rem;
				text-wrap: balance;
			}

			.hub-subheadline {
				font-size: 1.1rem;
				color: #94a3b8;
				max-width: 680px;
				line-height: 1.6;
				text-wrap: balance;
			}

			.viewers-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 2rem;
				margin-bottom: 3.5rem;
			}

			.viewer-card {
				background: var(--card-dark);
				border: 2px solid var(--border-dark);
				border-radius: 16px;
				padding: 2.25rem 2rem;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				text-decoration: none;
				color: inherit;
				position: relative;
				overflow: hidden;
				transition: all 0.22s ease;
			}

			.viewer-card:hover {
				border-color: #ef4444;
				transform: translateY(-4px);
				box-shadow: 0 20px 45px -10px rgba(239, 68, 68, 0.25);
			}

			.viewer-card.public-card:hover {
				border-color: #3b82f6;
				box-shadow: 0 20px 45px -10px rgba(59, 130, 246, 0.25);
			}

			.card-tag {
				font-family: monospace;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				padding: 0.25rem 0.65rem;
				border-radius: 6px;
				display: inline-block;
				margin-bottom: 1.25rem;
				width: fit-content;
			}

			.public-tag {
				color: #60a5fa;
				background: rgba(59, 130, 246, 0.12);
				border: 1px solid rgba(59, 130, 246, 0.3);
			}

			.private-tag {
				color: #f87171;
				background: rgba(239, 68, 68, 0.12);
				border: 1px solid rgba(239, 68, 68, 0.3);
			}

			.card-title {
				font-family: var(--font-heading, system-ui, sans-serif);
				font-size: 1.6rem;
				font-weight: 700;
				color: #ffffff;
				margin-bottom: 0.75rem;
			}

			.card-desc {
				font-size: 0.95rem;
				color: #94a3b8;
				line-height: 1.55;
				margin-bottom: 1.5rem;
			}

			.card-features {
				list-style: none;
				padding: 0;
				margin: 0 0 2rem 0;
				display: flex;
				flex-direction: column;
				gap: 0.65rem;
			}

			.card-feature-item {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				font-size: 0.88rem;
				color: #cbd5e1;
			}

			.card-feature-item svg {
				flex-shrink: 0;
				color: #22c55e;
			}

			.card-action-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				font-size: 0.95rem;
				font-weight: 700;
				padding: 0.85rem 1.5rem;
				border-radius: 8px;
				transition: all 0.18s ease;
			}

			.public-btn {
				background: #2563eb;
				color: #ffffff;
			}

			.public-btn:hover {
				background: #3b82f6;
			}

			.private-btn {
				background: #c8382c;
				color: #ffffff;
			}

			.private-btn:hover {
				background: #dc2626;
			}

			.hub-guide-box {
				background: #0d1118;
				border: 1px solid #1e2638;
				border-radius: 12px;
				padding: 1.75rem 2rem;
				margin-bottom: 3rem;
			}

			.hub-guide-title {
				font-size: 1.1rem;
				font-weight: 700;
				color: #ffffff;
				margin-bottom: 1rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.guide-steps {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5rem;
			}

			.guide-step {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}

			.step-number {
				font-family: monospace;
				font-size: 0.8rem;
				font-weight: 700;
				color: #ef4444;
			}

			.step-heading {
				font-size: 0.95rem;
				font-weight: 600;
				color: #e2e8f0;
			}

			.step-text {
				font-size: 0.85rem;
				color: #94a3b8;
				line-height: 1.45;
			}

			.hub-footer-nav {
				display: flex;
				justify-content: center;
				gap: 1.5rem;
			}

			.hub-nav-link {
				color: #94a3b8;
				font-size: 0.9rem;
				text-decoration: none;
				transition: color 0.18s ease;
			}

			.hub-nav-link:hover {
				color: #ffffff;
			}
		</style>
	</head>
	<body>
		<main class="hub-container">
			<header class="hub-header">
				<div class="hub-brand">
					<div class="hub-logo">
						<TongueLogo />
					</div>
					<span class="hub-brand-name">Decoding The Burn</span>
				</div>
				<h1 class="hub-title">Presentation Control&nbsp;Center</h1>
				<p class="hub-subheadline">
					Choose your viewer mode below. Both viewers automatically sync in real-time when running on multiple screens or inside OBS.
				</p>
			</header>

			<div class="viewers-grid">
				<!-- Public Viewer Card -->
				<a href="/viewer/public" class="viewer-card public-card">
					<div>
						<span class="card-tag public-tag">FOR AUDIENCE & OBS</span>
						<h2 class="card-title">Public Viewer</h2>
						<p class="card-desc">
							The clean, borderless slide presentation. Shows 5-word bullet reveals, large titles, and brand logo. Perfect for screen capture.
						</p>
						<ul class="card-features">
							<li class="card-feature-item">
								<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg>
								<span>Short, punchy 5-word bullet points</span>
							</li>
							<li class="card-feature-item">
								<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg>
								<span>Step-by-step Spacebar reveal</span>
							</li>
							<li class="card-feature-item">
								<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg>
								<span>Borderless 16:9 widescreen canvas</span>
							</li>
							<li class="card-feature-item">
								<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg>
								<span>Syncs with your Private Cockpit</span>
							</li>
						</ul>
					</div>
					<div class="card-action-btn public-btn">
						<span>Launch Public Viewer</span>
						<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="9 18 15 12 9 6"></polyline></svg>
					</div>
				</a>

				<!-- Private Presenter Card -->
				<a href="/viewer/private" class="viewer-card private-card">
					<div>
						<span class="card-tag private-tag">FOR DENNIS (SPEAKER)</span>
						<h2 class="card-title">Private Cockpit</h2>
						<p class="card-desc">
							Your personal teleprompter and control dashboard. Displays live talking points, elapsed timer, next slide preview, and remote controls.
						</p>
						<ul class="card-features">
							<li class="card-feature-item">
								<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg>
								<span>Full speaker notes and talking points</span>
							</li>
							<li class="card-feature-item">
								<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg>
								<span>Live elapsed recording timer</span>
							</li>
							<li class="card-feature-item">
								<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg>
								<span>Upcoming slide preview window</span>
							</li>
							<li class="card-feature-item">
								<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="20 6 9 17 4 12"></polyline></svg>
								<span>Remote controls the Public Viewer</span>
							</li>
						</ul>
					</div>
					<div class="card-action-btn private-btn">
						<span>Launch Private Cockpit</span>
						<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><polyline points="9 18 15 12 9 6"></polyline></svg>
					</div>
				</a>
			</div>

			<!-- Recording Setup Guide -->
			<div class="hub-guide-box">
				<div class="hub-guide-title">
					<svg viewBox="0 0 24 24" width="18" height="18" stroke="#ef4444" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
					<span>How to Record with OBS (Dual or Single Monitor)</span>
				</div>
				<div class="guide-steps">
					<div class="guide-step">
						<span class="step-number">OPTION A: DUAL SCREEN</span>
						<span class="step-heading">Open Both Viewers</span>
						<p class="step-text">
							Put <strong>Public Viewer</strong> on Monitor 2 (capture this in OBS). Open <strong>Private Cockpit</strong> on Monitor 1. When you press Spacebar on Monitor 1, Monitor 2 updates automatically!
						</p>
					</div>
					<div class="guide-step">
						<span class="step-number">OPTION B: SINGLE SCREEN</span>
						<span class="step-heading">Window Capture Mode</span>
						<p class="step-text">
							Open Public Viewer in a separate browser window and point OBS Window Capture to it. Keep Private Cockpit active in front of you while talking.
						</p>
					</div>
					<div class="guide-step">
						<span class="step-number">STEP 3: KEYBOARD SHORTCUTS</span>
						<span class="step-heading">Spacebar Navigation</span>
						<p class="step-text">
							Use <kbd>Spacebar</kbd> to step through each 5-word bullet. Use <kbd>Shift+Space</kbd> to step back. Hit <kbd>F</kbd> anytime for full borderless view.
						</p>
					</div>
				</div>
			</div>

			<footer class="hub-footer-nav">
				<a href="/blog/how-i-solved-my-burning-mouth-syndrome" class="hub-nav-link">← Read the Full Blog Post</a>
				<span style="color: #334155;">•</span>
				<a href="/" class="hub-nav-link">Decoding The Burn Home</a>
			</footer>
		</main>
	</body>
</html>
