---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import TongueLogo from '../../components/TongueLogo.astro';
import { generateSlidesFromPost } from '../../utils/slideEngine';

const posts = await getCollection('blog', ({ data }) => {
	return import.meta.env.DEV || !data.draft;
});

// Calculate slide count for each post
const postsWithSlides = posts.map((post) => {
	const slides = generateSlidesFromPost(post.id, post.data.title, post.data.description, post.body || '');
	const cleanTitle = post.data.title.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ');
	return {
		post,
		cleanTitle,
		slideCount: slides.length
	};
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Universal Slide Deck Hub | Decoding The Burn" 
			description="Select any blog post on Decoding The Burn to launch its public OBS slides or private presenter cockpit." 
		/>
		<style>
			:root {
				--bg-dark: #07090e;
				--card-dark: #0f131a;
				--border-dark: #1e2638;
				--accent-red: #c8382c;
			}

			html, body {
				margin: 0;
				padding: 0;
				background: var(--bg-dark);
				color: #f1f5f9;
				font-family: var(--font-body, system-ui, sans-serif);
				min-height: 100vh;
			}

			.hub-container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 3rem 1.5rem;
			}

			.hub-header {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				margin-bottom: 3.5rem;
			}

			.hub-brand {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 1.25rem;
			}

			.hub-logo {
				width: 38px;
				height: 38px;
			}

			.hub-brand-name {
				font-size: 1.25rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				color: #ffffff;
			}

			.hub-title {
				font-family: var(--font-heading, system-ui, sans-serif);
				font-size: clamp(2rem, 4vw, 2.75rem);
				font-weight: 800;
				line-height: 1.15;
				color: #ffffff;
				margin-bottom: 1rem;
				text-wrap: balance;
			}

			.hub-subheadline {
				font-size: 1.1rem;
				color: #94a3b8;
				max-width: 720px;
				line-height: 1.6;
				text-wrap: balance;
			}

			/* Posts Grid */
			.posts-slides-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
				gap: 2rem;
				margin-bottom: 3.5rem;
			}

			.post-slide-card {
				background: var(--card-dark);
				border: 1px solid var(--border-dark);
				border-radius: 14px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				transition: all 0.22s ease;
			}

			.post-slide-card:hover {
				border-color: #3b82f6;
				transform: translateY(-3px);
				box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.5);
			}

			.card-thumb-box {
				width: 100%;
				aspect-ratio: 16 / 9;
				background: #090c12;
				position: relative;
				overflow: hidden;
				border-bottom: 1px solid var(--border-dark);
			}

			.card-thumb-img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.3s ease;
			}

			.post-slide-card:hover .card-thumb-img {
				transform: scale(1.03);
			}

			.card-badges-row {
				position: absolute;
				top: 10px;
				left: 10px;
				display: flex;
				gap: 0.5rem;
			}

			.slide-count-badge {
				font-family: monospace;
				font-size: 0.72rem;
				font-weight: 700;
				color: #ffffff;
				background: rgba(0, 0, 0, 0.75);
				border: 1px solid rgba(255, 255, 255, 0.2);
				padding: 0.2rem 0.55rem;
				border-radius: 4px;
				backdrop-filter: blur(4px);
			}

			.card-content-box {
				padding: 1.5rem;
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			.card-post-title {
				font-family: var(--font-heading, system-ui, sans-serif);
				font-size: 1.25rem;
				font-weight: 700;
				line-height: 1.3;
				color: #ffffff;
				margin-bottom: 0.6rem;
			}

			.card-post-desc {
				font-size: 0.88rem;
				color: #94a3b8;
				line-height: 1.5;
				margin-bottom: 1.25rem;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.card-actions-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.75rem;
			}

			.action-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.4rem;
				font-size: 0.82rem;
				font-weight: 700;
				padding: 0.6rem 0.75rem;
				border-radius: 6px;
				text-decoration: none;
				transition: all 0.15s ease;
			}

			.public-btn {
				background: rgba(59, 130, 246, 0.12);
				color: #60a5fa;
				border: 1px solid rgba(59, 130, 246, 0.35);
			}

			.public-btn:hover {
				background: #2563eb;
				color: #ffffff;
				border-color: #2563eb;
			}

			.private-btn {
				background: rgba(239, 68, 68, 0.12);
				color: #f87171;
				border: 1px solid rgba(239, 68, 68, 0.35);
			}

			.private-btn:hover {
				background: #dc2626;
				color: #ffffff;
				border-color: #dc2626;
			}

			/* Guide Box */
			.hub-guide-box {
				background: #0d1118;
				border: 1px solid #1e2638;
				border-radius: 12px;
				padding: 1.75rem 2rem;
				margin-bottom: 3rem;
			}

			.hub-guide-title {
				font-size: 1.1rem;
				font-weight: 700;
				color: #ffffff;
				margin-bottom: 1rem;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.guide-steps {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5rem;
			}

			.guide-step {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}

			.step-number {
				font-family: monospace;
				font-size: 0.8rem;
				font-weight: 700;
				color: #ef4444;
			}

			.step-heading {
				font-size: 0.95rem;
				font-weight: 600;
				color: #e2e8f0;
			}

			.step-text {
				font-size: 0.85rem;
				color: #94a3b8;
				line-height: 1.45;
			}

			kbd {
				background: rgba(255, 255, 255, 0.08);
				border: 1px solid rgba(255, 255, 255, 0.15);
				border-radius: 4px;
				padding: 0.15rem 0.4rem;
				font-family: monospace;
				font-size: 0.75rem;
				color: #f1f5f9;
			}

			.hub-footer-nav {
				display: flex;
				justify-content: center;
				gap: 1.5rem;
			}

			.hub-nav-link {
				color: #94a3b8;
				font-size: 0.9rem;
				text-decoration: none;
				transition: color 0.18s ease;
			}

			.hub-nav-link:hover {
				color: #ffffff;
			}
		</style>
	</head>
	<body>
		<main class="hub-container">
			<header class="hub-header">
				<div class="hub-brand">
					<div class="hub-logo">
						<TongueLogo />
					</div>
					<span class="hub-brand-name">Decoding The Burn</span>
				</div>
				<h1 class="hub-title">Universal Presentation&nbsp;Hub</h1>
				<p class="hub-subheadline">
					Every blog post automatically generates its own interactive 5-word presentation deck. Choose any article below to launch the Public Screen or Private Presenter Cockpit.
				</p>
			</header>

			<!-- All Blog Posts as Presentation Decks -->
			<div class="posts-slides-grid">
				{postsWithSlides.map(({ post, cleanTitle, slideCount }) => (
					<div class="post-slide-card">
						<div class="card-thumb-box">
							<img 
								src={post.data.heroImage || '/how_i_solved_my_bms_thumbnail.jpg'} 
								alt={cleanTitle} 
								class="card-thumb-img"
								loading="lazy"
							/>
							<div class="card-badges-row">
								<span class="slide-count-badge">{slideCount} Slides</span>
							</div>
						</div>

						<div class="card-content-box">
							<div>
								<h2 class="card-post-title">{cleanTitle}</h2>
								<p class="card-post-desc">{post.data.description}</p>
							</div>

							<div class="card-actions-grid">
								<a href={`/viewer/${post.id}/public`} class="action-btn public-btn" title="Open Clean Public Screen for OBS">
									<svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
									<span>Public OBS ↗</span>
								</a>
								<a href={`/viewer/${post.id}/private`} class="action-btn private-btn" title="Open Denis's Teleprompter Cockpit">
									<svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
									<span>Cockpit ↗</span>
								</a>
							</div>
						</div>
					</div>
				))}
			</div>

			<!-- Quick Recording Instructions -->
			<div class="hub-guide-box">
				<div class="hub-guide-title">
					<svg viewBox="0 0 24 24" width="18" height="18" stroke="#ef4444" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
					<span>How Real-Time Sync Works</span>
				</div>
				<div class="guide-steps">
					<div class="guide-step">
						<span class="step-number">STEP 1: LAUNCH PUBLIC</span>
						<span class="step-heading">Open Public OBS View</span>
						<p class="step-text">
							Open the <strong>Public OBS</strong> viewer in a separate window or monitor. Point OBS Window Capture to it.
						</p>
					</div>
					<div class="guide-step">
						<span class="step-number">STEP 2: LAUNCH COCKPIT</span>
						<span class="step-heading">Open Presenter Cockpit</span>
						<p class="step-text">
							Open <strong>Cockpit</strong> in front of you. It shows live teleprompter notes and an elapsed timer.
						</p>
					</div>
					<div class="guide-step">
						<span class="step-number">STEP 3: HIT SPACEBAR</span>
						<span class="step-heading">Automatic Sync</span>
						<p class="step-text">
							Tapping <kbd>Spacebar</kbd> in your Cockpit advances BOTH your screen and the Public OBS screen simultaneously!
						</p>
					</div>
				</div>
			</div>

			<footer class="hub-footer-nav">
				<a href="/blog" class="hub-nav-link">← All Blog Posts</a>
				<span style="color: #334155;">•</span>
				<a href="/" class="hub-nav-link">Decoding The Burn Home</a>
			</footer>
		</main>
	</body>
</html>
