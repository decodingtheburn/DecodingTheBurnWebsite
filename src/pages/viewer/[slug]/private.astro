---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import TongueLogo from '../../../components/TongueLogo.astro';
import { generateSlidesFromPost } from '../../../utils/slideEngine';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			post,
			slides: generateSlidesFromPost(post.id, post.data.title, post.data.description, post.body || '')
		},
	}));
}

const { post, slides } = Astro.props;
const cleanTitle = post.data.title.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title={`Presenter Cockpit: ${cleanTitle} | Decoding The Burn`}
			description={`Denis's private presenter dashboard for ${cleanTitle} with live teleprompter notes and timer.`}
		/>
		<style is:global>
			:root {
				--bg-darkest: #07090d;
				--panel-bg: #0d1118;
				--border-color: #212a3d;
				--accent-red: #ef4444;
			}

			html, body {
				margin: 0;
				padding: 0;
				background: var(--bg-darkest);
				color: #f1f5f9;
				font-family: var(--font-body, system-ui, sans-serif);
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}

			.cockpit-top-bar {
				background: #0a0d14;
				border-bottom: 1px solid var(--border-color);
				padding: 0.75rem 1.5rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				position: sticky;
				top: 0;
				z-index: 100;
			}

			.top-left {
				display: flex;
				align-items: center;
				gap: 1rem;
			}

			.cockpit-logo-link {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				text-decoration: none;
				color: #ffffff;
			}

			.logo-mini {
				width: 26px;
				height: 26px;
			}

			.logo-title {
				font-size: 0.95rem;
				font-weight: 800;
				letter-spacing: -0.01em;
			}

			.slide-status-badge {
				font-family: monospace;
				font-size: 0.8rem;
				font-weight: 700;
				color: #cbd5e1;
				background: rgba(255, 255, 255, 0.08);
				border: 1px solid rgba(255, 255, 255, 0.15);
				padding: 0.25rem 0.65rem;
				border-radius: 6px;
			}

			.topic-status-badge {
				font-size: 0.78rem;
				font-weight: 700;
				color: #f87171;
				background: rgba(239, 68, 68, 0.1);
				border: 1px solid rgba(239, 68, 68, 0.25);
				padding: 0.25rem 0.75rem;
				border-radius: 6px;
			}

			.top-center {
				display: flex;
				align-items: center;
				gap: 1rem;
			}

			.timer-box {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				background: rgba(0, 0, 0, 0.4);
				border: 1px solid var(--border-color);
				border-radius: 8px;
				padding: 0.35rem 0.85rem;
			}

			.timer-display {
				font-family: monospace;
				font-size: 1.15rem;
				font-weight: 700;
				color: #38bdf8;
				letter-spacing: 0.05em;
			}

			.timer-btn {
				background: transparent;
				border: 1px solid rgba(255, 255, 255, 0.15);
				color: #94a3b8;
				font-size: 0.72rem;
				font-weight: 600;
				padding: 0.2rem 0.5rem;
				border-radius: 4px;
				cursor: pointer;
				transition: all 0.15s ease;
			}

			.timer-btn:hover {
				background: rgba(255, 255, 255, 0.1);
				color: #ffffff;
			}

			.top-right {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.sync-pill {
				font-size: 0.75rem;
				font-weight: 600;
				color: #22c55e;
				background: rgba(34, 197, 94, 0.1);
				border: 1px solid rgba(34, 197, 94, 0.25);
				padding: 0.25rem 0.65rem;
				border-radius: 6px;
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}

			.sync-led {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: #22c55e;
				box-shadow: 0 0 6px #22c55e;
			}

			.top-action-link {
				font-size: 0.78rem;
				font-weight: 600;
				color: #cbd5e1;
				background: rgba(255, 255, 255, 0.05);
				border: 1px solid var(--border-color);
				padding: 0.35rem 0.75rem;
				border-radius: 6px;
				text-decoration: none;
				transition: all 0.18s ease;
			}

			.top-action-link:hover {
				color: #ffffff;
				background: rgba(255, 255, 255, 0.1);
				border-color: #475569;
			}

			.cockpit-main {
				flex: 1;
				display: grid;
				grid-template-columns: 1.15fr 0.85fr;
				gap: 1.5rem;
				padding: 1.5rem;
				box-sizing: border-box;
				max-width: 1700px;
				margin: 0 auto;
				width: 100%;
			}

			.slide-panel {
				background: var(--panel-bg);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 2rem 2.5rem;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}

			.slide-title-display {
				font-family: var(--font-heading, system-ui, sans-serif);
				font-size: clamp(2rem, 3.2vw, 2.8rem);
				font-weight: 900;
				line-height: 1.18;
				color: #ffffff;
				margin: 0 0 2rem 0;
				text-wrap: balance;
				letter-spacing: -0.02em;
			}

			.cockpit-bullets {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1.35rem;
			}

			.cockpit-bullet-item {
				display: flex;
				align-items: center;
				gap: 1.15rem;
				font-size: clamp(1.4rem, 2.2vw, 1.85rem);
				font-weight: 600;
				line-height: 1.35;
				cursor: pointer;
				padding: 0.6rem 0.85rem;
				border-radius: 8px;
				transition: all 0.2s ease;
			}

			.cockpit-bullet-item:hover {
				background: rgba(255, 255, 255, 0.06);
			}

			.bullet-dot-indicator {
				width: 16px;
				height: 16px;
				border-radius: 50%;
				flex-shrink: 0;
				transition: all 0.22s ease;
			}

			.bullet-text-content {
				color: #ffffff !important;
				flex: 1;
			}

			/* 1. LIVE (ACTIVE) POINT: Glowing Emerald Green (Denis: green for the live one) */
			.cockpit-bullet-item.is-active {
				background: rgba(34, 197, 94, 0.18) !important;
				border: 2px solid #22c55e !important;
				box-shadow: 0 0 20px rgba(34, 197, 94, 0.35), inset 0 0 10px rgba(34, 197, 94, 0.15) !important;
				transform: translateX(8px);
			}

			.cockpit-bullet-item.is-active .bullet-dot-indicator {
				background: #22c55e !important;
				box-shadow: 0 0 16px #22c55e, 0 0 30px rgba(34, 197, 94, 0.7) !important;
				transform: scale(1.35);
			}

			.cockpit-bullet-item.is-active .bullet-text-content {
				color: #ffffff !important;
				font-weight: 800 !important;
				text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
			}

			/* 2. INACTIVE / UPCOMING POINTS: Red Dot Accent with 100% VISIBLE TEXT (Denis: red for inactive, text visible all the time) */
			.cockpit-bullet-item.is-dimmed {
				opacity: 1 !important; /* 100% visible, NEVER dark or faded */
				background: rgba(239, 68, 68, 0.06) !important;
				border: 1.5px solid rgba(239, 68, 68, 0.35) !important;
			}

			.cockpit-bullet-item.is-dimmed .bullet-dot-indicator {
				background: #ef4444 !important;
				box-shadow: 0 0 10px rgba(239, 68, 68, 0.7) !important;
				transform: scale(1);
			}

			.cockpit-bullet-item.is-dimmed .bullet-text-content {
				color: #f1f5f9 !important; /* Crisp, readable light text */
				font-weight: 600 !important;
			}

			/* 3. REVEALED / PAST POINTS: Clean finished status with soft gray/cyan dot */
			.cockpit-bullet-item.is-revealed {
				opacity: 0.88 !important;
				background: rgba(255, 255, 255, 0.03) !important;
				border: 1.5px solid rgba(255, 255, 255, 0.1) !important;
			}

			.cockpit-bullet-item.is-revealed .bullet-dot-indicator {
				background: #64748b !important;
				box-shadow: none !important;
			}

			.cockpit-bullet-item.is-revealed .bullet-text-content {
				color: #cbd5e1 !important;
				font-weight: 600 !important;
			}

			.cockpit-nav-dock {
				margin-top: 2rem;
				padding-top: 1.25rem;
				border-top: 1px solid var(--border-color);
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			.nav-buttons-group {
				display: flex;
				gap: 0.75rem;
			}

			.nav-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.95rem;
				font-weight: 700;
				padding: 0.65rem 1.25rem;
				border-radius: 8px;
				cursor: pointer;
				border: none;
				transition: all 0.15s ease;
			}

			.nav-btn-prev {
				background: #1e293b;
				color: #e2e8f0;
				border: 1px solid #334155;
			}

			.nav-btn-prev:hover {
				background: #334155;
				color: #ffffff;
			}

			.nav-btn-next {
				background: #c8382c;
				color: #ffffff;
				box-shadow: 0 0 14px rgba(200, 56, 44, 0.4);
			}

			.nav-btn-next:hover {
				background: #dc2626;
				box-shadow: 0 0 20px rgba(220, 38, 38, 0.6);
			}

			.nav-status-text {
				font-size: 0.85rem;
				color: #94a3b8;
			}

			.notes-panel {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			.notes-card {
				background: var(--panel-bg);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 1.75rem;
				flex: 1;
				display: flex;
				flex-direction: column;
			}

			.card-header-label {
				font-size: 0.78rem;
				font-weight: 800;
				letter-spacing: 0.08em;
				color: #38bdf8;
				margin-bottom: 0.85rem;
				display: flex;
				align-items: center;
				gap: 0.45rem;
			}

			.notes-content-box {
				background: #080b12 !important;
				border: 1.5px solid #252f44 !important;
				border-radius: 10px;
				padding: 1.5rem;
				flex: 1;
				overflow-y: auto;
				font-size: 1.35rem !important;
				line-height: 1.8 !important;
				color: #f8fafc !important;
				font-weight: 500;
			}

			.notes-content-box p {
				margin: 0 0 1.15rem 0 !important;
				color: #ffffff !important;
				font-size: 1.35rem !important;
				line-height: 1.8 !important;
				font-weight: 600 !important;
			}

			.notes-content-box p:last-child {
				margin-bottom: 0 !important;
			}

			.notes-legal-card {
				background: rgba(239, 68, 68, 0.18) !important;
				border: 2px solid rgba(239, 68, 68, 0.55) !important;
				border-radius: 8px;
				padding: 1.15rem 1.35rem;
				margin-top: 1.25rem;
			}

			.notes-legal-card-header {
				font-size: 0.85rem !important;
				font-weight: 800 !important;
				letter-spacing: 0.08em;
				color: #f87171 !important;
				display: flex;
				align-items: center;
				gap: 0.45rem;
				margin-bottom: 0.5rem;
			}

			.notes-legal-card-body {
				font-size: 1.15rem !important;
				line-height: 1.7 !important;
				color: #ffffff !important;
				font-weight: 600 !important;
			}

			.notes-spoken-card {
				background: rgba(56, 189, 248, 0.18) !important;
				border: 2px solid rgba(56, 189, 248, 0.55) !important;
				border-radius: 8px;
				padding: 1.25rem 1.45rem;
				margin-bottom: 1.25rem;
			}

			.notes-spoken-card-header {
				font-size: 0.88rem !important;
				font-weight: 800 !important;
				letter-spacing: 0.08em;
				color: #38bdf8 !important;
				display: flex;
				align-items: center;
				gap: 0.45rem;
				margin-bottom: 0.6rem;
			}

			.notes-spoken-card-body {
				font-size: 1.28rem !important;
				line-height: 1.8 !important;
				color: #ffffff !important;
				font-weight: 700 !important;
				font-style: italic;
			}

			.next-preview-card {
				background: var(--panel-bg);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 1.25rem 1.5rem;
			}

			.next-preview-title {
				font-size: 1.05rem;
				font-weight: 700;
				color: #ffffff;
				margin: 0.25rem 0 0.5rem 0;
			}

			.next-preview-first-bullet {
				font-size: 0.9rem;
				color: #94a3b8;
				display: flex;
				align-items: center;
				gap: 0.45rem;
			}

			.slide-switcher-bar {
				background: #0a0d14;
				border-top: 1px solid var(--border-color);
				padding: 0.85rem 1.5rem;
				display: flex;
				gap: 0.65rem;
				overflow-x: auto;
			}

			.switch-pill {
				flex: 0 0 auto;
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid var(--border-color);
				color: #94a3b8;
				font-size: 0.78rem;
				font-weight: 600;
				padding: 0.35rem 0.85rem;
				border-radius: 6px;
				cursor: pointer;
				transition: all 0.15s ease;
			}

			.switch-pill:hover {
				background: rgba(255, 255, 255, 0.1);
				color: #ffffff;
			}

			.switch-pill.is-active {
				background: rgba(239, 68, 68, 0.15);
				border-color: #ef4444;
				color: #ffffff;
				font-weight: 700;
			}

			/* Safe-Phrasing Guardrail Drawer & Button */
			.legal-guard-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				font-size: 0.8rem;
				font-weight: 700;
				color: #38bdf8;
				background: rgba(56, 189, 248, 0.12);
				border: 1px solid rgba(56, 189, 248, 0.35);
				padding: 0.35rem 0.8rem;
				border-radius: 6px;
				cursor: pointer;
				transition: all 0.18s ease;
			}

			.legal-guard-btn:hover,
			.legal-guard-btn.is-active {
				background: rgba(56, 189, 248, 0.22);
				border-color: #38bdf8;
				color: #ffffff;
				box-shadow: 0 0 12px rgba(56, 189, 248, 0.35);
			}

			.legal-drawer-backdrop {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.65);
				backdrop-filter: blur(4px);
				z-index: 150;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.25s ease;
			}

			.legal-drawer-backdrop.is-open {
				opacity: 1;
				pointer-events: auto;
			}

			.legal-drawer {
				position: fixed;
				top: 0;
				right: 0;
				width: min(550px, 92vw);
				height: 100vh;
				background: #0b0f17;
				border-left: 1px solid var(--border-color);
				box-shadow: -15px 0 45px rgba(0, 0, 0, 0.7);
				z-index: 160;
				display: flex;
				flex-direction: column;
				transform: translateX(100%);
				transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
			}

			.legal-drawer.is-open {
				transform: translateX(0);
			}

			.legal-drawer-header {
				padding: 1.25rem 1.5rem;
				background: #080b11;
				border-bottom: 1px solid var(--border-color);
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			.legal-badge-pill {
				font-size: 0.72rem;
				font-weight: 800;
				letter-spacing: 0.08em;
				color: #38bdf8;
				background: rgba(56, 189, 248, 0.12);
				border: 1px solid rgba(56, 189, 248, 0.25);
				padding: 0.2rem 0.55rem;
				border-radius: 4px;
				display: inline-block;
				margin-bottom: 0.35rem;
			}

			.legal-drawer-header h2 {
				margin: 0;
				font-size: 1.25rem;
				font-weight: 800;
				color: #ffffff;
			}

			.legal-close-btn {
				background: transparent;
				border: 1px solid rgba(255, 255, 255, 0.15);
				color: #94a3b8;
				font-size: 1.35rem;
				width: 32px;
				height: 32px;
				border-radius: 6px;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: all 0.15s ease;
			}

			.legal-close-btn:hover {
				background: rgba(255, 255, 255, 0.1);
				color: #ffffff;
			}

			.legal-drawer-body {
				padding: 1.5rem;
				overflow-y: auto;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
				flex: 1;
			}

			.legal-section-card {
				background: #111723;
				border: 1px solid var(--border-color);
				border-radius: 10px;
				padding: 1.25rem;
			}

			.legal-card-tag {
				font-size: 0.75rem;
				font-weight: 800;
				letter-spacing: 0.06em;
				color: #94a3b8;
				margin-bottom: 0.75rem;
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}

			.disclaimer-quote-box {
				background: #070a10;
				border-left: 3px solid #38bdf8;
				padding: 1rem 1.15rem;
				border-radius: 0 6px 6px 0;
				font-size: 0.95rem;
				line-height: 1.6;
				color: #f1f5f9;
			}

			.cardinal-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 0.85rem;
			}

			.rule-box {
				background: #080c14;
				border: 1px solid rgba(255, 255, 255, 0.06);
				border-radius: 8px;
				padding: 0.85rem 1rem;
			}

			.rule-row {
				margin-bottom: 0.45rem;
			}

			.rule-row:last-child {
				margin-bottom: 0;
			}

			.rule-badge {
				font-size: 0.72rem;
				font-weight: 800;
				padding: 0.15rem 0.45rem;
				border-radius: 4px;
				display: inline-block;
				margin-bottom: 0.25rem;
			}

			.rule-badge.ban {
				color: #f87171;
				background: rgba(239, 68, 68, 0.15);
				border: 1px solid rgba(239, 68, 68, 0.3);
			}

			.rule-badge.safe {
				color: #4ade80;
				background: rgba(34, 197, 94, 0.15);
				border: 1px solid rgba(34, 197, 94, 0.3);
			}

			.rule-text {
				font-size: 0.85rem;
				color: #cbd5e1;
				line-height: 1.45;
				margin: 0;
			}

			.swap-table {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.85rem;
			}

			.swap-table th {
				text-align: left;
				padding: 0.5rem 0.65rem;
				border-bottom: 1px solid var(--border-color);
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}

			.swap-table td {
				padding: 0.6rem 0.65rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
				vertical-align: middle;
			}

			.bad-text {
				color: #f87171;
				font-weight: 600;
			}

			.good-text {
				color: #4ade80;
				font-weight: 600;
			}

			@media (max-width: 1024px) {
				.cockpit-main {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<header class="cockpit-top-bar">
			<div class="top-left">
				<a href="/viewer" class="cockpit-logo-link" title="Return to Hub">
					<div class="logo-mini">
						<TongueLogo />
					</div>
					<span class="logo-title">Presenter Cockpit</span>
				</a>
				<span class="slide-status-badge" id="cockpit-slide-badge">SLIDE 01 / {String(slides.length).padStart(2, '0')}</span>
				<span class="topic-status-badge" id="cockpit-topic-badge">{slides[0]?.badge || 'Setup'}</span>
			</div>

			<div class="top-center">
				<div class="timer-box">
					<svg viewBox="0 0 24 24" width="16" height="16" stroke="#38bdf8" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
					<span class="timer-display" id="timer-display">00:00</span>
					<button type="button" class="timer-btn" id="timer-toggle-btn">Start</button>
					<button type="button" class="timer-btn" id="timer-reset-btn">Reset</button>
				</div>
			</div>

			<div class="top-right">
				<button type="button" class="legal-guard-btn" id="legal-guard-btn" title="Toggle Safe Phrasing Guide & YouTube Compliance Shield (Shortcut: L)">
					<span>🛡️ Safe Phrasing [L]</span>
				</button>
				<div class="sync-pill" title="Public Viewer window will follow your actions">
					<span class="sync-led"></span>
					<span>Broadcasting Live</span>
				</div>
				<a href={`/viewer/${post.id}/public`} target="_blank" class="top-action-link" title="Open Public screen in separate tab">
					<span>Open Public Tab ↗</span>
				</a>
			</div>
		</header>

		<main class="cockpit-main">
			<section class="slide-panel">
				<div>
					<h1 class="slide-title-display" id="cockpit-title">{slides[0]?.title}</h1>
					<ul class="cockpit-bullets" id="cockpit-bullets-list"></ul>
				</div>

				<div class="cockpit-nav-dock">
					<span class="nav-status-text" id="cockpit-point-status">Point 1 of {slides[0]?.bullets.length || 5}</span>
					<div class="nav-buttons-group">
						<button type="button" class="nav-btn nav-btn-prev" id="btn-prev-point">
							<span>← Prev (Shift+Space)</span>
						</button>
						<button type="button" class="nav-btn nav-btn-next" id="btn-next-point">
							<span>Next Point (Spacebar) →</span>
						</button>
					</div>
				</div>
			</section>

			<section class="notes-panel">
				<div class="notes-card">
					<div class="card-header-label">
						<svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
						<span>DENIS'S TALKING POINTS (TELEPROMPTER)</span>
					</div>
					<div class="notes-content-box" id="speaker-notes-box">
						<p>{slides[0]?.notes}</p>
					</div>
				</div>

				<div class="next-preview-card">
					<div class="card-header-label" style="color: #94a3b8;">
						<svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="9 18 15 12 9 6"></polyline></svg>
						<span>UPCOMING NEXT SLIDE</span>
					</div>
					<h3 class="next-preview-title" id="next-preview-title">{slides[1]?.title || 'Next Slide'}</h3>
					<div class="next-preview-first-bullet" id="next-preview-bullet">
						<span style="color: #ef4444;">•</span>
						<span id="next-preview-text">{slides[1]?.bullets[0] || ''}</span>
					</div>
				</div>
			</section>
		</main>

		<nav class="slide-switcher-bar" id="switcher-bar">
			{slides.map((s, idx) => (
				<button 
					type="button" 
					class={`switch-pill ${idx === 0 ? 'is-active' : ''}`}
					data-slide-index={idx}
					id={`switch-btn-${idx}`}
				>
					<span>{idx + 1}. {s.badge}</span>
				</button>
			))}
		</nav>

		<script define:vars={{ slides, slug: post.id }}>
			(function () {
				let currentSlide = 0;
				let currentPoint = 0;
				const totalSlides = slides.length;

				const syncChannel = new BroadcastChannel(`bms_deck_sync_${slug}`);

				const slideBadge = document.getElementById('cockpit-slide-badge');
				const topicBadge = document.getElementById('cockpit-topic-badge');
				const titleEl = document.getElementById('cockpit-title');
				const bulletsList = document.getElementById('cockpit-bullets-list');
				const pointStatus = document.getElementById('cockpit-point-status');
				const notesBox = document.getElementById('speaker-notes-box');
				const nextTitle = document.getElementById('next-preview-title');
				const nextText = document.getElementById('next-preview-text');
				const prevBtn = document.getElementById('btn-prev-point');
				const nextBtn = document.getElementById('btn-next-point');
				const switcherButtons = document.querySelectorAll('.switch-pill');

				let timerInterval = null;
				let timerSeconds = 0;
				const timerDisplay = document.getElementById('timer-display');
				const timerToggleBtn = document.getElementById('timer-toggle-btn');
				const timerResetBtn = document.getElementById('timer-reset-btn');

				function updateTimerDisplay() {
					if (!timerDisplay) return;
					const mins = String(Math.floor(timerSeconds / 60)).padStart(2, '0');
					const secs = String(timerSeconds % 60).padStart(2, '0');
					timerDisplay.textContent = `${mins}:${secs}`;
				}

				timerToggleBtn?.addEventListener('click', () => {
					if (timerInterval) {
						clearInterval(timerInterval);
						timerInterval = null;
						timerToggleBtn.textContent = 'Resume';
					} else {
						timerInterval = setInterval(() => {
							timerSeconds++;
							updateTimerDisplay();
						}, 1000);
						timerToggleBtn.textContent = 'Pause';
					}
				});

				timerResetBtn?.addEventListener('click', () => {
					clearInterval(timerInterval);
					timerInterval = null;
					timerSeconds = 0;
					updateTimerDisplay();
					if (timerToggleBtn) timerToggleBtn.textContent = 'Start';
				});

				function render() {
					const s = slides[currentSlide];
					if (!s) return;

					if (slideBadge) {
						slideBadge.textContent = `SLIDE ${String(currentSlide + 1).padStart(2, '0')} / ${String(totalSlides).padStart(2, '0')}`;
					}
					if (topicBadge) {
						topicBadge.textContent = s.badge;
					}
					if (titleEl) {
						titleEl.textContent = s.title;
					}

					if (bulletsList) {
						bulletsList.innerHTML = '';
						s.bullets.forEach((bText, idx) => {
							const li = document.createElement('li');
							li.className = 'cockpit-bullet-item';
							if (idx === currentPoint) {
								li.classList.add('is-active');
							} else if (idx < currentPoint) {
								li.classList.add('is-revealed');
							} else {
								li.classList.add('is-dimmed');
							}

							li.innerHTML = `
								<span class="bullet-dot-indicator"></span>
								<span class="bullet-text-content">${bText}</span>
							`;

							li.addEventListener('click', () => {
								currentPoint = idx;
								updateBulletStates();
								broadcastState();
							});

							bulletsList.appendChild(li);
						});
					}

					// Speaker Notes with High-Contrast Legal & Spoken Cues
					function formatNotesHtml(notesText) {
						if (!notesText) return '<p>Discuss this section.</p>';
						const paragraphs = notesText.split('\n\n');
						let html = '';
						paragraphs.forEach((p) => {
							const trimmed = p.trim();
							if (!trimmed) return;
							if (trimmed.startsWith('🛡️ LEGAL SHIELD:')) {
								const body = trimmed.replace('🛡️ LEGAL SHIELD:', '').trim();
								html += `
									<div class="notes-legal-card">
										<div class="notes-legal-card-header">
											<span>🛡️ LEGAL & YOUTUBE SHIELD</span>
										</div>
										<div class="notes-legal-card-body">${body}</div>
									</div>
								`;
							} else if (trimmed.startsWith('🎙️ READ VERBATIM OPENING DISCLAIMER:')) {
								const body = trimmed.replace('🎙️ READ VERBATIM OPENING DISCLAIMER:', '').trim();
								html += `
									<div class="notes-spoken-card">
										<div class="notes-spoken-card-header">
											<span>🎙️ READ VERBATIM OPENING DISCLAIMER (ALOUD)</span>
										</div>
										<div class="notes-spoken-card-body">${body}</div>
									</div>
								`;
							} else {
								html += `<p>${trimmed}</p>`;
							}
						});
						return html;
					}

					if (notesBox) {
						notesBox.innerHTML = formatNotesHtml(s.notes);
					}

					if (currentSlide < totalSlides - 1) {
						const nextS = slides[currentSlide + 1];
						if (nextTitle) nextTitle.textContent = nextS.title;
						if (nextText) nextText.textContent = nextS.bullets[0] || '';
					} else {
						if (nextTitle) nextTitle.textContent = 'End of Presentation';
						if (nextText) nextText.textContent = 'Wrap up your video!';
					}

					if (pointStatus) {
						pointStatus.textContent = `Point ${currentPoint + 1} of ${s.bullets.length}`;
					}

					switcherButtons.forEach((btn, idx) => {
						btn.classList.toggle('is-active', idx === currentSlide);
					});
				}

				function updateBulletStates() {
					const items = bulletsList?.querySelectorAll('.cockpit-bullet-item') || [];
					items.forEach((item, idx) => {
						item.classList.remove('is-active', 'is-revealed', 'is-dimmed');
						if (idx === currentPoint) {
							item.classList.add('is-active');
						} else if (idx < currentPoint) {
							item.classList.add('is-revealed');
						} else {
							item.classList.add('is-dimmed');
						}
					});
					const s = slides[currentSlide];
					if (pointStatus && s) {
						pointStatus.textContent = `Point ${currentPoint + 1} of ${s.bullets.length}`;
					}
				}

				function broadcastState() {
					syncChannel.postMessage({
						slideIndex: currentSlide,
						pointIndex: currentPoint
					});
				}

				function nextStep() {
					const s = slides[currentSlide];
					if (!s) return;
					if (currentPoint < s.bullets.length - 1) {
						currentPoint++;
						updateBulletStates();
					} else if (currentSlide < totalSlides - 1) {
						currentSlide++;
						currentPoint = 0;
						render();
					}
					broadcastState();
				}

				function prevStep() {
					if (currentPoint > 0) {
						currentPoint--;
						updateBulletStates();
					} else if (currentSlide > 0) {
						currentSlide--;
						const prevS = slides[currentSlide];
						currentPoint = prevS.bullets.length - 1;
						render();
					}
					broadcastState();
				}

				function nextSlide() {
					if (currentSlide < totalSlides - 1) {
						currentSlide++;
						currentPoint = 0;
						render();
						broadcastState();
					}
				}

				function prevSlide() {
					if (currentSlide > 0) {
						currentSlide--;
						currentPoint = 0;
						render();
						broadcastState();
					}
				}

				function jumpToSlide(idx) {
					if (idx >= 0 && idx < totalSlides) {
						currentSlide = idx;
						currentPoint = 0;
						render();
						broadcastState();
					}
				}

				nextBtn?.addEventListener('click', nextStep);
				prevBtn?.addEventListener('click', prevStep);

				switcherButtons.forEach((btn) => {
					btn.addEventListener('click', () => {
						const idx = parseInt(btn.getAttribute('data-slide-index') || '0', 10);
						jumpToSlide(idx);
					});
				});

				window.addEventListener('keydown', (e) => {
					if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) return;

					if (e.code === 'Space') {
						e.preventDefault();
						if (e.shiftKey) prevStep();
						else nextStep();
					} else if (e.code === 'ArrowRight') {
						e.preventDefault();
						nextStep();
					} else if (e.code === 'ArrowLeft') {
						e.preventDefault();
						prevStep();
					} else if (e.code === 'ArrowDown' || e.code === 'PageDown') {
						e.preventDefault();
						nextSlide();
					} else if (e.code === 'ArrowUp' || e.code === 'PageUp') {
						e.preventDefault();
						prevSlide();
					} else if (e.code === 'KeyL') {
						e.preventDefault();
						toggleLegalDrawer();
					} else if (e.code === 'Escape') {
						closeLegalDrawer();
					}
				});

				// Legal Safe-Phrasing Drawer Controls
				const legalBtn = document.getElementById('legal-guard-btn');
				const legalCloseBtn = document.getElementById('legal-close-btn');
				const legalDrawer = document.getElementById('legal-drawer');
				const legalBackdrop = document.getElementById('legal-drawer-backdrop');

				function openLegalDrawer() {
					legalDrawer?.classList.add('is-open');
					legalBackdrop?.classList.add('is-open');
					legalBtn?.classList.add('is-active');
				}

				function closeLegalDrawer() {
					legalDrawer?.classList.remove('is-open');
					legalBackdrop?.classList.remove('is-open');
					legalBtn?.classList.remove('is-active');
				}

				function toggleLegalDrawer() {
					if (legalDrawer?.classList.contains('is-open')) {
						closeLegalDrawer();
					} else {
						openLegalDrawer();
					}
				}

				legalBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					toggleLegalDrawer();
				});

				legalCloseBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					closeLegalDrawer();
				});

				legalBackdrop?.addEventListener('click', closeLegalDrawer);

				render();
			})();
		</script>

		<!-- Safe Phrasing Guide Drawer Backdrop & Panel -->
		<div class="legal-drawer-backdrop" id="legal-drawer-backdrop"></div>
		<aside class="legal-drawer" id="legal-drawer" aria-hidden="true">
			<div class="legal-drawer-header">
				<div>
					<span class="legal-badge-pill">🛡️ LEGAL & YOUTUBE COMPLIANCE SHIELD</span>
					<h2>Live Safe-Phrasing Guide</h2>
				</div>
				<button type="button" class="legal-close-btn" id="legal-close-btn" title="Close Guide (L or Esc)">&times;</button>
			</div>

			<div class="legal-drawer-body">
				<!-- 15-Second Spoken Opening Disclaimer -->
				<div class="legal-section-card">
					<div class="legal-card-tag">🎙️ 15-SECOND OPENING DISCLAIMER (READ BEFORE SLIDE 1)</div>
					<div class="disclaimer-quote-box">
						"Before we get started, a quick reminder: I am an independent literature researcher and a patient sharing my personal story living with Burning Mouth Syndrome. I am not a doctor or dentist, and this video is for educational purposes only. BMS is complex and everyone's biology is different, so please consult your doctor before making any major changes to your health or diet."
					</div>
				</div>

				<!-- The 4 Cardinal Rules on Camera -->
				<div class="legal-section-card">
					<div class="legal-card-tag">⚡ THE 4 CARDINAL RULES ON CAMERA</div>
					<div class="cardinal-grid">
						<div class="rule-box">
							<div class="rule-row">
								<span class="rule-badge ban">❌ NEVER PRESCRIBE</span>
								<p class="rule-text">Avoid "You should do X" or "This cures BMS".</p>
							</div>
							<div class="rule-row">
								<span class="rule-badge safe">✅ ALWAYS DESCRIBE</span>
								<p class="rule-text">"In my N=1 experiment..." / "Published studies observe..."</p>
							</div>
						</div>

						<div class="rule-box">
							<div class="rule-row">
								<span class="rule-badge ban">❌ NEVER "GEMINI TOLD ME"</span>
								<p class="rule-text">Prevents YouTube automated medical misinformation strikes.</p>
							</div>
							<div class="rule-row">
								<span class="rule-badge safe">✅ "AI AS STUDY ASSISTANT"</span>
								<p class="rule-text">"I used AI to organize published medical papers for my doctor."</p>
							</div>
						</div>

						<div class="rule-box">
							<div class="rule-row">
								<span class="rule-badge ban">❌ NEVER "CARNIVORE CURES BMS"</span>
								<p class="rule-text">Platforms penalize unproven extreme diet cures.</p>
							</div>
							<div class="rule-row">
								<span class="rule-badge safe">✅ "N=1 ELIMINATION TRIAL"</span>
								<p class="rule-text">"A personal elimination experiment to test food sensitivities."</p>
							</div>
						</div>

						<div class="rule-box">
							<div class="rule-row">
								<span class="rule-badge ban">❌ NEVER "OFFICIAL CLINICAL STUDY"</span>
								<p class="rule-text">Formal medical studies legally require prior IRB approval.</p>
							</div>
							<div class="rule-row">
								<span class="rule-badge safe">✅ "COMMUNITY CONVERSATION"</span>
								<p class="rule-text">"Informal channel poll / reading voluntary viewer comments."</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Instant Word-Swap Cheat Sheet -->
				<div class="legal-section-card">
					<div class="legal-card-tag">🔄 INSTANT WORD-SWAP CHEAT SHEET</div>
					<table class="swap-table">
						<thead>
							<tr>
								<th style="color: #f87171;">Avoid Saying</th>
								<th style="color: #4ade80;">Say Instead</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td><span class="bad-text">Cure / Fix / Solve</span></td>
								<td><span class="good-text">Remission / Relief in my case</span></td>
							</tr>
							<tr>
								<td><span class="bad-text">You should try...</span></td>
								<td><span class="good-text">What helped my body was...</span></td>
							</tr>
							<tr>
								<td><span class="bad-text">The AI prescribed...</span></td>
								<td><span class="good-text">AI helped me organize notes</span></td>
							</tr>
							<tr>
								<td><span class="bad-text">Gathering data for science</span></td>
								<td><span class="good-text">Casual community poll / discussion</span></td>
							</tr>
							<tr>
								<td><span class="bad-text">Medical protocol</span></td>
								<td><span class="good-text">Personal daily routine</span></td>
							</tr>
							<tr>
								<td><span class="bad-text">Doctor / Clinician</span></td>
								<td><span class="good-text">Independent literature researcher</span></td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</aside>
	</body>
</html>
