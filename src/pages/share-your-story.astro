---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import { Image } from 'astro:assets';
import authorPhoto from '../assets/denis-ethier.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Share Your Story | Decoding The Burn" 
			description="Share your Burning Mouth Syndrome experience, symptoms, dental history, and what helped or didn't help." 
		/>
	</head>
	<body>
		<Header />
		<main class="story-main-container">
			<div class="story-hero-image-wrapper">
				<Image 
					src={authorPhoto} 
					alt="Denis Ethier" 
					class="story-hero-img" 
					width={1200} 
					height={675} 
				/>
			</div>

			<h1 class="story-page-title">Share Your BMS&nbsp;Story</h1>

			<div class="story-disclaimer-wrapper">
				<MedicalDisclaimer />
			</div>

			<p class="story-lead-text">
				Every recovery clue matters. By gathering real patient experiences, symptoms, triggers, and dental histories, we can break through the isolation and build actionable data for the whole&nbsp;community.
			</p>
			
			<div class="story-form-card">
				<form action="https://formsubmit.co/denis@denisethier.com" method="POST" class="story-form-inner">
					<input type="hidden" name="_subject" value="[BMS Patient Story] Shared via Decoding The Burn" />
					<input type="hidden" name="_captcha" value="false" />
					<input type="hidden" name="_template" value="table" />

					<div class="form-group">
						<label for="story-name">Your Name</label>
						<input type="text" id="story-name" name="name" placeholder="Your name (or how you'd like to be called)" required />
					</div>
					
					<div class="form-group">
						<label for="story-email">Your Email</label>
						<input type="email" id="story-email" name="email" placeholder="name@example.com" required />
					</div>

					<div class="form-group">
						<label for="story-duration">How long have you had BMS symptoms?</label>
						<input type="text" id="story-duration" name="duration" placeholder="e.g., 6 months, 2 years, 5+ years" />
					</div>
					
					<div class="form-group">
						<label for="story-narrative">Your Story & Observations</label>
						<textarea id="story-narrative" name="story" rows="8" placeholder="Tell us about how your symptoms started, what triggers the pain (foods, stress, dental work), what treatments you've tried, and anything that brought relief..." required></textarea>
					</div>

					<div class="form-group-checkbox">
						<label class="checkbox-container">
							<input type="checkbox" name="permission_to_share" value="yes" checked />
							<span class="checkbox-text">You have permission to share my insights anonymously on the podcast or research case studies to help other patients.</span>
						</label>
					</div>
					
					<button type="submit" class="btn btn-primary story-submit-btn">Submit Your Story &rarr;</button>
				</form>
			</div>
		</main>
		<Footer />

		<style>
			.story-main-container {
				max-width: 760px;
				margin: 1.5rem auto 4.5rem;
				padding: 0 1.5rem;
			}

			.story-hero-image-wrapper {
				width: 100%;
				aspect-ratio: 16 / 9;
				border-radius: 20px;
				overflow: hidden;
				box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.18);
				margin-bottom: 2rem;
				background: #0f172a;
				border: 1px solid rgba(15, 23, 42, 0.08);
			}

			.story-hero-img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 20%;
				display: block;
			}

			.story-page-title {
				font-size: clamp(2.25rem, 4.5vw, 3rem);
				font-weight: 800;
				color: #000000;
				letter-spacing: -1px;
				margin: 0 0 1.25rem;
				text-align: center;
			}

			.story-disclaimer-wrapper {
				margin-bottom: 1.5rem;
			}

			.story-lead-text {
				font-size: 1.15rem;
				line-height: 1.7;
				color: #334155;
				margin-bottom: 2rem;
				text-align: center;
				text-wrap: balance;
			}

			.story-form-card {
				background: #ffffff;
				border: 1px solid var(--card-border);
				padding: 3rem 2.5rem;
				border-radius: 24px;
				box-shadow: var(--shadow-md);
			}

			.story-form-inner {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			.form-group label {
				display: block;
				margin-bottom: 0.5rem;
				color: #000000;
				font-weight: 700;
				font-size: 0.95rem;
			}

			.form-group input,
			.form-group textarea {
				width: 100%;
				padding: 0.9rem 1.25rem;
				border-radius: 12px;
				border: 1.5px solid #cbd5e1;
				background: #f8fafc;
				color: #0f172a;
				font-size: 1rem;
				outline: none;
				font-family: inherit;
				transition: border-color 0.2s, box-shadow 0.2s;
			}

			.form-group input:focus,
			.form-group textarea:focus {
				border-color: #c8382c;
				box-shadow: 0 0 0 3px rgba(200, 56, 44, 0.15);
				background: #ffffff;
			}

			.form-group-checkbox {
				margin-top: 0.5rem;
			}

			.checkbox-container {
				display: flex;
				align-items: flex-start;
				gap: 0.75rem;
				cursor: pointer;
			}

			.checkbox-container input[type="checkbox"] {
				margin-top: 0.25rem;
				width: 1.15rem;
				height: 1.15rem;
				accent-color: #c8382c;
				cursor: pointer;
			}

			.checkbox-text {
				font-size: 0.92rem;
				color: #475569;
				line-height: 1.5;
			}

			.story-submit-btn {
				align-self: flex-start;
				padding: 0.95rem 2.5rem;
				font-size: 1rem;
				font-weight: 700;
				border-radius: 12px;
				margin-top: 0.5rem;
			}

			@media (max-width: 640px) {
				.story-form-card {
					padding: 2rem 1.5rem;
				}

				.story-submit-btn {
					width: 100%;
				}
			}
		</style>
	</body>
</html>
