<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Thumbnail Variations Gallery | Decoding The Burn" description="Interactive gallery of 20 modern two-tone minimalist thumbnail concepts with zero text." />
		<style>
			.gallery-wrapper {
				max-width: 1400px;
				margin: 3rem auto 6rem;
				padding: 0 2rem;
			}
			.gallery-header {
				text-align: center;
				max-width: 860px;
				margin: 0 auto 3.5rem;
			}
			.gallery-header h1 {
				font-size: 3.2rem;
				font-weight: 800;
				letter-spacing: -1.5px;
				color: #000000;
				margin-bottom: 1rem;
				text-wrap: balance;
			}
			.gallery-header p {
				font-size: 1.15rem;
				color: #000000;
				line-height: 1.6;
				text-wrap: balance;
			}
			.variations-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
				gap: 2.5rem;
			}
			.variation-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 20px;
				overflow: hidden;
				box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.06);
				display: flex;
				flex-direction: column;
				transition: transform 0.2s ease, border-color 0.2s ease;
			}
			.variation-card:hover {
				transform: translateY(-4px);
				border-color: #c8382c;
				box-shadow: 0 12px 30px -4px rgba(200, 56, 44, 0.12);
			}
			.thumb-media {
				aspect-ratio: 16 / 9;
				width: 100%;
				background: #f8fafc;
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
				border-bottom: 1px solid #e2e8f0;
			}
			.thumb-media img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.card-details {
				padding: 1.75rem;
				display: flex;
				flex-direction: column;
				flex: 1;
			}
			.badge-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.85rem;
			}
			.num-badge {
				background: #000000;
				color: #ffffff;
				font-weight: 800;
				font-size: 0.75rem;
				padding: 3px 10px;
				border-radius: 6px;
				letter-spacing: 0.5px;
			}
			.tag-pill {
				background: #fef2f2;
				border: 1px solid #fecaca;
				color: #c8382c;
				font-size: 0.7rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 1px;
				padding: 3px 10px;
				border-radius: 6px;
			}
			.card-details h3 {
				font-size: 1.3rem;
				font-weight: 700;
				color: #000000;
				margin-bottom: 0.5rem;
				line-height: 1.3;
			}
			.card-details .sub {
				font-size: 0.92rem;
				color: #111111;
				line-height: 1.5;
				margin-bottom: 1.25rem;
				flex: 1;
			}
			.meta-footer {
				border-top: 1px solid #f1f5f9;
				padding-top: 1rem;
				font-size: 0.82rem;
				color: #000000;
				display: flex;
				flex-direction: column;
				gap: 4px;
			}
			.meta-footer strong {
				color: #000000;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="gallery-wrapper">
				<div class="gallery-header">
					<h1>20 Modern Two-Tone Thumbnail Variations</h1>
					<p>Explore 20 clean, branded graphic icons without any text. Each image uses our high-contrast brand palette (deep crimson red, warm linen cream, and dark obsidian mode) designed for clean blog presentation.</p>
				</div>

				<div class="variations-grid">
					{variations.map((v) => (
						<div class="variation-card">
							<div class="thumb-media">
								<img src={v.src} alt={v.title} loading="lazy" />
							</div>
							<div class="card-details">
								<div class="badge-row">
									<span class="num-badge">#{v.id}</span>
									<span class="tag-pill">{v.tag}</span>
								</div>
								<h3>{v.title}</h3>
								<p class="sub">{v.subtitle}</p>
								<div class="meta-footer">
									<div><strong>Palette:</strong> {v.palette}</div>
									<div><strong>Best Fit:</strong> {v.fit}</div>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
