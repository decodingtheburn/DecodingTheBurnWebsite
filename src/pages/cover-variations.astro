---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Book Cover PAIN Title Variations" description="Comparing variations of the PAIN title lockup" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800;900&family=Inter:wght@400;600;700;800;900&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
		<style>
			body {
				background: #090614;
				color: #f8fafc;
				font-family: 'Inter', system-ui, sans-serif;
				padding: 2rem 1rem 5rem;
				margin: 0;
			}
			.header-bar {
				max-width: 1400px;
				margin: 0 auto 2.5rem;
				text-align: center;
			}
			.header-bar h1 {
				font-size: 2.2rem;
				font-weight: 900;
				margin-bottom: 0.5rem;
				color: #ffffff;
			}
			.header-bar p {
				color: #94a3b8;
				font-size: 1.05rem;
				max-width: 720px;
				margin: 0 auto;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
				gap: 2rem;
				max-width: 1500px;
				margin: 0 auto;
			}
			.variant-card {
				background: radial-gradient(circle at 50% 20%, #1e1138 0%, #0d081e 60%, #06030e 100%);
				border: 1px solid rgba(255, 255, 255, 0.12);
				border-radius: 16px;
				padding: 2rem 1.5rem;
				display: flex;
				flex-direction: column;
				align-items: center;
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7);
				position: relative;
			}
			.variant-badge {
				position: absolute;
				top: 1rem;
				left: 1.25rem;
				font-size: 0.75rem;
				font-weight: 800;
				letter-spacing: 0.05em;
				color: #fbbf24;
				text-transform: uppercase;
			}
			.variant-desc {
				margin-top: 1.25rem;
				font-size: 0.88rem;
				color: #cbd5e1;
				text-align: center;
				line-height: 1.45;
				border-top: 1px solid rgba(255, 255, 255, 0.08);
				padding-top: 1rem;
				width: 100%;
			}
			.cover-title-stack {
				width: 100%;
				max-width: 380px;
				margin: 1.5rem auto 0;
				display: flex;
				flex-direction: column;
				align-items: stretch;
				text-shadow: 0 8px 35px rgba(0,0,0,0.95);
			}
			.cover-line-acid {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
				font-family: 'Inter', system-ui, sans-serif;
				font-size: 2.15rem;
				font-weight: 900;
				line-height: 1.0;
				text-transform: uppercase;
				margin-bottom: 0.35rem;
				letter-spacing: -0.04em;
			}
			.cover-line-mouth {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: 100%;
				font-family: 'Inter', system-ui, sans-serif;
				font-size: 5.65rem;
				font-weight: 900;
				line-height: 0.88;
				text-transform: uppercase;
				color: #ffffff;
				margin-bottom: 0.25rem;
			}
			.head-img {
				width: 130px;
				margin: 1.25rem auto 0;
				filter: drop-shadow(0 10px 25px rgba(0,0,0,0.8));
			}
		</style>
	</head>
	<body>
		<div class="header-bar">
			<h1>Book Cover PAIN Variations</h1>
			<p>Compare the current stretched lockup with tighter, bolder, centered, and scaled alternatives.</p>
		</div>

		<div class="grid">
			<!-- Option 1: Current stretched (space-between) -->
			<div class="variant-card">
				<span class="variant-badge">Variation 1 - Current</span>
				<div class="cover-title-stack">
					<div class="cover-line-acid">
						<span style="color: #ef4444;">A</span><span style="color: #f45b36;">C</span><span style="color: #f97316;">I</span><span style="color: #fb923c;">D</span><span style="color: #f59e0b;">-</span><span style="color: #eab308;">T</span><span style="color: #84cc16;">R</span><span style="color: #22c55e;">I</span><span style="color: #10b981;">G</span><span style="color: #06b6d4;">G</span><span style="color: #0ea5e9;">E</span><span style="color: #3b82f6;">R</span><span style="color: #6366f1;">E</span><span style="color: #a855f7;">D</span>
					</div>
					<div class="cover-line-mouth">
						<span>M</span><span>O</span><span>U</span><span>T</span><span>H</span>
					</div>
					<div style="display: flex; justify-content: space-between; align-items: center; width: 100%; font-family: 'Inter', system-ui, sans-serif; font-size: 7.4rem; font-weight: 900; line-height: 0.82; text-transform: uppercase; color: #ffffff;">
						<span>P</span><span>A</span><span>I</span><span>N</span>
					</div>
				</div>
				<img src="/bms-head-transparent-pain-map.png" alt="Map" class="head-img" />
				<div class="variant-desc">
					<strong>Current Stretched Lockup:</strong> 4 letters spread across 100% width via <code>space-between</code>, creating the wide gaps.
				</div>
			</div>

			<!-- Option 2: Centered, Natural Tight Kerning (No Wide Gaps) -->
			<div class="variant-card">
				<span class="variant-badge">Variation 2 - Natural Tight Kerning</span>
				<div class="cover-title-stack">
					<div class="cover-line-acid">
						<span style="color: #ef4444;">A</span><span style="color: #f45b36;">C</span><span style="color: #f97316;">I</span><span style="color: #fb923c;">D</span><span style="color: #f59e0b;">-</span><span style="color: #eab308;">T</span><span style="color: #84cc16;">R</span><span style="color: #22c55e;">I</span><span style="color: #10b981;">G</span><span style="color: #06b6d4;">G</span><span style="color: #0ea5e9;">E</span><span style="color: #3b82f6;">R</span><span style="color: #6366f1;">E</span><span style="color: #a855f7;">D</span>
					</div>
					<div class="cover-line-mouth">
						<span>M</span><span>O</span><span>U</span><span>T</span><span>H</span>
					</div>
					<div style="display: block; text-align: center; width: 100%; font-family: 'Inter', system-ui, sans-serif; font-size: 6.8rem; font-weight: 900; line-height: 0.88; text-transform: uppercase; color: #ffffff; letter-spacing: -0.04em;">
						PAIN
					</div>
				</div>
				<img src="/bms-head-transparent-pain-map.png" alt="Map" class="head-img" />
				<div class="variant-desc">
					<strong>Centered Solid Word:</strong> Eliminates the artificial letter spacing. Letters sit together naturally and compactly.
				</div>
			</div>

			<!-- Option 3: Massive Font Size (9.8rem) with Tight Kerning -->
			<div class="variant-card">
				<span class="variant-badge">Variation 3 - Massive Scale (9.8rem)</span>
				<div class="cover-title-stack">
					<div class="cover-line-acid">
						<span style="color: #ef4444;">A</span><span style="color: #f45b36;">C</span><span style="color: #f97316;">I</span><span style="color: #fb923c;">D</span><span style="color: #f59e0b;">-</span><span style="color: #eab308;">T</span><span style="color: #84cc16;">R</span><span style="color: #22c55e;">I</span><span style="color: #10b981;">G</span><span style="color: #06b6d4;">G</span><span style="color: #0ea5e9;">E</span><span style="color: #3b82f6;">R</span><span style="color: #6366f1;">E</span><span style="color: #a855f7;">D</span>
					</div>
					<div class="cover-line-mouth">
						<span>M</span><span>O</span><span>U</span><span>T</span><span>H</span>
					</div>
					<div style="display: block; text-align: center; width: 100%; font-family: 'Inter', system-ui, sans-serif; font-size: 9.6rem; font-weight: 900; line-height: 0.80; text-transform: uppercase; color: #ffffff; letter-spacing: -0.05em;">
						PAIN
					</div>
				</div>
				<img src="/bms-head-transparent-pain-map.png" alt="Map" class="head-img" />
				<div class="variant-desc">
					<strong>Giant Compact Word:</strong> Scaled up to 9.6rem with <code>-0.05em</code> kerning so the word fills the width naturally without spreading the letters apart.
				</div>
			</div>

			<!-- Option 4: Extra Heavy Stroke Emboldened -->
			<div class="variant-card">
				<span class="variant-badge">Variation 4 - Extra Heavy Stroke (Bolder)</span>
				<div class="cover-title-stack">
					<div class="cover-line-acid">
						<span style="color: #ef4444;">A</span><span style="color: #f45b36;">C</span><span style="color: #f97316;">I</span><span style="color: #fb923c;">D</span><span style="color: #f59e0b;">-</span><span style="color: #eab308;">T</span><span style="color: #84cc16;">R</span><span style="color: #22c55e;">I</span><span style="color: #10b981;">G</span><span style="color: #06b6d4;">G</span><span style="color: #0ea5e9;">E</span><span style="color: #3b82f6;">R</span><span style="color: #6366f1;">E</span><span style="color: #a855f7;">D</span>
					</div>
					<div class="cover-line-mouth">
						<span>M</span><span>O</span><span>U</span><span>T</span><span>H</span>
					</div>
					<div style="display: block; text-align: center; width: 100%; font-family: 'Inter', system-ui, sans-serif; font-size: 8.8rem; font-weight: 900; line-height: 0.82; text-transform: uppercase; color: #ffffff; letter-spacing: -0.04em; -webkit-text-stroke: 2.5px #ffffff;">
						PAIN
					</div>
				</div>
				<img src="/bms-head-transparent-pain-map.png" alt="Map" class="head-img" />
				<div class="variant-desc">
					<strong>Ultra-Fat Text Stroke:</strong> Adds <code>-webkit-text-stroke: 2.5px #ffffff</code> to push past standard 900 Black weight, making the letter stems visibly fatter.
				</div>
			</div>

			<!-- Option 5: Flush Justified with Subtle Keylines -->
			<div class="variant-card">
				<span class="variant-badge">Variation 5 - Tight Center + Side Accents</span>
				<div class="cover-title-stack">
					<div class="cover-line-acid">
						<span style="color: #ef4444;">A</span><span style="color: #f45b36;">C</span><span style="color: #f97316;">I</span><span style="color: #fb923c;">D</span><span style="color: #f59e0b;">-</span><span style="color: #eab308;">T</span><span style="color: #84cc16;">R</span><span style="color: #22c55e;">I</span><span style="color: #10b981;">G</span><span style="color: #06b6d4;">G</span><span style="color: #0ea5e9;">E</span><span style="color: #3b82f6;">R</span><span style="color: #6366f1;">E</span><span style="color: #a855f7;">D</span>
					</div>
					<div class="cover-line-mouth">
						<span>M</span><span>O</span><span>U</span><span>T</span><span>H</span>
					</div>
					<div style="display: flex; align-items: center; justify-content: center; width: 100%; margin-top: 0.1rem; gap: 0.85rem;">
						<span style="flex: 1; height: 3px; background: rgba(255, 255, 255, 0.35); border-radius: 2px;"></span>
						<span style="font-family: 'Inter', system-ui, sans-serif; font-size: 6.2rem; font-weight: 900; line-height: 0.85; text-transform: uppercase; color: #ffffff; letter-spacing: -0.03em;">PAIN</span>
						<span style="flex: 1; height: 3px; background: rgba(255, 255, 255, 0.35); border-radius: 2px;"></span>
					</div>
				</div>
				<img src="/bms-head-transparent-pain-map.png" alt="Map" class="head-img" />
				<div class="variant-desc">
					<strong>Balanced Framing:</strong> Tight, bold PAIN flanked by clean 3px keylines that anchor it to the exact same width as MOUTH.
				</div>
			</div>

			<!-- Option 6: Montserrat Black 900 for PAIN -->
			<div class="variant-card">
				<span class="variant-badge">Variation 6 - Montserrat 900 Black</span>
				<div class="cover-title-stack">
					<div class="cover-line-acid">
						<span style="color: #ef4444;">A</span><span style="color: #f45b36;">C</span><span style="color: #f97316;">I</span><span style="color: #fb923c;">D</span><span style="color: #f59e0b;">-</span><span style="color: #eab308;">T</span><span style="color: #84cc16;">R</span><span style="color: #22c55e;">I</span><span style="color: #10b981;">G</span><span style="color: #06b6d4;">G</span><span style="color: #0ea5e9;">E</span><span style="color: #3b82f6;">R</span><span style="color: #6366f1;">E</span><span style="color: #a855f7;">D</span>
					</div>
					<div class="cover-line-mouth">
						<span>M</span><span>O</span><span>U</span><span>T</span><span>H</span>
					</div>
					<div style="display: block; text-align: center; width: 100%; font-family: 'Montserrat', sans-serif; font-size: 8.5rem; font-weight: 900; line-height: 0.82; text-transform: uppercase; color: #ffffff; letter-spacing: -0.04em;">
						PAIN
					</div>
				</div>
				<img src="/bms-head-transparent-pain-map.png" alt="Map" class="head-img" />
				<div class="variant-desc">
					<strong>Montserrat Display Black:</strong> Uses Montserrat's broader proportions so PAIN feels wider and thicker while keeping letters closely knit.
				</div>
			</div>
		</div>
	</body>
</html>
