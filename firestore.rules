rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bms_quiz_responses/{docId} {
      allow create, read: if true;
    }
    match /bms_quiz_stats/{questionId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
